	quest.332755861094418C.title: "Basic Furnator"
	quest.332755861094418C.quest_subtitle: "Basic tier: furnator"
	quest.332755861094418C.quest_desc: [
		"&eWhat:&r the Furnator burns furnace fuel for FE."
