	chapter.25103ED6860F9AFB.title: "Tips and Tricks"
	chapter.25103ED6860F9AFB.chapter_subtitle: [
		"Small lessons that save a demigod hours. All optional, read them in any order."
	]
	quest.03AC2421DB7EB00C.title: "Tips and Tricks"
	quest.03AC2421DB7EB00C.quest_subtitle: "A board of short lessons"
	quest.03AC2421DB7EB00C.quest_desc: [
		"&6You remember knowing every trick of your own world. These belong to this one.&r"
		"&eWhat:&r each card below is one short tip about this pack: how to look things up, get around, and where it differs from other packs."
		"&eHow:&r read any card and click its checkmark. Nothing here blocks the main path."
		"&eTip:&r the top row is the most useful on your first day."
	]
	quest.14A3CED751BDE80A.title: "Look It Up"
	quest.14A3CED751BDE80A.quest_subtitle: "R for recipes, U for uses"
	quest.14A3CED751BDE80A.quest_desc: [
		"&eWhat:&r JEI shows every recipe in the pack, including the ones changed for progression."
		"&eHow:&r hover over any item and press &eR&r for how to make it or &eU&r for what it makes. Type &e@modname&r in the search bar to list one mod's items."
		"&eTip:&r press &eA&r over an item to bookmark it, and use the &e+&r button in a recipe to fill your crafting grid."
	]
	quest.37AF9544E96AAA47.title: "What Am I Looking At?"
	quest.37AF9544E96AAA47.quest_subtitle: "Jade's little panel"
	quest.37AF9544E96AAA47.quest_desc: [
		"&eWhat:&r Jade shows a panel at the top of the screen for the block or mob under your crosshair: its name, its mod and its state."
		"&eHow:&r look at a machine to see its progress, energy and fluids. Look at an ore to see which tool can mine it."
		"&eTip:&r when a machine stalls, look at it first: Jade usually shows what's missing."
	]
	quest.26EB3D7DD4E4F390.title: "Maps and Waypoints"
	quest.26EB3D7DD4E4F390.quest_subtitle: "JourneyMap draws as you walk"
	quest.26EB3D7DD4E4F390.quest_desc: [
		"&eWhat:&r JourneyMap keeps a minimap and a full world map of everywhere you've been."
		"&eHow:&r press &eJ&r for the full map and right-click a spot to set a waypoint."
		"&eTip:&r it drops a waypoint where you die, which leads you straight back to your grave."
	]
	quest.17701EB88280A179.title: "Claim and Force-Load"
	quest.17701EB88280A179.quest_subtitle: "FTB Chunks keeps your base safe"
	quest.17701EB88280A179.quest_desc: [
		"&eWhat:&r claimed chunks are protected from other players. Force-loaded chunks keep running while you're away."
		"&eHow:&r press &eM&r and drag over chunks to claim them. The same map force-loads a claimed chunk (its help text shows the clicks)."
		"&eTip:&r force-load your machine rooms and flight area, not your whole base: you have a limited number."
	]
	quest.706FAFD8B520897F.title: "One Swing, Whole Vein"
	quest.706FAFD8B520897F.quest_subtitle: "FTB Ultimine"
	quest.706FAFD8B520897F.quest_desc: [
		"&eWhat:&r Ultimine breaks every connected matching block at once: an ore vein, a tree, a strip of stone."
		"&eHow:&r hold the &e`&r key (left of 1) while you break a block. The Quality of Life page shows the shapes."
		"&eTip:&r it costs hunger, so eat before you clear a big vein."
	]
	quest.47735B9C5507ABFC.title: "Waystones"
	quest.47735B9C5507ABFC.quest_subtitle: "Fast travel between your places"
	quest.47735B9C5507ABFC.quest_desc: [
		"&eWhat:&r activate a waystone once and you can warp to it from any other waystone."
		"&eHow:&r get any waystone: find one in a village or craft one (check JEI)."
		"&eTip:&r put one at your base, your mine and your Nether portal. A Warp Stone (Market or JEI) warps from anywhere."
	]
	quest.1E3B8450579196C9.title: "Sleep Anywhere"
	quest.1E3B8450579196C9.quest_subtitle: "A sleeping bag skips the night"
	quest.1E3B8450579196C9.quest_desc: [
		"&eWhat:&r a sleeping bag lets you sleep through the night wherever you are, without moving your spawn point."
		"&eHow:&r get any sleeping bag (check JEI for the recipe). A hammock does the same for the day."
		"&eTip:&r keep one in your backpack for long trips and deep mines."
	]
	quest.39C7C23622237A6E.title: "Carry More"
	quest.39C7C23622237A6E.quest_subtitle: "A backpack, and what it can learn"
	quest.39C7C23622237A6E.quest_desc: [
		"&eWhat:&r Sophisticated Backpacks hold far more than your inventory and take upgrades: pickup, magnet, feeding, crafting and more."
		"&eHow:&r get a backpack (leather, string and a chest, check JEI)."
		"&eTip:&r the Market sells upgrade bases, so tokens turn into upgrades early. The backpack quest itself is on the Storage page."
	]
	quest.76EF853E17A85E47.title: "Fewer Clicks"
	quest.76EF853E17A85E47.quest_subtitle: "Bulk recipes and a crafting table on a stick"
	quest.76EF853E17A85E47.quest_desc: [
		"&eWhat:&r Utilitarian adds bulk wood recipes (two logs in a column make 16 sticks; chests and ladders straight from logs). Crafting on a Stick puts a crafting table, stonecutter or anvil in your hand."
		"&eHow:&r press &eU&r on any log in JEI to see the shortcuts."
		"&eTip:&r a Tool Belt keeps your spare tools one keypress away."
	]
	quest.3392F726D3D11ECE.title: "Death Is Not the End"
	quest.3392F726D3D11ECE.quest_subtitle: "Graves, /back and /home"
	quest.3392F726D3D11ECE.quest_desc: [
		"&eWhat:&r when you die, Corail Tombstone keeps your items in a grave where you fell."
		"&eHow:&r type &e/back&r to return to the spot, or follow JourneyMap's death waypoint, then open the grave."
		"&eTip:&r &e/sethome&r at your base and &e/home&r gets you back after a long trip."
	]
	quest.561B57755E420B66.title: "Play Together"
	quest.561B57755E420B66.quest_subtitle: "Teams share quests and land"
	quest.561B57755E420B66.quest_desc: [
		"&eWhat:&r FTB Teams puts players in a party that shares quest progress and claimed chunks."
		"&eHow:&r open the Teams screen from your inventory (or use &e/ftbteams&r), create a party and invite your friends."
		"&eTip:&r on a server, form the party early so claims and quest progress are shared from the start."
	]
	quest.21A3809C9F28F186.title: "Tokens and the Market"
	quest.21A3809C9F28F186.quest_subtitle: "What quests pay, and what it buys"
	quest.21A3809C9F28F186.quest_desc: [
		"&eWhat:&r most quests pay Demigod Tokens; nine of them make one Greater Demigod Token."
		"&eHow:&r the Demigod's Market pages trade tokens for supplies, and JEI shows every crafting trade (search &eDemigod Token&r, press &eU&r)."
		"&eTip:&r the Market sells more of what you've already made, never a way past a tier."
	]
	quest.58C324A48D29F67C.title: "Periodic Table Perks"
	quest.58C324A48D29F67C.quest_subtitle: "Collect a whole group for a permanent bonus"
	quest.58C324A48D29F67C.quest_desc: [
		"&eWhat:&r the pack remembers every element you've held. Hold every element of a group once and you keep a bonus for good, even after death."
		"&eHow:&r type &e/warbucks elements&r to see your progress. Aluminium, tin, lead and indium (the post-transition metals) give +2 armour toughness."
		"&eTip:&r you only need to hold each element once; you can use it up afterwards."
	]
	quest.4A7214A70718F893.title: "Quests Notice Everything"
	quest.4A7214A70718F893.quest_subtitle: "No need to do them in order"
	quest.4A7214A70718F893.quest_desc: [
		"&eWhat:&r the book is flexible: an item quest completes as soon as you have the item, even if the quests before it aren't done yet."
		"&eHow:&r just play. Craft a pickaxe early and its quest ticks off; claim the reward when you get there."
		"&eTip:&r many quests take any variant (any wood, any colour), so check the task before you craft a specific one."
	]
	quest.6946DA3347FFD696.title: "The Fast Furnace"
	quest.6946DA3347FFD696.quest_subtitle: "Every furnace cooks four times faster"
	quest.6946DA3347FFD696.quest_desc: [
		"&eWhat:&r in this pack every furnace, smoker and blast furnace recipe cooks 4x faster, including modded smelting."
		"&eHow:&r nothing to do: a stack of iron in a plain furnace is done in well under a minute."
		"&eTip:&r machines from MI, Mekanism and Create keep their own speeds; only vanilla-style cooking is faster."
	]
	quest.0C2E5B5B8ADC89A2.title: "Long Days, Little Rain"
	quest.0C2E5B5B8ADC89A2.quest_subtitle: "More daylight to work in"
	quest.0C2E5B5B8ADC89A2.quest_desc: [
		"&eWhat:&r Overworld days last twice as long (about 20 minutes); nights are normal length."
		"&eHow:&r dry spells are stretched and rain is cut short, so storms come less often."
		"&eTip:&r a sleeping bag still skips the night, so you can stay in daylight almost all the time."
	]
	quest.7EFB17FDB8203933.title: "Rich Deposits"
	quest.7EFB17FDB8203933.quest_subtitle: "Scattered ore is thin; deposits are huge"
	quest.7EFB17FDB8203933.quest_desc: [
		"&eWhat:&r loose ore is rarer here, but about one chunk in 16 to 30 hides a rich deposit of hundreds of ores, at a depth that depends on the metal."
		"&eHow:&r explore caves, use Jade and Ultimine, and later the &eSpectrometer&r (LV): right-click it to read ore signals in the chunks around you."
		"&eTip:&r a strong signal is usually a deposit. Walk towards it and scan again."
	]
	quest.2D0068CC685F50E1.title: "The Mining Dimension"
	quest.2D0068CC685F50E1.quest_subtitle: "A flat world packed with ore"
	quest.2D0068CC685F50E1.quest_desc: [
		"&eWhat:&r a Teleport Pad placed in the Overworld leads to the Mining dimension: flat layers rich in iron, gold, diamond, redstone, tin, lead, nickel, silver and bauxite."
		"&eHow:&r craft the pad (ender pearl, allthemodium nuggets, MI steel plates, an analog circuit), stand on it with empty hands and sneak + right-click."
		"&eTip:&r mobs spawn in the dark there, so light your tunnels."
	]
	quest.22EDDC3581120EE8.title: "More Ore From Chemistry"
	quest.22EDDC3581120EE8.quest_subtitle: "Acids multiply ore; plain crushing doesn't"
	quest.22EDDC3581120EE8.quest_desc: [
		"&eWhat:&r before acids, every route caps at 2x per ore block. Mekanism's chemistry raises it: oxygen 3x, hydrogen chloride 4x, sulfuric acid 5x."
		"&eChemistry:&r acids dissolve the ore into a solution, which can be purified far better than a crushed rock."
		"&eTip:&r spin Mekanism's dirty dust in the MI Centrifuge for byproduct metals."
	]
	quest.3F12CA25FC3264EF.title: "Everything Is Made of Elements"
	quest.3F12CA25FC3264EF.quest_subtitle: "The Dissolver takes blocks apart"
	quest.3F12CA25FC3264EF.quest_desc: [
		"&eWhat:&r Alchemistry's Dissolver breaks almost any block or item into its elements; the Combiner builds things back up."
		"&eChemistry:&r atoms are rearranged, never created or destroyed, so what you take apart you can rebuild."
		"&eTip:&r it's the only way to get some elements as items, like the hydrogen for your first flight."
	]
	quest.000BFE2E99302984.title: "Read the Formula"
	quest.000BFE2E99302984.quest_subtitle: "Tooltips show what things are made of"
	quest.000BFE2E99302984.quest_desc: [
		"&eWhat:&r chemistry items show their formula in the tooltip: ChemLib's elements and compounds, and many machine fluids and gases (H₂, Cl₂, D₂O and more)."
		"&eHow:&r hover over a compound or a fluid bucket in JEI or your inventory."
		"&eTip:&r the Lab Notebook page explains the real chemistry behind each machine."
	]
	quest.2DDF4D0EE541F4AA.title: "Building Multiblocks"
	quest.2DDF4D0EE541F4AA.quest_subtitle: "Where the 3D layouts are shown"
	quest.2DDF4D0EE541F4AA.quest_desc: [
		"&eWhat:&r big machines are multiblocks. You never have to guess their shape."
		"&eHow:&r press &eR&r on the controller in JEI for its layout, read the MI guidebook, and use Just Enough Mekanism Multiblocks for Mekanism's."
		"&eTip:&r MI multiblocks also need the right hatches for items, fluids and energy; the guidebook page for each one lists them."
	]
	chapter.283C125EDC24C8C3.title: "Building Tips"
	chapter.283C125EDC24C8C3.chapter_subtitle: [
		"A god's house should look like one."
	]
	quest.41199268F6357478.title: "Building Tips"
	quest.41199268F6357478.quest_subtitle: "Tools and blocks for a base worth living in"
	quest.41199268F6357478.quest_desc: [
		"&6You remember raising cities with a gesture. For now, a few clever tools will do.&r"
		"&eWhat:&r this page is a catalogue of the pack's building mods and decoration, one cluster per theme around this quest."
		"&eHow:&r everything here is optional and cheap. Pick a cluster that suits your next build and work outward."
		"&eTip:&r a stonecutter makes stairs, slabs, walls and patterns with no waste. Use it for every stone on this page."
	]
	quest.0EBF44825F21BDC2.title: "Construction Stick"
	quest.0EBF44825F21BDC2.quest_subtitle: "Extend a wall in one click"
	quest.0EBF44825F21BDC2.quest_desc: [
		"&eWhat:&r a Construction Stick places a whole row or face of blocks matching the one you click, from your inventory."
		"&eHow:&r three sticks in a column (check JEI). Right-click the face of a wall to grow it by one layer."
		"&eTip:&r the tooltip lists its modes, such as only extending in a straight line."
	]
	quest.046BE5DF3A379E58.title: "Diamond Stick"
	quest.046BE5DF3A379E58.quest_subtitle: "Bigger reach, more durability"
	quest.046BE5DF3A379E58.quest_desc: [
		"&eWhat:&r better sticks place more blocks per click and last longer: copper, iron, diamond, then netherite."
		"&eChemistry:&r diamond is pure carbon in a tight 3D lattice, which makes it the hardest natural material."
		"&eHow:&r a diamond on two sticks (check JEI). Templates at a smithing table add tricks such as replacing blocks."
	]
	quest.4AB4BF290ECDDCFD.title: "Tool Extras"
	quest.4AB4BF290ECDDCFD.quest_subtitle: "A saw, a hammer and an angel template"
	quest.4AB4BF290ECDDCFD.quest_desc: [
		"&eWhat:&r the Framing Saw crafts any framed shape from framed cubes; the Window Hammer reshapes a placed Macaw's window; the Angel template lets a stick place blocks in mid-air."
		"&eHow:&r check JEI for each. Apply the template to a stick at a smithing table."
		"&eTip:&r the angel template is a building aid, not flight. Flight in this pack is a chemistry milestone."
	]
	quest.7AD94AAAA5254B9E.title: "Effortless Building"
	quest.7AD94AAAA5254B9E.quest_subtitle: "Mirror, array and line building"
	quest.7AD94AAAA5254B9E.quest_desc: [
		"&eWhat:&r Effortless Building adds mirror, array and line modes for big symmetric builds."
		"&eHow:&r open its menu (check Controls) and pick a mode. The randomizer places a random mix of the blocks you load into it."
		"&eTip:&r load the randomizer with stone, andesite and cobblestone for natural-looking walls."
	]
	quest.0A13E015E85ED202.title: "Scaffolding"
	quest.0A13E015E85ED202.quest_subtitle: "Climb up, sneak down, break the base"
	quest.0A13E015E85ED202.quest_desc: [
		"&eWhat:&r scaffolding stacks upward and outward, you climb it like a ladder, and breaking the bottom brings the whole tower down."
		"&eChemistry:&r bamboo is a grass whose stems are stiffened with lignin and silica, which is why real scaffolds have used it for centuries."
		"&eHow:&r six bamboo and a string make six scaffolding (check JEI). Sneak to climb down."
	]
	quest.171C251ED5512ABD.title: "Building Gadgets"
	quest.171C251ED5512ABD.quest_subtitle: "Place whole surfaces with FE"
	quest.171C251ED5512ABD.quest_desc: [
		"&eWhat:&r FE-powered gadgets that place, swap, copy and remove blocks in bulk."
		"&eHow:&r iron, redstone, lapis and a diamond (check JEI). Charge it in any energy storage block."
		"&eTip:&r link the gadget to a chest or backpack so it pulls blocks from storage."
	]
	quest.34C2506F0D77DBC7.title: "Copy and Paste"
	quest.34C2506F0D77DBC7.quest_subtitle: "Copy a whole build"
	quest.34C2506F0D77DBC7.quest_desc: [
		"&eWhat:&r copy an area and paste it elsewhere; the Template Manager saves copies to share."
		"&eHow:&r check JEI. Great for repeating a row of furnaces or a decorated wall."
		"&eTip:&r templates can be shared with friends on the server."
	]
	quest.78B3985AFEC9753C.title: "Exchanging Gadget"
	quest.78B3985AFEC9753C.quest_subtitle: "Swap blocks in place"
	quest.78B3985AFEC9753C.quest_desc: [
		"&eWhat:&r replaces blocks in an area with another block, keeping the shape."
		"&eHow:&r check JEI. Perfect for turning a cobblestone shell into something pretty."
		"&eTip:&r it uses the blocks in your inventory, so carry enough."
	]
	quest.6264FFAD4D805503.title: "Destruction Gadget"
	quest.6264FFAD4D805503.quest_subtitle: "Clear a room in seconds"
	quest.6264FFAD4D805503.quest_desc: [
		"&eWhat:&r removes a box of blocks in front of you, sized however you like. It can undo its last action."
		"&eHow:&r check JEI. Set the depth, width and height in its menu."
		"&eTip:&r perfect for hollowing out a hillside for a new factory floor."
	]
	quest.256D3D0FC72501EE.title: "Rechiseled"
	quest.256D3D0FC72501EE.quest_subtitle: "Hundreds of block patterns"
	quest.256D3D0FC72501EE.quest_desc: [
		"&eWhat:&r Rechiseled's chisel turns stone, planks, metal blocks and more into patterns: bricks, tiles, pillars, gears."
		"&eHow:&r an iron ingot on a stick (check JEI). Right-click to open it, put blocks in and pick a pattern."
		"&eTip:&r iron and copper block patterns make a machine room look deliberate."
	]
	quest.725D51E935DF32C0.title: "Connected Textures"
	quest.725D51E935DF32C0.quest_subtitle: "Patterns that merge with their neighbours"
	quest.725D51E935DF32C0.quest_desc: [
		"&eWhat:&r every Rechiseled pattern has a connecting version whose texture joins up with the same block next to it, so a wall reads as one panel."
		"&eHow:&r chisel any sixteen connecting blocks of stone bricks, cobblestone, planks, iron or copper (the chisel shows the connecting versions next to the plain ones)."
		"&eTip:&r mix plain and connecting versions to frame a window or a doorway."
	]
	quest.17B2684DCFCAF116.title: "Framed Blocks"
	quest.17B2684DCFCAF116.quest_subtitle: "Any shape, any texture"
	quest.17B2684DCFCAF116.quest_desc: [
		"&eWhat:&r FramedBlocks are wooden frames that take the look of any block you right-click into them, in dozens of shapes."
		"&eHow:&r framed cubes are planks and sticks (check JEI). Right-click one with a full block to apply it; the Framed Hammer takes it off."
		"&eTip:&r camouflage with glass, ores or machine casings: the block keeps its shape and takes the texture."
	]
	quest.43AAE4F773290CA0.title: "Slopes and Panels"
	quest.43AAE4F773290CA0.quest_subtitle: "Six framed shapes"
	quest.43AAE4F773290CA0.quest_desc: [
		"&eWhat:&r any six framed slopes, corner slopes, stairs, slabs, panels, pillars or prisms."
		"&eHow:&r each shape is made from framed cubes (check JEI). Most come several at a time."
		"&eTip:&r framed slopes camouflaged as stone make roofs and ramps that look hand-carved."
	]
	quest.493C7E73D1EA248B.title: "Secret Storage"
	quest.493C7E73D1EA248B.quest_subtitle: "A chest that looks like a wall"
	quest.493C7E73D1EA248B.quest_desc: [
		"&eWhat:&r a full-block chest that wears any block's texture, so it disappears into a wall."
		"&eHow:&r a framed chest surrounded by framed cubes (check JEI), then camouflage it."
		"&eTip:&r hide your rarest elements in one. Nobody suspects the third stone brick from the left."
	]
	quest.05D2EE647B7C6620.title: "Copycats"
	quest.05D2EE647B7C6620.quest_subtitle: "Create-style shape-shifting blocks"
	quest.05D2EE647B7C6620.quest_desc: [
		"&eWhat:&r Copycats+ adds many more Create copycat shapes: slopes, boards, beams, slices. Each takes the look of the block you apply."
		"&eHow:&r cut zinc ingots in a stonecutter (check JEI), then right-click a placed copycat with a block."
		"&eTip:&r copycat boards cover pipes and shafts while leaving them working."
	]
	quest.3D96DF2EBED7106F.title: "Know Your Rocks"
	quest.3D96DF2EBED7106F.quest_subtitle: "64 of any natural stone"
	quest.3D96DF2EBED7106F.quest_desc: [
		"&eWhat:&r stone, deepslate, andesite, diorite, granite, tuff or calcite, mixed as you like. Each has polished and brick forms."
		"&eChemistry:&r granite cooled slowly deep underground, so its quartz and feldspar crystals grew large. Tuff is welded volcanic ash, and calcite is CaCO₃."
		"&eTip:&r the Trowel (Quality of Life page) mixes them into a natural-looking wall."
	]
	quest.18FFF9220FA14F85.title: "Masonry"
	quest.18FFF9220FA14F85.quest_subtitle: "Clay, bricks and walls"
	quest.18FFF9220FA14F85.quest_desc: [
		"&eWhat:&r clay fires into bricks; stone bricks chisel into patterns; walls make fences mobs can't jump."
		"&eChemistry:&r clay is mostly kaolinite, Al₂Si₂O₅(OH)₄. Fired above about 900 °C it loses its water and sinters into hard, waterproof ceramic."
		"&eHow:&r dig clay from riverbeds and lush caves and smelt it. Chiseled stone bricks and walls come from the stonecutter."
	]
	quest.2C5BC26B96761435.title: "Mud Bricks"
	quest.2C5BC26B96761435.quest_subtitle: "The oldest building block there is"
	quest.2C5BC26B96761435.quest_desc: [
		"&eWhat:&r mud packs with wheat into packed mud, which cuts into warm brown mud bricks."
		"&eChemistry:&r sun-dried mud brick (adobe) binds clay particles with straw fibres; it hardens by drying, not by firing, so it needs a roof to stay dry."
		"&eHow:&r use a water bottle on dirt to make mud, craft it with wheat into packed mud, then four packed mud make mud bricks."
	]
	quest.72FA9BD36ABC0A23.title: "Deep Stone"
	quest.72FA9BD36ABC0A23.quest_subtitle: "Deepslate and tuff, cut and polished"
	quest.72FA9BD36ABC0A23.quest_desc: [
		"&eWhat:&r deepslate tiles and bricks, and tuff bricks from the trial chambers' palette: dark, heavy-looking stone for foundations."
		"&eChemistry:&r deepslate is a metamorphic rock: older stone squeezed and heated far underground until its minerals lined up in layers."
		"&eHow:&r any 32 of them, cut from cobbled deepslate or tuff in a stonecutter."
	]
	quest.4CCAAA543CAA3C63.title: "Coloured Sandstone"
	quest.4CCAAA543CAA3C63.quest_subtitle: "White, orange, red and black sand"
	quest.4CCAAA543CAA3C63.quest_desc: [
		"&eWhat:&r Biomes O' Plenty adds white, orange and black sands; each makes its own sandstone."
		"&eChemistry:&r white sand is nearly pure quartz (SiO₂), orange and red sand are stained by iron oxides, and black sand is ground volcanic rock rich in magnetite."
		"&eHow:&r any 32 sandstone blocks of any colour. Four sand make one sandstone."
	]
	quest.28C35CCC84851B27.title: "Rocks of Other Biomes"
	quest.28C35CCC84851B27.quest_subtitle: "Chalk, argillite and mossy stone"
	quest.28C35CCC84851B27.quest_desc: [
		"&eWhat:&r three building stones from Regions Unexplored biomes: white chalk, dark red argillite and mossy stone."
		"&eChemistry:&r chalk is CaCO₃ made of the tiny plates of ancient sea algae. Argillite is clay squeezed into hard rock."
		"&eHow:&r find the biomes with Nature's Compass (Quality of Life page) and mine the stone."
	]
	quest.65382426023CF47F.title: "Dripstone"
	quest.65382426023CF47F.quest_subtitle: "Stone that grows"
	quest.65382426023CF47F.quest_desc: [
		"&eWhat:&r pointed dripstone grows in dripstone caves; hanging under a water source, it slowly fills a cauldron below."
		"&eChemistry:&r dripping water loses CO₂ and leaves calcite behind: Ca(HCO₃)₂ → CaCO₃ + H₂O + CO₂. A real stalactite grows about a centimetre a century."
		"&eHow:&r mine both in a dripstone cave (Nature's Compass finds one)."
	]
	quest.6F93CF01FD65C4E4.title: "Amethyst"
	quest.6F93CF01FD65C4E4.quest_subtitle: "Purple quartz from a geode"
	quest.6F93CF01FD65C4E4.quest_desc: [
		"&eWhat:&r amethyst grows on budding amethyst inside underground geodes. Shards make spyglasses, tinted glass and blocks that chime."
		"&eChemistry:&r amethyst is quartz, SiO₂, coloured violet by traces of iron that natural radiation has turned into colour centres."
		"&eTip:&r never break the budding amethyst: it can't be moved and it's the only thing that grows more."
	]
	quest.7884D09F7FBE7978.title: "Building with Ice"
	quest.7884D09F7FBE7978.quest_subtitle: "Snow, packed ice and blue ice"
	quest.7884D09F7FBE7978.quest_desc: [
		"&eWhat:&r snow blocks, packed ice (it doesn't melt) and blue ice, the slipperiest block in the game."
		"&eChemistry:&r ice floats because hydrogen bonds lock water into an open hexagonal lattice, about 9% less dense than liquid water."
		"&eHow:&r 4 snowballs make a snow block; 9 ice make packed ice, 9 packed ice make blue ice. Icebergs have both."
	]
	quest.2E96863B3A582666.title: "Nether Masonry"
	quest.2E96863B3A582666.quest_subtitle: "Blackstone, gold-flecked stone and chains"
	quest.2E96863B3A582666.quest_desc: [
		"&eWhat:&r polished blackstone makes dark, gothic builds; gilded blackstone sparkles with gold; chains hang lanterns."
		"&eChemistry:&r gold in dark rock is how real gold is often found: hot water carries dissolved gold through cracks and drops it as it cools."
		"&eHow:&r polish blackstone in a stonecutter. Gilded blackstone is found in bastions. Chain: an iron ingot between two iron nuggets."
	]
	quest.7BC56F9F1A08CDFE.title: "Brimstone"
	quest.7BC56F9F1A08CDFE.quest_subtitle: "Yellow stone from the Nether's vents"
	quest.7BC56F9F1A08CDFE.quest_desc: [
		"&eWhat:&r Biomes O' Plenty's brimstone covers volcanic Nether biomes, around fumaroles that puff smoke."
		"&eChemistry:&r \"brimstone\" is the old name for sulfur. Real volcanic vents deposit yellow sulfur crystals as hot H₂S and SO₂ gases cool and react."
		"&eHow:&r mine brimstone in the Nether (Nature's Compass finds the biome) and craft or cut it into bricks."
	]
	quest.4A79D247060404DF.title: "End Stone"
	quest.4A79D247060404DF.quest_subtitle: "Pale stone from the void"
	quest.4A79D247060404DF.quest_desc: [
		"&eWhat:&r end stone and its bricks: pale yellow and very blast-resistant. Chorus plants grow only on it."
		"&eHow:&r mine end stone on any End island; 4 end stone make 4 end stone bricks."
		"&eTip:&r end stone resists explosions far better than cobblestone, so wall in anything that might blow."
	]
	quest.67DBBD7AA5F55B53.title: "Purpur"
	quest.67DBBD7AA5F55B53.quest_subtitle: "The End cities' purple stone"
	quest.67DBBD7AA5F55B53.quest_desc: [
		"&eWhat:&r purpur blocks and pillars are what End cities are built from."
		"&eHow:&r pop chorus fruit in a furnace, then four popped fruit make four purpur blocks; pillars come from the stonecutter."
		"&eTip:&r chorus plants regrow from their flowers on end stone, so you can farm purpur at home."
	]
	quest.543994DFEC92CC24.title: "Prismarine"
	quest.543994DFEC92CC24.quest_subtitle: "Sea-green stone from the monuments"
	quest.543994DFEC92CC24.quest_desc: [
		"&eWhat:&r prismarine bricks and dark prismarine, the stone of ocean monuments, made from guardians' shards."
		"&eChemistry:&r real sea creatures build shells from calcium carbonate and silica drawn out of seawater, which is where reef stone comes from."
		"&eHow:&r 9 prismarine shards make prismarine bricks; 8 shards around a black dye make dark prismarine."
	]
	quest.4CBE2411222CD187.title: "Undergarden Bricks"
	quest.4CBE2411222CD187.quest_subtitle: "Depthrock, shiverstone and tremblecrust"
	quest.4CBE2411222CD187.quest_desc: [
		"&eWhat:&r the Undergarden's stones cut into bricks and tiles: grey depthrock, icy shiverstone and cracked tremblecrust."
		"&eHow:&r mine the stone in the Undergarden and use a stonecutter or crafting grid (check JEI). Any 16."
		"&eTip:&r depthrock bricks make a fine floor for a room that should feel underground."
	]
	quest.1EFF31F216B0A852.title: "Twilight Stonework"
	quest.1EFF31F216B0A852.quest_subtitle: "Castle brick, mazestone and nagastone"
	quest.1EFF31F216B0A852.quest_desc: [
		"&eWhat:&r the Twilight Forest's ruins are built from stone you can take home: castle brick, mazestone, underbrick and the Naga's scaled stone."
		"&eHow:&r mine them in the Naga courtyard, the labyrinth and the castle (or craft them, check JEI). Any 16."
		"&eTip:&r castle brick is very hard to break, which makes it a sturdy outer wall."
	]
	quest.640E50DD7D601804.title: "A Stack of Logs"
	quest.640E50DD7D601804.quest_subtitle: "64 logs of any tree"
	quest.640E50DD7D601804.quest_desc: [
		"&eWhat:&r every wood in the pack has its own colour and grain. A full stack lets you try them side by side."
		"&eChemistry:&r wood is cellulose fibres glued with lignin. Lignin's aromatic rings are what turn wood brown when it ages in sunlight."
		"&eTip:&r Ultimine fells a whole tree at once, and saplings from each wood are worth keeping."
	]
	quest.2F7FCB7F23390898.title: "Finishing Touches"
	quest.2F7FCB7F23390898.quest_subtitle: "Paintings, a pumpkin, a cauldron, clean beams"
	quest.2F7FCB7F23390898.quest_desc: [
		"&eWhat:&r the small things that make a base feel lived in: paintings, a carved pumpkin, a cauldron and stripped-log beams."
		"&eChemistry:&r stripping a log takes off the bark, which is full of tannins: the same polyphenols that tan leather."
		"&eHow:&r painting: sticks around wool. Carve a pumpkin with shears. Cauldron: 7 iron. Use an axe on any log to strip it."
	]
	quest.3B851585EACE6464.title: "Timber Framing"
	quest.3B851585EACE6464.quest_subtitle: "Tudor walls, one frame at a time"
	quest.3B851585EACE6464.quest_desc: [
		"&eWhat:&r Supplementaries' timber frames, braces and cross braces sit over a wall to make half-timbered houses."
		"&eHow:&r craft them from sticks (check JEI), then right-click a frame with a block to fill it, like daub or plaster."
		"&eTip:&r white-filled frames over a stone ground floor read as a proper village house."
	]
	quest.246A5AAFE3775A41.title: "Biomes O' Plenty Woods"
	quest.246A5AAFE3775A41.quest_subtitle: "Pink jacaranda, blue magic, red maple"
	quest.246A5AAFE3775A41.quest_desc: [
		"&eWhat:&r Biomes O' Plenty grows a dozen new trees, from pale fir to bright pink jacaranda and blue magic wood."
		"&eHow:&r any 32 planks from its woods. Nature's Compass finds the biomes."
		"&eTip:&r maple and jacaranda leaves make colourful hedges with Macaw's Fences."
	]
	quest.7809708F7D0F4D22.title: "Regions Unexplored Woods"
	quest.7809708F7D0F4D22.quest_subtitle: "Baobab, eucalyptus, blackwood and more"
	quest.7809708F7D0F4D22.quest_desc: [
		"&eWhat:&r Regions Unexplored adds its own trees, including baobab, eucalyptus, larch, blackwood and the Nether's brimwood."
		"&eHow:&r any 32 planks from its woods."
		"&eChemistry:&r eucalyptus leaves are rich in eucalyptol (C₁₀H₁₈O), the oil that gives cough drops their smell."
	]
	quest.7B91ACF7CDEB60A8.title: "Twilight Woods"
	quest.7B91ACF7CDEB60A8.quest_subtitle: "Canopy, darkwood and the magic trees"
	quest.7B91ACF7CDEB60A8.quest_desc: [
		"&eWhat:&r the Twilight Forest's woods: twilight oak, canopy, mangrove, darkwood, and the planks of its four magic trees."
		"&eHow:&r any 32 planks. The magic trees' cores are worth more as machines than as planks, so cut their trunks instead."
		"&eTip:&r darkwood is nearly black; it pairs well with lab blocks."
	]
	quest.762B8F75291A727E.title: "Undergarden Woods"
	quest.762B8F75291A727E.quest_subtitle: "Smogstem, wigglewood and grongle"
	quest.762B8F75291A727E.quest_desc: [
		"&eWhat:&r three woods from trees that grow without sunlight in the Undergarden."
		"&eHow:&r any 32 smogstem, wigglewood or grongle planks."
		"&eChemistry:&r real plants can't grow without light; deep-sea and cave life lives on chemosynthesis instead, oxidising H₂S or methane for energy."
	]
	quest.178627D6806BC305.title: "Glass"
	quest.178627D6806BC305.quest_subtitle: "Sand, heat and a lot of light"
	quest.178627D6806BC305.quest_desc: [
		"&eWhat:&r a stack and a half of glass for windows, roofs and greenhouses."
		"&eChemistry:&r glass is mostly silica (SiO₂) melted with soda (Na₂CO₃) and lime (CaO), then cooled before it can crystallise."
		"&eHow:&r smelt sand. The pack's furnaces cook four times faster, so a stack is quick."
	]
	quest.30251E31D4E975EF.title: "Windows"
	quest.30251E31D4E975EF.quest_subtitle: "Framed windows, shutters and curtains"
	quest.30251E31D4E975EF.quest_desc: [
		"&eWhat:&r Macaw's Windows adds framed windows, shutters, curtains, blinds and parapets."
		"&eHow:&r any four framed windows (check JEI)."
		"&eTip:&r the Window Hammer reshapes a placed window without breaking it."
	]
	quest.07114D9980DA34B9.title: "Stained Glass"
	quest.07114D9980DA34B9.quest_subtitle: "Colour in the light"
	quest.07114D9980DA34B9.quest_desc: [
		"&eWhat:&r 8 glass around a dye make 8 stained glass. Beacon beams take the colour of glass above them."
		"&eChemistry:&r medieval stained glass got its colour from metal oxides: cobalt for blue, copper for green, and tiny gold particles for ruby red."
		"&eHow:&r any 16 stained glass of any colour."
	]
	quest.197D98DE81CF9972.title: "Tinted Glass"
	quest.197D98DE81CF9972.quest_subtitle: "A window that blocks light"
	quest.197D98DE81CF9972.quest_desc: [
		"&eWhat:&r tinted glass looks dark and lets no light through, so mobs can spawn behind it but you can still see in."
		"&eHow:&r one glass surrounded by four amethyst shards makes two (check JEI)."
		"&eTip:&r a tinted roof over a farm or a mob trap keeps it dark without hiding it."
	]
	quest.1E6741C429743AFC.title: "Create Glass"
	quest.1E6741C429743AFC.quest_subtitle: "Framed glass and wooden windows"
	quest.1E6741C429743AFC.quest_desc: [
		"&eWhat:&r Create's framed and tiled glass connect into large clean panes, and its windows come in every wood."
		"&eHow:&r eight framed or tiled glass and four windows of any wood (check JEI for the recipes)."
		"&eTip:&r framed glass over a row of machines lets you watch them work."
	]
	quest.514CBE346457B9F4.title: "Lanterns"
	quest.514CBE346457B9F4.quest_subtitle: "Light that hangs"
	quest.514CBE346457B9F4.quest_desc: [
		"&eWhat:&r lanterns sit on floors or hang from ceilings and chains, and give a little more light than a torch."
		"&eHow:&r a torch surrounded by iron nuggets (check JEI)."
		"&eTip:&r light keeps mobs from spawning: every dark corner of your base is a spawn point."
	]
	quest.452737A7575DCEAE.title: "Lighting Without Torches"
	quest.452737A7575DCEAE.quest_subtitle: "Glowstone, lamps and soul lanterns"
	quest.452737A7575DCEAE.quest_desc: [
		"&eWhat:&r glowstone gives the brightest block light; redstone lamps switch on and off; soul lanterns burn blue and dim."
		"&eChemistry:&r a flame glows because hot soot glows (incandescence). LEDs and glow-sticks give cold light (luminescence): electrons dropping between energy levels."
		"&eHow:&r glowstone from the Nether ceiling (4 dust per block); lamp: glowstone in redstone; soul lantern: a soul torch in iron nuggets."
	]
	quest.648DEB4A88E62AB0.title: "Froglights"
	quest.648DEB4A88E62AB0.quest_subtitle: "Three frogs, three colours"
	quest.648DEB4A88E62AB0.quest_desc: [
		"&eWhat:&r a frog that eats a small magma cube leaves a froglight. Its colour depends on the frog: temperate, warm or cold."
		"&eHow:&r raise tadpoles from a swamp in a temperate, a warm and a cold biome, then bring the three frogs to the Nether's magma cubes."
		"&eTip:&r a lead is the easiest way to walk frogs through a portal."
	]
	quest.7D8A60F5C4CE08DA.title: "Lamps and Lanterns"
	quest.7D8A60F5C4CE08DA.quest_subtitle: "Street lamps and chandeliers"
	quest.7D8A60F5C4CE08DA.quest_desc: [
		"&eWhat:&r Macaw's Lights adds street lamps, lanterns, garden lights and chandeliers."
		"&eHow:&r any four of them (check JEI)."
		"&eTip:&r street lamps along your paths keep mobs from spawning on the way home."
	]
	quest.2483BE5777A45DF0.title: "Lava Lamp"
	quest.2483BE5777A45DF0.quest_subtitle: "Groovy chemistry"
	quest.2483BE5777A45DF0.quest_desc: [
		"&eWhat:&r a lava lamp for your desk. This one really has lava in it."
		"&eChemistry:&r a real lava lamp holds wax in water. Heated wax expands, its density drops below the water's and it rises; at the top it cools and sinks."
		"&eHow:&r iron nuggets, a lava bucket and an iron ingot (check JEI)."
	]
	quest.0390136B315C41D8.title: "Create Deco Lamps"
	quest.0390136B315C41D8.quest_subtitle: "Industrial lights"
	quest.0390136B315C41D8.quest_desc: [
		"&eWhat:&r Create Deco lamps in four colours and five metals light up a factory floor properly."
		"&eHow:&r a nugget, a torch and a plate of the metal (check JEI). Any four lamps."
		"&eTip:&r lamps can be switched off with redstone: red ones make good warning lights by a reactor."
	]
	quest.51B454403AABBDE8.title: "Sea Lanterns and End Rods"
	quest.51B454403AABBDE8.quest_subtitle: "Cool white light"
	quest.51B454403AABBDE8.quest_desc: [
		"&eWhat:&r sea lanterns are bright, cold-looking light blocks; end rods are thin white light sticks."
		"&eHow:&r a sea lantern is prismarine shards and crystals from guardians; an end rod is a blaze rod on popped chorus fruit (check JEI)."
		"&eTip:&r sea lanterns under a glass floor light a room with no visible source."
	]
	quest.0F78BCE71FB73397.title: "Candles"
	quest.0F78BCE71FB73397.quest_subtitle: "Wax, wick and a holder"
	quest.0F78BCE71FB73397.quest_desc: [
		"&eWhat:&r candles stack up to four per block and come in every colour; Supplementaries adds holders for walls."
		"&eChemistry:&r a candle burns its own vapour: heat melts the wax, the wick draws it up, and the hot gas burns into CO₂ and water."
		"&eHow:&r honeycomb on string makes a candle; dye it any colour. Any 8 candles and a candle holder (check JEI)."
	]
	quest.2D5822B02C1D11FE.title: "Dyes"
	quest.2D5822B02C1D11FE.quest_subtitle: "Sixteen colours from flowers and more"
	quest.2D5822B02C1D11FE.quest_desc: [
		"&eWhat:&r dyes colour wool, glass, concrete, terracotta, beds, candles and banners."
		"&eChemistry:&r flower colours come from pigments like anthocyanins, which shift from red to blue with acidity: a natural pH indicator."
		"&eHow:&r any 16 dyes. Most come from flowers; check JEI for the odd ones (cocoa, ink, lapis, bone meal)."
	]
	quest.092DAF17C8D2C76B.title: "Wool"
	quest.092DAF17C8D2C76B.quest_subtitle: "Soft blocks in every colour"
	quest.092DAF17C8D2C76B.quest_desc: [
		"&eWhat:&r wool blocks for carpets, beds, banners and colourful walls."
		"&eChemistry:&r wool is keratin, the same protein as hair and feathers; its sulfur bridges are why it smells when singed."
		"&eHow:&r shear sheep, or craft four string into a block. Any 16 wool of any colour."
	]
	quest.58D18066FC360C5F.title: "Terracotta and Concrete"
	quest.58D18066FC360C5F.quest_subtitle: "Colour by the stack"
	quest.58D18066FC360C5F.quest_desc: [
		"&eWhat:&r terracotta is fired clay; concrete powder is sand, gravel and dye that sets into concrete when it touches water."
		"&eChemistry:&r real concrete doesn't dry, it reacts: calcium silicates in cement take up water and grow interlocking crystals. It even sets underwater."
		"&eHow:&r smelt clay blocks into terracotta; 4 sand, 4 gravel and a dye make 8 concrete powder."
	]
	quest.137A78BE4D530B8E.title: "Glazed Terracotta"
	quest.137A78BE4D530B8E.quest_subtitle: "Tiles with a pattern"
	quest.137A78BE4D530B8E.quest_desc: [
		"&eWhat:&r smelting dyed terracotta gives glazed tiles whose pattern changes with the way you face when placing them."
		"&eChemistry:&r a real glaze is a thin glassy coat of silica and metal oxides fused onto fired clay, which is why tiles are waterproof."
		"&eHow:&r dye terracotta, then smelt it. Any 8 glazed terracotta."
	]
	quest.013CE88A9AB4F827.title: "Painted Planks"
	quest.013CE88A9AB4F827.quest_subtitle: "Wood in bright colours"
	quest.013CE88A9AB4F827.quest_desc: [
		"&eWhat:&r Regions Unexplored's painted planks come in all sixteen colours, for beach huts and toy-box rooms."
		"&eHow:&r planks with a dye (check JEI). Any 16."
		"&eTip:&r painted planks with white trim make a cheerful kitchen."
	]
	quest.279EA09DBE9B96B1.title: "Banners"
	quest.279EA09DBE9B96B1.quest_subtitle: "A flag for your house"
	quest.279EA09DBE9B96B1.quest_desc: [
		"&eWhat:&r banners take patterns from a loom; put one on a shield to carry your colours."
		"&eHow:&r six wool and a stick make a banner; the loom adds dye patterns (check JEI)."
		"&eTip:&r design your team's banner once and copy it in a crafting grid."
	]
	quest.0882494FACF73614.title: "Somewhere to Sit"
	quest.0882494FACF73614.quest_subtitle: "Handcrafted chairs and a table"
	quest.0882494FACF73614.quest_desc: [
		"&eWhat:&r Handcrafted adds furniture you can sit on: chairs, couches, benches, tables and desks."
		"&eHow:&r any wood works (check JEI). Right-click a chair to sit."
		"&eTip:&r the Handcrafted Hammer changes the shape of trims and some other pieces."
	]
	quest.255AF1E86B0F49B5.title: "A Proper Study"
	quest.255AF1E86B0F49B5.quest_subtitle: "Couches and a desk"
	quest.255AF1E86B0F49B5.quest_desc: [
		"&eWhat:&r couches connect into long sofas; desks connect into long workbenches."
		"&eHow:&r any wood (check JEI). Cushions and sheets add colour."
		"&eTip:&r a desk by your Alchemistry machines makes a fine place to read the quest book."
	]
	quest.4E82A4FFCC6F1EEF.title: "Macaw's Furniture"
	quest.4E82A4FFCC6F1EEF.quest_subtitle: "Wardrobes, drawers and cabinets"
	quest.4E82A4FFCC6F1EEF.quest_desc: [
		"&eWhat:&r Macaw's Furniture adds kitchens, wardrobes, drawers, bookshelves and more. Many of them store items."
		"&eHow:&r any two wardrobes, drawers or kitchen cabinets (check JEI for the full set)."
		"&eTip:&r drawers and cabinets open like chests, so a kitchen can double as food storage."
	]
	quest.68CAAB42B831EDE3.title: "A Real Kitchen"
	quest.68CAAB42B831EDE3.quest_subtitle: "Counters, a cupboard and a hood"
	quest.68CAAB42B831EDE3.quest_desc: [
		"&eWhat:&r Handcrafted counters, cupboards and a kitchen hood to go over your Farmer's Delight stove."
		"&eChemistry:&r a kitchen hood is a small fume hood: it pulls away smoke and the acrolein that hot fat gives off."
		"&eHow:&r any wood (check JEI). Two counters, a cupboard and a hood."
	]
	quest.29FF8ECA18C57FD9.title: "A Bedroom"
	quest.29FF8ECA18C57FD9.quest_subtitle: "A fancy bed and a nightstand"
	quest.29FF8ECA18C57FD9.quest_desc: [
		"&eWhat:&r a four-poster fancy bed and a nightstand; sheets and cushions change their colours."
		"&eHow:&r any wood (check JEI). The fancy bed works like a normal bed."
		"&eTip:&r a sleeping bag for trips and a real bed at home: your spawn stays here."
	]
	quest.549537978C5E01CD.title: "Plates and Cups"
	quest.549537978C5E01CD.quest_subtitle: "Set the table"
	quest.549537978C5E01CD.quest_desc: [
		"&eWhat:&r plates, cups and bowls to put on tables. A plate can hold a piece of food for display."
		"&eChemistry:&r white porcelain is kaolin clay fired so hot (about 1,300 °C) that part of it turns to glass, sealing the pores."
		"&eHow:&r any four (check JEI for the wood, terracotta and coloured sets)."
	]
	quest.5E740E65B6A4BD53.title: "Doors"
	quest.5E740E65B6A4BD53.quest_subtitle: "Macaw's doors in every wood"
	quest.5E740E65B6A4BD53.quest_desc: [
		"&eWhat:&r Macaw's Doors adds barn, cottage, glass, modern and many more doors in every wood."
		"&eHow:&r any two barn, modern, glass or cottage doors (check JEI for recipes)."
		"&eTip:&r glass doors let you see into a machine room without opening it."
	]
	quest.06248880B960989A.title: "Trapdoors"
	quest.06248880B960989A.quest_subtitle: "Shutters and cabinet fronts"
	quest.06248880B960989A.quest_desc: [
		"&eWhat:&r decorative trapdoors that match the doors: barn, glass, classic and more."
		"&eHow:&r any four barn, glass or classic trapdoors (check JEI)."
		"&eTip:&r trapdoors on walls make great shutters and cabinet fronts."
	]
	quest.0730AC23E95DCD5A.title: "Roofs"
	quest.0730AC23E95DCD5A.quest_subtitle: "A roof that isn't flat"
	quest.0730AC23E95DCD5A.quest_desc: [
		"&eWhat:&r Macaw's Roofs adds sloped, steep, attic and top roof pieces that join into proper roofs."
		"&eHow:&r any sixteen roof pieces (check JEI). Wooden roofs come from logs and sticks."
		"&eTip:&r place the lower and upper pieces together to make a gentler slope."
	]
	quest.1C66E75AABEB8A04.title: "Fences and Hedges"
	quest.1C66E75AABEB8A04.quest_subtitle: "Picket, stockade, wired, hedge"
	quest.1C66E75AABEB8A04.quest_desc: [
		"&eWhat:&r Macaw's Fences adds picket and stockade fences, wired fences, hedges and gates."
		"&eHow:&r any eight picket, stockade or wired fences or hedges (check JEI)."
		"&eTip:&r hedges are made from leaves, so a garden can stay looking natural."
	]
	quest.18A99D3C296C1FAB.title: "Better Stairs"
	quest.18A99D3C296C1FAB.quest_subtitle: "Loft, skyline and terrace stairs"
	quest.18A99D3C296C1FAB.quest_desc: [
		"&eWhat:&r Macaw's Stairs adds loft, skyline, terrace, bulk and compact stairs that turn corners and climb steeply."
		"&eHow:&r any eight, in wood or stone (check JEI)."
		"&eTip:&r compact stairs fit a tight tower where vanilla stairs won't."
	]
	quest.2EB21B01D5819EFD.title: "Balconies and Railings"
	quest.2EB21B01D5819EFD.quest_subtitle: "A place to look out from"
	quest.2EB21B01D5819EFD.quest_desc: [
		"&eWhat:&r balconies, railings and platforms from Macaw's Stairs, matching the stairs' woods and stones."
		"&eHow:&r any six (check JEI)."
		"&eTip:&r a railing around the top of a tank or a vat keeps you from falling in."
	]
	quest.7E1544D1ED3E2D20.title: "Paths"
	quest.7E1544D1ED3E2D20.quest_subtitle: "Paving between your buildings"
	quest.7E1544D1ED3E2D20.quest_desc: [
		"&eWhat:&r Macaw's Paths adds paving patterns (basket weave, honeycomb, flagstone) in stone, brick and sandstone."
		"&eHow:&r any sixteen paving blocks (check JEI)."
		"&eTip:&r a path from your base to your waystone saves getting lost at night."
	]
	quest.2B01CBA33D88B363.title: "Bridges"
	quest.2B01CBA33D88B363.quest_subtitle: "Rope, stone and iron bridges"
	quest.2B01CBA33D88B363.quest_desc: [
		"&eWhat:&r Macaw's Bridges adds pieces that connect into rope, stone, brick and iron bridges, with piers and stairs."
		"&eHow:&r any eight bridge pieces (check JEI)."
		"&eTip:&r an iron bridge over a lava lake makes the Nether commute much safer."
	]
	quest.7659ED25F3732FB6.title: "A Garden"
	quest.7659ED25F3732FB6.quest_subtitle: "Pots, planters and flower boxes"
	quest.7659ED25F3732FB6.quest_desc: [
		"&eWhat:&r flower pots, Supplementaries planters (crops grow in them) and flower boxes for under windows."
		"&eChemistry:&r terracotta pots breathe: their open pores let water and air through, which keeps roots from rotting."
		"&eHow:&r a flower pot is three bricks; check JEI for the planter and flower box."
	]
	quest.03D3BCD07ADEA8B2.title: "A Raked Garden"
	quest.03D3BCD07ADEA8B2.quest_subtitle: "Calm lines in the gravel"
	quest.03D3BCD07ADEA8B2.quest_desc: [
		"&eWhat:&r Supplementaries' raked gravel: gravel with lines combed into it, for a quiet stone garden."
		"&eHow:&r use a hoe on gravel. The lines follow the direction you face."
		"&eTip:&r a few stones, a pond and a cherry tree finish the look."
	]
	quest.263D8CF775631953.title: "Jars"
	quest.263D8CF775631953.quest_subtitle: "Display jars for anything"
	quest.263D8CF775631953.quest_desc: [
		"&eWhat:&r Supplementaries jars hold items, liquids or small mobs, and show what's inside."
		"&eHow:&r glass and a wooden slab (check JEI). Right-click with an item or a bucket to fill."
		"&eTip:&r a shelf of jars, one per element, makes a lovely periodic table display."
	]
	quest.03F0CB824882681C.title: "Rope and Sacks"
	quest.03F0CB824882681C.quest_subtitle: "Flax, rope and a sack"
	quest.03F0CB824882681C.quest_desc: [
		"&eWhat:&r rope you can climb and pull things up with, and sacks that store items and can be carried."
		"&eHow:&r grow flax (seeds from wild flax), then craft rope and sacks from it (check JEI)."
		"&eTip:&r rope down a mineshaft is a quick way up and down (check JEI for the pulley block)."
	]
	quest.3916B5092992AE39.title: "Soap"
	quest.3916B5092992AE39.quest_subtitle: "The oldest chemistry in the house"
	quest.3916B5092992AE39.quest_desc: [
		"&eWhat:&r soap washes dye off coloured blocks and items, and it powers the Bubble Blower."
		"&eChemistry:&r saponification: wood ash is rich in potash (K₂CO₃), which makes lye in water; lye splits fat into glycerol and fatty-acid salts, which is soap."
		"&eHow:&r a water bucket, four ash and a porkchop (check JEI). Ash is left when fire burns blocks away."
	]
	quest.27402D05976252E6.title: "Bubbles!"
	quest.27402D05976252E6.quest_subtitle: "Secret: a demigod at play"
	quest.27402D05976252E6.quest_desc: [
		"&6You remember making nebulae. These are smaller, but they're very pretty.&r"
		"&eWhat:&r the Bubble Blower uses soap to blow bubbles; it can also make Bubble Blocks (check its tooltip)."
		"&eChemistry:&r a soap film is a thin water layer between two layers of soap molecules. Its colours come from light reflecting off both surfaces and interfering."
	]
	quest.25C658490DBB5144.title: "Bamboo Spikes"
	quest.25C658490DBB5144.quest_subtitle: "A garden of sharp sticks"
	quest.25C658490DBB5144.quest_desc: [
		"&eWhat:&r bamboo spikes hurt mobs that walk on them; coated with a lingering potion they poison them too."
		"&eHow:&r 4 bamboo over 3 wooden slabs (check JEI). Use a lingering potion on placed spikes to coat them."
		"&eTip:&r a ring of spikes around a farm keeps zombies off the crops."
	]
	quest.2524975807C1FBF5.title: "A Globe"
	quest.2524975807C1FBF5.quest_subtitle: "Spin the world on your desk"
	quest.2524975807C1FBF5.quest_desc: [
		"&eWhat:&r a desk globe that spins when you click it, showing a map of a made-up world."
		"&eHow:&r check JEI for the recipe."
		"&eTip:&r it belongs on the desk in your study, next to the quest book."
	]
	quest.5E1C2E115FDDD384.title: "Boards to Write On"
	quest.5E1C2E115FDDD384.quest_subtitle: "A notice board and a blackboard"
	quest.5E1C2E115FDDD384.quest_desc: [
		"&eWhat:&r the notice board shows a written book's page on a wall; the blackboard is a slate you can draw on pixel by pixel."
		"&eHow:&r check JEI for both; the blackboard's tooltip shows how to draw."
		"&eTip:&r write your reactor's recipe on a blackboard next to it, the way chemists do."
	]
	quest.7E4EC55723ECCA84.title: "Clocks and Hourglasses"
	quest.7E4EC55723ECCA84.quest_subtitle: "Know the time without a clock in hand"
	quest.7E4EC55723ECCA84.quest_desc: [
		"&eWhat:&r the clock block shows the time on a wall; the hourglass is a timer you fill with sand or other powders."
		"&eChemistry:&r a real hourglass works because dry sand flows at a steady rate no matter how full the glass is, unlike water."
		"&eHow:&r check JEI for both. Days here are twice as long, so the clock moves slowly in daylight."
	]
	quest.45A2DA8484F08FBE.title: "Flags and Bunting"
	quest.45A2DA8484F08FBE.quest_subtitle: "Wave your colours"
	quest.45A2DA8484F08FBE.quest_desc: [
		"&eWhat:&r flags that flutter in the wind and strings of bunting for a festival look."
		"&eHow:&r any flag and four bunting (check JEI). Flags take banner patterns too."
		"&eTip:&r a flag on top of each waystone makes it easy to spot from far away."
	]
	quest.163F940519BFFA36.title: "Mineral Blocks"
	quest.163F940519BFFA36.quest_subtitle: "Copper, lapis and quartz to build with"
	quest.163F940519BFFA36.quest_desc: [
		"&eWhat:&r copper blocks weather from orange to green; lapis and quartz blocks are the classic blue and white trims."
		"&eChemistry:&r copper turns green as it reacts with air, water and CO₂ into basic copper carbonate. Honeycomb wax stops it; an axe scrapes it back."
		"&eHow:&r 9 copper ingots or 9 lapis per block; 4 Nether quartz per quartz block."
	]
	quest.077AB858F0DCF3AB.title: "Copper Craft"
	quest.077AB858F0DCF3AB.quest_subtitle: "Grates, bulbs and chiseled copper"
	quest.077AB858F0DCF3AB.quest_desc: [
		"&eWhat:&r copper grates you can see through, copper bulbs that toggle with each redstone pulse, and chiseled copper."
		"&eChemistry:&r in game a bulb dims as it weathers. Real patina (basic copper carbonate) is a far poorer conductor than the bright metal under it, which is why electrical contacts are kept clean."
		"&eHow:&r cut copper blocks in a stonecutter; a bulb is copper blocks, a blaze rod and redstone (check JEI)."
	]
	quest.1FFEB1B954DDA3A3.title: "Bars and Gates"
	quest.1FFEB1B954DDA3A3.quest_subtitle: "Railings that let air through"
	quest.1FFEB1B954DDA3A3.quest_desc: [
		"&eWhat:&r iron bars make cages, windows and railings; Supplementaries iron gates open like fence gates."
		"&eChemistry:&r iron rusts into hydrated iron(III) oxide, Fe₂O₃·nH₂O; in game it never does, which is the only unrealistic thing about it."
		"&eHow:&r six iron ingots make 16 bars (check JEI for the gate)."
	]
	quest.5569DB7CD62C242F.title: "Hulls and Supports"
	quest.5569DB7CD62C242F.quest_subtitle: "Riveted walls and girders"
	quest.5569DB7CD62C242F.quest_desc: [
		"&eWhat:&r hulls are riveted metal walls; supports are girders for roofs and catwalks."
		"&eHow:&r any four hulls and four supports (check JEI)."
		"&eTip:&r copper hulls weather like copper blocks do. Wax them with honeycomb to keep the shine."
	]
	quest.2869546C48B8D313.title: "Catwalks"
	quest.2869546C48B8D313.quest_subtitle: "Walk above your machines"
	quest.2869546C48B8D313.quest_desc: [
		"&eWhat:&r Create Deco catwalks and railings: see-through metal floors for walking over a factory."
		"&eHow:&r any eight catwalks and four railings (check JEI)."
		"&eTip:&r catwalks over your pipes and belts keep everything reachable for repairs."
	]
	quest.1EDB5983AC99AF7D.title: "Showing Off"
	quest.1EDB5983AC99AF7D.quest_subtitle: "Secret: nine diamonds you'll never use"
	quest.1EDB5983AC99AF7D.quest_desc: [
		"&6You remember a throne cut from a single gem. A block of diamond on the mantelpiece is a start.&r"
		"&eWhat:&r a block of diamond, placed only to be looked at."
		"&eChemistry:&r a block's worth of real diamond would be about 3.5 tonnes of pure carbon. Burn it and you'd get about 13 tonnes of CO₂."
	]
	quest.1C1D96F956C3898C.title: "Laboratory Blocks"
	quest.1C1D96F956C3898C.quest_subtitle: "Clean white walls for a chemist"
	quest.1C1D96F956C3898C.quest_desc: [
		"&6You remember a laboratory of white stone and light. You can build it again.&r"
		"&eWhat:&r Artemis' Laboratory Blocks adds clean lab walls, tiles, glass, screens, vents and fans."
		"&eChemistry:&r the recipe uses Nether quartz, which is silicon dioxide (SiO₂), the same compound as sand and glass."
		"&eHow:&r eight stone around one Nether quartz makes eight laboratory blocks (check JEI)."
	]
	quest.231AB73D5B98BE94.title: "Glowing Panels"
	quest.231AB73D5B98BE94.quest_subtitle: "Walls that light the room"
	quest.231AB73D5B98BE94.quest_desc: [
		"&eWhat:&r glowing laboratory blocks give off light, so a lab can be bright with no torches."
		"&eHow:&r one glowstone dust makes eight glowstone particles; a particle plus a laboratory block makes a glowing block (check JEI)."
		"&eChemistry:&r real glow-in-the-dark materials store energy from light and release it slowly (phosphorescence)."
	]
	quest.302DFA9D7E8161B1.title: "Lab Screens"
	quest.302DFA9D7E8161B1.quest_subtitle: "Monitors on every wall"
	quest.302DFA9D7E8161B1.quest_desc: [
		"&eWhat:&r decorative screens: clear, text, wave and quantum patterns, plain or glowing."
		"&eHow:&r clear screens from laboratory blocks, laboratory glass and iron screws; add a dye for the patterns (check JEI)."
		"&eTip:&r put a wave screen beside your reactor and a ComputerCraft monitor next to it for real numbers."
	]
	quest.7827D1263B738EE4.title: "Fans and Vents"
	quest.7827D1263B738EE4.quest_subtitle: "Fume extraction"
	quest.7827D1263B738EE4.quest_desc: [
		"&eWhat:&r animated lab fans and vents. The redstone-controlled fan only spins when powered."
		"&eChemistry:&r real labs handle HCl, NH₃ and Cl₂ under a fume hood, which pulls vapours away from your face."
		"&eHow:&r laboratory blocks with iron nuggets and iron screws (check JEI)."
	]
	quest.63B9D8367D6914A8.title: "Lab Doors and Glass"
	quest.63B9D8367D6914A8.quest_subtitle: "See in, keep fumes out"
	quest.63B9D8367D6914A8.quest_desc: [
		"&eWhat:&r lab doors (solid, glass or mesh) and laboratory glass for viewing windows."
		"&eHow:&r doors from laboratory blocks; laboratory glass is eight glass around a laboratory block (check JEI)."
		"&eTip:&r a glass wall around your Alchemistry room lets visitors admire it without touching anything."
	]
	quest.6B89ABF777E12980.title: "Hazard Signs"
	quest.6B89ABF777E12980.quest_subtitle: "Label what can hurt you"
	quest.6B89ABF777E12980.quest_desc: [
		"&eWhat:&r Create Deco decals: radiation, fire, electrical and warning signs to stick on walls and doors."
		"&eChemistry:&r real labs label chemicals with hazard pictograms and the four-coloured fire diamond: blue for health, red for fire, yellow for reactivity, white for special hazards."
		"&eHow:&r any three hazard decals (check JEI)."
	]
	quest.4D60C7C6C5F73477.title: "A Proper Laboratory"
	quest.4D60C7C6C5F73477.quest_subtitle: "Build a lab worthy of you"
	quest.4D60C7C6C5F73477.quest_desc: [
		"&6White walls, humming fans, glass and light. You remember this place. It was always where you were happiest.&r"
		"&eWhat:&r a challenge: build a real laboratory around your chemistry machines with these blocks."
		"&eHow:&r include glowing panels, screens, a fume fan and a glass wall. Click the checkmark when you're proud of it."
	]
	chapter.1C4BA472D45EB848.title: "Bounty Board"
	chapter.1C4BA472D45EB848.chapter_subtitle: [
		"Bounties on every monster. Each one is just chemistry with bad manners."
	]
	quest.544849C91E73A547.title: "Zombie Hunter"
	quest.544849C91E73A547.quest_subtitle: "Kill 25 zombies"
	quest.544849C91E73A547.quest_desc: [
		"&6You remember when the dead stayed down out of respect. Time to remind them.&r"
		"&eWhat:&r the first bounty on the board. Each tier asks for more of the same mob and pays out a Hunter's Bounty."
		"&eHow:&r zombies spawn in the dark and at night everywhere. A sword and shield are all you need."
		"&eTip:&r zombies burn in daylight; fight at dawn and let the sun help."
	]
	quest.3A8571E358829A4E.title: "Zombie Slayer"
	quest.3A8571E358829A4E.quest_subtitle: "Optional: kill 100 zombies"
	quest.3A8571E358829A4E.quest_desc: [
		"&eWhat:&r a hundred zombies. You'll get there just by playing at night."
		"&eChemistry:&r rotten flesh really is rotten: bacteria break proteins into amines like putrescine and cadaverine, which is where the smell comes from."
		"&eTip:&r a simple dark room over a spawner (YUNG's dungeons have plenty) speeds this up."
	]
	quest.07FFFFC27D98A06B.title: "Bane of the Dead"
	quest.07FFFFC27D98A06B.quest_subtitle: "Optional: kill 500 zombies"
	quest.07FFFFC27D98A06B.quest_desc: [
		"&eWhat:&r five hundred. This one is for people who build mob farms."
		"&eHow:&r a zombie spawner trap with a killing floor, or a Smite sword and a lot of nights."
		"&eTip:&r Smite adds damage against all undead: zombies, skeletons, wither skeletons, phantoms and the Wither."
	]
	quest.07F520C4C9DCA26D.title: "Bone Collector"
	quest.07F520C4C9DCA26D.quest_subtitle: "Kill 25 skeletons"
	quest.07F520C4C9DCA26D.quest_desc: [
		"&eWhat:&r skeletons drop bones and arrows, and sometimes their bow."
		"&eChemistry:&r bone meal is crushed bone: calcium phosphate, a real phosphorus fertiliser for plants."
		"&eHow:&r raise your shield when they draw, then close in between shots."
		"&eTip:&r strafing sideways makes skeletons miss most of their arrows."
	]
	quest.3768FF31E575A11C.title: "Skeleton Slayer"
	quest.3768FF31E575A11C.quest_subtitle: "Optional: kill 100 skeletons"
	quest.3768FF31E575A11C.quest_desc: [
		"&eWhat:&r a hundred skeletons, and a full stack of bones for bone meal."
		"&eHow:&r keep killing them at night, or trap a skeleton spawner."
		"&eTip:&r a skeleton spawner farm is also an arrow farm."
	]
	quest.67858DD92CCB0EF4.title: "Ossuary"
	quest.67858DD92CCB0EF4.quest_subtitle: "Optional: kill 500 skeletons"
	quest.67858DD92CCB0EF4.quest_desc: [
		"&eWhat:&r five hundred skeletons. Build a farm."
		"&eHow:&r YUNG's skeleton dungeons have several spawners close together; trap them."
		"&eTip:&r Looting raises bone and arrow drops."
	]
	quest.2787A073A108D244.title: "Undead of Every Climate"
	quest.2787A073A108D244.quest_subtitle: "Husks, strays and drowned"
	quest.2787A073A108D244.quest_desc: [
		"&eWhat:&r the undead adapt to their biome: husks in deserts, strays in the snow, drowned in the water."
		"&eHow:&r husks don't burn in daylight; strays shoot slowness arrows; drowned may carry tridents."
		"&eTip:&r a drowned holding a trident can drop it. The trident is worth the hunt."
	]
	quest.6882F9EA87616B2D.title: "Tide Breaker"
	quest.6882F9EA87616B2D.quest_subtitle: "Optional: kill 100 drowned"
	quest.6882F9EA87616B2D.quest_desc: [
		"&eWhat:&r a hundred drowned, for copper ingots, nautilus shells and the occasional trident."
		"&eChemistry:&r fitting loot for the sea: copper resists seawater well, because it grows a protective skin of copper oxides and chlorides."
		"&eHow:&r rivers and oceans at night. Channeling or Impaling help."
	]
	quest.3FA449155D4FEA25.title: "Creeper Hunter"
	quest.3FA449155D4FEA25.quest_subtitle: "Kill 25 creepers"
	quest.3FA449155D4FEA25.quest_desc: [
		"&eWhat:&r creepers drop gunpowder, the oldest chemical explosive."
		"&eChemistry:&r gunpowder is potassium nitrate, charcoal and sulfur. The nitrate (KNO₃) supplies the oxygen: 2KNO₃ + S + 3C → K₂S + N₂ + 3CO₂."
		"&eHow:&r hit and step back; a creeper resets its fuse when you leave its range."
		"&eTip:&r a bow is the safest creeper tool there is."
	]
	quest.06935A94927B14A4.title: "Demolition Expert"
	quest.06935A94927B14A4.quest_subtitle: "Optional: kill 100 creepers"
	quest.06935A94927B14A4.quest_desc: [
		"&eWhat:&r a hundred creepers and a pile of gunpowder for TNT and rockets."
		"&eHow:&r keep hunting at night; a Knockback sword keeps them away from you."
		"&eTip:&r a creeper killed by a skeleton's arrow drops a music disc."
	]
	quest.7F28D5737D25033D.title: "Ssssilence"
	quest.7F28D5737D25033D.quest_subtitle: "Optional: kill 250 creepers"
	quest.7F28D5737D25033D.quest_desc: [
		"&eWhat:&r two hundred and fifty creepers. The world is quieter now."
		"&eHow:&r a mob farm, or many careful nights."
		"&eTip:&r cats scare creepers away from your base."
	]
	quest.0F182C0FD3BF28FC.title: "Spider Hunter"
	quest.0F182C0FD3BF28FC.quest_subtitle: "Kill 25 spiders"
	quest.0F182C0FD3BF28FC.quest_desc: [
		"&eWhat:&r spiders drop string and spider eyes."
		"&eChemistry:&r a fermented spider eye (eye + sugar + brown mushroom) turns potions into their opposites; real fermentation is microbes turning sugars into new compounds like ethanol and acids."
		"&eHow:&r spiders climb walls; build with an overhang to keep them out."
		"&eTip:&r spiders are neutral in daylight unless you hit them."
	]
	quest.68FD0B5C8685AEC6.title: "Arachnophobe"
	quest.68FD0B5C8685AEC6.quest_subtitle: "Optional: kill 100 spiders"
	quest.68FD0B5C8685AEC6.quest_desc: [
		"&eWhat:&r a hundred spiders, and enough string for every bow and wool block you need."
		"&eHow:&r spiders spawn on the surface at night; Bane of Arthropods helps."
		"&eTip:&r string from spiders makes wool: four string per block."
	]
	quest.6E22D2D1C73AD43E.title: "Cave Spiders"
	quest.6E22D2D1C73AD43E.quest_subtitle: "Kill 25 cave spiders"
	quest.6E22D2D1C73AD43E.quest_desc: [
		"&eWhat:&r small, poisonous spiders that only come from spawners in mineshafts and spider caves."
		"&eChemistry:&r milk cures poison in Minecraft; in reality there's no general antidote, and venoms are treated with antivenom antibodies."
		"&eHow:&r find a mineshaft or YUNG's spider cave and fight near the spawner. Carry milk."
		"&eTip:&r torches on and around the spawner stop it."
	]
	quest.30F228CCC8B496B2.title: "Pearl Diver"
	quest.30F228CCC8B496B2.quest_subtitle: "Kill 16 endermen"
	quest.30F228CCC8B496B2.quest_desc: [
		"&eWhat:&r endermen drop ender pearls: teleportation, eyes of ender and many machines."
		"&eHow:&r look at one to make it attack, then fight with your back to a 2-block-high gap; it can't follow under a low roof."
		"&eTip:&r endermen hate water. A rain storm sends them teleporting away."
	]
	quest.253114F2D024BB07.title: "Enderman Slayer"
	quest.253114F2D024BB07.quest_subtitle: "Kill 64 endermen"
	quest.253114F2D024BB07.quest_desc: [
		"&eWhat:&r a stack of kills and, with luck, a stack of pearls."
		"&eHow:&r warped forests in the Nether and the End are full of them."
		"&eTip:&r a carved pumpkin on your head lets you look at endermen safely."
	]
	quest.58C7893587424EDB.title: "Void Walker"
	quest.58C7893587424EDB.quest_subtitle: "Optional: kill 256 endermen"
	quest.58C7893587424EDB.quest_desc: [
		"&eWhat:&r four stacks of endermen. You'll need an End farm or a lot of patience."
		"&eHow:&r an enderman farm on the outer End islands is the classic way."
		"&eTip:&r endermites make endermen aggressive; that's how most End farms lure them."
	]
	quest.7E196F63F0F0A960.title: "Witch Hunt"
	quest.7E196F63F0F0A960.quest_subtitle: "Kill 10 witches"
	quest.7E196F63F0F0A960.quest_desc: [
		"&eWhat:&r witches throw potions and drink their own to heal. They drop redstone, glowstone, sugar and bottles."
		"&eChemistry:&r glowstone dust in-game is a brewing amplifier; real \"glow\" chemicals (like the zinc sulfide in glow paint) store light and release it slowly."
		"&eHow:&r rush them; at range they out-potion you. Milk clears their effects."
		"&eTip:&r swamp huts spawn witches over and over: a classic redstone farm."
	]
	quest.5518E80E2B9B731B.title: "Coven Breaker"
	quest.5518E80E2B9B731B.quest_subtitle: "Optional: kill 50 witches"
	quest.5518E80E2B9B731B.quest_desc: [
		"&eWhat:&r fifty witches and a pile of redstone and glowstone."
		"&eHow:&r a swamp hut farm, or raids (witches join them)."
		"&eTip:&r witches are immune to most potion damage; use a sword or bow."
	]
	quest.3789F700DBDAA49F.title: "Slime Time"
	quest.3789F700DBDAA49F.quest_subtitle: "Kill 25 slimes"
	quest.3789F700DBDAA49F.quest_desc: [
		"&eWhat:&r slimes split when killed; the smallest drop slimeballs for sticky pistons and leads."
		"&eChemistry:&r real slime is a polymer gel: long molecules cross-linked loosely enough to flow, like borax and PVA glue."
		"&eHow:&r slimes spawn in swamps at night and in slime chunks underground."
		"&eTip:&r every split counts as a kill. A big slime is many kills."
	]
	quest.63D72081F346D7E0.title: "Night Terrors"
	quest.63D72081F346D7E0.quest_subtitle: "Kill 10 phantoms"
	quest.63D72081F346D7E0.quest_desc: [
		"&eWhat:&r phantoms dive at players who haven't slept for three nights. Their membranes repair elytra."
		"&eHow:&r stay up three nights, then fight with a bow on open ground at night."
		"&eTip:&r once you're done, sleep: it resets the timer and phantoms stop coming."
	]
	quest.6349CF403F409E40.title: "Skyclearer"
	quest.6349CF403F409E40.quest_subtitle: "Optional: kill 50 phantoms"
	quest.6349CF403F409E40.quest_desc: [
		"&eWhat:&r fifty phantoms, and enough membranes to keep an elytra flying for a long time."
		"&eHow:&r a bow with Power, or a trident with Loyalty, and a sleepless week."
		"&eTip:&r phantoms are undead; Smite works on them."
	]
	quest.7C77F3713A93792F.title: "Pest Control"
	quest.7C77F3713A93792F.quest_subtitle: "Optional: kill 50 silverfish"
	quest.7C77F3713A93792F.quest_desc: [
		"&eWhat:&r silverfish hide in infested stone in strongholds and mountains, and call their friends when hurt."
		"&eHow:&r YUNG's strongholds are full of infested blocks; a single blow kills each one."
		"&eTip:&r don't break blocks near a silverfish fight; you'll wake more."
	]
	quest.5B7746A8D5C8363A.title: "The Trials"
	quest.5B7746A8D5C8363A.quest_subtitle: "Kill 10 breezes and 10 bogged"
	quest.5B7746A8D5C8363A.quest_desc: [
		"&eWhat:&r two mobs from 1.21: breezes (wind spirits) and bogged (mossy skeletons with poison arrows), both from trial chambers."
		"&eHow:&r find a trial chamber (see the Exploration page) and fight the trial spawners."
		"&eTip:&r breeze rods make wind charges and the mace."
	]
	quest.325CC7A411B2A8F9.title: "Pillager Hunter"
	quest.325CC7A411B2A8F9.quest_subtitle: "Kill 25 pillagers"
	quest.325CC7A411B2A8F9.quest_desc: [
		"&eWhat:&r crossbow-armed illagers from outposts and patrols."
		"&eHow:&r a shield blocks their bolts. Outposts respawn pillagers around the tower."
		"&eTip:&r a captain (banner on its head) gives Bad Omen when killed: drink the ominous bottle to start a raid."
	]
	quest.4AB7BA8E5DA7EFFF.title: "Outpost Breaker"
	quest.4AB7BA8E5DA7EFFF.quest_subtitle: "Optional: kill 100 pillagers"
	quest.4AB7BA8E5DA7EFFF.quest_desc: [
		"&eWhat:&r a hundred pillagers."
		"&eHow:&r camp an outpost or run raids. Raids bring them in waves."
		"&eTip:&r a raid farm is the best emerald source in the game."
	]
	quest.24E4368C41967996.title: "Axes of Malice"
	quest.24E4368C41967996.quest_subtitle: "Kill 10 vindicators"
	quest.24E4368C41967996.quest_desc: [
		"&eWhat:&r axe-wielding illagers from raids and woodland mansions. They hit very hard."
		"&eHow:&r keep your shield up; their axes can disable it, so back off after a block."
		"&eTip:&r a vindicator named \"Johnny\" attacks every mob in sight."
	]
	quest.3E29A8FDA2E99B04.title: "Evoker Bane"
	quest.3E29A8FDA2E99B04.quest_subtitle: "Kill 3 evokers"
	quest.3E29A8FDA2E99B04.quest_desc: [
		"&eWhat:&r evokers summon fangs and vexes. Each one drops a Totem of Undying."
		"&eHow:&r they come in later raid waves and live in woodland mansions. Kill the evoker first; its vexes die with it."
		"&eTip:&r keep a totem in your off-hand when fighting raids."
	]
	quest.19A9413C7BECB803.title: "Beast of the Raid"
	quest.19A9413C7BECB803.quest_subtitle: "Kill 3 ravagers"
	quest.19A9413C7BECB803.quest_desc: [
		"&eWhat:&r ravagers are huge raid beasts that trample crops and charge."
		"&eHow:&r they appear in raids from wave 3 on. Block the charge with a shield, then counterattack while it's stunned."
		"&eTip:&r ravagers drop saddles."
	]
	quest.502A6AE02C3F21B9.title: "Guardian Hunter"
	quest.502A6AE02C3F21B9.quest_subtitle: "Kill 25 guardians"
	quest.502A6AE02C3F21B9.quest_desc: [
		"&eWhat:&r the spiky fish of ocean monuments. They drop prismarine shards and crystals."
		"&eChemistry:&r prismarine is in-game sea crystal; real sea creatures build shells and spines from calcium carbonate and silica pulled out of seawater."
		"&eHow:&r find a monument (see the Exploration page). Break line of sight when their laser charges."
		"&eTip:&r water breathing and Depth Strider make monuments much easier."
	]
	quest.3B3FCDB389203401.title: "Gold in the Rot"
	quest.3B3FCDB389203401.quest_subtitle: "Kill 50 zombified piglins"
	quest.3B3FCDB389203401.quest_desc: [
		"&eWhat:&r zombified piglins drop gold nuggets and rotten flesh."
		"&eHow:&r they're neutral until you hit one, then the whole crowd comes. Fight in a corridor."
		"&eTip:&r gold farms over Nether-roof portals are a classic build."
	]
	quest.25C1958DAE2F684A.title: "Blaze Hunter"
	quest.25C1958DAE2F684A.quest_subtitle: "Kill 25 blazes"
	quest.25C1958DAE2F684A.quest_desc: [
		"&eWhat:&r blazes drop blaze rods: brewing stands, blaze powder and eyes of ender."
		"&eChemistry:&r blazes throw fireballs; real fireballs need fuel plus oxygen, which is why a fire triangle (heat, fuel, O₂) puts them out when you remove any side."
		"&eHow:&r blaze spawners sit in Nether fortresses. Snowballs hurt them."
		"&eTip:&r fire resistance makes you immune to their fireballs."
	]
	quest.701B865E5BC4BFC5.title: "Blaze Slayer"
	quest.701B865E5BC4BFC5.quest_subtitle: "Optional: kill 100 blazes"
	quest.701B865E5BC4BFC5.quest_desc: [
		"&eWhat:&r a hundred blazes and a good supply of rods."
		"&eHow:&r build a blaze farm around a fortress spawner."
		"&eTip:&r blaze rods are a good furnace fuel: 12 items each."
	]
	quest.4BDCC9A8EB40A6B9.title: "Ghastbuster"
	quest.4BDCC9A8EB40A6B9.quest_subtitle: "Kill 10 ghasts"
	quest.4BDCC9A8EB40A6B9.quest_desc: [
		"&eWhat:&r ghasts drop ghast tears (regeneration potions, end crystals) and gunpowder."
		"&eHow:&r hit their fireballs back at them with a sword or an arrow."
		"&eTip:&r kill them over solid ground, not lava, or the tear is lost."
	]
	quest.6C85B3B27CEA7AB0.title: "Hot Jelly"
	quest.6C85B3B27CEA7AB0.quest_subtitle: "Kill 50 magma cubes"
	quest.6C85B3B27CEA7AB0.quest_desc: [
		"&eWhat:&r magma cubes split like slimes and drop magma cream for fire resistance."
		"&eHow:&r basalt deltas are full of them."
		"&eTip:&r every split counts as a kill."
	]
	quest.38A42A798875518D.title: "Skull Hunter"
	quest.38A42A798875518D.quest_subtitle: "Kill 25 wither skeletons"
	quest.38A42A798875518D.quest_desc: [
		"&eWhat:&r tall black skeletons in Nether fortresses. They sometimes drop their skull; three summon the Wither."
		"&eHow:&r fight in a 2-block-high tunnel; they're three blocks tall and can't follow."
		"&eTip:&r Looting raises the skull drop chance."
	]
	quest.3C7A0FC62606150B.title: "Bonebreaker"
	quest.3C7A0FC62606150B.quest_subtitle: "Optional: kill 100 wither skeletons"
	quest.3C7A0FC62606150B.quest_desc: [
		"&eWhat:&r a hundred wither skeletons, and enough skulls for several Withers."
		"&eHow:&r a wither skeleton farm on a fortress platform."
		"&eTip:&r a Smite sword kills them quickly."
	]
	quest.6463056EC87BB840.title: "Bastion Brawl"
	quest.6463056EC87BB840.quest_subtitle: "Kill 5 piglin brutes and 10 hoglins"
	quest.6463056EC87BB840.quest_desc: [
		"&eWhat:&r the toughest regular Nether fighters: axe-armed piglin brutes in bastions and charging hoglins in crimson forests."
		"&eChemistry:&r hoglins fear warped fungus; real animals avoid many plant compounds, which evolved as chemical defences."
		"&eHow:&r brutes ignore gold armour; fight them in doorways. Hoglins drop pork and leather."
		"&eTip:&r hoglins turn into zoglins in the Overworld, so don't bring one home."
	]
	quest.0BA05583E0D3118B.title: "Shell Game"
	quest.0BA05583E0D3118B.quest_subtitle: "Kill 20 shulkers"
	quest.0BA05583E0D3118B.quest_desc: [
		"&eWhat:&r shulkers hide in End Cities and drop shells for shulker boxes."
		"&eHow:&r hit them when their shell opens. Their bullets make you levitate."
		"&eTip:&r carry milk or slow falling against levitation."
	]
	quest.4DAB5F2E15BD1E7F.title: "The Rotspawn"
	quest.4DAB5F2E15BD1E7F.quest_subtitle: "Undergarden's rotting horde"
	quest.4DAB5F2E15BD1E7F.quest_desc: [
		"&eWhat:&r the Undergarden's undead-like rotspawn: small rotlings, tall rotwalkers and the huge rotbeast."
		"&eHow:&r utherium weapons deal extra damage to rotspawn."
		"&eTip:&r rotbeasts hit hard and have a lot of health; fight them in the open."
	]
	quest.3E7FE9B8E21A772D.title: "Things in the Dark"
	quest.3E7FE9B8E21A772D.quest_subtitle: "Nargoyles and munchers"
	quest.3E7FE9B8E21A772D.quest_desc: [
		"&eWhat:&r more Undergarden predators: nargoyles and the hungry munchers."
		"&eHow:&r explore the Undergarden at length; both turn up in its caverns."
		"&eTip:&r cloggrum armour is the Undergarden's best early protection."
	]
	quest.23851676A0A2DF97.title: "Sculk Fauna"
	quest.23851676A0A2DF97.quest_subtitle: "Snappers and centipedes"
	quest.23851676A0A2DF97.quest_desc: [
		"&eWhat:&r creatures of the Otherside, grown from sculk."
		"&eHow:&r roam the Otherside's biomes. Sneak to approach without alerting the sculk."
		"&eTip:&r carry food and a way home; the Otherside is a long way from your base."
	]
	quest.6C4CA5C87E1715D4.title: "Shattered and Stalkers"
	quest.6C4CA5C87E1715D4.quest_subtitle: "The Otherside's hunters"
	quest.6C4CA5C87E1715D4.quest_desc: [
		"&eWhat:&r shattered drop sculk bones; stalkers drop soul crystals. Both go into the soul elytra."
		"&eHow:&r both hunt by sound like the Warden. Fight at range."
		"&eTip:&r sneak to keep your footsteps quiet."
	]
	quest.5E83D1D3C67233ED.title: "Martian Raptors"
	quest.5E83D1D3C67233ED.quest_subtitle: "Optional: kill 10 raptors on Mars"
	quest.5E83D1D3C67233ED.quest_desc: [
		"&eWhat:&r fast predators of the Martian surface."
		"&eChemistry:&r anything living on Mars would need to cope with perchlorates (ClO₄⁻), reactive salts found in real Martian soil."
		"&eHow:&r land on Mars and hunt in the wastelands. Keep your suit topped up."
	]
	quest.68D285E63CF52E20.title: "Twilight Pests"
	quest.68D285E63CF52E20.quest_subtitle: "Redcaps, kobolds and swarm spiders"
	quest.68D285E63CF52E20.quest_desc: [
		"&eWhat:&r the common hostile mobs of the Twilight Forest."
		"&eHow:&r redcaps and kobolds roam the forest; swarm spiders spawn around hollow hills and spider-infested spots."
		"&eTip:&r redcap sappers carry TNT; kill them before they light it."
	]
	quest.7506A7C163583FD3.title: "Maze and Swamp"
	quest.7506A7C163583FD3.quest_subtitle: "Minotaurs, maze slimes and druids"
	quest.7506A7C163583FD3.quest_desc: [
		"&eWhat:&r guardians of the labyrinth and the swamp beyond the Lich."
		"&eHow:&r minotaurs and maze slimes fill the labyrinth; skeleton druids lurk in the forest at night."
		"&eTip:&r maze slimes split like regular slimes."
	]
	quest.260C93AB006F87B1.title: "Goblins and Ghastguards"
	quest.260C93AB006F87B1.quest_subtitle: "Stronghold and Dark Tower guards"
	quest.260C93AB006F87B1.quest_desc: [
		"&eWhat:&r goblin knights and block-and-chain goblins hold the Goblin Stronghold; carminite ghastguards haunt the Dark Tower."
		"&eHow:&r goblin knights ride in pairs; knock off the upper one, then finish the lower."
		"&eTip:&r ghastguards' fireballs can be hit back like a ghast's."
	]
	quest.4D50CBE90F48364F.title: "Snow Beasts"
	quest.4D50CBE90F48364F.quest_subtitle: "Yetis and winter wolves"
	quest.4D50CBE90F48364F.quest_desc: [
		"&eWhat:&r the snowy forest's hunters. Yetis drop arctic fur for warm armour."
		"&eHow:&r yetis guard the Alpha Yeti's cave; winter wolves roam the snowy forest and breathe frost."
		"&eTip:&r winter wolves come in packs; back against a tree."
	]
	quest.141CF02320F05EF3.title: "Trolls and Giants"
	quest.141CF02320F05EF3.quest_subtitle: "Optional: the highlands' heavyweights"
	quest.141CF02320F05EF3.quest_desc: [
		"&eWhat:&r trolls in the troll caves and giant miners on the highlands."
		"&eHow:&r trolls throw rocks; giants swing slowly but hard. Fight both from range."
		"&eTip:&r giant miners drop giant pickaxes."
	]
	quest.68F983645DEC5133.title: "Elder Guardians"
	quest.68F983645DEC5133.quest_subtitle: "All three elders of a monument"
	quest.68F983645DEC5133.quest_desc: [
		"&eWhat:&r each ocean monument holds three elder guardians. They cast Mining Fatigue until all three are dead."
		"&eHow:&r the elders sit in the top room and two wing rooms. Water breathing, a good sword and patience."
		"&eTip:&r elders drop wet sponges and, sometimes, a tide armour trim."
	]
	quest.62C34C9BAFF44652.title: "The Wither"
	quest.62C34C9BAFF44652.quest_subtitle: "Summon it, kill it, take its star"
	quest.62C34C9BAFF44652.quest_desc: [
		"&6You remember making stars. This one you'll have to take.&r"
		"&eWhat:&r the Wither is the Nether's boss, summoned by the player. It drops a Nether Star for beacons and many late recipes."
		"&eHow:&r four soul sand in a T with three wither skeleton skulls on top. Summon it deep underground or far from base: it destroys blocks."
		"&eTip:&r below half health it gains armour that stops arrows; switch to a Smite sword."
	]
	quest.1FC08840A62F5E10.title: "Web Breaker"
	quest.1FC08840A62F5E10.quest_subtitle: "Optional: kill 250 spiders"
	quest.1FC08840A62F5E10.quest_desc: [
		"&eWhat:&r two hundred and fifty spiders. Every web in the world is a little emptier."
		"&eChemistry:&r spider silk is a protein whose chains line up into tiny crystals; weight for weight it is tougher than steel."
		"&eHow:&r a spider spawner farm, or long nights on the surface with Bane of Arthropods."
	]
	quest.0ED1FFC46C9E2AB1.title: "Hexbreaker"
	quest.0ED1FFC46C9E2AB1.quest_subtitle: "Optional: kill 100 witches"
	quest.0ED1FFC46C9E2AB1.quest_desc: [
		"&eWhat:&r a hundred witches, and enough redstone and glowstone to light a city."
		"&eHow:&r a swamp hut farm is the only sane way; raids help too."
		"&eTip:&r witches drink fire resistance when burning, so lava traps work poorly on them."
	]
	quest.366C7B835BCEAFC9.title: "Flame Tamer"
	quest.366C7B835BCEAFC9.quest_subtitle: "Optional: kill 250 blazes"
	quest.366C7B835BCEAFC9.quest_desc: [
		"&eWhat:&r two hundred and fifty blazes: a lifetime supply of rods for brewing and fuel."
		"&eChemistry:&r a blaze is fire you can kill. Real fire is just a fast oxidation reaction feeding on its own heat."
		"&eHow:&r a blaze spawner farm in a fortress, with a killing floor and a collector."
	]
	quest.2070E34AD15C08E3.title: "Skullcrusher"
	quest.2070E34AD15C08E3.quest_subtitle: "Optional: kill 250 wither skeletons"
	quest.2070E34AD15C08E3.quest_desc: [
		"&eWhat:&r two hundred and fifty wither skeletons, and a crate of skulls."
		"&eHow:&r a wither skeleton farm on a cleared fortress platform; the skeletons spawn on nether bricks."
		"&eTip:&r coal and stone swords from them are worth smelting or dissolving, not keeping."
	]
	quest.63D08B7887BD0581.title: "Moon Raiders"
	quest.63D08B7887BD0581.quest_subtitle: "Optional: corrupted lunarians and star crawlers"
	quest.63D08B7887BD0581.quest_desc: [
		"&eWhat:&r the Moon's wastelands are home to corrupted lunarians and star crawlers. Both attack on sight."
		"&eChemistry:&r the Moon has no air to carry sound or heat, so a fight there is silent and the sun side of a rock is scorching."
		"&eHow:&r land on the Moon and roam the lunar wastelands. Keep your suit's oxygen topped up."
	]
	quest.2BBA78281DF31A7E.title: "Venusian Hunt"
	quest.2BBA78281DF31A7E.quest_subtitle: "Optional: sulfur creepers, moglers and pygros"
	quest.2BBA78281DF31A7E.quest_desc: [
		"&eWhat:&r Venus's barrens crawl with sulfur creepers, charging moglers and zombified pygros."
		"&eChemistry:&r real Venus has clouds of sulfuric acid (H₂SO₄) over a 460 °C surface, which is why its creepers come in sulfur."
		"&eHow:&r land on Venus in a heat-shielded suit and hunt the wastelands. Fight on solid ground away from the lava."
	]
	quest.6289ECF868508BE4.title: "Spoils: Rotten Flesh"
	quest.6289ECF868508BE4.quest_subtitle: "Optional: the least wanted drop, put to use"
	quest.6289ECF868508BE4.quest_desc: [
		"&eWhat:&r a stack of rotten flesh. Nobody wants to eat it, but your Dissolver does."
		"&eChemistry:&r the Dissolver breaks one rotten flesh into 3 protein. Proteins are chains of amino acids joined by peptide bonds (–CO–NH–); rotting is bacteria cutting those chains."
		"&eHow:&r keep the flesh from your zombie hunts instead of throwing it away."
		"&eTip:&r dissolve the protein again and it gives ammonia, CO₂, ethylene and sulfur; the sulfur comes from the amino acids cysteine and methionine."
	]
	quest.0957B507E7B098AB.title: "Spoils: Bones"
	quest.0957B507E7B098AB.quest_subtitle: "Optional: calcium phosphate on legs"
	quest.0957B507E7B098AB.quest_desc: [
		"&eWhat:&r a stack of bones: bone meal, bone blocks and a mineral the Dissolver can use."
		"&eChemistry:&r bone is mostly hydroxyapatite, Ca₅(PO₄)₃OH. Half the time the Dissolver gives 3 of it per bone: calcium and phosphorus in one crystal."
		"&eHow:&r keep the bones from skeletons."
		"&eTip:&r hydroxyapatite is also what tooth enamel is made of; fluoride toothpaste swaps OH⁻ for F⁻ to make it harder."
	]
	quest.6FD9C1EAEB0CC958.title: "Spoils: Silk and Eyes"
	quest.6FD9C1EAEB0CC958.quest_subtitle: "Optional: string and spider eyes"
	quest.6FD9C1EAEB0CC958.quest_desc: [
		"&eWhat:&r string for bows, wool and machines, and spider eyes for brewing."
		"&eChemistry:&r in the Dissolver, string gives keratin and a spider eye gives beta-carotene and chitin. Real spider silk is a different protein, spidroin, and is tougher than steel for its weight."
		"&eHow:&r keep the drops from your spider hunts. Witches drop spider eyes too."
		"&eTip:&r beta-carotene is the orange pigment in carrots; your body splits it into vitamin A."
	]
	quest.0218B2F222BDDB89.title: "Spoils: The Witch's Pantry"
	quest.0218B2F222BDDB89.quest_subtitle: "Optional: glowstone, sugar and bottles"
	quest.0218B2F222BDDB89.quest_desc: [
		"&eWhat:&r the ingredients witches carry: glowstone dust, sugar and empty bottles."
		"&eChemistry:&r the Dissolver breaks glowstone dust into 4 phosphorus and sugar into sucrose, C₁₂H₂₂O₁₁. Glass itself is mostly SiO₂, melted with soda (Na₂CO₃) and lime so it softens at a workable heat."
		"&eHow:&r keep the drops from witches; swamp huts respawn them."
		"&eTip:&r sucrose in the Dissolver is one of the easiest early sources of carbon, hydrogen and oxygen."
	]
	quest.0CD244DAA913DA26.title: "The Trident"
	quest.0CD244DAA913DA26.quest_subtitle: "Optional: take it from a drowned"
	quest.0CD244DAA913DA26.quest_desc: [
		"&eWhat:&r the only trident in the game is the one a drowned carries. It can't be crafted."
		"&eHow:&r fight drowned in rivers and oceans; only those holding a trident can drop one, and it's rare. Looting helps."
		"&eTip:&r enchant it with Loyalty to have it fly back, Riptide to launch yourself in rain, or Channeling to call lightning."
	]
	chapter.3FC1F772A8F79D5D.title: "Lab Notebook"
	chapter.3FC1F772A8F79D5D.chapter_subtitle: [
		"Why it works: the real chemistry behind every machine in the pack."
	]
	quest.54D480148A428377.title: "Note: Why Alloys Are Harder"
	quest.54D480148A428377.quest_subtitle: "Bronze and the sliding-layer problem"
	quest.54D480148A428377.quest_desc: [
		"&6You open a notebook in your own handwriting. The first page is about bronze.&r"
		"&eWhat:&r a pure metal is soft because its atoms sit in neat layers that slide past each other."
		"&eChemistry:&r add a few bigger or smaller atoms (tin in copper) and the layers jam. Bronze is about 88% Cu, 12% Sn."
		"&eTip:&r tick this when you've read both pages. Lab notes never block the main path."
		"{@pagebreak}"
		"&eDeep dive:&r metals are a lattice of positive ions in a 'sea' of shared electrons (metallic bonding). The electrons hold the ions together but let whole planes of atoms shift: that's why metals bend instead of shattering."
		"&eSolid solutions:&r in bronze, tin atoms replace some copper atoms in the lattice. Tin atoms are larger, so they distort the planes around them and pin them in place. Harder, stronger, still workable."
		"&eIn the pack:&r 3 copper dust + 1 tin dust → 3 bronze dust (a 3:1 ratio by count, close to the historical recipe). Every later alloy follows the same idea with different partners."
	]
	quest.3BC13BCE2A947A64.title: "Note: Steel and Carbon"
	quest.3BC13BCE2A947A64.quest_subtitle: "A pinch of carbon changes everything"
	quest.3BC13BCE2A947A64.quest_desc: [
		"&eWhat:&r steel is iron with up to about 2% carbon. Most structural steel has well under 1%."
		"&eChemistry:&r tiny carbon atoms fit into the gaps between iron atoms (an interstitial alloy) and lock the layers."
		"{@pagebreak}"
		"&eFrom ore to iron:&r a real blast furnace burns coke to carbon monoxide, which strips oxygen from iron ore: Fe₂O₃ + 3CO → 2Fe + 3CO₂."
		"&eToo much carbon:&r furnace iron ('pig iron') has about 4% carbon and is brittle. Steelmaking blows oxygen through it to burn the excess off as CO and CO₂ (the basic oxygen process)."
		"&eIn the pack:&r MI skips the ore step: iron dust + coke dust → uncooked steel, baked in the Steam Blast Furnace. The coke you made is the carbon source."
	]
	quest.2141C053422A6B2D.title: "Note: Invar, the Metal That Won't Grow"
	quest.2141C053422A6B2D.quest_subtitle: "Iron + nickel with almost no thermal expansion"
	quest.2141C053422A6B2D.quest_desc: [
		"&eWhat:&r invar is about 64% iron and 36% nickel. MI uses it for rotary blades and gears."
		"&eChemistry:&r most metals expand when heated. Invar barely does, which keeps precision parts precise."
		"{@pagebreak}"
		"&eWhy:&r in this exact mix, a magnetic effect inside the crystal shrinks the lattice as it warms, cancelling the normal expansion (the 'Invar effect')."
		"&eHistory:&r Charles-Édouard Guillaume found it in 1896 and won the 1920 Nobel Prize in Physics. It went into clocks, measuring tapes and later the shadow masks of colour TVs."
		"&eIn the pack:&r mix iron and nickel dust in the Mixer (check JEI for the ratio). Cupronickel (copper + nickel) is its cousin, used for heating coils because it resists current steadily."
	]
	quest.7CBC658F33E8B7F7.title: "Note: Electrum, a Natural Alloy"
	quest.7CBC658F33E8B7F7.quest_subtitle: "Gold and silver that nature mixed first"
	quest.7CBC658F33E8B7F7.quest_desc: [
		"&eWhat:&r electrum is gold alloyed with silver. It's found that way in rivers, already mixed."
		"&eChemistry:&r gold and silver atoms are almost the same size and both form the same crystal, so they mix in any proportion."
		"{@pagebreak}"
		"&eComplete solubility:&r when two metals have similar atomic radius, the same crystal structure and similar electronegativity, they can blend smoothly from 0% to 100% (the Hume-Rothery rules). Gold-silver and copper-nickel are classic examples."
		"&eWhy MI wants it:&r both metals conduct electricity superbly and resist corrosion, ideal for circuit boards."
		"&eIn the pack:&r gold ore often gives silver as a byproduct in the Centrifuge for exactly this reason: native gold is usually electrum."
	]
	quest.7F6A8CAA886F253C.title: "Note: Stainless Steel"
	quest.7F6A8CAA886F253C.quest_subtitle: "Steel that heals its own skin"
	quest.7F6A8CAA886F253C.quest_desc: [
		"&eWhat:&r steel with at least 10.5% chromium (plus nickel and manganese) that doesn't rust."
		"&eChemistry:&r chromium reacts with air to form a thin Cr₂O₃ film only a few atoms thick. It seals the surface."
		"{@pagebreak}"
		"&ePassivation:&r ordinary rust (hydrated iron oxide) is flaky, so it falls off and exposes fresh iron: 4Fe + 3O₂ + 2xH₂O → 2Fe₂O₃·xH₂O. Chromium oxide is dense and sticks, so oxygen can't get through."
		"&eSelf-repair:&r scratch the surface and the exposed chromium reacts with oxygen again within moments, rebuilding the film."
		"&eIn the pack:&r 6 iron + 1 chromium + 1 nickel + 1 manganese dust → 9 stainless dust. It melts so hot that it leaves the EBF as a hot ingot and must be cooled in the Vacuum Freezer."
	]
	quest.423D337BE9E0D3BA.title: "Note: Coking Coal"
	quest.423D337BE9E0D3BA.quest_subtitle: "Baking coal without air"
	quest.423D337BE9E0D3BA.quest_desc: [
		"&eWhat:&r coke is coal heated in an oven with no air, leaving almost pure carbon."
		"&eChemistry:&r without oxygen the coal can't burn. Instead its volatile parts (tars, gases, water) boil away. This is pyrolysis."
		"{@pagebreak}"
		"&eWhat leaves:&r coal tar and creosote (heavy aromatic oils), coal gas (mostly H₂ and CH₄), ammonia and sulfur compounds. Old gasworks sold all of them."
		"&eWhat stays:&r a hard, porous carbon skeleton. It's strong enough to carry the weight of ore in a blast furnace and burns hotter than coal."
		"&eIn the pack:&r the Coke Oven turns coal into coke and sometimes creosote. Charcoal from wood is the same idea on a smaller scale."
	]
	quest.42F1B1EE7E035990.title: "Note: Taking Things Apart"
	quest.42F1B1EE7E035990.quest_subtitle: "The Dissolver, and what real chemists do"
	quest.42F1B1EE7E035990.quest_desc: [
		"&eWhat:&r the Dissolver turns any block into the elements and compounds it's made of."
		"&eChemistry:&r every substance is built from about 90 natural elements. Analysing what's inside is called elemental analysis."
		"{@pagebreak}"
		"&eThe real thing:&r chemists can't dissolve a block of wood into a pile of carbon, but they can measure it. Burn a sample in oxygen and weigh the CO₂ and H₂O formed: that gives the carbon and hydrogen content (combustion analysis). A mass spectrometer reads atoms by their mass."
		"&eConservation of mass:&r atoms are never created or destroyed in a chemical change, only rearranged (Lavoisier, 1789). The Dissolver is a game version of that law: everything you put in comes out as atoms."
		"&eIn the pack:&r many outputs are chance-based (JEI shows the odds). Some items give compounds first; dissolve those again for pure elements."
	]
	quest.5EBB0B1FD1ED63A6.title: "Note: Fixed Recipes"
	quest.5EBB0B1FD1ED63A6.quest_subtitle: "Why water is always H₂O"
	quest.5EBB0B1FD1ED63A6.quest_desc: [
		"&eWhat:&r the Combiner always needs the same numbers of each element for a compound."
		"&eChemistry:&r that's the law of definite proportions: a pure compound always has the same elements in the same ratio."
		"{@pagebreak}"
		"&eProust's law (1794):&r water from a river, a glacier or a test tube is always 2 H for every 1 O, which is 11.2% hydrogen by mass. Compounds aren't mixtures; they have a formula."
		"&eBalanced equations:&r because atoms are conserved, both sides of a reaction must hold the same atoms: 2H₂ + O₂ → 2H₂O has 4 H and 2 O on each side. The Combiner's recipes are balanced equations made of items."
		"&eIn the pack:&r compare a Combiner recipe in JEI with the formula on the compound's tooltip; the counts match."
	]
	quest.4D1154B739B71329.title: "Note: Isotopes"
	quest.4D1154B739B71329.quest_subtitle: "Same element, different weight"
	quest.4D1154B739B71329.quest_desc: [
		"&eWhat:&r isotopes are atoms of one element with different numbers of neutrons."
		"&eChemistry:&r chemistry is decided by electrons, and isotopes have the same electrons, so they react identically. Only their mass differs."
		"{@pagebreak}"
		"&eHydrogen's three:&r ¹H (no neutron), deuterium ²H (one) and tritium ³H (two). Deuterium is stable and found in heavy water, D₂O; tritium is radioactive and is bred from lithium. Both feed the fusion reactor."
		"&eUranium's two:&r natural uranium is 99.3% U-238 and only 0.72% U-235, the isotope that splits easily. Reactors need it enriched to roughly 3 to 5%."
		"&eHow enrichment works:&r turn uranium into UF₆, a gas, then spin it. Molecules with U-238 are about 1% heavier and drift outward. Thousands of centrifuges in a row (a cascade) multiply that tiny difference. The Isotopic Centrifuge is one stage of that."
	]
	quest.6B270AB61C2A38E4.title: "Note: Making Elements"
	quest.6B270AB61C2A38E4.quest_subtitle: "Where the elements really come from"
	quest.6B270AB61C2A38E4.quest_desc: [
		"&eWhat:&r Alchemistry's fission and fusion chambers split or join nuclei to change one element into another."
		"&eChemistry:&r an element is defined by its proton count (atomic number). Change the nucleus and you change the element. That's nuclear physics, not chemistry."
		"{@pagebreak}"
		"&eIn stars:&r stars fuse hydrogen into helium, then helium into carbon and oxygen, and so on up to iron. Fusing past iron costs energy instead of releasing it."
		"&eHeavier than iron:&r most heavy elements form when nuclei capture neutrons, slowly in old giant stars (the s-process) or in a flash during neutron-star mergers and supernovae (the r-process). Your gold was forged in a cosmic collision."
		"&eOganesson (118):&r made in 2002 by firing calcium-48 (Z = 20) at californium-249 (Z = 98): 20 + 98 = 118. Only a handful of atoms have ever existed, each lasting under a millisecond. The chambers add atomic numbers the same way."
	]
	quest.16413D21780D1807.title: "Fool's Gold"
	quest.16413D21780D1807.quest_subtitle: "Not everything that glitters"
	quest.16413D21780D1807.quest_desc: [
		"&6You remember laughing at prospectors. Then you remember being one.&r"
		"&eWhat:&r you synthesised iron disulfide, FeS₂: pyrite, better known as fool's gold."
		"&eChemistry:&r brassy and cubic, it fooled miners for centuries. Strike it on steel and it sparks; the name comes from the Greek for fire."
		"&eTip:&r roasting pyrite was once a major source of SO₂ for sulfuric acid: 4FeS₂ + 11O₂ → 2Fe₂O₃ + 8SO₂."
	]
	quest.7E828052210346C3.title: "Note: Why Crushing Doubles Ore"
	quest.7E828052210346C3.quest_subtitle: "Ore, gangue and the 2x rule"
	quest.7E828052210346C3.quest_desc: [
		"&eWhat:&r in this pack, every route caps at &e2x&r per ore block (1.5x per raw ore) until you have acids."
		"&eChemistry:&r real ore is a little metal mineral locked in a lot of worthless rock (gangue). Grinding frees the mineral so it can be separated."
		"{@pagebreak}"
		"&eBeneficiation:&r mines crush ore to powder, then concentrate it. Dense minerals sink in water (gravity separation), magnetic ones stick to magnets, and sulfide minerals cling to air bubbles in froth flotation while the rock sinks."
		"&eSmelting the concentrate:&r only then is the metal freed by heat and chemistry, for example 2PbS + 3O₂ → 2PbO + 2SO₂, then PbO + C → Pb + CO."
		"&eThe game rule:&r crushing recovers more of the metal than tossing raw chunks in a furnace, so dust gives more ingots. The 2x cap is a balance choice; the next notes explain how acids push past it."
	]
	quest.7FFCA794F7A0681A.title: "Note: 3x, 4x, 5x"
	quest.7FFCA794F7A0681A.quest_subtitle: "Oxygen, chloride and acid leaching"
	quest.7FFCA794F7A0681A.quest_desc: [
		"&eWhat:&r Mekanism's ore chain adds a chemical step per tier: O₂ (3x), HCl (4x), H₂SO₄ (5x)."
		"&eChemistry:&r each step mirrors a real way of pulling metal out of rock: roasting, chlorination and leaching."
		"{@pagebreak}"
		"&e3x, oxygen:&r roasting sulfide ore in air turns it into an oxide that is easier to reduce: 2ZnS + 3O₂ → 2ZnO + 2SO₂."
		"&e4x, chloride:&r metal chlorides are often volatile or soluble, so chlorination separates metals cleanly. Titanium is refined this way (the Kroll process goes through TiCl₄)."
		"&e5x, leaching:&r sulfuric acid dissolves the metal out as a sulfate slurry, e.g. CuO + H₂SO₄ → CuSO₄ + H₂O. Wash it, crystallise it, and almost nothing is left behind. This hydrometallurgy is how much of the world's copper is made today."
	]
	quest.1090A28FC3203361.title: "Note: Ores Come in Families"
	quest.1090A28FC3203361.quest_subtitle: "Why the Centrifuge finds a second metal"
	quest.1090A28FC3203361.quest_desc: [
		"&eWhat:&r centrifuging Mekanism dirty dust gives the main metal plus a chance at a second one."
		"&eChemistry:&r metals with similar chemistry crystallise together in the same rocks, so real refineries recover them as byproducts."
		"{@pagebreak}"
		"&eThe pairs in this pack:&r iron → nickel (iron-nickel ores), copper → gold (recovered when copper is refined), gold → silver (native gold is electrum), lead → silver (galena, PbS, is the main silver source), tin → tungsten (cassiterite sits with wolframite), osmium → iridium (osmiridium), uranium → lead (uranium decays into lead over billions of years)."
		"&eWhy it matters:&r many rare metals have no mines of their own. Most of the world's indium, gallium and germanium comes out of zinc and aluminum refining."
	]
	quest.628CDE2D665A1E45.title: "Note: Refining Platinum"
	quest.628CDE2D665A1E45.quest_subtitle: "Aqua regia and a careful precipitation"
	quest.628CDE2D665A1E45.quest_desc: [
		"&eWhat:&r the platinum line turns anode sludge into pure platinum and four rarer metals."
		"&eChemistry:&r platinum resists almost every acid, but aqua regia (3 HCl : 1 HNO₃) dissolves it. Then a salt pulls it back out alone."
		"{@pagebreak}"
		"&eStep 1, dissolve:&r nitric acid oxidises the metal and chloride holds it in solution: Pt + 4HNO₃ + 6HCl → H₂PtCl₆ + 4NO₂ + 4H₂O."
		"&eStep 2, precipitate:&r ammonium chloride forms a yellow salt that barely dissolves: H₂PtCl₆ + 2NH₄Cl → (NH₄)₂PtCl₆ + 2HCl."
		"&eStep 3, calcine:&r heat drives everything else off as gas: 3(NH₄)₂PtCl₆ → 3Pt + 2NH₄Cl + 16HCl + 2N₂."
		"&eThe residue:&r iridium, osmium, rhodium and ruthenium don't dissolve in aqua regia, so they stay behind and are separated later (the Centrifuge in this pack)."
	]
	quest.569F76BBACC216C2.title: "Coffee Break"
	quest.569F76BBACC216C2.quest_subtitle: "Moved: see Morning Coffee"
	quest.569F76BBACC216C2.quest_desc: [
		"&eMoved:&r this step is now \"Morning Coffee\" on the The Periodic Table page. Click to dismiss."
	]
	quest.79BEB641DEFB5C31.title: "Note: Splitting Water"
	quest.79BEB641DEFB5C31.quest_subtitle: "Electrolysis: electricity drives a reaction backwards"
	quest.79BEB641DEFB5C31.quest_desc: [
		"&eWhat:&r the Electrolytic Separator (and MI's Electrolyzer) split water into hydrogen and oxygen."
		"&eChemistry:&r 2H₂O → 2H₂ + O₂. Burning hydrogen releases energy; electrolysis pays that energy back to undo it."
		"{@pagebreak}"
		"&eAt the electrodes:&r the negative electrode (cathode) gives electrons to water: 2H₂O + 2e⁻ → H₂ + 2OH⁻. The positive electrode (anode) takes them: 2H₂O → O₂ + 4H⁺ + 4e⁻."
		"&eTwo to one:&r twice as much hydrogen gas as oxygen comes off, by volume, exactly as the formula says. MI matches it: 3000 mB water → 2000 mB H₂ + 1000 mB O₂."
		"&eReal detail:&r pure water barely conducts, so real cells add a dissolved salt or alkali (an electrolyte) to carry the current. Only the water is used up."
	]
	quest.3D78546E16F1A9EE.title: "Note: The Chlor-Alkali Process"
	quest.3D78546E16F1A9EE.quest_subtitle: "Salt water in, chlorine out"
	quest.3D78546E16F1A9EE.quest_desc: [
		"&eWhat:&r electrolysing salt gives chlorine, one of the most-used industrial chemicals (PVC, bleach, HCl)."
		"&eChemistry:&r in water: 2NaCl + 2H₂O → Cl₂ + H₂ + 2NaOH. Molten salt with no water gives metal: 2NaCl → 2Na + Cl₂."
		"{@pagebreak}"
		"&eTwo routes:&r brine cells (the chlor-alkali process) make chlorine, hydrogen and sodium hydroxide (lye) together. Molten-salt cells (the Downs cell) make sodium metal and chlorine. Mekanism's separator gives sodium + chlorine, like the Downs cell."
		"&eWhy chlorine goes to the anode:&r chloride ions (Cl⁻) carry the negative charge, so they're drawn to the positive electrode and give up their electrons: 2Cl⁻ → Cl₂ + 2e⁻."
		"&eNext step:&r hydrogen and chlorine combine into hydrogen chloride, H₂ + Cl₂ → 2HCl, which you need for 4x ore and for PVC."
	]
	quest.48D49B45AC4EFCF0.title: "Note: Catalysts"
	quest.48D49B45AC4EFCF0.quest_subtitle: "Faster reactions, nothing used up"
	quest.48D49B45AC4EFCF0.quest_desc: [
		"&eWhat:&r a catalyst speeds up a reaction without being consumed. Industry runs on them."
		"&eChemistry:&r it offers an easier pathway with a lower energy barrier (activation energy). It doesn't change where the equilibrium ends up."
		"{@pagebreak}"
		"&eClassic catalysts:&r vanadium(V) oxide for SO₂ → SO₃ (contact process), iron for ammonia (Haber-Bosch), platinum-rhodium gauze for burning ammonia (Ostwald), chromium or titanium compounds for polyethylene, and zeolites in refinery cat-crackers."
		"&eSurface catalysts:&r gases stick to the metal surface, their bonds weaken, they react, and the product lets go, freeing the site for the next molecule."
		"&eIn the pack:&r machines don't model catalysts, and MI's polymer recipes consume a few tiny metal dusts. In real plants the catalyst is replaced only when it slowly wears out or gets poisoned."
	]
	quest.68772890EE85CCEE.title: "Note: The Contact Process"
	quest.68772890EE85CCEE.quest_subtitle: "Sulfuric acid, the king of chemicals"
	quest.68772890EE85CCEE.quest_desc: [
		"&eWhat:&r sulfuric acid is made in larger amounts than any other chemical: about 250 million tonnes a year."
		"&eChemistry:&r S + O₂ → SO₂, then 2SO₂ + O₂ ⇌ 2SO₃ over V₂O₅, then SO₃ is turned into H₂SO₄."
		"{@pagebreak}"
		"&eThe balancing act:&r 2SO₂ + O₂ ⇌ 2SO₃ releases heat, so lower temperatures give more SO₃ but react slowly. About 450 °C with a catalyst is the compromise. This is Le Chatelier's principle in action."
		"&eThe odd last step:&r SO₃ isn't bubbled straight into water; that makes a fine acid mist. It's absorbed into existing concentrated acid to form oleum (H₂S₂O₇), which is then diluted: H₂S₂O₇ + H₂O → 2H₂SO₄."
		"&eIn the pack:&r Mekanism splits the steps across three machines; MI's Chemical Reactor does it all at once from sulfur, oxygen and water. Its uses: 5x ore, fertilisers, batteries and the Seed of a New World."
	]
	quest.3EEF5FAA0EF15827.title: "Note: Haber-Bosch"
	quest.3EEF5FAA0EF15827.quest_subtitle: "Fixing nitrogen from the air"
	quest.3EEF5FAA0EF15827.quest_desc: [
		"&eWhat:&r ammonia, NH₃, made from nitrogen in the air and hydrogen. Fertiliser made from it feeds billions."
		"&eChemistry:&r N₂ + 3H₂ ⇌ 2NH₃. The N≡N triple bond is one of the strongest bonds there is, so it needs pressure, heat and an iron catalyst."
		"{@pagebreak}"
		"&eConditions:&r about 200 atmospheres and 400 to 450 °C over iron. The reaction releases heat, so cooler gives more ammonia but far too slowly; high pressure helps because 4 gas molecules become 2."
		"&eRecycling:&r only about 15% converts per pass, so the ammonia is condensed out and the unreacted gas goes round again."
		"&eReal hydrogen:&r most comes from natural gas (steam reforming, CH₄ + H₂O → CO + 3H₂). In the pack you get it from electrolysis instead, the 'green ammonia' route."
	]
	quest.73C48B0D9B78A1DC.title: "Note: The Ostwald Process"
	quest.73C48B0D9B78A1DC.quest_subtitle: "Ammonia into nitric acid"
	quest.73C48B0D9B78A1DC.quest_desc: [
		"&eWhat:&r nitric acid, HNO₃, for fertiliser, explosives in mining, and in this pack, aqua regia."
		"&eChemistry:&r overall NH₃ + 2O₂ → HNO₃ + H₂O, which happens in three real steps."
		"{@pagebreak}"
		"&eStep 1:&r ammonia burns over a red-hot platinum-rhodium gauze (about 900 °C): 4NH₃ + 5O₂ → 4NO + 6H₂O. The contact lasts only milliseconds."
		"&eStep 2:&r the gas cools and nitric oxide picks up more oxygen: 2NO + O₂ → 2NO₂ (brown)."
		"&eStep 3:&r NO₂ is absorbed in water: 3NO₂ + H₂O → 2HNO₃ + NO. The leftover NO goes back to step 2."
		"&eIn the pack:&r the Chemical Reactor does all three at once: 1 B ammonia + 2 B oxygen → 1 B nitric acid + 1 B water."
	]
	quest.7A933FC224D7210D.title: "Note: Fractional Distillation"
	quest.7A933FC224D7210D.quest_subtitle: "Sorting crude oil by boiling point"
	quest.7A933FC224D7210D.quest_desc: [
		"&eWhat:&r crude oil is a mix of thousands of hydrocarbons. A distillation tower sorts them into fractions."
		"&eChemistry:&r bigger molecules have stronger attractions between them, so they boil at higher temperatures."
		"{@pagebreak}"
		"&eThe tower:&r crude is heated to about 400 °C and fed in near the bottom. Vapour rises through trays, cooling as it goes; each fraction condenses at the height where the tower matches its boiling point."
		"&eTop to bottom:&r refinery gas (C₁ to C₄), naphtha (about C₅ to C₁₀), kerosene, diesel (light fuel), fuel oil (heavy fuel), and a tarry residue at the base."
		"&eSour crude:&r crude contains sulfur compounds, which is why MI's first fractions are 'sulfuric'. Hydrotreating with hydrogen strips the sulfur out as H₂S, and in MI that comes back to you as sulfuric acid."
	]
	quest.3C2A80CE10E42AE2.title: "Note: Steam Cracking"
	quest.3C2A80CE10E42AE2.quest_subtitle: "Breaking long chains into building blocks"
	quest.3C2A80CE10E42AE2.quest_desc: [
		"&eWhat:&r cracking breaks big, less useful molecules into small, valuable ones, especially ethylene."
		"&eChemistry:&r e.g. C₁₀H₂₂ → C₈H₁₈ + C₂H₄. One product must have a C=C double bond, because there isn't enough hydrogen to go round."
		"{@pagebreak}"
		"&eSteam cracking:&r naphtha mixed with steam is heated to about 850 °C for a fraction of a second, then quenched. The steam dilutes the hydrocarbon so it doesn't coke up the pipes. No catalyst: heat alone snaps the C-C bonds."
		"&eCatalytic cracking:&r refineries also crack heavy oil over zeolite catalysts at lower temperatures to make petrol. That's a different process with a different goal."
		"&eIn the pack:&r naphtha + steam → steam-cracked naphtha in the Chemical Reactor, then the Distillation Tower separates ethylene, propene, benzene and more."
	]
	quest.172800B968364FB8.title: "Note: Polymers"
	quest.172800B968364FB8.quest_subtitle: "Thousands of ethylenes holding hands"
	quest.172800B968364FB8.quest_desc: [
		"&eWhat:&r a polymer is a giant molecule made of repeating small units (monomers). Polyethylene is the world's most common plastic."
		"&eChemistry:&r n C₂H₄ → (-CH₂-CH₂-)ₙ. Each double bond opens and links to the next molecule: addition polymerisation."
		"{@pagebreak}"
		"&eChain length:&r a typical polyethylene chain has tens of thousands of carbon atoms. Long chains tangle like spaghetti, which is why plastic is tough instead of waxy."
		"&eLDPE vs HDPE:&r high-pressure, radical polymerisation gives branched chains that pack loosely (soft LDPE film). Metal catalysts (Ziegler-Natta, Phillips) give straight chains that pack tightly (stiff HDPE, Mekanism's HDPE pellets)."
		"&eIn the pack:&r polyethylene unlocks HV digital circuits, and 16 buckets go into the Seed of a New World."
	]
	quest.220F50B22EDEE68F.title: "Note: PVC"
	quest.220F50B22EDEE68F.quest_subtitle: "Polyethylene with a chlorine twist"
	quest.220F50B22EDEE68F.quest_desc: [
		"&eWhat:&r polyvinyl chloride, the plastic of pipes, cable insulation and window frames. MI needs it for EV processing units."
		"&eChemistry:&r n C₂H₃Cl → (-CH₂-CHCl-)ₙ. The same addition polymerisation as polyethylene, with one H swapped for Cl."
		"{@pagebreak}"
		"&eWhy chlorine matters:&r the C-Cl bonds make PVC rigid, oil-resistant and slow to burn (it releases HCl, which smothers flames). That's why it's trusted around electrical wiring."
		"&eMaking the monomer:&r the old route, used in MI, adds HCl to acetylene: C₂H₂ + HCl → C₂H₃Cl. Modern plants start from ethylene and chlorine instead, then crack the intermediate: C₂H₄Cl₂ → C₂H₃Cl + HCl."
		"&eTwo industries meet:&r PVC is where petrochemicals (the carbon) and chlor-alkali (the chlorine) come together."
	]
	quest.4A100082246D9BCC.title: "Note: Silicon from Sand"
	quest.4A100082246D9BCC.quest_subtitle: "Carbothermic reduction"
	quest.4A100082246D9BCC.quest_desc: [
		"&eWhat:&r silicon metal is made by stripping oxygen from quartz (SiO₂) with carbon."
		"&eChemistry:&r SiO₂ + 2C → Si + 2CO at around 2000 °C in an electric arc furnace."
		"{@pagebreak}"
		"&eMetallurgical grade:&r this gives silicon about 98 to 99% pure. Good enough for aluminum alloys and silicones, nowhere near good enough for chips."
		"&eThe purity ladder:&r for electronics, silicon is turned into a liquid (trichlorosilane: Si + 3HCl → SiHCl₃ + H₂), distilled until almost perfectly clean, then turned back into silicon (the Siemens process). That reaches 'nine nines', 99.9999999%."
		"&eIn the pack:&r quartz dust + coke dust in the EBF gives silicon for transistors and diodes. The next purity step comes at EV."
	]
	quest.0860B25725FD586F.title: "Note: Growing a Perfect Crystal"
	quest.0860B25725FD586F.quest_subtitle: "The Czochralski process and doping"
	quest.0860B25725FD586F.quest_desc: [
		"&eWhat:&r chips are built on wafers sliced from one single crystal of silicon."
		"&eChemistry:&r a seed crystal dipped into molten silicon and pulled up slowly while turning grows into an ingot where every atom lines up."
		"{@pagebreak}"
		"&eWhy argon:&r molten silicon reacts with oxygen and nitrogen, so the crystal is grown under argon, an unreactive noble gas. That's why the pack asks for argon here."
		"&eDoping:&r pure silicon conducts poorly. A few atoms of phosphorus per million (one extra electron each) make n-type silicon; boron (one electron short) makes p-type. Where the two meet you get a diode, and stacks of junctions make transistors."
		"&eIn the pack:&r EBF: silicon dust + a tiny pinch of iridium + argon → monocrystalline silicon, then the Cutting Machine slices it into wafers."
	]
	quest.34777C5D08BD6921.title: "Note: Fission Power"
	quest.34777C5D08BD6921.quest_subtitle: "Splitting heavy nuclei"
	quest.34777C5D08BD6921.quest_desc: [
		"&eWhat:&r a fission reactor splits uranium nuclei and uses the heat to make steam."
		"&eChemistry:&r ²³⁵U + n → ¹⁴¹Ba + ⁹²Kr + 3n + about 200 MeV. Mass numbers balance (236 = 141 + 92 + 3) and so do protons (92 = 56 + 36)."
		"{@pagebreak}"
		"&eChain reaction:&r each split releases 2 to 3 neutrons. If on average exactly one causes another split, the reactor runs steadily. Control rods absorb extra neutrons to hold it there."
		"&eWhere the energy comes from:&r the fragments weigh slightly less than the original nucleus. That missing mass becomes energy (E = mc²), about a million times more per atom than burning carbon."
		"&eWaste:&r the fragments are radioactive. In Mekanism, nuclear waste is processed into plutonium and polonium, which feed the next tiers. Always plan coolant and a SCRAM circuit."
	]
	quest.30AE82BF82E60951.title: "Note: Fusion Power"
	quest.30AE82BF82E60951.quest_subtitle: "Joining light nuclei, like the Sun"
	quest.30AE82BF82E60951.quest_desc: [
		"&eWhat:&r fusion joins hydrogen isotopes into helium. It powers every star."
		"&eChemistry:&r ²H + ³H → ⁴He + n + 17.6 MeV. Per kilogram of fuel that's about four times more energy than fission."
		"{@pagebreak}"
		"&eThe hard part:&r nuclei are positively charged and repel each other. They must hit at enormous speed, which means a plasma at about 100 million °C, held away from the walls by magnetic fields or squeezed by lasers."
		"&eIgnition:&r laser fusion fires lasers into a tiny gold cylinder (a hohlraum) that turns the light into X-rays and crushes a fuel pellet. Mekanism borrows exactly that: a laser burst into a filled Hohlraum lights the reactor."
		"&eFuel:&r deuterium comes from heavy water; tritium is bred from lithium: ⁶Li + n → ³H + ⁴He."
	]
	quest.5668ED9E8679D917.title: "Note: Antimatter as a Battery"
	quest.5668ED9E8679D917.quest_subtitle: "The densest energy store imaginable"
	quest.5668ED9E8679D917.quest_desc: [
		"&eWhat:&r every particle has an antiparticle with the opposite charge. Meet and they annihilate into pure energy."
		"&eChemistry:&r all the mass turns to energy: E = mc². One gram of antimatter meeting one gram of matter releases about 1.8 × 10¹⁴ J."
		"{@pagebreak}"
		"&eReal antimatter:&r positrons (anti-electrons) are used every day in PET scans. Antiprotons and antihydrogen are made at CERN, but all of it ever made adds up to only nanograms, at an enormous energy cost."
		"&eA store, not a source:&r making antimatter always costs more energy than it gives back. That's why it works as a battery: put energy in once, carry it in a tiny pellet, get it out later."
		"&eIn the pack:&r the SPS turns polonium and huge amounts of power into antimatter, which charges Antimatter Cores for the capstone. That part is game design, not real physics."
	]
	quest.02DB47D12BCB5C95.title: "Note: The Whole Notebook"
	quest.02DB47D12BCB5C95.quest_subtitle: "Every page in one recipe"
	quest.02DB47D12BCB5C95.quest_desc: [
		"&6The last page of the notebook is blank. You realise you're meant to write it.&r"
		"&eWhat:&r the Seed of a New World puts one product of every chemistry lesson into a single 9x9 recipe."
		"&eChemistry:&r each ingredient stands for a whole industry you rebuilt from the ground up."
		"{@pagebreak}"
		"&eThe ledger:&r coke (pyrolysis and steelmaking), water and hydrogen (synthesis and electrolysis), sulfuric acid (the contact process), polyethylene (cracking and polymerisation), processing units (silicon purification and PVC), stainless plates (alloys), oganesson (building nuclei), plutonium and polonium (fission), Antimatter Cores (mass into energy)."
		"&eThe point:&r almost nothing in modern life is mined and used as-is. It's separated, reacted, purified and combined. That's chemistry, and now it's yours."
		"&eHow:&r check JEI for the exact layout on the Ultimate Table."
	]
	chapter.452C93B72D978D1A.title: "Completionist"
	chapter.452C93B72D978D1A.chapter_subtitle: [
		"Collections for the thorough demigod. All optional."
	]
	quest.24914735614B7E05.title: "Sixteen Colours of Wool"
	quest.24914735614B7E05.quest_subtitle: "One block of every wool colour"
	quest.24914735614B7E05.quest_desc: [
		"&6You remember making a world with every colour in it. Start small: sixteen.&r"
		"&eWhat:&r a collection page. Nothing here is needed to progress; every quest is a bragging right with a small reward."
		"&eHow:&r shear sheep and dye white wool in a crafting grid (wool + dye). Sheep can also be dyed before shearing."
		"&eTip:&r dye a sheep once and it grows that colour back forever. A pen of sixteen sheep is a wool farm."
	]
	quest.3C3A4C35AF19917F.title: "The Dyer's Palette"
	quest.3C3A4C35AF19917F.quest_subtitle: "All sixteen dyes"
	quest.3C3A4C35AF19917F.quest_desc: [
		"&eWhat:&r every dye colour, from flowers, plants, minerals and mixing."
		"&eChemistry:&r real dyes are molecules that absorb some wavelengths of light. Lapis gets its blue from lazurite, a sodium aluminosilicate with sulfur ions trapped in its cage."
		"&eHow:&r flowers give most primaries; cocoa gives brown, cactus smelts into green, ink sacs give black. Mix the rest (JEI shows every recipe)."
		"&eTip:&r bone meal on grass and flowers gives you endless primaries."
	]
	quest.05CCE3C3E12A4F47.title: "Concrete Rainbow"
	quest.05CCE3C3E12A4F47.quest_subtitle: "All sixteen concretes"
	quest.05CCE3C3E12A4F47.quest_desc: [
		"&eWhat:&r one block of every concrete colour."
		"&eChemistry:&r real concrete sets by hydration, not drying: water reacts with the calcium silicates in cement to grow a stiff mesh of calcium silicate hydrate."
		"&eHow:&r craft concrete powder (4 sand, 4 gravel, 1 dye), then place it in water or touch it with water to set it."
		"&eTip:&r place powder in front of a water stream and mine it with a good pickaxe: fast and repeatable."
	]
	quest.29FD9FD275EB8B42.title: "Every Vanilla Tree"
	quest.29FD9FD275EB8B42.quest_subtitle: "Ten saplings from the vanilla world"
	quest.29FD9FD275EB8B42.quest_desc: [
		"&eWhat:&r one sapling from every vanilla tree, including the mangrove propagule and both azaleas."
		"&eChemistry:&r every tree builds itself from air and water: 6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂, powered by sunlight."
		"&eHow:&r break leaves in each biome. Cherry groves sit on mountain meadows; azaleas grow above lush caves; propagules hang under mangrove leaves."
		"&eTip:&r a Nature's Compass finds the biome you need."
	]
	quest.3E6E555D15E5618C.title: "Trees of Distant Lands"
	quest.3E6E555D15E5618C.quest_subtitle: "Ten saplings from modded biomes"
	quest.3E6E555D15E5618C.quest_desc: [
		"&eWhat:&r saplings from Biomes O' Plenty and Regions Unexplored trees."
		"&eHow:&r find the biome first: redwood and jacaranda groves, mystic groves (magic), tropics (palm), snowblossom groves; baobab savannas, eucalyptus forests, Joshua deserts, wisteria groves and rainforests."
		"&eTip:&r JEI shows each sapling's leaves. Botany Pots grow any of them without a forest."
	]
	quest.5CF80E20FAD6CF13.title: "The Creeper Collection"
	quest.5CF80E20FAD6CF13.quest_subtitle: "Twelve discs that creepers drop"
	quest.5CF80E20FAD6CF13.quest_desc: [
		"&eWhat:&r the twelve classic discs. A creeper drops one when a skeleton (or stray or bogged) kills it."
		"&eHow:&r lure creepers into a skeleton's line of fire, or build a mob farm that lets skeletons do the shooting. Dungeon chests also hold a few."
		"&eTip:&r a skeleton spawner dungeon is perfect: trap the skeletons, then walk creepers past them."
	]
	quest.30EC54EB8A9DFD35.title: "Treasure Discs"
	quest.30EC54EB8A9DFD35.quest_subtitle: "Pigstep, otherside, Relic and 5"
	quest.30EC54EB8A9DFD35.quest_desc: [
		"&eWhat:&r four discs that only come from structures."
		"&eHow:&r Pigstep: bastion remnant chests. otherside: dungeon and stronghold chests (rare). Relic: brush suspicious gravel in trail ruins. 5: craft nine disc fragments found in ancient city chests."
		"&eTip:&r an Explorer's Compass points to the structure you need."
	]
	quest.064638080B9AC1F3.title: "Trial Discs"
	quest.064638080B9AC1F3.quest_subtitle: "Three discs from trial chambers"
	quest.064638080B9AC1F3.quest_desc: [
		"&eWhat:&r the discs added with trial chambers."
		"&eHow:&r Precipice comes from vaults opened with a trial key; Creator from ominous vaults (ominous trial key); Creator (Music Box) from decorated pots in the chambers."
		"&eTip:&r drink an ominous bottle before a trial spawner to turn it ominous. Bring food, a shield and fire resistance."
	]
	quest.76E6697544E0D8BF.title: "Overworld Trims"
	quest.76E6697544E0D8BF.quest_subtitle: "Seven templates from Overworld structures"
	quest.76E6697544E0D8BF.quest_desc: [
		"&eWhat:&r armour trim templates decorate armour in a smithing table."
		"&eHow:&r coast: shipwrecks. dune: desert pyramids. wild: jungle temples. sentry: pillager outposts. vex: woodland mansions. tide: elder guardians in ocean monuments. eye: strongholds."
		"&eTip:&r copy a template with 7 diamonds and the block it's made of (check JEI) instead of hunting a second one."
	]
	quest.3A9524CD2B47B654.title: "Dug-Up Trims"
	quest.3A9524CD2B47B654.quest_subtitle: "Four templates from trail ruins"
	quest.3A9524CD2B47B654.quest_desc: [
		"&eWhat:&r four trims buried in trail ruins."
		"&eHow:&r brush suspicious gravel in trail ruins with a brush (feather, copper, stick). These are rare drops, so brush a lot."
		"&eTip:&r the same gravel holds pottery sherds and the Relic disc."
	]
	quest.71DF0C78D78D5E7B.title: "Trims of the Deep Dark"
	quest.71DF0C78D78D5E7B.quest_subtitle: "Ward and Silence"
	quest.71DF0C78D78D5E7B.quest_desc: [
		"&eWhat:&r the two ancient city trims. Silence is the rarest template in the game."
		"&eHow:&r loot ancient city chests. Sneak, wool on the floor, and don't let the shriekers call the Warden."
		"&eTip:&r a stack of wool carpets silences your footsteps on sculk sensors."
	]
	quest.476FD0DDC043D665.title: "Trims of Fire and Void"
	quest.476FD0DDC043D665.quest_subtitle: "Rib, Snout and Spire"
	quest.476FD0DDC043D665.quest_desc: [
		"&eWhat:&r one trim each from Nether fortresses (rib), bastions (snout) and End cities (spire)."
		"&eHow:&r fortress chests, bastion chests and End city chests. Bring gold armour for the bastion."
		"&eTip:&r bastion treasure rooms also hold the netherite upgrade template."
	]
	quest.6E25BE0980F1ED98.title: "Trial Trims"
	quest.6E25BE0980F1ED98.quest_subtitle: "Flow and Bolt"
	quest.6E25BE0980F1ED98.quest_desc: [
		"&eWhat:&r the two trial chamber trims."
		"&eHow:&r bolt comes from regular vaults (trial key); flow from ominous vaults (ominous trial key)."
		"&eTip:&r every player gets their own loot from each vault, so bring friends."
	]
	quest.3154336597FED77E.title: "Ore Cabinet: Overworld"
	quest.3154336597FED77E.quest_subtitle: "Every vanilla Overworld ore, as a block"
	quest.3154336597FED77E.quest_desc: [
		"&eWhat:&r one ore block of each vanilla Overworld ore (stone or deepslate both count)."
		"&eChemistry:&r real ores are minerals: iron as hematite (Fe₂O₃), copper as chalcopyrite (CuFeS₂), lapis as lazurite. Diamond is pure carbon."
		"&eHow:&r you need a &eSilk Touch&r pickaxe so the ore drops itself. Emerald only grows under mountains."
		"&eTip:&r place them in item frames as a display: a real geology cabinet."
	]
	quest.7AA71D0F3718C0F5.title: "Ore Cabinet: Nether"
	quest.7AA71D0F3718C0F5.quest_subtitle: "Three ores from the Nether"
	quest.7AA71D0F3718C0F5.quest_desc: [
		"&eWhat:&r Nether gold, Nether quartz and ancient debris."
		"&eChemistry:&r real quartz is silicon dioxide, SiO₂, the same thing as sand and the silicon you refine later."
		"&eHow:&r Silk Touch for the gold and quartz ores. Ancient debris always drops itself; mine around Y 15."
		"&eTip:&r beds explode in the Nether. That's a fast (and loud) way to find debris."
	]
	quest.17CB280131B353E2.title: "Ore Cabinet: Industrial"
	quest.17CB280131B353E2.quest_subtitle: "Eight Modern Industrialization ores"
	quest.17CB280131B353E2.quest_desc: [
		"&eWhat:&r one block of each common MI ore."
		"&eChemistry:&r bauxite is aluminium hydroxide; antimony is mined as stibnite (Sb₂S₃); monazite is a rare-earth phosphate, (Ce,La,Nd)PO₄, often with thorium."
		"&eHow:&r Silk Touch. Rich deposits sit at metal-specific depths: lead around Y −24 to 16, nickel lower at Y −32 to 8."
		"&eTip:&r Jade shows the ore name as you look at it, so you can tell tin from lead in the dark."
	]
	quest.56909AAC70A18B96.title: "Ore Cabinet: Deep and Rare"
	quest.56909AAC70A18B96.quest_subtitle: "Uranium, tungsten, osmium and fluorite"
	quest.56909AAC70A18B96.quest_desc: [
		"&eWhat:&r the deep ores, as blocks."
		"&eChemistry:&r uranium ore is uraninite (UO₂); tungsten comes from wolframite and scheelite (CaWO₄); fluorite is calcium fluoride, CaF₂, the source of the hydrofluoric acid you'll need for uranium."
		"&eHow:&r Silk Touch. Uranium and tungsten deposits sit deep, around Y −56 to −24. Tungsten ore needs an iron pickaxe or better in this pack."
		"&eTip:&r Mekanism's radiation comes from its nuclear fluids and waste later on. Hazmat gear is in Tools and Comfort."
	]
	quest.65B54DE3A16529B1.title: "Ore Hoarder"
	quest.65B54DE3A16529B1.quest_subtitle: "256 ore blocks of any kind"
	quest.65B54DE3A16529B1.quest_desc: [
		"&eWhat:&r four stacks of unprocessed ore blocks (anything tagged as an ore)."
		"&eHow:&r Silk Touch plus FTB Ultimine makes this quick. Keep them as blocks: Mekanism and MI process ore blocks too."
		"&eTip:&r ore blocks wait patiently. Store them until your 5x line is ready and every block is worth more."
	]
	quest.7C76F5D615A21CFD.title: "Circuit Collection"
	quest.7C76F5D615A21CFD.quest_subtitle: "LV, MV, HV and EV, side by side"
	quest.7C76F5D615A21CFD.quest_desc: [
		"&eWhat:&r one of each MI circuit tier you have built: analog, electronic, digital, processing unit."
		"&eChemistry:&r each tier stands on new chemistry: rubber, then aluminium, then polyethylene, then PVC and pure silicon."
		"&eHow:&r you made all of these on the main path. Keep one of each."
		"&eTip:&r frame them in order. It's a history of everything you've learned."
	]
	quest.2FD7F1F49B2C90E4.title: "Quantum Circuit"
	quest.2FD7F1F49B2C90E4.quest_subtitle: "The circuit beyond the main path"
	quest.2FD7F1F49B2C90E4.quest_desc: [
		"&eWhat:&r MI's top circuit. Nothing on the main path needs it, which makes it the perfect trophy."
		"&eHow:&r an Assembler: 4 processing units, 2 cooling cells, 2 qubits and a quantum circuit board. The board needs superconductor cable, plutonium batteries, iridium plates and helium-3 (check JEI for each)."
		"&eTip:&r iridium comes from the PGM residue line; plan the iridium before you start."
	]
	quest.46DBFE74EB369FB5.title: "Basic Factory"
	quest.46DBFE74EB369FB5.quest_subtitle: "Three items at once"
	quest.46DBFE74EB369FB5.quest_desc: [
		"&eWhat:&r a Mekanism factory runs several copies of one machine in one block. Basic factories have 3 slots."
		"&eHow:&r right-click a placed Mekanism machine with a Basic Tier Installer, or craft the factory (check JEI). Any basic factory counts."
		"&eTip:&r a basic smelting factory with speed upgrades already beats a row of furnaces."
	]
	quest.246D14A3AF1EEC26.title: "Advanced Factory"
	quest.246D14A3AF1EEC26.quest_subtitle: "Five items at once"
	quest.246D14A3AF1EEC26.quest_desc: [
		"&eWhat:&r advanced factories have 5 slots."
		"&eHow:&r an Advanced Tier Installer on a basic factory. Its control circuit needs an MI electronic circuit (MV) and infused alloy."
		"&eTip:&r upgrade in place: the installer keeps the factory's contents and settings."
	]
	quest.0D793D529C26B98B.title: "Elite Factory"
	quest.0D793D529C26B98B.quest_subtitle: "Seven items at once"
	quest.0D793D529C26B98B.quest_desc: [
		"&eWhat:&r elite factories have 7 slots."
		"&eHow:&r an Elite Tier Installer; its circuit needs an MI digital circuit (HV) and reinforced alloy."
		"&eTip:&r factories sort their own input slots if you turn on auto-sort in the GUI."
	]
	quest.1B2975F8496440C3.title: "Ultimate Factory"
	quest.1B2975F8496440C3.quest_subtitle: "Nine items at once"
	quest.1B2975F8496440C3.quest_desc: [
		"&eWhat:&r ultimate factories have 9 slots, the most Mekanism offers."
		"&eHow:&r an Ultimate Tier Installer; its circuit needs an MI processing unit (EV) and atomic alloy."
		"&eTip:&r one ultimate enriching factory can feed a whole 5x ore line's first step."
	]
	quest.1B30AE1DEF39A277.title: "The Full Line-Up"
	quest.1B30AE1DEF39A277.quest_subtitle: "All nine ultimate factories"
	quest.1B30AE1DEF39A277.quest_desc: [
		"&eWhat:&r every factory type at ultimate tier: smelting, enriching, crushing, compressing, combining, purifying, injecting, infusing and sawing."
		"&eHow:&r build or upgrade one of each. Purifying and injecting are the 4x and 5x ore steps; infusing makes alloys."
		"&eTip:&r this is a lot of atomic alloy. Automate the refined obsidian first."
	]
	quest.4FE53067D8E11C2A.title: "The s-Block"
	quest.4FE53067D8E11C2A.quest_subtitle: "Groups 1 and 2, plus helium"
	quest.4FE53067D8E11C2A.quest_desc: [
		"&eWhat:&r every s-block element: the alkali metals, the alkaline earth metals, hydrogen and helium."
		"&eChemistry:&r their outermost electrons sit in an s orbital. One or two to give away, which makes them reactive metals (helium's full 1s² shell is the exception)."
		"&eHow:&r the Dissolver gives most of the light metals (helium needs fusion: H + H). Rubidium, cesium, francium and radium are rare: build them in the Fusion Chamber by adding proton numbers (check JEI)."
		"&eTip:&r francium is so unstable that no one has ever seen a visible amount of it."
	]
	quest.1E660F2BA4576CE8.title: "The p-Block: Light"
	quest.1E660F2BA4576CE8.quest_subtitle: "Periods 2 to 4 of groups 13–18"
	quest.1E660F2BA4576CE8.quest_desc: [
		"&eWhat:&r the lighter p-block elements: the non-metals of life and most of what you've refined so far."
		"&eChemistry:&r these elements fill p orbitals. Across a row they go from metals that lose electrons to halogens that grab them, ending at a noble gas."
		"&eHow:&r most come from the Dissolver. Neon, argon and krypton need the Fusion Chamber (check JEI)."
		"&eTip:&r carbon, nitrogen, oxygen and phosphorus are most of the mass of a living thing besides hydrogen."
	]
	quest.0F28C5F7ADC0D5D0.title: "The p-Block: Heavy"
	quest.0F28C5F7ADC0D5D0.quest_subtitle: "Periods 5 to 7, ending at element 118"
	quest.0F28C5F7ADC0D5D0.quest_desc: [
		"&eWhat:&r the heavy p-block, including the superheavy elements made only in particle accelerators."
		"&eChemistry:&r past lead, every element is radioactive. Bismuth's half-life is a billion times the age of the universe; oganesson's is under a millisecond."
		"&eHow:&r the Fusion and Fission Chambers. Pick pairs whose proton numbers add up (check JEI)."
		"&eTip:&r astatine is the rarest naturally occurring element: less than a gram exists in Earth's crust at any time."
	]
	quest.525A2965171EDB91.title: "The d-Block: Period 4"
	quest.525A2965171EDB91.quest_subtitle: "Scandium to zinc"
	quest.525A2965171EDB91.quest_desc: [
		"&eWhat:&r the first row of transition metals, the workhorses of industry."
		"&eChemistry:&r transition metals fill d orbitals, which gives them colourful compounds, several oxidation states and catalytic tricks (iron in Haber-Bosch, platinum in Ostwald)."
		"&eHow:&r dissolve their ingots and dusts; build scandium and vanadium by fusion if you can't find a source (check JEI)."
		"&eTip:&r stainless steel is iron, chromium and nickel: three boxes in this row."
	]
	quest.0388D8B002BD2CC4.title: "The d-Block: Period 5"
	quest.0388D8B002BD2CC4.quest_subtitle: "Yttrium to cadmium"
	quest.0388D8B002BD2CC4.quest_desc: [
		"&eWhat:&r the second transition row, including three platinum-group metals."
		"&eChemistry:&r technetium (43) was the first element made artificially, in 1937. It has no stable isotope at all."
		"&eHow:&r ruthenium and rhodium come from your PGM residue; the rest by dissolving or fusion (check JEI)."
		"&eTip:&r rhodium is one of the most expensive metals on Earth, mostly used in car catalytic converters."
	]
	quest.40683E6E4778245E.title: "The d-Block: Period 6"
	quest.40683E6E4778245E.quest_subtitle: "Hafnium to mercury"
	quest.40683E6E4778245E.quest_desc: [
		"&eWhat:&r the heaviest stable transition metals: refractory tungsten, dense osmium, noble platinum and gold."
		"&eChemistry:&r osmium is the densest element (22.6 g/cm³). Gold is yellow and mercury is liquid because of relativity: their inner electrons move fast enough to change the orbitals' energies."
		"&eHow:&r the PGM line gives platinum, iridium and osmium; the rest by dissolving or fusion (check JEI)."
		"&eTip:&r tungsten has the highest melting point of any metal, 3422 °C."
	]
	quest.7509598E14623D37.title: "The d-Block: Period 7"
	quest.7509598E14623D37.quest_subtitle: "The transactinides"
	quest.7509598E14623D37.quest_desc: [
		"&eWhat:&r the superheavy transition metals, 104 to 112."
		"&eChemistry:&r each was made a few atoms at a time by smashing nuclei together. Several are named after scientists: Rutherford, Seaborg, Bohr, Meitner, Röntgen, Copernicus."
		"&eHow:&r only the Fusion Chamber makes these. Check JEI for pairs that add up."
		"&eTip:&r seaborgium was named while Glenn Seaborg was alive, a rare honour."
	]
	quest.418512B7873C1A28.title: "The Lanthanides"
	quest.418512B7873C1A28.quest_subtitle: "All fifteen rare earths of the f-block"
	quest.418512B7873C1A28.quest_desc: [
		"&eWhat:&r the whole lanthanide row, 57 to 71."
		"&eChemistry:&r they fill the 4f orbitals, which sit deep inside the atom, so their chemistry is almost identical. That's why separating them takes hundreds of extraction steps."
		"&eHow:&r press U on each element in JEI for Dissolver sources; fuse the rest in the Fusion Chamber. Promethium has no stable isotope."
		"&eTip:&r four of them are named after one Swedish village, Ytterby: yttrium, ytterbium, terbium, erbium."
	]
	quest.156884A7119394CC.title: "The Actinides"
	quest.156884A7119394CC.quest_subtitle: "All fifteen of the 5f row"
	quest.156884A7119394CC.quest_desc: [
		"&eWhat:&r the whole actinide row, 89 to 103. Every one is radioactive."
		"&eChemistry:&r only thorium and uranium last long enough to be found in quantity. Everything past uranium was first made in reactors or in the debris of bomb tests."
		"&eHow:&r dissolve uranium and thorium materials; fuse the heavier ones (check JEI)."
		"&eTip:&r americium is in most household smoke detectors."
	]
	quest.48916F4FA6905695.title: "Every Box Filled"
	quest.48916F4FA6905695.quest_subtitle: "All 118 elements, held in your hands"
	quest.48916F4FA6905695.quest_desc: [
		"&6Every element, in a chest. You remember when this was how you made worlds.&r"
		"&eWhat:&r you've collected every block of the periodic table."
		"&eHow:&r click to claim. Keep the chest; a periodic table wall of item frames is a fine way to show it off."
		"&eTip:&r the Combiner can now build almost any compound you can name."
	]
	quest.1DDE790728CC948C.title: "Tour: The Frozen North"
	quest.1DDE790728CC948C.quest_subtitle: "Seven cold Overworld biomes"
	quest.1DDE790728CC948C.quest_desc: [
		"&eWhat:&r visit seven snowy biomes."
		"&eChemistry:&r ice floats because water expands about 9% when it freezes: hydrogen bonds lock the molecules into an open hexagonal lattice."
		"&eHow:&r walk in. A Nature's Compass finds each one."
		"&eTip:&r powder snow on frozen peaks swallows players. Leather boots let you walk on it."
	]
	quest.5F230391BCAF5E21.title: "Tour: Heat and Rain"
	quest.5F230391BCAF5E21.quest_subtitle: "Seven warm Overworld biomes"
	quest.5F230391BCAF5E21.quest_desc: [
		"&eWhat:&r visit seven warm biomes, from dry desert to jungle."
		"&eChemistry:&r badlands terracotta gets its reds and oranges from iron oxides, the same rust you can make in the Combiner."
		"&eHow:&r walk in. Badlands have gold at every height, so bring a pickaxe."
		"&eTip:&r jungle temples and desert pyramids hold trim templates for the trim quests."
	]
	quest.07A9CBB7D105660B.title: "Tour: Hidden Places"
	quest.07A9CBB7D105660B.quest_subtitle: "Six rare Overworld biomes"
	quest.07A9CBB7D105660B.quest_desc: [
		"&eWhat:&r the rare and underground biomes."
		"&eChemistry:&r dripstone forms when water with dissolved calcium bicarbonate drips and loses CO₂, leaving calcium carbonate behind: Ca(HCO₃)₂ → CaCO₃ + H₂O + CO₂."
		"&eHow:&r mushroom fields are islands far out at sea. Lush and dripstone caves sit under the surface; the deep dark sits below Y 0 under mountains."
		"&eTip:&r no hostile mobs spawn on mushroom fields. Safe camping."
	]
	quest.63AC8473D812F00F.title: "Tour: Strange Lands"
	quest.63AC8473D812F00F.quest_subtitle: "Seven biomes from the biome mods"
	quest.63AC8473D812F00F.quest_desc: [
		"&eWhat:&r seven biomes from Biomes O' Plenty and Regions Unexplored."
		"&eHow:&r Nature's Compass lists modded biomes too. Prismachasm is a cave biome, so dig."
		"&eTip:&r volcanoes have lava at the top. Bring fire resistance."
	]
	quest.628CBA274F9C5F97.title: "Tour: The Five Fires"
	quest.628CBA274F9C5F97.quest_subtitle: "Every vanilla Nether biome"
	quest.628CBA274F9C5F97.quest_desc: [
		"&eWhat:&r visit all five vanilla Nether biomes."
		"&eChemistry:&r basalt is cooled lava, mostly silicates of iron and magnesium. Nether quartz is SiO₂."
		"&eHow:&r walk in. Warped forests are the safest place in the Nether: endermen only."
		"&eTip:&r ghasts hunt soul sand valleys. A shield blocks fireballs."
	]
	quest.086D64601C092565.title: "Tour: The Deeper Fires"
	quest.086D64601C092565.quest_subtitle: "Six modded Nether biomes"
	quest.086D64601C092565.quest_desc: [
		"&eWhat:&r Nether biomes from Biomes O' Plenty and Regions Unexplored."
		"&eHow:&r Nature's Compass works in the Nether too. Withered abyss is a void: don't fall in."
		"&eTip:&r crystalline chasm's crystals are pretty and brittle. Mine with care."
	]
	quest.3D24912A6A30A85B.title: "Tour: The Void"
	quest.3D24912A6A30A85B.quest_subtitle: "Every vanilla End biome"
	quest.3D24912A6A30A85B.quest_desc: [
		"&eWhat:&r visit the five End biomes, from the central island to the outer islands."
		"&eHow:&r after the dragon, throw an ender pearl into an end gateway to reach the outer islands."
		"&eTip:&r end cities sit in the highlands. Bring slow falling against shulkers."
	]
	quest.485ADC9463B35474.title: "Tour: Twilight Lowlands"
	quest.485ADC9463B35474.quest_subtitle: "Nine open Twilight Forest biomes"
	quest.485ADC9463B35474.quest_desc: [
		"&eWhat:&r the Twilight Forest biomes you can walk into from day one."
		"&eHow:&r walk in. The Magic Map shows biomes as you explore."
		"&eTip:&r enchanted forests hold rainbow oak and the odd quest ram."
	]
	quest.16F651F61CAD882E.title: "Tour: Twilight Frontier"
	quest.16F651F61CAD882E.quest_subtitle: "Nine biomes locked behind bosses"
	quest.16F651F61CAD882E.quest_desc: [
		"&eWhat:&r the Twilight biomes that open as you beat its bosses."
		"&eHow:&r locked biomes hurt or block you until you beat the boss before them. Follow the Twilight boss order in Worlds."
		"&eTip:&r the final plateau is the last place in the Twilight Forest. Enjoy the view."
	]
	quest.48F10386696CBC9B.title: "Tour: The Undergarden"
	quest.48F10386696CBC9B.quest_subtitle: "Eight Undergarden biomes"
	quest.48F10386696CBC9B.quest_desc: [
		"&eWhat:&r explore the Undergarden's biomes."
		"&eHow:&r walk in. Bring light: the Undergarden has no sun."
		"&eTip:&r smog spires and smogstem forests are where you'll find the strangest mobs."
	]
	quest.1973AAD62BAC2C46.title: "Tour: The Otherside"
	quest.1973AAD62BAC2C46.quest_subtitle: "Four biomes beyond the deep dark"
	quest.1973AAD62BAC2C46.quest_desc: [
		"&eWhat:&r the four Otherside biomes from Deeper and Darker."
		"&eHow:&r walk in. Sculk listens here too: sneak."
		"&eTip:&r echo trees in the echoing forest give wood you can't get anywhere else."
	]
	quest.01CF0FA12664D89A.title: "Tour: The Solar System"
	quest.01CF0FA12664D89A.quest_subtitle: "Nine biomes on five worlds"
	quest.01CF0FA12664D89A.quest_desc: [
		"&eWhat:&r stand in every planetary biome Ad Astra adds."
		"&eChemistry:&r Mars is red from iron(III) oxide dust; Venus's clouds are sulfuric acid droplets, the same H₂SO₄ you make in the Contact Process."
		"&eHow:&r fly to the Moon, Mars, Venus, Mercury and Glacio. Wear the right suit: Venus and Mercury need heat protection."
		"&eTip:&r martian polar caps are frozen CO₂ and water in real life; in game, bring an oxygen supply."
	]
	quest.2AA63CC0780D5E5A.title: "Element 5, Track 5"
	quest.2AA63CC0780D5E5A.quest_subtitle: "A very specific pun"
	quest.2AA63CC0780D5E5A.quest_desc: [
		"&eWhat:&r disc 5 and five boron. Boron is element 5."
		"&eChemistry:&r boron is in borosilicate glass, which barely expands when heated. That's why lab glassware survives a flame."
		"&eTip:&r the demigod finds this funnier than anyone else will."
	]
	quest.57F252721837BC8A.title: "An Egg from the Past"
	quest.57F252721837BC8A.quest_subtitle: "Something older than you"
	quest.57F252721837BC8A.quest_desc: [
		"&eWhat:&r a sniffer egg, brushed out of warm ocean ruins."
		"&eHow:&r place it on moss to hatch it faster. Adult sniffers dig up ancient seeds."
		"&eTip:&r torchflowers and pitcher plants only come from sniffers."
	]
	quest.12F7DBB03E253B15.title: "The Only One"
	quest.12F7DBB03E253B15.quest_subtitle: "There is exactly one per world"
	quest.12F7DBB03E253B15.quest_desc: [
		"&eWhat:&r the dragon egg. It teleports when you hit it."
		"&eHow:&r push it off the portal with a piston, or let it fall onto a torch, then pick it up."
		"&eTip:&r you'll need it for the Seed of a New World. Don't drop it in the void."
	]
	chapter.1CE4EAE5C8575E5D.title: "Getting Started"
	chapter.1CE4EAE5C8575E5D.chapter_subtitle: [
		"You wake in a world you didn't make, with a god's patience and none of a god's power."
		"A first day, a first night, first iron, and a first look at everything this world offers."
	]
	quest.4D8BFEB75E87D5CA.title: "The Awakening"
	quest.4D8BFEB75E87D5CA.quest_subtitle: "Everything is made of elements"
	quest.4D8BFEB75E87D5CA.quest_desc: [
		"&6You were more than this once. The book in your hands is in your own handwriting, though you don't remember writing it.&r"
		"&eWhat:&r One idea stayed with you: everything is made of elements, and elements can be taken apart and put back together. This chapter gets you through your first day and night, to iron, and gives you a first look at the rest of the book."
		"&eHow:&r Click the checkmark on the right to begin. Follow the lines: each quest leads to the next."
	]
	quest.61A00C75298573F8.title: "Tip: Recipes and Jade"
	quest.61A00C75298573F8.quest_subtitle: "R for recipes, U for uses"
	quest.61A00C75298573F8.quest_desc: [
		"&eWhat:&r JEI shows every recipe in the pack, including the ones changed for progression. Jade shows a small panel at the top of the screen for whatever block you're looking at."
		"&eHow:&r Press &eR&r over any item to see how it's made, or &eU&r to see what it's used in. Try it on the crafting table you're about to make, then click the checkmark."
		"&eTip:&r Type &e@modname&r in the JEI search bar to list a mod's items. When a machine isn't working, look at it: Jade shows its progress, energy and fluids, and usually why."
	]
	quest.7DAB1CA1D0DC9E58.title: "Punch a Tree"
	quest.7DAB1CA1D0DC9E58.quest_subtitle: "Bare hands, sixteen logs"
	quest.7DAB1CA1D0DC9E58.quest_desc: [
		"&eWhat:&r You start with nothing. Logs are the first thing you can take with bare hands, and everything early is made from them."
		"&eChemistry:&r Wood is mostly &ecellulose&r, (C₆H₁₀O₅)ₙ, long chains of glucose, bound together by &elignin&r, a tough aromatic polymer that keeps trees standing."
		"&eHow:&r Hold left-click on a tree trunk. Any kind of log counts."
		"&eTip:&r FTB Ultimine fells a whole tree at once: hold the &e`&r key (grave/tilde) while you break the bottom log."
	]
	quest.310586A0CE86D7B4.title: "Planks and a Workbench"
	quest.310586A0CE86D7B4.quest_subtitle: "One log, four planks; four planks, one table"
	quest.310586A0CE86D7B4.quest_desc: [
		"&eWhat:&r Planks are the basic building material for tables, tools, chests and beds. Your inventory only has a 2x2 grid; almost every tool and machine needs the full 3x3 grid of a crafting table."
		"&eHow:&r Put a log in the 2x2 grid in your inventory: each log gives 4 planks. Then 4 planks in the 2x2 grid make the table. Place it and right-click it."
		"&eTip:&r Keep a few logs as logs: some shortcuts below use them directly. The 8 torches in the reward get you through your first night."
	]
	quest.490B2EFFC87D0F70.title: "Somewhere to Put Things"
	quest.490B2EFFC87D0F70.quest_subtitle: "A chest for your first stockpile"
	quest.490B2EFFC87D0F70.quest_desc: [
		"&eWhat:&r You'll collect far more than you can carry. Chests hold 27 stacks each, and two side by side make a double chest."
		"&eHow:&r 8 planks in a ring make one chest. The &eUtilitarian&r shortcut is better: 8 &elogs&r in a ring make 4 chests."
		"&eTip:&r A chest is also the heart of your first backpack. That quest, and everything else about storage, is on the &eStorage and Logistics&r page."
	]
	quest.60D1BFC33DF3DC5B.title: "Messing About in Boats"
	quest.60D1BFC33DF3DC5B.quest_subtitle: "Faster than walking along a coast"
	quest.60D1BFC33DF3DC5B.quest_desc: [
		"&eWhat:&r A boat crosses rivers and oceans much faster than swimming, and you can scout coastlines for villages and exposed ore."
		"&eChemistry:&r Dry wood is about 0.4 to 0.7 g/cm³, lighter than water at 1.0 g/cm³, so it floats. That's density, nothing more."
		"&eHow:&r 5 planks of one wood in a U shape. Check JEI for the chest boat too."
		"&eTip:&r Mobs that touch a boat get pulled into it. Handy for moving a cow home."
	]
	quest.056B70005B9D0DDB.title: "Sticks and a Wooden Pick"
	quest.056B70005B9D0DDB.quest_subtitle: "Just enough to break stone"
	quest.056B70005B9D0DDB.quest_desc: [
		"&eWhat:&r Sticks are the handle of every tool and torch. A wooden pickaxe is weak, but it can mine stone, and stone is your next step."
		"&eHow:&r 2 planks stacked vertically make 4 sticks. Then 3 planks across the top and 2 sticks down the middle of a crafting table make the pickaxe."
		"&eTip:&r &eUtilitarian&r adds a shortcut: 2 &elogs&r stacked vertically make &e16 sticks&r, twice as many per log as going through planks."
	]
	quest.1E339D434FEA09CE.title: "Stone Age"
	quest.1E339D434FEA09CE.quest_subtitle: "Cobblestone, and a pickaxe that can mine iron"
	quest.1E339D434FEA09CE.quest_desc: [
		"&eWhat:&r Cobblestone makes stone tools, a furnace and a safe first shelter. A stone pickaxe can mine iron ore."
		"&eChemistry:&r Stone is a mix of &esilicate minerals&r: quartz (SiO₂) and feldspars, aluminium silicates of sodium, potassium and calcium. Silicon and oxygen are the two most common elements in the Earth's crust."
		"&eHow:&r Dig a few blocks down or mine a cliff face: stone drops cobblestone. The stone pickaxe is the wooden shape with 3 cobblestone in place of planks."
		"&eTip:&r FTB Ultimine mines a whole vein at once. Hold the &e`&r key (grave/tilde) while breaking blocks."
	]
	quest.4A91AD1D881ECA8C.title: "Coal"
	quest.4A91AD1D881ECA8C.quest_subtitle: "Ancient carbon from the ground"
	quest.4A91AD1D881ECA8C.quest_desc: [
		"&eWhat:&r Coal fuels furnaces now, and becomes coke and steel in Chapter II."
		"&eChemistry:&r Coal is plant matter buried for millions of years. Heat and pressure drove off most of its hydrogen and oxygen and left mostly carbon."
		"&eHow:&r Coal ore is the black-speckled stone common in exposed cliffs and mountains. Mine it with any pickaxe."
		"&eTip:&r Save extra coal for torches on your first mining trip. The Coke Oven in Chapter II eats a lot of it too."
	]
	quest.599FACBAB88E4288.title: "A Full Toolkit"
	quest.599FACBAB88E4288.quest_subtitle: "Sword, axe and shovel"
	quest.599FACBAB88E4288.quest_desc: [
		"&eWhat:&r A sword for the first night, an axe for faster wood, and a shovel for dirt, sand and gravel."
		"&eHow:&r Each takes 1 to 3 cobblestone and 1 or 2 sticks. Press &eR&r on each one if you forget the shape."
		"&eTip:&r An axe is also a decent weapon: it hits harder than a sword but swings slower."
	]
	quest.45D377EFE9BE87BC.title: "Bow and Arrow"
	quest.45D377EFE9BE87BC.quest_subtitle: "Deal with creepers from a distance"
	quest.45D377EFE9BE87BC.quest_desc: [
		"&eWhat:&r A bow lets you kill creepers and skeletons before they reach you."
		"&eHow:&r 3 sticks and 3 string make a bow. Arrows are flint, a stick and a feather. Spiders drop string, chickens drop feathers, and gravel sometimes drops flint."
		"&eTip:&r Hold right-click to draw the bow fully. A half-drawn shot does little damage."
	]
	quest.324A651EE9DDF0ED.title: "Fire"
	quest.324A651EE9DDF0ED.quest_subtitle: "Your first chemistry tool"
	quest.324A651EE9DDF0ED.quest_desc: [
		"&eWhat:&r Fire is your first chemistry tool. It cooks food, turns sand into glass and ore into metal, and chars logs into charcoal (more on that in Chapter I)."
		"&eChemistry:&r A furnace drives reactions with heat. Most of what it does is breaking bonds and letting atoms find new partners."
		"&eHow:&r 8 cobblestone in a ring make a furnace. Logs, planks, coal and charcoal all burn as fuel."
		"&eTip:&r Furnaces in this pack cook about &e4x faster&r than vanilla, so you rarely wait on one."
	]
	quest.5E58EA492DF847CE.title: "Campfire"
	quest.5E58EA492DF847CE.quest_subtitle: "Cooks without fuel"
	quest.5E58EA492DF847CE.quest_desc: [
		"&eWhat:&r A campfire cooks up to 4 pieces of food at once and never needs fuel."
		"&eChemistry:&r A log on a campfire chars slowly without enough air to burn through: that's &epyrolysis&r, the same reaction as the furnace, just slower."
		"&eHow:&r 3 sticks, 1 coal or charcoal and 3 logs (check JEI). Right-click food onto it."
		"&eTip:&r &eUtilitarian&r lets a campfire cook any log that burns into charcoal. Smoke rising from it also helps you find home."
	]
	quest.602F11E333E93BCA.title: "Glass"
	quest.602F11E333E93BCA.quest_subtitle: "Melted sand"
	quest.602F11E333E93BCA.quest_desc: [
		"&eWhat:&r Windows let you see out of your shelter, and glass shows up in many machine recipes later."
		"&eChemistry:&r Sand is mostly silica, SiO₂. Melted and cooled quickly, it can't line up into crystals and freezes into a disordered solid: glass. Real glassmakers add soda (Na₂CO₃) to lower its melting point of about 1,700 °C."
		"&eHow:&r Smelt sand in a furnace. Beaches, deserts and riverbeds are full of it."
	]
	quest.38196E0094811FC0.title: "Light in the Dark"
	quest.38196E0094811FC0.quest_subtitle: "Combustion you can carry"
	quest.38196E0094811FC0.quest_desc: [
		"&eWhat:&r Torches stop monsters spawning and light up caves."
		"&eChemistry:&r A torch is &ecombustion&r: carbon reacting with oxygen, C + O₂ → CO₂, releasing heat and light."
		"&eHow:&r One coal or charcoal on top of one stick makes 4 torches. No coal yet? Smelt a log into charcoal: it works just as well."
	]
	quest.1010A20D70EB78BD.title: "A Roof Overhead"
	quest.1010A20D70EB78BD.quest_subtitle: "Walls, a door, and light"
	quest.1010A20D70EB78BD.quest_desc: [
		"&eWhat:&r Monsters spawn in the dark. A small, lit, enclosed room keeps you safe while you work."
		"&eHow:&r Build four walls and a roof from planks or cobblestone, add a door, and light the inside with torches. Click the checkmark when you're done."
		"Days here last about &etwice as long&r as in vanilla (roughly 20 minutes of daylight); nights are normal length, and rain is rarer and shorter."
		"&eTip:&r Leave room to grow: your steam machines in Chapter I need floor space. The &eBuilding and Decoration&r page has ideas for later."
	]
	quest.3D0106C659AAF65F.title: "A Bed"
	quest.3D0106C659AAF65F.quest_subtitle: "Skip the night, set your spawn"
	quest.3D0106C659AAF65F.quest_desc: [
		"&6You never needed sleep before. Lying in the dark, you remember why mortals feared it.&r"
		"&eWhat:&r Sleeping skips the night and sets your spawn point, so you wake up here if you die."
		"&eChemistry:&r Wool is &ekeratin&r, a protein held together by sulfur-sulfur bonds between cysteine units. The same protein makes up your hair and nails."
		"&eHow:&r 3 wool of one colour over 3 planks. Shear sheep or kill them for wool."
		"&eTip:&r Going exploring? A sleeping bag skips the night without moving your spawn (see the &eQuality of Life&r page)."
	]
	quest.0AF857F7D594D497.title: "A First Field"
	quest.0AF857F7D594D497.quest_subtitle: "Seeds, hoe, water, wheat"
	quest.0AF857F7D594D497.quest_desc: [
		"&eWhat:&r A small wheat field feeds you for the whole early game."
		"&eChemistry:&r A plant builds itself out of air and water using sunlight: &ephotosynthesis&r, 6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂."
		"&eHow:&r Break grass and tall grass for seeds. Craft a hoe, till dirt next to water and plant them. Farmland stays wet up to 4 blocks from water. Harvest when the wheat turns golden."
		"&eTip:&r Bone meal (from skeleton bones) is calcium phosphate, a real fertiliser. Right-click a crop with it to grow it faster."
	]
	quest.26EAA1BDD3A1CE92.title: "Sugar Cane"
	quest.26EAA1BDD3A1CE92.quest_subtitle: "Sugar and paper"
	quest.26EAA1BDD3A1CE92.quest_desc: [
		"&eWhat:&r Sugar cane gives sugar for food and paper for books, maps and Silent Gear blueprints."
		"&eChemistry:&r Table sugar is &esucrose&r, C₁₂H₂₂O₁₁: one glucose and one fructose joined together. Paper is pressed cellulose fibres, the same polymer as wood."
		"&eHow:&r Find cane growing on sand or dirt right next to water. Plant it the same way to farm it; break the top and leave the bottom block."
		"&eTip:&r &eUtilitarian&r makes paper in the 2x2 grid: 3 cane in an L shape give 3 paper."
	]
	quest.2181236B6834BFDF.title: "Something to Eat"
	quest.2181236B6834BFDF.quest_subtitle: "Wheat, bread, and a full belly"
	quest.2181236B6834BFDF.quest_desc: [
		"&eWhat:&r Gods don't need to eat. You do, for now."
		"&eChemistry:&r Baking turns starch and protein into new compounds. The brown crust comes from the &eMaillard reaction&r between sugars and amino acids."
		"&eHow:&r 3 wheat in a row on a crafting table make 1 bread. With &eUtilitarian&r you can also put 3 wheat in an L shape in your 2x2 grid."
		"&eTip:&r AppleSkin shows how much hunger and saturation each food restores."
	]
	quest.0157B1B9C1096892.title: "Cooked Meat"
	quest.0157B1B9C1096892.quest_subtitle: "Much better than bread"
	quest.0157B1B9C1096892.quest_desc: [
		"&eWhat:&r Cooked meat restores far more hunger and saturation than bread. Cows also drop the leather you need next."
		"&eChemistry:&r Heat &edenatures&r proteins: it unfolds them so they firm up, and turns tough collagen into soft gelatin. It also kills bacteria."
		"&eHow:&r Kill cows, pigs, sheep, chickens or rabbits and cook the raw meat in a furnace, smoker or on a campfire. Any mix of cooked meat counts."
		"&eTip:&r Breed animals with wheat (cows, sheep) or carrots (pigs) next to your base so you never have to hunt far."
	]
	quest.050738B186A5EEB8.title: "Gone Fishing"
	quest.050738B186A5EEB8.quest_subtitle: "Food from any patch of water"
	quest.050738B186A5EEB8.quest_desc: [
		"&eWhat:&r A fishing rod gets you food anywhere there's water, plus the odd treasure."
		"&eHow:&r 3 sticks and 2 string. Cast it into water and pull it in when the bobber dips. Cook the cod or salmon you catch."
		"&eTip:&r A rod also reels in mobs and items, and fishing in the rain is faster."
	]
	quest.2575EE3D3B863D1D.title: "Leather Armour"
	quest.2575EE3D3B863D1D.quest_subtitle: "Better than nothing"
	quest.2575EE3D3B863D1D.quest_desc: [
		"&eWhat:&r Leather armour is weak, but it's the first protection you can make, and it's dyeable."
		"&eChemistry:&r Leather is animal skin that's been &etanned&r: tannins or chromium salts cross-link the collagen proteins so the hide stops rotting and stays flexible."
		"&eHow:&r Cows drop leather. A tunic takes 8 leather and boots take 4."
		"&eTip:&r Save spare leather: your first backpack needs some (on the &eStorage and Logistics&r page)."
	]
	quest.1C5E43BCEDA7593F.title: "Iron"
	quest.1C5E43BCEDA7593F.quest_subtitle: "Ore, heat, and carbon make metal"
	quest.1C5E43BCEDA7593F.quest_desc: [
		"&6The ore gives up its metal in the fire. Once, you did this with a thought.&r"
		"&eWhat:&r Iron is the metal of your first real tools, buckets and armour, and the key to most of the other pages in this book."
		"&eChemistry:&r Iron ore is iron oxide. In the furnace, carbon pulls the oxygen away: Fe₂O₃ + 3C → 2Fe + 3CO. That's &ereduction&r."
		"&eHow:&r Mine iron ore with a stone pickaxe (it's common around Y 16 and in mountains) and smelt the raw iron."
		"&eTip:&r Iron Furnaces (on the &eStorage and Logistics&r page) smelt faster once you have spare iron."
	]
	quest.0A8F569FBAF9D8B1.title: "Shield"
	quest.0A8F569FBAF9D8B1.quest_subtitle: "Block the arrows"
	quest.0A8F569FBAF9D8B1.quest_desc: [
		"&eWhat:&r A shield blocks arrows, melee hits and creeper blasts while you hold right-click."
		"&eHow:&r 1 iron ingot and 6 planks (check JEI for the shape)."
		"&eTip:&r Hold it in your off-hand so you can block and swing at the same time. The &eMonster Hunting&r page opens from here."
	]
	quest.5B6DEEA0E16717D8.title: "Shearing Season"
	quest.5B6DEEA0E16717D8.quest_subtitle: "Wool without killing the sheep"
	quest.5B6DEEA0E16717D8.quest_desc: [
		"&eWhat:&r Shears take 1 to 3 wool from a sheep without hurting it, and the wool grows back after the sheep eats grass."
		"&eChemistry:&r Raw wool is coated in &elanolin&r, a waxy mix of esters that keeps the sheep dry. It's the base of many skin creams."
		"&eHow:&r 2 iron ingots placed diagonally make shears. Right-click a sheep."
		"&eTip:&r Dye a sheep before you shear it to get coloured wool every time it regrows."
	]
	quest.7A1D323C6D2FA6FE.title: "Iron Pickaxe"
	quest.7A1D323C6D2FA6FE.quest_subtitle: "Diamonds, gold and redstone open up"
	quest.7A1D323C6D2FA6FE.quest_desc: [
		"&eWhat:&r Needed for diamonds, redstone and gold, and to start the journey to the Nether."
		"&eChemistry:&r Iron is harder than stone because its atoms sit in a regular metal lattice held by metallic bonds, which bend rather than shatter."
		"&eHow:&r 3 iron ingots and 2 sticks."
	]
	quest.04E36C5B3B405E19.title: "Redstone"
	quest.04E36C5B3B405E19.quest_subtitle: "A red dust that carries a signal"
	quest.04E36C5B3B405E19.quest_desc: [
		"&eWhat:&r Redstone powers doors, lamps and contraptions now, and goes into circuits and machines all through the book."
		"&eChemistry:&r Redstone has no real-world twin, but its ore looks a lot like &ecinnabar&r, mercury sulfide (HgS): the red mineral people once ground into vermilion paint."
		"&eHow:&r Redstone ore sits deep, mostly below Y 16, and needs an iron pickaxe. Each block drops several dust."
		"&eTip:&r Levers, repeaters and the rest are on the &eQuality of Life&r page (Redstone Basics)."
	]
	quest.51ADE3E5594C4B5E.title: "All That Glitters"
	quest.51ADE3E5594C4B5E.quest_subtitle: "Pretty, soft, and useful in the Nether"
	quest.51ADE3E5594C4B5E.quest_desc: [
		"&eWhat:&r Gold armour is weaker than iron and wears out fast, but in the Nether piglins leave you alone while you wear one piece."
		"&eChemistry:&r Gold is a &enoble metal&r: it hardly reacts with oxygen or water, so it never tarnishes. That's why ancient gold still shines."
		"&eHow:&r Mine gold ore with an iron pickaxe and smelt it. Any one piece of gold armour counts."
	]
	quest.59D6F5D488007219.title: "Carbon Under Pressure"
	quest.59D6F5D488007219.quest_subtitle: "Your first diamond"
	quest.59D6F5D488007219.quest_desc: [
		"&eWhat:&r Diamonds make the toughest vanilla tools, and a diamond pickaxe is the only early way to mine obsidian."
		"&eChemistry:&r A diamond is the same element as coal: carbon. Here every atom is bonded to four others in a rigid 3D lattice, formed about 150 km underground under enormous pressure."
		"&eHow:&r Diamond ore sits in the deepslate layers, most of it near the bottom of the world. Mine it with an iron pickaxe."
		"&eTip:&r Obsidian is the frame of the Nether portal in Chapter III. Keep your first diamonds for a pickaxe."
	]
	quest.3FB7FDD71CA1A2C2.title: "Iron Tools"
	quest.3FB7FDD71CA1A2C2.quest_subtitle: "Sword, axe and shovel in iron"
	quest.3FB7FDD71CA1A2C2.quest_desc: [
		"&eWhat:&r Iron tools are faster and last far longer than stone, and an iron sword handles anything the early nights throw at you."
		"&eHow:&r Same shapes as the stone tools, with iron ingots in place of cobblestone."
		"&eTip:&r Your iron pickaxe, axe and shovel combine into one &epaxel&r: that quest is on the &eGear and Comfort&r page."
	]
	quest.78AB87381549A629.title: "Iron Armour"
	quest.78AB87381549A629.quest_subtitle: "A full set before you dig deep"
	quest.78AB87381549A629.quest_desc: [
		"&eWhat:&r A full set of iron armour makes caves and the night survivable."
		"&eHow:&r Helmet, chestplate, leggings and boots take 24 iron ingots in total."
		"&eTip:&r Ultimine through an iron vein and you'll have this set in minutes."
	]
	quest.39214B137E06B1D9.title: "Chainmail"
	quest.39214B137E06B1D9.quest_subtitle: "Rings of iron, linked together"
	quest.39214B137E06B1D9.quest_desc: [
		"&eWhat:&r Chainmail sits between leather and iron. It isn't craftable in vanilla, but you can trade an armourer villager for it or take it from a mob that spawned wearing it."
		"&eChemistry:&r Interlocked rings spread the force of a blow across many links, so no single point takes the whole hit."
		"&eHow:&r Modern Industrialization adds a recipe from &eIron Rings&r once you have its tools (check JEI for both). Any one piece counts."
	]
	quest.6939E4AEBA9EF3ED.title: "Water"
	quest.6939E4AEBA9EF3ED.quest_subtitle: "The most important chemical in the pack"
	quest.6939E4AEBA9EF3ED.quest_desc: [
		"&eWhat:&r Water is the most important chemical in this pack: steam, electrolysis and acids all start with it."
		"&eChemistry:&r H₂O is a small, polar molecule. That polarity lets it dissolve salts and acids, which is why chemists call it the universal solvent."
		"&eHow:&r 3 iron ingots in a V make a bucket. Fill it at any water source."
		"&eTip:&r Two water sources in a 2x2 hole make an infinite spring. Carry a water bucket while mining: it puts out fire and breaks falls."
	]
	quest.0316A92702C409B9.title: "A Taste of Everything"
	quest.0316A92702C409B9.quest_subtitle: "The book is wider than one road"
	quest.0316A92702C409B9.quest_desc: [
		"&6Your memories come back in pieces, and not in order. Gears, spirits, strange seeds: you knew all of it once.&r"
		"&eWhat:&r The Demigod's Path is the main road, but every category in the sidebar is a mod with its own chapters. The quests here are one small step into a few of them, and each says where to go next."
		"&eHow:&r Click the checkmark, then try whichever look fun. Most of these are optional."
		"&eTip:&r None of these block Chapter I. Claim Your Land and Tools from Parts are worth doing early; the rest can wait for a quiet evening."
	]
	quest.384F1C4A2EF051A0.title: "Tools from Parts"
	quest.384F1C4A2EF051A0.quest_subtitle: "Silent Gear: stats come from materials"
	quest.384F1C4A2EF051A0.quest_desc: [
		"&eWhat:&r Silent Gear builds tools from parts. Each part's stats come from its &ematerial&r, so better chemistry means better tools."
		"&eHow:&r Make Blueprint Paper, craft a Pickaxe Blueprint, then craft a pickaxe head and rod (check JEI). An iron head is a good start."
		"&eTip:&r Repair kits, better materials and the paxels are on the &eGear and Comfort&r page."
	]
	quest.61288F458A90D25B.title: "Clockwork"
	quest.61288F458A90D25B.quest_subtitle: "Create: a first piece of machinery"
	quest.61288F458A90D25B.quest_desc: [
		"&eWhat:&r Create is the pack's early mechanical tier: shafts, water wheels, presses and mixers that turn by rotation, before you have electricity."
		"&eChemistry:&r Andesite is a grey volcanic rock, rich in feldspar. Bound with metal it makes a cheap, sturdy frame material, which is all Create needs from it."
		"&eHow:&r Andesite and iron nuggets in a 2x2 grid (check JEI). Andesite is the speckled grey stone common in hills and caves."
		"&eTip:&r &eThe Mechanical Age&r category picks up from here. Create feeds Modern Industrialization later; it doesn't replace it."
	]
	quest.421D29C6B470FAC0.title: "Kitchen Chemistry"
	quest.421D29C6B470FAC0.quest_subtitle: "Farmer's Delight: a proper meal"
	quest.421D29C6B470FAC0.quest_desc: [
		"&eWhat:&r Farmer's Delight meals restore more hunger and give the Nourishment and Comfort effects."
		"&eChemistry:&r Stewing denatures proteins: heat unfolds them, which is why meat turns firm and tender."
		"&eHow:&r Craft a Cooking Pot (iron, bricks, a water bucket and a wooden shovel), set it over a campfire or stove, and cook raw beef, a carrot and a potato."
		"&eTip:&r The &eFarming and Food&r category has knives, crops, feasts and more."
	]
	quest.6FBF739C4468CF71.title: "Seeds of Plenty"
	quest.6FBF739C4468CF71.quest_subtitle: "Mystical Agriculture: essence from the ground"
	quest.6FBF739C4468CF71.quest_desc: [
		"&eWhat:&r Inferium essence is the base of Mystical Agriculture, whose crops grow resources instead of food."
		"&eHow:&r Inferium ore is green-flecked stone found underground; mine it with any pickaxe. Mobs drop a little essence too."
		"&eTip:&r The &eMystical Agriculture&r category starts with the Infusion Altar. Higher seed tiers need MI circuits, and the chemistry milestones can't be grown at all."
	]
	quest.2810F0141953C3BE.title: "Strange Seeds"
	quest.2810F0141953C3BE.quest_subtitle: "Occultism: a plant that shows hidden things"
	quest.2810F0141953C3BE.quest_desc: [
		"&eWhat:&r Demon's Dream seeds are the first step into Occultism, the pack's spirit magic."
		"&eChemistry:&r Real datura plants are full of &etropane alkaloids&r such as scopolamine and atropine. They're poisonous, and they cause vivid hallucinations. Never eat the real thing."
		"&eHow:&r Break grass: the seeds drop now and then."
		"&eTip:&r The &eOccultism&r category shows what the fruit does and what the spirits can do for you."
	]
	quest.78540BFEDFE5CCD4.title: "Claim Your Land"
	quest.78540BFEDFE5CCD4.quest_subtitle: "Protect your base with FTB Chunks"
	quest.78540BFEDFE5CCD4.quest_desc: [
		"&eWhat:&r FTB Chunks protects your base and can keep it loaded while you're away."
		"&eHow:&r Press &eM&r to open the map, then drag over chunks to claim them. Click the checkmark when done."
		"&eTip:&r Right-click a claimed chunk to force-load it. You'll need that for the flight pylon later. More conveniences like this are on the &eQuality of Life&r page."
	]
	quest.4FA8CDAE5F6EBCB4.title: "A First Mining Trip"
	quest.4FA8CDAE5F6EBCB4.quest_subtitle: "Go down, come back richer"
	quest.4FA8CDAE5F6EBCB4.quest_desc: [
		"&eWhat:&r Chapter I needs copper and plenty of iron. Time for a proper trip underground."
		"&eChemistry:&r Below about Y 0, stone gives way to &edeepslate&r: older, denser rock formed under more heat and pressure. Ores near the surface are often oxidised by air and water, which is why copper ore has green streaks."
		"&eHow:&r Pack torches, food, a water bucket and spare tools. Dig a staircase down (never straight down) or explore a cave, and bring back raw copper and raw iron."
		"&eTip:&r &eUtilitarian&r turns 7 logs (in the ladder shape) into 24 ladders. Place a ladder line in your shaft so you can always climb out."
	]
	quest.5D6A23FA8DF41833.title: "Rock Collector"
	quest.5D6A23FA8DF41833.quest_subtitle: "One of every vanilla ore drop"
	quest.5D6A23FA8DF41833.quest_desc: [
		"&eWhat:&r Collect one drop from every vanilla ore. Emeralds only generate in mountain biomes."
		"&eChemistry:&r Real ores are minerals: iron comes from oxides like hematite (Fe₂O₃), copper often from sulfides like chalcopyrite (CuFeS₂), and diamond is pure carbon."
		"&eTip:&r Every one of these can go into the Dissolver later. Keep spares."
	]
	quest.51F87365154D80E8.title: "A Closer Look"
	quest.51F87365154D80E8.quest_subtitle: "Copper and amethyst"
	quest.51F87365154D80E8.quest_desc: [
		"&eWhat:&r A spyglass lets you scout terrain and spot ore in cliff faces from far away."
		"&eChemistry:&r Amethyst is quartz (SiO₂). Its purple colour comes from traces of iron in the crystal."
		"&eHow:&r 2 copper ingots and 1 amethyst shard. Amethyst geodes sit underground, ringed with smooth basalt."
	]
	quest.14F9F46803366AD8.title: "Ready for Chemistry"
	quest.14F9F46803366AD8.quest_subtitle: "Fed, armed, sheltered"
	quest.14F9F46803366AD8.quest_desc: [
		"&6Fed, armed, sheltered: a good day, by mortal standards. Now the real work begins, the long road back to what you were.&r"
		"&eWhat:&r Chapter I, Fire and Bronze, starts the Demigod's Path proper: charcoal, your first alloy and steam power."
		"&eHow:&r Click to open Chapter I. The copper and tin in the reward are a head start on bronze."
		"&eTip:&r Bring spare coal and iron. Chapter I eats both."
	]
	chapter.48AF3DD6C95E2CE8.title: "I. Fire and Bronze"
	chapter.48AF3DD6C95E2CE8.chapter_subtitle: [
		"Heat drives chemistry: reduce ore with carbon, mix metals into alloys, and let steam do the work."
	]
	quest.79F4E5BCC7D2EFBF.title: "Pyrolysis"
	quest.79F4E5BCC7D2EFBF.quest_subtitle: "Wood, heat, and no air"
	quest.79F4E5BCC7D2EFBF.quest_desc: [
		"&6You remember the first fire you ever tamed. It was smaller than this, and it frightened you more.&r"
		"&eWhat:&r &eCharcoal&r is almost pure carbon: fuel, and the reducing agent that turns ore into metal."
		"&eChemistry:&r Heat wood without enough oxygen to burn and the volatile compounds escape as smoke, tar, methanol and acetic acid. What's left is carbon. This is &epyrolysis&r."
		"&eHow:&r Smelt logs in a furnace."
		"&eTip:&r A tree farm now saves hours later. Charcoal fuels everything until you have coke."
	]
	quest.139143689A0FF7FD.title: "Copper"
	quest.139143689A0FF7FD.quest_subtitle: "The first metal humans smelted"
	quest.139143689A0FF7FD.quest_desc: [
		"&eWhat:&r Copper is three quarters of bronze, and MI uses it for rotors, gears and wires."
		"&eChemistry:&r Smelting is &ereduction&r: carbon pulls oxygen away from the metal oxide and leaves metal behind, CuO + C → Cu + CO."
		"&eHow:&r Copper ore is common near the surface, especially in dripstone caves. Smelt the raw copper."
		"&eTip:&r You'll need far more than sixteen: this chapter's pipes, rotors and gears are mostly copper."
	]
	quest.30FB6A2D6AE22741.title: "Tin"
	quest.30FB6A2D6AE22741.quest_subtitle: "The other quarter of bronze"
	quest.30FB6A2D6AE22741.quest_desc: [
		"&eWhat:&r Tin is soft on its own, but a little of it makes copper much harder."
		"&eChemistry:&r Real tin comes from cassiterite, SnO₂. Carbon reduces it the same way: SnO₂ + 2C → Sn + 2CO."
		"&eHow:&r Tin ore here comes from Modern Industrialization (MI). It's grey with pale specks and fairly common underground. Mine it and smelt the raw tin."
	]
	quest.622967087A4B1D2B.title: "The MI Guidebook"
	quest.622967087A4B1D2B.quest_subtitle: "Every machine and multiblock, explained"
	quest.622967087A4B1D2B.quest_desc: [
		"&eWhat:&r Modern Industrialization's own manual. It explains each machine and shows multiblock layouts."
		"&eHow:&r 8 copper nuggets around a book. Break a copper ingot into nuggets first."
		"&eTip:&r JEI (R/U) also shows multiblock shapes in 3D."
	]
	quest.2606913E31EFE860.title: "Heavy Iron Plates"
	quest.2606913E31EFE860.quest_subtitle: "The striking face of the Forge Hammer"
	quest.2606913E31EFE860.quest_desc: [
		"&eWhat:&r The Forge Hammer's head is three heavy weighted pressure plates."
		"&eChemistry:&r Iron is dense (7.9 g/cm³), so a slab of it carries a lot of momentum into each blow. That's all a hammer is."
		"&eHow:&r 2 iron ingots side by side make 1 heavy weighted pressure plate. You need 3, plus 4 more ingots for the base."
	]
	quest.1DD1902EBDA6FD91.title: "The Forge Hammer"
	quest.1DD1902EBDA6FD91.quest_subtitle: "Your first workstation"
	quest.1DD1902EBDA6FD91.quest_desc: [
		"&eWhat:&r MI's first workstation. It crushes ore and ingots into dust and hammers ingots into plates, rods and bolts."
		"&eHow:&r 3 heavy weighted pressure plates over 4 iron ingots. Place it and right-click to use."
		"&eTip:&r Ores give at most &e2x&r here. Bigger yields come later from &eacids&r, not bigger hammers. Make a spare: the Steam Compressor uses one up."
	]
	quest.1638082093BAC031.title: "Metal Dust"
	quest.1638082093BAC031.quest_subtitle: "Crush ingots so they can mix"
	quest.1638082093BAC031.quest_desc: [
		"&eWhat:&r Solid ingots can't blend. Powders can."
		"&eChemistry:&r Grinding a metal to powder gives it a huge surface area, so the two metals mix evenly when they melt together."
		"&eHow:&r Put copper and tin ingots in the Forge Hammer: 1 ingot makes 1 dust."
	]
	quest.7164771969B473AD.title: "Mixing Bronze"
	quest.7164771969B473AD.quest_subtitle: "3 copper + 1 tin"
	quest.7164771969B473AD.quest_desc: [
		"&eWhat:&r Bronze dust is the blended alloy, ready to melt into ingots."
		"&eChemistry:&r Traditional bronze is about 88% copper and 12% tin by mass. Tin atoms jam the copper crystal so its layers can't slide, which makes it harder."
		"&eHow:&r Craft 3 copper dust with 1 tin dust to get 3 bronze dust."
		"&eTip:&r The Steam Mixer later turns the same inputs into 4 bronze dust instead of 3."
	]
	quest.6EB1CA116210134C.title: "The First Alloy"
	quest.6EB1CA116210134C.quest_subtitle: "Humanity's first engineered material"
	quest.6EB1CA116210134C.quest_desc: [
		"&6Metal that never existed until a mind decided it should. The feeling is an old friend.&r"
		"&eWhat:&r &eBronze&r is harder than either copper or tin alone, and it's the frame of your whole steam age."
		"&eChemistry:&r An &ealloy&r is a mixture of metals. Its properties can beat its ingredients because the mixed atoms resist being pushed out of line."
		"&eHow:&r Smelt bronze dust in any furnace."
		"&eTip:&r The boiler, casings and machines ahead eat about sixty ingots. Keep the copper and tin coming."
	]
	quest.5D9DA66BCD1F549C.title: "Bronze Age Hoard"
	quest.5D9DA66BCD1F549C.quest_subtitle: "Four blocks of bronze"
	quest.5D9DA66BCD1F549C.quest_desc: [
		"&eWhat:&r 36 ingots of bronze, stored as blocks."
		"&eChemistry:&r Bronze resists corrosion: its surface forms a thin layer of copper compounds that protects the metal underneath. Bronze statues can last thousands of years."
		"&eHow:&r 9 bronze ingots make 1 block."
	]
	quest.4C3565E3456D5AE4.title: "Bronze Paxel"
	quest.4C3565E3456D5AE4.quest_subtitle: "Your alloy, as a tool"
	quest.4C3565E3456D5AE4.quest_desc: [
		"&eWhat:&r Mekanism Tools makes paxels from bronze too."
		"&eChemistry:&r Ancient bronze tools replaced stone ones because bronze can be cast, sharpened and repaired. Stone can only be chipped."
		"&eHow:&r Craft a bronze pickaxe, axe and shovel, then combine them with 2 sticks."
	]
	quest.555CDA91E0E40D29.title: "Bronze Armour"
	quest.555CDA91E0E40D29.quest_subtitle: "Better than iron, and you made the metal"
	quest.555CDA91E0E40D29.quest_desc: [
		"&eWhat:&r A full set of Mekanism Tools bronze armour: a little tougher than iron."
		"&eChemistry:&r Bronze Age armies wore bronze plate and scale. It was heavy, but a cast and hammered tin-bronze plate turned blades that would cut leather."
		"&eHow:&r The usual armour shapes, in bronze ingots: 24 ingots for the set."
	]
	quest.0FF0E23A8B2B7B70.title: "Bronze Plates"
	quest.0FF0E23A8B2B7B70.quest_subtitle: "The sheet metal of the steam age"
	quest.0FF0E23A8B2B7B70.quest_desc: [
		"&eWhat:&r Almost every steam machine is built from plates."
		"&eHow:&r Hammer bronze ingots in the Forge Hammer. Without a hammer tool, 2 ingots make 1 plate."
		"&eTip:&r With an Iron Hammer in the tool slot it's 1 ingot per plate, and the Steam Compressor later does it 1:1 for free."
	]
	quest.18FE9304A0173084.title: "Rods, Bolts and Rings"
	quest.18FE9304A0173084.quest_subtitle: "Small parts for bigger parts"
	quest.18FE9304A0173084.quest_desc: [
		"&eWhat:&r Gears need bolts and a ring; rings need rods and bolts."
		"&eHow:&r In the Forge Hammer, 1 bronze ingot makes 1 rod, 2 bolts or 1 ring. By hand, 4 rods and 4 bolts make 2 rings (check JEI)."
		"&eTip:&r Make a few extra of each. Every gear takes 4 bolts and a ring."
	]
	quest.6132BB59977148BB.title: "Bronze Gears"
	quest.6132BB59977148BB.quest_subtitle: "The heart of every machine casing"
	quest.6132BB59977148BB.quest_desc: [
		"&eWhat:&r Each machine casing needs a gear at its centre."
		"&eHow:&r 4 bronze plates, 4 bolts and 1 ring (check JEI for the shape)."
		"&eTip:&r Make extra rings and bolts while you're at it. You'll need several casings."
	]
	quest.697156ADC0ABAEB8.title: "Bronze Machine Casing"
	quest.697156ADC0ABAEB8.quest_subtitle: "The block every steam machine is built around"
	quest.697156ADC0ABAEB8.quest_desc: [
		"&eWhat:&r The core of every steam machine. You'll also need one for the Dissolver in Chapter II."
		"&eHow:&r 8 bronze plates around 1 bronze gear."
		"&eTip:&r The macerator, compressor, mixer, cutter and water pump each take one, and so does every multiblock hatch. Make a few."
	]
	quest.7BA24AB83BA2EFCA.title: "Glass"
	quest.7BA24AB83BA2EFCA.quest_subtitle: "Windows for tanks, pipes and mixers"
	quest.7BA24AB83BA2EFCA.quest_desc: [
		"&eWhat:&r Tanks have a glass core, every batch of fluid pipes needs a pane, and the mixer and cutter have glass windows."
		"&eChemistry:&r Sand is mostly silica, SiO₂. Melt it and cool it quickly and the atoms freeze in a jumble instead of a crystal: that's &eglass&r, a solid with the structure of a liquid."
		"&eHow:&r Smelt sand. 6 glass blocks make 16 panes."
	]
	quest.1A507DB4026F531C.title: "Bronze Tank"
	quest.1A507DB4026F531C.quest_subtitle: "Holds the boiler's water"
	quest.1A507DB4026F531C.quest_desc: [
		"&eWhat:&r A bronze tank stores 4 buckets of fluid, and the boiler and water pump each need one."
		"&eChemistry:&r Bronze resists corrosion from water, which is why it was used for ship fittings for centuries."
		"&eHow:&r 8 bronze plates around 1 glass block."
	]
	quest.6D6DC704E6FBCF0F.title: "The Wrench"
	quest.6D6DC704E6FBCF0F.quest_subtitle: "Handle MI machines with care"
	quest.6D6DC704E6FBCF0F.quest_desc: [
		"&eWhat:&r MI's wrench rotates MI machines, sets which face they output from, and picks them up quickly."
		"&eHow:&r 5 bronze plates in a wrench shape (check JEI)."
		"&eTip:&r Handy when you rearrange your steam setup for the Coke Oven in Chapter II. Held near a multiblock controller, it also highlights where hatches can go."
	]
	quest.388E5F68B0EC91E3.title: "Bronze Barrel"
	quest.388E5F68B0EC91E3.quest_subtitle: "32 stacks of one item"
	quest.388E5F68B0EC91E3.quest_desc: [
		"&eWhat:&r A barrel that holds 32 stacks of a single item and keeps them when broken."
		"&eHow:&r 8 bronze plates around a wooden barrel. Right-click to put a stack in, left-click to take one out."
		"&eTip:&r One barrel of cobblestone or charcoal clears a lot of chest space."
	]
	quest.0B24D8DEC8FC2161.title: "Iron Plates"
	quest.0B24D8DEC8FC2161.quest_subtitle: "Two ingots, one plate"
	quest.0B24D8DEC8FC2161.quest_desc: [
		"&eWhat:&r Iron plates are the first step to the Iron Hammer, the tool that unlocks brick dust."
		"&eChemistry:&r Hammering metal flat squeezes its crystal grains and tangles their defects, so the plate ends up harder than the ingot. Smiths call it &ework hardening&r."
		"&eHow:&r In the Forge Hammer, 2 iron ingots make 1 plate (1:1 once you have the Iron Hammer)."
	]
	quest.2574A917B43992A6.title: "Large Iron Plates"
	quest.2574A917B43992A6.quest_subtitle: "20 iron plates, pressed in fours"
	quest.2574A917B43992A6.quest_desc: [
		"&eWhat:&r The head of the Iron Hammer is made of large plates."
		"&eHow:&r Craft 4 iron plates in a 2x2 into 1 large plate. That's about 40 iron in total."
		"&eTip:&r Ultimine an iron vein first. This is the hungriest step of the chapter."
	]
	quest.0653BB5BC79C83EC.title: "The Iron Hammer"
	quest.0653BB5BC79C83EC.quest_subtitle: "A tool for the Forge Hammer"
	quest.0653BB5BC79C83EC.quest_desc: [
		"&eWhat:&r Put it in the Forge Hammer's tool slot to unlock better recipes: 1 ingot per plate, and crushing bricks into dust."
		"&eHow:&r 5 large iron plates and 2 sticks (check JEI). The tool loses durability with each use."
		"&eTip:&r Only use the tool slot when you need it. Plain recipes don't wear it down."
	]
	quest.536F90BA8F153AC7.title: "Clay"
	quest.536F90BA8F153AC7.quest_subtitle: "Wet earth that remembers its shape"
	quest.536F90BA8F153AC7.quest_desc: [
		"&eWhat:&r Clay goes into bricks twice: once as bricks to crush, and again raw in the fire clay mix."
		"&eChemistry:&r Clay is weathered rock: tiny flakes of aluminosilicate minerals such as kaolinite, Al₂Si₂O₅(OH)₄. Water between the flakes is what makes it mouldable."
		"&eHow:&r Dig clay blocks from riverbeds, lakes and swamps. Each block breaks into 4 balls."
		"&eTip:&r The boiler alone needs 12 clay balls and the Steam Blast Furnace in Chapter II far more. Take a whole clay patch."
	]
	quest.5B78A3B6F8685297.title: "Bricks"
	quest.5B78A3B6F8685297.quest_subtitle: "Clay, fired"
	quest.5B78A3B6F8685297.quest_desc: [
		"&eWhat:&r Single bricks, the half of fire clay you crush."
		"&eChemistry:&r Around 600 °C, clay minerals lose the water locked inside their crystals; hotter still, the grains fuse. The result is ceramic, and it can't turn back into clay."
		"&eHow:&r Smelt clay balls in a furnace."
	]
	quest.17CFDD38CE2280C0.title: "Brick Dust"
	quest.17CFDD38CE2280C0.quest_subtitle: "Crushed, already-fired clay"
	quest.17CFDD38CE2280C0.quest_desc: [
		"&eWhat:&r Brick dust is half of fire clay."
		"&eChemistry:&r Potters call crushed fired clay &egrog&r. It has already shrunk in the kiln, so mixing it into raw clay stops the new brick cracking when heated."
		"&eHow:&r Hammer bricks in the Forge Hammer with the Iron Hammer in the tool slot: 1 brick makes 1 dust."
	]
	quest.4BC4D530815158F0.title: "Fire Clay"
	quest.4BC4D530815158F0.quest_subtitle: "Clay that survives the furnace"
	quest.4BC4D530815158F0.quest_desc: [
		"&eWhat:&r Fire clay is a &erefractory&r: a material that stays solid at temperatures that would ruin ordinary brick."
		"&eChemistry:&r Refractory clays are rich in alumina (Al₂O₃) and silica (SiO₂), which melt far above a fire's temperature."
		"&eHow:&r Craft 2 clay balls with 2 brick dust to make 3 fire clay dust."
	]
	quest.604936958718809F.title: "Fire Clay Bricks"
	quest.604936958718809F.quest_subtitle: "Fired once, hard forever"
	quest.604936958718809F.quest_desc: [
		"&eWhat:&r Single fire bricks, ready to stack into blocks."
		"&eChemistry:&r Firing drives the bound water out of clay minerals and fuses the grains together. That change can't be undone."
		"&eHow:&r Smelt fire clay dust in a furnace."
	]
	quest.34418487854EFB2D.title: "Firebrick Blocks"
	quest.34418487854EFB2D.quest_subtitle: "The boiler's firebox"
	quest.34418487854EFB2D.quest_desc: [
		"&eWhat:&r The bronze boiler sits on a row of 3 fire clay brick blocks, and the Steam Furnace on 3 more."
		"&eHow:&r 4 fire clay bricks in a 2x2 make 1 block."
		"&eTip:&r Chapter II's Steam Blast Furnace is built from dozens of these. Start stockpiling clay."
	]
	quest.54BC3303179D3C2D.title: "The Diamond Hammer"
	quest.54BC3303179D3C2D.quest_subtitle: "Same slot, a much tougher head"
	quest.54BC3303179D3C2D.quest_desc: [
		"&eWhat:&r A more durable hammer for the Forge Hammer's tool slot. It does the same jobs as the Iron Hammer and wears out far more slowly."
		"&eChemistry:&r Diamond is carbon locked into a rigid 3D lattice, which makes it the hardest natural material. Iron bends; diamond doesn't."
		"&eHow:&r The Steam Compressor presses 1 diamond into 1 diamond plate; 4 plates make a large plate. Then 5 large plates and 2 sticks, in the Iron Hammer's shape."
		"&eTip:&r That's 20 diamonds. Ore yields stay capped at 2x either way, so build it only if you're tired of crafting Iron Hammers."
	]
	quest.7750194B2B6B21DA.title: "Fire Clay in Bulk"
	quest.7750194B2B6B21DA.quest_subtitle: "The mixer's better ratio"
	quest.7750194B2B6B21DA.quest_desc: [
		"&eWhat:&r Stockpile fire clay for the Steam Blast Furnace in Chapter II."
		"&eChemistry:&r The same 2 clay + 2 brick dust gives 4 fire clay in the Steam Mixer instead of 3 by hand. Better mixing, better &eyield&r."
		"&eTip:&r The Steam Macerator grinds bricks and brick blocks into dust too (4 dust per block), so the Iron Hammer can rest."
	]
	quest.659E7099634790A6.title: "Copper Plates"
	quest.659E7099634790A6.quest_subtitle: "Sheet copper for gears and blades"
	quest.659E7099634790A6.quest_desc: [
		"&eWhat:&r Copper gears and curved plates start as flat plates."
		"&eChemistry:&r Copper is one of the most &emalleable&r metals: its atoms sit in a close-packed lattice whose layers slide over each other without breaking apart."
		"&eHow:&r In the Forge Hammer, 2 copper ingots make 1 plate (1:1 with the Iron Hammer in the tool slot)."
	]
	quest.0541B786C1F6F117.title: "Curved Copper"
	quest.0541B786C1F6F117.quest_subtitle: "The cupped face of a blade"
	quest.0541B786C1F6F117.quest_desc: [
		"&eWhat:&r Rotor blades are curved copper plates on a copper rod."
		"&eHow:&r Hammer 2 copper ingots into 1 curved plate, or 1 plate into 1 curved plate with the Iron Hammer in the tool slot."
		"&eTip:&r Two rotors need 8 blades, and 2 curved plates and a rod make 4 blades."
	]
	quest.083B7812A9D1EBE8.title: "Copper Rods and Bolts"
	quest.083B7812A9D1EBE8.quest_subtitle: "Spines and fasteners"
	quest.083B7812A9D1EBE8.quest_desc: [
		"&eWhat:&r Rods hold blades, bolts hold rotors and gears together, and the Steam Compressor needs 2 rods of its own."
		"&eHow:&r In the Forge Hammer, 1 copper ingot makes 1 rod or 2 bolts."
		"&eTip:&r The Steam Cutting Machine later doubles both. Until then, the hammer will do."
	]
	quest.370D4F7A6D9CE267.title: "Copper Blades"
	quest.370D4F7A6D9CE267.quest_subtitle: "Four per rotor"
	quest.370D4F7A6D9CE267.quest_desc: [
		"&eWhat:&r The vanes of a rotor: they push water and steam through a pipe when the rotor turns."
		"&eHow:&r 2 curved copper plates stacked on a copper rod make 4 blades."
	]
	quest.7336A190E8E36AF0.title: "Copper Rings"
	quest.7336A190E8E36AF0.quest_subtitle: "Hubs for rotors and gears"
	quest.7336A190E8E36AF0.quest_desc: [
		"&eWhat:&r Every rotor and every gear is built around a ring."
		"&eHow:&r 4 copper rods and 4 copper bolts make 2 rings, or the Forge Hammer makes 1 ring from 1 ingot."
	]
	quest.208AF4B36E8297FA.title: "Copper Gears"
	quest.208AF4B36E8297FA.quest_subtitle: "Every steam machine runs on them"
	quest.208AF4B36E8297FA.quest_desc: [
		"&eWhat:&r The macerator, compressor, cutter and water pump each take 2 copper gears, the mixer 1."
		"&eHow:&r 4 copper plates, 4 copper bolts and 1 copper ring, the same shape as the bronze gear."
		"&eTip:&r That's 9 gears for the full set of machines. Build them as you need them."
	]
	quest.229F63ADEA222BD4.title: "Copper Rotors"
	quest.229F63ADEA222BD4.quest_subtitle: "Blades, a ring and bolts"
	quest.229F63ADEA222BD4.quest_desc: [
		"&eWhat:&r Rotors push fluid through pipes and pumps."
		"&eHow:&r 4 copper blades, 1 copper ring and 4 copper bolts (check JEI)."
		"&eTip:&r Fluid pipes take 2 per batch, the mixer 2 and the water pump 2. Make six."
	]
	quest.274C196DD5E225D9.title: "Copper Drill Head"
	quest.274C196DD5E225D9.quest_subtitle: "The business end of a drill"
	quest.274C196DD5E225D9.quest_desc: [
		"&eWhat:&r The tip of the Steam Mining Drill."
		"&eHow:&r A copper plate, 2 curved plates, a rod, 2 copper gears and 3 bolts (check JEI)."
		"&eTip:&r Copper is soft for a drill bit, but this one only has to turn. The drill's own power does the work."
	]
	quest.3257C24FD424AE58.title: "Steam Mining Drill"
	quest.3257C24FD424AE58.quest_subtitle: "A drill that burns fuel"
	quest.3257C24FD424AE58.quest_desc: [
		"&eWhat:&r A fuel-burning mining tool that digs a 3x3 area and can give an easy Silk Touch."
		"&eHow:&r Furnaces, diamonds, large iron plates, the copper drill head and a bucket (check JEI). Fill it from a water source and feed it solid fuel."
		"&eTip:&r Silk-touched ore goes into the Forge Hammer for 2 raw ore each."
	]
	quest.2705D93858F42684.title: "Ore, Whole"
	quest.2705D93858F42684.quest_subtitle: "Silk-touched tin for the hammer"
	quest.2705D93858F42684.quest_desc: [
		"&eWhat:&r Mine 8 tin ore blocks whole with the drill's Silk Touch mode."
		"&eChemistry:&r An ore block is mostly worthless rock (&egangue&r) around a little mineral. Crushing it first frees more of the mineral grains, which is why the Forge Hammer gets 2 raw ore from a block."
		"&eHow:&r Switch the Steam Mining Drill to Silk Touch (see its tooltip), mine tin ore, and hammer each block into 2 raw tin."
	]
	quest.696474FC1863B20C.title: "Steam Power"
	quest.696474FC1863B20C.quest_subtitle: "Fire boils water, steam does work"
	quest.696474FC1863B20C.quest_desc: [
		"&6The engines remember you even if the world doesn't. Pressure, heat, motion: old friends.&r"
		"&eWhat:&r Burn fuel, boil water, and the expanding steam does work. Welcome to the industrial revolution."
		"&eChemistry:&r Water expands more than 1,600 times in volume when it boils into steam. That pressure is what drives the machines."
		"&eHow:&r 4 bronze plates, a bronze tank, a furnace and 3 fire clay brick blocks. Give it water and fuel (coal or charcoal), and place steam machines next to it."
		"&eTip:&r A hot boiler makes 8 mB of steam a tick, enough for four bronze machines at once."
	]
	quest.1B20E348E02AE451.title: "Steam Furnace"
	quest.1B20E348E02AE451.quest_subtitle: "Smelting without fuel"
	quest.1B20E348E02AE451.quest_desc: [
		"&eWhat:&r Smelts with steam instead of fuel. Your first automated machine, and the only one that needs no pipes."
		"&eHow:&r 5 bronze plates, a furnace and 3 fire clay brick blocks. Place it touching the boiler."
		"&eTip:&r It's as slow as a vanilla furnace, but steam carries heat so well that it costs about a tenth of the fuel."
	]
	quest.296A19C3A1BFE619.title: "Curved Plates"
	quest.296A19C3A1BFE619.quest_subtitle: "The walls of a pipe"
	quest.296A19C3A1BFE619.quest_desc: [
		"&eWhat:&r Pipes are made from curved bronze plates."
		"&eHow:&r Hammer 2 bronze ingots into 1 curved plate in the Forge Hammer. Later the Steam Compressor bends plates into curved plates 1:1."
		"&eTip:&r You need 6 per batch of 16 pipes. Make 12 to have pipes to spare."
	]
	quest.0DB20A7152AEF87F.title: "Fluid Pipes"
	quest.0DB20A7152AEF87F.quest_subtitle: "Carry water and steam anywhere"
	quest.0DB20A7152AEF87F.quest_desc: [
		"&6Water that goes where you tell it. You used to do that with rivers.&r"
		"&eWhat:&r MI fluid pipes carry water, steam and later every chemical in the pack. Four of the five steam machines are built with them."
		"&eHow:&r 6 bronze curved plates, 2 copper rotors and a glass pane make 16 pipes."
		"&eTip:&r A pipe holds one fluid at a time. Right-click a pipe with a wrench to change its connection; item pipes need steel gears, so they wait for Chapter II."
	]
	quest.7D13FE6437607301.title: "Coal by the Block"
	quest.7D13FE6437607301.quest_subtitle: "Nine coal, one block, a long burn"
	quest.7D13FE6437607301.quest_desc: [
		"&eWhat:&r A block of coal holds 9 coal and burns as long as all nine, so one block keeps a boiler going far longer between refills."
		"&eChemistry:&r The energy is in the carbon, not the shape: packing coal tighter doesn't add heat, it just stores more of it in one slot."
		"&eHow:&r 9 coal in a crafting grid make 1 block."
		"&eTip:&r Feed boilers coal blocks through a hopper and you can leave them alone for a long time."
	]
	quest.75B6B78E30ECF49F.title: "Steam in a Bucket"
	quest.75B6B78E30ECF49F.quest_subtitle: "Boil a bucket of water"
	quest.75B6B78E30ECF49F.quest_desc: [
		"&eWhat:&r Smelt a water bucket in any furnace and you get a bucket of steam: portable power for a machine far from the boiler."
		"&eChemistry:&r Boiling doesn't change water chemically; H₂O stays H₂O. It only gives the molecules enough energy to escape the liquid, about 2,260 joules per gram."
		"&eTip:&r Handy for testing a machine before you've run a pipe to it."
	]
	quest.38B49BCA499EE071.title: "Diamonds for Grinding"
	quest.38B49BCA499EE071.quest_subtitle: "The teeth of the macerator and cutter"
	quest.38B49BCA499EE071.quest_desc: [
		"&eWhat:&r The Steam Macerator grinds with 2 diamonds and the Steam Cutting Machine cuts with 1."
		"&eChemistry:&r Diamond is the hardest natural material, so it grinds and cuts everything softer than itself. Real industrial saws and grinders are tipped with diamond grit for the same reason."
		"&eHow:&r Diamond ore is most common near the bottom of the world, around Y -59. An iron pickaxe mines it."
		"&eTip:&r A Fortune pickaxe helps a lot here."
	]
	quest.1FCCFB27D4E61D8B.title: "Steam Macerator"
	quest.1FCCFB27D4E61D8B.quest_subtitle: "Ore and ingots into dust"
	quest.1FCCFB27D4E61D8B.quest_desc: [
		"&eWhat:&r Grinds ore and items into dust without wearing out a tool."
		"&eHow:&r 2 diamonds, 2 copper gears, a bronze machine casing and 3 fluid pipes. Ores give at most 2x until acids."
		"&eTip:&r It also grinds bricks into brick dust, so your Iron Hammer can rest."
	]
	quest.0DCF15D0DDB80EE0.title: "Steam Compressor"
	quest.0DCF15D0DDB80EE0.quest_subtitle: "Plates at 1 ingot each"
	quest.0DCF15D0DDB80EE0.quest_desc: [
		"&eWhat:&r Presses ingots into plates 1:1, and plates into curved plates."
		"&eHow:&r A Forge Hammer, 2 copper rods, 2 copper gears, a bronze machine casing and 3 fluid pipes. The Forge Hammer goes into the recipe, so craft a second one."
		"&eTip:&r Machines need lots of plates. Keep this one fed."
	]
	quest.319D2A4BD36DBDCD.title: "Steam Mixer"
	quest.319D2A4BD36DBDCD.quest_subtitle: "Better alloy ratios"
	quest.319D2A4BD36DBDCD.quest_desc: [
		"&eWhat:&r Mixes dusts (like copper and tin into bronze) and fluids."
		"&eChemistry:&r Same copper and tin, less loss: a good process wastes less of its inputs. That's called &eyield&r."
		"&eHow:&r 2 glass, a copper gear, 2 copper rotors, a bronze machine casing and 3 fluid pipes. Here 3 copper dust + 1 tin dust makes 4 bronze dust, one more than by hand."
	]
	quest.5FA030B61A0C335C.title: "Steam Cutting Machine"
	quest.5FA030B61A0C335C.quest_subtitle: "Rods, bolts and planks"
	quest.5FA030B61A0C335C.quest_desc: [
		"&eWhat:&r Cuts ingots into 2 rods, rods into bolts, and logs into 6 planks."
		"&eHow:&r A diamond, 2 glass, 2 copper gears, a casing and pipes. It needs &elubricant&r as a cutting fluid. You'll make lubricant from creosote and redstone in Chapter II, so build it now and run it then."
		"&eTip:&r Until then, the Forge Hammer makes rods and bolts."
	]
	quest.15BEE6A43E8C4B6E.title: "Endless Water"
	quest.15BEE6A43E8C4B6E.quest_subtitle: "A boiler that never runs dry"
	quest.15BEE6A43E8C4B6E.quest_desc: [
		"&6Fire, water, metal, motion. The pieces of a world are coming back to you.&r"
		"&eWhat:&r A steam-powered pump that pulls water from the ground, so your boiler never runs dry."
		"&eHow:&r 2 copper rotors, 2 copper gears, a bronze tank, a machine casing and 3 fluid pipes. Place it next to the boiler, or pipe its water into it."
		"&eTip:&r The Coke Oven in Chapter II runs on steam, so a boiler that never runs dry comes first. Next stop: coke and steel."
	]
	quest.1AF0C99AB1B7CD3F.title: "Efficient Alloying"
	quest.1AF0C99AB1B7CD3F.quest_subtitle: "Let the mixer earn its keep"
	quest.1AF0C99AB1B7CD3F.quest_desc: [
		"&eWhat:&r Mix 32 bronze dust in the Steam Mixer."
		"&eChemistry:&r In real metallurgy, alloy ratios are measured by mass or by number of atoms. Getting the ratio right matters more than the amount."
		"&eTip:&r Pipe the macerator's dust straight into the mixer and you'll never mix by hand again."
	]
	quest.3975F40E071DA8BE.title: "Plates at Scale"
	quest.3975F40E071DA8BE.quest_subtitle: "A stack from the compressor"
	quest.3975F40E071DA8BE.quest_desc: [
		"&eWhat:&r Press a full stack of bronze plates in the Steam Compressor."
		"&eHow:&r The compressor gives 1 plate per ingot, where the bare Forge Hammer gives 1 per 2."
		"&eTip:&r Chapter II's hatches, tanks and steel upgrades are mostly plates. A stack in a barrel saves trips."
	]
	chapter.598D356C3B16EC05.title: "II. Steam and Steel"
	chapter.598D356C3B16EC05.chapter_subtitle: [
		"Destructive distillation turns coal into coke, and coke turns iron into steel."
		"At the end of this chapter, matter itself opens up to you."
	]
	quest.1EDDC44EC9C4E742.title: "A Kiln's Worth of Bricks"
	quest.1EDDC44EC9C4E742.quest_subtitle: "The Coke Oven's shell"
	quest.1EDDC44EC9C4E742.quest_desc: [
		"&6Smoke rising from a hill of earth, and what came out of it burning hotter than anything before. That memory is older than any city.&r"
		"&eWhat:&r The Coke Oven is built from ordinary brick blocks: 8 for the controller and 21 more for its walls."
		"&eChemistry:&r Firing clay drives out the water bound in its minerals and fuses the grains, turning soft mud into ceramic."
		"&eHow:&r Smelt clay balls into bricks, then craft 4 bricks into a brick block."
		"&eTip:&r Rivers and swamps are full of clay. Ultimine a clay patch."
	]
	quest.72877F09B21CFC52.title: "Coal for Coking"
	quest.72877F09B21CFC52.quest_subtitle: "Charcoal won't do this time"
	quest.72877F09B21CFC52.quest_desc: [
		"&eWhat:&r The Coke Oven bakes coal, not charcoal, and it's hungry: one coal becomes one coke."
		"&eChemistry:&r Coal is ancient plant matter, pressed and heated underground for millions of years. It's mostly carbon, plus hydrogen, sulfur and tars that coking will drive off."
		"&eHow:&r Coal ore is common in exposed stone and mountains. Ultimine a vein."
		"&eTip:&r Coal dust works too (it cokes into coke dust), and the Steam Macerator grinds coal 1:1."
	]
	quest.1F11787528A18CB9.title: "The Coke Oven"
	quest.1F11787528A18CB9.quest_subtitle: "The controller block"
	quest.1F11787528A18CB9.quest_desc: [
		"&eWhat:&r The controller of a small multiblock that bakes coal into coke."
		"&eChemistry:&r Coal is carbon mixed with many other compounds. Bake it without air and those volatiles are driven off. This is &edestructive distillation&r."
		"&eHow:&r 8 brick blocks around a furnace."
	]
	quest.3E0966482A811593.title: "Hatches"
	quest.3E0966482A811593.quest_subtitle: "How things get in and out of a multiblock"
	quest.3E0966482A811593.quest_desc: [
		"&eWhat:&r MI multiblocks have no inventory of their own. Hatches built into the walls take items and steam in and push products out."
		"&eHow:&r An item hatch is a hopper on a bronze machine casing; a fluid hatch is a bronze tank on a casing (check JEI for the output versions)."
		"&eTip:&r Hold a hatch or a wrench near the controller to see where hatches can go and what's missing."
	]
	quest.5B0DD23AD404D09E.title: "A Way Out for Tar"
	quest.5B0DD23AD404D09E.quest_subtitle: "A fluid output hatch for the Coke Oven"
	quest.5B0DD23AD404D09E.quest_desc: [
		"&eWhat:&r Coking coal also drives out a liquid. Without a fluid output hatch it has nowhere to go and is lost."
		"&eChemistry:&r The volatile part of coal leaves as gas and condenses into tar as it cools. Real coke works collect it, because coal tar is a feedstock, not waste."
		"&eHow:&r A bronze machine casing on top of a bronze tank. Swap one wall brick of the Coke Oven for it."
		"&eTip:&r Pipe it straight into a tank so it never fills up."
	]
	quest.4952190F5A9DACFA.title: "Build the Coke Oven"
	quest.4952190F5A9DACFA.quest_subtitle: "A 3x3x3 brick cube with hatches"
	quest.4952190F5A9DACFA.quest_desc: [
		"&eWhat:&r Put the shell together and the controller comes to life."
		"&eHow:&r Press R on the Coke Oven in JEI or open the MI guidebook to see the 3D layout: a 3x3x3 cube of brick blocks with the controller in one face. Swap wall bricks for hatches: item in, item out, steam in, and a fluid output for creosote."
		"&eTip:&r Pipe steam from your boiler into the fluid input hatch. Click the checkmark once the controller shows it's formed."
	]
	quest.2E90112C74807A32.title: "Coke"
	quest.2E90112C74807A32.quest_subtitle: "Nearly pure carbon, burns hotter than coal"
	quest.2E90112C74807A32.quest_desc: [
		"&6Carbon with everything weak burned out of it. You used to build with something like this. Mountains, mostly.&r"
		"&eWhat:&r Coke is exactly what a blast furnace needs: strong, porous, nearly pure carbon. It also burns four times as long as coal."
		"&eChemistry:&r With the hydrogen, sulfur and tars baked out, what's left is a carbon skeleton that burns hot and clean."
		"&eHow:&r Feed coal into the item input hatch. Each coal becomes 1 coke in 30 seconds."
	]
	quest.4E77936288D67925.title: "Fuel Reserve"
	quest.4E77936288D67925.quest_subtitle: "Four blocks of coke"
	quest.4E77936288D67925.quest_desc: [
		"&eWhat:&r A stockpile of coke for boilers, generators and future steel."
		"&eChemistry:&r Coke is porous. Air flows through it, which is why it burns so hot and steadily in a furnace."
		"&eTip:&r A full Coke Oven running overnight fills these quickly."
	]
	quest.4E8A54354F577B14.title: "Byproduct: Creosote"
	quest.4E8A54354F577B14.quest_subtitle: "The tar driven out of coal"
	quest.4E8A54354F577B14.quest_desc: [
		"&eWhat:&r Half the time, coking a coal also yields 500 mB of &ecreosote&r. Nothing is wasted in chemistry: creosote becomes lubricant now and generator fuel later."
		"&eChemistry:&r Coal-tar creosote is a mix of phenols, cresols and ring-shaped hydrocarbons, the same family of compounds that makes tar smell the way it does."
		"&eHow:&r Pipe it out of the fluid output hatch into a tank and fill a bucket from the tank."
	]
	quest.6788BDC814345011.title: "Lubricant"
	quest.6788BDC814345011.quest_subtitle: "Creosote + redstone"
	quest.6788BDC814345011.quest_desc: [
		"&eWhat:&r The Steam Cutting Machine needs lubricant as cutting fluid. Now you can finally run it."
		"&eHow:&r In the Steam Mixer, 500 mB of creosote and 1 redstone make 500 mB of lubricant."
		"&eTip:&r Each cut uses only 1 mB, so one bucket lasts a very long time. The Cutting Machine now makes your steel rods and bolts at 2 per ingot."
	]
	quest.01D936F8C9EF70C6.title: "Coke Dust"
	quest.01D936F8C9EF70C6.quest_subtitle: "Carbon, powdered"
	quest.01D936F8C9EF70C6.quest_desc: [
		"&eWhat:&r Steel is mixed as dust, so the carbon has to be a powder too."
		"&eChemistry:&r Coke is the reducing agent in a real blast furnace: it pulls oxygen out of iron ore and supplies the carbon that becomes steel."
		"&eHow:&r Grind coke in the Steam Macerator, or coke coal dust directly in the Coke Oven."
	]
	quest.6DFD06FF06C7F3C4.title: "Iron Dust"
	quest.6DFD06FF06C7F3C4.quest_subtitle: "Seven parts of the recipe"
	quest.6DFD06FF06C7F3C4.quest_desc: [
		"&eWhat:&r The other ingredient of steel."
		"&eHow:&r Grind iron ingots in the Steam Macerator or the Forge Hammer (1 ingot makes 1 dust)."
		"&eTip:&r Macerating iron ore gives 2 raw iron per ore, which smelts into more ingots than mining alone."
	]
	quest.4991EED8B0E223D1.title: "Uncooked Steel"
	quest.4991EED8B0E223D1.quest_subtitle: "7 iron dust + 2 coke dust"
	quest.4991EED8B0E223D1.quest_desc: [
		"&eWhat:&r A blend of iron and carbon, ready for the blast furnace."
		"&eChemistry:&r Real steel holds far less carbon than this mix suggests, but the idea is right: carbon is the ingredient that turns soft iron into steel."
		"&eHow:&r Craft 7 iron dust with 2 coke dust to get 7 uncooked steel dust."
	]
	quest.5FB052696612D024.title: "Steel by the Batch"
	quest.5FB052696612D024.quest_subtitle: "Nine from the mixer, not seven"
	quest.5FB052696612D024.quest_desc: [
		"&eWhat:&r The Steam Mixer turns the same 7 iron dust and 2 coke dust into 9 uncooked steel instead of 7."
		"&eChemistry:&r Hand-mixing powders always leaves pockets of unmixed metal. Stirring blends them evenly, so less of the batch is wasted."
		"&eTip:&r Pipe the macerator into the mixer and the mixer into the blast furnace's input hatch."
	]
	quest.2F826829D36DA434.title: "Blast Furnace Materials"
	quest.2F826829D36DA434.quest_subtitle: "A stack of firebricks and a blast furnace"
	quest.2F826829D36DA434.quest_desc: [
		"&eWhat:&r The Steam Blast Furnace is a tower of fire clay bricks: 8 around its controller and 29 more for the walls."
		"&eHow:&r Make fire clay bricks as in Chapter I (the Steam Macerator grinds bricks into brick dust now). A vanilla blast furnace is 5 iron, a furnace and 3 smooth stone."
		"&eTip:&r Automate it: macerator → mixer → steam furnace. You'll want a lot of these."
	]
	quest.09118CFFDCA49A2D.title: "The Steam Blast Furnace"
	quest.09118CFFDCA49A2D.quest_subtitle: "Hot enough to dissolve carbon in iron"
	quest.09118CFFDCA49A2D.quest_desc: [
		"&eWhat:&r A multiblock that gets hot enough to melt iron and dissolve carbon into it."
		"&eHow:&r Craft the controller from 8 fire clay brick blocks around a blast furnace. Check the structure in JEI: the Coke Oven's shape in fire clay bricks with one extra hollow layer on top, and the same three hatches."
		"&eTip:&r Some later recipes in this furnace need a steel hatch. Steel itself only needs bronze ones."
	]
	quest.506EB945C083CC2E.title: "Steel"
	quest.506EB945C083CC2E.quest_subtitle: "Iron and carbon in the right ratio"
	quest.506EB945C083CC2E.quest_desc: [
		"&6Iron that bends without breaking. You once forged weapons for gods out of something very like this.&r"
		"&eWhat:&r Iron with a small, controlled amount of carbon (about 0.2-2%) is &esteel&r: strong, tough, and the backbone of every machine to come."
		"&eChemistry:&r Carbon atoms sit in the gaps between iron atoms and stop the layers sliding. Too much carbon and you get brittle cast iron. Chemistry is about the right ratio."
		"&eHow:&r Put uncooked steel dust in the blast furnace's item input hatch. Each dust becomes 1 steel ingot in 30 seconds."
	]
	quest.5FC7A4838C153DB0.title: "Steel Paxel"
	quest.5FC7A4838C153DB0.quest_subtitle: "Diamond-tier mining, without diamonds"
	quest.5FC7A4838C153DB0.quest_desc: [
		"&eWhat:&r Mekanism's steel tools are &ediamond tier&r: a steel paxel mines obsidian, which the Combiner needs, and lasts far longer than iron."
		"&eChemistry:&r A little carbon in iron makes it much harder: carbon atoms in the gaps of the iron lattice pin it so the layers can't slip."
		"&eHow:&r A steel pickaxe, axe and shovel with 2 sticks (check JEI)."
		"&eTip:&r No diamonds needed for obsidian now. Save your diamonds for the Combiner itself."
	]
	quest.1622F5994D7D8D48.title: "Steel Plates"
	quest.1622F5994D7D8D48.quest_subtitle: "For gears, pipes and Alchemistry"
	quest.1622F5994D7D8D48.quest_desc: [
		"&eWhat:&r The Dissolver and Combiner are framed in steel plates, and steel gears need them too."
		"&eHow:&r The Steam Compressor presses 1 steel ingot into 1 plate."
		"&eTip:&r You need at least 8 for the Dissolver and Combiner, plus more for gears and casings. Keep the compressor busy."
	]
	quest.3A174F8585AF80D7.title: "Steel Rods, Bolts and Rings"
	quest.3A174F8585AF80D7.quest_subtitle: "The small parts, in steel"
	quest.3A174F8585AF80D7.quest_desc: [
		"&eWhat:&r Steel gears need steel bolts and rings, and the LV motors of Chapter IV are built on steel rods."
		"&eHow:&r The Steam Cutting Machine cuts 1 steel ingot into 2 rods and 1 rod into 2 bolts, using a drop of lubricant each time. The Forge Hammer works too, at worse ratios."
		"&eTip:&r 4 rods and 4 bolts craft into 2 rings, or the Steam Compressor bends 1 rod into 1 ring."
	]
	quest.7C26AEBE7939F360.title: "Steel Gears"
	quest.7C26AEBE7939F360.quest_subtitle: "Plates, bolts and a ring, in steel"
	quest.7C26AEBE7939F360.quest_desc: [
		"&eWhat:&r Steel machine casings (the core of every LV machine in Chapter IV) and item pipes need steel gears."
		"&eHow:&r Same pattern as bronze: 4 steel plates, 4 steel bolts and 1 steel ring (check JEI)."
	]
	quest.66487B00E1F3D5D0.title: "Steel Machine Casing"
	quest.66487B00E1F3D5D0.quest_subtitle: "A tougher heart for machines"
	quest.66487B00E1F3D5D0.quest_desc: [
		"&eWhat:&r The steel version of the bronze casing. Steel hatches, steel upgrades, the Packer and every LV machine hull are built around one."
		"&eHow:&r 8 steel plates around a steel gear."
		"&eTip:&r That's 12 steel ingots per casing. Chapter IV wants several, so keep the blast furnace running."
	]
	quest.287260F7D5158B76.title: "Item Pipes"
	quest.287260F7D5158B76.quest_subtitle: "Automate the item flow"
	quest.287260F7D5158B76.quest_desc: [
		"&eWhat:&r MI item pipes move items between machines, so dust, ingots and coke flow on their own."
		"&eHow:&r 6 bronze curved plates and 2 steel gears make 16 pipes."
		"&eTip:&r Item pipes are on whitelist by default: right-click a connection and either add the items to move or switch it to blacklist. Configure both ends."
	]
	quest.68D7E29AA3935E8A.title: "Steel Hatches"
	quest.68D7E29AA3935E8A.quest_subtitle: "One steel hatch makes a multiblock steel tier"
	quest.68D7E29AA3935E8A.quest_desc: [
		"&eWhat:&r Steel hatches hold more than bronze ones, and a steam multiblock with at least one steel hatch is upgraded to steel tier: twice as fast, as long as the recipe stays within 4 EU/t."
		"&eHow:&r Each is a steel machine casing with a hopper or a steel tank on top (check JEI for the output versions)."
		"&eTip:&r Swap one hatch on your Coke Oven and Steam Blast Furnace and both run at double speed."
	]
	quest.48758611BAA2D4CB.title: "Packer and Unpacker"
	quest.48758611BAA2D4CB.quest_subtitle: "Simple crafts, done by steam"
	quest.48758611BAA2D4CB.quest_desc: [
		"&eWhat:&r The Packer does small crafts on its own: blocks, double ingots and pipes. The Unpacker takes blocks back apart. Both exist only in steel."
		"&eHow:&r A steel machine casing with bronze gears, fluid pipes and item pipes (check JEI; the Unpacker also needs bronze rods)."
		"&eTip:&r Pipe ingots into the Packer and store your metal as blocks: nine times fewer slots."
	]
	quest.25AC6318A5AC0F72.title: "Nickel"
	quest.25AC6318A5AC0F72.quest_subtitle: "A silvery metal that shrugs off heat"
	quest.25AC6318A5AC0F72.quest_desc: [
		"&eWhat:&r Nickel goes into two alloys you'll lean on: invar now, and cupronickel heating coils in Chapter IV."
		"&eChemistry:&r Nickel (Ni, element 28) sits right next to iron and cobalt and shares their magnetism. Most of Earth's nickel is thought to be in its iron core."
		"&eHow:&r MI nickel ore is fairly rare scattered, but rich deposits sit around Y -32 to 8. Smelt the raw nickel, or macerate it first for 2x."
	]
	quest.74B157424ED264D1.title: "Invar Dust"
	quest.74B157424ED264D1.quest_subtitle: "2 iron + 1 nickel"
	quest.74B157424ED264D1.quest_desc: [
		"&eWhat:&r The mixed powder of iron and nickel, ready to smelt."
		"&eHow:&r In the Steam Mixer, 2 iron dust and 1 nickel dust make 3 invar dust. Grind nickel ingots in the macerator first."
	]
	quest.3E5534444F9B853B.title: "Invar"
	quest.3E5534444F9B853B.quest_subtitle: "The metal that doesn't grow when heated"
	quest.3E5534444F9B853B.quest_desc: [
		"&eWhat:&r &eInvar&r is iron with about a third nickel. MI builds rotary blades, heatproof casings and the alloy smelter from it."
		"&eChemistry:&r Almost every metal expands as it warms. Invar (64% Fe, 36% Ni) barely does: its magnetic order cancels the thermal expansion. Its discovery won Charles-Édouard Guillaume the 1920 Nobel Prize in Physics."
		"&eHow:&r Smelt invar dust in any furnace."
	]
	quest.6FAF0E8C7E90C6A8.title: "Invar Plates and Gears"
	quest.6FAF0E8C7E90C6A8.quest_subtitle: "Parts that keep their shape in the heat"
	quest.6FAF0E8C7E90C6A8.quest_desc: [
		"&eWhat:&r An invar gear is the hub of the rotary blade. Later, invar plates and gears make the heatproof casings of the Electric Blast Furnace."
		"&eHow:&r The Steam Compressor presses invar ingots into plates 1:1. A gear is 4 plates, 4 invar bolts and an invar ring, the same shape as before."
	]
	quest.57DF95F0416DB663.title: "Diamond Dust"
	quest.57DF95F0416DB663.quest_subtitle: "The hardest grit there is"
	quest.57DF95F0416DB663.quest_desc: [
		"&eWhat:&r Diamond dust is the cutting edge of the invar rotary blade."
		"&eChemistry:&r Industrial abrasives are mostly diamond grit, and most of that is synthetic, made by squeezing graphite at around 5 GPa and 1,500 °C."
		"&eHow:&r The Steam Macerator grinds 1 diamond into 1 dust. It's slow (40 seconds each), so leave it running."
	]
	quest.21CDC19EF7130730.title: "Invar Rotary Blade"
	quest.21CDC19EF7130730.quest_subtitle: "A gear with a diamond edge"
	quest.21CDC19EF7130730.quest_desc: [
		"&eWhat:&r The grinding wheel of the Steam Quarry, the Electric Macerator and the Electric Cutting Machine."
		"&eHow:&r 1 invar gear with 4 diamond dust around it."
		"&eTip:&r Each blade costs 4 diamonds. Chapter IV's macerator and cutter each take one, so plan for two more."
	]
	quest.517923AB55DF110A.title: "Steel Alloy Smelter"
	quest.517923AB55DF110A.quest_subtitle: "Alloy ingots straight from nuggets"
	quest.517923AB55DF110A.quest_desc: [
		"&eWhat:&r An Extended Industrialization machine that melts metals together and pours alloy ingots directly: bronze, invar, cupronickel, electrum, battery alloy, brass and more."
		"&eChemistry:&r Alloying in the melt is how bronze was really made: liquid copper and tin mix atom by atom, then freeze together."
		"&eHow:&r Invar plates, a bronze rotor, fluid pipes and a steel machine casing (check JEI). Feed it ingots, dusts or nuggets."
		"&eTip:&r 27 copper and 9 tin nuggets make 4 bronze ingots: the same 3:1 ratio as the dust, with no mixing step."
	]
	quest.749F28A2B915932F.title: "Drill Parts"
	quest.749F28A2B915932F.quest_subtitle: "A bronze bit and two iron gears"
	quest.749F28A2B915932F.quest_desc: [
		"&eWhat:&r Bronze drills are the quarry's consumable. Each batch of 4 needs a bronze drill head, 2 iron gears, an item pipe and a fluid pipe."
		"&eHow:&r The drill head is a bronze plate, 2 curved plates, a rod, 2 bronze gears and bolts. Iron gears are 4 iron plates, iron bolts and an iron ring (check JEI)."
	]
	quest.5DD432221FD45DC3.title: "The Steam Quarry"
	quest.5DD432221FD45DC3.quest_subtitle: "Ore from below the bottom of the world"
	quest.5DD432221FD45DC3.quest_desc: [
		"&eWhat:&r A steam multiblock that wears out bronze drills to bring up ore from deeper than bedrock. Slow, but you never have to dig."
		"&eHow:&r The controller takes steel large plates, steel gears, item pipes, an invar rotary blade and a steel machine casing (check JEI for the shape and its ore table)."
		"&eTip:&r It eats a lot of steel, so build it once your Steam Blast Furnace runs on its own. Quarry ore still obeys the 2x cap until acids."
	]
	quest.095949D02325D2DB.title: "Bronze Blades"
	quest.095949D02325D2DB.quest_subtitle: "Curved bronze on a bronze rod"
	quest.095949D02325D2DB.quest_desc: [
		"&eWhat:&r The vanes of a bronze rotor. Steel upgrades and the Steel Wiremill of Chapter IV both need bronze rotors."
		"&eHow:&r 2 bronze curved plates on a bronze rod make 4 blades, just like the copper ones."
	]
	quest.0A1932BF335E6451.title: "Bronze Rotors"
	quest.0A1932BF335E6451.quest_subtitle: "Stiffer than copper"
	quest.0A1932BF335E6451.quest_desc: [
		"&eWhat:&r A rotor that holds its shape under steel-tier loads."
		"&eHow:&r 4 bronze blades, 1 bronze ring and 4 bronze bolts (check JEI)."
		"&eTip:&r The Steel Wiremill takes 2 and each pair of Steel Upgrades takes 1."
	]
	quest.786BB9183811C265.title: "Steel Upgrades"
	quest.786BB9183811C265.quest_subtitle: "Faster steam machines"
	quest.786BB9183811C265.quest_desc: [
		"&eWhat:&r A Steel Upgrade turns a bronze steam machine into its steel version: twice as fast for recipes up to 4 EU/t."
		"&eHow:&r Bronze rods, a bronze rotor, 2 bronze gears, a steel machine casing, fluid pipes and fire clay bricks make 2 upgrades (check JEI). Combine one with the Bronze Macerator."
		"&eTip:&r Upgrade the machines that bottleneck you first, usually the macerator."
	]
	quest.0283A0C43718F7C7.title: "Steel Tank"
	quest.0283A0C43718F7C7.quest_subtitle: "Sixteen buckets"
	quest.0283A0C43718F7C7.quest_desc: [
		"&eWhat:&r A tank that holds 16 buckets, four times a bronze one. The steel boiler is built around it."
		"&eHow:&r 8 steel plates around a glass block."
		"&eTip:&r A steel tank under the Coke Oven's creosote output means you rarely have to empty it."
	]
	quest.750EFDC1E2DC1879.title: "Steel Boiler"
	quest.750EFDC1E2DC1879.quest_subtitle: "Twice the steam"
	quest.750EFDC1E2DC1879.quest_desc: [
		"&eWhat:&r Twice the steam of the bronze boiler, up to 16 mB a tick."
		"&eHow:&r Steel plates, a steel tank, a furnace and 3 fire clay brick blocks, or a bronze boiler with a Steel Upgrade (check JEI)."
		"&eTip:&r A steel water pump doubles the water too, up to 2 buckets every 5 seconds."
	]
	quest.7F6A7163CDEC6B19.title: "Large Steel Plates"
	quest.7F6A7163CDEC6B19.quest_subtitle: "Four plates, pressed together"
	quest.7F6A7163CDEC6B19.quest_desc: [
		"&eWhat:&r Large steel plates go into the Steam Quarry and the Steel Hammer."
		"&eHow:&r 4 steel plates in a 2x2 make 1 large plate."
	]
	quest.15A87A4EFD0A441C.title: "The Steel Hammer"
	quest.15A87A4EFD0A441C.quest_subtitle: "A Forge Hammer tool that lasts"
	quest.15A87A4EFD0A441C.quest_desc: [
		"&eWhat:&r The steel version of the Iron Hammer: same recipes in the Forge Hammer, many more uses before it breaks."
		"&eChemistry:&r Carbon steel is far harder than wrought iron, so the striking face deforms less with every blow."
		"&eHow:&r 5 large steel plates and 2 sticks, in the Iron Hammer's shape."
	]
	quest.77F4F93F303CD16D.title: "Automatic Trash Can"
	quest.77F4F93F303CD16D.quest_subtitle: "Somewhere for the overflow"
	quest.77F4F93F303CD16D.quest_desc: [
		"&eWhat:&r Destroys any item or fluid piped into it. Hold it over a machine's fluid tank and click to dump that tank."
		"&eHow:&r 8 steel plates around a lava bucket."
		"&eTip:&r A full output slot stops a machine. A trash can on the end of an overflow pipe keeps cobblestone and spare creosote from jamming things."
	]
	quest.3BAD7D0A76461500.title: "Blocks of Redstone"
	quest.3BAD7D0A76461500.quest_subtitle: "One for each generator"
	quest.3BAD7D0A76461500.quest_desc: [
		"&eWhat:&r The Copper Generator and its Iron upgrade each have a block of redstone in their recipe, so you'll need two in all."
		"&eHow:&r 9 redstone dust make 1 block. Redstone ore sits deep, mostly below Y 16, and needs an iron pickaxe."
		"&eTip:&r Ultimine a redstone vein: one gives plenty, and lubricant needs dust too."
	]
	quest.3D9A8C810E3CC81C.title: "A Simple Generator"
	quest.3D9A8C810E3CC81C.quest_subtitle: "Burn fuel, make Forge Energy"
	quest.3D9A8C810E3CC81C.quest_desc: [
		"&eWhat:&r Generator Galore's Copper Generator burns solid fuel into FE (Forge Energy) and pushes it into machines it touches."
		"&eChemistry:&r Burning releases the chemical energy stored in carbon bonds as heat; the generator turns that heat into electricity."
		"&eHow:&r 7 copper ingots around a furnace, with a block of redstone."
	]
	quest.54E6526368208022.title: "Forge Energy"
	quest.54E6526368208022.quest_subtitle: "Enough FE to run the Dissolver"
	quest.54E6526368208022.quest_desc: [
		"&eWhat:&r Some machines run on &eFE&r instead of steam. You'll need it for the Dissolver."
		"&eHow:&r Upgrade the Copper Generator: surround it with 7 iron ingots and a block of redstone to make the Iron Generator."
		"&eTip:&r A Mekanism Heat Generator or Powah Furnator also works. Burn coke for long runs."
	]
	quest.4EF4EA98C358B2AE.title: "Heat and Pressure"
	quest.4EF4EA98C358B2AE.quest_subtitle: "Magma and pistons for the Dissolver"
	quest.4EF4EA98C358B2AE.quest_desc: [
		"&eWhat:&r Besides 4 steel plates and a bronze machine casing, the Dissolver needs 2 magma blocks and 2 pistons."
		"&eChemistry:&r Magma blocks are rock hot enough to glow, a fitting heat source for a machine that tears compounds apart."
		"&eHow:&r Magma blocks generate in underwater ravines and caves, or can be crafted from 4 magma cream. Pistons need iron, redstone, cobblestone and planks."
	]
	quest.7B8C9B9BAD74D427.title: "Pressure and Precision"
	quest.7B8C9B9BAD74D427.quest_subtitle: "A diamond and obsidian for the Combiner"
	quest.7B8C9B9BAD74D427.quest_desc: [
		"&eWhat:&r The Combiner needs a diamond, 2 obsidian and a piston, plus 4 steel plates and a casing."
		"&eChemistry:&r Obsidian is volcanic glass: lava that cooled too fast for crystals to form."
		"&eHow:&r Pour water onto a lava source to make obsidian. Your &esteel paxel&r is diamond tier, so it mines obsidian; no diamond pickaxe needed. Diamonds are most common near the bottom of the world."
	]
	quest.7E15308871B090AE.title: "The Dissolver"
	quest.7E15308871B090AE.quest_subtitle: "Break anything into its elements"
	quest.7E15308871B090AE.quest_desc: [
		"&6Your first gift returns: look at anything and know what it's made of.&r"
		"&eWhat:&r The Dissolver breaks any item into the &eelements and compounds&r it's made of."
		"&eHow:&r 4 steel plates, 2 pistons, 2 magma blocks and a Bronze Machine Casing. Power it with FE, insert anything, and collect the elements."
		"&eTip:&r Some things dissolve into compounds first. Put those back in to break them down further."
	]
	quest.29BEA270C571B58C.title: "The Combiner"
	quest.29BEA270C571B58C.quest_subtitle: "Build items back up from elements"
	quest.29BEA270C571B58C.quest_desc: [
		"&6And the other half of the gift: what you can take apart, you can put back together.&r"
		"&eWhat:&r The reverse: arrange elements and the Combiner builds them back into items and blocks."
		"&eHow:&r 4 steel plates, a diamond, 2 obsidian, a piston and a Bronze Machine Casing. It runs on FE too."
		"&eTip:&r Its first real job comes in Chapter IV: sulfuric acid for the lead-acid redstone battery. Taking the world apart and rebuilding it is what this pack is about."
	]
	quest.6482D732148C9CAB.title: "Wood, Undone"
	quest.6482D732148C9CAB.quest_subtitle: "Logs dissolve into cellulose"
	quest.6482D732148C9CAB.quest_desc: [
		"&eWhat:&r Your first compound out of the Dissolver."
		"&eChemistry:&r Cellulose is a chain of glucose units, (C₆H₁₀O₅)ₙ. It's the most common organic compound on Earth and gives wood its strength."
		"&eHow:&r Dissolve logs: each log gives 1 cellulose. Dissolve the cellulose again to get 6 carbon, 10 hydrogen and 5 oxygen."
	]
	quest.7A840CDAA02E6E54.title: "Graphite"
	quest.7A840CDAA02E6E54.quest_subtitle: "Coal and charcoal, sorted"
	quest.7A840CDAA02E6E54.quest_desc: [
		"&eWhat:&r Coal and charcoal dissolve into graphite, a pure form of carbon."
		"&eChemistry:&r In graphite, carbon atoms form flat sheets of hexagons that slide over each other. That's why pencil 'lead' leaves a mark."
		"&eHow:&r Dissolve coal or charcoal: each gives 2 graphite. Each graphite dissolves into 4 carbon."
	]
	quest.2C209AB4708A194F.title: "First Entries in the Periodic Table"
	quest.2C209AB4708A194F.quest_subtitle: "H, C, O and Fe"
	quest.2C209AB4708A194F.quest_desc: [
		"&eWhat:&r Dissolve whatever you have lying around and collect your first elements: &eH&r (1), &eC&r (6), &eO&r (8), &eFe&r (26)."
		"&eChemistry:&r The number is the &eatomic number&r: how many protons are in the nucleus. Change it and you have a different element."
		"&eHow:&r Cellulose gives carbon, hydrogen and oxygen; graphite gives carbon. Each iron ingot gives 16 iron."
		"&eTip:&r The Periodic Table chapter tracks every element from here on."
	]
	quest.3D16D152C8C89059.title: "Your First Synthesis"
	quest.3D16D152C8C89059.quest_subtitle: "2 H + 1 O → H₂O"
	quest.3D16D152C8C89059.quest_desc: [
		"&6Two hydrogen, one oxygen. You once filled oceans with this; today it's a few drops. It's a start, and it's yours.&r"
		"&eWhat:&r Build water from its elements in the Combiner. It's a trivial compound, but you made it from scratch. That's the point."
		"&eChemistry:&r 2H₂ + O₂ → 2H₂O. Hydrogen and oxygen share electrons in covalent bonds, and the bent shape of the molecule makes it polar."
		"&eHow:&r Pick water as the target in the Combiner's GUI, then supply 2 hydrogen and 1 oxygen per water."
	]
	quest.34238F774A63B533.title: "Proof of Composition"
	quest.34238F774A63B533.quest_subtitle: "Copper and tin, as elements"
	quest.34238F774A63B533.quest_desc: [
		"&eWhat:&r Dissolve a copper ingot and a tin ingot to see the two elements that make bronze."
		"&eChemistry:&r Copper is element 29 and tin is element 50. Every bronze ingot you made in Chapter I was these two, mixed."
		"&eHow:&r Each copper or tin ingot dissolves into 16 of its element."
	]
	quest.0227C974352048DA.title: "Sweet Chemistry"
	quest.0227C974352048DA.quest_subtitle: "Sugar is C₁₂H₂₂O₁₁"
	quest.0227C974352048DA.quest_desc: [
		"&eWhat:&r Dissolve sugar into sucrose, then sucrose into its elements."
		"&eChemistry:&r Sucrose is glucose and fructose joined together. Dissolved, it gives 12 carbon, 22 hydrogen and 11 oxygen."
		"&eHow:&r Sugar cane makes sugar; the Dissolver turns 1 sugar into 1 sucrose."
	]
	quest.5228E072334D75AA.title: "Carbon Is Carbon"
	quest.5228E072334D75AA.quest_subtitle: "Dissolve a diamond"
	quest.5228E072334D75AA.quest_desc: [
		"&eWhat:&r A diamond dissolves into 128 graphite. Expensive, but it proves a point."
		"&eChemistry:&r Diamond and graphite are both pure carbon, called &eallotropes&r. In diamond every atom bonds to four neighbours in 3D; in graphite, to three in flat sheets."
		"&eTip:&r Don't dissolve your last diamond. You'll need them for machines."
	]
	quest.632D96966BF470C3.title: "The Atomizer"
	quest.632D96966BF470C3.quest_subtitle: "Fluids into chemical items"
	quest.632D96966BF470C3.quest_desc: [
		"&eWhat:&r An Alchemistry machine that turns a fluid into its compound as items. Its best trick: 500 mB of water becomes 8 ChemLib water."
		"&eChemistry:&r Each ChemLib water dissolves into 2 hydrogen and 1 oxygen, so one bucket of water is 32 hydrogen. That's the easiest hydrogen you'll find for the flight pylon in Chapter III."
		"&eHow:&r 4 iron ingots, 2 pistons, 2 cauldrons and redstone. Pipe in water from your pump and give it FE."
		"&eTip:&r Chain it: water pump → Atomizer → Dissolver, and hydrogen and oxygen pile up on their own."
	]
	quest.24258A11397935DE.title: "The Liquifier"
	quest.24258A11397935DE.quest_subtitle: "Chemical items back into fluids"
	quest.24258A11397935DE.quest_desc: [
		"&eWhat:&r The Atomizer in reverse: 8 compound items become 500 mB of their fluid, ready to pipe."
		"&eChemistry:&r A real chemical plant moves almost everything as liquids and gases, because fluids flow through pipes. Solids have to be carried."
		"&eHow:&r 4 iron ingots, a piston, 2 stone pressure plates, redstone and a cauldron."
	]
	quest.53F71C712890B511.title: "The Compactor"
	quest.53F71C712890B511.quest_subtitle: "Atoms back into dust"
	quest.53F71C712890B511.quest_desc: [
		"&eWhat:&r Presses piles of elements back into usable dust: 16 iron atoms into an MI iron dust, 4 carbon into a graphite, 8 of many compounds into their dust."
		"&eHow:&r 4 iron ingots, 2 pistons, 2 stone pressure plates and redstone."
		"&eTip:&r Elements you dissolved out of junk become real metal again, so nothing is lost."
	]
	quest.56F035265D20D7D0.title: "The Breath of Fire"
	quest.56F035265D20D7D0.quest_subtitle: "C + 2 O → CO₂"
	quest.56F035265D20D7D0.quest_desc: [
		"&eWhat:&r Build carbon dioxide in the Combiner from 1 carbon and 2 oxygen."
		"&eChemistry:&r Every fire you've lit made this: C + O₂ → CO₂. It's also what you breathe out, and what plants turn back into cellulose with sunlight."
		"&eHow:&r Pick carbon dioxide in the Combiner's GUI and supply the elements."
	]
	quest.65F5627AAA0D86ED.title: "The Simplest Fuel"
	quest.65F5627AAA0D86ED.quest_subtitle: "C + 4 H → CH₄"
	quest.65F5627AAA0D86ED.quest_desc: [
		"&eWhat:&r Build methane, the main part of natural gas, from 1 carbon and 4 hydrogen."
		"&eChemistry:&r Carbon makes four bonds, so the smallest hydrocarbon is one carbon with four hydrogens arranged as a tetrahedron. Every fuel in the oil age is a longer chain of the same idea."
		"&eHow:&r Pick methane in the Combiner's GUI and supply the elements."
	]
	quest.57C619587270D282.title: "Sand, Undone"
	quest.57C619587270D282.quest_subtitle: "Sand is silica, SiO₂"
	quest.57C619587270D282.quest_desc: [
		"&eWhat:&r Dissolve sand: each block gives 4 silicon dioxide, and once in a while a speck of gold."
		"&eChemistry:&r Silica is the most common compound in Earth's crust. Glass is silica, quartz is silica, and in Chapter V carbon will strip its oxygen away to give you silicon for circuits."
		"&eTip:&r Placer gold is real: rivers concentrate heavy gold grains in their sand, which is why prospectors panned for it."
	]
	chapter.33108756735886F7.title: "III. Divine Ascent"
	chapter.33108756735886F7.chapter_subtitle: [
		"Walk through fire, brew in the dark, and take back the sky."
		"Flight needs the Nether and your first Alchemistry machine: fire and chemistry together."
	]
	quest.206E95EBFA840B9D.title: "A Door of Fire"
	quest.206E95EBFA840B9D.quest_subtitle: "Ten blocks of obsidian and a spark"
	quest.206E95EBFA840B9D.quest_desc: [
		"&6You remember the sky. Not looking up at it: standing in it.&r"
		"&eWhat:&r a Nether portal is a 4x5 frame of obsidian (corners optional), lit with flint and steel."
		"&eChemistry:&r obsidian is volcanic glass. Lava cooled so fast its atoms never had time to form crystals."
		"&eHow:&r mine obsidian with a diamond pickaxe (or a steel paxel, which is diamond tier), or pour water over still lava to make it in place."
		"&eTip:&r a bucket of water and a bucket of lava let you cast the frame block by block."
	]
	quest.04B2CA0DEFD9BEA6.title: "Into the Fire"
	quest.04B2CA0DEFD9BEA6.quest_subtitle: "A dimension of quartz, fire and soul sand"
	quest.04B2CA0DEFD9BEA6.quest_desc: [
		"&eWhat:&r the Nether is a chemistry lab: quartz (SiO₂), blaze powder, glowstone and nether wart all come from here."
		"&eHow:&r bring food, armour, blocks and a way home. NetherPortalFix keeps portals linked properly."
		"&eTip:&r water evaporates instantly here and beds explode. Bring a respawn plan, not a bed."
	]
	quest.7543D8AB321711BF.title: "Fortress Found"
	quest.7543D8AB321711BF.quest_subtitle: "Bring home a piece of a fortress"
	quest.7543D8AB321711BF.quest_desc: [
		"&eWhat:&r Nether Fortresses hold blazes, wither skeletons and nether wart."
		"&eHow:&r Explorer's Compass points to structures. Mine nether bricks from the fortress walls."
		"&eTip:&r build a small portal near the fortress and your next trip is much shorter."
	]
	quest.1C82E86408050A34.title: "A Bastion of Gold"
	quest.1C82E86408050A34.quest_subtitle: "Piglin halls of blackstone"
	quest.1C82E86408050A34.quest_desc: [
		"&eWhat:&r Bastion remnants are huge blackstone ruins full of piglins and gold. Stand inside one."
		"&eHow:&r Explorer's Compass finds them. Wear at least one piece of gold armour so the piglins stay calm, and never open their chests in front of them."
		"&eTip:&r the walls are polished blackstone already: a free start on the pylon's frame."
	]
	quest.1D6AE11C08080F65.title: "The Basalt Deltas"
	quest.1D6AE11C08080F65.quest_subtitle: "Grey ash and black rock"
	quest.1D6AE11C08080F65.quest_desc: [
		"&eWhat:&r the Nether's volcanic badlands: basalt columns, blackstone, magma cubes and falling ash."
		"&eChemistry:&r basalt is the most common rock on Earth's ocean floors: lava rich in iron and magnesium that cooled slowly enough to form small crystals, unlike obsidian."
		"&eTip:&r magma cubes here drop magma cream for Fire Resistance and the Dissolver's magma blocks."
	]
	quest.46426D0CB76C7FEF.title: "Nether Gold"
	quest.46426D0CB76C7FEF.quest_subtitle: "Specks of gold in netherrack"
	quest.46426D0CB76C7FEF.quest_desc: [
		"&eWhat:&r nether gold ore drops gold nuggets: four ingots' worth fills this quest."
		"&eChemistry:&r gold is so unreactive that it occurs as the native metal, not as a compound. That's why it was the first metal people ever found."
		"&eHow:&r mine the yellow-flecked netherrack with any pickaxe. Fortune helps."
	]
	quest.2A7CD7184FBD641A.title: "Ghast Tears"
	quest.2A7CD7184FBD641A.quest_subtitle: "Regeneration, from a crying ghast"
	quest.2A7CD7184FBD641A.quest_desc: [
		"&eWhat:&r ghast tears brew Regeneration and drop rarely, since the ghast must die over solid ground."
		"&eHow:&r reflect a fireball back with a punch or arrow, then catch the tear before it burns in lava."
		"&eTip:&r a bow and patience beat chasing ghasts across lava lakes."
	]
	quest.5162E347921E0863.title: "Ancient Debris"
	quest.5162E347921E0863.quest_subtitle: "The rarest ore in the Nether"
	quest.5162E347921E0863.quest_desc: [
		"&eWhat:&r ancient debris smelts into netherite scrap, the base of netherite gear."
		"&eHow:&r it hides deep in the Nether (around Y 8-22) and resists explosions, so bed or TNT mining works."
		"&eTip:&r try the Dissolver on a scrap later and see what this 'element' really is."
	]
	quest.17FDCFCBC059454A.title: "Netherite"
	quest.17FDCFCBC059454A.quest_subtitle: "Moved: see Netherite Ingot"
	quest.17FDCFCBC059454A.quest_desc: [
		"&eMoved:&r this step is now \"Netherite Ingot\" on the Armour and Harvest Tiers page. Click to dismiss."
	]
	quest.28538BBB51C3DF16.title: "A Grim Trophy"
	quest.28538BBB51C3DF16.quest_subtitle: "The rarest drop in a fortress"
	quest.28538BBB51C3DF16.quest_desc: [
		"&eWhat:&r wither skeletons drop their skull only now and then. Three of them summon the Wither, much later."
		"&eHow:&r fight wither skeletons in fortress corridors with a Looting sword. Their hits cause Wither, so bring milk or a stack of food."
		"&eTip:&r no rush: nothing in this chapter needs it. Put it on a shelf and admire it."
	]
	quest.75644D12ABEA0664.title: "Nether Quartz"
	quest.75644D12ABEA0664.quest_subtitle: "Silicon dioxide, straight from the rock"
	quest.75644D12ABEA0664.quest_desc: [
		"&eWhat:&r Nether quartz ore is everywhere in Nether netherrack. The Infusion Pylon is capped with quartz."
		"&eChemistry:&r quartz is silicon dioxide, SiO₂. Much later you'll reduce it with carbon to get pure silicon for circuits."
		"&eTip:&r keep a spare stack. Quartz dust plus coke becomes silicon in Chapter V."
	]
	quest.069E15B497A964D9.title: "Blackstone"
	quest.069E15B497A964D9.quest_subtitle: "Dark volcanic stone for the pylon"
	quest.069E15B497A964D9.quest_desc: [
		"&eWhat:&r the Infusion Pylon stands on polished blackstone."
		"&eChemistry:&r blackstone is a basalt-like volcanic rock, rich in dark iron and magnesium minerals."
		"&eHow:&r it fills basalt deltas and bastion remnants. Any pickaxe mines it."
	]
	quest.5AB609C759A54482.title: "Glowstone"
	quest.5AB609C759A54482.quest_subtitle: "Light that grows on the ceiling"
	quest.5AB609C759A54482.quest_desc: [
		"&eWhat:&r glowstone clusters hang from the Nether's ceilings. The dust strengthens potions (Level II) at the cost of duration."
		"&eHow:&r break glowstone blocks (they drop 2 to 4 dust) or kill witches. A Silk Touch tool gives the whole block."
		"&eTip:&r a strengthened potion can't also be extended with redstone, so keep glowstone away from the potions you want to last."
	]
	quest.038175F9D716E38A.title: "The Light-Bearer"
	quest.038175F9D716E38A.quest_subtitle: "Glowstone dissolves into phosphorus"
	quest.038175F9D716E38A.quest_desc: [
		"&eWhat:&r every glowstone dust dissolves into 4 phosphorus."
		"&eChemistry:&r phosphorus means 'light-bearer' in Greek. White phosphorus glows in the dark as it slowly reacts with the oxygen in air. Hennig Brand found it in 1669 by boiling down urine."
		"&eHow:&r put glowstone dust in the Dissolver."
	]
	quest.01F22CC8F8612F2A.title: "Quartz, Undone"
	quest.01F22CC8F8612F2A.quest_subtitle: "One quartz, 32 silica and 16 barium"
	quest.01F22CC8F8612F2A.quest_desc: [
		"&eWhat:&r Nether quartz dissolves into 32 silicon dioxide and 16 barium."
		"&eChemistry:&r pure quartz is only SiO₂, but real quartz veins often carry &ebarite&r (barium sulfate, BaSO₄). Barium salts burn green, which is how fireworks get that colour."
		"&eHow:&r put Nether quartz in the Dissolver."
	]
	quest.51111ED97E8A8D63.title: "Blaze Powder, Undone"
	quest.51111ED97E8A8D63.quest_subtitle: "Germanium, carbon and sulfur"
	quest.51111ED97E8A8D63.quest_desc: [
		"&eWhat:&r Alchemistry reads blaze powder as 8 germanium, 2 graphite and 8 sulfur."
		"&eChemistry:&r germanium (Ge, 32) is a semiconductor. The first transistor, built at Bell Labs in 1947, was a sliver of germanium."
		"&eTip:&r the sulfur is handy: Chapter IV's battery acid needs sulfur too."
	]
	quest.0F659538DB408706.title: "Soul Sand"
	quest.0F659538DB408706.quest_subtitle: "Where nether wart grows"
	quest.0F659538DB408706.quest_desc: [
		"&eWhat:&r nether wart only grows on soul sand. Bring some home and plant a wart farm."
		"&eHow:&r soul sand valleys are full of it, and fortress stairwells have small patches. A shovel digs it fast."
		"&eTip:&r soul sand under water makes a bubble column that pushes you up."
	]
	quest.324D521459A0712A.title: "Blaze Rods"
	quest.324D521459A0712A.quest_subtitle: "Fuel for the brewing stand"
	quest.324D521459A0712A.quest_desc: [
		"&eWhat:&r blaze rods craft the brewing stand, and blaze powder fuels it."
		"&eHow:&r blazes spawn around spawners in Nether Fortresses. Explorer's Compass can point you to one."
		"&eTip:&r snowballs hurt blazes, and fire resistance makes the fight easy."
	]
	quest.41129EEF35D20ABE.title: "Blaze Powder"
	quest.41129EEF35D20ABE.quest_subtitle: "Crushed rods burn the brew"
	quest.41129EEF35D20ABE.quest_desc: [
		"&eWhat:&r blaze powder fuels the brewing stand: one powder lasts 20 brews."
		"&eHow:&r 1 blaze rod makes 2 powder by hand. The Steam Macerator gets 4 per rod."
		"&eTip:&r keep one rod back for the stand itself."
	]
	quest.7C9C1346FF3451C6.title: "Nether Wart"
	quest.7C9C1346FF3451C6.quest_subtitle: "The base of almost every potion"
	quest.7C9C1346FF3451C6.quest_desc: [
		"&eWhat:&r the base reagent for almost every potion."
		"&eHow:&r it grows on soul sand in fortress stairwells. Bring some soul sand home and replant it; it grows in the Overworld too."
		"&eTip:&r one stack of wart grown at home covers every brew in this chapter."
	]
	quest.7271A237054B8116.title: "The Brewer's Art"
	quest.7271A237054B8116.quest_subtitle: "Applied chemistry, the old-fashioned way"
	quest.7271A237054B8116.quest_desc: [
		"&6Tinctures and draughts: the first chemistry was done by people trying to bottle a little divinity. You can relate.&r"
		"&eWhat:&r a brewing stand turns water bottles into potions, one ingredient at a time."
		"&eChemistry:&r brewing is extraction and reaction: each ingredient changes what's dissolved in the bottle."
		"&eHow:&r 1 blaze rod + 3 cobblestone. Blaze powder in the top-left slot fuels 20 brews."
		"&eTip:&r look up &ePotion of Flying&r in JEI (from Apothic Attributes). The next quests walk the whole chain."
	]
	quest.77B4FE536121FA06.title: "Glass Bottles"
	quest.77B4FE536121FA06.quest_subtitle: "Three glass, three bottles"
	quest.77B4FE536121FA06.quest_desc: [
		"&eWhat:&r every potion lives in a bottle. The stand brews three at a time."
		"&eHow:&r 3 glass in a V shape make 3 bottles. The Steam Compressor presses 1 glass block into 2."
		"&eTip:&r make plenty: the flight chain takes several rounds of three."
	]
	quest.546CE2391B2BE2D3.title: "Bottled Water"
	quest.546CE2391B2BE2D3.quest_subtitle: "The solvent for every brew"
	quest.546CE2391B2BE2D3.quest_desc: [
		"&eWhat:&r fill three bottles from any water source. Then brew nether wart into them to get &eAwkward Potions&r, the base of almost every recipe."
		"&eChemistry:&r water is the universal solvent: its polar molecules pull apart salts and sugars, so whatever you add to the bottle ends up dissolved in it."
		"&eHow:&r right-click water with empty bottles. Any potion counts for this quest."
	]
	quest.2BF8FDA92111B602.title: "Fire Resistance"
	quest.2BF8FDA92111B602.quest_subtitle: "Awkward + magma cream"
	quest.2BF8FDA92111B602.quest_desc: [
		"&eWhat:&r Fire Resistance makes lava and blaze fire harmless. Swimming in lava becomes a shortcut."
		"&eHow:&r magma cubes drop magma cream in basalt deltas, or craft it from blaze powder + slimeball. Brew it into an Awkward Potion."
		"&eTip:&r add redstone for an 8-minute version before any lava-heavy trip."
	]
	quest.5BCAB5B85016C31D.title: "Slow Falling"
	quest.5BCAB5B85016C31D.quest_subtitle: "Awkward + phantom membrane"
	quest.5BCAB5B85016C31D.quest_desc: [
		"&eWhat:&r step 1 toward flight. Awkward Potion + phantom membrane = Potion of Slow Falling."
		"&eHow:&r phantoms appear at night when someone in the world hasn't slept for three or more days. Fight them on a roof."
		"&eTip:&r one membrane brews three bottles, so two membranes go a long way."
	]
	quest.5055CA8893F35E9E.title: "Fermenting Supplies"
	quest.5055CA8893F35E9E.quest_subtitle: "Spider eye, sugar and a mushroom"
	quest.5055CA8893F35E9E.quest_desc: [
		"&eWhat:&r the three ingredients of a fermented spider eye, the reagent that turns an effect into its opposite."
		"&eChemistry:&r fermentation needs a sugar to feed on and a living culture to do the work. Here the mushroom plays the yeast and the sugar is its food."
		"&eHow:&r spiders and cave spiders drop eyes, sugar comes from sugar cane, and brown mushrooms grow in dark places."
	]
	quest.51616CABAD571846.title: "Levitation"
	quest.51616CABAD571846.quest_subtitle: "Slow Falling + fermented spider eye"
	quest.51616CABAD571846.quest_desc: [
		"&eWhat:&r step 2. Slow Falling + fermented spider eye = Potion of Levitation (Apothic Attributes)."
		"&eChemistry:&r fermentation is yeast turning sugar into alcohol and acids. Here it 'corrupts' the effect into its opposite."
		"&eHow:&r fermented spider eye = spider eye + sugar + brown mushroom (shapeless). The Steam Mixer can make them too."
	]
	quest.0860B82960107DA5.title: "Lifting Gas"
	quest.0860B82960107DA5.quest_subtitle: "Levitation + hydrogen = Flying"
	quest.0860B82960107DA5.quest_desc: [
		"&eWhat:&r step 3. In this pack, Flying is made with &ehydrogen&r instead of End chorus fruit, so you can fly before the End."
		"&eChemistry:&r hydrogen (H₂) is the lightest gas there is, about 14 times lighter than air. It lifted the first passenger balloons in 1783."
		"&eHow:&r in a crafting grid, 1 Potion of Levitation + 2 hydrogen make a &ePotion of Flying&r: 8 minutes of creative-style flight (check JEI)."
		"&eTip:&r don't drink it yet; the next step makes it last longer. The brewing-stand route (popped chorus fruit) also works once you reach the End."
	]
	quest.025AF6A3C6CE7426.title: "Extended Flight"
	quest.025AF6A3C6CE7426.quest_subtitle: "Redstone, twice: 15 minutes, then 30"
	quest.025AF6A3C6CE7426.quest_desc: [
		"&eWhat:&r redstone stretches a potion's duration. Flying + redstone = Long Flying (15 min). Add redstone again for Extra Long Flying (30 min)."
		"&eHow:&r brew redstone into your Flying potions, then into the Long ones."
		"&eTip:&r a Potion Filter needs a full hour, which is just &etwo Extra Long&r potions. Brew at least two."
	]
	quest.7033201713D3AEDC.title: "Lighter than Air"
	quest.7033201713D3AEDC.quest_subtitle: "The lightest element, from your Dissolver"
	quest.7033201713D3AEDC.quest_desc: [
		"&eWhat:&r your flight potion and the pylon itself need hydrogen, and only the &eDissolver&r can pull it out of matter as an item."
		"&eChemistry:&r H is element 1: one proton, one electron. It makes up about three quarters of the ordinary matter in the universe."
		"&eHow:&r dissolve logs (cellulose) or sugar (sucrose), or let the Atomizer turn piped water into ChemLib water and dissolve that: 2 hydrogen each."
		"&eTip:&r feed the Dissolver from a hopper and it runs while you're in the Nether."
	]
	quest.29CBBE8A448C0A31.title: "A Block of Emerald"
	quest.29CBBE8A448C0A31.quest_subtitle: "Nine emeralds at the pylon's heart"
	quest.29CBBE8A448C0A31.quest_desc: [
		"&eWhat:&r the Infusion Pylon is built around a block of emerald, and the Potion Filter needs one more emerald."
		"&eChemistry:&r emerald is the mineral beryl, Be₃Al₂Si₆O₁₈, coloured green by a trace of chromium. Without the chromium the same crystal is colourless."
		"&eHow:&r emerald ore hides in mountain biomes. Trading with villagers is the steadier way: most professions pay emeralds for simple goods."
		"&eTip:&r a farmer villager buys wheat, potatoes and carrots. Your field from the first day pays for this."
	]
	quest.1CD8AA0BC3E29464.title: "Coloured Clay"
	quest.1CD8AA0BC3E29464.quest_subtitle: "Cyan terracotta and green dye"
	quest.1CD8AA0BC3E29464.quest_desc: [
		"&eWhat:&r the Potion Filter is framed in cyan terracotta with a green dye at its centre."
		"&eChemistry:&r smelt cactus and its green pigment survives as dye. Mix it with lapis blue for cyan. Alchemistry agrees: 4 copper chloride compact into cyan dye, the colour of copper salts."
		"&eHow:&r smelt clay blocks into terracotta, then 8 terracotta around 1 cyan dye make 8 cyan terracotta."
	]
	quest.06C7CB442A50E345.title: "Potion Filter"
	quest.06C7CB442A50E345.quest_subtitle: "Store an effect in a filter"
	quest.06C7CB442A50E345.quest_desc: [
		"&6An hour of flight, folded into a pane of glass. Close enough to a feather from your old wings.&r"
		"&eWhat:&r a Potion Filter holds a potion effect for the Infusion Pylon."
		"&eHow:&r 2 cyan terracotta, green dye, an emerald and 5 glass. Drink a potion, then right-click the filter to store the effect. It activates once it holds &e1 hour&r of Flying: two Extra Long (30 min each), four Long (15 min) or about eight regular potions."
		"&eTip:&r drink and load one potion at a time so none of the effect runs out first. Two filters with the same effect combine: hold one in each hand and right-click."
	]
	quest.2B73B76E08E88F40.title: "Quartz Slabs"
	quest.2B73B76E08E88F40.quest_subtitle: "The pylon's cap"
	quest.2B73B76E08E88F40.quest_desc: [
		"&eWhat:&r the pylon is topped with two quartz slabs."
		"&eHow:&r 4 Nether quartz make a block of quartz; 3 blocks in a row make 6 slabs."
	]
	quest.70E81EEF06F1E07B.title: "The Pylon's Frame"
	quest.70E81EEF06F1E07B.quest_subtitle: "Polished blackstone and iron bars"
	quest.70E81EEF06F1E07B.quest_desc: [
		"&eWhat:&r the pylon stands on 3 polished blackstone with 2 iron bars at its sides."
		"&eHow:&r 4 blackstone in a 2x2 make 4 polished blackstone. 6 iron ingots make 16 iron bars."
	]
	quest.2EE32733B83E0FCA.title: "Wings of a God"
	quest.2EE32733B83E0FCA.quest_subtitle: "Permanent flight, built from fire and hydrogen"
	quest.2EE32733B83E0FCA.quest_desc: [
		"&6Your second gift returns, and the sky is yours again. You had forgotten how small the world looks from here.&r"
		"&eWhat:&r the &eInfusion Pylon&r applies a filter's effect to you anywhere. With a Flying filter, that's creative-style flight."
		"&eHow:&r 2 quartz slabs, 2 iron bars, a block of emerald, 3 polished blackstone and 1 &ehydrogen&r from your Dissolver (see JEI). Place it and put the full (one-hour) filter inside."
		"&eTip:&r the pylon only works while its chunk is loaded. Force-load it (see the next quest)."
	]
	quest.165366B8F8450DF0.title: "Keep It Running"
	quest.165366B8F8450DF0.quest_subtitle: "Force-load the pylon's chunk"
	quest.165366B8F8450DF0.quest_desc: [
		"&eWhat:&r if the pylon's chunk unloads, your flight stops. Over a long trip that means a long fall."
		"&eHow:&r open the FTB Chunks map (press M), claim the chunk with the pylon, then right-click it again to force-load it."
		"&eTip:&r force-load your Dissolver and brewing setup too, so they keep working while you travel."
	]
	quest.085504B6D2AE4F4C.title: "Eyes of Ender"
	quest.085504B6D2AE4F4C.quest_subtitle: "Blaze powder and a pearl"
	quest.085504B6D2AE4F4C.quest_desc: [
		"&eWhat:&r An Eye of Ender, thrown, flies towards the nearest stronghold, and twelve of them open the way to the End."
		"&eHow:&r Endermen drop ender pearls; they spawn in every dimension but crowd the Nether's warped forests. Craft 1 pearl with 1 blaze powder (shapeless) for an eye."
		"&eTip:&r No rush. Flight here runs on hydrogen, so the End can wait until you want its chorus fruit."
	]
	quest.04AB64EC70146236.title: "Whispers of Magic"
	quest.04AB64EC70146236.quest_subtitle: "Light magic suits a demigod"
	quest.04AB64EC70146236.quest_desc: [
		"&eWhat:&r the Worn Notebook teaches Ars Nouveau spellcrafting. Source gems are its basic magical material."
		"&eHow:&r the notebook is a book + lapis lazuli (shapeless). Source gems come from the Imbuement Chamber (lapis or amethyst + Source)."
		"&eTip:&r its Ritual of Flight is a second way to fly near your base. See the Ars Nouveau page (Magic and Relics)."
	]
	quest.32E9236C34FD4F59.title: "Fire into Source"
	quest.32E9236C34FD4F59.quest_subtitle: "Moved: see Volcanic Sourcelink"
	quest.32E9236C34FD4F59.quest_desc: [
		"&eMoved:&r this step is now \"Volcanic Sourcelink\" on the Ars Nouveau page. Click to dismiss."
	]
	quest.7FC86D79A91A5FFB.title: "Archwood"
	quest.7FC86D79A91A5FFB.quest_subtitle: "Magic trees in the archwood forests"
	quest.7FC86D79A91A5FFB.quest_desc: [
		"&eWhat:&r archwood is Ars Nouveau's magic wood, used for its jars, tables and rituals."
		"&eHow:&r look for brightly coloured trees in archwood forests; any colour of archwood log counts."
		"&eTip:&r archwood saplings grow at home, so a few logs become a farm."
	]
	chapter.00581FF47AFBFC11.title: "IV. The Electric Age"
	chapter.00581FF47AFBFC11.chapter_subtitle: [
		"Electricity is the tool that splits compounds apart. First you have to make it, and build the circuits that use it."
	]
	quest.6F197454B1B8D676.title: "Oil from Coal"
	quest.6F197454B1B8D676.quest_subtitle: "Coke dust and water, in the mixer"
	quest.6F197454B1B8D676.quest_desc: [
		"&6Lightning used to come when you called it. Now you'll have to build it a road, and the road starts in a coal pit.&r"
		"&eWhat:&r Raw synthetic oil is the first step to rubber, and rubber is what keeps electricity in its wires."
		"&eChemistry:&r Hot carbon and steam react into syngas, C + H₂O → CO + H₂, and the Fischer-Tropsch process builds that up into longer hydrocarbon chains. Coal-to-oil really was done this way."
		"&eHow:&r In the Steam Mixer, 1 coke dust and 100 mB of water make 200 mB of raw synthetic oil. Fill a bucket from the mixer's output."
		"&eTip:&r Grind coke in the Steam Macerator for the dust. One coke dust is a fifth of a bucket of oil."
	]
	quest.02E79E2CE41503C0.title: "Synthetic Oil"
	quest.02E79E2CE41503C0.quest_subtitle: "Refined in the Steam Blast Furnace"
	quest.02E79E2CE41503C0.quest_desc: [
		"&eWhat:&r Raw oil is a messy mixture. Heat refines it into synthetic oil, the input for rubber."
		"&eChemistry:&r Heating a crude hydrocarbon mix breaks up the unstable pieces and drives off the light ones, leaving a cleaner, more uniform oil."
		"&eHow:&r Pipe raw synthetic oil into a fluid input hatch on your Steam Blast Furnace: 100 mB in, 100 mB out. It needs a fluid output hatch too."
		"&eTip:&r A tank between mixer and furnace keeps both busy."
	]
	quest.527B2E427AA6D0BE.title: "Paper"
	quest.527B2E427AA6D0BE.quest_subtitle: "The backing for rubber and resistors"
	quest.527B2E427AA6D0BE.quest_desc: [
		"&eWhat:&r Rubber sheets are cast on paper, and resistors are wrapped in it."
		"&eChemistry:&r Paper is a mat of cellulose fibres held together by hydrogen bonds between the chains. Wet it and the water breaks those bonds, which is why wet paper tears."
		"&eHow:&r 3 sugar cane make 3 paper."
		"&eTip:&r A sugar cane farm next to water keeps this coming. Every rubber sheet batch eats one paper."
	]
	quest.06244939DFC248C8.title: "Rubber"
	quest.06244939DFC248C8.quest_subtitle: "Insulation, so current goes where you want"
	quest.06244939DFC248C8.quest_desc: [
		"&6A wire is only useful if the current stays inside it. You used to just tell lightning where to go.&r"
		"&eWhat:&r rubber sheets insulate cables and form circuit boards. Here rubber is &esynthetic&r, made from coal, not tree sap."
		"&eChemistry:&r rubber is a polymer: long, tangled hydrocarbon chains. Cross-linked with sulfur (&evulcanisation&r), the chains become a tough, flexible insulator."
		"&eHow:&r Mixer: 100 mB synthetic oil + 1 paper → 2 rubber sheets. Or vulcanise 1000 mB of oil with sulfur dust into synthetic rubber fluid first: then 1 paper and 100 mB give 12 sheets."
		"&eTip:&r the sulfur route gives six times more sheets per oil, but it needs a steel or electric mixer (4 EU/t)."
	]
	quest.0E122D2C0AEFAF5E.title: "Casings for the LV Line"
	quest.0E122D2C0AEFAF5E.quest_subtitle: "A stack of steel frames"
	quest.0E122D2C0AEFAF5E.quest_desc: [
		"&eWhat:&r the Steel Wiremill takes one casing and every LV machine hull takes another. Build a few ahead."
		"&eHow:&r 8 steel plates around a steel gear, the same shape as the bronze one."
		"&eTip:&r the Assembler later makes them for you. Until then, keep the blast furnace running."
	]
	quest.1D00667539B02E3B.title: "Steel Wiremill"
	quest.1D00667539B02E3B.quest_subtitle: "Pulls plates into wire"
	quest.1D00667539B02E3B.quest_desc: [
		"&eWhat:&r Copper wire can't be crafted by hand. The Wiremill draws plates into wire, and wire into fine wire."
		"&eChemistry:&r Metals are &eductile&r: their atoms slide past each other without the bonds breaking, so a plate can be pulled through a die into a thin wire."
		"&eHow:&r A steel machine casing, 4 bronze gears, 2 bronze rotors and 2 fluid pipes. It runs on steam like your other machines."
		"&eTip:&r 1 copper plate makes 2 wire. Keep it fed from your Steam Compressor."
	]
	quest.417F2089080CF66F.title: "Tin Wire"
	quest.417F2089080CF66F.quest_subtitle: "The core of LV cable"
	quest.417F2089080CF66F.quest_desc: [
		"&eWhat:&r Tin cable, the wire that carries LV power, has tin wire at its core. The Polarizer needs bare tin wire too."
		"&eChemistry:&r tin conducts about a seventh as well as copper. That's plenty for low voltage, and tin was cheap and resisted corrosion."
		"&eHow:&r Press tin ingots into plates, then draw each plate into 2 tin wire in the Wiremill."
	]
	quest.57D063A8E142DE9D.title: "Wires and Cables"
	quest.57D063A8E142DE9D.quest_subtitle: "Copper conducts; rubber makes it a cable"
	quest.57D063A8E142DE9D.quest_desc: [
		"&eWhat:&r copper wire goes into every component. Tin cable carries LV power between machines."
		"&eChemistry:&r copper's single outer electron moves freely between atoms, which is why it conducts so well."
		"&eHow:&r the Wiremill pulls copper plates into wire. 3 tin wire between 6 rubber sheets make 3 tin cable."
		"&eTip:&r tin cable is rated for LV (32 EU/t). Higher tiers need better cable."
	]
	quest.7507760BBA479D06.title: "Fine Copper Wire"
	quest.7507760BBA479D06.quest_subtitle: "Wire, drawn again"
	quest.7507760BBA479D06.quest_desc: [
		"&eWhat:&r Thinner wire for small components. Resistors need it first."
		"&eChemistry:&r A thinner wire has more resistance: current has less metal to flow through. Useful when you want to limit current, not carry it."
		"&eHow:&r Put copper wire back into the Wiremill: 1 wire makes 4 fine wire."
	]
	quest.66D90743DD8F6EC0.title: "Analog Circuit Board"
	quest.66D90743DD8F6EC0.quest_subtitle: "Rubber, copper, rubber"
	quest.66D90743DD8F6EC0.quest_desc: [
		"&eWhat:&r the base every analog circuit is soldered onto."
		"&eHow:&r rubber sheet, copper plate, rubber sheet stacked in a column."
		"&eTip:&r once you have an Assembler, it makes these automatically."
	]
	quest.1C1E9B5ECFF900F2.title: "Coal Dust"
	quest.1C1E9B5ECFF900F2.quest_subtitle: "Carbon for a resistor"
	quest.1C1E9B5ECFF900F2.quest_desc: [
		"&eWhat:&r the resistive filling of a carbon resistor."
		"&eHow:&r the Steam Macerator grinds 1 coal into 1 coal dust. Coal, not charcoal: the recipe wants coal dust specifically."
		"&eTip:&r one coal dust makes three resistors by hand, twelve in the Assembler."
	]
	quest.4D4359831AE16AE9.title: "Resistor"
	quest.4D4359831AE16AE9.quest_subtitle: "Limits the current through a circuit"
	quest.4D4359831AE16AE9.quest_desc: [
		"&eWhat:&r resistors limit current so the rest of the circuit doesn't burn out."
		"&eChemistry:&r carbon conducts, but poorly. A pinch of coal dust between fine copper wires makes a carbon resistor."
		"&eHow:&r 2 paper, 2 copper fine wire and 1 coal dust. One craft gives three."
	]
	quest.3A314B1F934A8988.title: "Gold Plates"
	quest.3A314B1F934A8988.quest_subtitle: "The plates of a capacitor"
	quest.3A314B1F934A8988.quest_desc: [
		"&eWhat:&r every capacitor holds two gold plates."
		"&eChemistry:&r gold doesn't oxidise, so its surface stays clean and conductive forever. Real electronics plate their contacts with a thin layer of it."
		"&eHow:&r the Steam Compressor presses 1 gold ingot into 1 plate."
		"&eTip:&r the Nether's gold ore and piglin trades are an easy source."
	]
	quest.28A08814D26B46D9.title: "Capacitor"
	quest.28A08814D26B46D9.quest_subtitle: "Stores charge between two plates"
	quest.28A08814D26B46D9.quest_desc: [
		"&eWhat:&r capacitors store a small charge and smooth out the current."
		"&eChemistry:&r two conductors (gold plates) separated by an insulator (rubber): charge builds up on each side."
		"&eHow:&r 2 gold plates, 2 copper wire and a rubber sheet."
	]
	quest.3562EE0D06376879.title: "Inductor"
	quest.3562EE0D06376879.quest_subtitle: "A coil that resists change"
	quest.3562EE0D06376879.quest_desc: [
		"&eWhat:&r inductors resist sudden changes in current. The Polarizer also needs them."
		"&eChemistry:&r current through a coil makes a magnetic field; changing the current fights that field."
		"&eHow:&r 8 copper wire wound around a steel rod."
	]
	quest.55AF98DD41956199.title: "Analog Circuit"
	quest.55AF98DD41956199.quest_subtitle: "Your first circuit"
	quest.55AF98DD41956199.quest_desc: [
		"&eWhat:&r the LV circuit. Mekanism's Basic Control Circuit also needs one, so MI and Mekanism advance together."
		"&eHow:&r 2 resistors, 1 inductor, 2 capacitors, the board, and 3 copper wire (see JEI for the layout)."
		"&eTip:&r make four or five now. The hull, turbine and each machine all eat them."
	]
	quest.4C7AA8620B6D2885.title: "The Spectrometer"
	quest.4C7AA8620B6D2885.quest_subtitle: "Every element sings its own colour"
	quest.4C7AA8620B6D2885.quest_desc: [
		"&6Once you could see the colours inside things, the light every element gives off. This is a fair copy.&r"
		"&eWhat:&r a hand-held scanner (Warbucks Core, made for this pack). Right-click to read the ore signal in the loaded chunks around you."
		"&eChemistry:&r heated atoms give off light only at certain wavelengths, an emission spectrum unique to each element. That's how helium was found in the Sun before anyone found it on Earth."
		"&eHow:&r amethyst prism, steel plates, copper wire and an analog circuit (check JEI). It lists each element with its strength, direction, distance and depth."
		"&eTip:&r a \"strong\" signal is usually a rich deposit. Walk towards it and scan again."
	]
	quest.5E67D9DE692DE74E.title: "Redstone Control Module"
	quest.5E67D9DE692DE74E.quest_subtitle: "An on-off switch for machines"
	quest.5E67D9DE692DE74E.quest_desc: [
		"&eWhat:&r slot it into an electric machine or multiblock and a redstone signal decides when it runs."
		"&eHow:&r redstone, a redstone torch, a capacitor, 2 resistors, 2 inductors and an analog circuit board (check JEI). Configure it in your hand first."
		"&eTip:&r wire it to a comparator on a tank and a machine stops before its output overflows."
	]
	quest.19B6324913F4E0DE.title: "Lead"
	quest.19B6324913F4E0DE.quest_subtitle: "The heavy half of battery alloy"
	quest.19B6324913F4E0DE.quest_desc: [
		"&eWhat:&r lead is most of the battery alloy in every redstone battery."
		"&eChemistry:&r most lead comes from galena, lead sulfide (PbS). Roasting drives the sulfur off as SO₂ and carbon reduces the oxide that's left: PbO + C → Pb + CO."
		"&eHow:&r MI lead ore is common, and rich deposits sit around Y -24 to 16. Smelt the raw lead."
	]
	quest.70A17E4532B8DA8B.title: "A Rich Lead Deposit"
	quest.70A17E4532B8DA8B.quest_subtitle: "Find a chunk full of lead"
	quest.70A17E4532B8DA8B.quest_desc: [
		"&eWhat:&r rich ore deposits hold hundreds of ores in one chunk, at a metal-specific depth. Lead's sits around Y -24 to 16."
		"&eHow:&r strip-mine at that depth and check ore with Jade. FTB Ultimine clears a vein in one go."
		"&eTip:&r galena (lead sulfide, PbS) is the world's main lead ore, and it often carries silver."
	]
	quest.77793676E67A1B68.title: "Antimony"
	quest.77793676E67A1B68.quest_subtitle: "The hardener"
	quest.77793676E67A1B68.quest_desc: [
		"&eWhat:&r a brittle, silvery metalloid. A little of it makes soft lead stiff enough to hold its shape in a battery."
		"&eChemistry:&r antimony's main ore is stibnite, Sb₂S₃. Ancient Egyptians ground it into kohl, the black eyeliner."
		"&eHow:&r MI antimony ore sits around Y -24 to 16 in rich deposits. Smelt the raw antimony."
	]
	quest.793BF809EF9A1130.title: "Battery Alloy Dust"
	quest.793BF809EF9A1130.quest_subtitle: "1 lead + 1 antimony"
	quest.793BF809EF9A1130.quest_desc: [
		"&eWhat:&r the mixed powder of lead and antimony."
		"&eHow:&r grind the ingots in the macerator, then mix 1 lead dust and 1 antimony dust into 2 battery alloy dust in the Steam Mixer."
	]
	quest.03F683AA3BD598A6.title: "Battery Alloy"
	quest.03F683AA3BD598A6.quest_subtitle: "Lead and antimony, as in a car battery"
	quest.03F683AA3BD598A6.quest_desc: [
		"&eWhat:&r battery alloy makes the casing and grids of redstone batteries."
		"&eChemistry:&r lead hardened with antimony is the grid metal of real lead-acid batteries. Pure lead is too soft."
		"&eHow:&r smelt battery alloy dust in any furnace."
	]
	quest.5F860EF298F9E2E6.title: "Battery Plates"
	quest.5F860EF298F9E2E6.quest_subtitle: "One flat, four curved per battery"
	quest.5F860EF298F9E2E6.quest_desc: [
		"&eWhat:&r each redstone battery is a flat battery alloy plate on top of four curved ones."
		"&eChemistry:&r in a real lead-acid cell the plates are grids, so the acid can reach as much lead surface as possible. More surface, more current."
		"&eHow:&r the Steam Compressor presses ingots into plates and plates into curved plates, 1:1."
	]
	quest.780CE79E82A87229.title: "Sulfur from Gunpowder"
	quest.780CE79E82A87229.quest_subtitle: "Element 16, the brimstone"
	quest.780CE79E82A87229.quest_desc: [
		"&eWhat:&r the S in H₂SO₄. Battery acid needs it, and the Dissolver can pull it out of gunpowder."
		"&eChemistry:&r gunpowder is saltpetre (KNO₃), sulfur and charcoal. One gunpowder dissolves into 2 potassium nitrate, 8 sulfur and 2 graphite."
		"&eHow:&r creepers drop gunpowder. Blaze powder dissolves into 8 sulfur too."
	]
	quest.504400DAF1F3A606.title: "Battery Acid"
	quest.504400DAF1F3A606.quest_subtitle: "2 H + S + 4 O → H₂SO₄, in the Combiner"
	quest.504400DAF1F3A606.quest_desc: [
		"&eWhat:&r the redstone battery is a real &elead-acid battery&r, and its electrolyte is sulfuric acid. The Combiner from Chapter II makes it from elements."
		"&eChemistry:&r H₂SO₄ is the most-produced chemical in the world. In a car battery it reacts with the lead plates (Pb + PbO₂ + 2H₂SO₄ → 2PbSO₄ + 2H₂O) and releases electrons; charging runs the reaction backwards."
		"&eHow:&r pick sulfuric acid in the Combiner and supply 2 hydrogen, 1 sulfur and 4 oxygen. Water or cellulose give the hydrogen and oxygen."
		"&eTip:&r every LV hull needs two batteries, so keep a stack of acid ready."
	]
	quest.2BF86ECE9691E81C.title: "Redstone Battery"
	quest.2BF86ECE9691E81C.quest_subtitle: "Lead, antimony and acid: the LV hull needs two"
	quest.2BF86ECE9691E81C.quest_desc: [
		"&eWhat:&r a rechargeable lead-acid battery. Every LV hull holds two."
		"&eChemistry:&r lead-antimony grids, sulfuric acid electrolyte: the same chemistry as the battery under a car's bonnet."
		"&eHow:&r 1 battery alloy plate, 4 curved plates, 2 tin cable, 1 redstone and 1 &esulfuric acid&r from the Combiner."
		"&eTip:&r the LV Storage Unit is built from six of these, so make spares."
	]
	quest.58932C2263D38534.title: "LV Storage Unit"
	quest.58932C2263D38534.quest_subtitle: "Moved: see EU Storage"
	quest.58932C2263D38534.quest_desc: [
		"&eMoved:&r this step is now \"EU Storage\" on the Power page. Click to dismiss."
	]
	quest.392A7909301184E2.title: "LV Machine Hull"
	quest.392A7909301184E2.quest_subtitle: "The heart of every LV machine"
	quest.392A7909301184E2.quest_desc: [
		"&6Your hands remember wiring this. Your mind is still catching up.&r"
		"&eWhat:&r &eLV&r (Low Voltage) is the first electric tier. Every LV machine is built on this hull."
		"&eHow:&r steel machine casing + analog circuit + 2 redstone batteries + 3 tin cable."
	]
	quest.1295A863E0D4A446.title: "Magnetic Steel Rod"
	quest.1295A863E0D4A446.quest_subtitle: "A steel rod surrounded by redstone"
	quest.1295A863E0D4A446.quest_desc: [
		"&eWhat:&r the core of an electric motor."
		"&eChemistry:&r iron-based alloys hold magnetism because their electron spins line up in domains."
		"&eHow:&r a steel rod ringed by 6 redstone. Later the Polarizer magnetises rods with electricity."
	]
	quest.2082C655C0D3F03A.title: "Electric Motor"
	quest.2082C655C0D3F03A.quest_subtitle: "Electricity in, rotation out"
	quest.2082C655C0D3F03A.quest_desc: [
		"&eWhat:&r motors drive turbines, pistons, conveyors and robot arms. Nearly every LV machine needs one."
		"&eChemistry:&r current in a coil next to a magnet creates a force; that's the motor effect. Run it backwards and it's a generator."
		"&eHow:&r a magnetic steel rod, 2 steel rods, 4 copper wire and 2 tin cable."
	]
	quest.3EE9DDEFB1213D1E.title: "Tin Blades, Rings and Bolts"
	quest.3EE9DDEFB1213D1E.quest_subtitle: "Rotor parts in tin"
	quest.3EE9DDEFB1213D1E.quest_desc: [
		"&eWhat:&r electric machines push fluids with tin rotors, not copper ones."
		"&eHow:&r the same parts as before: 2 tin curved plates on a tin rod make 4 blades; the Forge Hammer and Cutting Machine make rods, bolts and rings."
		"&eTip:&r the turbine and the mixer need 2 rotors each and a pump 3. Every rotor is 4 blades."
	]
	quest.3984370055D66C50.title: "Tin Rotors"
	quest.3984370055D66C50.quest_subtitle: "Blades for the turbine"
	quest.3984370055D66C50.quest_desc: [
		"&eWhat:&r the spinning heart of the steam turbine, and the stirrer of the electric mixer."
		"&eHow:&r 4 tin blades, a tin ring and 4 tin bolts."
	]
	quest.2535BA17FB64FACE.title: "Steam to Electricity"
	quest.2535BA17FB64FACE.quest_subtitle: "Your boilers become a power plant"
	quest.2535BA17FB64FACE.quest_desc: [
		"&eWhat:&r a turbine turns your boiler's steam into &eEU&r, MI's electricity: 1 mB of steam is 1 EU, up to 32 EU/t."
		"&eHow:&r an LV hull, an analog circuit, 2 tin rotors, 2 motors, 2 fluid pipes and tin cable. Pipe steam in and run tin cable from its output side to your machines."
		"&eTip:&r one turbine at full speed eats the steam of two steel boilers. If machines stall, add boilers before adding turbines."
	]
	quest.75392C7B4202212A.title: "LV Energy Input Hatch"
	quest.75392C7B4202212A.quest_subtitle: "Power into a multiblock"
	quest.75392C7B4202212A.quest_desc: [
		"&eWhat:&r electric multiblocks take power through energy hatches. The Electric Blast Furnace needs at least one."
		"&eHow:&r a tin cable on top of an LV machine hull."
		"&eTip:&r an LV hatch only connects to LV cables. Two hatches double the power a multiblock can draw."
	]
	quest.715BC066754DE9B0.title: "Pipe Config Card"
	quest.715BC066754DE9B0.quest_subtitle: "Copy one pipe's settings to another"
	quest.715BC066754DE9B0.quest_desc: [
		"&eWhat:&r saves an item or fluid pipe connection's settings and pastes them onto other connections."
		"&eHow:&r sneak + use on a configured pipe connection to save; use on another connection to apply. Sneak + use on air clears it."
		"&eTip:&r it can also camouflage pipes as any block. The card's tooltip explains how."
	]
	quest.0C925B1FB58E9659.title: "Pump"
	quest.0C925B1FB58E9659.quest_subtitle: "A motor that moves fluid"
	quest.0C925B1FB58E9659.quest_desc: [
		"&eWhat:&r MI's pump component: the Electric Water Pump and the Diesel Generator are built around it."
		"&eHow:&r 3 fluid pipes, a motor, 3 tin rotors and 2 tin bolts (check JEI)."
	]
	quest.7DE855B5084E6181.title: "Electric Water Pump"
	quest.7DE855B5084E6181.quest_subtitle: "Endless water for boilers"
	quest.7DE855B5084E6181.quest_desc: [
		"&eWhat:&r pumps water from nothing but power, for boilers and (soon) electrolysis."
		"&eHow:&r an LV hull with 2 pumps, a tin rotor, fluid pipes, tin cable and an analog circuit."
		"&eTip:&r next chapter, water becomes hydrogen and oxygen. You'll want lots of it."
	]
	quest.4B788318DD3F9C82.title: "Burning Creosote"
	quest.4B788318DD3F9C82.quest_subtitle: "An LV generator that burns fluid fuel"
	quest.4B788318DD3F9C82.quest_desc: [
		"&eWhat:&r the Diesel Generator burns liquid fuels into EU. Right now that means creosote from the Coke Oven, a waste product turned into power."
		"&eChemistry:&r creosote is a mix of aromatic hydrocarbons and phenols. Burning them releases the energy in their C-H and C-C bonds as heat, just like coal, but it flows through a pipe."
		"&eHow:&r an LV hull, 2 pumps, 2 tin gears, an analog circuit and 3 tin cable. Check JEI for every fuel it accepts."
		"&eTip:&r later fuels from the distillation tower burn far longer per bucket."
	]
	quest.18D25C63CA285B54.title: "Piston"
	quest.18D25C63CA285B54.quest_subtitle: "A motor that pushes"
	quest.18D25C63CA285B54.quest_desc: [
		"&eWhat:&r MI's piston component, used in the macerator, compressor and robot arm."
		"&eHow:&r 3 steel plates, 2 steel rods, a steel gear, 2 tin cable and a motor."
		"&eTip:&r the Electric Macerator needs 2 pistons and the Electric Compressor 4, so make plenty."
	]
	quest.5E348DAE3EAE594E.title: "Conveyor"
	quest.5E348DAE3EAE594E.quest_subtitle: "A rubber belt on two motors"
	quest.5E348DAE3EAE594E.quest_desc: [
		"&eWhat:&r conveyors move items inside machines. The Assembler, Packer and Cutting Machine need them."
		"&eHow:&r 6 rubber sheets, 2 motors and a tin cable."
		"&eTip:&r motors are the bottleneck here. Keep a few spare."
	]
	quest.23F83FE4BAEF4BD9.title: "Robot Arm"
	quest.23F83FE4BAEF4BD9.quest_subtitle: "Motors, a piston and a circuit"
	quest.23F83FE4BAEF4BD9.quest_desc: [
		"&eWhat:&r robot arms move parts inside the Assembler and Packer."
		"&eHow:&r two motors, a piston, steel rods, tin cable and an analog circuit."
		"&eTip:&r the Assembler takes four and the Packer two."
	]
	quest.2F67A54D1D634F0A.title: "Electric Compressor"
	quest.2F67A54D1D634F0A.quest_subtitle: "Plates, faster and without steam"
	quest.2F67A54D1D634F0A.quest_desc: [
		"&eWhat:&r plates, curved plates and rings for every part you'll build next."
		"&eHow:&r LV hull, four pistons, two analog circuits and two tin cable."
		"&eTip:&r it doubles as a second plate source while the steam compressor keeps running."
	]
	quest.0E77517E4651B27A.title: "Electric Wiremill"
	quest.0E77517E4651B27A.quest_subtitle: "Wire, faster"
	quest.0E77517E4651B27A.quest_desc: [
		"&eWhat:&r copper wire and fine wire in bulk. Circuits and coils use a lot of it."
		"&eHow:&r LV hull, 4 motors, 2 analog circuits and 2 tin cable."
		"&eTip:&r feed it from your compressor's plate output."
	]
	quest.2EF4BB510E2F28AC.title: "Polarizer"
	quest.2EF4BB510E2F28AC.quest_subtitle: "Magnetises rods and wires"
	quest.2EF4BB510E2F28AC.quest_desc: [
		"&eWhat:&r magnetic steel rods for motors, and &emagnetic cupronickel wire&r for heating coils."
		"&eChemistry:&r a strong field lines up the magnetic domains in the metal, and they stay lined up."
		"&eHow:&r LV hull, 2 inductors, 4 tin wire and 2 tin cable."
	]
	quest.48A4FFD83AE8AD44.title: "Electric Mixer"
	quest.48A4FFD83AE8AD44.quest_subtitle: "Alloy dusts and chemical mixes"
	quest.48A4FFD83AE8AD44.quest_desc: [
		"&eWhat:&r mixing dusts into alloys (bronze, invar, cupronickel, battery alloy) and fluids into mixtures, faster than steam and up to 32 EU/t."
		"&eHow:&r LV hull, a motor, 2 tin rotors, 2 glass, a fluid pipe and 2 analog circuits."
		"&eTip:&r recipes that need more than 4 EU/t, like vulcanised synthetic rubber, run here and not in the steam mixer."
	]
	quest.541A010A43E31E95.title: "Electric Macerator"
	quest.541A010A43E31E95.quest_subtitle: "Grinding, now electric"
	quest.541A010A43E31E95.quest_desc: [
		"&eWhat:&r ore to crushed dust, ingots back to dust. Still capped at 2x per ore until acids."
		"&eHow:&r an LV hull, an &einvar rotary blade&r, 2 pistons, 2 motors, 2 analog circuits and tin cable."
		"&eTip:&r the hull quest reward included one. Build a second for throughput."
	]
	quest.7364759091BAA54E.title: "Cutting Machine"
	quest.7364759091BAA54E.quest_subtitle: "Rods, bolts and planks"
	quest.7364759091BAA54E.quest_desc: [
		"&eWhat:&r cutting ingots into rods and bolts, and logs into more planks."
		"&eHow:&r an LV hull, an invar rotary blade, 2 motors, a conveyor, 2 glass and 2 analog circuits. Its cuts use a little lubricant, the creosote + redstone mix from Chapter II."
		"&eTip:&r logs give six planks here instead of four."
	]
	quest.290BB135DCEA6DC7.title: "Assembler"
	quest.290BB135DCEA6DC7.quest_subtitle: "Where MI automation really starts"
	quest.290BB135DCEA6DC7.quest_desc: [
		"&eWhat:&r circuits and machine parts, automatically, from a stocked input."
		"&eHow:&r LV hull, four robot arms, two conveyors and two analog circuits."
		"&eTip:&r automate hulls, circuits, motors, pistons, robot arms and conveyors first. With slot locking, one Assembler can hold up to three recipes."
	]
	quest.6D28244E306FB852.title: "Packer"
	quest.6D28244E306FB852.quest_subtitle: "Blocks, double ingots and more"
	quest.6D28244E306FB852.quest_desc: [
		"&eWhat:&r compacting ingots into blocks and double ingots, and assembling a few parts. You'll want bauxite blocks next chapter."
		"&eHow:&r 2 robot arms, 2 conveyors, 3 analog circuits and 2 tin cable on an LV hull."
		"&eTip:&r unpacking is a separate machine, the Unpacker. Build one if you store metal as blocks."
	]
	quest.5C3EE33DE324BFAB.title: "Configurable Chest"
	quest.5C3EE33DE324BFAB.quest_subtitle: "27 slots that sort and eject"
	quest.5C3EE33DE324BFAB.quest_desc: [
		"&eWhat:&r a chest with lockable slots and auto-eject: a buffer between machines that keeps exactly what you tell it to."
		"&eHow:&r a steel machine casing, 2 motors, 2 hoppers and 4 analog circuits make 4 chests."
		"&eTip:&r lock its slots to the parts of a recipe and it becomes a tidy input buffer for an Assembler."
	]
	quest.3D588C9CA0BC7C9B.title: "Steel Drills"
	quest.3D588C9CA0BC7C9B.quest_subtitle: "Longer-lasting quarry drills"
	quest.3D588C9CA0BC7C9B.quest_desc: [
		"&eWhat:&r the steel tier of quarry drill. The Steam Quarry digs a different ore table with them (check JEI)."
		"&eHow:&r a steel drill head, 2 iron gears, 2 item pipes, 2 motors, a tin cable and an analog circuit make 4 drills."
	]
	quest.18170B0E819C6E3C.title: "Cupronickel Dust"
	quest.18170B0E819C6E3C.quest_subtitle: "1 copper + 1 nickel"
	quest.18170B0E819C6E3C.quest_desc: [
		"&eWhat:&r the mixed powder for MI's first heating wire."
		"&eHow:&r in a mixer, 1 copper dust and 1 nickel dust make 2 cupronickel dust. The Steam Mixer can do it."
		"&eTip:&r the furnace's coils alone take 64 cupronickel ingots. Find a nickel deposit (Y -32 to 8) before you start."
	]
	quest.1A2695F25F58E916.title: "Cupronickel Ingots and Plates"
	quest.1A2695F25F58E916.quest_subtitle: "Smelt, then press"
	quest.1A2695F25F58E916.quest_desc: [
		"&eWhat:&r cupronickel is drawn into wire from plates, just like copper."
		"&eChemistry:&r copper and nickel dissolve into each other in any ratio: a true &esolid solution&r, one crystal lattice with both atoms mixed at random."
		"&eHow:&r smelt the dust into ingots, then press ingots into plates in a compressor."
	]
	quest.535D1E9F5B2936D1.title: "Cupronickel Wire"
	quest.535D1E9F5B2936D1.quest_subtitle: "Two wires per plate"
	quest.535D1E9F5B2936D1.quest_desc: [
		"&eWhat:&r bare cupronickel wire, the start of both coils and heating elements."
		"&eHow:&r the Wiremill draws 1 cupronickel plate into 2 wire."
	]
	quest.0DFEE581F10201B2.title: "Magnetic Cupronickel Wire"
	quest.0DFEE581F10201B2.quest_subtitle: "Copper-nickel wire for heating coils"
	quest.0DFEE581F10201B2.quest_desc: [
		"&6A wire that turns current into heat on command. Fire, tamed one more time.&r"
		"&eWhat:&r the heating wire for the Electric Furnace (4) and the Electric Blast Furnace controller (7)."
		"&eChemistry:&r cupronickel (copper + nickel) resists current more than copper and survives heat. Coins and ship pipes use it too."
		"&eHow:&r magnetise cupronickel wire in the Polarizer, 1:1."
	]
	quest.435D6984CDDF47E1.title: "Electric Furnace"
	quest.435D6984CDDF47E1.quest_subtitle: "Smelting with heat from a wire coil"
	quest.435D6984CDDF47E1.quest_desc: [
		"&eWhat:&r fast, fuel-free smelting."
		"&eChemistry:&r current through a resistive wire turns into heat (Joule heating), the same idea as a toaster."
		"&eHow:&r LV hull wrapped in 4 magnetic cupronickel wire, with 2 analog circuits and tin cable."
	]
	quest.1FBE35CD1A4B0E02.title: "Cupronickel Cable"
	quest.1FBE35CD1A4B0E02.quest_subtitle: "Insulated heating wire"
	quest.1FBE35CD1A4B0E02.quest_desc: [
		"&eWhat:&r coils are wound from insulated cupronickel cable. Cupronickel cable is also MV-rated if you ever need it for power."
		"&eHow:&r 3 cupronickel wire between 6 rubber sheets make 3 cable. The Assembler does it with synthetic rubber fluid and no sheets."
		"&eTip:&r 16 coils need 128 cable. This is where an Assembler and a rubber line pay off."
	]
	quest.1B92A1281C26BAA7.title: "Cupronickel Coils"
	quest.1B92A1281C26BAA7.quest_subtitle: "Two hollow rings of them"
	quest.1B92A1281C26BAA7.quest_desc: [
		"&eWhat:&r the heating jacket of the Electric Blast Furnace: two hollow 3x3 rings of 8 coils each."
		"&eChemistry:&r a coil packs a long wire into a small space, so a lot of resistive heating happens in one block. Kilns and toasters use the same trick."
		"&eHow:&r 8 cupronickel cable in a ring make 1 coil."
		"&eTip:&r cupronickel coils run EBF recipes up to 32 EU/t, which covers aluminium and silicon."
	]
	quest.5E85D21B83221114.title: "A Stack of Invar Plates"
	quest.5E85D21B83221114.quest_subtitle: "For the furnace's heatproof shell"
	quest.5E85D21B83221114.quest_desc: [
		"&eWhat:&r heatproof casings are 8 invar plates around an invar gear each. The furnace needs a dozen or more."
		"&eHow:&r mix iron and nickel dust 2:1 into invar dust, smelt, and press the ingots into plates."
		"&eTip:&r that's well over a hundred plates in all. Run the mixer, a furnace and the compressor in a line."
	]
	quest.67E9E34070EF1881.title: "Heatproof Machine Casings"
	quest.67E9E34070EF1881.quest_subtitle: "A floor and a roof that won't warp"
	quest.67E9E34070EF1881.quest_desc: [
		"&eWhat:&r the Electric Blast Furnace's bottom and top layers are heatproof casings, with the controller and hatches set into them."
		"&eChemistry:&r a furnace wall that expands as it heats cracks at the joints. Invar barely expands, so a casing made of it holds its shape at any temperature the coils reach."
		"&eHow:&r 8 invar plates around an invar gear. You need up to 14: 18 blocks in the two layers, minus the controller and each hatch."
	]
	quest.0213687BA73A9908.title: "Electric Blast Furnace"
	quest.0213687BA73A9908.quest_subtitle: "The furnace that makes aluminum"
	quest.0213687BA73A9908.quest_desc: [
		"&6Fire you can measure in volts. You used to do this without the volts.&r"
		"&eWhat:&r MI's big furnace multiblock. With cupronickel coils it reaches the heat for &ealuminum&r and &esilicon&r."
		"&eHow:&r the controller is an LV hull, 7 magnetic cupronickel wire and a blast furnace. Build a layer of heatproof casings (controller in it), two hollow rings of cupronickel coils, and another heatproof layer. Hatches go in the top or bottom layer: an LV energy input hatch and item hatches."
		"&eTip:&r hold a hatch or wrench near the controller to see the valid positions highlighted. JEI shows the whole shape in 3D."
	]
	quest.474137432EABE206.title: "Osmium"
	quest.474137432EABE206.quest_subtitle: "Mekanism's blue-grey metal"
	quest.474137432EABE206.quest_desc: [
		"&eWhat:&r Mekanism builds almost everything from osmium: its infuser, casings and circuits."
		"&eChemistry:&r real osmium is the densest natural element, 22.6 g/cm³. A litre of it weighs about as much as a big dog."
		"&eHow:&r osmium ore is common in small veins underground. Mine it with an iron pickaxe or better."
	]
	quest.4C96AD6CEA8A92A6.title: "Osmium Ingots"
	quest.4C96AD6CEA8A92A6.quest_subtitle: "Raw osmium, smelted"
	quest.4C96AD6CEA8A92A6.quest_desc: [
		"&eWhat:&r the Metallurgic Infuser, the Steel Casing and every Basic Control Circuit each take an osmium ingot."
		"&eChemistry:&r osmium is named for its smell: the Greek &eosme&r. Powdered osmium slowly oxidises in air to OsO₄, a volatile and very toxic oxide with a sharp odour."
		"&eHow:&r smelt raw osmium in any furnace."
	]
	quest.6A50FF652B6B5624.title: "Osmium Hoard"
	quest.6A50FF652B6B5624.quest_subtitle: "Stockpile for the Mekanism build-out"
	quest.6A50FF652B6B5624.quest_desc: [
		"&eWhat:&r every Mekanism machine, casing and circuit costs osmium. A stockpile saves trips."
		"&eHow:&r smelt or enrich raw osmium into ingots."
		"&eTip:&r the Enrichment Chamber doubles osmium ore, so process it there once it's built."
	]
	quest.42B76D3BDE21F0DC.title: "Mekanism: Metallurgic Infuser"
	quest.42B76D3BDE21F0DC.quest_subtitle: "Infuse metals with carbon, redstone and more"
	quest.42B76D3BDE21F0DC.quest_desc: [
		"&eWhat:&r Mekanism's entry machine. It infuses metals with other materials."
		"&eHow:&r 4 iron ingots, 2 redstone, an osmium ingot and 2 furnaces."
		"&eTip:&r it runs on FE. Your Chapter II generator works, or a Mekanism Heat Generator (Power chapter)."
	]
	quest.354E125FC5D3BB01.title: "Infused Alloy"
	quest.354E125FC5D3BB01.quest_subtitle: "Copper infused with redstone"
	quest.354E125FC5D3BB01.quest_desc: [
		"&eWhat:&r Mekanism's basic alloy. The Enrichment Chamber and many basic machines need it."
		"&eChemistry:&r a real alloy mixes metals at the atomic level. Here redstone plays the part of the second element."
		"&eHow:&r put redstone in the infuser's left slot (it becomes an infusion buffer), then feed copper ingots."
	]
	quest.480FB3C55927F1A1.title: "Mekanism Circuits"
	quest.480FB3C55927F1A1.quest_subtitle: "MI's analog circuit, in Mekanism form"
	quest.480FB3C55927F1A1.quest_desc: [
		"&eWhat:&r in this pack, a Basic Control Circuit is &eMI Analog Circuit + osmium ingot&r (shapeless). Each Mekanism circuit tier needs the matching MI circuit."
		"&eHow:&r the Steel Casing (4 steel, 4 glass and an osmium ingot) is the frame for most Mekanism machines."
		"&eTip:&r make several casings at once. Every Mekanism machine in the next chapter needs one."
	]
	quest.3A2454B103645938.title: "Enrichment Chamber"
	quest.3A2454B103645938.quest_subtitle: "Mekanism's 2x ore processing"
	quest.3A2454B103645938.quest_desc: [
		"&eWhat:&r ore → 2 dust. It also turns dirty dust into clean dust in the higher-tier lines."
		"&eHow:&r steel casing, 4 infused alloy, 2 iron and 2 basic control circuits."
		"&eTip:&r 3x, 4x and 5x need gases and acids: that's the next chapter."
	]
	quest.6BB487593411143E.title: "Crusher"
	quest.6BB487593411143E.quest_subtitle: "Clumps into dirty dust"
	quest.6BB487593411143E.quest_desc: [
		"&eWhat:&r crushes ingots to dust and, later, ore clumps into dirty dust in the 3x+ lines."
		"&eHow:&r steel casing, 2 basic control circuits, 4 redstone and 2 lava buckets."
		"&eTip:&r it also turns ingots back into dust, handy for alloy recipes."
	]
	chapter.6549651AA2526584.title: "V. Electrochemistry and Acids"
	chapter.6549651AA2526584.chapter_subtitle: [
		"Electricity splits compounds into elements. Acids dissolve what fire can't."
		"Ore processing becomes chemistry."
	]
	quest.0D7390621F3F2B9F.title: "Mekanism Gases"
	quest.0D7390621F3F2B9F.quest_subtitle: "Split water into hydrogen and oxygen"
	quest.0D7390621F3F2B9F.quest_desc: [
		"&6Once a word was enough to pull water apart. Now it takes a machine and a cable, and that will have to do.&r"
		"&eWhat:&r the Electrolytic Separator makes hydrogen and oxygen as gases you can pipe and store."
		"&eChemistry:&r 2H₂O → 2H₂ + O₂. Current drives the reaction backwards from burning hydrogen."
		"&eHow:&r feed it water and FE. Gases leave from the coloured sides (configure them with the Configurator)."
	]
	quest.326FC7460262152E.title: "Pressurized Tubes"
	quest.326FC7460262152E.quest_subtitle: "Pipes for gases"
	quest.326FC7460262152E.quest_desc: [
		"&eWhat:&r gases need sealed tubes. Item pipes and fluid pipes won't carry them."
		"&eHow:&r craft basic pressurized tubes (see JEI) and run them from the separator's outputs."
		"&eTip:&r vent what you don't need yet. A full output tank stops the whole separator."
	]
	quest.5FB4044A1D311473.title: "A Source of Sulfur"
	quest.5FB4044A1D311473.quest_subtitle: "Yellow brimstone for the contact process"
	quest.5FB4044A1D311473.quest_desc: [
		"&eWhat:&r sulfur is where sulfuric acid starts."
		"&eChemistry:&r S is element 16. Volcanoes and fossil fuels are full of it; most industrial sulfur is stripped out of oil and gas."
		"&eHow:&r macerate crushed lignite coal (about half the time you get sulfur dust), or centrifuge lava later. Press U on Sulfur Dust in JEI for all sources."
	]
	quest.4B75115FF988850B.title: "Contact Process 1: SO₂"
	quest.4B75115FF988850B.quest_subtitle: "Burn sulfur into sulfur dioxide"
	quest.4B75115FF988850B.quest_desc: [
		"&eWhat:&r the Chemical Oxidizer turns a solid into a gas. Sulfur dust becomes sulfur dioxide."
		"&eChemistry:&r S + O₂ → SO₂. It's the sharp smell of a struck match."
		"&eHow:&r one sulfur dust gives 100 mB of SO₂. Pipe it out with pressurized tubes."
	]
	quest.25824A2CB3B866D5.title: "Contact Process 2: SO₃"
	quest.25824A2CB3B866D5.quest_subtitle: "Sulfur dioxide + oxygen"
	quest.25824A2CB3B866D5.quest_desc: [
		"&eWhat:&r the Chemical Infuser combines two gases. SO₂ plus oxygen from your separator gives sulfur trioxide."
		"&eChemistry:&r 2SO₂ + O₂ → 2SO₃. Real plants pass the gases over a vanadium oxide (V₂O₅) catalyst at about 450 °C: the 'contact' in the name."
		"&eHow:&r SO₂ in one side, O₂ in the other."
	]
	quest.4630AF08524F8BB3.title: "Water Vapor"
	quest.4630AF08524F8BB3.quest_subtitle: "Turn water into a gas Mekanism can use"
	quest.4630AF08524F8BB3.quest_desc: [
		"&eWhat:&r the Rotary Condensentrator converts fluids to gases and back. It turns water into water vapor."
		"&eHow:&r set it to gas mode (the toggle in its GUI), pipe water in and pressurized tube out."
		"&eTip:&r it also turns Mekanism gases into buckets, which is handy for storage and trading."
	]
	quest.7C9F89951691CE8C.title: "Contact Process 3: H₂SO₄"
	quest.7C9F89951691CE8C.quest_subtitle: "SO₃ + water vapor in a second infuser"
	quest.7C9F89951691CE8C.quest_desc: [
		"&eWhat:&r a second Chemical Infuser combines SO₃ with water vapor into sulfuric acid gas. Tick this when acid is flowing."
		"&eChemistry:&r SO₃ + H₂O → H₂SO₄. Real plants dissolve SO₃ in existing acid first (oleum), because SO₃ and water alone make a corrosive mist."
		"&eTip:&r store the acid in a chemical tank. The 5x ore line drinks it."
	]
	quest.4015B208E94DAE2D.title: "Salt"
	quest.4015B208E94DAE2D.quest_subtitle: "Sodium chloride, NaCl"
	quest.4015B208E94DAE2D.quest_desc: [
		"&eWhat:&r salt is the start of the chlor-alkali industry: chlorine, sodium and everything made from them."
		"&eChemistry:&r NaCl is an ionic crystal: Na⁺ and Cl⁻ held together by charge. Split it and you get a soft, reactive metal and a toxic green gas."
		"&eHow:&r MI salt ore is found underground and drops salt dust."
	]
	quest.1CA114894501491D.title: "Brine"
	quest.1CA114894501491D.quest_subtitle: "Salt dissolved in water"
	quest.1CA114894501491D.quest_desc: [
		"&eWhat:&r brine is salty water, and Mekanism splits it into chlorine. Tick this when you have brine."
		"&eHow:&r put salt dust in a Chemical Oxidizer (15 mB brine per dust), or build a Thermal Evaporation Plant (see the side quest)."
		"&eTip:&r a second oxidizer just for salt saves you from swapping inputs."
	]
	quest.573EAFB3E7A17498.title: "Chlorine"
	quest.573EAFB3E7A17498.quest_subtitle: "Electrolyse brine into Cl₂ and sodium"
	quest.573EAFB3E7A17498.quest_desc: [
		"&eWhat:&r the Electrolytic Separator also takes brine. Out come chlorine and sodium. Tick this when chlorine is flowing."
		"&eChemistry:&r real brine electrolysis gives Cl₂ at one electrode and H₂ + NaOH at the other. Mekanism simplifies it to sodium + chlorine."
		"&eTip:&r use a second separator so your hydrogen and oxygen line keeps running."
	]
	quest.649A4F33DE9E7A82.title: "Hydrogen Chloride"
	quest.649A4F33DE9E7A82.quest_subtitle: "H₂ + Cl₂ in a Chemical Infuser"
	quest.649A4F33DE9E7A82.quest_desc: [
		"&eWhat:&r hydrogen chloride drives the 4x ore line. Tick this when HCl is flowing."
		"&eChemistry:&r H₂ + Cl₂ → 2HCl. Dissolved in water it's hydrochloric acid, the same acid in your stomach."
		"&eHow:&r hydrogen in one side of a Chemical Infuser, chlorine in the other."
	]
	quest.613C5C713C056E03.title: "3x Ore: Oxygen"
	quest.613C5C713C056E03.quest_subtitle: "Purification Chamber + oxygen"
	quest.613C5C713C056E03.quest_desc: [
		"&eWhat:&r before acids, every route caps at &e2x&r per ore. Purifying ore with oxygen gives &e3x&r. The chamber needs advanced control circuits, which are built on MI's electronic circuit."
		"&eHow:&r ore + O₂ → 3 clumps. Crusher: clumps → dirty dust. Enrichment Chamber: dirty dust → dust."
		"&eTip:&r Mekanism shows each step in JEI. Chain them with pipes and side configuration."
	]
	quest.5DC82018A921CB16.title: "4x Ore: Hydrogen Chloride"
	quest.5DC82018A921CB16.quest_subtitle: "Chemical Injection Chamber + HCl"
	quest.5DC82018A921CB16.quest_desc: [
		"&eWhat:&r injecting hydrogen chloride splits ore into shards: &e4x&r."
		"&eHow:&r ore + HCl → 4 shards. Purification Chamber: shards → clumps, then on through your 3x line."
		"&eTip:&r your 3x machines are now the back half of the 4x line. Nothing is wasted."
	]
	quest.1F8977634DAF6D2D.title: "Dissolving Ore"
	quest.1F8977634DAF6D2D.quest_subtitle: "Ore + sulfuric acid → dirty slurry"
	quest.1F8977634DAF6D2D.quest_desc: [
		"&eWhat:&r the Dissolution Chamber dissolves ore in sulfuric acid, giving a dirty slurry."
		"&eChemistry:&r acid leaching: H₂SO₄ turns metal minerals into soluble sulfates, leaving the rock behind."
		"&eHow:&r feed it ore and sulfuric acid gas. The slurry comes out as a chemical."
	]
	quest.6D834765E3A2FDF2.title: "Washing Slurry"
	quest.6D834765E3A2FDF2.quest_subtitle: "Dirty slurry + water → clean slurry"
	quest.6D834765E3A2FDF2.quest_desc: [
		"&eWhat:&r the Chemical Washer rinses impurities out of the slurry."
		"&eChemistry:&r washing removes the dissolved gangue (waste rock) so only the metal salt is left to crystallise."
		"&eHow:&r slurry in, water in, clean slurry out. An MI electric water pump keeps the water coming."
	]
	quest.79928EE6B7E8E534.title: "5x Ore: Dissolution"
	quest.79928EE6B7E8E534.quest_subtitle: "Crystallise the slurry: five from one"
	quest.79928EE6B7E8E534.quest_desc: [
		"&6Five from one. You used to call that a small miracle. Now you call it hydrometallurgy.&r"
		"&eWhat:&r the Chemical Crystallizer turns clean slurry into crystals: &e5x&r per ore."
		"&eChemistry:&r this is &ehydrometallurgy&r, the way most of the world's copper is really refined."
		"&eHow:&r crystals → Injection Chamber (shards) → Purification Chamber (clumps) → Crusher → Enrichment Chamber."
		"&eTip:&r the Crystallizer itself needs fluorite gems: Mekanism's fluorite ore sits deep underground (check JEI for the recipe)."
	]
	quest.5610598250CF6B1D.title: "Ore Byproducts"
	quest.5610598250CF6B1D.quest_subtitle: "Dirty dust through a centrifuge"
	quest.5610598250CF6B1D.quest_desc: [
		"&eWhat:&r real ores are never pure. Send Mekanism's &edirty dust&r through MI's &eCentrifuge&r instead of the Enrichment Chamber for the same dust plus a chance at a bonus metal."
		"&eChemistry:&r iron → nickel, copper → gold, gold → silver, &elead → silver&r (galena), tin → tungsten, osmium → iridium, uranium → lead (decay)."
		"&eHow:&r route dirty dust to your Centrifuge instead of the Enrichment Chamber. Silver from lead (or gold) dirty dust ticks this quest."
	]
	quest.543D2B2404F95AAA.title: "Bauxite"
	quest.543D2B2404F95AAA.quest_subtitle: "The ore aluminum hides in"
	quest.543D2B2404F95AAA.quest_desc: [
		"&6An emperor once served his finest guests on this metal. You knew even then it was never rare, only stubborn.&r"
		"&eWhat:&r bauxite is the only practical aluminum ore. MI bauxite ore drops bauxite dust."
		"&eChemistry:&r bauxite is mostly aluminium hydroxides, Al(OH)₃ and AlO(OH), stained red by iron oxide."
		"&eHow:&r rich bauxite deposits sit around Y -16 to 24. No furnace will free the metal: it goes through the Bayer process first."
	]
	quest.0634B5A042428462.title: "Lye for the Digester"
	quest.0634B5A042428462.quest_subtitle: "Sodium hydroxide from the Combiner"
	quest.0634B5A042428462.quest_desc: [
		"&eWhat:&r the Bayer process dissolves bauxite in hot lye, so you need sodium hydroxide solution first."
		"&eChemistry:&r NaOH is a strong base: it fully splits into Na⁺ and OH⁻ in water, and OH⁻ is what pulls aluminium into solution."
		"&eHow:&r combine Na + O + H in the Alchemistry Combiner (check JEI on Sodium Hydroxide), then Mixer: 1 crystal + 250 mB water → 250 mB lye."
		"&eTip:&r the digester gives most of the lye back, so a few crystals go a long way. Later the Chemical Reactor makes it in bulk."
	]
	quest.0254086EF2C56C8D.title: "Bayer Digestion"
	quest.0254086EF2C56C8D.quest_subtitle: "Dissolve the aluminium, leave the rust"
	quest.0254086EF2C56C8D.quest_desc: [
		"&eWhat:&r the first step of every aluminium refinery since 1888: hot lye dissolves the aluminium out of bauxite."
		"&eChemistry:&r Al(OH)₃ + NaOH → NaAl(OH)₄ (sodium aluminate). Iron and titanium oxides don't dissolve; they settle out as 'red mud'."
		"&eHow:&r Mixer: 4 bauxite dust + 1000 mB lye → 1000 mB sodium aluminate solution + 2 tiny iron dust + 1 tiny titanium dust."
		"&eTip:&r pipe the solution straight into the next Mixer; a bucket is only needed for this quest."
	]
	quest.44D206C74AAFDE47.title: "Precipitation"
	quest.44D206C74AAFDE47.quest_subtitle: "Cool, dilute, and crystals fall out"
	quest.44D206C74AAFDE47.quest_desc: [
		"&eWhat:&r pure aluminium hydroxide, crystallised back out of the solution, with the lye recovered."
		"&eChemistry:&r NaAl(OH)₄ → Al(OH)₃ + NaOH. Diluting the liquor makes the reaction run backwards; the impurities stayed behind in the red mud."
		"&eHow:&r Mixer: 1000 mB sodium aluminate + 1000 mB water → 4 aluminium hydroxide dust + 900 mB lye."
		"&eTip:&r loop the 900 mB of lye back into the digester. That loop is why the Bayer process is cheap."
	]
	quest.27E5C3E5F7BB388B.title: "Alumina"
	quest.27E5C3E5F7BB388B.quest_subtitle: "Bake out the water"
	quest.27E5C3E5F7BB388B.quest_desc: [
		"&eWhat:&r alumina (aluminium oxide) is the white powder that actually goes into the smelter."
		"&eChemistry:&r calcination: 2Al(OH)₃ → Al₂O₃ + 3H₂O at around 1000 °C. Alumina also makes sapphire and ruby, coloured by traces of iron, titanium or chromium."
		"&eHow:&r Electric Blast Furnace: 2 aluminium hydroxide dust → 1 alumina dust."
	]
	quest.3B99BB8419C1FF2D.title: "The Hall-Héroult Cell"
	quest.3B99BB8419C1FF2D.quest_subtitle: "Electrolyse molten alumina"
	quest.3B99BB8419C1FF2D.quest_desc: [
		"&eWhat:&r a multiblock smelter that splits alumina with electricity. It's built from steel and LV parts, because it's what makes your first aluminium."
		"&eChemistry:&r alumina melts at 2072 °C, far too hot. Dissolved in molten cryolite it melts near 950 °C. Current then splits it: 2Al₂O₃ + 3C → 4Al + 3CO₂, burning the carbon anode away."
		"&eHow:&r controller from steel large plates, analog circuits, cupronickel coils and an LV hull. Check JEI (press U on the controller) for the 3x3x3 shape: steel casings top and bottom, a ring of cupronickel coils with the controller in the middle layer."
		"{@pagebreak}"
		"&eHistory:&r Charles Martin Hall (USA) and Paul Héroult (France) found the process independently in 1886, both in their early twenties. Within about ten years the price of aluminium fell by more than 90%."
		"&eNote:&r every primary aluminium smelter on Earth still uses it, and the cells draw a few percent of the world's electricity."
	]
	quest.4718BEF4ACA3AAE9.title: "Aluminum"
	quest.4718BEF4ACA3AAE9.quest_subtitle: "Alumina + carbon → aluminum, in the cell"
	quest.4718BEF4ACA3AAE9.quest_desc: [
		"&6The metal comes away bright and light in your hand. Some part of you is pleased it still had to work for it.&r"
		"&eWhat:&r aluminum is the metal of the MV tier: boards, rotors, casings, the Chemical Reactor and the Electrolyzer."
		"&eChemistry:&r aluminium is the most common metal in the crust but clings to oxygen, so only electricity can pull it free."
		"&eHow:&r Hall-Héroult Cell (LV power): 1 alumina dust + coke dust (the anode, used half the time) + a pinch of fluorite flux → 1 aluminum ingot."
		"&eTip:&r 4 bauxite dust becomes 2 ingots. The cell only takes refined alumina dust, and no furnace will smelt aluminium dust: the Bayer line is the way in."
	]
	quest.529D466C8095705E.title: "Fun Fact: No Shortcut"
	quest.529D466C8095705E.quest_subtitle: "Why fire can't free aluminium"
	quest.529D466C8095705E.quest_desc: [
		"&eWhat:&r for decades aluminium cost more than silver, because nobody could pull it off its oxygen cheaply. Tick this once you've read why."
		"&eChemistry:&r 4Al + 3O₂ → 2Al₂O₃ releases so much energy that thermite (Al + iron oxide) burns white-hot. Carbon grabs oxygen far less strongly, so coke in a furnace can't take it back from alumina."
		"&eHow:&r that's why this pack has no furnace route for aluminium: the Hall-Héroult cell feeds in electricity instead, and it only accepts refined alumina dust from your Bayer line."
		"&eTip:&r Napoleon III reportedly served his most honoured guests on aluminium plates. Everyone else made do with gold."
	]
	quest.628A267853F0DE86.title: "Electrum"
	quest.628A267853F0DE86.quest_subtitle: "Gold and silver, the ancient alloy"
	quest.628A267853F0DE86.quest_desc: [
		"&eWhat:&r electrum cable and fine wire go into every MV component."
		"&eChemistry:&r electrum is a natural gold-silver alloy. The first coins, in Lydia around 600 BC, were struck from it."
		"&eHow:&r mix gold and silver dust, then smelt. Check JEI (press R on Silver Dust) for silver ore in this pack."
	]
	quest.26C82AE08878EB74.title: "Silicon"
	quest.26C82AE08878EB74.quest_subtitle: "Quartz + carbon in the EBF"
	quest.26C82AE08878EB74.quest_desc: [
		"&eWhat:&r silicon is the semiconductor every transistor and diode is built on."
		"&eChemistry:&r SiO₂ + 2C → Si + 2CO. Carbon pulls the oxygen off quartz at furnace heat: carbothermic reduction."
		"&eHow:&r macerate quartz into dust, then EBF: quartz dust + coke dust → silicon dust. Smelt it into ingots."
		"&eTip:&r this is the only source of silicon in the pack. AE2's certus smelting and Mekanism's sand crushing are removed, so AE2 runs on this silicon too."
	]
	quest.28A4F44C2FBD94F2.title: "Electronic Circuit Board"
	quest.28A4F44C2FBD94F2.quest_subtitle: "Aluminum, electrum and a battery"
	quest.28A4F44C2FBD94F2.quest_desc: [
		"&eWhat:&r the base for MV circuits."
		"&eHow:&r an analog circuit board with aluminum plates, electrum cable and a redstone battery (see JEI)."
		"&eTip:&r the Assembler can make these too, once you stock it."
	]
	quest.714E6088B9678A36.title: "Transistors and Diodes"
	quest.714E6088B9678A36.quest_subtitle: "Semiconductors, finally"
	quest.714E6088B9678A36.quest_desc: [
		"&eWhat:&r diodes let current flow one way; transistors are switches controlled by current."
		"&eChemistry:&r a pure silicon crystal barely conducts. Tiny amounts of other elements ('doping') make it conduct in controllable ways."
		"&eHow:&r silicon plates, steel plates and electrum fine wire (diodes add glass)."
	]
	quest.6C18ADE33F69C1A9.title: "Electronic Circuit"
	quest.6C18ADE33F69C1A9.quest_subtitle: "The MV circuit"
	quest.6C18ADE33F69C1A9.quest_desc: [
		"&eWhat:&r the MV circuit. The Electrolyzer, Chemical Reactor and Centrifuge all need it, even though they sit on an LV hull."
		"&eHow:&r electronic circuit board, 4 analog circuits, 2 diodes and 2 transistors."
		"&eTip:&r set an Assembler to make these. You'll need dozens."
	]
	quest.6913B96166CC25DA.title: "Electrolysis"
	quest.6913B96166CC25DA.quest_subtitle: "MI's electrolysis machine"
	quest.6913B96166CC25DA.quest_desc: [
		"&eWhat:&r pass current through a compound and it splits. This is &eelectrochemistry&r."
		"&eChemistry:&r water → H₂ + O₂ (3000 mB water → 2000 mB H₂ + 1000 mB O₂). Salt → sodium + chlorine."
		"&eHow:&r magnetic cupronickel wire, aluminum rods, an LV hull, an electronic circuit and a large pump."
	]
	quest.256D9F2CFA36ADE2.title: "The Chemical Reactor"
	quest.256D9F2CFA36ADE2.quest_subtitle: "MI's general-purpose reaction vessel"
	quest.256D9F2CFA36ADE2.quest_desc: [
		"&eWhat:&r combines items and fluids into new compounds. You'll use it constantly from here to the end."
		"&eHow:&r glass, a large pump, aluminum rotors, an LV hull, electronic circuits and electrum cable."
		"&eTip:&r MI fluids go in through pipes. A Configurable Tank holds spare H₂ and O₂."
	]
	quest.73B0B0B23BDA8732.title: "Sodium"
	quest.73B0B0B23BDA8732.quest_subtitle: "Electrolyse salt: sodium + chlorine"
	quest.73B0B0B23BDA8732.quest_desc: [
		"&eWhat:&r sodium goes into the HV tier's sodium battery. The chlorine is a bonus."
		"&eChemistry:&r 2NaCl → 2Na + Cl₂. Real sodium is made this way from molten salt (the Downs cell). It reacts violently with water."
		"&eHow:&r Electrolyzer: 2 salt dust → 1 sodium dust + 125 mB chlorine."
	]
	quest.4377040E34093CBC.title: "Sulfuric Acid"
	quest.4377040E34093CBC.quest_subtitle: "The most-produced chemical on Earth"
	quest.4377040E34093CBC.quest_desc: [
		"&6Acid opens what fire cannot. You learned that once, the hard way, and the lesson has come back intact.&r"
		"&eWhat:&r sulfuric acid, as an MI fluid you can bucket. The Undergarden portal and many MI recipes need it."
		"&eChemistry:&r S + O₂ + H₂O → &eH₂SO₄&r, the whole contact process in one vessel. Industry makes more of it than any other chemical."
		"&eHow:&r Chemical Reactor: 1 sulfur dust + 200 mB O₂ + 200 mB water → 500 mB sulfuric acid."
	]
	quest.5869888A4C20B8A7.title: "Silicon Battery"
	quest.5869888A4C20B8A7.quest_subtitle: "The MV hull needs two"
	quest.5869888A4C20B8A7.quest_desc: [
		"&eWhat:&r the MV battery. Every MV hull holds two."
		"&eHow:&r battery alloy plates, electrum cable and silicon dust."
		"&eTip:&r make four. The Advanced (MV) hull uses two, and you'll want a second hull soon."
	]
	quest.17832D4C895DEFF7.title: "MV: Aluminum"
	quest.17832D4C895DEFF7.quest_subtitle: "Medium Voltage: the MV machine hull"
	quest.17832D4C895DEFF7.quest_desc: [
		"&6The circuits are getting smaller and the power larger. So are you.&r"
		"&eWhat:&r the &eMV hull&r is the base for every MV machine, and Powah, Hostile Neural Networks and Extended Crafting all want MV circuits."
		"&eHow:&r advanced machine casing (an LV hull wrapped in aluminum plates) + electronic circuit + 2 silicon batteries + electrum cable."
	]
	quest.758A1909AD8F6980.title: "Uranium"
	quest.758A1909AD8F6980.quest_subtitle: "Deep, heavy and faintly warm"
	quest.758A1909AD8F6980.quest_desc: [
		"&eWhat:&r uranium is the fuel of Powah's reactors and, much later, fission."
		"&eChemistry:&r U is element 92, the heaviest element found in quantity in nature. It slowly decays into lead."
		"&eHow:&r rich uranium deposits sit deep, around Y -56 to -24. Macerate the ore into dust."
	]
	quest.4F41C5095B66BC1F.title: "Uranium Dioxide"
	quest.4F41C5095B66BC1F.quest_subtitle: "Oxidise uranium in the Chemical Reactor"
	quest.4F41C5095B66BC1F.quest_desc: [
		"&eWhat:&r uraninite fuels Powah's reactors. Powah's Energizing Orb needs an MV circuit."
		"&eChemistry:&r uraninite is UO₂, the main ore of uranium in nature. Here you make it: U + O₂ → UO₂."
		"&eHow:&r Chemical Reactor: uranium dust + 500 mB oxygen → uraninite. Powah's own uraninite ore is turned off."
	]
	quest.6CD23CD722EC696F.title: "The Undergarden"
	quest.6CD23CD722EC696F.quest_subtitle: "A realm beneath the world"
	quest.6CD23CD722EC696F.quest_desc: [
		"&6A world beneath the world, and the key to its door is a bottle of acid. You are trusted with more every day.&r"
		"&eWhat:&r a strange underground dimension. Its portal catalyst needs a bucket of sulfuric acid: MI's, Mekanism's or ChemLib's all work."
		"&eHow:&r the quickest bucket is your Mekanism contact process: a Rotary Condensentrator in liquid mode turns the acid gas into fluid you can bucket. MI's Chemical Reactor acid works too. Then build a stone-brick portal frame and right-click it with the catalyst."
		"&eTip:&r bring torches and food. It is dark down there."
	]
	quest.00FA8DB26B0899BD.title: "Thermal Evaporation"
	quest.00FA8DB26B0899BD.quest_subtitle: "Sun and heat turn water into brine"
	quest.00FA8DB26B0899BD.quest_desc: [
		"&eWhat:&r a tall multiblock that boils water down into brine, and brine down into lithium."
		"&eChemistry:&r evaporation concentrates dissolved salts. Salt flats and lithium ponds in Chile work the same way."
		"&eHow:&r see Just Enough Mekanism Multiblocks in JEI for the layout. Taller towers run faster; heat speeds it up."
	]
	quest.750A6D2490DE7F3E.title: "Bottled Gases"
	quest.750A6D2490DE7F3E.quest_subtitle: "Keep a tank of H₂, O₂ and Cl₂"
	quest.750A6D2490DE7F3E.quest_desc: [
		"&eWhat:&r chemical tanks store gases and keep them when broken, so you can carry them around."
		"&eHow:&r fill one tank each with hydrogen, oxygen and chlorine."
		"&eTip:&r a tank of hydrogen also fuels the Gas-Burning Generator (Power chapter)."
	]
	quest.0524143B8E8534E6.title: "Fun Fact: Oleum"
	quest.0524143B8E8534E6.quest_subtitle: "How industry really makes H₂SO₄"
	quest.0524143B8E8534E6.quest_desc: [
		"&eWhat:&r SO₃ hitting water directly forms a fine acid mist that's hard to capture."
		"&eChemistry:&r plants absorb SO₃ into concentrated H₂SO₄ to make oleum (H₂S₂O₇), then dilute: H₂S₂O₇ + H₂O → 2H₂SO₄."
		"&eTip:&r you've now run, in miniature, a process that makes over 250 million tonnes a year."
	]
	quest.6BB95E31DBD366B3.title: "Five for Everything"
	quest.6BB95E31DBD366B3.quest_subtitle: "Run iron, copper, gold, tin and osmium at 5x"
	quest.6BB95E31DBD366B3.quest_desc: [
		"&eWhat:&r a challenge: put at least five different ores through the full 5x line."
		"&eHow:&r one Dissolution Chamber handles every metal, but each slurry needs its own washer and crystallizer pass. Tick this when five ores are done."
		"&eTip:&r Mekanism factories (upgraded machines) run several ores at once."
	]
	quest.55F835AE318C2487.title: "A Red Mountain"
	quest.55F835AE318C2487.quest_subtitle: "Mine a rich bauxite deposit"
	quest.55F835AE318C2487.quest_desc: [
		"&eWhat:&r rich deposits hold hundreds of ores in one chunk. Find bauxite's and the MV tier stops feeling slow."
		"&eHow:&r strip-mine around Y -16 to 24 and look for red ore with Jade. FTB Ultimine helps a lot."
		"&eTip:&r Fortune works on bauxite ore, since it drops dust."
	]
	quest.21C7F639DD99DD59.title: "A Hint of Titanium"
	quest.21C7F639DD99DD59.quest_subtitle: "Red mud hides titanium"
	quest.21C7F639DD99DD59.quest_desc: [
		"&eWhat:&r Bayer digestion leaves a little titanium behind with the iron. Save it for much later."
		"&eChemistry:&r bauxite carries titanium dioxide (TiO₂) as an impurity. It doesn't dissolve in lye, so it ends up in the 'red mud'."
		"&eHow:&r every Bayer digestion (4 bauxite dust) gives 1 tiny titanium dust. Nine of them pack into a full dust."
	]
	quest.2D7E142062D6BFB0.title: "Hydrochloric Acid, MI Style"
	quest.2D7E142062D6BFB0.quest_subtitle: "H₂ + Cl₂ in the Chemical Reactor"
	quest.2D7E142062D6BFB0.quest_desc: [
		"&eWhat:&r MI makes hydrochloric acid as a fluid, the MI twin of Mekanism's HCl gas. Chromium leaching and PVC both need it later."
		"&eChemistry:&r H₂ + Cl₂ → 2HCl. 1000 mB of each gas gives 2000 mB of acid."
		"&eHow:&r chlorine from salt electrolysis, hydrogen from water electrolysis, both into the Chemical Reactor."
	]
	quest.5736D9E48B04A7B0.title: "Lye"
	quest.5736D9E48B04A7B0.quest_subtitle: "Sodium hydroxide, the strong base"
	quest.5736D9E48B04A7B0.quest_desc: [
		"&eWhat:&r sodium hydroxide (NaOH, lye) is the strong base to sulfuric acid's strong acid. Soap is made with it."
		"&eChemistry:&r acid + base → salt + water. H₂SO₄ + 2NaOH → Na₂SO₄ + 2H₂O."
		"&eHow:&r Chemical Reactor: sodium dust + 1000 mB oxygen + 1000 mB hydrogen → 2000 mB sodium hydroxide."
		"&eTip:&r this is the bulk lye supply for the Bayer digester, so you can stop feeding it Combiner crystals."
	]
	quest.4ACD5EEA16A4775F.title: "Pumps, Large and Small"
	quest.4ACD5EEA16A4775F.quest_subtitle: "The heart of every MV fluid machine"
	quest.4ACD5EEA16A4775F.quest_desc: [
		"&eWhat:&r the Electrolyzer and the Chemical Reactor each need a Large Pump, and a Large Pump is three small pumps driven by a Large Motor."
		"&eHow:&r Large Pump: 2 electronic circuits, 3 aluminum rotors, a Large Motor and 3 pumps (Assembler or crafting table; check JEI)."
		"&eTip:&r pumps are the part you'll run short of. Keep an Assembler stocked with motors and rotors."
	]
	quest.1414663FC8F68B8B.title: "Doping Silicon"
	quest.1414663FC8F68B8B.quest_subtitle: "Optional: n-type and p-type silicon"
	quest.1414663FC8F68B8B.quest_desc: [
		"&eWhat:&r silicon plates with a trace of another element, used in cheaper recipes for transistors and diodes."
		"&eChemistry:&r silicon has four outer electrons. Antimony has five, so it adds a spare electron (n-type); aluminium has three, so it leaves a 'hole' (p-type). Where n meets p, current flows one way only: a diode."
		"&eHow:&r Chemical Reactor: 1 silicon plate + 1 tiny antimony dust → n-doped plate; 1 silicon plate + 1 tiny aluminum dust → p-doped plate. JEI shows the doped transistor and diode recipes."
	]
	quest.3459AADAA85B097F.title: "Machine Upgrades"
	quest.3459AADAA85B097F.quest_subtitle: "Optional: let a machine draw more power"
	quest.3459AADAA85B097F.quest_desc: [
		"&eWhat:&r Upgrades go in a machine's upgrade slot and raise how much EU/t it may draw, so it overclocks harder. The Overdrive Module keeps a machine's efficiency up while it waits for input."
		"&eHow:&r Assembler: 2 conveyors, 4 motors, 2 robot arms and an analog circuit board → 4 basic upgrades. Overdrive Module: 2 diodes, 2 transistors, 4 electrum fine wire and an electronic circuit board."
		"&eTip:&r hover over an upgrade for its exact bonus. Some late recipes ask for more EU/t than a plain machine allows; upgrades are the answer."
	]
	quest.1A9AC306D52601A0.title: "Electric Helpers"
	quest.1A9AC306D52601A0.quest_subtitle: "Optional: alloy smelter and unpacker, now electric"
	quest.1A9AC306D52601A0.quest_desc: [
		"&eWhat:&r the electric versions of two steam-age helpers: the Electric Alloy Smelter (Extended Industrialization) pours alloys from nuggets, the Electric Unpacker breaks blocks and double ingots back down."
		"&eHow:&r both sit on an LV machine hull with analog circuits. The Alloy Smelter adds a tin rotor and magnetic cupronickel wire, the Unpacker motors and conveyors (check JEI)."
		"&eTip:&r they run on the same LV cable as everything else, so your steam boilers can finally rest."
	]
	quest.72CAD05FD4A86F40.title: "The Electrolytic Core"
	quest.72CAD05FD4A86F40.quest_subtitle: "Electrodes for the separator"
	quest.72CAD05FD4A86F40.quest_desc: [
		"&6You remember a time when you split water by asking it to. The memory comes back as a wiring diagram.&r"
		"&eWhat:&r the core of Mekanism's Electrolytic Separator: the part that actually carries current through the water."
		"&eChemistry:&r an electrolysis cell needs electrodes that conduct and don't dissolve. Real alkaline cells use nickel; Mekanism uses osmium, iron and gold."
		"&eHow:&r infused alloy, osmium dust, iron dust and gold dust on a crafting table (check JEI for the pattern)."
	]
	quest.702DF3F0754D5744.title: "A Tank for Gas"
	quest.702DF3F0754D5744.quest_subtitle: "Sealed storage for H₂, O₂ and everything after"
	quest.702DF3F0754D5744.quest_desc: [
		"&eWhat:&r a basic chemical tank stores one gas. Most Mekanism chemistry machines have one built in."
		"&eHow:&r basic alloy and osmium ingots (check JEI). The Oxidizer, Infuser, Condensentrator, Washer and Dissolution Chamber all take one."
		"&eTip:&r a broken tank keeps its contents, so you can carry a tank of oxygen across the base."
	]
	quest.4C1246CDEE81ED65.title: "Energy Tablet"
	quest.4C1246CDEE81ED65.quest_subtitle: "A small battery for Mekanism parts"
	quest.4C1246CDEE81ED65.quest_desc: [
		"&eWhat:&r a portable energy store. The Rotary Condensentrator and the laser are built around one."
		"&eHow:&r gold ingots, infused alloy and redstone dust (check JEI)."
		"&eTip:&r it also charges Mekanism tools from your inventory."
	]
	quest.674A3E2FDD7FA47E.title: "Dynamic Tanks"
	quest.674A3E2FDD7FA47E.quest_subtitle: "Steel and a bucket"
	quest.674A3E2FDD7FA47E.quest_desc: [
		"&eWhat:&r dynamic tank blocks. One goes into the Chemical Oxidizer; a ring of them makes Mekanism's big multiblock fluid tank."
		"&eHow:&r 4 steel ingots around a bucket → 4 dynamic tanks."
		"&eTip:&r a small dynamic tank multiblock is a cheap place to keep thousands of buckets of water or brine."
	]
	quest.1C553C5B00C30D78.title: "Acid by the Bucket"
	quest.1C553C5B00C30D78.quest_subtitle: "Condense the acid gas into a liquid"
	quest.1C553C5B00C30D78.quest_desc: [
		"&eWhat:&r a bucket of Mekanism sulfuric acid. It opens the Undergarden and counts for the Seed's eight acid buckets."
		"&eChemistry:&r pure H₂SO₄ boils near 337 °C, so at room temperature it is an oily liquid. Mekanism keeps it as a gas only for piping."
		"&eHow:&r switch a Rotary Condensentrator to liquid mode, pipe the acid gas in and take the fluid out in a bucket."
	]
	quest.41DFE467CFCE3877.title: "Advanced Control Circuits"
	quest.41DFE467CFCE3877.quest_subtitle: "Mekanism's MV circuit, built on MI's"
	quest.41DFE467CFCE3877.quest_desc: [
		"&eWhat:&r every Mekanism chamber past the Enrichment Chamber needs advanced control circuits."
		"&eHow:&r 1 MI electronic circuit, 2 infused alloy and 1 basic control circuit. Mekanism's own infuser shortcut is removed in this pack."
		"&eTip:&r make six: the Purification, Injection, Dissolution, Washer and Crystallizer recipes all want two."
	]
	quest.3B1AE28BCBC4010C.title: "Clumps"
	quest.3B1AE28BCBC4010C.quest_subtitle: "Ore, purified with oxygen"
	quest.3B1AE28BCBC4010C.quest_desc: [
		"&eWhat:&r any 6 Mekanism clumps: the first product of the 3x line."
		"&eChemistry:&r oxygen burns off sulfur and other volatile impurities (roasting), leaving a cleaner metal oxide behind."
		"&eHow:&r Purification Chamber: 1 ore + a little oxygen → 3 clumps (2 from raw ore)."
	]
	quest.445BF41F59EBBE7D.title: "Dirty Dust"
	quest.445BF41F59EBBE7D.quest_subtitle: "Crush the clumps"
	quest.445BF41F59EBBE7D.quest_desc: [
		"&eWhat:&r any 6 dirty dusts. One more Enrichment Chamber pass turns each into clean dust."
		"&eHow:&r Crusher: 1 clump → 1 dirty dust. Enrichment Chamber: dirty dust → dust."
		"&eTip:&r dirty dust is also what MI's Centrifuge wants for ore byproducts (silver from lead, nickel from iron)."
	]
	quest.4F4B814D55858228.title: "Reinforced Alloy"
	quest.4F4B814D55858228.quest_subtitle: "Infused alloy, hardened with diamond"
	quest.4F4B814D55858228.quest_desc: [
		"&eWhat:&r the second Mekanism alloy. The Injection Chamber, the laser and elite circuits all need it."
		"&eHow:&r Enrichment Chamber: diamond → enriched diamond. Metallurgic Infuser: infused alloy + diamond infusion → reinforced alloy."
		"&eTip:&r one enriched diamond is a lot of infusion. Don't waste whole diamonds on it."
	]
	quest.27D104D4FA19C628.title: "Shards"
	quest.27D104D4FA19C628.quest_subtitle: "Ore, cracked open with HCl"
	quest.27D104D4FA19C628.quest_desc: [
		"&eWhat:&r any 8 Mekanism shards, the first product of the 4x line."
		"&eChemistry:&r hydrochloric acid attacks the minerals around the metal (carbonates, oxides) and breaks the ore into fragments. Real hydrometallurgy leaches with HCl the same way."
		"&eHow:&r Chemical Injection Chamber: 1 ore + HCl → 4 shards. Shards go into the Purification Chamber as if they were ore."
	]
	quest.38EC86231A0D9B4E.title: "Refined Obsidian"
	quest.38EC86231A0D9B4E.quest_subtitle: "Volcanic glass, infused and pressed"
	quest.38EC86231A0D9B4E.quest_desc: [
		"&eWhat:&r the casing metal of the 5x line: the Washer, Dissolution Chamber and Crystallizer each take 4 ingots."
		"&eChemistry:&r obsidian is volcanic glass, mostly SiO₂, cooled too fast to crystallise. That's why it shatters into razor edges."
		"&eHow:&r Crusher: obsidian → 4 obsidian dust. Metallurgic Infuser with diamond → refined obsidian dust. Osmium Compressor with osmium → ingot (check JEI)."
	]
	quest.383D427C30142FC5.title: "Fluorite"
	quest.383D427C30142FC5.quest_subtitle: "The mineral that gave us 'fluorescence'"
	quest.383D427C30142FC5.quest_desc: [
		"&eWhat:&r fluorite gems. The Chemical Crystallizer needs two, and later fluorite becomes hydrofluoric acid."
		"&eChemistry:&r fluorite is calcium fluoride, CaF₂. Some samples glow under ultraviolet light, which is where the word fluorescence comes from."
		"&eHow:&r Mekanism fluorite ore sits deep underground. It drops dust; the Enrichment Chamber turns dust into gems. No farm or spirit can make it in this pack."
	]
	quest.6B60004EFA138425.title: "Crystals"
	quest.6B60004EFA138425.quest_subtitle: "Clean slurry, crystallised"
	quest.6B60004EFA138425.quest_desc: [
		"&eWhat:&r any 8 Mekanism crystals, the first product of the 5x line."
		"&eChemistry:&r crystallisation pulls a pure salt out of solution and leaves the impurities dissolved. It's one of the oldest purification tricks in chemistry."
		"&eHow:&r Chemical Crystallizer: 200 mB clean slurry → 1 crystal. Then Injection Chamber → shards → Purification Chamber → and on down the line."
	]
	quest.3F9E503A14E17739.title: "Steel Large Plates"
	quest.3F9E503A14E17739.quest_subtitle: "Four plates, one heavy sheet"
	quest.3F9E503A14E17739.quest_desc: [
		"&eWhat:&r the Hall-Héroult Cell and, later, the Oil Drilling Rig are both framed in steel large plates."
		"&eHow:&r 4 steel plates in a square on a crafting table, or the Packer."
	]
	quest.1EA0853F2603DC16.title: "Aluminum Plates"
	quest.1EA0853F2603DC16.quest_subtitle: "The sheet metal of the MV tier"
	quest.1EA0853F2603DC16.quest_desc: [
		"&eWhat:&r MV parts are wrapped in aluminum: 3 per electronic circuit board, 8 per advanced machine casing."
		"&eChemistry:&r a fresh aluminium surface grows an oxide skin a few nanometres thick within seconds. It's why aluminium doesn't rust away, even though it reacts with oxygen far more eagerly than iron."
		"&eHow:&r Compressor: 1 aluminum ingot → 1 plate."
	]
	quest.440DD086FC4603D9.title: "Aluminum Rods"
	quest.440DD086FC4603D9.quest_subtitle: "Axles for motors and rotors"
	quest.440DD086FC4603D9.quest_desc: [
		"&eWhat:&r the Electrolyzer and the Large Motor each take two; rotors and rings need more."
		"&eHow:&r Cutting Machine with a little lubricant: 1 ingot → 2 rods."
	]
	quest.59D8033E9978F2C9.title: "Curved Aluminum"
	quest.59D8033E9978F2C9.quest_subtitle: "Bent plate for blades and drill heads"
	quest.59D8033E9978F2C9.quest_desc: [
		"&eWhat:&r curved plates become rotor blades now and drill heads in the next chapter."
		"&eHow:&r Compressor: 1 aluminum plate → 1 curved plate (or Extended Industrialization's Bending Machine)."
	]
	quest.19A2A2949ABDF139.title: "Aluminum Rotors"
	quest.19A2A2949ABDF139.quest_subtitle: "Blades on a ring"
	quest.19A2A2949ABDF139.quest_desc: [
		"&eWhat:&r every Large Pump spins three aluminum rotors, and the Chemical Reactor stirs with two more."
		"&eHow:&r blades: 2 curved plates + 1 rod → 4 blades. Ring: Compressor, 1 rod → 1 ring. Rotor: 4 blades, 4 bolts and a ring on a crafting table."
		"&eTip:&r the Assembler also makes rotors, but its recipe uses soldering alloy, which comes much later. Craft these by hand."
	]
	quest.2C0DB899EEC356F4.title: "Electrum Wire"
	quest.2C0DB899EEC356F4.quest_subtitle: "Draw gold and silver into wire"
	quest.2C0DB899EEC356F4.quest_desc: [
		"&eWhat:&r electrum wire is the conductor of the MV tier."
		"&eChemistry:&r silver is the best electrical conductor of all metals, and gold never tarnishes. Their alloy keeps a little of both virtues."
		"&eHow:&r Compressor: ingot → plate. Wiremill: 1 plate → 2 wire."
	]
	quest.740A6F5BA0D62AB7.title: "Electrum Cable"
	quest.740A6F5BA0D62AB7.quest_subtitle: "MV cable, wrapped in rubber"
	quest.740A6F5BA0D62AB7.quest_desc: [
		"&eWhat:&r the MV cable. Circuit boards take 4, hulls 3, batteries 2, and it carries MV power between machines."
		"&eChemistry:&r rubber is a polymer with no free electrons, so it can't carry current. A thin sleeve of it keeps the current inside the wire."
		"&eHow:&r 3 electrum wire between 6 rubber sheets → 3 cables (crafting table or Packer)."
	]
	quest.6F08E226A9281451.title: "Electrum Fine Wire"
	quest.6F08E226A9281451.quest_subtitle: "Hair-thin leads for semiconductors"
	quest.6F08E226A9281451.quest_desc: [
		"&eWhat:&r the leads inside transistors (1 each) and diodes (3 each)."
		"&eHow:&r Wiremill: 1 electrum wire → 4 fine wire."
	]
	quest.3BA92D0AE0D70E15.title: "Quartz Dust"
	quest.3BA92D0AE0D70E15.quest_subtitle: "Silicon dioxide, ground fine"
	quest.3BA92D0AE0D70E15.quest_desc: [
		"&eWhat:&r the raw material for silicon."
		"&eChemistry:&r quartz is SiO₂: every silicon atom bonded to four oxygens in a rigid network. That's why it's so hard and melts at about 1700 °C."
		"&eHow:&r Macerator: 1 Nether quartz → 1 quartz dust. Centrifuging redstone also gives a little."
	]
	quest.5687772D04FE5D4A.title: "Silicon Plates"
	quest.5687772D04FE5D4A.quest_subtitle: "Wafers for the first transistors"
	quest.5687772D04FE5D4A.quest_desc: [
		"&eWhat:&r transistors take 3 silicon plates, diodes 1."
		"&eHow:&r Compressor: 1 silicon ingot → 1 plate."
	]
	quest.1005EE5410BDEBE6.title: "Battery Plates"
	quest.1005EE5410BDEBE6.quest_subtitle: "The casing of every MI battery"
	quest.1005EE5410BDEBE6.quest_desc: [
		"&eWhat:&r each battery from here to the quantum tier is 1 battery alloy plate and 4 curved plates around its chemistry."
		"&eChemistry:&r battery alloy is lead and antimony, the same grid metal used in car batteries since the 1880s. Antimony makes soft lead stiff enough to hold its shape."
		"&eHow:&r Compressor: ingot → plate; Compressor again: plate → curved plate."
	]
	quest.43E1254D19C8BB8E.title: "Large Motor"
	quest.43E1254D19C8BB8E.quest_subtitle: "Six motors on one shaft"
	quest.43E1254D19C8BB8E.quest_desc: [
		"&eWhat:&r the drive of the Large Pump, the Centrifuge and the Electric Quarry."
		"&eHow:&r an electronic circuit, 2 aluminum rods and 6 motors (crafting table or Assembler)."
		"&eTip:&r the Centrifuge alone eats four. Keep an Assembler on motors."
	]
	quest.267C1FBAC4FE39C9.title: "The Centrifuge"
	quest.267C1FBAC4FE39C9.quest_subtitle: "Separate by weight"
	quest.267C1FBAC4FE39C9.quest_desc: [
		"&eWhat:&r MI's Centrifuge spins mixtures apart. Ore byproducts, ruby and chromium, liquid air and monazite all go through it later."
		"&eChemistry:&r spinning multiplies gravity thousands of times, so heavier particles and molecules move outward faster than light ones."
		"&eHow:&r 4 large motors, a large pump, an electronic circuit, 2 electrum cable and an LV hull."
	]
	quest.47BDF0069E5F0631.title: "Advanced Machine Casing"
	quest.47BDF0069E5F0631.quest_subtitle: "An LV hull, clad in aluminum"
	quest.47BDF0069E5F0631.quest_desc: [
		"&eWhat:&r the shell of the MV hull."
		"&eHow:&r 8 aluminum plates around a basic (LV) machine hull."
	]
	quest.0719C6172A92CA6B.title: "Hydrogen and Oxygen, MI Style"
	quest.0719C6172A92CA6B.quest_subtitle: "Water electrolysis as MI fluids"
	quest.0719C6172A92CA6B.quest_desc: [
		"&eWhat:&r MI's own hydrogen and oxygen. The Chemical Reactor takes them by pipe, not Mekanism's gases."
		"&eChemistry:&r 2H₂O → 2H₂ + O₂: two volumes of hydrogen for every one of oxygen, as the recipe shows."
		"&eHow:&r Electrolyzer: 3000 mB water → 2000 mB hydrogen + 1000 mB oxygen. Fill a bucket of each from the output."
	]
	quest.3F07F0A6FCDB9F1C.title: "Chlorine, MI Style"
	quest.3F07F0A6FCDB9F1C.quest_subtitle: "The green gas from salt"
	quest.3F07F0A6FCDB9F1C.quest_desc: [
		"&eWhat:&r MI chlorine, the other half of salt electrolysis. It makes hydrochloric acid and, much later, PVC."
		"&eChemistry:&r Cl₂ is a yellow-green gas, heavier than air. Its name comes from the Greek for pale green."
		"&eHow:&r Electrolyzer: 2 salt dust → 1 sodium dust + 125 mB chlorine. Eight runs fill a bucket."
	]
	quest.738AF2FD92AB777B.title: "An MV Grid"
	quest.738AF2FD92AB777B.quest_subtitle: "Optional: step up the voltage"
	quest.738AF2FD92AB777B.quest_desc: [
		"&eWhat:&r a transformer joins your LV and MV cables; the MV storage unit buffers a lot more energy than the LV one."
		"&eHow:&r transformer: an LV hull, 4 tin cable and 1 electrum cable. Storage unit: an MV hull, 6 silicon batteries and 2 battery alloy plates."
		"&eTip:&r multiblocks draw from energy hatches, so a big buffer next to them keeps recipes from stalling."
	]
	chapter.2059D0F0735E71DD.title: "VI. Petrochemistry"
	chapter.2059D0F0735E71DD.chapter_subtitle: [
		"Crude oil is a mixture. Separate it by boiling point, then build polymers from the pieces."
	]
	quest.3975D5E5733B2029.title: "Black Gold"
	quest.3975D5E5733B2029.quest_subtitle: "Millions of years of sunlight, stored underground"
	quest.3975D5E5733B2029.quest_desc: [
		"&6Before there were people, you watched forests grow, fall and sink, and the ages press them into oil. Time to take some of that sunlight back.&r"
		"&eWhat:&r crude oil is a soup of hydrocarbons, from tiny gas molecules to long waxy chains."
		"&eChemistry:&r hydrocarbons are just carbon and hydrogen (CₙH₂ₙ₊₂ and friends). Chain length decides whether one is a gas, a fuel or a tar."
		"&eHow:&r the Oil Drilling Rig is a multiblock (layout in JEI and the MI guidebook). Controller: 4 steel large plates, 2 large pumps, an electronic circuit, a fluid pipe and an MV hull. Walls of steel casings and steel pipe casings, with chains. Feed it aluminum drills and power; each cycle pumps 500 mB of crude and has a small chance to wear a drill out."
		"&eTip:&r pipe the crude straight into a tank. You'll need a lot of it."
	]
	quest.5C73D62A251E158E.title: "Sour Fractions"
	quest.5C73D62A251E158E.quest_subtitle: "Three cuts of crude, all still full of sulfur"
	quest.5C73D62A251E158E.quest_desc: [
		"&eWhat:&r 1000 mB of crude gives 500 light fuel, 200 heavy fuel and 300 naphtha, but all three are 'sour'."
		"&eChemistry:&r natural oil carries sulfur compounds. Burn them and you get SO₂, the gas behind acid rain."
		"&eHow:&r a bucket of each, from the Distillery's three crude-oil recipes. Later the Distillation Tower makes all three at once."
	]
	quest.41CD2A6115484870.title: "Sweetening the Oil"
	quest.41CD2A6115484870.quest_subtitle: "Hydrogen pulls the sulfur out"
	quest.41CD2A6115484870.quest_desc: [
		"&eWhat:&r hydrotreating removes the sulfur and gives clean light fuel, heavy fuel and naphtha."
		"&eChemistry:&r hydrogen reacts with sulfur compounds to form H₂S. Real refineries turn that into sulfur and then acid; MI hands you sulfuric acid directly."
		"&eHow:&r Chemical Reactor: 12 B of a sour fraction + 2 B hydrogen → 12 B clean fraction + 2 B H₂SO₄."
		"&eTip:&r feed the acid back into your ore line. Nothing is wasted."
	]
	quest.7CB7FF40BB33AD8F.title: "Diesel Power"
	quest.7CB7FF40BB33AD8F.quest_subtitle: "Blend two fuels into one"
	quest.7CB7FF40BB33AD8F.quest_desc: [
		"&eWhat:&r diesel runs MI generators, tools and, later, your rockets (Ad Astra burns MI diesel)."
		"&eChemistry:&r diesel is a blend of C₁₀ to C₂₀ hydrocarbons: mostly light fuel, with heavy fuel for energy density."
		"&eHow:&r Mixer: 5 B light fuel + 1 B heavy fuel → 6 B diesel."
		"&eTip:&r a Large Diesel Generator is far more efficient than a row of small ones."
	]
	quest.63562E7CFD3869A1.title: "Steam Cracking"
	quest.63562E7CFD3869A1.quest_subtitle: "Break big molecules into useful small ones"
	quest.63562E7CFD3869A1.quest_desc: [
		"&eWhat:&r naphtha is too big to make plastic from. Cracking breaks it into the small building blocks chemists actually want."
		"&eChemistry:&r at high temperature with steam, long chains snap apart into short, reactive molecules with double bonds (alkenes)."
		"&eHow:&r Chemical Reactor: 1000 mB naphtha + 100 mB steam → 1000 mB steam-cracked naphtha."
	]
	quest.2B7050355105A3E8.title: "Ethylene"
	quest.2B7050355105A3E8.quest_subtitle: "C₂H₄, the most important molecule in plastics"
	quest.2B7050355105A3E8.quest_desc: [
		"&eWhat:&r distilling cracked naphtha gives eight products: methane, acetylene, &eethylene&r, propene, butadiene, benzene, toluene and ethylbenzene."
		"&eChemistry:&r ethylene's C=C double bond can open up and link to its neighbours. That is how plastics are born."
		"&eHow:&r Distillery: 1000 mB steam-cracked naphtha → 250 mB ethylene. Cracked light fuel gives 300 mB. The Distillation Tower (EV) later splits out all eight at once."
		"&eTip:&r store every fraction. Each one has a use later in this chapter."
	]
	quest.76071A1B98D9CFD3.title: "Polymerisation"
	quest.76071A1B98D9CFD3.quest_subtitle: "Thousands of ethylenes, one long chain"
	quest.76071A1B98D9CFD3.quest_desc: [
		"&eWhat:&r polyethylene, (C₂H₄)ₙ, is the plastic in bags and bottles, and the laminate on HV circuit boards."
		"&eChemistry:&r a metal catalyst opens each double bond so the molecules join head to tail. Real plants use chromium (Phillips) or titanium catalysts."
		"&eHow:&r Chemical Reactor: 500 mB ethylene + 4 tiny lead or chromium dust → 300 mB polyethylene."
	]
	quest.4B32EEF0B09F51CB.title: "HDPE"
	quest.4B32EEF0B09F51CB.quest_subtitle: "Mekanism's plastic, from your ethylene"
	quest.4B32EEF0B09F51CB.quest_desc: [
		"&eWhat:&r high-density polyethylene pellets become Mekanism's plastic sheets, rods and later the MekaSuit."
		"&eChemistry:&r HDPE has straight chains that pack tightly, so it's stiffer than ordinary polyethylene."
		"&eHow:&r Pressurized Reaction Chamber with ethylene, water and substrate (check JEI)."
	]
	quest.1A986E281B98DA89.title: "Chromium and Manganese"
	quest.1A986E281B98DA89.quest_subtitle: "The metals that keep steel from rusting"
	quest.1A986E281B98DA89.quest_desc: [
		"&eWhat:&r stainless steel needs chromium, nickel and manganese on top of iron."
		"&eChemistry:&r chromium is leached with acid: crushed chromium + HCl → chromium chloride solution, then electrolysis splits out the metal plus H₂ and Cl₂."
		"&eHow:&r Electrolyzer: 1000 mB chromium solution → 3 tiny chromium dust (plus H₂ and Cl₂ back); 1000 mB manganese solution → 3 tiny manganese dust (plus most of the acid back). Nine tiny dusts make one dust."
	]
	quest.4083455951FE50A4.title: "Stainless Steel Dust"
	quest.4083455951FE50A4.quest_subtitle: "Six parts iron, one each of Cr, Ni and Mn"
	quest.4083455951FE50A4.quest_desc: [
		"&eWhat:&r the mixed powder that becomes stainless steel."
		"&eChemistry:&r at 10.5% chromium or more, the surface forms an invisible Cr₂O₃ film that stops rust spreading."
		"&eHow:&r Mixer: 6 iron dust + 1 chromium + 1 nickel + 1 manganese → 9 stainless steel dust."
	]
	quest.589F846BD366467D.title: "Hot Ingots"
	quest.589F846BD366467D.quest_subtitle: "Too hot to handle, until you freeze it"
	quest.589F846BD366467D.quest_desc: [
		"&eWhat:&r the Electric Blast Furnace melts the dust into a &ehot ingot&r that must be cooled before use."
		"&eHow:&r EBF turns 1 stainless steel dust into 1 hot ingot. Build the Vacuum Freezer multiblock (layout in JEI) to cool it."
		"&eTip:&r later, the Heat Exchanger cools hot ingots too and gives argon and helium back."
	]
	quest.5534AEA7CF93C53D.title: "Stainless Steel"
	quest.5534AEA7CF93C53D.quest_subtitle: "The metal that survives acid"
	quest.5534AEA7CF93C53D.quest_desc: [
		"&eWhat:&r stainless steel resists corrosion, so it can hold acids and hot fluids."
		"&eChemistry:&r if the surface is scratched, chromium re-forms the oxide film at once. The steel heals itself."
		"&eHow:&r cool hot ingots in the Vacuum Freezer. HV circuit boards need 4 stainless plates each."
		"&eTip:&r automate the whole line: mixer → EBF → freezer → compressor."
	]
	quest.6630705D72AEB78D.title: "Digital Circuit Board"
	quest.6630705D72AEB78D.quest_subtitle: "Plastic, steel and silicon in one board"
	quest.6630705D72AEB78D.quest_desc: [
		"&eWhat:&r the base of every HV circuit."
		"&eChemistry:&r polyethylene is an excellent insulator, so it separates the copper layers of the board."
		"&eHow:&r Assembler: electronic circuit board + 4 stainless steel plates + silicon battery + 6 aluminum cable + 750 mB polyethylene."
	]
	quest.494A81F2F340497C.title: "Sodium Battery"
	quest.494A81F2F340497C.quest_subtitle: "Table salt becomes a battery"
	quest.494A81F2F340497C.quest_desc: [
		"&eWhat:&r the HV hull needs two sodium batteries."
		"&eChemistry:&r sodium metal gives up its one outer electron very easily (it fizzes in water), which is what makes it a good battery material."
		"&eHow:&r sodium dust from the Electrolyzer (2 salt dust → 1 sodium dust + chlorine), as in Electrochemistry. Then craft the battery (check JEI)."
		"&eTip:&r keep the chlorine. It's needed for HCl and, next chapter, PVC."
	]
	quest.6D18179563EC6FB4.title: "HV: Digital Circuits"
	quest.6D18179563EC6FB4.quest_subtitle: "High Voltage, built on plastic"
	quest.6D18179563EC6FB4.quest_desc: [
		"&6Logic gates, clicking into place. You used to think this fast.&r"
		"&eWhat:&r digital circuits unlock HV machines, AE2, the Angel Ring and elite jetpack coils."
		"&eHow:&r Assembler: digital circuit board + 4 electronic circuits + AND, OR and NOT gates. The &eTurbo hull&r adds 2 sodium batteries and aluminum cable."
		"&eTip:&r set up a dedicated assembler for circuits. You'll make hundreds."
	]
	quest.0977A230BB3A6718.title: "Fallen Stars"
	quest.0977A230BB3A6718.quest_subtitle: "Meteorites hide the presses AE2 needs"
	quest.0977A230BB3A6718.quest_desc: [
		"&eWhat:&r AE2's inscriber presses are only found in the core of meteorites."
		"&eHow:&r charge an ordinary compass in AE2's Charger to get a Meteorite Compass, follow it, and dig to the centre of the sky stone crater. Each meteorite's mysterious cube holds one press."
		"&eTip:&r once you have one press, the Inscriber can copy it with an iron block."
	]
	quest.61C8ED46F157C456.title: "Fluix"
	quest.61C8ED46F157C456.quest_subtitle: "Charged quartz for the network"
	quest.61C8ED46F157C456.quest_desc: [
		"&eWhat:&r fluix crystals carry the ME network's signal. The ME Controller needs them."
		"&eHow:&r charge certus quartz in the Charger, then drop charged certus, redstone and Nether quartz in water together (check JEI)."
		"&eTip:&r budding certus quartz grows new crystals, so certus is renewable once you find some."
	]
	quest.6C079DD7BD5DC36A.title: "The Inscriber"
	quest.6C079DD7BD5DC36A.quest_subtitle: "Printing circuits onto silicon"
	quest.6C079DD7BD5DC36A.quest_desc: [
		"&eWhat:&r every AE2 processor is printed in the Inscriber. In this pack it's built on a Turbo hull."
		"&eChemistry:&r engineering processors print a circuit onto silicon, the same element your HV boards depend on."
		"&eHow:&r press a diamond into a printed engineering circuit, silicon into printed silicon, then combine them with redstone."
		"&eTip:&r the silicon is your MI silicon from the EBF. AE2's certus-to-silicon smelting is removed in this pack."
	]
	quest.45849083414E98A3.title: "The God's Archive"
	quest.45849083414E98A3.quest_subtitle: "Your memory, rebuilt as a network"
	quest.45849083414E98A3.quest_desc: [
		"&6Everything you own, known at once and found in an instant. Your memory used to work like this; now it lives in a network you built.&r"
		"&eWhat:&r Applied Energistics 2 stores items as data and crafts on demand."
		"&eHow:&r the ME Controller needs a digital circuit, an engineering processor, fluix and smooth sky stone."
		"&eTip:&r Tom's Simple Storage was your early network. AE2 takes over from here (see the Applied Energistics page in Engineering)."
	]
	quest.40E5C8E7AFD9DCDB.title: "First Storage Cells"
	quest.40E5C8E7AFD9DCDB.quest_subtitle: "Optional: where the archive keeps its memories"
	quest.40E5C8E7AFD9DCDB.quest_desc: [
		"&eWhat:&r storage cells go into an ME Drive. Fluid cells hold your acids and fuels as data too."
		"&eHow:&r a 1k cell component needs a logic processor (gold + logic press). Check JEI for the housing."
		"&eTip:&r a few fluid cells beat a wall of tanks for small stocks of rare chemicals."
	]
	quest.4B6B18DEE9511230.title: "The Twilight Forest"
	quest.4B6B18DEE9511230.quest_subtitle: "A realm of permanent dusk"
	quest.4B6B18DEE9511230.quest_desc: [
		"&6A forest held forever at dusk. Even a god can get lost here, which is half the fun.&r"
		"&eWhat:&r a dimension of bosses, strange woods and unique metals (see the Twilight Forest page in Exploration)."
		"&eHow:&r dig a 2x2 pool of water ringed with flowers, stand in it, and throw in a diamond."
		"&eTip:&r set a waystone near the portal before you explore."
	]
	quest.66878B009C6ABC9F.title: "Benzene Rings"
	quest.66878B009C6ABC9F.quest_subtitle: "The hexagon at the heart of organic chemistry"
	quest.66878B009C6ABC9F.quest_desc: [
		"&eWhat:&r benzene (C₆H₆) and toluene (C₇H₈) come out of the cracked-naphtha distillation."
		"&eChemistry:&r benzene is a flat ring of six carbons whose electrons are shared around the whole ring. That makes it unusually stable."
		"&eHow:&r collect them from the Distillation Tower's benzene and toluene outputs."
		"&eTip:&r keep the toluene: Industrial TNT needs it in the next chapter. Benzene also makes nylon (side quest)."
	]
	quest.5529968E112BBA9E.title: "Styrene"
	quest.5529968E112BBA9E.quest_subtitle: "Add ethylene, then strip off hydrogen"
	quest.5529968E112BBA9E.quest_desc: [
		"&eChemistry:&r benzene + ethylene → ethylbenzene (acid catalyst). Steam over iron then pulls off H₂ to give styrene, C₈H₈, exactly as in real plants."
		"&eHow:&r Chemical Reactor: benzene + ethylene + a little HCl → ethylbenzene. Then ethylbenzene + steam + iron dust → styrene + hydrogen."
		"&eTip:&r the hydrogen by-product can go straight back into hydrotreating."
	]
	quest.11E3CE994DD5E91B.title: "Synthetic Rubber"
	quest.11E3CE994DD5E91B.quest_subtitle: "Car-tyre rubber, made from oil"
	quest.11E3CE994DD5E91B.quest_desc: [
		"&eWhat:&r styrene-butadiene rubber (SBR) is the rubber in most tyres. Here it makes rubber sheets by the stack."
		"&eChemistry:&r styrene and butadiene polymerise together into one chain (a copolymer): stiff styrene parts, springy butadiene parts."
		"&eHow:&r Chemical Reactor: styrene + butadiene → styrene-butadiene, then polymerise with tiny lead or chromium dust. The Vacuum Freezer turns 200 mB into 64 rubber sheets."
		"&eTip:&r keep a tank of liquid SBR: the RAM chips of the next chapter are printed with 500 mB each, and it makes cable far cheaper than rubber sheets."
	]
	quest.7A05E39EE109E1CA.title: "Diesel Toys"
	quest.7A05E39EE109E1CA.quest_subtitle: "Optional: fuel-powered tools"
	quest.7A05E39EE109E1CA.quest_desc: [
		"&eWhat:&r MI's diesel drill and jetpack run on the fuel you just learned to blend."
		"&eHow:&r check JEI for both recipes, then fill them from a tank."
		"&eTip:&r the jetpack is loud and thirsty, but it flies. Real flight comes later."
	]
	quest.697083271627CD0D.title: "Fuel from Plants"
	quest.697083271627CD0D.quest_subtitle: "Optional: diesel without drilling"
	quest.697083271627CD0D.quest_desc: [
		"&eChemistry:&r transesterification: plant oil + ethanol, with NaOH as catalyst, swaps the oil's glycerol backbone for ethyl groups. The result burns like diesel."
		"&eHow:&r Chemical Reactor: plant oil + ethanol + sodium hydroxide → raw biodiesel, then wash it with steam (check JEI for plant oil)."
		"&eTip:&r Ad Astra rockets accept biodiesel too."
	]
	quest.1AAB2F81853CDE86.title: "Acrylic Glue"
	quest.1AAB2F81853CDE86.quest_subtitle: "Optional: slime from propene"
	quest.1AAB2F81853CDE86.quest_desc: [
		"&eChemistry:&r propene + oxygen → acrylic acid + water. Polymerised, it becomes a sticky acrylic: the same family as superabsorbent polymers."
		"&eHow:&r Chemical Reactor for the acid, then polymerise with tiny lead or chromium dust."
		"&eTip:&r the Chemical Reactor can turn acrylic glue into slime balls. No more slime farms."
	]
	quest.6879CF7353CD336E.title: "Nylon"
	quest.6879CF7353CD336E.quest_subtitle: "Optional: string from benzene"
	quest.6879CF7353CD336E.quest_desc: [
		"&eChemistry:&r benzene + hydrogen over nickel leads to caprolactam, a ring that opens up and polymerises into nylon-6."
		"&eHow:&r Chemical Reactor: benzene + hydrogen + tiny nickel dust → caprolactam, then polymerise it."
		"&eTip:&r 20 mB of nylon makes one string in the Chemical Reactor."
	]
	quest.66000D449A417BFA.title: "A Mountain of Rubber"
	quest.66000D449A417BFA.quest_subtitle: "Optional: stockpile challenge"
	quest.66000D449A417BFA.quest_desc: [
		"&eHow:&r keep the SBR line and Vacuum Freezer running until you have 256 sheets."
		"&eWhat:&r four full stacks of rubber sheets, made the modern way."
		"&eTip:&r one bucket of SBR is five freezer runs, so a single bucket gets you there."
	]
	quest.4B5C9677207BD72C.title: "Logic Gates"
	quest.4B5C9677207BD72C.quest_subtitle: "AND, OR, NOT: the grammar of thought"
	quest.4B5C9677207BD72C.quest_desc: [
		"&eWhat:&r every digital circuit needs one AND, one OR and one NOT gate, and every gate starts with an operational amplifier."
		"&eChemistry:&r a transistor is a switch with no moving parts. Wire a few together and they answer yes-or-no questions; wire millions and you have a computer."
		"&eHow:&r Assembler. Op amp: 4 resistors, 4 transistors, 1 diode. AND: 2 resistors, 1 op amp, 4 aluminum wire. OR: 2 op amps, 2 aluminum wire, 1 diode. NOT: 1 resistor, 1 op amp, 1 aluminum wire."
		"&eTip:&r set one Assembler per gate type. Digital circuits eat them by the dozen."
	]
	quest.29EB3B57474E09B3.title: "The Distillery"
	quest.29EB3B57474E09B3.quest_subtitle: "The HV refinery: one fraction at a time"
	quest.29EB3B57474E09B3.quest_desc: [
		"&eWhat:&r a single-block still that pulls one fraction out of a fluid per recipe. It's the refinery of this chapter; the full Distillation Tower needs EV parts."
		"&eChemistry:&r a pot still works by boiling point too, but with only one stage it can't separate everything at once."
		"&eHow:&r LV machine hull, 2 large pumps, 2 electronic circuits, glass, a fluid pipe and electrum cable."
		"&eTip:&r JEI lists one Distillery recipe per fraction. Several Distilleries side by side, one per product, make a fine first refinery."
	]
	quest.3CABA477F26CBEE2.title: "Chromium and Manganese Ores"
	quest.3CABA477F26CBEE2.quest_subtitle: "Ruby and raw iron, spun apart"
	quest.3CABA477F26CBEE2.quest_desc: [
		"&eWhat:&r the raw material for the chromium and manganese leaching lines."
		"&eChemistry:&r ruby is aluminium oxide coloured red by chromium, so it hides chromium. Iron ores usually carry a little manganese."
		"&eHow:&r Centrifuge: 6 ruby dust → 1 chromium crushed dust + 2 aluminum dust (ruby dust comes from centrifuging redstone). Centrifuge: 6 raw iron → 8 iron dust + 1 manganese crushed dust."
	]
	quest.449849B93937E00E.title: "Hot and Cold Casings"
	quest.449849B93937E00E.quest_subtitle: "Optional: invar for heat, aluminum for cold"
	quest.449849B93937E00E.quest_desc: [
		"&eWhat:&r heatproof casings wall in your Blast Furnace; frostproof casings wall in the Vacuum Freezer. The Heat Exchanger needs both."
		"&eChemistry:&r invar (iron with 36% nickel) barely expands when heated. Aluminium stays tough in the cold, where steel turns brittle."
		"&eHow:&r 8 invar plates + an invar gear, or 8 aluminum plates + an aluminum gear (Assembler or crafting table)."
	]
	quest.60DC824132BB1184.title: "Advanced Upgrades"
	quest.60DC824132BB1184.quest_subtitle: "Optional: four basic upgrades, made better"
	quest.60DC824132BB1184.quest_desc: [
		"&eWhat:&r a bigger EU/t boost per slot than basic upgrades."
		"&eHow:&r Assembler: 4 basic upgrades, 2 large motors, a large pump, an electronic circuit board and 1000 mB polyethylene → 4 advanced upgrades."
	]
	quest.242CC152863715AD.title: "Cracking Light Fuel"
	quest.242CC152863715AD.quest_subtitle: "Optional: crack the fuel, not just the naphtha"
	quest.242CC152863715AD.quest_desc: [
		"&eWhat:&r light fuel can be steam-cracked too, and the cracked fuel distils into another mix of small molecules."
		"&eChemistry:&r cracking breaks long chains into short ones. Refineries crack whatever fraction the market wants less of into what it wants more of."
		"&eHow:&r steam + light fuel in the cracker (check JEI), then send it through the Distillation Tower."
	]
	quest.1A1FFC0C25846B77.title: "Butadiene"
	quest.1A1FFC0C25846B77.quest_subtitle: "The springy half of synthetic rubber"
	quest.1A1FFC0C25846B77.quest_desc: [
		"&eWhat:&r butadiene (C₄H₆) is the second monomer of SBR rubber."
		"&eChemistry:&r two double bonds make it springy once polymerised. Before oil, Soviet plants made it from ethanol (the Lebedev process); MI can too."
		"&eHow:&r Chemical Reactor: 750 mB ethanol + a tiny aluminum dust, or distil it out of cracked naphtha or cracked fuels (check JEI). Then styrene + butadiene → styrene-butadiene."
	]
	quest.5FA794E22BE6574B.title: "Shale Oil"
	quest.5FA794E22BE6574B.quest_subtitle: "Optional: sour crude and a breath of helium"
	quest.5FA794E22BE6574B.quest_desc: [
		"&eWhat:&r the Oil Drilling Rig, fed stainless steel drills instead of aluminum ones, brings up shale oil. Distilled, it gives sour (sulfuric) crude, sulfuric naphtha and a little helium."
		"&eChemistry:&r sour crude is full of sulfur compounds. Hydrotreating strips them out with hydrogen, the same way your fuels are cleaned: 12 B sour crude + 2 B H₂ → 12 B crude oil + 2 B sulfuric acid."
		"&eTip:&r real helium is mined from natural gas wells, where it collects from uranium decay. Keep this helium; you'll want it later."
	]
	quest.2FBB61200999B261.title: "Processing Array"
	quest.2FBB61200999B261.quest_subtitle: "Optional: many machines, one controller"
	quest.2FBB61200999B261.quest_desc: [
		"&eWhat:&r an Extended Industrialization multiblock that holds a stack of identical machines and runs them as one."
		"&eHow:&r an Assembler, 4 robot arms, 2 digital circuits and 2 clean stainless steel casings (8 stainless plates + a stainless gear each). Check JEI for the layout and what it accepts."
		"&eTip:&r one array of 16 macerators beats 16 macerators on cables."
	]
	quest.0E18BB3C1103B362.title: "Aluminum Drills"
	quest.0E18BB3C1103B362.quest_subtitle: "The bit that reaches the oil"
	quest.0E18BB3C1103B362.quest_desc: [
		"&eWhat:&r the Oil Drilling Rig wears through aluminum drills as it pumps."
		"&eHow:&r drill head: an aluminum plate, 2 curved plates, a rod, 2 aluminum gears and bolts. Drill: the head, 2 iron gears, 2 fluid pipes, 2 pumps, an electrum cable and an electronic circuit → 4 drills."
		"&eTip:&r each pumping cycle has only a small chance to break a drill, so four last a long time."
	]
	quest.5A30AA92AD9BEAB6.title: "Sour Light Fuel"
	quest.5A30AA92AD9BEAB6.quest_subtitle: "Half of every bucket of crude"
	quest.5A30AA92AD9BEAB6.quest_desc: [
		"&eWhat:&r the lightest liquid cut of crude, still carrying its sulfur."
		"&eChemistry:&r light fuel is roughly C₅ to C₁₂: petrol and kerosene. Small molecules have weak forces between them, so they boil first."
		"&eHow:&r Distillery: 1000 mB crude oil → 500 mB sulfuric light fuel."
	]
	quest.59A46C8873BFF2FD.title: "Sour Heavy Fuel"
	quest.59A46C8873BFF2FD.quest_subtitle: "The thick bottom of the barrel"
	quest.59A46C8873BFF2FD.quest_desc: [
		"&eWhat:&r the heaviest cut: long chains that boil last."
		"&eChemistry:&r long molecules tangle and attract each other more, so they need more heat to escape as vapour. That's why heavy fuel is thick and oily."
		"&eHow:&r Distillery: 1000 mB crude oil → 200 mB sulfuric heavy fuel."
	]
	quest.6157C08B1893FBA3.title: "Sour Naphtha"
	quest.6157C08B1893FBA3.quest_subtitle: "The cut that becomes plastic"
	quest.6157C08B1893FBA3.quest_desc: [
		"&eWhat:&r naphtha is the feedstock of the whole plastics industry."
		"&eChemistry:&r a mix of mid-sized alkanes and rings. Too big for gas, too small for diesel, just right to crack into ethylene."
		"&eHow:&r Distillery: 1000 mB crude oil → 300 mB sulfuric naphtha."
	]
	quest.5FA481C725D36333.title: "Tanks for Every Fraction"
	quest.5FA481C725D36333.quest_subtitle: "Optional: one tank per fluid"
	quest.5FA481C725D36333.quest_desc: [
		"&eWhat:&r aluminum tanks hold far more than bronze or steel ones."
		"&eHow:&r check JEI. Put one on each Distillery output so a full tank never stalls the line."
		"&eTip:&r label them. By the end of this chapter you'll have a dozen fluids."
	]
	quest.1B9C9A465506627C.title: "Methane"
	quest.1B9C9A465506627C.quest_subtitle: "CH₄, the smallest hydrocarbon"
	quest.1B9C9A465506627C.quest_desc: [
		"&eWhat:&r natural gas. Next chapter it becomes acetylene, and acetylene becomes PVC."
		"&eChemistry:&r one carbon, four hydrogens, arranged as a tetrahedron. It burns cleanly to CO₂ and water."
		"&eHow:&r Distillery: 1000 mB steam-cracked naphtha → 150 mB methane. Store it; you'll want a few buckets."
	]
	quest.102865386CBAEB55.title: "Propene"
	quest.102865386CBAEB55.quest_subtitle: "Optional: ethylene's bigger sibling"
	quest.102865386CBAEB55.quest_desc: [
		"&eWhat:&r propene (propylene, C₃H₆) is the second most important plastics monomer in the real world."
		"&eChemistry:&r one more carbon than ethylene, with the same C=C double bond. Polymerised, it becomes polypropylene."
		"&eHow:&r Distillery: 1000 mB steam-cracked naphtha → 75 mB propene."
	]
	quest.3E482FC61DCED040.title: "A Pinch of Catalyst"
	quest.3E482FC61DCED040.quest_subtitle: "Tiny lead or chromium dust"
	quest.3E482FC61DCED040.quest_desc: [
		"&eWhat:&r MI polymerises with a tiny dust of metal: 4 tiny lead dust or 1 tiny chromium dust per 500 mB of monomer."
		"&eChemistry:&r a catalyst speeds a reaction without being used up overall. Real polyethylene plants use chromium (Phillips) or titanium (Ziegler-Natta) catalysts."
		"&eHow:&r craft 1 lead dust into 9 tiny dusts. Chromium gives more plastic per pinch once your stainless line runs."
	]
	quest.0A6E7C49D5F97578.title: "Pressurized Reaction Chamber"
	quest.0A6E7C49D5F97578.quest_subtitle: "Mekanism's high-pressure reactor"
	quest.0A6E7C49D5F97578.quest_desc: [
		"&eWhat:&r the PRC reacts an item, a fluid and a gas together under pressure. It makes HDPE, substrate and, later, nuclear pellets."
		"&eHow:&r an Enrichment Chamber, 2 basic control circuits, steel, infused alloy, 2 basic chemical tanks and a dynamic tank (check JEI)."
		"&eTip:&r MI ethylene counts as Mekanism ethene in this pack, so your Distillery feeds it directly."
	]
	quest.0FAFF5ECC8FE69BA.title: "Ruby Dust"
	quest.0FAFF5ECC8FE69BA.quest_subtitle: "Redstone hides a gemstone"
	quest.0FAFF5ECC8FE69BA.quest_desc: [
		"&eWhat:&r ruby dust is MI's chromium ore."
		"&eChemistry:&r ruby is aluminium oxide with a trace of chromium. Cr³⁺ ions absorb green light, which is why the crystal looks red."
		"&eHow:&r Centrifuge: 10 redstone → 5 iron dust, 1 ruby dust, 1 quartz dust and sometimes a tiny neodymium dust."
	]
	quest.7D06DECC1C8E234F.title: "Chromium Leach"
	quest.7D06DECC1C8E234F.quest_subtitle: "Dissolve chromium in hydrochloric acid"
	quest.7D06DECC1C8E234F.quest_desc: [
		"&eWhat:&r chromium chloride solution, ready for the Electrolyzer."
		"&eChemistry:&r HCl dissolves the metal as chloride ions, leaving the rock behind. Electrolysis then plates the metal back out."
		"&eHow:&r Chemical Reactor: 1 chromium crushed dust + 9000 mB hydrochloric acid → 9000 mB solution."
	]
	quest.7323CA399282E2C4.title: "Manganese Leach"
	quest.7323CA399282E2C4.quest_subtitle: "Dissolve manganese in sulfuric acid"
	quest.7323CA399282E2C4.quest_desc: [
		"&eWhat:&r manganese sulfate solution. Most of the world's pure manganese is made by electrolysing exactly this."
		"&eHow:&r Chemical Reactor: 1 manganese crushed dust + 9000 mB sulfuric acid → 9000 mB solution."
		"&eTip:&r the Electrolyzer gives most of the acid back, so the loop barely costs you any."
	]
	quest.2EFDC0BD774F60CE.title: "Nickel"
	quest.2EFDC0BD774F60CE.quest_subtitle: "The metal that keeps stainless tough"
	quest.2EFDC0BD774F60CE.quest_desc: [
		"&eWhat:&r one of the four dusts in stainless steel, and the anode metal of the platinum line later."
		"&eChemistry:&r nickel keeps stainless steel in its austenite structure at room temperature: tough, non-magnetic and easy to shape."
		"&eHow:&r mine MI nickel ore and macerate the raw nickel."
	]
	quest.4C2022903993BFF9.title: "Aluminum Large Plates"
	quest.4C2022903993BFF9.quest_subtitle: "Cold-proof panels for the freezer"
	quest.4C2022903993BFF9.quest_desc: [
		"&eWhat:&r the Vacuum Freezer takes two."
		"&eHow:&r 4 aluminum plates in a square (crafting table or Packer)."
	]
	quest.53DB33898544C0AD.title: "Stainless Plates"
	quest.53DB33898544C0AD.quest_subtitle: "The sheet metal of the HV tier"
	quest.53DB33898544C0AD.quest_desc: [
		"&eWhat:&r digital circuit boards take 4, the Turbo casing 8, and air intakes, gears and rotors more."
		"&eHow:&r Compressor: 1 stainless steel ingot → 1 plate."
	]
	quest.44D67AF0793195A4.title: "Aluminum Cable"
	quest.44D67AF0793195A4.quest_subtitle: "The HV cable"
	quest.44D67AF0793195A4.quest_desc: [
		"&eWhat:&r aluminum cable carries HV power and goes into the digital circuit board, the sodium battery and the Turbo hull. Logic gates use bare aluminum wire."
		"&eChemistry:&r aluminium conducts about 60% as well as copper but weighs a third as much. Real overhead power lines are aluminium for that reason."
		"&eHow:&r Wiremill: 1 aluminum plate → 2 wire. 3 wire between 6 rubber sheets → 3 cable (or liquid SBR in the Assembler)."
	]
	quest.260F69307FC9DFF0.title: "Operational Amplifiers"
	quest.260F69307FC9DFF0.quest_subtitle: "Transistors that do arithmetic"
	quest.260F69307FC9DFF0.quest_desc: [
		"&eWhat:&r every logic gate starts with an op amp."
		"&eChemistry:&r an op amp multiplies the difference between two voltages enormously. Feed some of its output back and it can add, compare or switch."
		"&eHow:&r 4 resistors, 4 transistors and 1 diode (crafting table or Assembler)."
	]
	quest.48A8A2AF333BB57E.title: "Turbo Machine Casing"
	quest.48A8A2AF333BB57E.quest_subtitle: "An MV hull, clad in stainless"
	quest.48A8A2AF333BB57E.quest_desc: [
		"&eWhat:&r the shell of the HV (Turbo) hull."
		"&eHow:&r 8 stainless steel plates around an MV (advanced) machine hull."
	]
	quest.3124E15EF0939D10.title: "An HV Grid"
	quest.3124E15EF0939D10.quest_subtitle: "Optional: step up again"
	quest.3124E15EF0939D10.quest_desc: [
		"&eWhat:&r an MV-to-HV transformer and an HV storage unit."
		"&eHow:&r check JEI for both. The storage unit is built on a Turbo hull with sodium batteries."
		"&eTip:&r the Electric Blast Furnace and Vacuum Freezer pull a lot; give them an HV buffer."
	]
	quest.2C2130D79E259C0E.title: "Certus Quartz"
	quest.2C2130D79E259C0E.quest_subtitle: "The quartz that holds a charge"
	quest.2C2130D79E259C0E.quest_desc: [
		"&eWhat:&r certus quartz becomes fluix, AE2's network crystal."
		"&eHow:&r meteorites carry budding certus. Mine around it (not the budding block itself) and harvest the crystals that grow."
		"&eTip:&r a Growth Accelerator next to budding certus speeds it up a lot (check JEI)."
	]
	quest.7DC466934D70C5A8.title: "Sky Stone"
	quest.7DC466934D70C5A8.quest_subtitle: "Meteorite rock, smelted smooth"
	quest.7DC466934D70C5A8.quest_desc: [
		"&eWhat:&r the ME Controller is framed in 4 smooth sky stone blocks."
		"&eHow:&r mine sky stone from the meteorite and smelt it."
	]
	quest.3A446272DE337676.title: "Processors"
	quest.3A446272DE337676.quest_subtitle: "Logic, calculation and engineering"
	quest.3A446272DE337676.quest_desc: [
		"&eWhat:&r AE2's three processors. Storage cells use logic, crafting uses calculation, the controller and drives use engineering."
		"&eHow:&r Inscriber: gold → printed logic circuit, certus → printed calculation circuit, diamond → printed engineering circuit, silicon → printed silicon. Then circuit + redstone + printed silicon → processor."
		"&eTip:&r MI's Packer can also print silicon with a silicon press."
	]
	quest.195CD1678E16F567.title: "Fluix Cable"
	quest.195CD1678E16F567.quest_subtitle: "The wiring of the archive"
	quest.195CD1678E16F567.quest_desc: [
		"&eWhat:&r ME cable joins the controller, drives and terminals into one network."
		"&eHow:&r quartz fiber + 2 fluix → 4 glass cables (check JEI for quartz fiber)."
	]
	quest.056317CC7EAC1F12.title: "Pipe Casings"
	quest.056317CC7EAC1F12.quest_subtitle: "The rig's hollow shaft"
	quest.056317CC7EAC1F12.quest_desc: [
		"&eWhat:&r steel pipe machine casings form the shaft of the Oil Drilling Rig, around the drill string."
		"&eHow:&r a steel machine casing wrapped in 6 steel curved plates gives 2 pipe casings (crafting table or Assembler)."
		"&eTip:&r place the rig's controller and hold a wrench: MI previews the whole structure in the world."
	]
	quest.3E2F08883A3E0CF6.title: "Rig Hatches"
	quest.3E2F08883A3E0CF6.quest_subtitle: "Drills in, oil out, power in"
	quest.3E2F08883A3E0CF6.quest_desc: [
		"&eWhat:&r a multiblock talks to the world through hatches. The rig needs an item input (drills), a fluid output (crude) and an energy input."
		"&eHow:&r steel hatches are a steel casing plus a chest or tank (check JEI). An energy input hatch is a machine hull plus a cable of its tier."
		"&eTip:&r any casing slot of the structure can hold a hatch, so put them where your pipes already run."
	]
	chapter.12C105E0A9C3B5B2.title: "VII. Materials and Nuclear"
	chapter.12C105E0A9C3B5B2.chapter_subtitle: [
		"Purity and precision: semiconductors, PVC, isotopes."
		"Then transmutation: any element from any other."
	]
	quest.7EFA01609EB9CAE8.title: "Argon from Air"
	quest.7EFA01609EB9CAE8.quest_subtitle: "The lazy gas that protects hot silicon"
	quest.7EFA01609EB9CAE8.quest_desc: [
		"&6You once stirred the sky. Now you pour it, liquid, into a tank.&r"
		"&eWhat:&r argon is an inert blanket gas. Growing a silicon crystal in air would ruin it."
		"&eChemistry:&r air is 78% N₂, 21% O₂ and about 0.9% argon. Cool it until it liquefies, then separate the parts."
		"&eHow:&r the Vacuum Freezer (or Pressurizer) with an Air Intake makes liquid air. The Centrifuge splits it into oxygen, nitrogen and a little argon."
		"&eTip:&r the Heat Exchanger gives far more argon while it cools hot ingots."
	]
	quest.5487AC6E80EEFF90.title: "Semiconductor Silicon"
	quest.5487AC6E80EEFF90.quest_subtitle: "One perfect crystal, sliced thin"
	quest.5487AC6E80EEFF90.quest_desc: [
		"&eWhat:&r computer chips need silicon purer than 99.9999999%, grown as one single crystal."
		"&eChemistry:&r a seed crystal is pulled slowly out of molten silicon (the Czochralski process). Every atom lines up with the one below it."
		"&eHow:&r Cutting Machine: 1 monocrystalline silicon + 500 mB lubricant → 32 wafers."
		"&eTip:&r one boule is 32 wafers: enough for a long run of RAM and MMUs."
	]
	quest.7F783CDF991DA3CA.title: "Chips"
	quest.7F783CDF991DA3CA.quest_subtitle: "Memory, logic and control on silicon"
	quest.7F783CDF991DA3CA.quest_desc: [
		"&eWhat:&r a processing unit needs RAM, an ALU and an MMU."
		"&eChemistry:&r a pinch of aluminum (p-type) or phosphorus (n-type) in silicon changes how it carries current. That's 'doping', the basis of every transistor."
		"&eHow:&r one of each, made in the quests around this one. The processing unit takes 2 RAM, 1 ALU and 1 MMU."
	]
	quest.1CA61C282BFA56F8.title: "Acetylene"
	quest.1CA61C282BFA56F8.quest_subtitle: "The welding gas, from methane"
	quest.1CA61C282BFA56F8.quest_desc: [
		"&eWhat:&r acetylene (C₂H₂) has a triple bond, which makes it very reactive."
		"&eChemistry:&r heat methane hard enough and pairs of molecules lose hydrogen and join: 2CH₄ → C₂H₂ + 3H₂."
		"&eHow:&r Electric Blast Furnace: 200 mB methane → 200 mB acetylene. Cracked naphtha also gives a little."
	]
	quest.7ADCA113114E63A0.title: "Vinyl Chloride"
	quest.7ADCA113114E63A0.quest_subtitle: "Acetylene meets hydrochloric acid"
	quest.7ADCA113114E63A0.quest_desc: [
		"&eChemistry:&r C₂H₂ + HCl → C₂H₃Cl. HCl adds across the triple bond. This was the original industrial route to PVC."
		"&eHow:&r Chemical Reactor: 1 B acetylene + 1 B hydrochloric acid → 1 B vinyl chloride."
		"&eTip:&r your salt line's chlorine and hydrogen make the HCl."
	]
	quest.56149E13A2EFBE0C.title: "PVC"
	quest.56149E13A2EFBE0C.quest_subtitle: "Petrochemistry meets chlor-alkali"
	quest.56149E13A2EFBE0C.quest_desc: [
		"&eWhat:&r polyvinyl chloride, (C₂H₃Cl)ₙ, is tough, fire-resistant and insulates EV circuit boards."
		"&eChemistry:&r just like polyethylene, but every other carbon carries a chlorine atom. That's why PVC doesn't burn easily."
		"&eHow:&r Chemical Reactor: 500 mB vinyl chloride + 4 tiny lead or chromium dust → 300 mB PVC."
	]
	quest.336CD4DE5D9F2FAF.title: "Cadmium Battery"
	quest.336CD4DE5D9F2FAF.quest_subtitle: "Nickel-cadmium cells for the EV hull"
	quest.336CD4DE5D9F2FAF.quest_desc: [
		"&eWhat:&r the EV hull and processing unit board each need 2 cadmium batteries."
		"&eChemistry:&r a NiCd cell runs Cd + 2NiO(OH) + 2H₂O → Cd(OH)₂ + 2Ni(OH)₂, and it can be recharged by running it backwards."
		"&eHow:&r Centrifuge: 9 monazite dust → 3 cadmium dust (plus neodymium, yttrium and helium). Battery: 2 cadmium dust, a battery alloy plate, 4 curved plates and 2 annealed copper cable. In reality cadmium is mostly a by-product of zinc refining."
		"&eTip:&r cadmium is toxic in real life. Here it just needs a lot of monazite."
	]
	quest.4226F3C3C6AF3441.title: "Processing Unit Board"
	quest.4226F3C3C6AF3441.quest_subtitle: "PVC, platinum and cadmium in one board"
	quest.4226F3C3C6AF3441.quest_desc: [
		"&eHow:&r Assembler: digital circuit board + 4 platinum plates + 2 cadmium batteries + 8 annealed copper cable + 1500 mB PVC."
		"&eChemistry:&r platinum never corrodes, so it makes contacts that last forever."
		"&eTip:&r platinum comes from MI's ore processing or the Platinum Line below (check JEI)."
	]
	quest.009FBA775299B910.title: "EV: Processing Units"
	quest.009FBA775299B910.quest_subtitle: "Extreme Voltage, built on purity"
	quest.009FBA775299B910.quest_desc: [
		"&6A mind of silicon, insulated in salt and oil. It thinks the way you used to.&r"
		"&eWhat:&r processing units unlock EV machines, the NASA Workbench, Flux Networks and Alchemistry's chambers."
		"&eHow:&r Assembler: processing unit board + 4 digital circuits + 2 RAM + ALU + MMU. The &eEV hull&r is a highly advanced casing + a processing unit + 2 cadmium batteries + 3 annealed copper cable."
	]
	quest.515EABDC83B26416.title: "Yellowcake"
	quest.515EABDC83B26416.quest_subtitle: "The first step from ore to fuel"
	quest.515EABDC83B26416.quest_desc: [
		"&eWhat:&r yellowcake is concentrated uranium oxide powder, the raw material of nuclear fuel."
		"&eChemistry:&r natural uranium is only 0.72% U-235, the isotope that splits. The rest is U-238."
		"&eHow:&r Enrichment Chamber: 1 uranium ingot → 2 yellowcake. Then the Chemical Oxidizer turns it into uranium oxide gas."
		"&eTip:&r a Geiger counter tells you when you're standing too close to anything radioactive."
	]
	quest.6DA3A8FA4B30A712.title: "Hydrofluoric Acid"
	quest.6DA3A8FA4B30A712.quest_subtitle: "The acid that eats glass"
	quest.6DA3A8FA4B30A712.quest_desc: [
		"&eChemistry:&r CaF₂ + H₂SO₄ → CaSO₄ + 2HF. Hydrogen fluoride dissolves glass and is one of the most dangerous acids there is."
		"&eHow:&r Chemical Dissolution Chamber: fluorite + sulfuric acid → hydrofluoric acid gas."
		"&eTip:&r fluorite ore sits deep. Mystical Agriculture and Occultism can't make it in this pack. Keep extra HF: the Seed of a New World needs 4 buckets (a Rotary Condensentrator in liquid mode turns the gas into fluid)."
	]
	quest.2393C134BD200793.title: "Uranium Hexafluoride"
	quest.2393C134BD200793.quest_subtitle: "Turn uranium into a gas"
	quest.2393C134BD200793.quest_desc: [
		"&eWhat:&r UF₆ is the only uranium compound that becomes a gas at low temperature (it sublimes at 56 °C), so it can be spun."
		"&eChemistry:&r real plants go UO₂ → UF₄ → UF₆ with HF and then fluorine. Mekanism combines the steps."
		"&eHow:&r Chemical Infuser: uranium oxide + hydrofluoric acid → uranium hexafluoride."
	]
	quest.5CE57DF0EEA3E9C2.title: "Isotope Separation"
	quest.5CE57DF0EEA3E9C2.quest_subtitle: "Only mass tells U-235 and U-238 apart"
	quest.5CE57DF0EEA3E9C2.quest_desc: [
		"&eWhat:&r the two isotopes behave identically in every reaction, so chemistry can't separate them."
		"&eChemistry:&r U-235 is about 1% lighter. Spin UF₆ fast enough and the heavier molecules drift outward."
		"&eHow:&r Isotopic Centrifuge (6 lead ingots, 2 ultimate control circuits, a chemical tank): uranium hexafluoride → fissile fuel."
	]
	quest.1CFE682A19E514A6.title: "Reactor Parts"
	quest.1CFE682A19E514A6.quest_subtitle: "Fuel, control rods and ports"
	quest.1CFE682A19E514A6.quest_desc: [
		"&eWhat:&r fuel assemblies hold the fuel, control rods absorb neutrons, and ports move fuel, coolant and waste."
		"&eChemistry:&r each split releases 2 to 3 neutrons. Absorb too few and the chain reaction runs away."
		"&eHow:&r check JEI for each part. Plan for water or sodium coolant and somewhere for the steam to go."
	]
	quest.79D73BB7E003DB38.title: "Fission"
	quest.79D73BB7E003DB38.quest_subtitle: "Split the atom"
	quest.79D73BB7E003DB38.quest_desc: [
		"&eWhat:&r split heavy nuclei and release enormous energy. Mind the temperature, and the waste."
		"&eChemistry:&r U-235 + n → two lighter nuclei + 2-3 n + about 200 MeV, millions of times more than any chemical bond."
		"&eHow:&r Just Enough Mekanism Multiblocks shows the layout in JEI. Pair it with a turbine (see Power)."
		"&eTip:&r wire a Logic Adapter to SCRAM the reactor if it overheats."
	]
	quest.170C5FC9F9808944.title: "Plutonium"
	quest.170C5FC9F9808944.quest_subtitle: "An element made by neutrons"
	quest.170C5FC9F9808944.quest_desc: [
		"&eChemistry:&r U-238 captures a neutron and beta-decays twice into Pu-239, which is itself fissile."
		"&eHow:&r Isotopic Centrifuge: 10 nuclear waste → 1 plutonium. Pressurized Reaction Chamber: plutonium + fluorite dust + water → pellet."
		"&eTip:&r the pellet reaction also gives spent nuclear waste. Store it in a Radioactive Waste Barrel."
	]
	quest.1615290C8FEE0C7C.title: "Polonium"
	quest.1615290C8FEE0C7C.quest_subtitle: "The element Marie Curie named for Poland"
	quest.1615290C8FEE0C7C.quest_desc: [
		"&eChemistry:&r polonium-210 is made by neutron capture; it is intensely radioactive and gives off heat on its own."
		"&eHow:&r Solar Neutron Activator (open sky, daylight): 10 nuclear waste → 1 polonium. Pellets come from the Pressurized Reaction Chamber, as with plutonium."
		"&eTip:&r polonium is the input for the SPS and for Energy Cores."
	]
	quest.69D67DF12EE0C400.title: "Transmutation by Neutron"
	quest.69D67DF12EE0C400.quest_subtitle: "Lead to gold was never the hard part"
	quest.69D67DF12EE0C400.quest_desc: [
		"&6The old alchemists wanted to change one element into another. You do it before breakfast.&r"
		"&eWhat:&r reprocessing nuclear waste gives &eplutonium&r and &epolonium&r, two elements that barely exist in nature."
		"&eHow:&r keep both pellet lines running. Plutonium feeds the quantum tier; polonium feeds antimatter."
		"&eTip:&r spent waste still goes in a Radioactive Waste Barrel. Never dump it."
	]
	quest.0485E912DC2B316F.title: "Chamber Frame"
	quest.0485E912DC2B316F.quest_subtitle: "The shell around an element reactor"
	quest.0485E912DC2B316F.quest_desc: [
		"&eWhat:&r Alchemistry's fission and fusion chambers share the same casing, energy, input and output blocks."
		"&eHow:&r craft the frame blocks (check JEI) and build the chamber around its controller. The controllers themselves are crafted with a reactor casing."
		"&eTip:&r build both chambers side by side so one can feed the other."
	]
	quest.606688FB50C32212.title: "Element Transmutation"
	quest.606688FB50C32212.quest_subtitle: "Split or merge any element"
	quest.606688FB50C32212.quest_desc: [
		"&eWhat:&r the fission chamber splits one element into two lighter ones; the fusion chamber merges two into a heavier one."
		"&eChemistry:&r atomic numbers simply add or divide: fuse sodium (11) with chlorine (17) and you get nickel (28)."
		"&eHow:&r both controllers need a processing unit; fusion also needs a Nether Star."
		"&eTip:&r with both, &eevery element&r is within reach."
	]
	quest.6C2882437A5C659C.title: "The Complete Periodic Table"
	quest.6C2882437A5C659C.quest_subtitle: "Element 118"
	quest.6C2882437A5C659C.quest_desc: [
		"&6Oganesson. It barely exists in reality, but you made one.&r"
		"&eWhat:&r the heaviest element on the table, made by fusing lighter ones."
		"&eChemistry:&r real oganesson has been made only a handful of times, and each atom lasted under a millisecond."
		"&eHow:&r fuse your way up in the Fusion Chamber (check JEI for which pairs reach 118)."
		"&6Every block in this world can now be built from chemicals. You're close to what you once were.&r"
	]
	quest.3720EEA89BCDC92F.title: "Wireless Power"
	quest.3720EEA89BCDC92F.quest_subtitle: "Optional: energy without cables"
	quest.3720EEA89BCDC92F.quest_desc: [
		"&eWhat:&r Flux Networks moves energy anywhere in a dimension, or across them."
		"&eHow:&r the Flux Core needs a processing unit in this pack. Add plugs at sources and points at machines."
		"&eTip:&r set a password on your network if you share a server."
	]
	quest.1D1660D4E4098CF6.title: "Haber-Bosch"
	quest.1D1660D4E4098CF6.quest_subtitle: "Bread from air"
	quest.1D1660D4E4098CF6.quest_desc: [
		"&6Feeding a world used to take a harvest god. Now it takes a reactor and some hydrogen.&r"
		"&eWhat:&r ammonia is the root of fertiliser, nitric acid and ammonium salts."
		"&eChemistry:&r N₂ + 3H₂ → 2NH₃. Breaking nitrogen's triple bond is hard; this process feeds about half the world through fertiliser."
		"&eHow:&r Chemical Reactor: 1 B nitrogen + 3 B hydrogen → 2 B ammonia. Fill a bucket from the output tank."
	]
	quest.703A5F9E92E332B9.title: "Ostwald Process"
	quest.703A5F9E92E332B9.quest_subtitle: "Burn ammonia, catch nitric acid"
	quest.703A5F9E92E332B9.quest_desc: [
		"&eChemistry:&r NH₃ + 2O₂ → HNO₃ + H₂O. Real plants burn ammonia over a platinum gauze, the very metal you're about to extract with it."
		"&eHow:&r Chemical Reactor: 1 B ammonia + 2 B oxygen → 1 B nitric acid + 1 B water."
		"&eTip:&r the water by-product can go back into your electrolysis line."
	]
	quest.1BC8628F6F7EC4AF.title: "Anode Sludge"
	quest.1BC8628F6F7EC4AF.quest_subtitle: "Treasure in the electrolyzer's leftovers"
	quest.1BC8628F6F7EC4AF.quest_desc: [
		"&eWhat:&r refining nickel and copper electrically leaves a sludge rich in platinum-group metals."
		"&eChemistry:&r noble metals don't dissolve at the anode, so they fall to the bottom of the cell."
		"&eHow:&r Electrolyzer: 4 nickel or copper dust → 4 dust back + PGM sludge (25% chance)."
		"&eTip:&r it costs you nothing but power. Leave it running."
	]
	quest.0B9EEBE52756E0D9.title: "Ammonium Chloride"
	quest.0B9EEBE52756E0D9.quest_subtitle: "Two gases make a white powder"
	quest.0B9EEBE52756E0D9.quest_desc: [
		"&eChemistry:&r NH₃ + HCl → NH₄Cl. Open bottles of each near one another and a white smoke of this salt forms in the air."
		"&eHow:&r Chemical Reactor: 1 B ammonia + 1 B hydrochloric acid → 1 ammonium chloride."
		"&eTip:&r you need 2 per precipitation, so make plenty."
	]
	quest.20C5260FC05F87BA.title: "Aqua Regia"
	quest.20C5260FC05F87BA.quest_subtitle: "Royal water dissolves the noble metals"
	quest.20C5260FC05F87BA.quest_desc: [
		"&eChemistry:&r 3 HCl : 1 HNO₃. Nitric acid oxidises the platinum and chloride grabs the ions, forming chloroplatinic acid, H₂PtCl₆."
		"&eHow:&r Chemical Reactor: 4 PGM sludge + 3 B HCl + 1 B nitric acid → 2 chloroplatinic acid + 1 PGM residue."
		"&eTip:&r iridium, osmium, rhodium and ruthenium don't dissolve. Keep the residue."
	]
	quest.051D638F5846BAE0.title: "Precipitation"
	quest.051D638F5846BAE0.quest_subtitle: "Pull platinum out of solution as a salt"
	quest.051D638F5846BAE0.quest_desc: [
		"&eChemistry:&r ammonium chloride makes the platinum fall out as yellow ammonium hexachloroplatinate, (NH₄)₂PtCl₆."
		"&eHow:&r Chemical Reactor: 1 chloroplatinic acid + 2 ammonium chloride → 1 ammonium hexachloroplatinate."
		"&eTip:&r this step is why real platinum refining needs both the Haber-Bosch and Ostwald plants."
	]
	quest.45087080B517BD44.title: "The Platinum Line"
	quest.45087080B517BD44.quest_subtitle: "Calcine the salt, keep the metal"
	quest.45087080B517BD44.quest_desc: [
		"&6Metals that never tarnish. You used to think it was pride; now you know they simply refuse to react.&r"
		"&eChemistry:&r heating (calcining) drives off ammonia and HCl and leaves pure platinum metal."
		"&eHow:&r Electric Blast Furnace: 2 ammonium hexachloroplatinate → 1 platinum dust."
		"&eTip:&r processing unit boards need 4 platinum plates each. Automate this line."
	]
	quest.2C530BDB9215DABC.title: "The Rare Four"
	quest.2C530BDB9215DABC.quest_subtitle: "Iridium, osmium, rhodium, ruthenium"
	quest.2C530BDB9215DABC.quest_desc: [
		"&eWhat:&r the insoluble residue holds the rarest metals on Earth."
		"&eChemistry:&r osmium is the densest element known, and iridium the most corrosion-resistant metal."
		"&eHow:&r Centrifuge the PGM residue. Each output is a chance, so run plenty."
		"&eTip:&r iridium is needed for monocrystalline silicon and, later, quantum circuit boards."
	]
	quest.5A912483315D29F6.title: "Dress for the Job"
	quest.5A912483315D29F6.quest_subtitle: "Optional: radiation safety"
	quest.5A912483315D29F6.quest_desc: [
		"&eHow:&r check JEI for each piece."
		"&eWhat:&r a full hazmat suit blocks radiation; the Geiger counter shows how much is around you."
		"&eTip:&r a leaking waste pipe can make an area dangerous for a long time. Check before you build."
	]
	quest.479B3AFD6DB059F7.title: "Closing the Fuel Cycle"
	quest.479B3AFD6DB059F7.quest_subtitle: "Optional: burn plutonium as fuel"
	quest.479B3AFD6DB059F7.quest_desc: [
		"&eChemistry:&r plutonium-239 is fissile, so spent fuel can be recycled into new fuel, as some real reactors do."
		"&eHow:&r Chemical Injection Chamber: plutonium pellet + hydrogen chloride → 4 fragments. Oxidize them into fissile fuel."
		"&eTip:&r it means less waste and more fuel from every uranium ingot."
	]
	quest.74E8AAEEA075991E.title: "The Unstable Ones"
	quest.74E8AAEEA075991E.quest_subtitle: "Optional: elements with no stable form"
	quest.74E8AAEEA075991E.quest_desc: [
		"&eWhat:&r four elements that real chemists almost never get to hold."
		"&eChemistry:&r technetium (43) and promethium (61) are the only light elements with no stable isotope. Astatine and francium are the rarest natural elements: grams exist in the whole crust."
		"&eHow:&r fuse or split your way to each atomic number (check JEI)."
	]
	quest.218AA021BA449275.title: "Platinum Reserve"
	quest.218AA021BA449275.quest_subtitle: "Optional: stockpile challenge"
	quest.218AA021BA449275.quest_desc: [
		"&eHow:&r keep the Platinum Line running, then smelt the dust."
		"&eWhat:&r half a stack of platinum ingots, all pulled out of sludge."
		"&eTip:&r every processing unit board eats 4 platinum plates. You'll be glad of the reserve."
	]
	quest.2CD3E54AACDEE455.title: "Kanthal"
	quest.2CD3E54AACDEE455.quest_subtitle: "Iron, chromium, aluminium: the heating-element alloy"
	quest.2CD3E54AACDEE455.quest_desc: [
		"&eWhat:&r Kanthal is the wire inside toasters and kilns. Coiled around your Blast Furnace it reaches recipes cupronickel can't."
		"&eChemistry:&r FeCrAl alloy. When hot, its aluminium forms a thin skin of alumina (Al₂O₃) that stops the wire burning away, even near 1400 °C."
		"&eHow:&r Mixer: 1 stainless steel + 1 chromium + 1 aluminum dust → 3 Kanthal dust. EBF → hot ingot, then the Vacuum Freezer."
	]
	quest.670B5856D35E61A3.title: "A Hotter Furnace"
	quest.670B5856D35E61A3.quest_subtitle: "Swap your cupronickel coils for Kanthal"
	quest.670B5856D35E61A3.quest_desc: [
		"&eWhat:&r an Electric Blast Furnace built with Kanthal coils unlocks a new set of recipes. JEI lists them under 'EBF (Kanthal Tier)'."
		"&eHow:&r each coil is 8 Kanthal cables (crafting table or Assembler). The EBF's two coil rings take 16."
		"&eTip:&r keep your old cupronickel furnace running too: cheap recipes don't need the upgrade."
	]
	quest.30C3A897D0CE563A.title: "Annealed Copper"
	quest.30C3A897D0CE563A.quest_subtitle: "Copper, softened by fire"
	quest.30C3A897D0CE563A.quest_desc: [
		"&eWhat:&r annealed copper cable goes into cadmium batteries, the processing unit board and every stainless motor."
		"&eChemistry:&r annealing heats a metal and lets it cool slowly, so its crystals regrow without strain. Soft, fully annealed copper conducts best of all and is the standard (100% IACS) that other conductors are measured against."
		"&eHow:&r Kanthal-tier EBF: copper dust + 250 mB oxygen → annealed copper hot ingot, then the Vacuum Freezer."
	]
	quest.526130F78B8D9F95.title: "Titanium"
	quest.526130F78B8D9F95.quest_subtitle: "Light as aluminium, strong as steel"
	quest.526130F78B8D9F95.quest_desc: [
		"&eWhat:&r titanium builds the toughest MI machines: the Implosion Compressor, the Pressurizer and their casings."
		"&eChemistry:&r titanium grabs oxygen and nitrogen when hot, so real plants reduce TiCl₄ with molten magnesium under argon (the Kroll process). Here the EBF does it in one step."
		"&eHow:&r MI titanium ore needs an iron pick; macerate it to dust (bauxite digestion leaves tiny titanium too). Kanthal-tier EBF → hot ingot → Vacuum Freezer."
	]
	quest.4EB7F33F66AC90E1.title: "The Rest of the Air"
	quest.4EB7F33F66AC90E1.quest_subtitle: "Nitrogen and oxygen, by the bucket"
	quest.4EB7F33F66AC90E1.quest_desc: [
		"&eWhat:&r the liquid air you split for argon is mostly nitrogen and oxygen. Nitrogen goes into explosives; oxygen into almost everything."
		"&eChemistry:&r nitrogen boils at −196 °C, oxygen at −183 °C and argon in between. Real air-separation plants distil liquid air exactly along those steps."
		"&eHow:&r Centrifuge: 3000 mB liquid air → 2315 nitrogen + 650 oxygen + 35 argon."
	]
	quest.0C4771010632E10B.title: "Industrial TNT"
	quest.0C4771010632E10B.quest_subtitle: "Controlled violence for compression"
	quest.0C4771010632E10B.quest_desc: [
		"&eWhat:&r Industrial TNT drives the Implosion Compressor, the only way to press the hardest alloys."
		"&eChemistry:&r real TNT is 2,4,6-trinitrotoluene: toluene with three nitro groups, made with nitric and sulfuric acid. It's stable enough to melt and cast, which is why it was used so widely."
		"&eHow:&r Mixer: 4 sand + 3 flint + 250 mB toluene (from cracked naphtha) + 1000 mB nitrogen → 4 Industrial TNT."
	]
	quest.2DA07581F51335CE.title: "Tungsten"
	quest.2DA07581F51335CE.quest_subtitle: "The metal with the highest melting point"
	quest.2DA07581F51335CE.quest_desc: [
		"&eWhat:&r tungsten goes into blastproof alloy and, much later, the ultradense metal ball."
		"&eChemistry:&r tungsten melts at 3422 °C, so no furnace casts it. Real tungsten parts are pressed from powder and sintered: powder metallurgy."
		"&eHow:&r tungsten ore (iron pick, deep) → dust → tiny dust. Compressor: 1 tiny dust → 1 nugget (slow). Once you have an Implosion Compressor: 9 tiny dust + a stainless nugget + Industrial TNT → 1 ingot."
	]
	quest.40DCC8ED98C178DE.title: "Stainless Motors"
	quest.40DCC8ED98C178DE.quest_subtitle: "Motors and pumps for the EV age"
	quest.40DCC8ED98C178DE.quest_desc: [
		"&eWhat:&r advanced motors and pumps run the Implosion Compressor, the heat exchangers and the best upgrades."
		"&eHow:&r advanced motor: a magnetic stainless rod, 2 stainless rods, 2 aluminum cable, 4 annealed copper wire. Advanced pump: advanced motor, 2 stainless rotors, fluid pipes and stainless bolts."
		"&eTip:&r advanced pumps also build the Distillation Tower, the EV refinery."
	]
	quest.1608AF65276EE441.title: "Blastproof Alloy"
	quest.1608AF65276EE441.quest_subtitle: "Tungsten, titanium and stainless, pressed as one"
	quest.1608AF65276EE441.quest_desc: [
		"&eWhat:&r the armour of the Implosion Compressor and every nuclear fuel rod."
		"&eChemistry:&r tungsten for heat, titanium for lightness, stainless for toughness: a composite does what no single metal can."
		"&eHow:&r Packer: 1 tungsten + 1 titanium + 1 stainless steel ingot → mixed blastproof ingot. Compressor: 2 mixed ingots → 1 plate (slow). With an Implosion Compressor: 1 mixed ingot + TNT → 3 ingots."
		"&eTip:&r the Compressor route is only for your first compressor's 16 plates. After that, use the bang."
	]
	quest.7981F4614531D764.title: "The Implosion Compressor"
	quest.7981F4614531D764.quest_subtitle: "Squeeze metal with a shockwave"
	quest.7981F4614531D764.quest_desc: [
		"&eWhat:&r a multiblock that uses Industrial TNT to press tungsten, blastproof alloy, beryllium and nuclear alloy."
		"&eChemistry:&r explosive compaction is real: a shockwave can squeeze powder past what any press reaches. Explosions even make tiny diamonds from graphite."
		"&eHow:&r controller: 2 advanced motors, 2 titanium large plates, an HV hull and 4 blastproof large plates. Blastproof casings (8 plates each) form the walls; layout in JEI and the MI guidebook."
	]
	quest.52956515291DB6DD.title: "Beryllium"
	quest.52956515291DB6DD.quest_subtitle: "Emeralds are beryllium in disguise"
	quest.52956515291DB6DD.quest_desc: [
		"&eWhat:&r beryllium is one third of nuclear alloy."
		"&eChemistry:&r emerald is the mineral beryl, Be₃Al₂Si₆O₁₈. Beryllium is light, stiff and reflects neutrons back into a reactor core."
		"&eHow:&r Electrolyzer: 23 emerald dust → 3 beryllium + 2 aluminum + 6 silicon dust + oxygen. Implosion Compressor: 9 tiny beryllium dust + a stainless nugget + TNT → 1 ingot. Compress it into plates."
	]
	quest.50D273F200006CD0.title: "Rare Earths and Helium"
	quest.50D273F200006CD0.quest_subtitle: "Everything else hiding in monazite"
	quest.50D273F200006CD0.quest_desc: [
		"&eWhat:&r the same centrifuge run that gives cadmium also gives neodymium, yttrium and sometimes helium. You'll need all three for superconductors and fuel rods."
		"&eChemistry:&r monazite is a rare-earth phosphate, (Ce,La,Nd,Th)PO₄. Its thorium slowly decays and the alpha particles it fires become helium atoms trapped in the crystal."
		"&eHow:&r Centrifuge: 9 monazite dust → 3 neodymium + 3 yttrium + 3 cadmium dust, plus 300 mB helium half the time."
		"&eTip:&r helium also comes from centrifuging uranium, distilling shale oil, and cooling hot ingots in the Heat Exchanger."
	]
	quest.5110B6F84BA1F817.title: "Soldering Alloy"
	quest.5110B6F84BA1F817.quest_subtitle: "Tin and lead, the metal glue"
	quest.5110B6F84BA1F817.quest_desc: [
		"&eWhat:&r molten solder seals every MI fuel rod and control rod."
		"&eChemistry:&r tin and lead together melt lower than either alone (a eutectic, about 183 °C), so solder flows into joints without melting the parts."
		"&eHow:&r Mixer: 1 tin dust + 1 lead dust → 2 solder dust. The EBF melts 1 dust into 90 mB of liquid solder."
	]
	quest.07556C6DB6B9A0FE.title: "Nuclear Alloy"
	quest.07556C6DB6B9A0FE.quest_subtitle: "Blastproof, beryllium and cadmium, fused"
	quest.07556C6DB6B9A0FE.quest_desc: [
		"&eWhat:&r the metal the MI Nuclear Reactor is built from."
		"&eChemistry:&r a reactor wall must survive heat and handle neutrons: beryllium reflects them, cadmium absorbs them, blastproof alloy holds it all together."
		"&eHow:&r Packer: blastproof plate + beryllium plate + cadmium plate → mixed nuclear plate. Implosion Compressor with TNT → 3 nuclear alloy plates. Four plates make a large plate."
	]
	quest.1B304766443A7E04.title: "Control Rods"
	quest.1B304766443A7E04.quest_subtitle: "The brakes of a reactor"
	quest.1B304766443A7E04.quest_desc: [
		"&eWhat:&r cadmium control rods soak up neutrons. The reactor controller needs two, and they tame a hot core."
		"&eChemistry:&r cadmium-113 swallows slow neutrons more readily than almost any other nucleus, so a little cadmium stops a chain reaction from running away."
		"&eHow:&r Assembler: 18 cadmium rods, 2 blastproof curved plates, a large motor, 2 robot arms, 500 mB solder and 100 mB helium."
	]
	quest.064F597FDA577ACA.title: "Reactor Shell"
	quest.064F597FDA577ACA.quest_subtitle: "Casings and hatches in nuclear alloy"
	quest.064F597FDA577ACA.quest_desc: [
		"&eWhat:&r the walls and the top grid of the reactor. Item hatches hold fuel and rods; fluid hatches hold water to boil into steam."
		"&eHow:&r nuclear casing: 8 nuclear alloy plates around an HV hull. Hatches: 8 plates around an EV item or fluid input hatch. Check JEI for the pipe casing."
		"&eTip:&r the reactor comes in several sizes. Start small; the MI guidebook shows them all."
	]
	quest.0B94A8E8F50FD54F.title: "Fuel Rods"
	quest.0B94A8E8F50FD54F.quest_subtitle: "Natural uranium, sealed in blastproof"
	quest.0B94A8E8F50FD54F.quest_desc: [
		"&eWhat:&r plain uranium fuel rods need no enrichment. They burn slowly, and that slowness breeds plutonium."
		"&eChemistry:&r natural uranium is 99.3% U-238 and 0.7% fissile U-235. U-238 catches a neutron and decays twice: ²³⁸U → ²³⁹U → ²³⁹Np → ²³⁹Pu."
		"&eHow:&r 18 uranium rods (see Uranium Rods). Assembler: 18 uranium rods, 2 blastproof curved plates, a large motor, 2 robot arms, 500 mB solder, 100 mB helium. Packer: 2 rods + a nuclear alloy plate → double rod."
	]
	quest.0912E79710C67213.title: "The Nuclear Reactor"
	quest.0912E79710C67213.quest_subtitle: "MI's fission reactor, a puzzle of neutrons"
	quest.0912E79710C67213.quest_desc: [
		"&eWhat:&r a big power source, and the only place in the pack that makes MI plutonium. Quantum circuits need it."
		"&eHow:&r Assembler: 4 nuclear alloy large plates, an EV hull, 2 processing units, 2 cadmium control rods. Put water in fluid hatches and fuel in item hatches; JEI shows each part's heat and neutron numbers."
		"&eTip:&r it can't explode or irradiate anything. Too much heat only destroys what's inside the hatches. Experiment freely."
		"{@pagebreak}"
		"&eDeep dive: fast and slow neutrons&r"
		"Fission releases fast neutrons. Fuel catches slow ones far better, so reactors use a moderator (water, heavy water, graphite) to slow them down by collisions."
		"MI models both kinds. Neutrons that escape the edge are lost; ones that hit a hatch can scatter, slow down, or be absorbed. Read the reactor's GUI as a map of where neutrons go."
	]
	quest.41BE4334905A4A11.title: "Bred Plutonium"
	quest.41BE4334905A4A11.quest_subtitle: "Spent fuel, recycled into a new element"
	quest.41BE4334905A4A11.quest_desc: [
		"&6Uranium in, plutonium out. You are keeping a forge for elements now.&r"
		"&eWhat:&r MI plutonium dust, the heart of the plutonium battery and so of every quantum circuit."
		"&eHow:&r burn uranium fuel rods until they're depleted. Centrifuge one depleted rod → 53 tiny U-238 dust + 27 tiny plutonium dust (3 full dusts) and sometimes a tiny U-235."
		"&eTip:&r this is MI plutonium, not Mekanism's pellets. You need both: pellets for the Seed, dust for quantum circuits."
	]
	quest.38E9325D96328F5C.title: "Small Heat Exchanger"
	quest.38E9325D96328F5C.quest_subtitle: "Move heat without mixing fluids"
	quest.38E9325D96328F5C.quest_desc: [
		"&eWhat:&r a component for cooling cells (quantum circuits need them) and for the Heat Exchanger multiblock."
		"&eChemistry:&r a heat exchanger lets a hot fluid warm a cold one through a thin wall. Every power station and refrigerator relies on one."
		"&eHow:&r Assembler: 4 invar plates, a stainless large plate and 4 advanced pumps."
	]
	quest.3D710834BA9E41ED.title: "Titanium Casings"
	quest.3D710834BA9E41ED.quest_subtitle: "Optional: walls for the big machines"
	quest.3D710834BA9E41ED.quest_desc: [
		"&eWhat:&r solid titanium casings wall in the Pressurizer and the high-pressure boilers; stainless pipe casings carry fluids through the Heat Exchanger."
		"&eHow:&r 8 titanium plates + a titanium gear per casing (Assembler). Check JEI (press U on a casing) for the multiblocks that use each."
	]
	quest.7B01F8F5E20FA84C.title: "The Heat Exchanger"
	quest.7B01F8F5E20FA84C.quest_subtitle: "Optional: cool hot ingots, catch argon and helium"
	quest.7B01F8F5E20FA84C.quest_desc: [
		"&eWhat:&r a multiblock that cools hot ingots with cryofluid (giving back argon and helium) and recycles high-pressure water and steam."
		"&eHow:&r Assembler: 2 small heat exchangers, an HV hull, 2 stainless pipe casings, 2 frostproof and 2 heatproof casings. Layout in JEI."
		"&eTip:&r each ingot cooled this way returns 13 mB argon and 5 mB helium. It adds up."
	]
	quest.569E499A60B09D59.title: "Heavy Water"
	quest.569E499A60B09D59.quest_subtitle: "Optional: hydrogen with a neutron"
	quest.569E499A60B09D59.quest_desc: [
		"&eWhat:&r deuterium is hydrogen with one extra neutron; heavy water is D₂O. Both feed fusion, and heavy water is a reactor coolant."
		"&eChemistry:&r about 1 hydrogen atom in 6400 is deuterium. Heavy water is 11% denser than normal water, and ice made from it sinks."
		"&eHow:&r Centrifuge: 1000 mB hydrogen → 20 mB deuterium + 1 mB tritium, or 1000 mB water → 20 mB heavy water. Chemical Reactor: 2000 deuterium + 1000 oxygen → 3000 heavy water."
	]
	quest.62BA867E3F6EA3A1.title: "Uranium Isotopes"
	quest.62BA867E3F6EA3A1.quest_subtitle: "Optional: split U-235 from U-238"
	quest.62BA867E3F6EA3A1.quest_desc: [
		"&eWhat:&r MI's own isotope split, for enriched fuel."
		"&eChemistry:&r U-235 and U-238 differ by three neutrons, about 1% in mass. Spinning them hard is still how most enrichment is done."
		"&eHow:&r Centrifuge: 9 uranium dust → 1 tiny U-235 + 80 tiny U-238 (and sometimes helium). Very slow; depleted rods give more."
	]
	quest.6D7366E1BEA19236.title: "Enriched Uranium"
	quest.6D7366E1BEA19236.quest_subtitle: "Optional: low and high enrichment"
	quest.6D7366E1BEA19236.quest_desc: [
		"&eWhat:&r enriched fuel burns hotter and makes more neutrons than natural uranium."
		"&eHow:&r Mixer: 8 U-238 + 1 U-235 dust → 9 LE uranium dust; 6 U-238 + 3 U-235 → 9 HE uranium dust. Then rods and fuel rods as before."
		"&eTip:&r more neutrons also means more heat. Add control rods before you add HE fuel."
	]
	quest.4D4BD1A09AFF8C0C.title: "MOX Fuel"
	quest.4D4BD1A09AFF8C0C.quest_subtitle: "Optional: burn the plutonium you bred"
	quest.4D4BD1A09AFF8C0C.quest_desc: [
		"&eWhat:&r mixed-oxide fuel uses plutonium in place of U-235."
		"&eChemistry:&r real MOX mixes PuO₂ into UO₂. France recycles spent fuel into MOX, getting more energy from the same mined uranium."
		"&eHow:&r Mixer: 8 U-238 + 1 plutonium dust → 9 LE MOX; 6 U-238 + 3 plutonium → 9 HE MOX."
	]
	quest.1C912A9B990FA8F3.title: "Better Fuel Rods"
	quest.1C912A9B990FA8F3.quest_subtitle: "Optional: any enriched or MOX double rod"
	quest.1C912A9B990FA8F3.quest_desc: [
		"&eWhat:&r any double fuel rod made from LE or HE uranium, or from LE or HE MOX."
		"&eHow:&r the same Assembler recipe as plain fuel rods, with the enriched rods instead. Packer: 2 rods + a nuclear alloy plate → double."
	]
	quest.1C73F7F13B9427C1.title: "Spent Fuel"
	quest.1C73F7F13B9427C1.quest_subtitle: "Optional: burn an enriched rod to the end"
	quest.1C73F7F13B9427C1.quest_desc: [
		"&eWhat:&r a depleted enriched or MOX rod, ready for the Centrifuge."
		"&eHow:&r centrifuging it returns U-238 and plutonium (and U-235 from uranium fuel). HE MOX gives the most plutonium back."
		"&eTip:&r this closes the loop: uranium in, plutonium out, plutonium back in as MOX."
	]
	quest.7B9D236771EA5771.title: "Turbo Upgrades"
	quest.7B9D236771EA5771.quest_subtitle: "Optional: the next machine upgrade"
	quest.7B9D236771EA5771.quest_desc: [
		"&eHow:&r Assembler: 16 advanced motors, 2 advanced pumps, 4 advanced upgrades, a digital circuit board and 1000 mB PVC → 4 turbo upgrades."
		"&eTip:&r one turbo upgrade in a multiblock lets the hungriest recipes run."
	]
	quest.132998E49F41818F.title: "Large Advanced Motors"
	quest.132998E49F41818F.quest_subtitle: "Optional: titanium-rotored giants"
	quest.132998E49F41818F.quest_desc: [
		"&eHow:&r large advanced motor: a processing unit, 2 titanium rods, 6 advanced motors. Large advanced pump: 2 processing units, 3 titanium rotors, a large advanced motor and 3 advanced pumps."
		"&eTip:&r they go into highly advanced upgrades and the biggest pumps and machines."
	]
	quest.6607A09EC4F9245E.title: "Highly Advanced Upgrades"
	quest.6607A09EC4F9245E.quest_subtitle: "Optional: the last upgrade before quantum"
	quest.6607A09EC4F9245E.quest_desc: [
		"&eHow:&r Assembler: 8 large advanced motors, 4 large advanced pumps, 4 turbo upgrades, a processing unit board and 2500 mB PVC → 4."
		"&eTip:&r the Quantum Upgrade, after the Seed, needs 32 of these."
	]
	quest.077B8D568A0E67A4.title: "Fractional Distillation"
	quest.077B8D568A0E67A4.quest_subtitle: "The refinery of the pack"
	quest.077B8D568A0E67A4.quest_desc: [
		"&eWhat:&r the Distillation Tower is a multiblock that splits one fluid into several fractions at once."
		"&eChemistry:&r heat the crude and each fraction boils off at its own temperature. Light molecules rise to the top, heavy ones stay low."
		"&eHow:&r controller: 4 advanced pumps, 2 Distilleries, 2 digital circuits and a Turbo hull. The layout is in JEI. Each extra layer adds one more output, up to eight."
		"&eTip:&r one tower replaces a whole row of Distilleries: steam-cracked naphtha gives methane, acetylene, ethylene, propene, butadiene, benzene, toluene and ethylbenzene in one pass."
	]
	quest.5CC6C638830FA78A.title: "Stainless Rotors"
	quest.5CC6C638830FA78A.quest_subtitle: "Blades that survive heat and acid"
	quest.5CC6C638830FA78A.quest_desc: [
		"&eWhat:&r the air intake spins one; every advanced pump spins three."
		"&eHow:&r blades: 2 stainless curved plates + 1 stainless rod → 4 blades. Ring: Compressor, 1 rod → 1 ring. Rotor: 4 blades, 4 bolts and a ring on a crafting table."
		"&eTip:&r the Assembler recipe needs soldering alloy; craft by hand until your solder line runs."
	]
	quest.598E694FD19E4ED9.title: "Air Intake"
	quest.598E694FD19E4ED9.quest_subtitle: "A fan that feeds the freezer"
	quest.598E694FD19E4ED9.quest_desc: [
		"&eWhat:&r the Air Intake sits in the Vacuum Freezer or Pressurizer and lets it pull in air to liquefy. It isn't used up."
		"&eHow:&r 4 stainless plates, 4 aluminum plates and a stainless rotor."
	]
	quest.39CC29E34F6CFD1F.title: "Liquid Air"
	quest.39CC29E34F6CFD1F.quest_subtitle: "Air, cooled until it pours"
	quest.39CC29E34F6CFD1F.quest_desc: [
		"&eWhat:&r air cold enough to be a liquid: the raw material for nitrogen, oxygen and argon."
		"&eChemistry:&r air liquefies below about −194 °C. Carl von Linde did it industrially in 1895 by compressing air, cooling it, and letting it expand again and again."
		"&eHow:&r Vacuum Freezer with an Air Intake inside: 1000 mB liquid air per run."
	]
	quest.790651BF62E97B47.title: "A Perfect Crystal"
	quest.790651BF62E97B47.quest_subtitle: "Grow one silicon crystal under argon"
	quest.790651BF62E97B47.quest_desc: [
		"&eWhat:&r a monocrystalline silicon boule, the start of every chip."
		"&eChemistry:&r in the Czochralski process a seed crystal is drawn slowly out of molten silicon, and every atom lines up with the one below. Argon keeps oxygen and nitrogen out of the melt."
		"&eHow:&r Electric Blast Furnace: 32 silicon dust + 1 tiny iridium dust + 1250 mB argon → 1 monocrystalline silicon."
		"&eTip:&r the tiny iridium is from the Platinum Line's residue. Keep a few."
	]
	quest.3BD6313B14C50277.title: "RAM"
	quest.3BD6313B14C50277.quest_subtitle: "Memory, grown on a wafer"
	quest.3BD6313B14C50277.quest_desc: [
		"&eWhat:&r random access memory; each processing unit takes 2."
		"&eChemistry:&r a DRAM cell is one transistor and one tiny capacitor. The capacitor's charge is the bit, and it leaks away, so the chip refreshes itself thousands of times a second."
		"&eHow:&r Chemical Reactor: 1 silicon wafer + 1 antimony dust + 1 aluminum dust + 250 mB argon + 500 mB styrene-butadiene rubber → 2 RAM."
	]
	quest.3CB2443322A99803.title: "Diamond Plates"
	quest.3CB2443322A99803.quest_subtitle: "The hardest substrate there is"
	quest.3CB2443322A99803.quest_desc: [
		"&eWhat:&r each ALU is built on a diamond plate."
		"&eChemistry:&r diamond conducts heat better than any metal while insulating electrically: ideal for a chip that runs hot."
		"&eHow:&r Compressor: 1 diamond → 1 diamond plate (slow)."
	]
	quest.688CAAECBD19E29C.title: "Arithmetic Logic Unit"
	quest.688CAAECBD19E29C.quest_subtitle: "Eight gates that do sums"
	quest.688CAAECBD19E29C.quest_desc: [
		"&eWhat:&r the part of a processor that adds, compares and decides. Qubits need two each later."
		"&eChemistry:&r binary addition is just XOR and AND: a half adder is two gates. Chain them and you can add numbers of any size."
		"&eHow:&r 1 diamond plate, 2 AND gates, 2 OR gates and 4 NOT gates."
	]
	quest.33067C5B8613A104.title: "Emerald Plates"
	quest.33067C5B8613A104.quest_subtitle: "Beryl, pressed flat"
	quest.33067C5B8613A104.quest_desc: [
		"&eWhat:&r the MMU sits on an emerald plate."
		"&eHow:&r Compressor: 1 emerald → 1 emerald plate (slow)."
	]
	quest.35C09102D7295A00.title: "Platinum Plates"
	quest.35C09102D7295A00.quest_subtitle: "The noble metal, rolled"
	quest.35C09102D7295A00.quest_desc: [
		"&eWhat:&r every processing unit board takes 4 platinum plates; wire for the MMU comes from them too."
		"&eHow:&r smelt platinum dust into ingots, then Compressor: 1 ingot → 1 plate."
	]
	quest.50968272E29917FE.title: "Platinum Fine Wire"
	quest.50968272E29917FE.quest_subtitle: "Contacts that never corrode"
	quest.50968272E29917FE.quest_desc: [
		"&eWhat:&r each MMU takes 6."
		"&eHow:&r Wiremill: plate → 2 platinum wire; wire → 4 fine wire."
	]
	quest.26A65DFE869F4962.title: "Memory Management Unit"
	quest.26A65DFE869F4962.quest_subtitle: "The chip that keeps track of memory"
	quest.26A65DFE869F4962.quest_desc: [
		"&eWhat:&r the MMU translates the addresses a program asks for into real places in RAM."
		"&eHow:&r 1 emerald plate, 2 silicon wafers and 6 platinum fine wire."
	]
	quest.79938278B8C58983.title: "Monazite"
	quest.79938278B8C58983.quest_subtitle: "A rare-earth phosphate"
	quest.79938278B8C58983.quest_desc: [
		"&eWhat:&r monazite is the pack's source of cadmium, neodymium, yttrium and helium, all from one centrifuge run."
		"&eChemistry:&r (Ce,La,Nd,Th)PO₄: a phosphate of rare earths with a little thorium, which makes it faintly radioactive."
		"&eHow:&r mine MI monazite ore and macerate it. A stainless steel drill in a quarry also brings some up."
	]
	quest.73456FD75ADEE9A8.title: "Annealed Copper Cable"
	quest.73456FD75ADEE9A8.quest_subtitle: "The EV cable"
	quest.73456FD75ADEE9A8.quest_desc: [
		"&eWhat:&r annealed copper cable carries EV power and goes into cadmium batteries, the processing unit board and the EV hull. Advanced motors use the bare wire."
		"&eHow:&r Compressor: ingot → plate. Wiremill: plate → 2 wire. 3 wire + rubber (sheets or liquid SBR) → 3 cable."
	]
	quest.2AB0818669DAAFFB.title: "Chromium Plates"
	quest.2AB0818669DAAFFB.quest_subtitle: "Bright, hard and stubborn"
	quest.2AB0818669DAAFFB.quest_desc: [
		"&eWhat:&r the highly advanced casing is half chromium plates."
		"&eChemistry:&r chromium is the hardest pure metal and the reason chrome plating shines: its oxide film is clear and self-healing."
		"&eHow:&r EBF: chromium dust → hot ingot. Vacuum Freezer → ingot. Compressor → plate."
	]
	quest.68728632D70C8B0D.title: "Titanium Plates"
	quest.68728632D70C8B0D.quest_subtitle: "Light armour for EV machines"
	quest.68728632D70C8B0D.quest_desc: [
		"&eWhat:&r the highly advanced casing takes 4 titanium plates; the Implosion Compressor takes 2 large plates."
		"&eHow:&r Compressor: ingot → plate. 4 plates → 1 large plate (crafting table or Packer)."
	]
	quest.3BC9F7D8E24F0D27.title: "Highly Advanced Casing"
	quest.3BC9F7D8E24F0D27.quest_subtitle: "A Turbo hull in titanium and chromium"
	quest.3BC9F7D8E24F0D27.quest_desc: [
		"&eWhat:&r the shell of the EV hull."
		"&eHow:&r 4 titanium plates and 4 chromium plates around a Turbo (HV) machine hull."
	]
	quest.5A0CBBA4E15DB983.title: "An EV Grid"
	quest.5A0CBBA4E15DB983.quest_subtitle: "Optional: the next step up"
	quest.5A0CBBA4E15DB983.quest_desc: [
		"&eWhat:&r an HV-to-EV transformer and an EV storage unit."
		"&eHow:&r transformer: a Turbo hull, 4 aluminum cable, 1 annealed copper cable. Storage: an EV hull, 6 cadmium batteries, 2 battery alloy plates."
	]
	quest.73DD5B627C5BCEAC.title: "Kanthal Cable"
	quest.73DD5B627C5BCEAC.quest_subtitle: "Heating wire, insulated"
	quest.73DD5B627C5BCEAC.quest_desc: [
		"&eWhat:&r Kanthal coils are wound from Kanthal cable, 8 per coil."
		"&eHow:&r Compressor: ingot → plate. Wiremill: plate → 2 wire. 3 wire + rubber → 3 cable."
		"&eTip:&r a full furnace needs 16 coils, so 128 cables. Set the Wiremill and Packer running early."
	]
	quest.232394DD95C530FE.title: "Magnetic Stainless Rods"
	quest.232394DD95C530FE.quest_subtitle: "Neodymium makes the magnet"
	quest.232394DD95C530FE.quest_desc: [
		"&eWhat:&r the rotor core of every advanced motor."
		"&eChemistry:&r neodymium-iron-boron magnets are the strongest permanent magnets made. Every wind turbine and electric car motor has them."
		"&eHow:&r Polarizer: 1 stainless steel rod + 1 neodymium dust → 1 magnetic stainless rod."
	]
	quest.063CF30DEB5E2666.title: "Elite Control Circuits"
	quest.063CF30DEB5E2666.quest_subtitle: "Mekanism's HV circuit"
	quest.063CF30DEB5E2666.quest_desc: [
		"&eWhat:&r fission ports, control rods and the Solar Neutron Activator all need elite circuits."
		"&eHow:&r 1 MI digital circuit, 2 reinforced alloy and 1 advanced control circuit."
	]
	quest.5AEF9772995532C8.title: "Ultimate Control Circuits"
	quest.5AEF9772995532C8.quest_subtitle: "Mekanism's EV circuit"
	quest.5AEF9772995532C8.quest_desc: [
		"&eWhat:&r the Isotopic Centrifuge and the SPS run on ultimate circuits."
		"&eHow:&r atomic alloy: Metallurgic Infuser, reinforced alloy + refined obsidian. Circuit: 1 MI processing unit, 2 atomic alloy and 1 elite circuit."
	]
	quest.47A7061A4984BC0F.title: "Uranium Ingots"
	quest.47A7061A4984BC0F.quest_subtitle: "The fuel, as metal"
	quest.47A7061A4984BC0F.quest_desc: [
		"&eWhat:&r Mekanism's enrichment starts from ingots, and MI's fuel rods are cut from them."
		"&eChemistry:&r uranium metal is dense (19 g/cm³, about as heavy as gold) and burns in air when finely divided."
		"&eHow:&r smelt raw uranium in any furnace, or melt uranium dust in a Kanthal-tier Electric Blast Furnace."
	]
	quest.37AF029345B9BB54.title: "Fluorite Dust"
	quest.37AF029345B9BB54.quest_subtitle: "The binder of every pellet"
	quest.37AF029345B9BB54.quest_desc: [
		"&eWhat:&r each plutonium or polonium pellet takes 1 fluorite dust."
		"&eHow:&r Crusher: 1 fluorite gem → 1 dust. Fluorite ore crushed in Occultism gives more."
	]
	quest.2622BFFBFC672B27.title: "HF in a Bucket"
	quest.2622BFFBFC672B27.quest_subtitle: "The Seed wants four of these"
	quest.2622BFFBFC672B27.quest_desc: [
		"&eWhat:&r hydrofluoric acid as a liquid. The Seed of a New World takes 4 buckets."
		"&eChemistry:&r HF boils at 19.5 °C, so on a warm day it's barely a liquid. Real plants keep it cooled under pressure in steel, never glass."
		"&eHow:&r Rotary Condensentrator in liquid mode, HF gas in, fluid out."
	]
	quest.44AFDB081A744F0F.title: "Solar Neutron Activator"
	quest.44AFDB081A744F0F.quest_subtitle: "Sunlight, focused on waste"
	quest.44AFDB081A744F0F.quest_desc: [
		"&eWhat:&r the machine that turns nuclear waste into polonium."
		"&eHow:&r reinforced alloy, an HDPE sheet, 2 elite circuits, a steel casing and bronze ingots (check JEI). It needs a clear view of the sky and works only in daylight."
	]
	quest.20B33884B86B7F1A.title: "Waste Barrels"
	quest.20B33884B86B7F1A.quest_subtitle: "Somewhere safe for what's left"
	quest.20B33884B86B7F1A.quest_desc: [
		"&eWhat:&r radioactive waste barrels hold spent waste and let it decay slowly instead of leaking."
		"&eChemistry:&r every radioactive isotope halves on its own schedule. Real spent fuel is kept cool for years before it is moved anywhere."
		"&eHow:&r 4 steel and 4 lead ingots."
	]
	quest.4EBC20A78A27092C.title: "Reactor Logic"
	quest.4EBC20A78A27092C.quest_subtitle: "Moved: see Fission Logic Adapter"
	quest.4EBC20A78A27092C.quest_desc: [
		"&eMoved:&r this step is now \"Fission Logic Adapter\" on the Mekanism: Power page. Click to dismiss."
	]
	quest.19632E21E1396FA9.title: "A Nether Star"
	quest.19632E21E1396FA9.quest_subtitle: "The Fusion Chamber's heart"
	quest.19632E21E1396FA9.quest_desc: [
		"&eWhat:&r the Fusion Chamber controller needs a Nether Star."
		"&eHow:&r defeat a Wither (soul sand T, three wither skeleton skulls). Fight it in a sealed room, deep underground."
		"&eTip:&r save the skulls you find from now on: the Seed of a New World needs four more stars."
	]
	quest.57FE4088CA0A06F3.title: "Cadmium Rods"
	quest.57FE4088CA0A06F3.quest_subtitle: "Neutron sponges, cut to length"
	quest.57FE4088CA0A06F3.quest_desc: [
		"&eWhat:&r each cadmium control rod is 18 of these."
		"&eHow:&r smelt cadmium dust into ingots. Cutting Machine with lubricant: 1 ingot → 2 rods."
	]
	quest.110CE93790D8AAEE.title: "Uranium Rods"
	quest.110CE93790D8AAEE.quest_subtitle: "Fuel, cut to length"
	quest.110CE93790D8AAEE.quest_desc: [
		"&eWhat:&r each MI uranium fuel rod is 18 of these."
		"&eHow:&r Cutting Machine with lubricant: 1 uranium ingot → 2 rods."
	]
	quest.2144B44343C0BDB9.title: "Large Diesel Generator"
	quest.2144B44343C0BDB9.quest_subtitle: "Moved: see Large Diesel Generator"
	quest.2144B44343C0BDB9.quest_desc: [
		"&eMoved:&r this step is now \"Large Diesel Generator\" on the Power page. Click to dismiss."
	]
	chapter.45FF88D8CD5549A4.title: "VIII. Beyond the Sky"
	chapter.45FF88D8CD5549A4.chapter_subtitle: [
		"Leave the cradle. Make matter from energy. Seed a new world."
	]
	quest.7F5D0246011FE307.title: "Leaving the Cradle"
	quest.7F5D0246011FE307.quest_subtitle: "Every rocket starts on this bench"
	quest.7F5D0246011FE307.quest_desc: [
		"&6The stars were close once, close enough to touch. Time to stop looking at them from the ground.&r"
		"&eWhat:&r the NASA Workbench assembles every Ad Astra rocket."
		"&eHow:&r iron rods, steel plates, redstone torches and a steel block around an EV (highly advanced) hull, so processing units come first."
	]
	quest.2D71A1E8E2859236.title: "Rocket Parts"
	quest.2D71A1E8E2859236.quest_subtitle: "Nose cone, fins, tanks and an engine"
	quest.2D71A1E8E2859236.quest_desc: [
		"&eWhat:&r a Tier 1 rocket needs a nose cone, 4 fins, 2 steel tanks, a steel engine and 6 steel blocks."
		"&eChemistry:&r real rockets carry their own oxidiser (often liquid oxygen) as well as fuel, because there's no air to burn in once you're up. Ad Astra simplifies this: its tanks take fuel only (MI diesel, biodiesel or cryo fuel; see Rocket Fuel)."
		"&eHow:&r all parts are crafted from steel plates and rods (check JEI). The nose cone uses a lightning rod."
	]
	quest.06F69B817832C614.title: "Breathe"
	quest.06F69B817832C614.quest_subtitle: "Space has no air"
	quest.06F69B817832C614.quest_desc: [
		"&eWhat:&r the Oxygen Loader fills your space suit's tank."
		"&eChemistry:&r it accepts plain water, but 100 mB of water gives only 4 mB of oxygen. Pure O₂ from your electrolysis line (2H₂O → 2H₂ + O₂) goes in 1:1."
		"&eHow:&r helmet: 5 steel plates and a glass pane. Loader: steel plates, a fan, 2 gas tanks, a lightning rod and a redstone block. Pipe MI or Mekanism oxygen in, power it, and put the suit in the slot."
	]
	quest.494D2FBE3172520A.title: "The Full Suit"
	quest.494D2FBE3172520A.quest_subtitle: "Helmet alone won't do"
	quest.494D2FBE3172520A.quest_desc: [
		"&eWhat:&r the full set keeps you alive in vacuum and in the cold of the Moon."
		"&eHow:&r check JEI for each piece. Wear all four before launch."
		"&eTip:&r the chest piece holds the oxygen. Watch the gauge on your HUD."
	]
	quest.6DDB2C2ACDAA5443.title: "Launch Pad"
	quest.6DDB2C2ACDAA5443.quest_subtitle: "Somewhere to stand the rocket"
	quest.6DDB2C2ACDAA5443.quest_desc: [
		"&eWhat:&r rockets are placed on a launch pad, not on the bare ground."
		"&eHow:&r 5 steel plates and 4 steel rods. Place it in the open, with clear sky above."
		"&eTip:&r build a pad on each world you visit so you always have somewhere to land and relaunch."
	]
	quest.44A4B4888AF3AF27.title: "Rocket Fuel"
	quest.44A4B4888AF3AF27.quest_subtitle: "Ad Astra burns your diesel"
	quest.44A4B4888AF3AF27.quest_desc: [
		"&eWhat:&r in this pack rockets burn anything in the Ad Astra fuel tag: MI diesel or biodiesel, or Ad Astra's cryo fuel. Ad Astra's own oil refining is removed."
		"&eChemistry:&r a kilogram of diesel releases about 45 MJ when it burns: more than ten times a good battery."
		"&eHow:&r fill the rocket from buckets or pipes (check its GUI for how much it holds). Cryo fuel comes from Ad Astra's Cryo Freezer (check JEI)."
		"&eTip:&r bring spare fuel for the trip home."
	]
	quest.0C1DD95BA033EAB3.title: "One Small Step"
	quest.0C1DD95BA033EAB3.quest_subtitle: "Reach the Moon"
	quest.0C1DD95BA033EAB3.quest_desc: [
		"&6The Moon looks smaller than you remember. Or perhaps you were larger.&r"
		"&eHow:&r build the rocket in the NASA Workbench, place it on the pad, fuel it, climb in and launch. Pick the Moon on the planet screen."
		"&eTip:&r place a bed or waystone near your landing site before exploring."
	]
	quest.1B2FF1921BFAFACF.title: "Desh"
	quest.1B2FF1921BFAFACF.quest_subtitle: "Optional: the Moon's own metal"
	quest.1B2FF1921BFAFACF.quest_desc: [
		"&eWhat:&r desh is Ad Astra's lunar metal, needed for the Tier 2 rocket and oxygen equipment."
		"&eHow:&r mine desh ore on the Moon, smelt it, and press the ingots into plates in Ad Astra's Compressor."
		"&eTip:&r the Moon also has cheese ore. Really."
	]
	quest.17759B5826DD9CB6.title: "A Breathable Room"
	quest.17759B5826DD9CB6.quest_subtitle: "Moved: see Breathable Bases"
	quest.17759B5826DD9CB6.quest_desc: [
		"&eMoved:&r this step is now \"Breathable Bases\" on the Space page. Click to dismiss."
	]
	quest.243C3A96FE99DD8D.title: "Supercritical Phase Shifter"
	quest.243C3A96FE99DD8D.quest_subtitle: "A multiblock that turns polonium into antimatter"
	quest.243C3A96FE99DD8D.quest_desc: [
		"&eWhat:&r the SPS is Mekanism's largest machine. It needs huge amounts of power."
		"&eHow:&r Just Enough Mekanism Multiblocks shows the full layout in JEI. Ports (4 casings + an ultimate circuit) feed polonium in; the supercharged coil (copper, 2 ultimate circuits, a laser and polonium pellets) takes the power."
		"&eTip:&r feed it from a fission reactor and turbine, or several Flux Networks plugs."
	]
	quest.1CB50F40C6DA26D6.title: "Bottling Antimatter"
	quest.1CB50F40C6DA26D6.quest_subtitle: "Antimatter gas becomes a pellet"
	quest.1CB50F40C6DA26D6.quest_desc: [
		"&eWhat:&r the SPS outputs antimatter as a gas. The Chemical Crystallizer packs 1000 mB of it into one pellet."
		"&eHow:&r pipe antimatter from the SPS output port into the crystallizer."
		"&eTip:&r pipe the SPS straight into the crystallizer so the antimatter never sits in a tank."
	]
	quest.1E6BA9227B6B280F.title: "Antimatter"
	quest.1E6BA9227B6B280F.quest_subtitle: "Matter with every charge reversed"
	quest.1E6BA9227B6B280F.quest_desc: [
		"&6Matter from nothing but energy. Even the oldest part of you is impressed.&r"
		"&eChemistry:&r when matter meets antimatter both vanish into pure energy, E = mc². One gram of each releases about 1.8 × 10¹⁴ J."
		"&eHow:&r SPS → antimatter gas → Chemical Crystallizer → antimatter pellet."
		"&eTip:&r it's the most energy-dense substance there is. Antimatter Cores need four pellets each."
	]
	quest.25E45CBEE34D9D34.title: "Empty Energy Core"
	quest.25E45CBEE34D9D34.quest_subtitle: "A stainless shell around polonium"
	quest.25E45CBEE34D9D34.quest_desc: [
		"&eWhat:&r the vessel for the most concentrated energy you can hold."
		"&eChemistry:&r polonium gives off so much heat by decay that a gram of it glows. Here it seeds the core."
		"&eHow:&r craft: 4 stainless steel plates + 4 polonium pellets + a processing unit in the centre."
		"&eTip:&r the Complete Periodic Table quest rewards one empty core."
	]
	quest.4EF6FFBCA6DD55AD.title: "Charge the Core"
	quest.4EF6FFBCA6DD55AD.quest_subtitle: "About three million EU, poured into one item"
	quest.4EF6FFBCA6DD55AD.quest_desc: [
		"&eWhat:&r an empty core holds nothing until you charge it with raw electrical energy."
		"&eHow:&r MI Assembler at 512 EU/t for 6000 ticks: about 3 million EU per core."
		"&eTip:&r give it its own power line. A charging core will starve every other machine on the network."
	]
	quest.39868F66D40B59DD.title: "Antimatter Core"
	quest.39868F66D40B59DD.quest_subtitle: "The heart of the Seed"
	quest.39868F66D40B59DD.quest_desc: [
		"&6It hums in your hand like a small sun. You were this, once.&r"
		"&eWhat:&r a charged core, upgraded with antimatter and a quantum circuit."
		"&eHow:&r MI Assembler at 2048 EU/t for 6000 ticks: charged Energy Core + 4 antimatter pellets + 1 quantum circuit."
		"&eTip:&r the Seed needs eight. Start a production line, not a one-off."
	]
	quest.37BAEF06294D5602.title: "Made of Cheese"
	quest.37BAEF06294D5602.quest_subtitle: "Moved: see The Moon Is Cheese"
	quest.37BAEF06294D5602.quest_desc: [
		"&eMoved:&r this step is now \"The Moon Is Cheese\" on the Space page. Click to dismiss."
	]
	quest.17ABF0CEA1A27F7B.title: "Low Earth Orbit"
	quest.17ABF0CEA1A27F7B.quest_subtitle: "Optional: look down on home"
	quest.17ABF0CEA1A27F7B.quest_desc: [
		"&eWhat:&r every planet has an orbit dimension above it, a good place for a space station."
		"&eHow:&r pick Earth Orbit on the rocket's planet screen."
		"&eTip:&r bring building blocks and a way home."
	]
	quest.3AC9108E8851EEA2.title: "Grand Tour"
	quest.3AC9108E8851EEA2.quest_subtitle: "Optional: visit every planet"
	quest.3AC9108E8851EEA2.quest_desc: [
		"&eWhat:&r the Moon (Tier 1 rocket), Mars (Tier 2), Venus and Mercury (Tier 3) and Glacio (Tier 4)."
		"&eHow:&r a dimension task completes on arrival. Plan fuel and oxygen for each trip."
		"&eTip:&r Venus and Mercury are hot enough to cook an ordinary space suit. Bring the netherite one."
	]
	quest.2DD64AE9BEF9A844.title: "Heat-Proof Suit"
	quest.2DD64AE9BEF9A844.quest_subtitle: "Optional: armour for hot planets"
	quest.2DD64AE9BEF9A844.quest_desc: [
		"&eWhat:&r the netherite space suit survives the heat of Venus and Mercury."
		"&eHow:&r the chest piece is a netherite chestplate with ostrum plates (from Mars), gas tanks and an oxygen gear. Check JEI for the rest."
	]
	quest.5F38F7B1EF8C809A.title: "Glacio"
	quest.5F38F7B1EF8C809A.quest_subtitle: "Optional: the frozen planet in another system"
	quest.5F38F7B1EF8C809A.quest_desc: [
		"&eWhat:&r Glacio orbits another star and needs a Tier 4 rocket built from calorite."
		"&eHow:&r calorite comes from Venus. The tanks, engine and blocks are all calorite (check JEI)."
		"&eTip:&r it's the only planet outside our solar system. Take a look at the sky."
	]
	quest.4E04F8FE399BBE55.title: "Antiprotonic Nucleosynthesizer"
	quest.4E04F8FE399BBE55.quest_subtitle: "Moved: see Antiprotonic Nucleosynthesizer"
	quest.4E04F8FE399BBE55.quest_desc: [
		"&eMoved:&r this step is now \"Antiprotonic Nucleosynthesizer\" on the Mekanism: Power page. Click to dismiss."
	]
	quest.1A9E3337C7DEAE2B.title: "Cryofluid"
	quest.1A9E3337C7DEAE2B.quest_subtitle: "Argon and helium, colder than anything"
	quest.1A9E3337C7DEAE2B.quest_desc: [
		"&eWhat:&r cryofluid fills cooling cells and qubits. Superconductors only work this cold."
		"&eChemistry:&r liquid helium boils at −269 °C, four degrees above absolute zero. Nothing else stays liquid that cold."
		"&eHow:&r Vacuum Freezer: 140 mB argon + 60 mB helium → 200 mB cryofluid."
		"&eTip:&r the recipe draws 256 EU/t, more than a plain freezer allows. Put machine upgrades in it (Electrochemistry and Petrochemistry side quests)."
	]
	quest.75E50688ECDFF583.title: "Cooling Cells"
	quest.75E50688ECDFF583.quest_subtitle: "A bucket of cold, sealed in tin"
	quest.75E50688ECDFF583.quest_desc: [
		"&eWhat:&r cooling cells keep superconductor cable and quantum circuits below their critical temperature."
		"&eHow:&r Assembler: 3 fluid pipes, 2 small heat exchangers, 6 tin plates and 1000 mB cryofluid."
		"&eTip:&r every quantum circuit uses 2 directly, plus more inside its cable. Make a stack."
	]
	quest.647752E13B8E7FFC.title: "Superconductor Cable"
	quest.647752E13B8E7FFC.quest_subtitle: "Zero resistance, kept cold"
	quest.647752E13B8E7FFC.quest_desc: [
		"&eWhat:&r the cable of the quantum tier."
		"&eChemistry:&r below its critical temperature a superconductor carries current with no loss at all and pushes magnetic fields out (the Meissner effect)."
		"&eHow:&r Wiremill: 1 superconductor plate → 2 wire. Assembler: 3 wire + 2 cooling cells + 1000 mB PVC → 6 cable."
	]
	quest.72071E03AD4FE648.title: "Pure Carbon"
	quest.72071E03AD4FE648.quest_subtitle: "Coal, with everything else spun out"
	quest.72071E03AD4FE648.quest_desc: [
		"&eWhat:&r carbon plates hold each qubit."
		"&eChemistry:&r coal is carbon plus hydrogen, sulfur and ash. The Centrifuge spins the rest away."
		"&eHow:&r Centrifuge: 1 coal dust → 1 carbon dust. Compressor: carbon dust → carbon plate."
	]
	quest.5D33AA216320D3F3.title: "Tritium"
	quest.5D33AA216320D3F3.quest_subtitle: "Hydrogen with two neutrons"
	quest.5D33AA216320D3F3.quest_desc: [
		"&eWhat:&r every qubit needs 50 mB of tritium."
		"&eChemistry:&r tritium (³H) is radioactive, with a half-life of about 12 years. Real tritium is bred in reactors by hitting lithium or deuterium with neutrons."
		"&eHow:&r Centrifuge: 1000 mB hydrogen → 20 mB deuterium + 1 mB tritium. That's slow; the Nuclear Reactor turns fluids in its fluid hatches into heavier isotopes much faster (check JEI under the reactor)."
	]
	quest.4384A7C5B8E334FB.title: "Qubits"
	quest.4384A7C5B8E334FB.quest_subtitle: "A bit that is both until you look"
	quest.4384A7C5B8E334FB.quest_desc: [
		"&eWhat:&r the core of a quantum circuit."
		"&eChemistry:&r a qubit holds a superposition of 0 and 1. Real ones are superconducting loops kept a hair above absolute zero, which is why yours needs cryofluid."
		"&eHow:&r Assembler: 2 arithmetic logic units, 2 carbon plates, 2 glass panes, 6 superconductor wire, 250 mB cryofluid and 50 mB tritium."
	]
	quest.32F2BF68A18309D7.title: "Plutonium Battery"
	quest.32F2BF68A18309D7.quest_subtitle: "Power from decay"
	quest.32F2BF68A18309D7.quest_desc: [
		"&eWhat:&r the quantum tier's battery: the circuit board and the quantum hull each take two."
		"&eChemistry:&r radioisotope generators turn decay heat into electricity. The Voyager probes still run on plutonium-238, launched in 1977."
		"&eHow:&r Assembler: a battery alloy plate, 4 battery alloy curved plates, 2 superconductor cable and 2 MI plutonium dust."
	]
	quest.12237BFAFD2ECDED.title: "Helium-3"
	quest.12237BFAFD2ECDED.quest_subtitle: "The rarest helium"
	quest.12237BFAFD2ECDED.quest_desc: [
		"&eWhat:&r every quantum circuit board needs 50 mB of helium-3."
		"&eChemistry:&r helium-3 has one neutron instead of two. Earth has almost none; the Moon's soil holds more, implanted by the solar wind."
		"&eHow:&r Centrifuge: 1000 mB helium → 5 mB helium-3. That's 10 buckets of helium per board, so tap every helium source you have."
	]
	quest.2668316C90F7DEAA.title: "Quantum Circuit Board"
	quest.2668316C90F7DEAA.quest_subtitle: "Superconductor, plutonium and iridium"
	quest.2668316C90F7DEAA.quest_desc: [
		"&eHow:&r Assembler: a processing unit board, 12 superconductor cable, 2 plutonium batteries, 6 iridium plates and 50 mB helium-3."
		"&eTip:&r the iridium plates are the slow part: each one is an implosion. Plan for 6 per board."
	]
	quest.53D0FAD0F5540C32.title: "Quantum Circuit"
	quest.53D0FAD0F5540C32.quest_subtitle: "The IV circuit, and the Seed's last secret"
	quest.53D0FAD0F5540C32.quest_desc: [
		"&6A thought that holds every answer until it is asked. This one you didn't remember. You built it.&r"
		"&eWhat:&r the top MI circuit. Each Antimatter Core needs one, so the Seed needs eight."
		"&eHow:&r Assembler: 4 processing units, 2 cooling cells, 2 qubits and a quantum circuit board."
		"&eTip:&r automate the whole line before you need eight. Cooling cells and helium-3 are the slow parts."
	]
	quest.23EA3647A908E952.title: "Quantum Hull"
	quest.23EA3647A908E952.quest_subtitle: "Optional: the IV machine hull"
	quest.23EA3647A908E952.quest_desc: [
		"&eWhat:&r the base of MI's fusion reactor, replicator and quantum machines (Creation chapter)."
		"&eHow:&r Assembler: a quantum machine casing, a quantum circuit, 2 plutonium batteries and 3 superconductor cable."
	]
	quest.6C7D6DE142EE3F93.title: "Steel for the Ship"
	quest.6C7D6DE142EE3F93.quest_subtitle: "Plates and blocks, a whole hull's worth"
	quest.6C7D6DE142EE3F93.quest_desc: [
		"&eWhat:&r a Tier 1 rocket is mostly steel: 6 steel blocks in the body plus plates for every part around them."
		"&eHow:&r MI steel plates count as Ad Astra steel plates, and MI or Mekanism steel blocks as Ad Astra steel blocks. Your steel line already makes them."
		"&eTip:&r one more block and a few plates go into the NASA Workbench itself."
	]
	quest.61523CE96DFF035F.title: "Nose Cone"
	quest.61523CE96DFF035F.quest_subtitle: "Point it at the sky"
	quest.61523CE96DFF035F.quest_desc: [
		"&eWhat:&r the tip of the rocket."
		"&eChemistry:&r a rocket's nose takes the worst of the air's friction on the way up. Real cones are shaped to push the shock wave away from the body."
		"&eHow:&r a lightning rod on top of 4 steel plates."
	]
	quest.74E75282187BBBDB.title: "Fins"
	quest.74E75282187BBBDB.quest_subtitle: "Four, to keep it straight"
	quest.74E75282187BBBDB.quest_desc: [
		"&eWhat:&r fins keep the rocket pointed nose-first while it's still in the air."
		"&eHow:&r 6 steel plates → 4 fins."
	]
	quest.4EC783427EFDC360.title: "Gas Tanks"
	quest.4EC783427EFDC360.quest_subtitle: "Small pressure vessels"
	quest.4EC783427EFDC360.quest_desc: [
		"&eWhat:&r the steel tanks, the space suit and the Oxygen Loader each take two."
		"&eHow:&r an iron rod and 4 iron plates (MI iron plates work)."
	]
	quest.267AD1619973D069.title: "Fuel Tanks"
	quest.267AD1619973D069.quest_subtitle: "Where the diesel rides"
	quest.267AD1619973D069.quest_desc: [
		"&eWhat:&r the rocket carries its fuel in two steel tanks."
		"&eHow:&r a gas tank, a steel rod and 5 steel plates each."
	]
	quest.3B09953F94C52113.title: "Fans"
	quest.3B09953F94C52113.quest_subtitle: "Turbopump blades"
	quest.3B09953F94C52113.quest_desc: [
		"&eWhat:&r the engine and the Oxygen Loader each need a fan."
		"&eHow:&r 4 steel plates around a steel rod."
	]
	quest.43B9E13767C30682.title: "Engine Frame"
	quest.43B9E13767C30682.quest_subtitle: "A cage of steel rods"
	quest.43B9E13767C30682.quest_desc: [
		"&eWhat:&r the skeleton of the rocket engine."
		"&eHow:&r 8 steel rods around a steel plate."
	]
	quest.632B1C7B9603E35E.title: "Steel Engine"
	quest.632B1C7B9603E35E.quest_subtitle: "Fuel in, thrust out"
	quest.632B1C7B9603E35E.quest_desc: [
		"&eWhat:&r the engine that lifts a Tier 1 rocket."
		"&eChemistry:&r a rocket works by Newton's third law: hot gas thrown down fast pushes the rocket up. It needs nothing to push against, which is why it works in vacuum."
		"&eHow:&r an engine frame, a fan and 5 steel plates."
	]
	quest.47A0C8FA79699AB0.title: "Oxygen Gear"
	quest.47A0C8FA79699AB0.quest_subtitle: "The suit's regulator"
	quest.47A0C8FA79699AB0.quest_desc: [
		"&eWhat:&r the valve that feeds the suit's air to your helmet. The space suit and the Oxygen Distributor use one."
		"&eHow:&r 3 steel rods and 4 steel plates."
	]
	quest.6150D1C981380BDD.title: "HDPE Sheets"
	quest.6150D1C981380BDD.quest_subtitle: "Plastic armour for the SPS"
	quest.6150D1C981380BDD.quest_desc: [
		"&eWhat:&r every SPS casing is 4 HDPE sheets around polonium and plutonium."
		"&eHow:&r Enrichment Chamber: 3 HDPE pellets → 1 sheet."
	]
	quest.1F9FB98489AD3CB8.title: "SPS Casing"
	quest.1F9FB98489AD3CB8.quest_subtitle: "Polonium and plutonium, wrapped in plastic"
	quest.1F9FB98489AD3CB8.quest_desc: [
		"&eWhat:&r the walls of the Supercritical Phase Shifter."
		"&eHow:&r 4 HDPE sheets, 4 polonium pellets and 1 plutonium pellet per casing."
		"&eTip:&r the whole shell needs many more than four. Just Enough Mekanism Multiblocks in JEI gives the exact count; start your pellet lines early."
	]
	quest.337E7617284AA92C.title: "Laser"
	quest.337E7617284AA92C.quest_subtitle: "Light, amplified"
	quest.337E7617284AA92C.quest_desc: [
		"&eWhat:&r the SPS's supercharged coil is built around a Mekanism laser."
		"&eChemistry:&r laser stands for Light Amplification by Stimulated Emission of Radiation: excited atoms are triggered to release identical photons, all in step."
		"&eHow:&r 3 reinforced alloy, 2 energy tablets, a steel casing and a diamond."
	]
	quest.6AA2AE9C9E9B347D.title: "Superconductor Dust"
	quest.6AA2AE9C9E9B347D.quest_subtitle: "Iridium, copper and two rare earths"
	quest.6AA2AE9C9E9B347D.quest_desc: [
		"&eWhat:&r the mixed powder that becomes superconductor."
		"&eChemistry:&r real high-temperature superconductors are copper oxides layered with yttrium and rare earths, like YBa₂Cu₃O₇. MI's mix borrows the idea: copper, yttrium and neodymium."
		"&eHow:&r Mixer: 1 iridium + 3 annealed copper + 3 yttrium + 2 neodymium dust → 9 superconductor dust."
	]
	quest.6B8CBB0B7768D95A.title: "Superconductor Ingots"
	quest.6B8CBB0B7768D95A.quest_subtitle: "Melted hot, frozen fast"
	quest.6B8CBB0B7768D95A.quest_desc: [
		"&eWhat:&r superconductor as metal."
		"&eHow:&r Kanthal-tier Electric Blast Furnace → hot ingot → Vacuum Freezer (or the Heat Exchanger, which gives argon and helium back)."
	]
	quest.781F6CAF5F4C04B9.title: "Superconductor Plates"
	quest.781F6CAF5F4C04B9.quest_subtitle: "Flatten it for the wiremill"
	quest.781F6CAF5F4C04B9.quest_desc: [
		"&eWhat:&r plates become superconductor wire."
		"&eHow:&r Compressor: 1 ingot → 1 plate."
	]
	quest.05DCDF8E7AE0C37C.title: "Iridium Plates"
	quest.05DCDF8E7AE0C37C.quest_subtitle: "The rarest metal, pressed by explosion"
	quest.05DCDF8E7AE0C37C.quest_desc: [
		"&eWhat:&r each quantum circuit board takes 6 iridium plates."
		"&eChemistry:&r iridium is the most corrosion-resistant metal known. A thin layer of it marks the 66-million-year-old boundary left by the asteroid that ended the dinosaurs."
		"&eHow:&r Packer: 2 blastproof alloy ingots + 1 iridium ingot → mixed iridium ingot. Implosion Compressor: mixed ingot + Industrial TNT → 1 iridium plate."
	]
	quest.1EA8E5E4724F249F.title: "Quantum Casing"
	quest.1EA8E5E4724F249F.quest_subtitle: "Optional: an EV hull in iridium"
	quest.1EA8E5E4724F249F.quest_desc: [
		"&eWhat:&r the shell of the quantum (IV) hull, which the Creation chapter's machines are built on."
		"&eHow:&r 8 iridium plates around a highly advanced (EV) machine hull."
	]
	chapter.232C6148722A8576.title: "The Seed of a New World"
	chapter.232C6148722A8576.chapter_subtitle: [
		"Every tier in one 9x9 grid. The act of making a world."
	]
	quest.27A09B9B53019B2A.title: "The Last Recipe"
	quest.27A09B9B53019B2A.quest_subtitle: "One grid, thirteen ingredients"
	quest.27A09B9B53019B2A.quest_desc: [
		"&6Now it comes back, what all of this was for. Not machines. A world.&r"
		"&eWhat:&r the Seed of a New World is the pack's final craft: a 9x9 Ultimate Table recipe that uses something from every tier you've climbed."
		"&eHow:&r every ingredient has its own branch, from raw material to finished part, and each branch ends in a checklist quest with the exact count. Finish all eight checklists and the Ultimate Table, and the Seed opens."
		"&eTip:&r you can start the cheap lines (coke, water, acids, plastic) right away. The Antimatter Cores at the bottom take the longest."
		"{@pagebreak}"
		"&eThe full recipe:&r 4 coke, 8 ChemLib water, 4 hydrogen, 4 hydrofluoric acid buckets, 8 sulfuric acid buckets, 12 polyethylene buckets, 8 processing units, 4 stainless steel plates, 8 oganesson, 4 plutonium pellets, 4 polonium pellets, 4 Nether Stars, 8 Antimatter Cores and 1 Dragon Egg. 81 slots, every one filled."
		"&eWhy these:&r read them in order and they retell the climb: fire (coke), the elements (synthesized water), the Acid Age (sulfuric and hydrofluoric acid), the Oil Age, the machine ages, the atomic age, and the energy you learned to bottle at the end."
		"&eWhere:&r the Extended Crafting Ultimate Table (9x9). JEI shows the layout; press U on the Seed."
	]
	quest.6D36DDBCE1D2EF87.title: "Coke"
	quest.6D36DDBCE1D2EF87.quest_subtitle: "The fuel that started your steel"
	quest.6D36DDBCE1D2EF87.quest_desc: [
		"&eWhat:&r the four corners of the Seed are coke, the first thing your coke oven ever made."
		"&eChemistry:&r coke is coal baked without air. Heat drives off water, tar and coal gas, leaving a hard, porous lump that is mostly carbon."
		"&eHow:&r any coke oven or MI Coke Oven. Four pieces."
		"&eTip:&r it's fitting that the last recipe starts with the first fuel."
		"{@pagebreak}"
		"&eDeep dive: why coke, not coal?&r"
		"Raw coal is full of volatile hydrocarbons and sulfur. In a blast furnace they would boil off, foul the iron and choke the burden."
		"Coking (about 1000 °C, no oxygen) cooks them out. What's left is strong enough to carry the weight of ore above it and burns hot and clean."
		"In the furnace, coke does two jobs: it burns for heat, and its carbon monoxide strips oxygen from iron oxide: Fe₂O₃ + 3CO → 2Fe + 3CO₂."
	]
	quest.226A4C5E8144864D.title: "Hydrogen, Element 1"
	quest.226A4C5E8144864D.quest_subtitle: "The simplest atom there is"
	quest.226A4C5E8144864D.quest_desc: [
		"&eWhat:&r the Seed takes 4 hydrogen itself, and its 8 synthesized water need 16 more to build. Start with a dozen and keep the Dissolver running."
		"&eChemistry:&r one proton and one electron. Hydrogen makes up about three quarters of all the ordinary matter in the universe by mass."
		"&eHow:&r the Alchemistry Dissolver breaks ChemLib water into 2 hydrogen + 1 oxygen. Other compounds give hydrogen too (check JEI)."
		"&eTip:&r it's the same element you used for the Potion of Flying back in Chapter II."
		"{@pagebreak}"
		"&eDeep dive: the first element&r"
		"Almost all the hydrogen in existence was made in the first few minutes after the Big Bang. Every other element was built from it later, inside stars."
		"Stars fuse hydrogen into helium. Bigger stars go on to carbon, oxygen and up to iron. Heavier elements need supernovae and neutron-star collisions."
		"So hydrogen is the right place to start a new world: it's where the old one started too."
	]
	quest.5B4E365A4D8B860A.title: "Synthesized Water"
	quest.5B4E365A4D8B860A.quest_subtitle: "H₂O, built one molecule at a time"
	quest.5B4E365A4D8B860A.quest_desc: [
		"&eWhat:&r 8 ChemLib water, made from elements rather than scooped from a lake."
		"&eChemistry:&r 2H₂ + O₂ → 2H₂O. The reaction releases a lot of energy: it's what powers a hydrogen fuel cell."
		"&eHow:&r Alchemistry Combiner: 2 hydrogen + 1 oxygen → 1 water."
		"&eTip:&r the Dissolver gives you the oxygen along with the hydrogen, so nothing is wasted."
		"{@pagebreak}"
		"&eDeep dive: why build water at all?&r"
		"You could pour a bucket. The point of the Seed is that every part of a world can be made from its elements, and water is the most important compound of all."
		"Water's bent shape (104.5° between the two O-H bonds) makes it polar. That polarity is why it dissolves salts, why ice floats, and why it holds so much heat."
		"No water, no life. It's on the Seed eight times."
	]
	quest.3B78A43C636B517A.title: "Sulfur"
	quest.3B78A43C636B517A.quest_subtitle: "Brimstone, in quantity"
	quest.3B78A43C636B517A.quest_desc: [
		"&eWhat:&r eight buckets of acid need 16 sulfur dust."
		"&eChemistry:&r sulfur is a yellow non-metal. Most of the world's supply comes from scrubbing it out of oil and gas, much as you do in petrochemistry."
		"&eHow:&r sulfuric purification of crude oil and fuels in the MI Chemical Reactor, or from ore processing byproducts (check JEI)."
	]
	quest.3295CA3D2D55ACB5.title: "The King of Chemicals"
	quest.3295CA3D2D55ACB5.quest_subtitle: "Sulfuric acid, one more time"
	quest.3295CA3D2D55ACB5.quest_desc: [
		"&eWhat:&r the acid that unlocked 5x ore processing. The Seed needs eight buckets."
		"&eChemistry:&r S + O₂ → SO₂, then 2SO₂ + O₂ → 2SO₃, then SO₃ + H₂O → H₂SO₄. MI's Chemical Reactor does it in one step from sulfur, oxygen and water."
		"&eHow:&r Chemical Reactor: 1 sulfur dust + 200 mB oxygen + 200 mB water → 500 mB sulfuric acid."
		"&eTip:&r one reactor makes the full 8000 mB in a few minutes."
		"{@pagebreak}"
		"&eDeep dive: the Contact Process&r"
		"Industry makes sulfuric acid by the contact process. Burning sulfur gives SO₂; a vanadium(V) oxide catalyst at about 450 °C turns it into SO₃."
		"SO₃ isn't simply added to water: the reaction is so violent it makes a mist of acid. It's absorbed into concentrated acid first (making oleum, H₂S₂O₇), then diluted."
		"More sulfuric acid is made than any other chemical. A country's output of it was once used as a measure of its industrial strength."
	]
	quest.0CEF6566B979F348.title: "Ethylene"
	quest.0CEF6566B979F348.quest_subtitle: "C₂H₄, the plastic monomer"
	quest.0CEF6566B979F348.quest_desc: [
		"&eWhat:&r the feedstock for polyethylene. 12 buckets of plastic need about 8.6 buckets of ethylene."
		"&eChemistry:&r ethylene has a carbon-carbon double bond. That bond is what lets thousands of molecules link into a chain."
		"&eHow:&r steam-crack naphtha or light fuel and distil the result, or dehydrate ethanol in the Chemical Reactor (check JEI)."
	]
	quest.7518F6AC8A7D7AA9.title: "Polymerise"
	quest.7518F6AC8A7D7AA9.quest_subtitle: "Many small molecules, one long chain"
	quest.7518F6AC8A7D7AA9.quest_desc: [
		"&eWhat:&r the Seed uses 12 buckets of polyethylene, more than any other ingredient."
		"&eChemistry:&r n C₂H₄ → (–CH₂–CH₂–)ₙ. The double bond opens and each monomer joins the next."
		"&eHow:&r Chemical Reactor: 500 mB ethylene + a tiny pile of chromium (or lead) dust → 700 mB polyethylene."
		"&eTip:&r the chromium is a catalyst in real life too (see the next page)."
		"{@pagebreak}"
		"&eDeep dive: catalysts that make plastic&r"
		"Most of the world's high-density polyethylene is made with chromium catalysts (the Phillips process) or titanium-aluminium ones (Ziegler-Natta)."
		"The metal centre grabs an ethylene molecule and slots it into the growing chain, again and again. The result is a long, straight chain that packs tightly: strong, stiff plastic."
		"Without a catalyst you need huge pressures and get a branched, softer plastic (LDPE). Same formula, different shape, different material."
	]
	quest.16A26034057BB6C8.title: "Eight Processing Units"
	quest.16A26034057BB6C8.quest_subtitle: "The EV brain, eight times over"
	quest.16A26034057BB6C8.quest_desc: [
		"&eWhat:&r processing units are MI's EV circuits. The Seed takes eight, and each Energy Core needs one more."
		"&eChemistry:&r they're built on PVC boards. PVC is polyethylene with a chlorine atom on every other carbon, which makes it harder and flame-resistant."
		"&eHow:&r MI Assembler (check JEI). Queue sixteen: eight for the Seed and eight for the cores."
		"&eTip:&r processing units are slow. Start them first and let them run while you do the other lines."
	]
	quest.2AC1B7061B4071EE.title: "Stainless Steel"
	quest.2AC1B7061B4071EE.quest_subtitle: "Steel that guards itself"
	quest.2AC1B7061B4071EE.quest_desc: [
		"&eWhat:&r 4 plates for the Seed itself and 4 for each of the 8 Energy Core shells: 36 in all."
		"&eChemistry:&r stainless steel is iron with at least 10.5% chromium, often with nickel. The chromium forms a thin Cr₂O₃ film that heals itself when scratched."
		"&eHow:&r plates from stainless steel ingots in the Compressor. Ingots from the Electric Blast Furnace (check JEI)."
		"{@pagebreak}"
		"&eDeep dive: passivation&r"
		"Ordinary iron rusts because its oxide flakes off and exposes fresh metal. Chromium oxide does the opposite: it's a dense layer a few nanometres thick that sticks."
		"Scratch it and the exposed chromium reacts with oxygen in the air and seals the gap within moments. That's why stainless steel stays shiny."
		"Nickel keeps the steel in its austenite form at room temperature: tough, non-magnetic and easy to work."
	]
	quest.0EC50EEC62D9F3F6.title: "Oganesson ×8"
	quest.0EC50EEC62D9F3F6.quest_subtitle: "Element 118, eight times"
	quest.0EC50EEC62D9F3F6.quest_desc: [
		"&eWhat:&r the last element on the periodic table. You made one to finish the table; the Seed wants eight."
		"&eChemistry:&r oganesson-294 has a half-life of under a millisecond. Only a handful of atoms have ever been made."
		"&eHow:&r Alchemistry Fusion Chamber: fuse two elements whose atomic numbers add up to 118 (check JEI for the pairs)."
		"&eTip:&r automate the inputs. Eight by hand is a long afternoon."
		"{@pagebreak}"
		"&eDeep dive: making element 118&r"
		"In 2002 a team in Dubna, Russia fired calcium-48 ions (20 protons) at a californium-249 target (98 protons). 20 + 98 = 118."
		"Over months of beam time they saw about three atoms. Each decayed by alpha emission within a millisecond, into livermorium (116)."
		"It sits in the noble gas column, but it may not behave like one: its electrons move so fast that relativity smears out its shells. Your Fusion Chamber does the same addition, rather more reliably."
	]
	quest.1CCD67EEFD869A89.title: "Plutonium Pellets"
	quest.1CCD67EEFD869A89.quest_subtitle: "Element 94, from your reactor's waste"
	quest.1CCD67EEFD869A89.quest_desc: [
		"&eWhat:&r four plutonium pellets for the Seed."
		"&eChemistry:&r uranium-238 in a reactor captures a neutron and decays twice: U-238 → U-239 → Np-239 → Pu-239."
		"&eHow:&r Mekanism: nuclear waste → Isotopic Centrifuge → plutonium → Chemical Crystallizer → pellet."
		"&eTip:&r a running fission reactor makes waste whether you want it or not. This is a good use for it."
	]
	quest.6C44C6845C242921.title: "Polonium Pellets"
	quest.6C44C6845C242921.quest_subtitle: "Element 84, in bulk"
	quest.6C44C6845C242921.quest_desc: [
		"&eWhat:&r 4 pellets for the Seed and 4 for each of the 8 Energy Core shells: 36 in all. Polonium also feeds the SPS that makes antimatter."
		"&eChemistry:&r Marie and Pierre Curie found polonium in 1898 and named it after Poland. Po-210 is so radioactive that a gram of it glows from its own heat."
		"&eHow:&r Mekanism: nuclear waste → Solar Neutron Activator → polonium → Chemical Crystallizer → pellet."
		"&eTip:&r activators only work in daylight. Build a row of them, not one."
	]
	quest.5C3E6875CBAE0E55.title: "The Wither"
	quest.5C3E6875CBAE0E55.quest_subtitle: "Four stars means four fights"
	quest.5C3E6875CBAE0E55.quest_desc: [
		"&eWhat:&r every Nether Star comes from a Wither. The Seed needs four."
		"&eHow:&r soul sand T-shape, three wither skeleton skulls on top. Fight it somewhere you don't mind losing."
		"&eTip:&r fight it underground or in a sealed box so it can't fly off, and bring milk for the wither effect."
	]
	quest.2DF7AB2F8A372D6E.title: "The Dragon"
	quest.2DF7AB2F8A372D6E.quest_subtitle: "The egg sits at the very centre"
	quest.2DF7AB2F8A372D6E.quest_desc: [
		"&eWhat:&r the Dragon Egg is the Seed's centre slot."
		"&eHow:&r kill the Ender Dragon. The egg appears on top of the exit portal. Push it off with a piston or knock it onto a torch; clicking it makes it teleport."
		"&eTip:&r if someone on the server already took the egg, there's another way. Look into the Antiprotonic Nucleosynthesizer."
	]
	quest.0571A0A13F5FE83E.title: "Thirty-Two Antimatter Pellets"
	quest.0571A0A13F5FE83E.quest_subtitle: "The bulk of the work"
	quest.0571A0A13F5FE83E.quest_desc: [
		"&eWhat:&r each Antimatter Core takes 4 antimatter pellets, so eight cores need 32."
		"&eChemistry:&r an antiproton has the proton's mass and the opposite charge. When one meets a proton both vanish into energy (and a spray of lighter particles)."
		"&eHow:&r SPS → antimatter gas → Chemical Crystallizer. Keep both running non-stop."
		"&eTip:&r a second SPS halves the wait, if you can feed it the polonium and the power."
		"{@pagebreak}"
		"&eDeep dive: how much energy?&r"
		"E = mc². Annihilating 1 gram of antimatter with 1 gram of matter releases about 1.8 × 10¹⁴ J, roughly the energy of a 43-kiloton explosion."
		"Real labs (CERN's Antiproton Decelerator) have made only nanograms in decades, and keep them for minutes at most in magnetic traps."
		"Your SPS is far kinder than physics, but it still asks for a lot of power. That's the price of reversing every charge in an atom."
	]
	quest.028FCEE75EB61B76.title: "Eight Quantum Circuits"
	quest.028FCEE75EB61B76.quest_subtitle: "One for every core"
	quest.028FCEE75EB61B76.quest_desc: [
		"&eWhat:&r MI's top circuit. Each Antimatter Core needs one."
		"&eHow:&r MI Assembler (check JEI). Quantum circuit boards come first."
		"&eTip:&r quantum circuits also build the fusion reactor and the quantum armour in the Creation chapter. Make spares."
	]
	quest.25D884DA0739E05F.title: "Two Cores"
	quest.25D884DA0739E05F.quest_subtitle: "A production line, not a one-off"
	quest.25D884DA0739E05F.quest_desc: [
		"&eWhat:&r you've made one Antimatter Core. Make it two."
		"&eHow:&r Empty Energy Core (4 stainless plates, 4 polonium pellets, 1 processing unit) → MI Assembler at 512 EU/t to charge it → MI Assembler at 2048 EU/t with 4 antimatter pellets and 1 quantum circuit."
		"&eTip:&r two assemblers, one for each step, let the cores flow without you."
	]
	quest.5F8D7BB001543AF8.title: "Four Cores"
	quest.5F8D7BB001543AF8.quest_subtitle: "Halfway to eight"
	quest.5F8D7BB001543AF8.quest_desc: [
		"&eWhat:&r four Antimatter Cores. The Seed's diamond of power is half built."
		"&eHow:&r keep the line running. Each core is about 3 million EU to charge and 12 million more to upgrade."
		"&eTip:&r if your network sags while the assemblers run, give them their own generator."
		"{@pagebreak}"
		"&eDeep dive: the energy budget&r"
		"Charging: 512 EU/t × 6000 ticks = about 3.1 million EU. Upgrading: 2048 EU/t × 6000 ticks = about 12.3 million EU."
		"That's about 15 million EU per core, or about 123 million EU for all eight, before counting the SPS that makes the antimatter."
		"A fission reactor with a turbine, or a Mekanism fusion reactor, makes this a matter of hours. A wall of solar panels makes it a matter of weeks."
	]
	quest.4148D8D889253331.title: "Fire, Water and Hydrogen"
	quest.4148D8D889253331.quest_subtitle: "Seed checklist: where it all began"
	quest.4148D8D889253331.quest_desc: [
		"&eWhat:&r the Seed's corners and outer ring hold the first things you learned: coke from your coke oven, and water synthesized from its elements."
		"&eHow:&r 4 coke, 8 ChemLib water (Combiner: 2 hydrogen + 1 oxygen each) and 4 hydrogen, all held at once."
		"&eTip:&r both are cheap now. Make spares."
	]
	quest.73A2968AB5DB56B3.title: "Eight Buckets of Acid"
	quest.73A2968AB5DB56B3.quest_subtitle: "Seed checklist: the Acid Age"
	quest.73A2968AB5DB56B3.quest_desc: [
		"&eWhat:&r 8 buckets of sulfuric acid, the chemical that unlocked 5x ore processing."
		"&eHow:&r fill buckets from your sulfuric acid tanks. MI, Mekanism and ChemLib acid buckets all count, in any mix."
		"&eTip:&r buckets don't stack. Clear inventory space first, or keep them in a backpack."
	]
	quest.72FE1D8E4A9EFFBB.title: "Four Buckets of HF"
	quest.72FE1D8E4A9EFFBB.quest_subtitle: "Seed checklist: the acid that eats glass"
	quest.72FE1D8E4A9EFFBB.quest_desc: [
		"&eWhat:&r 4 buckets of hydrofluoric acid, the acid that opened the road to nuclear fuel."
		"&eChemistry:&r CaF₂ + H₂SO₄ → CaSO₄ + 2HF. HF is a weak acid by strength, yet it etches glass and soaks through skin: fluoride grabs silicon and calcium."
		"&eHow:&r Chemical Dissolution Chamber: fluorite + sulfuric acid → HF gas. A Rotary Condensentrator in liquid mode turns the gas into fluid; fill buckets from it."
		"&eTip:&r never store HF in glass, in real life. In game, a Mekanism fluid tank is fine."
	]
	quest.737B13A3F051EBCE.title: "Twelve Buckets of Plastic"
	quest.737B13A3F051EBCE.quest_subtitle: "Seed checklist: the Oil Age"
	quest.737B13A3F051EBCE.quest_desc: [
		"&eWhat:&r 12 buckets of polyethylene, the most of any ingredient."
		"&eHow:&r polymerise ethylene in the Chemical Reactor, as in Petrochemistry."
		"&eTip:&r fill them straight from your polymerisation reactor's output."
	]
	quest.4B92489590061799.title: "Circuits and Steel"
	quest.4B92489590061799.quest_subtitle: "Seed checklist: the machine ages"
	quest.4B92489590061799.quest_desc: [
		"&eWhat:&r 8 processing units and 4 stainless steel plates."
		"&eHow:&r both come from lines you already run. Keep these apart from the ones meant for Energy Cores."
		"&eTip:&r processing units are slow to make, so start these early."
	]
	quest.4C94606E9E477108.title: "Heavy Elements"
	quest.4C94606E9E477108.quest_subtitle: "Seed checklist: the atomic age"
	quest.4C94606E9E477108.quest_desc: [
		"&eWhat:&r 8 oganesson, 4 plutonium pellets and 4 polonium pellets."
		"&eHow:&r oganesson from the Fusion Chamber; pellets from your reactor's waste."
		"&eTip:&r keep 4 polonium pellets aside. The core shells will happily eat them all."
	]
	quest.6C1F822313ECDE4A.title: "Stars and an Egg"
	quest.6C1F822313ECDE4A.quest_subtitle: "Seed checklist: trophies of the old world"
	quest.6C1F822313ECDE4A.quest_desc: [
		"&eWhat:&r 4 Nether Stars, and the Dragon Egg at the very centre."
		"&eHow:&r defeat the Wither four times; kill the Ender Dragon for the egg."
		"&eTip:&r on a server, agree who crafts the Seed before anyone grabs the egg."
	]
	quest.13530533FFB056A9.title: "Eight Antimatter Cores"
	quest.13530533FFB056A9.quest_subtitle: "Seed checklist: the hardest part"
	quest.13530533FFB056A9.quest_desc: [
		"&eWhat:&r eight Antimatter Cores ring the centre of the recipe."
		"&eHow:&r that's 32 antimatter pellets, 32 polonium pellets, 32 stainless plates, 8 processing units and 8 quantum circuits in total."
		"&6Eight suns in your pack. You have carried heavier things.&r"
	]
	quest.3A6618C9323E34D8.title: "Seed of a New World"
	quest.3A6618C9323E34D8.quest_subtitle: "The endgame goal"
	quest.3A6618C9323E34D8.quest_desc: [
		"&6Every lesson, in one 9x9 grid. You hold it, and it holds a world.&r"
		"&eWhat:&r a recipe on the Ultimate Table that needs something from every tier."
		"&eHow:&r 4 coke, 8 water, 4 hydrogen, 4 hydrofluoric acid, 8 sulfuric acid, 12 polyethylene, 8 processing units, 4 stainless plates, 8 oganesson, 4 plutonium, 4 polonium, 4 Nether Stars, 8 Antimatter Cores, and the Dragon Egg at the centre."
		"&eTip:&r check JEI for the exact layout before you fill the table. One wrong slot and nothing happens."
		"{@pagebreak}"
		"&eDeep dive: reading the grid&r"
		"The pattern is symmetrical in every direction. Coke holds the four corners. Water and sulfuric acid line the outer ring, with hydrofluoric acid tucked just inside each corner. Plastic forms crosses on all four sides."
		"Stainless steel and processing units make an inner square. Oganesson, plutonium and Nether Stars sit closer in. Eight Antimatter Cores form a diamond around the centre."
		"And in the middle, one Dragon Egg: the only thing in the old world that was already a seed of something new."
	]
	quest.4EDA4951BC73B125.title: "Ultimate Auto Table"
	quest.4EDA4951BC73B125.quest_subtitle: "Optional: let the table fill itself"
	quest.4EDA4951BC73B125.quest_desc: [
		"&eWhat:&r an auto-crafting version of the Ultimate Table. Set the recipe once, then pipe the ingredients in."
		"&eHow:&r check JEI for the recipe. It needs power to craft."
		"&eTip:&r useful if your team wants a second Seed, or for the other 9x9 recipes in the pack."
	]
	quest.670A449A96D33FEA.title: "The Bill of Materials"
	quest.670A449A96D33FEA.quest_subtitle: "Optional: everything, counted from scratch"
	quest.670A449A96D33FEA.quest_desc: [
		"&eWhat:&r a shopping list for the whole Seed, Energy Cores included."
		"&eHow:&r read the next page, then tick this quest."
		"{@pagebreak}"
		"&eSeed only:&r 4 coke, 8 water, 4 hydrogen, 4 hydrofluoric acid buckets, 8 sulfuric acid buckets, 12 polyethylene buckets, 8 processing units, 4 stainless plates, 8 oganesson, 4 plutonium pellets, 4 polonium pellets, 4 Nether Stars, 1 Dragon Egg."
		"&eEight cores:&r 32 stainless plates, 32 polonium pellets, 8 processing units, 32 antimatter pellets, 8 quantum circuits, about 123 million EU."
		"&eGrand total:&r 36 stainless plates, 36 polonium pellets, 16 processing units, 32 antimatter pellets, 8 quantum circuits, plus everything above."
		"&eIn raw terms:&r 16 sulfur dust for the acid, 20 hydrogen (16 for the water, 4 as is) and 8 oxygen, fluorite and a little more sulfuric acid for the HF, about 8.6 buckets of ethylene."
	]
	quest.540E985F5EBBBAA4.title: "Four Withers"
	quest.540E985F5EBBBAA4.quest_subtitle: "Optional: one for every star"
	quest.540E985F5EBBBAA4.quest_desc: [
		"&eWhat:&r kill the Wither four times, once for each Nether Star in the Seed."
		"&eHow:&r a wither skeleton farm makes the skulls easy. Fight in a sealed bunker each time."
		"&eTip:&r Looting on your sword raises the skull drop chance from wither skeletons."
	]
	quest.13E910EB9FC8D13F.title: "A Second Egg"
	quest.13E910EB9FC8D13F.quest_subtitle: "Secret: a chicken egg, rewritten"
	quest.13E910EB9FC8D13F.quest_desc: [
		"&eWhat:&r you found it: the Antiprotonic Nucleosynthesizer turns an ordinary egg into a Dragon Egg with a little antimatter."
		"&eChemistry:&r nucleosynthesis means building heavier nuclei from lighter ones. Stars do it slowly. Mekanism does it with an egg and 4 mB of antimatter."
		"&eTip:&r now every player on the server can have a Seed of their own."
	]
	quest.118879F524410963.title: "Oxygen, Element 8"
	quest.118879F524410963.quest_subtitle: "One atom in every water molecule"
	quest.118879F524410963.quest_desc: [
		"&eWhat:&r 8 ChemLib oxygen, one for each of the Seed's 8 synthesized waters."
		"&eChemistry:&r oxygen is 89% of water by mass, even though water has twice as many hydrogen atoms. Oxygen atoms are 16 times heavier."
		"&eHow:&r the Alchemistry Dissolver gives oxygen along with hydrogen when it breaks down water and many other compounds."
	]
	quest.687B2E2758553F12.title: "Oxygen for the Reactor"
	quest.687B2E2758553F12.quest_subtitle: "MI oxygen, by the bucket"
	quest.687B2E2758553F12.quest_desc: [
		"&eWhat:&r the Chemical Reactor's acid recipe burns sulfur in MI oxygen: 200 mB per 500 mB of acid, so 3200 mB for eight buckets."
		"&eHow:&r Electrolyzer (water) or the Centrifuge (liquid air). Fill one bucket to prove the line runs."
	]
	quest.783101C98C52380D.title: "Fluorite for HF"
	quest.783101C98C52380D.quest_subtitle: "Four gems, four buckets"
	quest.783101C98C52380D.quest_desc: [
		"&eWhat:&r one fluorite gem dissolves into 1000 mB of HF, so four gems fill the Seed's four HF buckets."
		"&eChemistry:&r CaF₂ + H₂SO₄ → CaSO₄ + 2HF. Sulfuric acid is stronger and less volatile, so it pushes the hydrogen fluoride out of the mineral."
		"&eHow:&r mine fluorite ore deep down; the Enrichment Chamber turns its dust into gems."
	]
	quest.035552936C9CC1AD.title: "Hydrofluoric Acid"
	quest.035552936C9CC1AD.quest_subtitle: "The acid that eats glass"
	quest.035552936C9CC1AD.quest_desc: [
		"&eWhat:&r your first HF bucket for the Seed."
		"&eHow:&r Chemical Dissolution Chamber: fluorite gem + sulfuric acid gas → HF gas. Rotary Condensentrator (liquid mode) → fluid → bucket."
		"&eTip:&r three more and the checklist is done."
	]
	quest.747D8B5F4EBAFE17.title: "Naphtha"
	quest.747D8B5F4EBAFE17.quest_subtitle: "Sweet naphtha, ready to crack"
	quest.747D8B5F4EBAFE17.quest_desc: [
		"&eWhat:&r the start of the plastic branch: 12 buckets of polyethylene trace back to about 34 buckets of naphtha."
		"&eHow:&r Distillery (sour naphtha from crude), then hydrotreat it with hydrogen in the Chemical Reactor."
	]
	quest.431E3C111D7D1776.title: "Cracked Naphtha"
	quest.431E3C111D7D1776.quest_subtitle: "Steam snaps the chains"
	quest.431E3C111D7D1776.quest_desc: [
		"&eWhat:&r the mix that ethylene is distilled from."
		"&eHow:&r Chemical Reactor: 1000 mB naphtha + 100 mB steam → 1000 mB steam-cracked naphtha."
	]
	quest.45CBA864C0E23717.title: "Chromium Catalyst"
	quest.45CBA864C0E23717.quest_subtitle: "A pinch for every half bucket"
	quest.45CBA864C0E23717.quest_desc: [
		"&eWhat:&r one tiny chromium dust polymerises 500 mB of ethylene into 700 mB of polyethylene."
		"&eHow:&r craft 1 chromium dust into 9 tiny dusts. That's most of the 18 runs the Seed's plastic needs; make a second dust."
	]
	quest.36A880C6936B6142.title: "Stainless Dust"
	quest.36A880C6936B6142.quest_subtitle: "Thirty-six plates start as powder"
	quest.36A880C6936B6142.quest_desc: [
		"&eWhat:&r 36 stainless steel plates (4 for the Seed, 32 for the core shells) start as 36 dusts."
		"&eHow:&r Mixer: 6 iron + 1 chromium + 1 nickel + 1 manganese dust → 9 stainless dust. Four runs."
	]
	quest.7305B7360F75C170.title: "Stainless Ingots"
	quest.7305B7360F75C170.quest_subtitle: "Melted, then frozen"
	quest.7305B7360F75C170.quest_desc: [
		"&eWhat:&r the ingots for the Seed's plates."
		"&eHow:&r Electric Blast Furnace → hot ingot → Vacuum Freezer (or Heat Exchanger). Then Compressor → plates."
	]
	quest.149912253C241751.title: "PVC for the Boards"
	quest.149912253C241751.quest_subtitle: "1500 mB per board"
	quest.149912253C241751.quest_desc: [
		"&eWhat:&r every processing unit board is laminated with 1500 mB of PVC. Sixteen units (8 for the Seed, 8 for the cores) need 24 buckets."
		"&eHow:&r acetylene + HCl → vinyl chloride; polymerise with tiny chromium dust."
	]
	quest.2281D2193B9B8B09.title: "Platinum for the Boards"
	quest.2281D2193B9B8B09.quest_subtitle: "Four plates a board"
	quest.2281D2193B9B8B09.quest_desc: [
		"&eWhat:&r 16 platinum plates: enough for the first four boards."
		"&eHow:&r keep the Platinum Line (sludge → aqua regia → hexachloroplatinate → calcine) running the whole time you work on the Seed."
	]
	quest.699768E4CB2AD97D.title: "Processing Unit Boards"
	quest.699768E4CB2AD97D.quest_subtitle: "The first batch of four"
	quest.699768E4CB2AD97D.quest_desc: [
		"&eWhat:&r the base of every processing unit."
		"&eHow:&r Assembler: digital circuit board, 4 platinum plates, 2 cadmium batteries, 8 annealed copper cable and 1500 mB PVC."
	]
	quest.3578F45CC30FD508.title: "Chips by the Batch"
	quest.3578F45CC30FD508.quest_subtitle: "RAM, ALUs and MMUs for four units"
	quest.3578F45CC30FD508.quest_desc: [
		"&eWhat:&r each processing unit takes 2 RAM, 1 ALU and 1 MMU. This is the set for four."
		"&eHow:&r RAM in the Chemical Reactor (wafer, antimony, aluminium, argon, SBR); ALU and MMU in the Assembler."
		"&eTip:&r one silicon boule is 32 wafers. That covers the RAM and MMUs for all sixteen units."
	]
	quest.3BE6DAC608CC30EC.title: "Digital Circuits"
	quest.3BE6DAC608CC30EC.quest_subtitle: "Four per processing unit"
	quest.3BE6DAC608CC30EC.quest_desc: [
		"&eWhat:&r 16 digital circuits, enough for four processing units."
		"&eHow:&r Assembler: a digital circuit board, 4 electronic circuits, an AND, an OR and 2 NOT gates."
		"&eTip:&r all sixteen units need 64. Put three Assemblers on this branch alone."
	]
	quest.432CB13E3D97CF1F.title: "Fluorite for the Pellets"
	quest.432CB13E3D97CF1F.quest_subtitle: "One dust for every pellet"
	quest.432CB13E3D97CF1F.quest_desc: [
		"&eWhat:&r 4 plutonium pellets and 36 polonium pellets need 40 fluorite dust."
		"&eHow:&r Crusher: fluorite gem → dust. Occultism's crusher spirits give more per ore."
	]
	quest.11856EFB16276123.title: "Skulls and Soul Sand"
	quest.11856EFB16276123.quest_subtitle: "What it takes to summon a Wither"
	quest.11856EFB16276123.quest_desc: [
		"&eWhat:&r one Wither's worth: 3 wither skeleton skulls and 4 soul sand."
		"&eHow:&r wither skeletons in Nether fortresses drop skulls now and then; Looting helps. Soul sand is in Soul Sand Valleys."
	]
	quest.3452451FFB6B9832.title: "Four Nether Stars"
	quest.3452451FFB6B9832.quest_subtitle: "One for every arm of the cross"
	quest.3452451FFB6B9832.quest_desc: [
		"&eWhat:&r the Seed's four Nether Stars, held at once."
		"&eHow:&r four Withers. Each drops one star."
		"&eTip:&r the Fusion Chamber already ate one star. These four are for the Seed alone."
	]
	quest.28BCE1B0548E0D1B.title: "Eyes of Ender"
	quest.28BCE1B0548E0D1B.quest_subtitle: "Find the stronghold, fill the frame"
	quest.28BCE1B0548E0D1B.quest_desc: [
		"&eWhat:&r enough eyes to find a stronghold and light its portal."
		"&eHow:&r ender pearl + blaze powder. Throw one and follow it; it flies toward the nearest stronghold."
	]
	quest.76932732B6845616.title: "The End"
	quest.76932732B6845616.quest_subtitle: "Step through the portal"
	quest.76932732B6845616.quest_desc: [
		"&eWhat:&r the dragon's island."
		"&eTip:&r bring blocks, a bow and slow-falling potions. Flight makes the crystal towers far easier."
	]
	quest.4880E1F3DA45B03C.title: "Core Shells"
	quest.4880E1F3DA45B03C.quest_subtitle: "Stainless, polonium and a processing unit"
	quest.4880E1F3DA45B03C.quest_desc: [
		"&eWhat:&r empty Energy Cores, the first stage of every Antimatter Core."
		"&eHow:&r crafting table: 4 stainless steel plates around a processing unit, with 4 polonium pellets."
	]
	quest.68A1890A470FC805.title: "Charged Cores"
	quest.68A1890A470FC805.quest_subtitle: "Three million EU each"
	quest.68A1890A470FC805.quest_desc: [
		"&eWhat:&r Energy Cores filled with raw electrical energy."
		"&eHow:&r MI Assembler at 512 EU/t for 6000 ticks per core."
		"&eTip:&r a core takes five minutes to charge. A second Assembler doubles the pace."
	]
	quest.2CDCD5345B1E0774.title: "Eight Pellets"
	quest.2CDCD5345B1E0774.quest_subtitle: "Two cores' worth of antimatter"
	quest.2CDCD5345B1E0774.quest_desc: [
		"&eWhat:&r the first quarter of the 32 antimatter pellets."
		"&eHow:&r SPS → antimatter gas → Chemical Crystallizer, 1000 mB per pellet."
		"&eTip:&r if the SPS stalls, it's usually power or polonium. Watch both."
	]
	quest.0BC11E13D2CAFA40.title: "Boards and Qubits"
	quest.0BC11E13D2CAFA40.quest_subtitle: "Two quantum circuits' worth"
	quest.0BC11E13D2CAFA40.quest_desc: [
		"&eWhat:&r each quantum circuit is a board, 2 qubits, 2 cooling cells and 4 processing units."
		"&eHow:&r Assembler. The boards wait on helium-3 and iridium plates; the qubits on tritium and cryofluid."
		"&eTip:&r eight circuits need 8 boards and 16 qubits. Keep the helium-3 centrifuges running."
	]
	quest.0C2BF4800643D842.title: "Ultimate Components"
	quest.0C2BF4800643D842.quest_subtitle: "Black iron, luminessence and emerald"
	quest.0C2BF4800643D842.quest_desc: [
		"&eWhat:&r the 9x9 table needs 4 components and a catalyst made of 4 more."
		"&eHow:&r a black iron slate, luminessence and 2 emeralds each (crafting table)."
	]
	quest.664C835F0BE917DB.title: "Ultimate Catalyst"
	quest.664C835F0BE917DB.quest_subtitle: "The table's focus"
	quest.664C835F0BE917DB.quest_desc: [
		"&eWhat:&r the centre of the Ultimate Table recipe."
		"&eHow:&r 4 ultimate components around a black iron ingot. The table itself adds 2 elite tables, an emerald block and a processing unit (Monifactory page)."
	]
	chapter.5AFB176150767B83.title: "Creation"
	chapter.5AFB176150767B83.chapter_subtitle: [
		"The Seed is planted. Now shape what grows."
	]
	quest.699C8548A909219F.title: "A New World"
	quest.699C8548A909219F.quest_subtitle: "The demigod, restored"
	quest.699C8548A909219F.quest_desc: [
		"&6You took the world apart, element by element, and learned to build it again.&r"
		"Fire, steel, acid, oil, silicon, the atom, antimatter. Every tier was a lesson in chemistry, and you mastered them all."
		"&6The worlds out there are blank canvases now. Go make them yours.&r"
		"{@pagebreak}"
		"&eWhat now:&r this chapter is for after the Seed. Nothing here gates anything; it's what a demigod does with full power."
		"&eTo the right:&r making matter. Rewrite nuclei with antimatter, compress a singularity, build armour from a collapsed star."
		"&eTo the left:&r walking the worlds you can now reach, and holding the rarest parts of the periodic table in your hand."
	]
	quest.246A11D921704D57.title: "A Sample of Somewhere"
	quest.246A11D921704D57.quest_subtitle: "Bottle a biome"
	quest.246A11D921704D57.quest_desc: [
		"&6Every world you have walked through, you can carry with you.&r"
		"&eWhat:&r a Biome Capsule records the biome you stand in (sneak + right-click). It tells the Terraformer what to grow."
		"&eHow:&r glass bottle, rubber sheet and any sapling. Travel to the biome you want, then record it."
		"&eTip:&r capsules stack until filled; each one holds one biome."
	]
	quest.6DC38F2552EAF71E.title: "The Terraformer"
	quest.6DC38F2552EAF71E.quest_subtitle: "The Seed, planted"
	quest.6DC38F2552EAF71E.quest_desc: [
		"&6The Seed was never meant to stay in your pocket.&r"
		"&eWhat:&r the Terraformer (Warbucks Core) rewrites the biome around it, nearest chunks first, out to a 9x9 chunk area."
		"&eHow:&r craft it from the Seed of a New World, processing units, stainless plates and energy cores. Right-click it with a filled Biome Capsule, then with Charged Energy Cores (each powers 9 chunks; sneak to insert a stack). Right-click empty-handed for status."
		"{@pagebreak}"
		"&eWhat changes:&r grass and leaf colours, weather (rain or snow), and which mobs spawn, just like vanilla /fillbiome. Blocks you placed stay as they are."
		"&eTip:&r you can change it again later: a new capsule restarts the spread with the new biome."
	]
	quest.2BA7DDC2C439E998.title: "A World You Chose"
	quest.2BA7DDC2C439E998.quest_subtitle: "All 81 chunks"
	quest.2BA7DDC2C439E998.quest_desc: [
		"&6This is what the power was for.&r"
		"&eWhat:&r let a Terraformer finish its whole area (status shows 81 / 81), then tick this off."
		"&eTip:&r 9 Charged Energy Cores finish one Terraformer."
	]
	quest.2BE57BED6090B129.title: "Nucleosynthesis"
	quest.2BE57BED6090B129.quest_subtitle: "Turn one thing into another with antimatter"
	quest.2BE57BED6090B129.quest_desc: [
		"&6Making something out of nothing was once your trade. This is close.&r"
		"&eWhat:&r Mekanism's Antiprotonic Nucleosynthesizer feeds a few millibuckets of antimatter into an item and rebuilds it as something rarer."
		"&eChemistry:&r nucleosynthesis is how stars make elements: lighter nuclei fuse into heavier ones. This machine borrows the idea."
		"&eHow:&r check JEI for the recipe and the full list of transmutations. Pipe antimatter in from your SPS."
		"&eTip:&r it works slowly. Give it its own antimatter tank."
	]
	quest.4B42E676B0625A61.title: "Hearts of the Sea"
	quest.4B42E676B0625A61.quest_subtitle: "A Nether Star, rewritten"
	quest.4B42E676B0625A61.quest_desc: [
		"&eWhat:&r four Hearts of the Sea, each nucleosynthesized from a Nether Star with 5 mB of antimatter."
		"&eHow:&r Nether Star in, antimatter in, wait about a minute."
		"&eTip:&r a Heart of the Sea plus nautilus shells makes a Conduit: permanent water breathing and night vision around an ocean base."
	]
	quest.2B7A00AD7F472C4C.title: "Skulls on Demand"
	quest.2B7A00AD7F472C4C.quest_subtitle: "Two Withers' worth, no fortress"
	quest.2B7A00AD7F472C4C.quest_desc: [
		"&eWhat:&r six wither skeleton skulls, made from ordinary skeleton skulls with 5 mB of antimatter each."
		"&eHow:&r skeleton skulls drop when a charged creeper kills a skeleton, or from other sources (check JEI). Feed them to the Nucleosynthesizer."
		"&eTip:&r that's enough for two more Withers, and two more Nether Stars for a second Seed."
	]
	quest.0B60041E38BE73BA.title: "Echoes"
	quest.0B60041E38BE73BA.quest_subtitle: "Amethyst in, Ancient City loot out"
	quest.0B60041E38BE73BA.quest_desc: [
		"&eWhat:&r 32 echo shards, rebuilt from amethyst shards with 2 mB of antimatter each."
		"&eChemistry:&r real amethyst is quartz (SiO₂) coloured purple by traces of iron and natural radiation. Here it becomes something no chemist could make."
		"&eHow:&r amethyst shards from geodes or a budding amethyst farm. Nucleosynthesizer, 2 mB antimatter each."
		"&eTip:&r echo shards make Recovery Compasses, which point to where you last died."
	]
	quest.5980CE602A035671.title: "Sixty-Four Nukes"
	quest.5980CE602A035671.quest_subtitle: "Not for throwing"
	quest.5980CE602A035671.quest_desc: [
		"&eWhat:&r MI's Nuke block. Sixty-four of them are crushed together to make a singularity."
		"&eChemistry:&r a nuke combines fission (plutonium) and fusion fuel (deuterium and tritium, the heavy isotopes of hydrogen) around industrial TNT."
		"&eHow:&r MI Assembler: 6 industrial TNT, 4 plutonium ingots, 2 processing units, 4 nuclear alloy plates, 100 mB deuterium, 50 mB tritium → 2 nukes."
		"&eTip:&r that's 32 crafts, 64 processing units and 128 plutonium ingots. Automate it."
		"{@pagebreak}"
		"&eDeep dive: two kinds of nuclear energy&r"
		"Fission splits heavy nuclei like Pu-239 into lighter ones. Fusion joins light nuclei like deuterium (²H) and tritium (³H) into helium."
		"Both release energy because the products are more tightly bound than the inputs. Iron-56 sits at the bottom of that curve: nothing is gained by splitting it or fusing it."
		"Real thermonuclear weapons use a fission stage to compress and heat a fusion stage. MI's recipe follows the same idea."
	]
	quest.0F393E87019D7242.title: "A Singularity"
	quest.0F393E87019D7242.quest_subtitle: "Sixty-four nukes, one point"
	quest.0F393E87019D7242.quest_desc: [
		"&eWhat:&r MI's Singularity: an ultradense metal ball collapsed by 64 nukes in the Implosion Compressor."
		"&eHow:&r ultradense metal ball (tungsten large plates, lead plates and an iridium plate, check JEI) + 64 nukes → Implosion Compressor."
		"&eTip:&r it's never used up in the Electrolyzer: it slowly bleeds out UU-matter, 1 mB every 2500 ticks. Build several Electrolyzers and several singularities."
		"{@pagebreak}"
		"&eDeep dive: collapse&r"
		"A real singularity is the centre of a black hole, where matter is crushed past every limit we know. Stars more than about 20 times the Sun's mass end this way."
		"Before that, there's neutron-star matter: electrons are pushed into protons until only neutrons remain. A teaspoon would weigh about a billion tonnes."
		"MI's singularity is a game item, not physics. But the idea, matter compressed until it becomes a source of something new, fits a demigod well."
	]
	quest.5CF14C9A3DB9276D.title: "Quantum Upgrade"
	quest.5CF14C9A3DB9276D.quest_subtitle: "UU-matter, circuits and a singularity"
	quest.5CF14C9A3DB9276D.quest_desc: [
		"&eWhat:&r the part that turns netherite armour into MI quantum armour."
		"&eHow:&r MI Assembler: 32 highly advanced upgrades, 8 quantum circuits, 1 singularity, 1 quantum circuit board, 50 mB UU-matter."
		"&eTip:&r 50 mB of UU-matter takes one Electrolyzer and singularity about 1.7 hours (1 mB per 2500 ticks). More singularities, more Electrolyzers."
	]
	quest.73FDE51567B46CCC.title: "Quantum Armour"
	quest.73FDE51567B46CCC.quest_subtitle: "Armour fit for a god"
	quest.73FDE51567B46CCC.quest_desc: [
		"&6Once you needed no armour at all. This is the next best thing.&r"
		"&eWhat:&r MI's quantum armour: a full set, each piece a netherite piece plus a quantum upgrade."
		"&eHow:&r MI Packer: netherite armour piece + 1 quantum upgrade, 200 ticks at 1,000,000 EU/t. Four upgrades for four pieces."
		"&eTip:&r that draw is far above a plain Packer's limit. Check JEI and the MI guidebook for how machine upgrades raise it."
	]
	quest.2E4322C04DA4BF91.title: "Replicator"
	quest.2E4322C04DA4BF91.quest_subtitle: "Optional: copy anything with UU-matter"
	quest.2E4322C04DA4BF91.quest_desc: [
		"&eWhat:&r MI's Replicator copies items using UU-matter."
		"&eHow:&r MI Assembler: quantum machine hull, 2 quantum upgrades, 4 quantum circuits, 500 mB UU-matter. Check JEI for what it can copy."
		"&eTip:&r 500 mB is about 17 hours for one Electrolyzer. A long-term goal for a server, not a weekend."
	]
	quest.01EEDEE42183D76A.title: "A Star in a Box"
	quest.01EEDEE42183D76A.quest_subtitle: "MI's fusion reactor and plasma turbine"
	quest.01EEDEE42183D76A.quest_desc: [
		"&eWhat:&r MI's fusion reactor makes helium plasma; the plasma turbine turns it into a flood of EU."
		"&eChemistry:&r D + T → ⁴He + n. MI's reactor turns 1000 mB each of deuterium and tritium into helium plasma and hydrogen."
		"&eHow:&r fusion reactor: 6 fusion chambers, a quantum machine hull and 2 quantum circuits. Plasma turbine: 4 superconductor coils, 2 quantum circuits, 2 titanium rotors and a quantum hull. The multiblock layout is in JEI and the MI guidebook."
		"&eTip:&r deuterium-deuterium and helium-3 routes exist too (check JEI under the fusion reactor)."
		"{@pagebreak}"
		"&eDeep dive: why fusion is hard&r"
		"Nuclei are positively charged and repel each other. To fuse, they need temperatures over 100 million °C, hotter than the Sun's core."
		"The Sun manages at 15 million °C only because of its crushing gravity and its sheer size. On Earth we use magnetic bottles (tokamaks) or lasers instead."
		"In 2022 the US National Ignition Facility got more energy out of a fusion shot than its lasers put in, for the first time."
	]
	quest.5EFEE568ABAE16CE.title: "Sixty-Four Superconductors"
	quest.5EFEE568ABAE16CE.quest_subtitle: "Wire with no resistance at all"
	quest.5EFEE568ABAE16CE.quest_desc: [
		"&eWhat:&r a stack of MI superconductor ingots, the material of MI's best cables and coils."
		"&eChemistry:&r below a critical temperature, a superconductor carries current with zero resistance. Real high-temperature ones, like YBa₂Cu₃O₇, are copper oxides with yttrium and rare earths."
		"&eHow:&r Mixer: iridium, annealed copper, yttrium and neodymium dusts → superconductor dust. Electric Blast Furnace → hot ingot → Vacuum Freezer."
		"&eTip:&r the fusion chambers alone eat 30 superconductor coils (240 cables). Run several furnaces."
	]
	quest.4885EA03F81450DB.title: "Shining Alloy"
	quest.4885EA03F81450DB.quest_subtitle: "Mekanism Extras' antimatter alloy"
	quest.4885EA03F81450DB.quest_desc: [
		"&eWhat:&r Mekanism Extras' alloys go beyond atomic: radiance → thermonuclear → shining → spectrum. Shining is the first that needs antimatter."
		"&eHow:&r Nucleosynthesizer: enriched thermonuclear + antimatter → enriched shining. Metallurgic Infuser: thermonuclear alloy + shining infusion → shining alloy (check JEI)."
		"&eTip:&r these alloys build Mekanism Extras' higher tiers of factories, cables and energy cubes."
	]
	quest.60D90CB55CC28586.title: "A Stack of Atomic Alloy"
	quest.60D90CB55CC28586.quest_subtitle: "Quantity is its own kind of power"
	quest.60D90CB55CC28586.quest_desc: [
		"&eWhat:&r 64 atomic alloys, Mekanism's top standard alloy."
		"&eHow:&r Metallurgic Infuser: reinforced alloy + refined obsidian dust (check JEI). Each step up uses the alloy before it."
		"&eTip:&r a Metallurgic Infusing Factory makes this a matter of minutes."
	]
	quest.4DED552C15CC21B1.title: "Quantum Compressor"
	quest.4DED552C15CC21B1.quest_subtitle: "Ten thousand of anything, made one"
	quest.4DED552C15CC21B1.quest_desc: [
		"&eWhat:&r Extended Crafting's Quantum Compressor squeezes huge amounts of one material into a singularity."
		"&eHow:&r crafting table: black iron ingots, a black iron slate, 2 elite components, 2 elite catalysts and a frame (check JEI)."
		"&eTip:&r it uses 5,000 FE/t and holds 10 million FE. Power it well."
	]
	quest.27F6CADD94271013.title: "Your First Singularity"
	quest.27F6CADD94271013.quest_subtitle: "Ten thousand ingots in one item"
	quest.27F6CADD94271013.quest_desc: [
		"&eWhat:&r any Extended Crafting singularity: iron, copper, gold, steel, aluminium, platinum and more."
		"&eHow:&r insert 10,000 of one material into the Quantum Compressor, plus 5 million FE. Check JEI for the full list."
		"&eTip:&r iron or copper is the easiest first pick: your ore lines make thousands an hour."
	]
	quest.57580059AE02623F.title: "Ultimate Singularity"
	quest.57580059AE02623F.quest_subtitle: "Optional: every singularity, in one"
	quest.57580059AE02623F.quest_desc: [
		"&eWhat:&r one of every singularity, combined on the Ultimate Table."
		"&eHow:&r there are 19 singularities in this pack (check JEI for the list). That's about 190,000 items in total."
		"&eTip:&r this is a server project. Split the materials between players."
	]
	quest.78E502B19DD89147.title: "Worlds Within Worlds"
	quest.78E502B19DD89147.quest_subtitle: "Optional: a demigod should have rooms to spare"
	quest.78E502B19DD89147.quest_desc: [
		"&eWhat:&r Compact Machines are small rooms in their own dimension. You've made a new world; now make a few small ones."
		"&eHow:&r 64 machine walls, then step inside any of your machines with the Personal Shrinking Device."
		"&eTip:&r one room per production line keeps your main base clean and your server's tick time low."
	]
	quest.72095611C2C91CF1.title: "Rare Ground"
	quest.72095611C2C91CF1.quest_subtitle: "The Overworld's rarest places"
	quest.72095611C2C91CF1.quest_desc: [
		"&6You saw these places from above, long ago. Walk them this time.&r"
		"&eWhat:&r visit a Mushroom Fields island, an Ice Spikes plain and a Cherry Grove."
		"&eHow:&r Explorer's Compass or Nature's Compass (if you have one) finds biomes; otherwise fly and look. Each completes on arrival."
		"&eTip:&r Mushroom Fields never spawn hostile mobs. A good place for a quiet base."
	]
	quest.23B71F2FEF5E96E0.title: "Under Everything"
	quest.23B71F2FEF5E96E0.quest_subtitle: "Deep Dark, the Otherside, the Undergarden"
	quest.23B71F2FEF5E96E0.quest_desc: [
		"&eWhat:&r the Deep Dark, the Otherside's Echoing Forest, and the Undergarden's Frostfields."
		"&eHow:&r the Deep Dark is under mountains in the Overworld; the Echoing Forest is in Deeper and Darker's Otherside; the Frostfields are in the Undergarden."
		"&eTip:&r the Warden still doesn't care how powerful you are. Sneak."
	]
	quest.6D98BE12A9AAC748.title: "Fire Below"
	quest.6D98BE12A9AAC748.quest_subtitle: "The Nether's strangest corners"
	quest.6D98BE12A9AAC748.quest_desc: [
		"&eWhat:&r a Soul Sand Valley and two of Biomes O' Plenty's rarer Nether biomes: the Crystalline Chasm and the Withered Abyss."
		"&eChemistry:&r soul sand and soul soil burn with a blue flame. Real blue flames mean complete combustion; these are just strange."
		"&eTip:&r the Withered Abyss has bottomless drops. Bring a way to fly."
	]
	quest.40787344DD5655A1.title: "Twilight Wanderer"
	quest.40787344DD5655A1.quest_subtitle: "Deep into the Twilight Forest"
	quest.40787344DD5655A1.quest_desc: [
		"&eWhat:&r the Enchanted Forest, the Glacier and the Highlands of the Twilight Forest."
		"&eHow:&r the Glacier and Highlands are locked behind Twilight bosses. If a biome hurts you, you haven't beaten the boss that guards it yet."
		"&eTip:&r the Enchanted Forest is small and rare. The Magic Map shows biomes as you explore."
	]
	quest.1BE80DCE67BFB851.title: "Gardens of the End"
	quest.1BE80DCE67BFB851.quest_subtitle: "The outer End islands"
	quest.1BE80DCE67BFB851.quest_desc: [
		"&eWhat:&r the End Highlands and three Biomes O' Plenty End biomes: the Wilds, the Reef and the Corruption."
		"&eHow:&r take an End Gateway out past the main island. The BOP biomes are scattered among the outer islands."
		"&eTip:&r End Cities in the Highlands hold Elytra and shulker shells."
	]
	quest.6778022C45172E21.title: "Other Skies"
	quest.6778022C45172E21.quest_subtitle: "Four planets, four strange landscapes"
	quest.6778022C45172E21.quest_desc: [
		"&eWhat:&r Mars's polar caps, Venus's infernal barrens, Mercury's deltas and Glacio's ice peaks."
		"&eChemistry:&r Mars's polar caps are water ice under a layer of frozen CO₂ (dry ice). Venus's air is 96% CO₂ at 90 times Earth's pressure."
		"&eHow:&r Tier 2 rocket for Mars, Tier 3 for Venus and Mercury, Tier 4 for Glacio. Netherite space suit for the hot ones."
		"&eTip:&r set up a launch pad on each planet before you go exploring."
	]
	quest.66C984FCB0A4C541.title: "A Breath of Noble Gas"
	quest.66C984FCB0A4C541.quest_subtitle: "64 of helium, neon, argon, krypton, xenon or radon"
	quest.66C984FCB0A4C541.quest_desc: [
		"&eWhat:&r any 64 noble gas items from ChemLib, in any mix."
		"&eChemistry:&r noble gases have full outer electron shells, so they almost never react. Neon glows red in a discharge tube; xenon glows blue; radon is radioactive."
		"&eHow:&r Alchemistry Dissolver on air-rich or gas-bearing items, or the Fusion Chamber (check JEI for which inputs give which gas)."
		"&eTip:&r helium is the lightest: fuse two hydrogen and you're there."
	]
	quest.323139D4D25E743E.title: "The Rare Earths"
	quest.323139D4D25E743E.quest_subtitle: "64 of any lanthanide, element 57 to 71"
	quest.323139D4D25E743E.quest_desc: [
		"&eWhat:&r any 64 lanthanide items from ChemLib: lanthanum through lutetium."
		"&eChemistry:&r the lanthanides fill the 4f electron shell, which sits deep inside the atom. That's why they're so alike and so hard to separate."
		"&eHow:&r Fusion Chamber (pairs that add up to 57-71) or the Dissolver on rare-earth-bearing items (check JEI)."
		"&eTip:&r neodymium makes the strongest permanent magnets; europium makes red phosphors in screens."
		"{@pagebreak}"
		"&eDeep dive: why 'rare' earths?&r"
		"They aren't rare. Cerium is about as common as copper in the Earth's crust. They're 'rare' because they never form rich deposits on their own."
		"Separating them took chemists over a century. Their outer electrons are nearly the same, so their chemistry is nearly the same; only the slow shrinking of the atoms across the row (the lanthanide contraction) tells them apart."
		"Industry separates them by solvent extraction, hundreds of stages long. Your Fusion Chamber skips all that."
	]
	quest.4D22FC631684D41C.title: "Island of Stability"
	quest.4D22FC631684D41C.quest_subtitle: "64 superheavy atoms, elements 113 to 118"
	quest.4D22FC631684D41C.quest_desc: [
		"&eWhat:&r any 64 of the six newest elements: nihonium, flerovium, moscovium, livermorium, tennessine and oganesson."
		"&eChemistry:&r all six were made in the last 25 years, a few atoms at a time, and decay within seconds or less."
		"&eHow:&r Alchemistry Fusion Chamber. Automate the inputs and let it run."
		"&eTip:&r physicists predict an 'island of stability' near 114 protons and 184 neutrons, where superheavy nuclei might last much longer. No one has reached it yet."
	]
	quest.192E6C7744B27AF1.title: "Demigod"
	quest.192E6C7744B27AF1.quest_subtitle: "Nothing left to remember"
	quest.192E6C7744B27AF1.quest_desc: [
		"&6You don't remember being this any more. You simply are.&r"
		"&eWhat:&r you've planted the Seed, walked every world, built armour from a collapsed star, and held the whole periodic table."
		"&eNow:&r build. A city, a garden on Mars, a pocket world for every friend on the server. The tools are yours."
		"&6The new world is waiting. It's whatever you make it.&r"
	]
	quest.591A55827650C75D.title: "Pressure Not Required"
	quest.591A55827650C75D.quest_subtitle: "Secret: coal, rewritten into diamond"
	quest.591A55827650C75D.quest_desc: [
		"&eWhat:&r the Nucleosynthesizer turns coal into diamond with 4 mB of antimatter. You found it."
		"&eChemistry:&r both are carbon. Graphite and diamond differ only in how the atoms bond: sheets of rings versus a rigid 3D lattice. Nature needs about 50,000 atmospheres to make the change."
		"&eTip:&r 64 diamonds from 64 coal. Your younger self, swinging an iron pickaxe, would be furious."
	]
	quest.3783C72768169901.title: "Where It Began"
	quest.3783C72768169901.quest_subtitle: "Secret: the oldest-looking valley"
	quest.3783C72768169901.quest_desc: [
		"&eWhat:&r Biomes O' Plenty's Origin Valley, built to look like the very first versions of Minecraft."
		"&6Bright grass, roses, plain old trees. You remember a world this simple. It was the first one you made.&r"
		"&eTip:&r it's rare. If you found it by chance, consider it a gift."
	]
	quest.7CFB5EA488876EF2.title: "Ultradense Metal Ball"
	quest.7CFB5EA488876EF2.quest_subtitle: "The heaviest thing you can hold"
	quest.7CFB5EA488876EF2.quest_desc: [
		"&eWhat:&r the core that 64 nukes crush into a singularity."
		"&eChemistry:&r tungsten, lead and iridium are among the densest metals there are. Iridium and osmium tie for the record at about 22.6 g/cm³, twice as dense as lead."
		"&eHow:&r Assembler: 4 tungsten large plates, 4 lead plates and 1 iridium plate."
	]
	quest.233B19D95D6A965F.title: "Quantum Sword"
	quest.233B19D95D6A965F.quest_subtitle: "Moved: see Quantum Sword"
	quest.233B19D95D6A965F.quest_desc: [
		"&eMoved:&r this step is now \"Quantum Sword\" on the Gear and Comfort page. Click to dismiss."
	]
	quest.57ED01523BECF4AF.title: "Two Charged Cores"
	quest.57ED01523BECF4AF.quest_subtitle: "The Terraformer's battery"
	quest.57ED01523BECF4AF.quest_desc: [
		"&eWhat:&r the Terraformer is built around 2 charged Energy Cores, and every 9 chunks it reshapes burns one more."
		"&eHow:&r empty core (4 stainless plates, 4 polonium pellets, a processing unit) → MI Assembler at 512 EU/t for 6000 ticks."
		"&eTip:&r keep the charging Assembler running for the rest of the game."
	]
	quest.1670FB4D633E8794.title: "A Stack of Industrial TNT"
	quest.1670FB4D633E8794.quest_subtitle: "Six per pair of nukes"
	quest.1670FB4D633E8794.quest_desc: [
		"&eWhat:&r 32 nuke crafts take 192 Industrial TNT. Start with a stack."
		"&eChemistry:&r nitrogen compounds store energy because the N≡N triple bond they release is so stable. Making N₂ again sets it all free at once."
		"&eHow:&r Mixer: 4 sand + 3 flint + 250 mB toluene + 1000 mB nitrogen → 4 TNT."
	]
	quest.71380DE9F51A3043.title: "Plutonium Ingots"
	quest.71380DE9F51A3043.quest_subtitle: "Four per pair of nukes"
	quest.71380DE9F51A3043.quest_desc: [
		"&eWhat:&r 32 nuke crafts take 128 plutonium ingots. This is the first eighth."
		"&eChemistry:&r plutonium metal has six different crystal forms between room temperature and its melting point, more than any other element."
		"&eHow:&r Electric Blast Furnace (128 EU/t): 1 plutonium dust → 1 ingot. The dust comes from centrifuging depleted fuel rods."
	]
	quest.4F238266758C670E.title: "Deuterium and Tritium"
	quest.4F238266758C670E.quest_subtitle: "Heavy hydrogen, both kinds"
	quest.4F238266758C670E.quest_desc: [
		"&eWhat:&r every nuke craft takes 100 mB deuterium and 50 mB tritium; the fusion reactor burns both by the bucket."
		"&eChemistry:&r deuterium has one neutron, tritium two. Tritium is radioactive (half-life about 12 years), so nature has almost none."
		"&eHow:&r Centrifuge hydrogen, or let the Nuclear Reactor's fluid hatches turn hydrogen and deuterium into heavier isotopes (check JEI)."
	]
	quest.38F9B399FBFB3849.title: "The First Two"
	quest.38F9B399FBFB3849.quest_subtitle: "One craft, two nukes"
	quest.38F9B399FBFB3849.quest_desc: [
		"&eWhat:&r one Assembler run of MI's nuke recipe."
		"&eHow:&r Assembler at 32 EU/t: 6 industrial TNT, 4 plutonium ingots, 2 processing units, 4 nuclear alloy plates, 100 mB deuterium and 50 mB tritium → 2 nukes."
		"&eTip:&r 31 more runs to go. Automate the inputs before you start."
	]
	quest.25FA764E2EF26DBF.title: "Tungsten Large Plates"
	quest.25FA764E2EF26DBF.quest_subtitle: "The shell of the ultradense ball"
	quest.25FA764E2EF26DBF.quest_desc: [
		"&eWhat:&r the ultradense metal ball is wrapped in 4 tungsten large plates."
		"&eChemistry:&r tungsten is almost as dense as gold (19.3 g/cm³) and has the highest melting point of any metal, 3422 °C."
		"&eHow:&r Implosion Compressor makes tungsten ingots; Compressor → plates; 4 plates → 1 large plate."
	]
	quest.4683C61BBE57CF2A.title: "Thirty-Two Upgrades"
	quest.4683C61BBE57CF2A.quest_subtitle: "The bulk of a quantum upgrade"
	quest.4683C61BBE57CF2A.quest_desc: [
		"&eWhat:&r every quantum upgrade eats 32 highly advanced upgrades."
		"&eHow:&r Assembler: 8 large advanced motors, 4 large advanced pumps, 4 turbo upgrades, a processing unit board and 2500 mB PVC → 4. Eight runs."
		"&eTip:&r the Electrochemistry, Petrochemistry and Materials side quests walk through basic, advanced and turbo upgrades."
	]
	quest.59AC1CEBD3CC7EC6.title: "Eight More Quantum Circuits"
	quest.59AC1CEBD3CC7EC6.quest_subtitle: "Plus a spare board"
	quest.59AC1CEBD3CC7EC6.quest_desc: [
		"&eWhat:&r a quantum upgrade takes 8 quantum circuits and 1 quantum circuit board on top."
		"&eHow:&r the same line that fed your Antimatter Cores. Helium-3 and iridium plates are the slow inputs."
	]
	quest.1C4FB8278003C91C.title: "Netherite Set"
	quest.1C4FB8278003C91C.quest_subtitle: "The base of quantum armour"
	quest.1C4FB8278003C91C.quest_desc: [
		"&eWhat:&r each quantum armour piece is a netherite piece plus a quantum upgrade."
		"&eHow:&r diamond armour + netherite ingot + netherite upgrade template in a smithing table."
	]
	quest.07E1DE3F18C61242.title: "Quantum Hulls"
	quest.07E1DE3F18C61242.quest_subtitle: "One for the reactor, one for the turbine"
	quest.07E1DE3F18C61242.quest_desc: [
		"&eWhat:&r the IV machine hull. The fusion reactor and the plasma turbine each sit on one."
		"&eHow:&r quantum machine casing (8 iridium plates around an EV hull) + a quantum circuit + 2 plutonium batteries + 3 superconductor cable."
	]
	quest.2D04AB539AAF43D6.title: "Superconductor Coils"
	quest.2D04AB539AAF43D6.quest_subtitle: "The magnetic bottle"
	quest.2D04AB539AAF43D6.quest_desc: [
		"&eWhat:&r coils of superconductor cable hold the plasma in place."
		"&eChemistry:&r a superconductor carries enormous current with no loss, so it makes the strongest steady magnets we can build. Real tokamaks like ITER use niobium-tin coils cooled by liquid helium."
		"&eHow:&r 8 superconductor cable → 1 coil."
	]
	quest.4F8D81EF12D9DE4F.title: "Plasma Casings"
	quest.4F8D81EF12D9DE4F.quest_subtitle: "Iridium around a coil"
	quest.4F8D81EF12D9DE4F.quest_desc: [
		"&eWhat:&r every fusion chamber holds one plasma-handling casing."
		"&eHow:&r 8 iridium plates around a superconductor coil."
	]
	quest.22A29089903DEDEF.title: "Large Heat Exchangers"
	quest.22A29089903DEDEF.quest_subtitle: "Carry the heat out of the chamber"
	quest.22A29089903DEDEF.quest_desc: [
		"&eWhat:&r each fusion chamber needs 2. Six chambers, twelve exchangers."
		"&eHow:&r 2 small heat exchangers, a large advanced pump, 2 aluminum rotors and 4 invar gears."
	]
	quest.6C47077092C245D5.title: "Six Fusion Chambers"
	quest.6C47077092C245D5.quest_subtitle: "The ring of the reactor"
	quest.6C47077092C245D5.quest_desc: [
		"&eWhat:&r the fusion reactor controller takes six."
		"&eHow:&r 4 superconductor coils, 2 large heat exchangers, 2 nuclear alloy large plates and a plasma casing each."
	]
	quest.4D71A7A698B2EC77.title: "Radiance Alloy"
	quest.4D71A7A698B2EC77.quest_subtitle: "Glowstone and uranium oxide"
	quest.4D71A7A698B2EC77.quest_desc: [
		"&eWhat:&r the first alloy past atomic."
		"&eHow:&r Osmium Compressor: glowstone dust + uranium oxide gas → radiance dust. Enrichment Chamber → enriched radiance. Metallurgic Infuser: atomic alloy + radiance infusion → radiance alloy."
	]
	quest.062144FC3F2191BD.title: "Thermonuclear Alloy"
	quest.062144FC3F2191BD.quest_subtitle: "Born in superheated sodium"
	quest.062144FC3F2191BD.quest_desc: [
		"&eWhat:&r the alloy between radiance and shining."
		"&eHow:&r Pressurized Reaction Chamber: lava + superheated sodium → molten thermonuclear; then enriched radiance + lava + molten thermonuclear → enriched thermonuclear. Infuse a radiance alloy with it (check JEI)."
		"&eTip:&r superheated sodium comes from a sodium-cooled fission reactor."
	]
	quest.731E517EE952D2D7.title: "Spectrum Alloy"
	quest.731E517EE952D2D7.quest_subtitle: "Optional: the last alloy"
	quest.731E517EE952D2D7.quest_desc: [
		"&eWhat:&r the top of Mekanism Extras' alloy ladder."
		"&eHow:&r Metallurgic Infuser: shining alloy + spectrum infusion (check JEI for where the infusion comes from)."
	]
	quest.25304A159A72CA36.title: "Compressor Parts"
	quest.25304A159A72CA36.quest_subtitle: "Elite components and a frame"
	quest.25304A159A72CA36.quest_desc: [
		"&eWhat:&r the Quantum Compressor needs an elite component, 2 elite catalysts and a frame."
		"&eHow:&r elite component: black iron slate, luminessence and 2 diamonds. Catalyst: 4 elite components around a black iron ingot (check JEI for the frame)."
	]
	quest.3059C38CBBF609B8.title: "The Actinides"
	quest.3059C38CBBF609B8.quest_subtitle: "64 of any element 89 to 103"
	quest.3059C38CBBF609B8.quest_desc: [
		"&eWhat:&r any 64 actinides from ChemLib: actinium through lawrencium."
		"&eChemistry:&r every actinide is radioactive. Only thorium and uranium last long enough to be mined; everything past uranium was first made in reactors and accelerators."
		"&eHow:&r Fusion Chamber, or split heavier elements in the Fission Chamber (check JEI)."
		"&eTip:&r americium-241 is in most household smoke detectors: a fraction of a microgram each."
	]
	chapter.5DCD0BE8A5030114.title: "Market: Materials and Chemicals"
	chapter.5DCD0BE8A5030114.chapter_subtitle: [
		"Buy more of the metals, parts and chemicals you've already made."
	]
	quest.79F48E49083339C8.title: "The Materials Stall"
	quest.79F48E49083339C8.quest_subtitle: "Buy more of what you've already made"
	quest.79F48E49083339C8.quest_desc: [
		"&6You remember the offerings piling up at your temple. Now you can order them.&r"
		"&eWhat:&r this stall sells ingots, dusts, plates, gears, wires, circuit parts, chemicals and fuels."
		"&eHow:&r an item appears here only after the quest where you first made it. Hand in the tokens and claim the bundle; the entry resets so you can buy again."
		"&eTip:&r tokens save repetition, never a lesson. Nothing here skips a tier or a chemistry step."
		"&eTip:&r MV and up cost Greater Demigod Tokens (1 Greater = 9 tokens; craft them in a grid)."
	]
	quest.45E6FFABFD5AA33D.title: "Steam Stall"
	quest.45E6FFABFD5AA33D.quest_subtitle: "Bronze, steel and the first chemicals"
	quest.45E6FFABFD5AA33D.quest_desc: [
		"&eWhat:&r the Steam-age stall: bronze parts, steel, coke and your first Dissolver products."
		"&eHow:&r entries show up one by one as you finish the quests that make them."
	]
	quest.2F4D7BF827975DEF.title: "Charcoal"
	quest.2F4D7BF827975DEF.quest_subtitle: "1 token · unlocked by Pyrolysis"
	quest.2F4D7BF827975DEF.quest_desc: [
		"&eWhat:&r 32 charcoal. Wood heated without air leaves nearly pure carbon."
	]
	quest.6476357FC5229751.title: "Copper Ingots"
	quest.6476357FC5229751.quest_subtitle: "2 tokens · unlocked by Copper"
	quest.6476357FC5229751.quest_desc: [
		"&eWhat:&r 32 copper ingots for pipes, wires and bronze."
	]
	quest.0DA89891022DA9F7.title: "Tin Ingots"
	quest.0DA89891022DA9F7.quest_subtitle: "2 tokens · unlocked by Tin"
	quest.0DA89891022DA9F7.quest_desc: [
		"&eWhat:&r 16 tin ingots, the other half of bronze."
	]
	quest.03DB603BA8D89C67.title: "Tin Dust"
	quest.03DB603BA8D89C67.quest_subtitle: "2 tokens · unlocked by Metal Dust"
	quest.03DB603BA8D89C67.quest_desc: [
		"&eWhat:&r 16 tin dust, ready for mixing."
	]
	quest.70D5A7D70810EED7.title: "Bronze Ingots"
	quest.70D5A7D70810EED7.quest_subtitle: "2 tokens · unlocked by The First Alloy"
	quest.70D5A7D70810EED7.quest_desc: [
		"&eWhat:&r 16 bronze ingots (copper and tin, about 3:1)."
	]
	quest.78F737C47AD128D8.title: "Bronze Plates"
	quest.78F737C47AD128D8.quest_subtitle: "2 tokens · unlocked by Bronze Plates"
	quest.78F737C47AD128D8.quest_desc: [
		"&eWhat:&r 16 bronze plates for steam machines and boilers."
	]
	quest.7CDD3DAADCB638CB.title: "Bronze Curved Plates"
	quest.7CDD3DAADCB638CB.quest_subtitle: "2 tokens · unlocked by Curved Plates"
	quest.7CDD3DAADCB638CB.quest_desc: [
		"&eWhat:&r 16 curved bronze plates for tanks and pipes."
	]
	quest.2FF6B2CEA7EF522B.title: "Bronze Rods"
	quest.2FF6B2CEA7EF522B.quest_subtitle: "2 tokens · unlocked by Rods, Bolts and Rings"
	quest.2FF6B2CEA7EF522B.quest_desc: [
		"&eWhat:&r 32 bronze rods."
	]
	quest.76975ADD07B91711.title: "Bronze Gears"
	quest.76975ADD07B91711.quest_subtitle: "3 tokens · unlocked by Bronze Gears"
	quest.76975ADD07B91711.quest_desc: [
		"&eWhat:&r 16 bronze gears for steam machines."
	]
	quest.273280DA0DECCD4C.title: "Fire Clay Bricks"
	quest.273280DA0DECCD4C.quest_subtitle: "2 tokens · unlocked by Fire Clay Bricks"
	quest.273280DA0DECCD4C.quest_desc: [
		"&eWhat:&r 32 fire clay bricks: refractory ceramic that survives a furnace's heat."
	]
	quest.796A59D12F9E58DD.title: "Coke"
	quest.796A59D12F9E58DD.quest_subtitle: "3 tokens · unlocked by Coke"
	quest.796A59D12F9E58DD.quest_desc: [
		"&eWhat:&r 32 coke: coal baked free of its volatiles, a hotter and cleaner fuel."
	]
	quest.1B66407E8FB4B664.title: "Creosote"
	quest.1B66407E8FB4B664.quest_subtitle: "1 token · unlocked by Byproduct: Creosote"
	quest.1B66407E8FB4B664.quest_desc: [
		"&eWhat:&r 4 buckets of creosote, the tar the coke oven drives out. A boiler fuel."
	]
	quest.7B2D696257233D07.title: "Lubricant"
	quest.7B2D696257233D07.quest_subtitle: "2 tokens · unlocked by Lubricant"
	quest.7B2D696257233D07.quest_desc: [
		"&eWhat:&r 4 buckets of lubricant for cutting machines."
	]
	quest.4B67EA44F2F23FFF.title: "Steel Ingots"
	quest.4B67EA44F2F23FFF.quest_subtitle: "3 tokens · unlocked by Steel"
	quest.4B67EA44F2F23FFF.quest_desc: [
		"&eWhat:&r 16 steel ingots: iron with a little carbon, far stronger than either."
	]
	quest.57880290074BA9D8.title: "Steel Plates"
	quest.57880290074BA9D8.quest_subtitle: "3 tokens · unlocked by Steel Plates"
	quest.57880290074BA9D8.quest_desc: [
		"&eWhat:&r 16 steel plates."
	]
	quest.2FA7B7FD73EA2BA3.title: "Steel Gears"
	quest.2FA7B7FD73EA2BA3.quest_subtitle: "3 tokens · unlocked by Steel Gears"
	quest.2FA7B7FD73EA2BA3.quest_desc: [
		"&eWhat:&r 8 steel gears."
	]
	quest.26AB9B772012B98B.title: "Graphite"
	quest.26AB9B772012B98B.quest_subtitle: "2 tokens · unlocked by Graphite"
	quest.26AB9B772012B98B.quest_desc: [
		"&eWhat:&r 16 graphite: carbon in flat sheets of hexagons."
	]
	quest.52D5CFF2D82EDAF4.title: "Carbon"
	quest.52D5CFF2D82EDAF4.quest_subtitle: "1 token · unlocked by First Entries in the Periodic Table"
