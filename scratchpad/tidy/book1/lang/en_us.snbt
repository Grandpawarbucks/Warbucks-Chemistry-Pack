	quest.39C85E5ABA208889.quest_subtitle: "Basic tier: player transmitter"
	quest.39C85E5ABA208889.quest_desc: [
		"&eWhat:&r the Player Transmitter charges the FE items carried by the player bound to it, wirelessly."
		"&eHow:&r usually the starter player transmitter with basic capacitors; JEI has the exact recipe."
		"&eTip:&r basic blocks still need no Orb: basic capacitors are iron, paste and a redstone block."
	]
