	]
	quest.68EF3FE9B926A467.title: "Awakened Supremium Armour"
	quest.68EF3FE9B926A467.quest_subtitle: "Optional: a full essence set"
	quest.68EF3FE9B926A467.quest_desc: [
		"&eWhat:&r the awakened_supremium armour set. Each tier adds protection and augment slots."
		"&eHow:&r upgrade the previous tier's pieces with this tier's ingots and gemstones (check JEI)."
		"&eTip:&r augments go in at the Tinkering Table."
	]
	quest.29F3A59698BEC9A9.title: "Awakened Supremium Tools"
	quest.29F3A59698BEC9A9.quest_subtitle: "Any one essence tool of this tier"
	quest.29F3A59698BEC9A9.quest_desc: [
		"&eWhat:&r any awakened_supremium tool: sword, pick, axe, shovel, hoe, sickle, scythe, shears, bow, crossbow, fishing rod or watering can."
		"&eHow:&r upgrade the previous tier's tool with this tier's ingots and gemstones (check JEI)."
		"&eTip:&r the sickle and scythe harvest crops in an area and replant them."
	]
	quest.0DB5956B6691C42D.title: "Ice Seeds"
	quest.0DB5956B6691C42D.quest_subtitle: "Tier 1 crop"
	quest.0DB5956B6691C42D.quest_desc: [
		"&eWhat:&r ice seeds grow ice essence, which crafts back into ice and snow."
		"&eHow:&r a prosperity seed base on the Infusion Altar, with inferium essence and the crop's materials on the pedestals (check JEI)."
		"&eChemistry:&r ice is water whose molecules have locked into a hexagonal lattice held by hydrogen bonds; that open lattice is why ice floats."
		"&eTip:&r one seed is enough: plant it and every harvest has a chance to drop another."
	]
	quest.7B979C99F86BEC3C.title: "Earth Seeds"
	quest.7B979C99F86BEC3C.quest_subtitle: "Tier 1 crop"
	quest.7B979C99F86BEC3C.quest_desc: [
		"&eWhat:&r earth seeds grow earth essence, which crafts back into earth-element ingredients."
		"&eHow:&r a prosperity seed base on the Infusion Altar, with inferium essence and the crop's materials on the pedestals (check JEI)."
		"&eTip:&r one seed is enough: plant it and every harvest has a chance to drop another."
	]
	quest.55A617539F6955CA.title: "Water Seeds"
	quest.55A617539F6955CA.quest_subtitle: "Tier 1 crop"
	quest.55A617539F6955CA.quest_desc: [
		"&eWhat:&r water seeds grow water essence, which crafts back into water-element ingredients."
		"&eHow:&r a prosperity seed base on the Infusion Altar, with inferium essence and the crop's materials on the pedestals (check JEI)."
		"&eTip:&r one seed is enough: plant it and every harvest has a chance to drop another."
	]
	quest.3DAC49DAE939DFD5.title: "Dirt Seeds"
	quest.3DAC49DAE939DFD5.quest_subtitle: "Tier 1 crop"
	quest.3DAC49DAE939DFD5.quest_desc: [
		"&eWhat:&r dirt seeds grow dirt essence, which crafts back into dirt."
		"&eHow:&r a prosperity seed base on the Infusion Altar, with inferium essence and the crop's materials on the pedestals (check JEI)."
		"&eTip:&r one seed is enough: plant it and every harvest has a chance to drop another."
	]
	quest.6071B6ED2BEE5505.title: "Stone Seeds"
	quest.6071B6ED2BEE5505.quest_subtitle: "Tier 1 crop"
	quest.6071B6ED2BEE5505.quest_desc: [
		"&eWhat:&r stone seeds grow stone essence, which crafts back into stone."
		"&eHow:&r a prosperity seed base on the Infusion Altar, with inferium essence and the crop's materials on the pedestals (check JEI)."
		"&eTip:&r one seed is enough: plant it and every harvest has a chance to drop another."
	]
	quest.711B020D493BD8C0.title: "Deepslate Seeds"
	quest.711B020D493BD8C0.quest_subtitle: "Tier 1 crop"
	quest.711B020D493BD8C0.quest_desc: [
