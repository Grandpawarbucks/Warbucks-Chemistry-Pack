	quest.486502690DC244A7.title: "Hardened Reactor"
	quest.486502690DC244A7.quest_subtitle: "Rebuild the reactor a tier up"
	quest.486502690DC244A7.quest_desc: [
		"&eWhat:&r a hardened reactor, much stronger than the basic one."
		"&eHow:&r 4 basic reactor blocks, 4 hardened capacitors and 1 uraninite make 4 hardened blocks."
		"&eTip:&r blazing, niotic, spirited and nitro reactors follow the same recipe with that tier's capacitor."
	]
	quest.293DB6B8FC940D40.title: "Hardened Solar Panel"
	quest.293DB6B8FC940D40.quest_subtitle: "Hardened tier: solar panel"
