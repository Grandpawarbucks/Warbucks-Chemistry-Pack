	]
	quest.5AB5A551ED938B4A.title: "Awakened Supremium Growth Accelerator"
	quest.5AB5A551ED938B4A.quest_subtitle: "Faster crops from below"
	quest.5AB5A551ED938B4A.quest_desc: [
