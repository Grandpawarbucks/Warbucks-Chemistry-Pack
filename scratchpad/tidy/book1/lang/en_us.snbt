	]
	quest.4EDF2F9E55E68B2D.title: "Wood Seeds"
	quest.4EDF2F9E55E68B2D.quest_subtitle: "Tier 1 crop"
	quest.4EDF2F9E55E68B2D.quest_desc: [
		"&eWhat:&r wood seeds grow wood essence, which crafts back into logs."
		"&eHow:&r a prosperity seed base on the Infusion Altar, with inferium essence and the crop's materials on the pedestals (check JEI)."
		"&eTip:&r one seed is enough: plant it and every harvest has a chance to drop another."
	]
	quest.43F2968DE0614692.title: "Air Seeds"
	quest.43F2968DE0614692.quest_subtitle: "Tier 1 crop"
	quest.43F2968DE0614692.quest_desc: [
		"&eWhat:&r air seeds grow air essence, which crafts back into air-element ingredients."
