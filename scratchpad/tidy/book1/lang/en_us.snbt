	]
	quest.4F02F40199EB5C57.title: "Supremium Farmland"
	quest.4F02F40199EB5C57.quest_subtitle: "Soil for tier 5 crops"
	quest.4F02F40199EB5C57.quest_desc: [
		"&eWhat:&r farmland infused with supremium essence. Inferium crops on it drop more essence, and the tier 5 seeds on this page hang off it."
		"&eHow:&r supremium essence and farmland, shapeless (check JEI)."
		"&eTip:&r convert the soil under your inferium field first; that's where it pays."
	]
	quest.438A37F21BA23B5D.title: "Supremium Growth Accelerator"
	quest.438A37F21BA23B5D.quest_subtitle: "Faster crops from below"
