	quest.0D7A0B7F7ED74F1F.quest_subtitle: "Basic tier: energy cell"
	quest.0D7A0B7F7ED74F1F.quest_desc: [
		"&eWhat:&r the Energy Cell stores FE and passes it on to cells next to it."
		"&eHow:&r usually the starter energy cell with basic capacitors; JEI has the exact recipe."
		"&eTip:&r basic blocks still need no Orb: basic capacitors are iron, paste and a redstone block."
	]
