	quest.3BD9634A63632FB3.quest_subtitle: "Any one essence tool of this tier"
	quest.3BD9634A63632FB3.quest_desc: [
		"&eWhat:&r any imperium tool: sword, pick, axe, shovel, hoe, sickle, scythe, shears, bow, crossbow, fishing rod or watering can."
