	quest.036250CBB076FD28.quest_subtitle: "Any one essence tool of this tier"
	quest.036250CBB076FD28.quest_desc: [
		"&eWhat:&r any supremium tool: sword, pick, axe, shovel, hoe, sickle, scythe, shears, bow, crossbow, fishing rod or watering can."
