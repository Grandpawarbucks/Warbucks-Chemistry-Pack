	quest.4487AE487BA04CF0.title: "Basic Thermo Generator"
	quest.4487AE487BA04CF0.quest_subtitle: "Basic tier: thermo generator"
	quest.4487AE487BA04CF0.quest_desc: [
		"&eWhat:&r the Thermo Generator makes FE from a hot block underneath and a coolant fed in."
