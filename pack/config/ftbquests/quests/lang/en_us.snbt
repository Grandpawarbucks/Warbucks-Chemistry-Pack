	quest.3BECBAAF865CB3B6.quest_subtitle: "4 tokens · unlocked by Feather and Berries"
	quest.3BECBAAF865CB3B6.quest_desc: [
		"&eWhat:&r 4 raven feathers."
	]
	quest.0DCE34744D65CCB1.title: "Liveroot"
	quest.0DCE34744D65CCB1.quest_subtitle: "5 tokens · unlocked by Ironwood"
	quest.0DCE34744D65CCB1.quest_desc: [
		"&eWhat:&r 16 liveroot for ironwood."
	]
	quest.36DA233DFB67812B.title: "Raw Venison"
	quest.36DA233DFB67812B.quest_subtitle: "4 tokens · unlocked by Venison"
	quest.36DA233DFB67812B.quest_desc: [
		"&eWhat:&r 16 raw venison."
	]
	quest.7E419CE5992D6FEF.title: "Raw Meef"
	quest.7E419CE5992D6FEF.quest_subtitle: "4 tokens · unlocked by Meef"
	quest.7E419CE5992D6FEF.quest_desc: [
		"&eWhat:&r 16 raw meef."
	]
	quest.5A1C0C9B8D835BE1.title: "Maze Wafers"
	quest.5A1C0C9B8D835BE1.quest_subtitle: "4 tokens · unlocked by Maze Wafers"
	quest.5A1C0C9B8D835BE1.quest_desc: [
		"&eWhat:&r 16 maze wafers."
	]
	quest.696350741D156208.title: "Thorn Roses"
	quest.696350741D156208.quest_subtitle: "4 tokens · unlocked by Thorn Roses"
	quest.696350741D156208.quest_desc: [
		"&eWhat:&r 4 thorn roses."
	]
	quest.45045CE7477D6CCB.title: "Uberous Soil"
	quest.45045CE7477D6CCB.quest_subtitle: "6 tokens · unlocked by Uberous Soil"
	quest.45045CE7477D6CCB.quest_desc: [
		"&eWhat:&r 4 uberous soil."
	]
	quest.270C04AA9B5F3A3D.title: "Castle Bricks"
	quest.270C04AA9B5F3A3D.quest_subtitle: "6 tokens · unlocked by Castle Stone"
	quest.270C04AA9B5F3A3D.quest_desc: [
		"&eWhat:&r 32 castle bricks."
	]
	quest.2B927204AC358F0E.title: "Arctic Fur"
	quest.2B927204AC358F0E.quest_subtitle: "5 tokens · unlocked by Arctic Fur"
	quest.2B927204AC358F0E.quest_desc: [
		"&eWhat:&r 8 arctic fur."
	]
	quest.5261E39D892D603C.title: "Armour Shards"
	quest.5261E39D892D603C.quest_subtitle: "6 tokens · unlocked by Armour Shards"
	quest.5261E39D892D603C.quest_desc: [
		"&eWhat:&r 9 armour shards (one cluster's worth)."
	]
	quest.62CA2A2A0311E7BC.title: "Carminite"
	quest.62CA2A2A0311E7BC.quest_subtitle: "6 tokens · unlocked by Carminite"
	quest.62CA2A2A0311E7BC.quest_desc: [
		"&eWhat:&r 4 carminite."
	]
	quest.4965C2A533DE5133.title: "Naga Scales"
	quest.4965C2A533DE5133.quest_subtitle: "8 tokens · unlocked by The Naga"
	quest.4965C2A533DE5133.quest_desc: [
		"&eWhat:&r 4 naga scales."
	]
	quest.018A52EB5E05756F.title: "Alpha Yeti Fur"
	quest.018A52EB5E05756F.quest_subtitle: "8 tokens · unlocked by Alpha Yeti Fur"
	quest.018A52EB5E05756F.quest_desc: [
		"&eWhat:&r 4 alpha yeti fur."
	]
	quest.5BD4ED5AFB9E740A.title: "Space Stall"
	quest.5BD4ED5AFB9E740A.quest_subtitle: "Stone and souvenirs of other planets"
	quest.5BD4ED5AFB9E740A.quest_desc: [
		"&eWhat:&r the stone, sand and ice of the Moon, Mars, Venus, Mercury and Glacio. Paid in Greater Tokens."
		"&eHow:&r each planet's goods appear after you've landed there. Ores stay off the list: mine them yourself."
	]
	quest.180BB03EA23AF3AE.title: "Moon Stone"
	quest.180BB03EA23AF3AE.quest_subtitle: "1 Greater · unlocked by One Small Step"
	quest.180BB03EA23AF3AE.quest_desc: [
		"&eWhat:&r 64 moon stone."
	]
	quest.4FF405DE155210AF.title: "Moon Sand"
	quest.4FF405DE155210AF.quest_subtitle: "1 Greater · unlocked by One Small Step"
	quest.4FF405DE155210AF.quest_desc: [
		"&eWhat:&r 64 moon sand (lunar regolith)."
	]
	quest.4666297CEB71FD2A.title: "Moon Cheese"
	quest.4666297CEB71FD2A.quest_subtitle: "1 Greater · unlocked by The Moon Is Cheese"
	quest.4666297CEB71FD2A.quest_desc: [
		"&eWhat:&r 16 wedges of moon cheese."
	]
	quest.1581A0CECE98DD24.title: "Mars Stone"
	quest.1581A0CECE98DD24.quest_subtitle: "1 Greater · unlocked by Mars"
	quest.1581A0CECE98DD24.quest_desc: [
		"&eWhat:&r 64 mars stone."
	]
	quest.672727BB164DF403.title: "Mars Sand"
	quest.672727BB164DF403.quest_subtitle: "1 Greater · unlocked by Mars"
	quest.672727BB164DF403.quest_desc: [
		"&eWhat:&r 64 mars sand, red with iron(III) oxide."
	]
	quest.01CA499DFC0A849F.title: "Ice Shards"
	quest.01CA499DFC0A849F.quest_subtitle: "1 Greater · unlocked by The Polar Caps"
	quest.01CA499DFC0A849F.quest_desc: [
		"&eWhat:&r 16 ice shards from the polar caps."
	]
	quest.5FFD75716BD61C4E.title: "Venus Stone"
	quest.5FFD75716BD61C4E.quest_subtitle: "1 Greater · unlocked by Venus"
	quest.5FFD75716BD61C4E.quest_desc: [
		"&eWhat:&r 64 venus stone."
	]
	quest.64D3EDB2EBBDD233.title: "Venus Sand"
	quest.64D3EDB2EBBDD233.quest_subtitle: "1 Greater · unlocked by Venus"
	quest.64D3EDB2EBBDD233.quest_desc: [
		"&eWhat:&r 64 venus sand."
	]
	quest.24E7B2254DA77625.title: "Mercury Stone"
	quest.24E7B2254DA77625.quest_subtitle: "1 Greater · unlocked by Mercury"
	quest.24E7B2254DA77625.quest_desc: [
		"&eWhat:&r 64 mercury stone."
	]
	quest.0FB1E793A8F93A00.title: "Glacio Stone"
	quest.0FB1E793A8F93A00.quest_subtitle: "1 Greater · unlocked by Glacio"
	quest.0FB1E793A8F93A00.quest_desc: [
		"&eWhat:&r 64 glacio stone."
	]
	quest.4C1DD7BEE15267BE.title: "Permafrost"
	quest.4C1DD7BEE15267BE.quest_subtitle: "1 Greater · unlocked by Glacio"
	quest.4C1DD7BEE15267BE.quest_desc: [
		"&eWhat:&r 32 permafrost."
	]
	chapter.71E6C109F4D846B5.title: "Gear and Comfort"
	chapter.71E6C109F4D846B5.chapter_subtitle: [
		"Better tools from better materials, and a soft place to land."
	]
	quest.4ABA9DD08B8F9ACD.title: "Repair Kits"
	quest.4ABA9DD08B8F9ACD.quest_subtitle: "Mend your parts instead of throwing them away"
	quest.4ABA9DD08B8F9ACD.quest_desc: [
		"&6You remember tools that never wore out. These will, but you can mend them.&r"
		"&eWhat:&r Silent Gear tools don't break for good; at zero durability they just stop working until repaired."
		"&eHow:&r craft a Crude Repair Kit, load it with matching material, then combine it with the tool in a crafting grid."
		"&eTip:&r a better kit (Sturdy, then Crimson and Azure) holds more material and repairs more per use."
	]
	quest.7458CDD0AC00121E.title: "Blaze Gold"
	quest.7458CDD0AC00121E.quest_subtitle: "Optional: gold, fired with blaze powder"
	quest.7458CDD0AC00121E.quest_desc: [
		"&eWhat:&r Silent Gear's first magic alloy. It's a key ingredient of the Material Grader and the Starlight Charger."
		"&eChemistry:&r gold (Au) is a noble metal: it barely reacts with anything, which is why it's found as native nuggets. Blaze gold is fictional; the blaze powder does the work."
		"&eHow:&r gold ingot + 2 blaze powder in the Alloy Forge, or check JEI for the early crafting route."
		"&eTip:&r keep a stack spare. Blaze gold blocks also go into the Starlight Charger."
	]
	quest.566563CC2C37BED0.title: "Material Grader"
	quest.566563CC2C37BED0.quest_subtitle: "Optional: same metal, better grade, stronger part"
	quest.566563CC2C37BED0.quest_desc: [
		"&eWhat:&r grades Silent Gear materials. A higher grade adds a stat bonus to every part made from that material."
		"&eHow:&r quartz, iron, blaze gold and an Advanced Upgrade Base (check JEI). Feed it materials plus a catalyst (check JEI for which items count)."
		"&eTip:&r grade only the materials you'll use for heads and main parts; rods and bindings matter less."
	]
	quest.7C6F13A70CB4F9FE.title: "Salvager"
	quest.7C6F13A70CB4F9FE.quest_subtitle: "Optional: old tools back into parts"
	quest.7C6F13A70CB4F9FE.quest_desc: [
		"&eWhat:&r breaks old Silent Gear tools back into parts, so upgrading doesn't waste materials."
		"&eHow:&r place it and drop in the old tool. Some material is lost on each salvage."
		"&eTip:&r salvage before you throw anything in lava; the parts often have most of their value left."
	]
	quest.2A06D8DD04609B9C.title: "Crimson Iron"
	quest.2A06D8DD04609B9C.quest_subtitle: "An ore that only grows in the Nether"
	quest.2A06D8DD04609B9C.quest_desc: [
		"&eWhat:&r crimson iron ore generates in Nether biomes. It's the base of crimson steel and the Alloy Forge."
		"&eHow:&r mine crimson iron ore in the Nether (Jade shows the name), then smelt the raw ore."
		"&eTip:&r run a few through the Alchemistry Dissolver and see which real elements it gives back."
	]
	quest.4E659FFA072CD2C6.title: "Crimson Steel"
	quest.4E659FFA072CD2C6.quest_subtitle: "Crimson iron, blaze rods and magma cream"
	quest.4E659FFA072CD2C6.quest_desc: [
		"&eWhat:&r a tough, heat-loving alloy for tool heads and the Alloy Forge frame."
		"&eChemistry:&r real steel is iron with a little carbon (under about 2%); the carbon atoms jam the iron lattice so it can't slip. Crimson steel is the fictional cousin."
		"&eHow:&r the first ingots are a shaped craft (crimson iron, blaze rods, magma cream); check JEI."
	]
	quest.5C0C129959F2C62D.title: "The Alloy Forge"
	quest.5C0C129959F2C62D.quest_subtitle: "Silent Gear's alloy machine"
	quest.5C0C129959F2C62D.quest_desc: [
		"&eWhat:&r mixes metals into Silent Gear alloys: blaze gold, crimson steel (3 per batch), azure electrum and tyrian steel."
		"&eHow:&r crimson steel ingots, blackstone and an iron block (check JEI). Fuel it like a furnace."
		"&eTip:&r alloying in the forge gives more ingots per batch than the crafting-table route."
	]
	quest.6628750FED7710A3.title: "Azure Electrum"
	quest.6628750FED7710A3.quest_subtitle: "Optional: azure silver from the End, plus gold"
	quest.6628750FED7710A3.quest_desc: [
		"&eWhat:&r azure silver ore generates in the End. Alloyed with gold it becomes azure electrum, a fast, enchantable metal."
		"&eChemistry:&r real electrum is a natural gold–silver alloy (Au–Ag); the ancient Lydians struck the first coins from it."
		"&eHow:&r azure silver ore needs a netherite-tier pickaxe (netherite, refined obsidian, crimson steel or better; see the Harvest Tiers chapter). Then Alloy Forge: an azure silver block, 2 gold ingots and an ender pearl."
	]
	quest.39DF5C695F1B32EB.title: "Tyrian Steel"
	quest.39DF5C695F1B32EB.quest_subtitle: "Optional: Silent Gear's finest metal"
	quest.39DF5C695F1B32EB.quest_desc: [
		"&eWhat:&r the top Silent Gear alloy: crimson steel, azure electrum, crushed shulker shell and netherite scrap."
		"&eChemistry:&r Tyrian purple was a real dye made from sea snails, once worth its weight in silver. The steel just borrowed the colour."
		"&eHow:&r Alloy Forge (check JEI). Crush shulker shells first."
	]
	quest.37DD31C8DF09C737.title: "Osmium Paxel"
	quest.37DD31C8DF09C737.quest_subtitle: "The densest natural element, as a tool"
	quest.37DD31C8DF09C737.quest_desc: [
		"&eWhat:&r Mekanism's signature metal as a paxel: more durability and speed than bronze, iron tier for mining."
		"&eChemistry:&r osmium (Os) is the densest natural element at about 22.6 g/cm³, twice as dense as lead."
		"&eHow:&r osmium ore generates in the Overworld; smelt or process it, then craft the pickaxe, axe and shovel and combine them with a stick (check JEI)."
		"&eTip:&r your steel paxel from T1 already mines at diamond tier. This one is about durability and speed."
	]
	quest.1E48AB2B0066F565.title: "The Ultimate Paxel"
	quest.1E48AB2B0066F565.quest_subtitle: "Refined obsidian: Mekanism's toughest metal"
	quest.1E48AB2B0066F565.quest_desc: [
		"&6You remember a hammer that could split mountains. This is a start.&r"
		"&eWhat:&r refined obsidian is Mekanism's toughest material, and its paxel is the best of the line (netherite tier)."
		"&eHow:&r infuse obsidian dust with diamond in the Metallurgic Infuser, then press the refined obsidian dust in the Osmium Compressor (check JEI)."
		"&eTip:&r the same ingots make the Atomic Disassembler and much of Mekanism's late gear."
	]
	quest.4E4AD4A8D6C2C30C.title: "Atomic Disassembler"
	quest.4E4AD4A8D6C2C30C.quest_subtitle: "Optional: an FE-powered everything-tool"
	quest.4E4AD4A8D6C2C30C.quest_desc: [
		"&eWhat:&r an electric tool that mines, chops and digs, with vein and area modes. It runs on FE instead of durability."
		"&eHow:&r refined obsidian, atomic alloy, infused alloy and an Energy Tablet (check JEI). Charge it in an energy cube."
		"&eTip:&r sneak + right-click to switch modes."
	]
	quest.42978372FCFCA164.title: "Bottled Oxygen"
	quest.42978372FCFCA164.quest_subtitle: "Breathe underwater on O₂ from your separator"
	quest.42978372FCFCA164.quest_desc: [
		"&eWhat:&r the Scuba Mask and Tank let you breathe underwater for as long as the tank has oxygen."
		"&eChemistry:&r the Electrolytic Separator splits water: 2H₂O → 2H₂ + O₂. The O₂ fills the tank; the H₂ is fuel."
		"&eHow:&r steel, a control circuit and a chemical tank (check JEI). Fill the tank from a Chemical Tank or the separator's oxygen output."
		"&eTip:&r great for ocean monuments and underwater prospecting."
	]
	quest.1868DF8A24A0C2BA.title: "Free Runners"
	quest.1868DF8A24A0C2BA.quest_subtitle: "Step up blocks and never take fall damage"
	quest.1868DF8A24A0C2BA.quest_desc: [
		"&eWhat:&r electric boots: auto step-up and no fall damage while charged."
		"&eHow:&r infused alloy, a basic control circuit and an Energy Tablet (check JEI)."
		"&eTip:&r the armoured version adds protection; upgrade once you have more alloy."
	]
	quest.43D93D778FD7460F.title: "MekaSuit"
	quest.43D93D778FD7460F.quest_subtitle: "Polonium, HDPE and a netherite core"
	quest.43D93D778FD7460F.quest_desc: [
		"&6You remember armour that was never armour, only certainty. This is the closest a mortal gets.&r"
		"&eWhat:&r Mekanism's modular power armour. Add modules for flight, night vision, magnet, radiation shielding and more."
		"&eChemistry:&r it needs HDPE sheets (polyethylene: long C₂H₄ chains) and polonium pellets. Real ²¹⁰Po is made by hitting bismuth-209 with neutrons; Mekanism makes it from nuclear waste in the Solar Neutron Activator."
		"&eHow:&r netherite armour, HDPE sheets, ultimate control circuits, polonium pellets and induction cells (check JEI). Install modules in the Modification Station."
	]
	quest.172C8AEEBF9724DA.title: "Hazmat Gear"
	quest.172C8AEEBF9724DA.quest_subtitle: "Optional: lead against radiation"
	quest.172C8AEEBF9724DA.quest_desc: [
		"&eWhat:&r the full hazmat suit stops Mekanism radiation from building up in you. Cheap and worth having before fission."
		"&eChemistry:&r lead (Pb) is dense and has many electrons, so it absorbs gamma rays well."
		"&eHow:&r lead ingots and orange dye for each piece (check JEI)."
	]
	quest.18BB98D1C02BB648.title: "Hydrogen Jetpack"
	quest.18BB98D1C02BB648.quest_subtitle: "Optional: fly on the other half of water"
	quest.18BB98D1C02BB648.quest_desc: [
		"&eWhat:&r Mekanism's jetpack burns hydrogen gas. Short hops, not true flight."
		"&eChemistry:&r 2H₂ + O₂ → 2H₂O. Burning hydrogen gives only water and a lot of energy."
		"&eHow:&r steel, tin, a basic control circuit and a chemical tank. Fill it with H₂ from the Electrolytic Separator."
	]
	quest.5E5F22E41BC4538A.title: "Jetpacks"
	quest.5E5F22E41BC4538A.quest_subtitle: "Electric flight, one coil at a time"
	quest.5E5F22E41BC4538A.quest_desc: [
		"&eWhat:&r Iron Jetpacks run on FE. Every tier needs a coil, and in this pack the coils need MI circuits."
		"&eHow:&r Basic coil = analog circuit (LV). Craft the coil, then cells, thrusters, strap and the jetpack for your metal (check JEI)."
		"&eTip:&r better metals fly faster and hold more FE. Charge it in any energy cube."
	]
	quest.5E3BA6083259F734.title: "Advanced Coil"
	quest.5E3BA6083259F734.quest_subtitle: "Optional: MV jetpacks"
	quest.5E3BA6083259F734.quest_desc: [
		"&eWhat:&r unlocks the middle jetpack tiers."
		"&eHow:&r needs an MI electronic circuit (MV, aluminum chemistry). Check JEI for which jetpacks use it."
		"&eTip:&r JEI shows which jetpacks use this coil."
	]
	quest.6EF99BBC489E3FBF.title: "Elite Coil"
	quest.6EF99BBC489E3FBF.quest_subtitle: "Optional: HV jetpacks"
	quest.6EF99BBC489E3FBF.quest_desc: [
		"&eWhat:&r faster, longer flights."
		"&eHow:&r needs an MI digital circuit (HV, polyethylene)."
		"&eTip:&r the digital circuit is your polyethylene line paying off; make a few extra."
	]
	quest.1DAC0AE8A49D8F79.title: "Ultimate Coil"
	quest.1DAC0AE8A49D8F79.quest_subtitle: "Optional: the best jetpacks"
	quest.1DAC0AE8A49D8F79.quest_desc: [
		"&eWhat:&r the top jetpack tier."
		"&eHow:&r needs an MI processing unit (EV, PVC chemistry)."
		"&eTip:&r by now the Angel Ring may suit you better; the jetpack still has the best speed."
	]
	quest.29E14CD67BE0BB33.title: "The Angel Ring"
	quest.29E14CD67BE0BB33.quest_subtitle: "Creative flight from a ring"
	quest.29E14CD67BE0BB33.quest_desc: [
		"&6You remember the sky being yours. Now it is again.&r"
		"&eWhat:&r portable creative flight, no fuel, from a Curios ring slot."
		"&eChemistry:&r its &eMI digital circuit&r needs polyethylene: n C₂H₄ → (C₂H₄)ₙ, ethylene from your distillation tower."
		"&eHow:&r Elytra, ghast tears, diamond blocks and Nether Stars plus the digital circuit. Craft the Diamond Ring first, then the Angel Ring."
	]
	quest.1EA839D4E5BC136D.title: "Hammock"
	quest.1EA839D4E5BC136D.quest_subtitle: "Optional: sleep through the day"
	quest.1EA839D4E5BC136D.quest_desc: [
		"&eWhat:&r skips the day the way a sleeping bag skips the night, without moving your spawn."
		"&eHow:&r white wool, string and sticks. Hang it between two Rope and Nails placed on facing walls (check JEI)."
		"&eTip:&r useful when you want night-only mobs, like the ones a Deep Learner needs."
	]
	quest.0359B6BBCD892545.title: "Mining Gadget"
	quest.0359B6BBCD892545.quest_subtitle: "Optional: a mining laser powered by FE"
	quest.0359B6BBCD892545.quest_desc: [
		"&eWhat:&r a mining laser that breaks blocks at range. Upgrades add 3x3 (and bigger) size, efficiency, magnet and void filters."
		"&eHow:&r iron, gold, diamond and redstone (check JEI). Charge it with FE."
		"&eTip:&r a void filter for stone and dirt keeps your inventory clean on long ore runs."
	]
	quest.6B1EAD376672743D.title: "Bindings and Grips"
	quest.6B1EAD376672743D.quest_subtitle: "Optional: parts that change a tool's stats"
	quest.6B1EAD376672743D.quest_desc: [
		"&eWhat:&r bindings and grips are optional Silent Gear parts. Each adds its material's traits and stats to the tool."
		"&eHow:&r make the Binding and Grip blueprints, then craft the parts from string, vines, leather or wool (check JEI). Add them to a tool in a crafting grid."
		"&eTip:&r the Material Book (or JEI) shows every material's traits. Hover a part to see what it adds."
	]
	quest.1109E5DB21C9B41E.title: "Coatings"
	quest.1109E5DB21C9B41E.quest_subtitle: "Optional: plate a tool in a better material"
	quest.1109E5DB21C9B41E.quest_desc: [
		"&eWhat:&r a coating covers a finished tool's main part in another material, like diamond or netherite, changing its stats and colour."
		"&eChemistry:&r real tools are coated too: drill bits get a thin layer of titanium nitride (TiN) or diamond to stay sharp much longer."
		"&eHow:&r craft the coating smithing template (check JEI), then apply the coating material at a smithing table."
	]
	quest.66CF5CE277F89ABA.title: "Silent Jewellery"
	quest.66CF5CE277F89ABA.quest_subtitle: "Optional: rings, bracelets and necklaces"
	quest.66CF5CE277F89ABA.quest_desc: [
		"&eWhat:&r Silent Gear jewellery carries material traits as curios: a ring of a lucky or magnetic material gives you that trait while worn."
		"&eHow:&r a ring shank, bracelet band or necklace chain plus a gem setting, made with the matching blueprint (check JEI)."
		"&eTip:&r try different metals and gems. The traits list on each material shows what jewellery will do."
	]
	quest.5FAAB59A05382846.title: "Armour from Parts"
	quest.5FAAB59A05382846.quest_subtitle: "Optional: a full set of Silent Gear armour"
	quest.5FAAB59A05382846.quest_desc: [
		"&eWhat:&r Silent Gear armour is built from plates of any material, so your best alloy becomes your best armour."
		"&eHow:&r helmet, chestplate, legging and boot plates from their blueprints, then assemble each piece (check JEI). Any four pieces."
		"&eTip:&r crimson steel and azure electrum plates have strong traits; check the Material Book before choosing."
	]
	quest.02AA8F5B0AF7AF4F.title: "Primordial Goo"
	quest.02AA8F5B0AF7AF4F.quest_subtitle: "Optional: the door into Just Dire Things"
	quest.02AA8F5B0AF7AF4F.quest_desc: [
		"&eWhat:&r Just Dire Things goo converts the blocks it touches. Tier 1 goo turns an iron block into raw ferricore ore."
		"&eHow:&r clay, sugar, rotten flesh and dirt (check JEI). The full goo line, from ferricore to eclipse alloy, is in the Just Dire Things chapter."
		"&eTip:&r JEI's goo tab shows every conversion and which goo tier it needs."
	]
	quest.0377341C1CFB93F6.title: "Pocket Generator"
	quest.0377341C1CFB93F6.quest_subtitle: "Optional: charge tools on the go"
	quest.0377341C1CFB93F6.quest_desc: [
		"&eWhat:&r the Pocket Generator burns fuel in your inventory and charges your FE items."
		"&eHow:&r ferricore, a furnace, coal and a redstone block (check JEI)."
		"&eChemistry:&r burning coal is oxidation: C + O₂ → CO₂ releases about 394 kJ per mole of carbon as heat."
	]
	quest.1940B63A57F962D5.title: "Thinking with Portals"
	quest.1940B63A57F962D5.quest_subtitle: "Secret: now you're thinking"
	quest.1940B63A57F962D5.quest_desc: [
		"&6You remember stepping between places without walking. You'd forgotten how much fun it was.&r"
		"&eWhat:&r the Portal Gun shoots two linked portals onto walls. Walk in one, come out the other."
		"&eTip:&r there is an upgraded Portal Gun too; JEI has its recipe."
	]
	quest.288DFDDF8BE4ECCB.title: "Grading Catalysts"
	quest.288DFDDF8BE4ECCB.quest_subtitle: "Optional: fuel for the Material Grader"
	quest.288DFDDF8BE4ECCB.quest_desc: [
		"&eWhat:&r the Material Grader needs a catalyst for each try. Glowing dust is tier 1, blazing dust tier 2; a better catalyst allows a higher grade."
		"&eChemistry:&r a real catalyst speeds a reaction without being used up. These are spent on every try, so 'reagent' would be the honest word."
		"&eHow:&r glowing dust: a stick, 2 glowstone dust and a quartz (makes 4). Blazing dust: blaze gold dust and 2 glowstone dust (makes 4)."
		"&eTip:&r grade the material for a tool head, not the rod; the head carries most of the stats."
	]
	quest.21DCC8A163713431.title: "Glittery Dust"
	quest.21DCC8A163713431.quest_subtitle: "Optional: the tier 3 catalyst"
	quest.21DCC8A163713431.quest_desc: [
		"&eWhat:&r the best Grader catalyst, for the highest grades."
		"&eHow:&r popped chorus fruit, emerald nuggets, glowstone dust and a nether banana make 8 (check JEI). Chorus grows in the End; nether bananas grow on netherwood trees."
		"&eTip:&r popped chorus is just chorus fruit smelted in a furnace."
	]
	quest.2FAA0AA31B106DF9.title: "Hammered Dust"
	quest.2FAA0AA31B106DF9.quest_subtitle: "Optional: crush an ingot on an anvil"
	quest.2FAA0AA31B106DF9.quest_desc: [
		"&eWhat:&r Silent Gear turns its ingots into dust with a hammer: blaze gold, crimson iron, azure silver and more."
		"&eChemistry:&r grinding a metal to powder hugely raises its surface area. That's why fine metal dusts burn or react so much faster than a solid bar."
		"&eHow:&r a tool action with any hammer (the c:tools/hammer tag) on the ingot; JEI shows the steps and which block it needs."
		"&eTip:&r blaze gold dust is the tier 1 Starlight Charger catalyst and the base of blazing dust."
	]
	quest.2427AC65E7F170F3.title: "Starlight Charger"
	quest.2427AC65E7F170F3.quest_subtitle: "Optional: charge materials under the night sky"
	quest.2427AC65E7F170F3.quest_desc: [
		"&eWhat:&r the Starlight Charger collects starlight at night and charges Silent Gear materials, giving them a 'charged' bonus."
		"&eHow:&r quartz blocks, glass, polished blackstone and a blaze gold block (check JEI). Place it under open sky, add a catalyst (blaze gold dust is tier 1) and the item."
		"&eTip:&r the catalyst tier sets how strong the charge can get; JEI's tag view lists each tier."
	]
	quest.384FF8341B7900ED.title: "Starmetal"
	quest.384FF8341B7900ED.quest_subtitle: "Optional: azure metals and a piece of a star"
	quest.384FF8341B7900ED.quest_desc: [
		"&eWhat:&r starmetal dust is a late Silent Gear material made from azure metals and a Nether Star fragment."
		"&eChemistry:&r every atom heavier than iron was forged in dying stars or neutron-star collisions. Real 'starmetal' is just... metal."
		"&eHow:&r azure electrum dust, 2 azure silver dust, blaze gold dust and a nether star fragment make 3 (check JEI). Hammer the ingots into dust first."
		"&eTip:&r one Nether Star crafts into 9 fragments, so a single Wither kill goes a long way."
	]
	quest.2515563461325E04.title: "Recrystallizer"
	quest.2515563461325E04.quest_subtitle: "Optional: grow hybrid gems"
	quest.2515563461325E04.quest_desc: [
		"&eWhat:&r the Recrystallizer fuses gems and dusts into a hybrid gem material whose stats depend on what you put in."
		"&eChemistry:&r real recrystallisation purifies a solid: dissolve it hot, cool slowly, and pure crystals grow while impurities stay in the liquid."
		"&eHow:&r azure electrum ingots, an emerald, a diamond, purpur blocks and a gold block (check JEI)."
		"&eTip:&r the Material Book explains hybrid gems; experiment with cheap gems first."
	]
	quest.04D6247E9D3D6485.title: "A Metallurgist's Shelf"
	quest.04D6247E9D3D6485.quest_subtitle: "Optional: a block of each great alloy"
	quest.04D6247E9D3D6485.quest_desc: [
		"&6Three alloys, three blocks, each one a recipe you wrote yourself. You remember a forge like this.&r"
		"&eWhat:&r a storage block of crimson steel, azure electrum and tyrian steel: Silent Gear's three great alloys, side by side."
		"&eChemistry:&r alloys aren't mixtures you can see: the atoms share one crystal lattice. Bronze, steel and electrum are all solid solutions or mixed phases at the atomic scale."
		"&eHow:&r nine ingots of each make a block (check JEI)."
	]
	chapter.7C7291BC2B72BD23.title: "Tools, Armour and Harvest Tiers"
	chapter.7C7291BC2B72BD23.chapter_subtitle: [
		"Which pickaxe mines what, and why harder is not the same as tougher."
	]
	quest.60FA1921CCF3AF97.title: "The Hardness of Things"
	quest.60FA1921CCF3AF97.quest_subtitle: "Why some blocks ignore your pickaxe"
	quest.60FA1921CCF3AF97.quest_desc: [
		"&6Once you could split a mountain with a look. Now you need the right pick. You remember why: everything has a hardness.&r"
		"&eWhat:&r every ore needs a pickaxe of a certain tier: wood, stone, iron, diamond, netherite. Too weak a pick breaks the block slowly and drops nothing."
		"&eChemistry:&r hardness is resistance to scratching and denting; toughness is resistance to cracking. A good tool needs both, and they pull against each other."
		"&eHow:&r look at a block: Jade shows the tool it needs and turns red when yours is too weak. This page walks up the tiers."
		"&eTip:&r this pack raises some tiers: MI titanium, tungsten, platinum and iridium ores need iron, and the rocket metals climb from iron to netherite."
	]
	quest.6BDFD1326944CD7B.title: "Flint"
	quest.6BDFD1326944CD7B.quest_subtitle: "Optional: the first sharp edge"
	quest.6BDFD1326944CD7B.quest_desc: [
		"&eWhat:&r flint drops from gravel. Silent Gear makes tool heads from it, and it lights the Nether portal."
		"&eChemistry:&r flint and chert are microcrystalline quartz, SiO₂, about 7 on the Mohs scale: harder than steel. It breaks with a curved, shell-like (conchoidal) fracture that leaves a razor edge."
		"&eHow:&r dig gravel with a shovel; each block has a small chance to drop flint instead."
		"&eTip:&r a Silent Gear pickaxe with a flint head mines like stone, but you can repair and upgrade it."
	]
	quest.056CD721D29672F1.title: "Stone Tier"
	quest.056CD721D29672F1.quest_subtitle: "Now you can mine iron, copper and lapis"
	quest.056CD721D29672F1.quest_desc: [
		"&eWhat:&r a stone pickaxe (or better) opens iron, copper and lapis, plus almost every Modern Industrialization and Mekanism ore: tin, lead, nickel, antimony, bauxite, salt, monazite, uranium, osmium and fluorite."
		"&eChemistry:&r a stone pick is a rock hitting a rock. It works on iron ore because the iron minerals (haematite Fe₂O₃, magnetite Fe₃O₄) are softer than the granite-like stone of the head... roughly."
		"&eHow:&r mine 8 raw iron and 8 raw copper with any stone-tier pick."
		"&eTip:&r you can't mine gold, redstone or diamond yet. Mark where you saw them and come back with iron."
	]
	quest.60920BB92C5975BC.title: "Bronze Age"
	quest.60920BB92C5975BC.quest_subtitle: "Same tier, much longer life"
	quest.60920BB92C5975BC.quest_desc: [
		"&eWhat:&r bronze tools are iron tier (Mekanism bronze, Silent Gear bronze): more durable than stone, and they reach gold, redstone and diamond."
		"&eChemistry:&r pure copper is soft, about Mohs 3. Add roughly 12% tin and the bigger tin atoms sit in the copper lattice and pin the defects (dislocations) that let metal bend. That is solid-solution strengthening, and it started an age."
		"&eHow:&r mine 8 raw tin. Tin ore needs only a stone pick; its mineral, cassiterite (SnO₂), is actually harder than iron ore."
		"&eTip:&r the bronze paxel (Bronze Age on the T0 page) is a pick, axe and shovel in one."
	]
	quest.354E836D0228BCD9.title: "Iron Tier"
	quest.354E836D0228BCD9.quest_subtitle: "Now you can mine gold, redstone and diamond"
	quest.354E836D0228BCD9.quest_desc: [
		"&6Iron rings against stone, and something in you rings back. You remember iron.&r"
		"&eWhat:&r an iron-tier pick opens gold, redstone, diamond and emerald, Create zinc, AE2 sky stone, Silent Gear crimson iron, and in this pack the hard MI ores: titanium, tungsten, platinum and iridium."
		"&eChemistry:&r pure iron is soft (about Mohs 4). Iron from a blast furnace (pig iron) carries about 4% carbon as brittle iron carbide, so it shatters. Useful iron sits between the two."
		"&eHow:&r mine 4 raw gold, 8 redstone and a diamond with an iron pickaxe, iron paxel, bronze or osmium tools."
		"&eTip:&r diamonds sit deep (near Y -58). Branch-mine in deepslate."
	]
	quest.08BC2133F72EA7FC.title: "Hard Ores"
	quest.08BC2133F72EA7FC.quest_subtitle: "Tungsten and titanium need an iron pick"
	quest.08BC2133F72EA7FC.quest_desc: [
		"&eWhat:&r in this pack MI titanium, tungsten, platinum and iridium ores need an iron-tier pick. The metals inside still need the chemistry lines."
		"&eChemistry:&r their real minerals are hard: wolframite ((Fe,Mn)WO₄) about 4-4.5, ilmenite (FeTiO₃) 5-6, sperrylite (PtAs₂) 6-7. Tungsten itself melts at 3422 °C, higher than any other metal."
		"&eHow:&r mine 4 raw tungsten. Rich tungsten deposits sit at their own depth; check the ore pages in JEI."
		"&eTip:&r a stone pick on these ores gets you nothing but a broken block. Bring iron."
	]
	quest.131B5FE96A4605BB.title: "Diamond Tier, Without Diamonds"
	quest.131B5FE96A4605BB.quest_subtitle: "Now you can mine obsidian and ancient debris"
	quest.131B5FE96A4605BB.quest_desc: [
		"&6You remember quenching a blade in a cold river, and the hiss of it.&r"
		"&eWhat:&r Mekanism steel tools are diamond tier. Your steel paxel already mines obsidian, crying obsidian and ancient debris, long before you own a diamond pick."
		"&eChemistry:&r steel is iron with 0.2-2% carbon. Heat it red hot and quench it in water and it becomes martensite: very hard, but brittle. Temper it (reheat to 200-600 °C) and it trades a little hardness for toughness."
		"&eHow:&r mine 4 obsidian and a crying obsidian with the steel paxel (or any diamond-tier tool). Obsidian forms where water meets lava."
		"{@pagebreak}"
		"&eChemistry:&r obsidian isn't actually hard: it's volcanic glass, mostly SiO₂ that cooled too fast to crystallise, about Mohs 5.5. It snaps to edges sharper than steel, which is why surgeons still sometimes use obsidian blades."
		"&eTip:&r the game makes obsidian slow to mine for its blast resistance, not its hardness. Real obsidian shatters under a hammer."
	]
	quest.694B6BC236B91267.title: "Netherite Tier"
	quest.694B6BC236B91267.quest_subtitle: "Now you can mine azure silver and naquadah"
	quest.694B6BC236B91267.quest_desc: [
		"&eWhat:&r a netherite-tier tool opens Silent Gear azure silver ore (the End), Mekanism Extras naquadah ore and, much later, Ad Astra calorite."
		"&eChemistry:&r netherite is fiction. The real champion of hard tools is tungsten carbide (WC, Mohs about 9), cemented with a little cobalt so it doesn't shatter: a ceramic-metal composite, or cermet."
		"&eHow:&r smelt ancient debris into scrap; four scrap and four gold make a netherite ingot. The upgrade template comes from bastion chests."
		"&eTip:&r copy a template with 7 diamonds and a netherrack before you use your last one."
	]
	quest.42D79AC9616538D3.title: "Azure Silver"
	quest.42D79AC9616538D3.quest_subtitle: "Optional: an End ore only netherite can mine"
	quest.42D79AC9616538D3.quest_desc: [
		"&eWhat:&r azure silver ore grows on End islands and needs a netherite-tier tool. It's the base of Silent Gear's azure electrum."
		"&eHow:&r mine 4 raw azure silver in the End with a netherite, refined obsidian or eclipse alloy pick."
		"&eTip:&r a diamond pick just bounces off it; check the Jade tooltip first."
	]
	quest.7540B7EBA3302C25.title: "Refined Obsidian"
	quest.7540B7EBA3302C25.quest_subtitle: "Mekanism's road to netherite tier"
	quest.7540B7EBA3302C25.quest_desc: [
		"&eWhat:&r refined obsidian tools are netherite tier, no Nether trip needed. They're also Mekanism Tools' strongest set."
		"&eChemistry:&r infusing osmium into obsidian dust is invented, but the idea is real: cermets (ceramic grains in a metal binder) are what drill bits and cutting inserts are made of."
		"&eHow:&r Metallurgic Infuser: obsidian dust + diamond infusion → refined obsidian dust, then the Osmium Compressor (check JEI)."
		"&eTip:&r the refined obsidian paxel is on the Tools page; the armour is on the Mekanism page."
	]
	quest.6D9600C7F52BED6B.title: "Beyond Netherite"
	quest.6D9600C7F52BED6B.quest_subtitle: "Now you can mine dreadrock"
	quest.6D9600C7F52BED6B.quest_desc: [
		"&6Harder was never the whole answer. You remember a stone that only its own metal could cut.&r"
		"&eWhat:&r dreadrock and its utherium and rogdorium ores need a Forgotten tool. Netherite fails here: dreadrock is on its 'can't mine' list."
		"&eChemistry:&r 'harder' is not one number. A cutting edge has to out-scratch the mineral, survive the impact and not wear or react away. A diamond bit cuts granite but dissolves into hot steel, because carbon diffuses into iron."
		"&eHow:&r mine 16 dreadrock at the bottom of the Undergarden with a Forgotten pickaxe."
		"&eTip:&r warden and resonarium tools (Deeper and Darker) also mine it."
	]
	quest.0F1A84D28960CA59.title: "Ores of Other Worlds"
	quest.0F1A84D28960CA59.quest_subtitle: "Desh, ostrum and calorite climb the tiers"
	quest.0F1A84D28960CA59.quest_desc: [
		"&eWhat:&r in this pack the rocket metals climb the ladder: Moon desh needs an iron pick, Mars ostrum a diamond-tier pick, Venus calorite a netherite-tier pick."
		"&eChemistry:&r the three are fiction, but real space mining would face the same problem: unknown minerals, unknown hardness. Geologists still carry a steel knife and a glass plate to test them."
		"&eHow:&r bring a netherite-tier tool on every trip past the Moon. The desh, ostrum and calorite quests are on the T7 and Space pages."
		"&eTip:&r a refined obsidian paxel covers all three and doesn't need the Nether."
	]
	quest.62D770D91B33A944.title: "Every Block"
	quest.62D770D91B33A944.quest_subtitle: "A tool with no tier at all"
	quest.62D770D91B33A944.quest_desc: [
		"&6No block refuses you now. You remember this: not strength, but understanding.&r"
		"&eWhat:&r the Atomic Disassembler, the Meka-Tool and the warden pickaxe have no 'can't mine' list. They break every block in the pack, dreadrock included."
		"&eChemistry:&r an energy tool doesn't scratch. It's closer to a laser or plasma cutter: put enough energy into a spot and the bonds break whatever the hardness."
		"&eHow:&r the Atomic Disassembler is on the Tools page, the Meka-Tool on the Mekanism page, the warden pickaxe on the Deeper and Darker page. Any one of them counts."
		"&eTip:&r energy tools need charging; keep a charger or an Energy Cube near your base."
	]
	quest.70178598964EFF4E.title: "Lapis Tools"
	quest.70178598964EFF4E.quest_subtitle: "Optional: pretty, and only stone tier"
	quest.70178598964EFF4E.quest_desc: [
		"&eWhat:&r Mekanism Tools makes a lapis pickaxe and paxel. They mine at stone tier but enchant very well."
		"&eChemistry:&r lapis lazuli is a rock, not one mineral: mostly lazurite (a sodium aluminosilicate with sulfur) about Mohs 5-5.5. The blue comes from S₃⁻ radical ions trapped in the crystal."
		"&eHow:&r lapis and sticks, shaped like any pick (check JEI)."
		"&eTip:&r ground lapis was ultramarine, once worth more than gold to painters."
	]
	quest.79F7E96504AC02E0.title: "Iron-Tier Cousins"
	quest.79F7E96504AC02E0.quest_subtitle: "Optional: one tier, many mods"
	quest.79F7E96504AC02E0.quest_desc: [
		"&eWhat:&r each of these mines exactly what an iron pick does: ferricore (Just Dire Things), ironwood (Twilight), cloggrum (Undergarden), bronze and osmium (Mekanism Tools)."
		"&eChemistry:&r osmium is the densest element (22.6 g/cm³) and quite hard, but brittle: real osmium is almost never used for tools, only for tiny wear-proof tips like old pen nibs."
		"&eHow:&r craft any one of them; their mods' pages show the recipes."
		"&eTip:&r durability and speed differ a lot between them even at the same tier. Check the tooltip."
	]
	quest.143395D7328062B5.title: "Diamond Pickaxe"
	quest.143395D7328062B5.quest_subtitle: "Hard is not tough"
	quest.143395D7328062B5.quest_desc: [
		"&eWhat:&r the vanilla road to diamond tier: obsidian, crying obsidian and ancient debris. Also the base for Mystical Agriculture tools."
		"&eChemistry:&r diamond is carbon with every atom bonded to four neighbours in a 3D network (sp³). It's Mohs 10, the hardest natural material, but it cleaves along flat planes: a sharp knock in the right direction splits it."
		"&eHow:&r three diamonds and two sticks."
		"&eTip:&r a steel paxel (T1) is already diamond tier. Spend early diamonds on machines, not picks, if you're short."
	]
	quest.0F0206FF419082A1.title: "Diamond-Tier Cousins"
	quest.0F0206FF419082A1.quest_subtitle: "Optional: steel, glowstone, blazegold and more"
	quest.0F0206FF419082A1.quest_desc: [
		"&eWhat:&r all of these are diamond tier: Mekanism steel and refined glowstone, JDT blazegold and celestigem, Twilight steeleaf and knightmetal, Undergarden utherium, and MI's Steam Mining Drill."
		"&eChemistry:&r the Steam Mining Drill is honest engineering: a hardened bit turned by a steam engine. Real drill bits use tungsten carbide or industrial diamond tips on a tough steel body."
		"&eHow:&r craft any one of them; each mod page and JEI have the recipe."
		"&eTip:&r the steam drill burns fuel instead of wearing out, and digs 3x3. Its tooltip lists the modes."
	]
	quest.1192D454BBE6D5C5.title: "Netherite Pickaxe"
	quest.1192D454BBE6D5C5.quest_subtitle: "Upgrade, don't rebuild"
	quest.1192D454BBE6D5C5.quest_desc: [
		"&eWhat:&r the vanilla netherite-tier pick. Upgrading keeps every enchantment on your diamond pick."
		"&eHow:&r smithing table: netherite upgrade template + diamond pickaxe + netherite ingot."
		"&eTip:&r netherite items float in lava and don't burn. Drop one in the Nether and it can be fished back out."
	]
	quest.643C93A070C57511.title: "Netherite-Tier Cousins"
	quest.643C93A070C57511.quest_subtitle: "Optional: refined obsidian, eclipse, fiery"
	quest.643C93A070C57511.quest_desc: [
		"&eWhat:&r all netherite tier: Mekanism refined obsidian and netherite paxel, JDT eclipse alloy, Twilight fiery, MI's Diesel Mining Drill. A Silent Gear pick with a crimson steel, azure electrum or tyrian steel head counts too (its tier comes from the head)."
		"&eChemistry:&r fiery metal is 'quenched' in fiery blood; real metallurgists do the same with oil, brine or polymer baths to control how fast the steel cools."
		"&eHow:&r craft any one of the listed tools (check JEI)."
		"&eTip:&r the diesel drill is listed on the T5 page as part of Diesel Toys."
	]
	quest.5628DFE05F0477DE.title: "A Grown Pickaxe"
	quest.5628DFE05F0477DE.quest_subtitle: "Optional: Mystical Agriculture ignores tiers"
	quest.5628DFE05F0477DE.quest_desc: [
		"&eWhat:&r Mystical Agriculture tools have no 'can't mine' list: even an inferium pick breaks azure silver, naquadah and dreadrock."
		"&eHow:&r a diamond pickaxe with two inferium ingots and two inferium gemstones around it (check JEI). Higher essences make it faster, not 'higher tier'."
		"&eTip:&r it still can't give you the metal: the ores need the same chemistry lines as ever."
	]
	quest.4779C73262490E2D.title: "Fast and Useless"
	quest.4779C73262490E2D.quest_subtitle: "Optional: the fastest, weakest pick"
	quest.4779C73262490E2D.quest_desc: [
		"&eWhat:&r a golden pick mines faster than any vanilla pick, but only at wood tier and with almost no durability."
		"&eChemistry:&r gold is about Mohs 2.5-3: a fingernail nearly scratches it. Real gold is so soft it's alloyed with copper or silver for jewellery (18 carat is 75% gold)."
		"&eHow:&r three gold ingots and two sticks."
		"&eTip:&r enchant it with Silk Touch and it's a quick glass and ice collector."
	]
	quest.23B44A46EAB73D68.title: "Bronze Armour"
	quest.23B44A46EAB73D68.quest_subtitle: "Optional: a little better than iron"
	quest.23B44A46EAB73D68.quest_desc: [
		"&eWhat:&r Mekanism Tools bronze armour is a touch better than iron, and it saves your iron for machines."
		"&eChemistry:&r Bronze Age armour really was bronze, often hammered cold: working the metal (work hardening) piles up dislocations and makes it harder still."
		"&eHow:&r 24 bronze ingots, shaped like any armour set. MI bronze counts (it's a c:ingots/bronze ingot)."
	]
	quest.410BB4BB232F3580.title: "Steel Armour"
	quest.410BB4BB232F3580.quest_subtitle: "Optional: plate for the steel age"
	quest.410BB4BB232F3580.quest_desc: [
		"&eWhat:&r Mekanism Tools steel armour: better than iron, from the steel you already make in MI."
		"&eChemistry:&r real plate armour was hardened on the outside and left soft inside (case hardening): a hard face to stop blades, a tough core so it dents instead of cracking."
		"&eHow:&r 24 steel ingots, shaped like any armour set (any c:ingots/steel counts)."
	]
	quest.5C190CBD956F8F68.title: "Diamond Armour"
	quest.5C190CBD956F8F68.quest_subtitle: "Four pieces of the hardest gem"
	quest.5C190CBD956F8F68.quest_desc: [
		"&eWhat:&r the full vanilla diamond set: the step before netherite, and the base you'll upgrade."
		"&eChemistry:&r real diamond armour would be a disaster: diamond is hard but brittle, and a solid plate would crack on the first heavy blow. Real body armour stacks hard ceramic plates (boron carbide, B₄C) on tough fibres."
		"&eHow:&r 24 diamonds. If that hurts, make the steel set first and come back."
	]
	quest.37F636BFE7E37758.title: "Netherite Armour"
	quest.37F636BFE7E37758.quest_subtitle: "Upgrade the diamond set"
	quest.37F636BFE7E37758.quest_desc: [
		"&6Your skin is mortal now, so you wear the strongest shell the world allows. You remember not needing one.&r"
		"&eWhat:&r the full vanilla netherite set: the best plain armour, with knockback resistance and immunity to burning up in lava as an item."
		"&eHow:&r smithing table, one piece at a time: template + diamond piece + netherite ingot. Four templates, four ingots."
		"&eTip:&r copy templates with diamonds and netherrack so you never run out."
	]
	quest.10136D8201F4A3F9.title: "Bastion Remnant"
	quest.10136D8201F4A3F9.quest_subtitle: "Optional: where the templates come from"
	quest.10136D8201F4A3F9.quest_desc: [
		"&eWhat:&r every bastion has a netherite upgrade template in its chests, often gold blocks and ancient debris too."
		"&eHow:&r find a bastion in the Nether (anywhere except basalt deltas) and step inside."
		"&eTip:&r piglin brutes don't care about gold armour. Bring a shield and a bow."
	]
	quest.50A0E221B1B69D46.title: "The Scratch Test"
	quest.50A0E221B1B69D46.quest_subtitle: "Optional: seven of Mohs' ten minerals"
	quest.50A0E221B1B69D46.quest_desc: [
		"&eWhat:&r in 1812 Friedrich Mohs ranked ten minerals by which scratches which. Seven of them exist here."
		"&eChemistry:&r gypsum CaSO₄·2H₂O (2), calcite CaCO₃ (3), fluorite CaF₂ (4), apatite Ca₅(PO₄)₃(OH) (5), quartz SiO₂ (7), corundum Al₂O₃ (9), diamond C (10). Talc (1), orthoclase (6) and topaz (8) are missing."
		"&eHow:&r calcite in dripstone caves and amethyst geodes; fluorite from Mekanism ore; nether quartz; diamond. Calcium sulfate, hydroxylapatite and aluminium oxide come from the Alchemistry machines (check JEI)."
		"{@pagebreak}"
		"&eChemistry:&r the scale only ranks, it doesn't measure. Diamond (10) is about four times harder than corundum (9), while corundum is only a bit harder than topaz (8)."
		"&eTip:&r a fingernail is about 2.5, a copper coin 3.5, a steel knife 5.5, window glass 5.5. That's the field geologist's whole kit."
	]
	quest.161941956EC2518F.title: "Hard Rock, Soft Ore"
	quest.161941956EC2518F.quest_subtitle: "Optional: why game tiers don't follow Mohs"
	quest.161941956EC2518F.quest_desc: [
		"&eWhat:&r the ores you mine have real hardnesses, and they don't line up with the game's tiers at all."
		"&eChemistry:&r galena (PbS, lead ore) 2.5; bauxite 1-3; fluorite 4; wolframite 4-4.5; uraninite (UO₂) 5-6; ilmenite 5-6; cassiterite (SnO₂) 6-7; sperrylite (PtAs₂) 6-7. Tin ore is harder than iron ore, yet the game puts it lower."
		"&eHow:&r read it, then click the check."
		"&eTip:&r real miners don't pick ore apart by hand: they blast the rock and crush it, then separate by density and froth flotation."
	]
	quest.4A7AE47C4EF7931F.title: "Green Beryl"
	quest.4A7AE47C4EF7931F.quest_subtitle: "Optional: an iron-tier gem"
	quest.4A7AE47C4EF7931F.quest_desc: [
		"&eWhat:&r emerald ore is iron tier; in the Overworld it only appears in mountain biomes."
		"&eChemistry:&r emerald is beryl, Be₃Al₂Si₆O₁₈, Mohs 7.5-8, coloured green by a trace of chromium or vanadium. Pure beryl is colourless; iron makes it blue (aquamarine)."
		"&eHow:&r mine 4 emeralds with an iron pick, or trade with villagers."
		"&eTip:&r beryllium from beryl makes copper-beryllium alloy: hard, and it doesn't spark, so it's used for tools near explosives."
	]
	quest.249BDBDED71AD605.title: "Tungsten Carbide"
	quest.249BDBDED71AD605.quest_subtitle: "Optional: the real super-hard tool"
	quest.249BDBDED71AD605.quest_desc: [
		"&eWhat:&r the real material that nearly every drill bit and cutting insert on Earth is made of."
		"&eChemistry:&r heat tungsten powder with carbon at 1400-2000 °C: W + C → WC. Tungsten carbide is about Mohs 9 and keeps its hardness when red hot. Pressed with 6-12% cobalt as a binder it becomes 'cemented carbide', hard and tough at once."
		"&eHow:&r macerate raw tungsten into 2 tungsten dust."
		"&eTip:&r tungsten carbide is about twice as dense as steel. Pick up a carbide drill bit and it feels wrong."
	]
	quest.29AA69B51A6AFDD7.title: "Wooden Tools"
	quest.29AA69B51A6AFDD7.quest_subtitle: "Optional: the oldest composite you own"
	quest.29AA69B51A6AFDD7.quest_desc: [
		"&eWhat:&r the full wooden set: weak, cheap, and a fine fuel once it wears out."
		"&eChemistry:&r wood is a natural composite: long cellulose fibres, (C₆H₁₀O₅)ₙ chains of glucose, glued together by lignin. It's strong along the grain and splits easily across it."
		"&eHow:&r planks and sticks, shaped like any tool."
		"&eTip:&r a broken wooden tool burns in a furnace for as long as a plank. Nothing goes to waste."
	]
	quest.78EF41DFE812460E.title: "Soft Gold"
	quest.78EF41DFE812460E.quest_subtitle: "Optional: a ceremonial blade"
	quest.78EF41DFE812460E.quest_desc: [
		"&eWhat:&r a golden sword hits about as hard as a wooden one and wears out faster. Piglins like it, though."
		"&eChemistry:&r gold is the most malleable metal: one gram can be beaten into a leaf about a square metre wide and a few hundred atoms thick. Great for leaf, useless for an edge."
		"&eHow:&r smelt 8 gold ingots from raw gold (needs an iron-tier pick), then craft the sword."
		"&eTip:&r wearing one piece of gold armour keeps most piglins calm in the Nether."
	]
	quest.5C98652AE96904AD.title: "Diamond Sword and Shovel"
	quest.5C98652AE96904AD.quest_subtitle: "Optional: rounding out the diamond kit"
	quest.5C98652AE96904AD.quest_desc: [
		"&eWhat:&r the diamond sword is the vanilla weapon to beat until netherite; the shovel digs sand and gravel at speed."
		"&eChemistry:&r real diamond blades exist: diamond scalpels cut with an edge only a few nanometres wide. They're kept for eye surgery because one sideways knock can chip them."
		"&eHow:&r two diamonds and a stick for the sword, one diamond and two sticks for the shovel."
		"&eTip:&r enchant before you upgrade to netherite: the enchantments carry over."
	]
	quest.3728FFD02FB4DBFA.title: "Netherite Sword"
	quest.3728FFD02FB4DBFA.quest_subtitle: "Optional: upgrade the blade too"
	quest.3728FFD02FB4DBFA.quest_desc: [
		"&eWhat:&r the strongest vanilla sword, and it can't burn up in lava."
		"&eHow:&r smithing table: netherite upgrade template + diamond sword + netherite ingot."
		"&eTip:&r copy a template with 7 diamonds and a netherrack first, so the sword doesn't cost your last one."
	]
	quest.6750BD8E82E2D070.title: "Mekanism Blades"
	quest.6750BD8E82E2D070.quest_subtitle: "Optional: a sword from your own alloys"
	quest.6750BD8E82E2D070.quest_desc: [
		"&eWhat:&r Mekanism Tools makes a sword in every one of its metals: bronze, lapis, osmium, steel, refined glowstone and refined obsidian. Any one counts."
		"&eChemistry:&r a good sword is a compromise. Hard steel keeps an edge; soft steel bends instead of snapping. Japanese smiths welded both into one blade and quenched it with clay on the spine."
		"&eHow:&r two ingots (or gems) of the metal and a stick, like any sword (check JEI)."
		"&eTip:&r refined obsidian is the best of the set; steel is the cheapest one worth carrying."
	]
	quest.144F85C7FE48A4C1.title: "Lapis Armour"
	quest.144F85C7FE48A4C1.quest_subtitle: "Optional: blue and very enchantable"
	quest.144F85C7FE48A4C1.quest_desc: [
		"&eWhat:&r Mekanism Tools lapis armour protects about as well as chainmail but takes enchantments very well."
		"&eChemistry:&r the blue of lapis is the S₃⁻ radical ion caged in lazurite. Grind it, wash out the grey minerals, and you have ultramarine pigment."
		"&eHow:&r 24 lapis lazuli, shaped like any armour set (check JEI)."
		"&eTip:&r a cheap set to practise enchanting on while your diamonds go into machines."
	]
	quest.322E25AE504F1593.title: "A Full Leather Set"
	quest.322E25AE504F1593.quest_subtitle: "Optional: cap and trousers to match"
	quest.322E25AE504F1593.quest_desc: [
		"&eWhat:&r the helmet and leggings that finish the leather set from Getting Started. Leather can be dyed any colour."
		"&eChemistry:&r leather is tanned hide: tannins (plant polyphenols) or chromium(III) salts cross-link the collagen protein chains, so the skin stops rotting and stays flexible."
		"&eHow:&r 5 leather for the cap, 7 for the leggings. Craft a piece with dye to colour it; a water cauldron washes the dye out."
		"&eTip:&r leather boots let you walk on powder snow without sinking."
	]
	quest.209C0E4096417699.title: "Armour for a Friend"
	quest.209C0E4096417699.quest_subtitle: "Optional: armadillo scutes for your wolf"
	quest.209C0E4096417699.quest_desc: [
		"&eWhat:&r wolf armour soaks up damage for a tamed wolf. When it cracks, repair it with scutes."
		"&eChemistry:&r scutes are keratin plates, the same protein as hair, horn and nails. Disulfide (S–S) bridges between the chains make keratin tough; that's also why burning hair smells of sulfur."
		"&eHow:&r brush an armadillo (savanna and badlands) with a brush for scutes. 6 scutes make the armour; keep 2 for repairs."
		"&eTip:&r right-click a tamed wolf with the armour to put it on. Dye it if you like."
	]
	quest.0BC7913B1AAE9567.title: "Barding"
	quest.0BC7913B1AAE9567.quest_subtitle: "Optional: armour for your horse"
	quest.0BC7913B1AAE9567.quest_desc: [
		"&eWhat:&r horse armour, any kind. Leather horse armour can be crafted and dyed; iron, gold and diamond only turn up in chests."
		"&eHow:&r 7 leather for the leather one, or loot dungeons, temples, villages and Ancient Cities for the metal ones."
		"&eTip:&r Farmer's Delight Horse Feed heals a horse and speeds it up (Farming page)."
	]
	chapter.34560F2FAB74139C.title: "Storage and Logistics"
	chapter.34560F2FAB74139C.chapter_subtitle: [
		"A god needs somewhere to keep things."
	]
	quest.44D2496540C5F6FE.title: "Sophisticated Barrel"
	quest.44D2496540C5F6FE.quest_subtitle: "Chests and barrels that grow with you"
	quest.44D2496540C5F6FE.quest_desc: [
		"&6You remember vaults that held the stars. A barrel is humbler, but it's a start.&r"
		"&eWhat:&r Sophisticated Storage chests and barrels take upgrades, just like your backpack. Sophisticated Storage Plus raises their limits."
		"&eHow:&r craft a wooden barrel (check JEI). Tier upgrades improve it in place later."
		"&eTip:&r barrels keep their contents when broken, so moving a full one is easy."
	]
	quest.4C812FEC12C477A4.title: "Tier Upgrades"
	quest.4C812FEC12C477A4.quest_subtitle: "More slots without emptying anything"
	quest.4C812FEC12C477A4.quest_desc: [
		"&eWhat:&r tier upgrades turn a placed chest or barrel into the next tier (copper, iron, gold, diamond, netherite) without moving items."
		"&eHow:&r craft the upgrade (check JEI) and right-click it on the placed container."
		"&eTip:&r you can skip tiers with the direct upgrades, like basic → iron."
	]
	quest.45772E69CBC7F59A.title: "Compacting"
	quest.45772E69CBC7F59A.quest_subtitle: "Optional: nuggets to ingots to blocks, automatically"
	quest.45772E69CBC7F59A.quest_desc: [
		"&eWhat:&r the Compacting Upgrade squeezes 9 nuggets into an ingot and 9 ingots into a block as items arrive."
		"&eChemistry:&r a block holds the same metal atoms as 9 ingots; only the packing changes, so no mass is lost either way."
		"&eHow:&r craft it (check JEI) and put it in an upgrade slot. Add a filter so it only compacts what you choose."
	]
	quest.4723957D49EEF36E.title: "Storage Controller"
	quest.4723957D49EEF36E.quest_subtitle: "Optional: many containers, one inventory"
	quest.4723957D49EEF36E.quest_desc: [
		"&eWhat:&r the Controller joins touching Sophisticated containers into one inventory; Storage Links extend its reach."
		"&eHow:&r place it next to your chests and barrels. Pipes into the controller reach every connected container."
		"&eTip:&r one pipe into the controller is a simple sorting system: items go where matching items already are."
	]
	quest.34606B92A3A6F57F.title: "Drawers"
	quest.34606B92A3A6F57F.quest_subtitle: "Huge stacks of one item each"
	quest.34606B92A3A6F57F.quest_desc: [
		"&eWhat:&r Functional Storage drawers hold lots of a single item and show it on the front."
		"&eHow:&r craft an oak drawer (1, 2 or 4 slots; check JEI). Right-click to insert, left-click to take."
		"&eTip:&r upgrades (copper, gold, diamond, netherite) multiply drawer capacity."
	]
	quest.21D03D3F9703DD77.title: "Compacting Drawer"
	quest.21D03D3F9703DD77.quest_subtitle: "Optional: one drawer, three sizes of the same metal"
	quest.21D03D3F9703DD77.quest_desc: [
		"&eWhat:&r a compacting drawer stores nuggets, ingots and blocks of one metal as a single pool, and hands out whichever you ask for."
		"&eHow:&r craft it (check JEI), then insert the item you want to track."
		"&eTip:&r perfect for copper and tin near your bronze setup."
	]
	quest.129185B0D2C7C75A.title: "Drawer Controller"
	quest.129185B0D2C7C75A.quest_subtitle: "Optional: one face for every drawer"
	quest.129185B0D2C7C75A.quest_desc: [
		"&eWhat:&r the Storage Controller links nearby drawers into one inventory you (and pipes) can use."
		"&eHow:&r place it among your drawers. Use the Linking Tool to add drawers further away."
		"&eTip:&r a Controller Extension gives you a second access point."
	]
	quest.73F96D08F9DD5275.title: "An Early Network"
	quest.73F96D08F9DD5275.quest_subtitle: "Tom's Simple Storage: one searchable terminal"
	quest.73F96D08F9DD5275.quest_desc: [
		"&eWhat:&r Tom's Simple Storage connects your chests into one searchable terminal. It's your network until AE2."
		"&eHow:&r place an Inventory Connector touching your chests (or link them with Inventory Cables), and a Storage Terminal on it."
		"&eTip:&r point it at a drawer controller and every drawer shows up in the terminal."
	]
	quest.36279DAC568E66FC.title: "Crafting Terminal"
	quest.36279DAC568E66FC.quest_subtitle: "Optional: craft straight from storage"
	quest.36279DAC568E66FC.quest_desc: [
		"&eWhat:&r a terminal with a crafting grid that pulls ingredients from the network. JEI's + button fills it for you."
		"&eHow:&r upgrade a Storage Terminal (check JEI)."
		"&eTip:&r a Wireless Terminal (also in JEI) lets you use it from across the base."
	]
	quest.28340CD18CB88A6E.title: "Faster Furnaces"
	quest.28340CD18CB88A6E.quest_subtitle: "Iron Furnaces smelt faster"
	quest.28340CD18CB88A6E.quest_desc: [
		"&eWhat:&r Iron Furnaces are faster furnaces in metal tiers. A generator augment turns one into a small FE source."
		"&eChemistry:&r smelting iron ore is a reduction: carbon pulls the oxygen off, Fe₂O₃ + 3CO → 2Fe + 3CO₂."
		"&eHow:&r ring a furnace with iron (check JEI). Upgrade kits move it up a tier without breaking it."
	]
	quest.2AA6E5D8AD92D260.title: "Pipez"
	quest.2AA6E5D8AD92D260.quest_subtitle: "Simple item, fluid and energy pipes"
	quest.2AA6E5D8AD92D260.quest_desc: [
		"&eWhat:&r simple pipes for moving items, fluids and energy between non-MI machines."
		"&eHow:&r place a line from source to target, then set the end touching the source to extract (the pipe tooltip explains how)."
		"&eTip:&r MI machines have their own pipes; Pipez is best for everything else."
	]
	quest.3391DEB52E24862E.title: "LaserIO"
	quest.3391DEB52E24862E.quest_subtitle: "Move things through the air"
	quest.3391DEB52E24862E.quest_desc: [
		"&eWhat:&r Laser Nodes move items, fluids and energy between machines without cables."
		"&eHow:&r place nodes on machines, link them with the Laser Wrench, and add cards to set what moves (check JEI)."
		"&eTip:&r one node can serve all six faces of a block, great for compact chemical setups."
	]
	quest.01F07AC7CEBA34C1.title: "Entangled"
	quest.01F07AC7CEBA34C1.quest_subtitle: "Optional: one inventory, two places"
	quest.01F07AC7CEBA34C1.quest_desc: [
		"&eWhat:&r an Entangled Block is a window into another inventory: bind it to a chest or machine, and anything put in the Entangled Block goes into the bound block, even across dimensions."
		"&eHow:&r ender pearls, obsidian and a wooden chest (check JEI). Right-click the target with the Entangled Binder (pearls, obsidian and a diamond), then right-click the Entangled Block. Click the checkmark when one is working."
		"&eTip:&r put one next to a remote ore processor and pipe the output straight home. Both chunks must be loaded."
	]
	quest.24A467FAA663A7EF.title: "Storage in Motion"
	quest.24A467FAA663A7EF.quest_subtitle: "Optional: Sophisticated chests on rails and water"
	quest.24A467FAA663A7EF.quest_desc: [
		"&eWhat:&r Sophisticated Storage in Motion puts upgradeable chests and barrels on minecarts, boats and rafts, upgrades and all."
		"&eHow:&r combine a minecart with a Sophisticated chest or barrel (check JEI). Boats and rafts work the same way."
		"&eTip:&r a hopper upgrade on a storage minecart makes a simple ore train between your mine and base."
	]
	quest.14C4F705E5EB614F.title: "Stack Upgrades"
	quest.14C4F705E5EB614F.quest_subtitle: "Optional: more items in every slot"
	quest.14C4F705E5EB614F.quest_desc: [
		"&eWhat:&r stack upgrades multiply how many items fit in each slot of a chest or barrel. Higher tiers multiply more."
		"&eHow:&r an upgrade base and storage blocks (check JEI). Insert it in an upgrade slot."
		"&eTip:&r a barrel with a few stack upgrades holds a whole mine's worth of cobblestone or raw ore."
	]
	quest.317575EF2934BE98.title: "Drawer Upgrades"
	quest.317575EF2934BE98.quest_subtitle: "Optional: copper, gold, diamond, netherite"
	quest.317575EF2934BE98.quest_desc: [
		"&eWhat:&r storage upgrades multiply a drawer's capacity. Each tier (copper, gold, diamond, netherite) holds more."
		"&eHow:&r craft the upgrades in order (check JEI) and right-click the drawer to open its upgrade slots."
		"&eTip:&r the Iron Downgrade does the reverse, limiting a drawer to a single stack per slot."
	]
	quest.6A53B6D2F371F859.title: "Pullers and Pushers"
	quest.6A53B6D2F371F859.quest_subtitle: "Optional: drawers that move items themselves"
	quest.6A53B6D2F371F859.quest_desc: [
		"&eWhat:&r utility upgrades: the Puller pulls items from the block it faces, the Pusher pushes items into it. No pipes needed."
		"&eHow:&r check JEI. Put one in a drawer's utility slot and set its direction in the drawer's menu."
		"&eTip:&r a drawer with a Puller behind a macerator collects all the dust without a single pipe."
	]
	quest.46990CC570367505.title: "Fluid Drawers"
	quest.46990CC570367505.quest_subtitle: "Optional: drawers for liquids"
	quest.46990CC570367505.quest_desc: [
		"&eWhat:&r fluid drawers store a fluid instead of items, and show it on the front."
		"&eChemistry:&r handy for small stocks of acids: one drawer of H₂SO₄, one of HCl, one of HNO₃. A real lab keeps acids in separate, labelled containers too."
		"&eHow:&r check JEI. Pipes and MI fluid pipes can fill and drain them; the storage upgrades work on them too."
	]
	quest.6E40C57F90C4FE3B.title: "Ender Drawer"
	quest.6E40C57F90C4FE3B.quest_subtitle: "Optional: one drawer, many places"
	quest.6E40C57F90C4FE3B.quest_desc: [
		"&eWhat:&r every Ender Drawer with the same frequency shares one inventory, wherever it is."
		"&eHow:&r check JEI. Link drawers with the Linking Tool to give them the same frequency."
		"&eTip:&r put one at your mine and one at your smelters to send ore home."
	]
	quest.198E6DA2BCC8985F.title: "Inventory Cables"
	quest.198E6DA2BCC8985F.quest_subtitle: "Optional: reach chests across the room"
	quest.198E6DA2BCC8985F.quest_desc: [
		"&eWhat:&r inventory cables carry the Inventory Connector's reach to chests that aren't touching it."
		"&eHow:&r run cables from the connector and put a Cable Connector on each chest or drawer (check JEI)."
		"&eTip:&r framed cables can wear any block's texture, so they hide in walls."
	]
	quest.74EA12F84EA1A34D.title: "Wireless Terminal"
	quest.74EA12F84EA1A34D.quest_subtitle: "Optional: your early network, anywhere"
	quest.74EA12F84EA1A34D.quest_desc: [
		"&eWhat:&r the Advanced Wireless Terminal opens your Tom's network from a long way off."
		"&eHow:&r check JEI, then right-click it on a Storage Terminal to bind it."
		"&eTip:&r it's the cheapest remote storage access until AE2."
	]
	quest.69DDDBCD4E866CB4.title: "Sophisticated Chests"
	quest.69DDDBCD4E866CB4.quest_subtitle: "Optional: the same upgrades, in chest form"
	quest.69DDDBCD4E866CB4.quest_desc: [
		"&eWhat:&r Sophisticated chests take the same tier upgrades and upgrade cards as the barrels."
		"&eHow:&r craft a wooden chest version (check JEI). Tier upgrades work on it in place."
		"&eTip:&r the Decoration Table re-skins chests and barrels with any wood or block, so your storage room can match your base."
	]
	quest.3E872691D5DE867F.title: "Sophisticated Shulker Box"
	quest.3E872691D5DE867F.quest_subtitle: "Optional: upgradeable storage you can carry"
	quest.3E872691D5DE867F.quest_desc: [
		"&eWhat:&r a shulker box that takes tier upgrades and upgrade cards, and keeps everything inside when you pick it up."
		"&eHow:&r a chest, two shulker shells and a lever (check JEI). Shulkers live in End cities."
		"&eTip:&r a shulker box with a compacting upgrade is a portable ore bank for long mining trips."
	]
	quest.767BDE1049071494.title: "Netherite Storage"
	quest.767BDE1049071494.quest_subtitle: "Optional: the top tier"
	quest.767BDE1049071494.quest_desc: [
		"&eWhat:&r the netherite tier has the most slots and upgrade slots of any Sophisticated container."
		"&eHow:&r a diamond-to-netherite tier upgrade on a placed diamond chest or barrel (check JEI)."
		"&eTip:&r upgrade the containers you use most first; a netherite barrel full of stack upgrades holds a staggering amount."
	]
	quest.437BDBF9EB5E0A3A.title: "Limited Barrels"
	quest.437BDBF9EB5E0A3A.quest_subtitle: "Optional: drawer-style barrels with a few huge slots"
	quest.437BDBF9EB5E0A3A.quest_desc: [
		"&eWhat:&r limited barrels have one to four big slots and show their items on the front, like drawers, but take Sophisticated upgrades."
		"&eHow:&r check JEI for each size. They use the same tier upgrades as normal barrels."
		"&eTip:&r a four-slot limited barrel per metal (ore, dust, ingot, block) makes a tidy wall."
	]
	quest.60D0F5C1FAE2D0DD.title: "Hopper Upgrade"
	quest.60D0F5C1FAE2D0DD.quest_subtitle: "Optional: containers that pull and push themselves"
	quest.60D0F5C1FAE2D0DD.quest_desc: [
		"&eWhat:&r the Hopper Upgrade pulls items from one side and pushes them out another, with filters."
		"&eHow:&r an upgrade base, a hopper, iron and redstone (check JEI). Set directions and filters in the container's upgrade tab."
		"&eTip:&r a barrel with a hopper upgrade under a machine's output collects everything without pipes."
	]
	quest.43161D5C917A2792.title: "Compression Upgrade"
	quest.43161D5C917A2792.quest_subtitle: "Optional: nuggets, ingots and blocks as one stock"
	quest.43161D5C917A2792.quest_desc: [
		"&eWhat:&r the Compression Upgrade links a few slots so nuggets, ingots and blocks of one material count as a single stock."
		"&eHow:&r an upgrade base, pistons, iron and redstone (check JEI). Choose which slots it uses in the upgrade tab."
		"&eTip:&r take out exactly the form you need: blocks for storage, ingots for crafting, nuggets for small recipes."
	]
	quest.41BFE37C73B3E712.title: "Storage Input and Output"
	quest.41BFE37C73B3E712.quest_subtitle: "Optional: separate doors into your storage"
	quest.41BFE37C73B3E712.quest_desc: [
		"&eWhat:&r Storage Input only accepts items into the controller's containers; Storage Output only lets them out. Pipes and hoppers use them like any inventory."
		"&eHow:&r a wooden storage block, gold, planks and a repeater (check JEI). Place them touching the controller's group."
		"&eTip:&r put an Input at the end of your ore line and an Output by your crafting area, so the two never mix."
	]
	quest.5DD71B12870D590E.title: "Storage Tool"
	quest.5DD71B12870D590E.quest_subtitle: "Optional: link and lock from a distance"
	quest.5DD71B12870D590E.quest_desc: [
		"&eWhat:&r the Storage Tool links containers to a controller without touching it and toggles settings like locks and displays."
		"&eHow:&r an ender pearl, iron, sticks and a redstone torch (check JEI). Its tooltip lists each mode."
		"&eTip:&r locked slots keep their item type even when empty, so a sorting system never fills them with junk."
	]
	quest.3E28F4295DA98B59.title: "Gold Backpack"
	quest.3E28F4295DA98B59.quest_subtitle: "More rows, more upgrade slots"
	quest.3E28F4295DA98B59.quest_desc: [
		"&eWhat:&r the gold backpack adds inventory rows and upgrade slots over the iron one."
		"&eHow:&r surround an iron backpack with eight gold ingots. Everything inside stays put."
		"&eTip:&r this pack's upgrade base is also sold in the Demigod Token shop (search \"Demigod Token\" in JEI)."
	]
	quest.38D0C0420E9CD61E.title: "Diamond Backpack"
	quest.38D0C0420E9CD61E.quest_subtitle: "Optional: room for a whole lab's worth of reagents"
	quest.38D0C0420E9CD61E.quest_desc: [
		"&eWhat:&r the diamond backpack is the tier before netherite: even more rows and upgrade slots."
		"&eHow:&r surround a gold backpack with eight diamonds. Netherite comes after it (see Netherite Backpack on the QoL page)."
		"&eTip:&r spend the extra slots on stack upgrades first; they multiply every slot at once."
	]
	quest.5962C913253DCBED.title: "Everlasting"
	quest.5962C913253DCBED.quest_subtitle: "Optional: a backpack that can't be lost"
	quest.5962C913253DCBED.quest_desc: [
		"&eWhat:&r with the Everlasting Upgrade, a dropped backpack can't burn, explode or despawn."
		"&eHow:&r an upgrade base, nether stars and end crystals (check JEI). That means beating the Wither and visiting the End."
		"&eTip:&r worth it before reactor work or deep Nether trips, where a lost pack hurts most."
	]
	quest.50DE86ADFB0ED44D.title: "Crafting Upgrade"
	quest.50DE86ADFB0ED44D.quest_subtitle: "A crafting grid in your backpack"
	quest.50DE86ADFB0ED44D.quest_desc: [
		"&eWhat:&r adds a 3x3 crafting grid to the backpack screen that can use the backpack's own items."
		"&eHow:&r an upgrade base, a crafting table, iron and a chest (check JEI)."
		"&eTip:&r JEI's + button fills the backpack grid straight from the backpack."
	]
	quest.199FC6B41959C849.title: "Smelting on the Go"
	quest.199FC6B41959C849.quest_subtitle: "Optional: a furnace in your backpack"
	quest.199FC6B41959C849.quest_desc: [
		"&eWhat:&r the Smelting Upgrade is a furnace in the backpack screen. The Auto-Smelting Upgrade smelts matching items inside the backpack by itself, using fuel from the backpack."
		"&eChemistry:&r smelting iron ore is a reduction: carbon monoxide strips the oxygen off the ore, Fe₂O₃ + 3CO → 2Fe + 3CO₂."
		"&eHow:&r an upgrade base and a furnace for the first; the auto version adds a hopper, gold, redstone and a diamond (check JEI)."
		"&eTip:&r filter auto-smelting to raw ores only, or it will smelt your logs into charcoal too."
	]
	quest.5DDE2A62CC563B43.title: "Void Upgrade"
	quest.5DDE2A62CC563B43.quest_subtitle: "Optional: delete the junk as you pick it up"
	quest.5DDE2A62CC563B43.quest_desc: [
		"&eWhat:&r the Void Upgrade destroys chosen items as they enter the backpack: cobblestone, dirt, gravel, rotten flesh."
		"&eChemistry:&r real matter can't vanish (mass is conserved in every chemical reaction). In Minecraft, it can."
		"&eHow:&r an upgrade base, ender pearls, obsidian and redstone (check JEI). Set the filter carefully."
		"&eTip:&r keep a stack of cobblestone out of the filter. You'll want it for building and for the Matter Condenser later."
	]
	quest.30AEB3BE1D760F10.title: "Deposit and Restock"
	quest.30AEB3BE1D760F10.quest_subtitle: "Optional: empty into chests, refill from them"
	quest.30AEB3BE1D760F10.quest_desc: [
		"&eWhat:&r with a Deposit Upgrade, using the backpack on a chest puts matching items into it. A Restock Upgrade does the reverse, topping up the backpack from the chest."
		"&eHow:&r an upgrade base, a chest, iron, redstone and a piston (sticky for restock). Check JEI."
		"&eTip:&r deposit ores into your processing chest, restock torches and food from your supply chest, all in two clicks."
	]
	quest.1EF5A71CFAD4061B.title: "Tank Upgrade"
	quest.1EF5A71CFAD4061B.quest_subtitle: "Optional: carry fluids in your backpack"
	quest.1EF5A71CFAD4061B.quest_desc: [
		"&eWhat:&r the Tank Upgrade stores fluid inside the backpack. Fill and empty it with buckets or tanks from its upgrade tab."
		"&eChemistry:&r a real acid needs the right container: HF eats glass, so it's kept in PTFE; concentrated H₂SO₄ can sit in steel. A backpack tank isn't fussy."
		"&eHow:&r an upgrade base surrounded by glass (check JEI)."
		"&eTip:&r a tank of water means you're never stuck in a lava cave without a way to cool it into obsidian."
	]
	quest.3D68B879966847C4.title: "Speed and Fuel Augments"
	quest.3D68B879966847C4.quest_subtitle: "Optional: faster cooking, or longer-lasting fuel"
	quest.3D68B879966847C4.quest_desc: [
		"&eWhat:&r augments go in an Iron Furnace's augment slot. Speed cooks faster but burns more fuel; Fuel Efficiency does the opposite."
		"&eHow:&r stone, redstone and paper around sugar (speed) or coal (fuel). Check JEI."
		"&eTip:&r speed for ores you need now, fuel efficiency for slow bulk jobs like glass or charcoal."
	]
	quest.654A264E4B2127B7.title: "Furnace Generator"
	quest.654A264E4B2127B7.quest_subtitle: "Optional: burn fuel for FE instead of smelting"
	quest.654A264E4B2127B7.quest_desc: [
		"&eWhat:&r the Generator Augment turns an Iron Furnace into a small FE generator that burns furnace fuel."
		"&eChemistry:&r burning carbon releases about 394 kJ per mole: C + O₂ → CO₂. Every generator, from a furnace to a power plant, turns that heat into work."
		"&eHow:&r stone, redstone and paper around a repeater (check JEI). Put it in the augment slot and pull FE from the furnace."
		"&eTip:&r a few generator furnaces on charcoal can run the Alchemistry Dissolver before MI's electric age."
	]
	quest.10C32F4F5C98A2A3.title: "Factory and Blasting"
	quest.10C32F4F5C98A2A3.quest_subtitle: "Optional: many slots, or blast-furnace mode"
	quest.10C32F4F5C98A2A3.quest_desc: [
		"&eWhat:&r the Factory Augment gives a furnace several input slots that smelt side by side. The Blasting Augment makes it work like a blast furnace (the Smoking Augment like a smoker)."
		"&eHow:&r stone, redstone and paper around a piston (factory) or a blast furnace (blasting). Check JEI."
		"&eTip:&r a factory furnace runs on FE, so put it next to your generator furnaces."
	]
	quest.7F7F7AE8FCCD5830.title: "Gold Furnace"
	quest.7F7F7AE8FCCD5830.quest_subtitle: "Optional: the next tier up"
	quest.7F7F7AE8FCCD5830.quest_desc: [
		"&eWhat:&r each furnace tier cooks faster than the last: iron, gold, diamond, emerald, obsidian, netherite."
		"&eChemistry:&r gold melts at 1064 °C, lower than iron (1538 °C). It's here for its glitter, not its heat resistance."
		"&eHow:&r gold ingots and a gold block around an Iron Furnace (check JEI)."
	]
	quest.120BEFA94919009C.title: "Diamond Furnace"
	quest.120BEFA94919009C.quest_subtitle: "Optional: carbon, in its hardest form"
	quest.120BEFA94919009C.quest_desc: [
		"&eWhat:&r the diamond furnace is a big step up in speed."
		"&eChemistry:&r diamond is pure carbon, and it burns: heated in air to about 900 °C it turns into CO₂, like coal does."
		"&eHow:&r diamonds and glass around a Gold Furnace (check JEI)."
	]
	quest.31D9AF350D35865B.title: "Emerald Furnace"
	quest.31D9AF350D35865B.quest_subtitle: "Optional: faster still"
	quest.31D9AF350D35865B.quest_desc: [
		"&eWhat:&r the emerald furnace is faster than diamond, and the base for the obsidian tier."
		"&eChemistry:&r emerald is the mineral beryl, Be₃Al₂Si₆O₁₈, coloured green by a trace of chromium."
		"&eHow:&r emeralds around a Diamond Furnace (check JEI). Villager trading is the easy source of emeralds."
	]
	quest.015A0B700439D32C.title: "Obsidian Furnace"
	quest.015A0B700439D32C.quest_subtitle: "Optional: volcanic glass and blaze rods"
	quest.015A0B700439D32C.quest_desc: [
		"&eWhat:&r the obsidian furnace needs Nether blaze rods and is faster again."
		"&eChemistry:&r obsidian is volcanic glass: lava, mostly SiO₂, cooled so fast that no crystals could form."
		"&eHow:&r obsidian and blaze rods around an Emerald Furnace (check JEI)."
	]
	quest.049DBCCC2E53857E.title: "Netherite Furnace"
	quest.049DBCCC2E53857E.quest_subtitle: "Optional: the fastest furnace you'll build"
	quest.049DBCCC2E53857E.quest_desc: [
		"&6You remember fire that answered to you. This one comes close.&r"
		"&eWhat:&r the netherite furnace is the top of the normal Iron Furnaces line."
		"&eHow:&r netherite ingots, magma cream and a soul fire block around an Obsidian Furnace (check JEI)."
		"&eTip:&r use upgrade kits on a placed furnace so you keep its augment and settings."
	]
	quest.4D47DB0CB8D48178.title: "Silver Furnace"
	quest.4D47DB0CB8D48178.quest_subtitle: "Optional: a side branch for MI's silver"
	quest.4D47DB0CB8D48178.quest_desc: [
		"&eWhat:&r the silver furnace is a side tier between iron and gold, made with silver ingots."
		"&eChemistry:&r silver (Ag) is the best conductor of heat and electricity of any element, better even than copper."
		"&eHow:&r silver ingots and glass around an Iron Furnace (check JEI). Silver dust comes from ore byproducts in the MI Centrifuge."
	]
	quest.1B903ED1F099C34F.title: "Upgrade Kits"
	quest.1B903ED1F099C34F.quest_subtitle: "Optional: upgrade a furnace without breaking it"
	quest.1B903ED1F099C34F.quest_desc: [
		"&eWhat:&r upgrade kits turn a placed furnace into the next tier and keep its contents, augment and settings."
		"&eHow:&r each kit is the next tier's materials around a block (check JEI). Right-click the placed furnace with it."
		"&eTip:&r kits are cheaper than crafting a new furnace when you have a whole row to upgrade."
	]
	quest.3906982CF5CE98D2.title: "Barrels and Trapped Chests"
	quest.3906982CF5CE98D2.quest_subtitle: "Optional: the plain vanilla containers"
	quest.3906982CF5CE98D2.quest_desc: [
		"&eWhat:&r a barrel holds as much as a chest and opens even with a block on top. A trapped chest gives a redstone signal while someone has it open."
		"&eHow:&r barrel: planks and slabs. Trapped chest: a chest and a tripwire hook (check JEI)."
		"&eTip:&r a trapped chest next to a door makes a cheap 'is anyone in my lab?' alarm."
	]
	quest.76220BE84C524994.title: "Ender Chest"
	quest.76220BE84C524994.quest_subtitle: "Optional: one private inventory, everywhere"
	quest.76220BE84C524994.quest_desc: [
		"&eWhat:&r every Ender Chest you open shows the same 27 slots, and only you can see yours."
		"&eHow:&r 8 obsidian around an eye of ender."
		"&eTip:&r keep spare tools and a water bucket in it; any Ender Chest becomes an emergency kit."
	]
	quest.5ABF92EBA6B76EAC.title: "Hoppers"
	quest.5ABF92EBA6B76EAC.quest_subtitle: "Optional: the first item mover"
	quest.5ABF92EBA6B76EAC.quest_desc: [
		"&eWhat:&r a hopper pulls items from the container above it and pushes them into the one it points at."
		"&eHow:&r 5 iron ingots around a chest (Utilitarian also has a log recipe; check JEI)."
		"&eTip:&r a redstone signal locks a hopper, which makes simple item gates."
	]
	quest.24D0C566AB0B92AB.title: "On Rails"
	quest.24D0C566AB0B92AB.quest_subtitle: "Optional: haul ore by cart"
	quest.24D0C566AB0B92AB.quest_desc: [
		"&eWhat:&r minecarts move players and items along rails. A chest minecart carries cargo; a hopper minecart loads and unloads it."
		"&eChemistry:&r steel rails on steel wheels have very low rolling resistance, which is why one locomotive can pull thousands of tonnes."
		"&eHow:&r rails from iron and sticks; carts from 5 iron; combine a cart with a chest or a hopper (check JEI). Add powered rails to keep them moving."
		"&eTip:&r a hopper under the track at your base empties every chest cart that rolls over it."
	]
	quest.0B24E672E714DDCB.title: "Simple Compacting Drawer"
	quest.0B24E672E714DDCB.quest_subtitle: "Optional: two forms instead of three"
	quest.0B24E672E714DDCB.quest_desc: [
		"&eWhat:&r the simple version handles two forms of one item (ingot and block, say) instead of three."
		"&eHow:&r check JEI. Insert the item you want it to track."
		"&eTip:&r good for things with no nugget form, like coal and coal blocks."
	]
	quest.0E8BBA3A8819F628.title: "Drawer Tools"
	quest.0E8BBA3A8819F628.quest_subtitle: "Optional: lock, link and tidy your drawers"
	quest.0E8BBA3A8819F628.quest_desc: [
		"&eWhat:&r the Configuration Tool locks drawers to their item and changes how the front displays. The Linking Tool adds far-away drawers to a controller."
		"&eHow:&r check JEI for both. Sneak-use cycles the tool's mode; the mode shows on the item."
		"&eTip:&r lock every drawer in a sorting wall, so an empty drawer still only accepts its own item."
	]
	quest.565F00C582D234E8.title: "Controller Access Point"
	quest.565F00C582D234E8.quest_subtitle: "Optional: a second door into your drawer wall"
	quest.565F00C582D234E8.quest_desc: [
		"&eWhat:&r an access point works like the controller itself: pipes and players can use the whole drawer network through it."
		"&eHow:&r check JEI, then link it with the Linking Tool."
		"&eTip:&r one access point by the smelters, one by the crafting bench."
	]
	quest.2F46BAEB729FA068.title: "Copper and Gold Upgrades"
	quest.2F46BAEB729FA068.quest_subtitle: "Optional: the cheap capacity steps"
	quest.2F46BAEB729FA068.quest_desc: [
		"&eWhat:&r the first two capacity upgrades, before diamond. Each one multiplies how much a drawer holds."
		"&eChemistry:&r copper (8.96 g/cm³) and gold (19.3 g/cm³) are both soft and malleable, which is why they were the first metals people worked."
		"&eHow:&r copper: copper ingots and blocks, chests and a drawer. Gold builds on copper (check JEI)."
	]
	quest.3396BFBDB6C40BF6.title: "Netherite Drawer Upgrade"
	quest.3396BFBDB6C40BF6.quest_subtitle: "Optional: the biggest drawer there is"
	quest.3396BFBDB6C40BF6.quest_desc: [
		"&eWhat:&r the top drawer upgrade. One drawer holds an absurd amount of a single item."
		"&eHow:&r smithing table: netherite upgrade template + diamond upgrade + netherite ingot."
		"&eTip:&r save it for cobblestone, raw ore or dust, the things you have tens of thousands of."
	]
	quest.0E6E523DE8427EBF.title: "Void and Downgrade"
	quest.0E6E523DE8427EBF.quest_subtitle: "Optional: delete the overflow, or hold less"
	quest.0E6E523DE8427EBF.quest_desc: [
		"&eWhat:&r the Void Upgrade destroys whatever doesn't fit, so a full drawer never backs up a pipe. The Iron Downgrade limits a drawer to one stack per slot."
		"&eHow:&r both are drawer upgrades (check JEI)."
		"&eTip:&r a void-upgraded cobblestone drawer at the end of a quarry line keeps everything flowing."
	]
	quest.73531F8549FB5D54.title: "Upgrade Base"
	quest.73531F8549FB5D54.quest_subtitle: "Optional: the blank every upgrade starts from"
	quest.73531F8549FB5D54.quest_desc: [
		"&eWhat:&r every Sophisticated Storage upgrade card starts from an upgrade base."
		"&eHow:&r planks and iron ingots in a checker pattern. The backpack mod has its own base; JEI shows both."
		"&eTip:&r make a few at a time; you'll want stack, hopper and compacting upgrades soon."
	]
	quest.2478497698299592.title: "Copper Tier"
	quest.2478497698299592.quest_subtitle: "Optional: the first small step up"
	quest.2478497698299592.quest_desc: [
		"&eWhat:&r the copper tier sits between wood and iron: a few more slots for a little copper."
		"&eChemistry:&r copper tarnishes green: over years it forms a patina of basic copper carbonate, Cu₂CO₃(OH)₂, which then protects the metal underneath."
		"&eHow:&r right-click the placed container with the tier upgrade (check JEI)."
	]
	quest.5CEDE0D09BC9E44B.title: "Gold and Diamond Tiers"
	quest.5CEDE0D09BC9E44B.quest_subtitle: "Optional: climb the ladder one tier at a time"
	quest.5CEDE0D09BC9E44B.quest_desc: [
		"&eWhat:&r tier upgrades for an iron container to gold, then gold to diamond. More slots and more upgrade slots each time."
		"&eHow:&r check JEI, then right-click the placed chest or barrel. Nothing inside moves."
		"&eTip:&r upgrade the barrel your ore line feeds first; it fills fastest."
	]
	quest.4EA79F2D59AD8BFF.title: "The Netherite Tier Kit"
	quest.4EA79F2D59AD8BFF.quest_subtitle: "Optional: the last tier upgrade"
	quest.4EA79F2D59AD8BFF.quest_desc: [
		"&eWhat:&r turns a placed diamond chest or barrel into netherite: the most slots any Sophisticated container gets."
		"&eHow:&r a lever and a netherite ingot, shapeless."
		"&eTip:&r upgrade in place and every item and upgrade card inside stays where it was."
	]
	quest.44A83B065B0048B5.title: "Copper Backpack"
	quest.44A83B065B0048B5.quest_subtitle: "Optional: one small step before iron"
	quest.44A83B065B0048B5.quest_desc: [
		"&eWhat:&r the copper backpack sits between leather and iron: a few more slots and an extra upgrade slot."
		"&eHow:&r surround your backpack with copper ingots (check JEI). Everything inside stays put."
		"&eTip:&r copper is plentiful early, so this is the cheapest upgrade in the line."
	]
	quest.08E300D23A89C5D9.title: "Bigger Stacks"
	quest.08E300D23A89C5D9.quest_subtitle: "Optional: stack upgrades II and up"
	quest.08E300D23A89C5D9.quest_desc: [
		"&eWhat:&r each stack tier multiplies how many items fit in every backpack slot. Tier 2 and either tier 3 or 4."
		"&eHow:&r each tier is built from the one before with better materials (check JEI)."
		"&eTip:&r a backpack full of stacked dust is the cheapest way to move a day's mining to your machines."
	]
	quest.1C8600E724F1113E.title: "Compacting and Filters"
	quest.1C8600E724F1113E.quest_subtitle: "Optional: nuggets to ingots, and only what you want"
	quest.1C8600E724F1113E.quest_desc: [
		"&eWhat:&r the Compacting Upgrade squeezes 9 of something into its block as you pick it up. The Filter Upgrade decides what pipes and hoppers may put in or take out."
		"&eHow:&r an upgrade base with pistons, iron and redstone (compacting), or with string and redstone (filter). Check JEI."
		"&eTip:&r compact redstone, lapis and coal while mining; whole blocks take a ninth of the space."
	]
	quest.4BB6003995F45994.title: "Advanced Pickup"
	quest.4BB6003995F45994.quest_subtitle: "Optional: more filter slots, tag and mod filters"
	quest.4BB6003995F45994.quest_desc: [
		"&eWhat:&r the advanced versions of pickup, magnet and filter: more filter slots, plus filters by tag, mod or durability."
		"&eHow:&r each one is its basic upgrade with gold, diamonds and redstone (check JEI)."
		"&eTip:&r a tag filter for 'c:raw_materials' picks up every raw ore in the pack with one entry."
	]
	quest.39A06D5C8360B8C7.title: "Advanced Everything"
	quest.39A06D5C8360B8C7.quest_subtitle: "Optional: any two more advanced upgrades"
	quest.39A06D5C8360B8C7.quest_desc: [
		"&eWhat:&r almost every upgrade has an advanced form with more slots and finer filters: feeding, refill, restock, deposit, void, tool swapper, compacting, pump. Any two."
		"&eHow:&r the basic upgrade plus gold, diamonds and redstone (check JEI for each)."
		"&eTip:&r advanced feeding can be set to eat only when it won't waste food, so meals last longer."
	]
	quest.078048039CB21290.title: "Smoker and Blast Furnace"
	quest.078048039CB21290.quest_subtitle: "Optional: specialist cooking in your pack"
	quest.078048039CB21290.quest_desc: [
		"&eWhat:&r smoking upgrades cook food twice as fast; blasting upgrades smelt ores twice as fast. The auto versions work by themselves."
		"&eChemistry:&r a blast furnace forces air through the fuel, so it burns hotter. Real ones blow hot air into the bottom of a coke-and-ore stack: C + O₂ → CO₂, then CO₂ + C → 2CO, and the CO reduces the ore."
		"&eHow:&r an upgrade base with a smoker or a blast furnace, iron and redstone; the auto ones add hoppers, gold and diamonds (check JEI)."
		"&eTip:&r one of each, not both furnace upgrades: they share the backpack's fuel."
	]
	quest.746F54C2A600C026.title: "Pumps"
	quest.746F54C2A600C026.quest_subtitle: "Optional: fluids and experience on tap"
	quest.746F54C2A600C026.quest_desc: [
		"&eWhat:&r the Pump Upgrade fills and empties the backpack's tank from the world or from tanks. The XP Pump stores your experience and gives it back."
		"&eHow:&r pump: an upgrade base with buckets, glass, a piston and a sticky piston. XP pump: an advanced pump upgrade with ender eyes, bottles o' enchanting and redstone (check JEI)."
		"&eTip:&r bank your levels in the XP pump before a risky fight; a grave keeps items, not levels."
	]
	quest.143C1C0C468DEAB2.title: "Battery Upgrade"
	quest.143C1C0C468DEAB2.quest_subtitle: "Optional: FE in your backpack"
	quest.143C1C0C468DEAB2.quest_desc: [
		"&eWhat:&r stores Forge Energy in the backpack, which other upgrades and charging tools can use."
		"&eChemistry:&r a battery stores energy as chemistry: two electrodes with different appetites for electrons, kept apart by an electrolyte."
		"&eHow:&r an upgrade base with gold ingots and redstone blocks (check JEI)."
		"&eTip:&r charge it at home, then top up your jetpack or Mining Gadget in the field."
	]
	quest.71BA808FEAC08882.title: "Stonecutter Upgrade"
	quest.71BA808FEAC08882.quest_subtitle: "Optional: cut stone without a block"
	quest.71BA808FEAC08882.quest_desc: [
		"&eWhat:&r the Stonecutter Upgrade adds a stonecutter to the backpack screen."
		"&eHow:&r an upgrade base with a stonecutter, iron and redstone (check JEI)."
		"&eTip:&r perfect for Create Deco, Rechiseled and laboratory blocks on a building trip."
	]
	quest.0A0D6B351BA1796A.title: "Inception"
	quest.0A0D6B351BA1796A.quest_subtitle: "Optional: backpacks within backpacks"
	quest.0A0D6B351BA1796A.quest_desc: [
		"&eWhat:&r with the Inception Upgrade, backpacks stored inside your backpack keep using their own upgrades, and you can open them from the outer one."
		"&eHow:&r an upgrade base with ender eyes, diamonds and a Nether Star (check JEI)."
		"&eTip:&r a small 'mining' backpack inside your main one keeps its magnet and void settings separate."
	]
	quest.0D290B35BC958A75.title: "Mixtape"
	quest.0D290B35BC958A75.quest_subtitle: "Secret: music while you mine"
	quest.0D290B35BC958A75.quest_desc: [
		"&6You remember a time when the spheres sang to you. A jukebox in a backpack will have to do.&r"
		"&eWhat:&r the Jukebox Upgrade plays music discs from inside your backpack, wherever you walk."
		"&eTip:&r it plays to everyone nearby. Choose your disc with care."
	]
	quest.34FFD4956363A3AB.title: "Copper Furnace"
	quest.34FFD4956363A3AB.quest_subtitle: "Optional: the first metal furnace"
	quest.34FFD4956363A3AB.quest_desc: [
		"&eWhat:&r the copper furnace is a small step faster than vanilla, and the cheapest Iron Furnace."
		"&eChemistry:&r copper conducts heat about five times better than iron, which is why good saucepans have copper bottoms."
		"&eHow:&r 8 copper ingots around a furnace."
	]
	quest.00E5D0622F31D483.title: "Crystal Furnace"
	quest.00E5D0622F31D483.quest_subtitle: "Optional: a furnace you can see into"
	quest.00E5D0622F31D483.quest_desc: [
		"&eWhat:&r a side tier from diamond: as fast as a diamond furnace, built of clear glass."
		"&eChemistry:&r glass lets visible light through because its electrons need more energy than visible light carries to jump up, so the photons pass straight through."
		"&eHow:&r clear glass and an eye of ender around a diamond furnace (check JEI)."
	]
	quest.6C22B8BC24D08909.title: "Every Kit"
	quest.6C22B8BC24D08909.quest_subtitle: "Optional: any two more upgrade kits"
	quest.6C22B8BC24D08909.quest_desc: [
		"&eWhat:&r there's a kit for every step: vanilla to copper or iron, copper to iron, iron to gold or silver, diamond to emerald or crystal, up to netherite. Any two."
		"&eHow:&r each is the next tier's material around a stone tool material or gem (check JEI)."
		"&eTip:&r kits keep the furnace's augment, so upgrade a generator furnace without losing its setup."
	]
	quest.765C3CFF7AB22005.title: "Smoking Augment"
	quest.765C3CFF7AB22005.quest_subtitle: "Optional: a furnace that cooks food fast"
	quest.765C3CFF7AB22005.quest_desc: [
		"&eWhat:&r turns an Iron Furnace into a smoker: food only, at double speed."
		"&eChemistry:&r smoking preserves meat: phenols and other compounds in wood smoke kill microbes and slow the fats going rancid."
		"&eHow:&r stone, redstone and paper around a smoker."
	]
	quest.51B6B34D8378335D.title: "Wireless Heat"
	quest.51B6B34D8378335D.quest_subtitle: "Optional: run furnaces on FE without cables"
	quest.51B6B34D8378335D.quest_desc: [
		"&eWhat:&r the Wireless Heat Transmitter takes FE; a Wireless Heat Receiver bound to it goes into a furnace's fuel slot and heats it with that energy. Iron tier and up."
		"&eHow:&r the transmitter is stone, a comparator, a redstone block and a furnace; the receiver is stone, redstone and a comparator. Bind the receiver to the transmitter (check its tooltip)."
		"&eTip:&r one transmitter on your power line, receivers in a whole row of furnaces: no coal ever again."
	]
	quest.7714F7B6CE6E8C98.title: "Settings Linker"
	quest.7714F7B6CE6E8C98.quest_subtitle: "Optional: copy one furnace's setup to another"
	quest.7714F7B6CE6E8C98.quest_desc: [
		"&eWhat:&r the Furnace Settings Linker copies a furnace's side and redstone settings onto other furnaces."
		"&eHow:&r paper around a furnace (check JEI). Use it on the configured furnace, then on the others."
		"&eTip:&r set up one furnace's input and output sides, then copy it down the whole row."
	]
	quest.067098268A78E98D.title: "The Rainbow Furnace"
	quest.067098268A78E98D.quest_subtitle: "Optional: every furnace, melted into one"
	quest.067098268A78E98D.quest_desc: [
		"&6Every colour of fire at once. You remember when a flame would do whatever you asked.&r"
		"&eWhat:&r the Rainbow Furnace is the top of Iron Furnaces, built from one of every other furnace."
		"&eChemistry:&r flame colours are real chemistry: copper burns green, sodium yellow, strontium red, potassium lilac. Each element's electrons emit their own wavelengths (that's how fireworks get their colours)."
		"&eHow:&r rainbow plating is iron, gold, diamond, emerald, obsidian, crystal, copper and silver furnaces, shapeless (makes 8). The core is a netherite furnace in rainbow glass. 8 plating around the core makes the furnace."
	]
	chapter.1C6E26542D7508E5.title: "Power"
	chapter.1C6E26542D7508E5.chapter_subtitle: [
		"Energy is chemistry too: combustion, gas burning, fission and fusion."
	]
	quest.664799749DFCE0E4.title: "Choosing Your Power"
	quest.664799749DFCE0E4.quest_subtitle: "A catalogue of every way to make FE and EU"
	quest.664799749DFCE0E4.quest_desc: [
		"&6You remember holding lightning. For now, the generator you built in T1 will do.&r"
		"&eWhat:&r this page lists the pack's power options by row: combustion, storage, MI steam and EU, Powah, renewables and nuclear. Pick the lines that suit your base; most are optional."
		"&eChemistry:&r every generator turns some stored energy into current: chemical bonds (C + O₂ → CO₂), sunlight, wind, heat, or the nucleus itself."
		"&eHow:&r start from the Generator Galore generator you made for Forge Energy (FE), the power most mods share. Click the checkmark to open the page."
		"&eTip:&r MI machines run on EU, Modern Industrialization's own electricity (the MI steam and EU row). Most other mods run on FE."
	]
	quest.75F490C611174982.title: "A Faster Burn"
	quest.75F490C611174982.quest_subtitle: "Optional: same fuel, more FE per tick"
	quest.75F490C611174982.quest_desc: [
		"&eWhat:&r the next Generator Galore tier: it burns fuel faster and makes more FE per tick."
		"&eHow:&r upgrade from the iron generator (check JEI for the recipe)."
		"&eTip:&r a faster burn needs a steadier fuel supply. Pipe in charcoal from a tree farm."
	]
	quest.3F4B647DA140B71A.title: "Generator Collector"
	quest.3F4B647DA140B71A.quest_subtitle: "Four odd ways to make FE"
	quest.3F4B647DA140B71A.quest_desc: [
		"&eWhat:&r a diamond-tier generator plus three that burn strange fuels."
		"&eHow:&r each one's tooltip and JEI page show what it burns. The Halitosis Generator wants dragon's breath, so plan an End trip."
		"&eTip:&r the Culinary Generator eats spare food. Hook it to a farm's overflow."
	]
	quest.4104964F0EF1348C.title: "Bio Fuel"
	quest.4104964F0EF1348C.quest_subtitle: "Crops into power"
	quest.4104964F0EF1348C.quest_desc: [
		"&eWhat:&r Mekanism's Bio-Generator burns Bio Fuel."
		"&eChemistry:&r plants store sunlight as sugars and cellulose. Burning them releases it, and the CO₂ is the same CO₂ the plant took in."
		"&eHow:&r crush seeds and crops into Bio Fuel in a Mekanism Crusher."
	]
	quest.30A2E65738B8AE03.title: "Burning Hydrogen"
	quest.30A2E65738B8AE03.quest_subtitle: "Optional: the cleanest combustion there is"
	quest.30A2E65738B8AE03.quest_desc: [
		"&eWhat:&r the Gas-Burning Generator turns flammable gas into FE."
		"&eChemistry:&r 2H₂ + O₂ → 2H₂O + energy. The only exhaust is water."
		"&eHow:&r pipe hydrogen from your Electrolytic Separator in with pressurized tubes."
		"&eTip:&r electrolysis costs more energy than burning hydrogen returns. Use it to store spare power, not to make it."
	]
	quest.36381170B678DBC6.title: "Diesel Generators"
	quest.36381170B678DBC6.quest_subtitle: "Optional: petrochemical power"
	quest.36381170B678DBC6.quest_desc: [
		"&eWhat:&r MI generators that burn the fuels from your distillation tower."
		"&eChemistry:&r diesel is a mix of hydrocarbons around C₁₂ to C₂₀. Long chains pack lots of C-H bonds, and lots of energy."
		"&eHow:&r pipe diesel into the generator and cable it to your machines."
	]
	quest.39B5DB6B48A4B6D7.title: "Large Diesel Generator"
	quest.39B5DB6B48A4B6D7.quest_subtitle: "Optional: factory-scale combustion"
	quest.39B5DB6B48A4B6D7.quest_desc: [
		"&eWhat:&r a multiblock diesel generator for real factories."
		"&eHow:&r the 3D layout is in JEI and the MI guidebook. It needs fluid input and energy output hatches."
		"&eTip:&r refined fuels (like boosted diesel) burn for more EU per bucket. Check JEI."
	]
	quest.1EDE182DE2183A9C.title: "Heat Generator"
	quest.1EDE182DE2183A9C.quest_subtitle: "Mekanism's starter generator"
	quest.1EDE182DE2183A9C.quest_desc: [
		"&eWhat:&r Mekanism's first generator. It burns fuel and turns heat into FE."
		"&eHow:&r place lava next to it for a passive bonus, and feed it fuel for more."
		"&eTip:&r lava from a pump makes this a decent passive generator early on."
	]
	quest.63E2812122315EC2.title: "Store It"
	quest.63E2812122315EC2.quest_subtitle: "A buffer for your grid"
	quest.63E2812122315EC2.quest_desc: [
		"&eWhat:&r energy cubes hold FE so short spikes don't stall your machines."
		"&eHow:&r put one between your generators and machines. Configure its sides with the Configurator."
		"&eTip:&r cubes upgrade in place: craft the next tier around the old one."
	]
	quest.70651DDC383EDB77.title: "Bigger Cubes"
	quest.70651DDC383EDB77.quest_subtitle: "Alloys and energy tablets around the cube below"
	quest.70651DDC383EDB77.quest_desc: [
		"&eWhat:&r the Advanced Energy Cube holds and moves much more energy."
		"&eHow:&r a basic cube with infused alloy, osmium ingots and energy tablets around it (check JEI). Upgrading in place keeps the stored energy."
		"&eTip:&r Elite and Ultimate cubes follow the same pattern with reinforced and atomic alloys."
	]
	quest.44993050A3DC3B80.title: "Evaporation Ponds"
	quest.44993050A3DC3B80.quest_subtitle: "Sunlight and heat concentrate brine"
	quest.44993050A3DC3B80.quest_desc: [
		"&eWhat:&r the Thermal Evaporation Plant boils water down into brine, and brine down into liquid lithium."
		"&eChemistry:&r real lithium comes from salt flats: brine sits in ponds until the water evaporates and the salts concentrate."
		"&eHow:&r a multiblock tower of Thermal Evaporation Blocks, Valves and one Controller. See Just Enough Mekanism Multiblocks in JEI."
		"&eTip:&r taller towers and more heat run faster. Feed it plain water."
	]
	quest.02BB51B61A42F1E1.title: "Lithium"
	quest.02BB51B61A42F1E1.quest_subtitle: "The battery metal"
	quest.02BB51B61A42F1E1.quest_desc: [
		"&eWhat:&r lithium dust, for induction cells (and later, tritium)."
		"&eChemistry:&r lithium is the lightest metal and gives up its electron easily, which is why lithium-ion batteries store so much energy for their weight."
		"&eHow:&r run brine through the plant again for liquid lithium. Turn it into gas in a Rotary Condensentrator, then crystallise it in a Chemical Crystallizer."
		"&eTip:&r check JEI with &eR&r on Lithium Dust to confirm each step."
	]
	quest.54C26C329300A347.title: "Induction Matrix"
	quest.54C26C329300A347.quest_subtitle: "One multiblock battery for the whole base"
	quest.54C26C329300A347.quest_desc: [
		"&6Power stored, waiting, obedient. This feels familiar.&r"
		"&eWhat:&r a hollow multiblock battery. Cells inside set how much it stores; providers set how fast it charges and discharges."
		"&eHow:&r casings form the shell (Structural Glass works for the walls), ports move energy in and out. Layout: Just Enough Mekanism Multiblocks."
		"&eTip:&r switch one port to output with the Configurator. Start small; you can rebuild it larger later."
	]
	quest.392C4F4FA0F31627.title: "Wireless Grid"
	quest.392C4F4FA0F31627.quest_subtitle: "Optional: power anywhere, no cables"
	quest.392C4F4FA0F31627.quest_desc: [
		"&eWhat:&r Flux Networks sends power through the air: Plugs take it in, Points give it out, Storage buffers it."
		"&eHow:&r the Flux Core needs an &eMI processing unit&r (EV) in this pack. Link all devices to one network in their GUI."
		"&eTip:&r put a Flux Plug on your induction matrix's output port and every Point on the network draws from it."
	]
	quest.109BC5571612DD61.title: "EU Storage"
	quest.109BC5571612DD61.quest_subtitle: "A battery for MI's grid"
	quest.109BC5571612DD61.quest_desc: [
		"&eWhat:&r MI's storage unit holds EU, Modern Industrialization's electricity."
		"&eHow:&r built from redstone batteries, battery alloy plates and an LV hull. Put it between your turbine and your machines."
		"&eTip:&r a buffer lets your steam turbine keep running while machines are idle."
	]
	quest.1E551EC24D7B07BE.title: "MV Steam Turbine"
	quest.1E551EC24D7B07BE.quest_subtitle: "Optional: more steam, more EU"
	quest.1E551EC24D7B07BE.quest_desc: [
		"&eWhat:&r a bigger steam turbine that outputs MV power."
		"&eChemistry:&r a turbine converts the energy of hot, expanding steam into rotation, then a generator turns rotation into current."
		"&eHow:&r assemble it from an MV hull, aluminum rotors and large motors (check JEI)."
	]
	quest.18E2BC4078D46255.title: "Transformers"
	quest.18E2BC4078D46255.quest_subtitle: "Optional: step voltage between tiers"
	quest.18E2BC4078D46255.quest_desc: [
		"&eWhat:&r a transformer moves energy between two neighbouring voltage tiers (LV and MV here)."
		"&eHow:&r place it between an MV cable and your LV machines (or the other way round). Check which face is which in its tooltip."
		"&eTip:&r real grids do the same: high voltage for transmission, low voltage at the socket."
	]
	quest.1C5484680D3A8FE8.title: "HV Steam Turbine"
	quest.1C5484680D3A8FE8.quest_subtitle: "Optional: high-voltage steam"
	quest.1C5484680D3A8FE8.quest_desc: [
		"&eWhat:&r the HV steam turbine, for HV machine lines."
		"&eHow:&r check JEI for the recipe. Feed it from a large boiler."
		"&eTip:&r more steam than one turbine can eat? Add a second turbine on the same steam line."
	]
	quest.16133057CBACFAE4.title: "Large Steam Turbine"
	quest.16133057CBACFAE4.quest_subtitle: "Optional: power-station scale"
	quest.16133057CBACFAE4.quest_desc: [
		"&eWhat:&r MI's multiblock steam turbine. It eats steam by the thousands of mB and makes serious EU."
		"&eHow:&r the controller needs an HV steam turbine, a processing unit (EV) and a highly advanced hull. Layout: JEI or the MI guidebook."
		"&eTip:&r pair it with a large boiler or a reactor's steam output."
	]
	quest.61169F0AFAA00D90.title: "Energized Steel"
	quest.61169F0AFAA00D90.quest_subtitle: "Iron and gold, charged together"
	quest.61169F0AFAA00D90.quest_desc: [
		"&eWhat:&r Powah's basic alloy, made by the Energizing Orb."
		"&eHow:&r place Energizing Rods aimed at the orb and power them. Put 1 iron + 1 gold in the orb for 2 Energized Steel."
		"&eTip:&r more rods (and better rods) charge faster."
	]
	quest.0D7A0B7F7ED74F1F.title: "Powah Energy Cells"
	quest.0D7A0B7F7ED74F1F.quest_subtitle: "Stack your storage"
	quest.0D7A0B7F7ED74F1F.quest_desc: [
		"&eWhat:&r Powah's energy storage block, with tiers from Starter to Nitro."
		"&eHow:&r iron, a dielectric casing and Powah capacitors. Higher tiers use better capacitors and crystals (check JEI)."
		"&eTip:&r cells pass power through each other, so a wall of them makes one big buffer."
	]
	quest.582ADD5540E1751B.title: "Thermo Generator"
	quest.582ADD5540E1751B.quest_subtitle: "Power from a temperature difference"
	quest.582ADD5540E1751B.quest_desc: [
		"&eWhat:&r a generator that needs a hot block underneath and a coolant fed in."
		"&eChemistry:&r thermoelectric plates make current from a temperature difference (the Seebeck effect). Hotter below and colder inside means more power."
		"&eHow:&r place it on lava or magma and pipe water in."
	]
	quest.354774525777C4A9.title: "Powah Reactor"
	quest.354774525777C4A9.quest_subtitle: "Uraninite-fuelled multiblock"
	quest.354774525777C4A9.quest_desc: [
		"&eWhat:&r a multiblock reactor fuelled by the uraninite you oxidised yourself."
		"&eChemistry:&r uraninite is UO₂. Its uranium releases heat as it fissions; the reactor turns that heat into FE."
		"&eHow:&r place the reactor blocks in a stack and they form one reactor (check JEI). Feed it uraninite."
		"&eTip:&r fuel, temperature and coolant all show in its GUI. Watch the temperature as you scale up."
	]
	quest.5C6AD7D248FE5B0F.title: "Photovoltaics"
	quest.5C6AD7D248FE5B0F.quest_subtitle: "Optional: light straight into electricity"
	quest.5C6AD7D248FE5B0F.quest_desc: [
		"&eWhat:&r solar panels from Mekanism and Powah."
		"&eChemistry:&r silicon solar cells use a p-n junction: a photon knocks an electron loose and the junction pushes it into a current."
		"&eHow:&r place them under open sky. They stop at night and slow in rain."
		"&eTip:&r pair solar with an energy cube to cover the night."
	]
	quest.687502F33B0ACF31.title: "Advanced Solar"
	quest.687502F33B0ACF31.quest_subtitle: "A bigger array"
	quest.687502F33B0ACF31.quest_desc: [
		"&eWhat:&r Mekanism's Advanced Solar Generator, a larger array with much more output."
		"&eHow:&r check JEI for the recipe. Give it space: it's bigger than one block."
		"&eTip:&r like the basic panel, it only works in daylight. Buffer it with a cube."
	]
	quest.6CA4A3D8E8BB9BE6.title: "Wind Power"
	quest.6CA4A3D8E8BB9BE6.quest_subtitle: "Build it high"
	quest.6CA4A3D8E8BB9BE6.quest_desc: [
		"&eWhat:&r Mekanism's Wind Generator. It works day and night."
		"&eHow:&r it makes more power the higher it's placed. Build it on a mountain or a tall tower."
		"&eTip:&r it needs open space around it, so leave room."
	]
	quest.09A503304C6EC280.title: "Reactor Safety"
	quest.09A503304C6EC280.quest_subtitle: "Build the off-switch first"
	quest.09A503304C6EC280.quest_desc: [
		"&eWhat:&r Logic Adapters let redstone read the reactor and switch it off."
		"&eChemistry:&r a fission reactor makes heat by splitting heavy nuclei. If heat can't escape fast enough, the reactor takes damage; at 100% it melts down."
		"&eHow:&r set one adapter to emit a signal on damage or high temperature (pick the mode in its GUI) and wire it to another in Activation mode."
		"&eTip:&r start at a low burn rate (0.1 mB/t), keep coolant flowing, and drain waste and heated coolant constantly."
	]
	quest.0A9EE595B44C9104.title: "Industrial Turbine"
	quest.0A9EE595B44C9104.quest_subtitle: "Steam into enormous power"
	quest.0A9EE595B44C9104.quest_desc: [
		"&eWhat:&r Mekanism's multiblock turbine. Feed it steam from fission or a boiler and it makes huge amounts of FE."
		"&eHow:&r casings, valves, vents, rotors with blades, a rotational complex, a pressure disperser and electromagnetic coils. Layout: Just Enough Mekanism Multiblocks."
		"&eTip:&r a Saturating Condenser turns spent steam back into water, closing the loop."
	]
	quest.3CE4B1A7FBAD8566.title: "D-T Fuel"
	quest.3CE4B1A7FBAD8566.quest_subtitle: "Deuterium and tritium"
	quest.3CE4B1A7FBAD8566.quest_desc: [
		"&eWhat:&r fusion fuel: deuterium and tritium, the two heavy isotopes of hydrogen."
		"&eChemistry:&r deuterium comes from heavy water (D₂O). Tritium is bred from lithium by neutrons: ⁶Li + n → ³H + ⁴He."
		"&eHow:&r electrolyse heavy water for deuterium; put lithium in the Solar Neutron Activator for tritium. Combine them into D-T fuel in the Chemical Infuser, then fill a Hohlraum with it (a chemical tank's item slot works; see its tooltip)."
		"&eTip:&r heavy water comes from a Mekanism Electric Pump with a Filter Upgrade."
	]
	quest.2D19FF2F88C95DEA.title: "Fusion"
	quest.2D19FF2F88C95DEA.quest_subtitle: "The power of a star"
	quest.2D19FF2F88C95DEA.quest_desc: [
		"&6The power of a star, in a box you built. This is what you were.&r"
		"&eWhat:&r Mekanism's fusion reactor, the top of the power tree."
		"&eChemistry:&r D + T → ⁴He + n + 17.6 MeV, millions of times more energy per kilogram than any chemical reaction."
		"&eHow:&r a filled Hohlraum in the controller, then a burst from a Laser through a Laser Amplifier to ignite it. Layout: Just Enough Mekanism Multiblocks."
	]
	quest.42A8C9D5A8EBF106.title: "Upgrade in Place"
	quest.42A8C9D5A8EBF106.quest_subtitle: "Optional: upgrade a generator without breaking it"
	quest.42A8C9D5A8EBF106.quest_desc: [
		"&eWhat:&r Generators Galore upgrade kits turn a placed generator into the next tier, keeping its fuel and connections."
		"&eHow:&r gold ingots, an item frame and a redstone block for iron → gold (check JEI for the others). Right-click the placed generator."
		"&eTip:&r the tree branches: gold leads to diamond or to the food-burning Culinary Generator."
	]
	quest.491B66EA7719A9CD.title: "Eight Times the Burn"
	quest.491B66EA7719A9CD.quest_subtitle: "Optional: compressed generators"
	quest.491B66EA7719A9CD.quest_desc: [
		"&eWhat:&r 8x generators burn fuel eight times as fast and make eight times the FE in one block."
		"&eHow:&r eight generators of a tier around an echo shard (check JEI). Echo shards come from Ancient City chests."
		"&eTip:&r a 64x version exists too, for when space matters more than echo shards."
	]
	quest.0316471653C2202B.title: "Burning a Star"
	quest.0316471653C2202B.quest_subtitle: "Secret: fuel fit for a god"
	quest.0316471653C2202B.quest_desc: [
		"&6You remember lighting stars. Burning one feels like a waste, and also like coming home.&r"
		"&eWhat:&r the Nether Star Generator burns Nether Stars for an enormous amount of FE."
		"&eChemistry:&r real stars run on fusion: hydrogen nuclei fuse into helium (4 ¹H → ⁴He) and a little mass becomes a lot of energy, E = mc²."
	]
	quest.394211D5B3DB95C1.title: "Blazing Crystals"
	quest.394211D5B3DB95C1.quest_subtitle: "Powah's second tier: energized blaze"
	quest.394211D5B3DB95C1.quest_desc: [
		"&eWhat:&r every Powah tier is built from a crystal made in the Energizing Orb. Blazing crystals unlock the blazing tier of cells, generators and cables."
		"&eHow:&r energize a blaze rod (or four blaze powder) with 120,000 FE. Then craft blazing-tier parts (check JEI)."
		"&eTip:&r feed the energizing rods from your biggest power source; crystals charge faster with more rods."
	]
	quest.5540CD98C595C363.title: "Niotic Crystals"
	quest.5540CD98C595C363.quest_subtitle: "Energized diamond"
	quest.5540CD98C595C363.quest_desc: [
		"&eWhat:&r the niotic tier. Reactors and generators get much stronger."
		"&eChemistry:&r diamond is pure carbon in a rigid lattice where every atom bonds to four others. Pumping energy into it is Powah's magic, but diamond really does conduct heat better than any metal."
		"&eHow:&r energize a diamond with 300,000 FE (check JEI)."
	]
	quest.7972888C428AA464.title: "Spirited Crystals"
	quest.7972888C428AA464.quest_subtitle: "Energized emerald"
	quest.7972888C428AA464.quest_desc: [
		"&eWhat:&r the spirited tier, one step below the top."
		"&eChemistry:&r emerald is the mineral beryl, Be₃Al₂Si₆O₁₈. A trace of chromium (Cr³⁺) replacing some aluminum gives it its green colour."
		"&eHow:&r energize an emerald with 1,000,000 FE (check JEI). A villager trading hall pays off here."
	]
	quest.34546079D90320A3.title: "Nitro Crystals"
	quest.34546079D90320A3.quest_subtitle: "Optional: Powah's top tier"
	quest.34546079D90320A3.quest_desc: [
		"&eWhat:&r nitro crystals build the strongest Powah reactors and cells."
		"&eHow:&r energize a Nether Star, two redstone blocks and a blazing crystal block with 20,000,000 FE. One craft makes sixteen."
		"&eTip:&r save your Nether Stars for this; the Wither is the only reliable source (check JEI for a Hostile Neural Networks wither model)."
	]
	quest.30316683DE199107.title: "Ender Power"
	quest.30316683DE199107.quest_subtitle: "Optional: wireless Powah energy"
	quest.30316683DE199107.quest_desc: [
		"&eWhat:&r Ender Cells share one energy pool across your base; the Player Transmitter charges the items in your inventory."
		"&eHow:&r both need an Ender Core (an eye of ender, dielectric casing and a tiny capacitor, energized). Check JEI, and link them with a Binding Card."
		"&eTip:&r a player transmitter keeps jetpacks and the MekaSuit charged while you work."
	]
	quest.17B72E750B2DA75E.title: "Herculean Storage"
	quest.17B72E750B2DA75E.quest_subtitle: "Optional: a much bigger flux battery"
	quest.17B72E750B2DA75E.quest_desc: [
		"&eWhat:&r Herculean (and then Gargantuan) Flux Storage holds far more energy in one block, shared with the whole flux network."
		"&eHow:&r Basic Flux Storage blocks around glass panes (check JEI). Gargantuan is the same with Herculean blocks."
		"&eTip:&r flux storage keeps its energy when broken, so you can carry charged batteries to a new base."
	]
	quest.59B570AD2FBBC34F.title: "Flux Controller"
	quest.59B570AD2FBBC34F.quest_subtitle: "Optional: charge yourself from the network"
	quest.59B570AD2FBBC34F.quest_desc: [
		"&eWhat:&r the Flux Controller sends network energy wirelessly into players' inventories. The Configurator copies settings between flux devices."
		"&eHow:&r flux blocks, a Flux Core and flux dust (check JEI). The Flux Core needs an MI processing unit in this pack."
		"&eTip:&r turn charging off for your armor slots if it fights with other chargers."
	]
	quest.76374C5B1FE2BF4F.title: "Obsidian Generator"
	quest.76374C5B1FE2BF4F.quest_subtitle: "Optional: the hub of the late generator tree"
	quest.76374C5B1FE2BF4F.quest_desc: [
		"&eWhat:&r a stronger burner, and the base for the ender, enchantment and magmatic generators."
		"&eHow:&r a diamond generator in obsidian with a redstone block (or use the diamond to obsidian upgrade kit on a placed one)."
		"&eTip:&r the upgrade kits keep fuel and connections; JEI shows the whole tree."
	]
	quest.5AA4AD279F987736.title: "Emerald and Netherite Generators"
	quest.5AA4AD279F987736.quest_subtitle: "Optional: the two top solid-fuel burners"
	quest.5AA4AD279F987736.quest_desc: [
		"&eWhat:&r the emerald and netherite generators burn ordinary fuel at a much higher rate for much more FE per tick."
		"&eHow:&r emerald: a diamond generator in emeralds with a redstone block. Netherite: smithing table, template + diamond generator + netherite ingot."
		"&eTip:&r feed them coal blocks or coke blocks; loose coal won't keep up."
	]
	quest.5EDF0878D2A0BCC0.title: "Ender and Enchantment Generators"
	quest.5EDF0878D2A0BCC0.quest_subtitle: "Optional: burn pearls and enchanted books"
	quest.5EDF0878D2A0BCC0.quest_desc: [
		"&eWhat:&r the ender generator burns ender pearls; the enchantment generator burns enchanted books. Junk books from fishing finally have a use."
		"&eHow:&r an obsidian generator in ender pearls with a redstone block, or in enchanted books with an enchanting table (check JEI)."
		"&eTip:&r an enderman farm feeds the ender generator for ever."
	]
	quest.7B45AA45C19DB1E1.title: "Honey and Potion Generators"
	quest.7B45AA45C19DB1E1.quest_subtitle: "Optional: burn honey and leftover potions"
	quest.7B45AA45C19DB1E1.quest_desc: [
		"&eWhat:&r two branches from the Culinary Generator: one burns honey, the other burns potions."
		"&eChemistry:&r honey is about 80% sugars (fructose and glucose). Sugar burns well: C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O, the same reaction your cells run, only slower."
		"&eHow:&r a culinary generator in honey blocks with buckets and a redstone block, or in pink dye with brewing stands (check JEI)."
		"&eTip:&r a few beehives with campfires underneath keep the honey generator running."
	]
	quest.3D038A4FBE7828E6.title: "Compressed Generators"
	quest.3D038A4FBE7828E6.quest_subtitle: "Optional: another 8x or a 64x"
	quest.3D038A4FBE7828E6.quest_desc: [
		"&eWhat:&r any compressed generator other than the iron 8x: magmatic, star, gem, food, whatever you run most. 64x generators are eight 8x ones around a conduit."
		"&eHow:&r 8x: eight generators around an echo shard. 64x: eight 8x generators around a conduit (check JEI)."
		"&eTip:&r a 64x generator eats fuel 64 times as fast. Make sure the fuel line can keep up first."
	]
	quest.749DA6B4C4E44871.title: "Flux Dust"
	quest.749DA6B4C4E44871.quest_subtitle: "Optional: redstone crushed between obsidian and bedrock"
	quest.749DA6B4C4E44871.quest_desc: [
		"&eWhat:&r flux dust is the base of every Flux Networks device. Nine make a Flux Block."
		"&eChemistry:&r real redstone doesn't exist, but pressure really does change minerals: graphite squeezed hard enough becomes diamond, and that's the idea here."
		"&eHow:&r its tooltip says it: redstone compressed with bedrock and obsidian. JEI's Flux Networks page shows the setup. Bedrock is easy to reach at the Nether's floor or roof."
		"&eTip:&r make a big batch now. The Flux Core still needs an MI processing unit (EV), but the dust doesn't."
	]
	chapter.28808ADA8AC0C5E2.title: "Powah!"
	chapter.28808ADA8AC0C5E2.chapter_subtitle: [
		"Powah: dielectric parts, the Energizing Orb, crystal tiers, generators, cells and wireless power. The starter tier is open early; the Orb needs an MI electronic circuit (MV)."
	]
	quest.1B2EA615D5CF6C0E.title: "Dielectric Paste"
	quest.1B2EA615D5CF6C0E.quest_subtitle: "Coal, clay and heat"
	quest.1B2EA615D5CF6C0E.quest_desc: [
		"&6Insulators and conductors. You remember that power is mostly about where it is not allowed to go.&r"
		"&eWhat:&r the base of every Powah block: rods, casings, capacitors and cables."
		"&eChemistry:&r a dielectric is an insulator that polarises in an electric field. Fired clay (aluminosilicates such as kaolinite, Al₂Si₂O₅(OH)₄) is the porcelain on real power-line insulators."
		"&eHow:&r shapeless: 3 coal or charcoal + 2 clay balls + a lava bucket makes 24. Or 2 coal + 1 clay ball + 1 blaze powder for 16."
		"&eTip:&r the lava recipe gives more per craft and keeps the bucket. Make a stack."
	]
	quest.345BB838C641F0EB.title: "Dielectric Rods"
	quest.345BB838C641F0EB.quest_subtitle: "Paste set around iron bars"
	quest.345BB838C641F0EB.quest_desc: [
		"&eWhat:&r insulated rods, upright and horizontal. Both go into casings, the Orb, cables and cards."
		"&eHow:&r 6 paste around 3 iron bars: a vertical line of bars for the upright rod, a horizontal line for the horizontal one. 8 per craft."
		"&eTip:&r you'll need far more horizontal rods than upright ones; every cable craft eats six."
	]
	quest.4D1DE85C33E51944.title: "Dielectric Casing"
	quest.4D1DE85C33E51944.quest_subtitle: "The shell of every Powah block"
	quest.4D1DE85C33E51944.quest_desc: [
		"&eWhat:&r the frame inside almost every Powah machine, cell and generator."
		"&eHow:&r 4 iron ingots in the corners, horizontal rods top and bottom, upright rods in the middle row (check JEI)."
	]
	quest.7BD41E6982C597FE.title: "Capacitors"
	quest.7BD41E6982C597FE.quest_subtitle: "Two plates and an insulator"
	quest.7BD41E6982C597FE.quest_desc: [
		"&eWhat:&r capacitors set a block's tier. The tiny ones go into starter blocks, the basic ones into basic blocks."
		"&eChemistry:&r a capacitor is two conductors separated by a dielectric. It stores E = ½CV², and a better dielectric raises the capacitance C."
		"&eHow:&r iron ingots, paste and a redstone block make 4 basic capacitors. One basic capacitor splits into 2 tiny ones."
		"&eTip:&r two basic capacitors combine into a large one, which the hardened tier needs later."
	]
	quest.67DA0D7313A45702.title: "Energy Cables"
	quest.67DA0D7313A45702.quest_subtitle: "Wires that know their tier"
	quest.67DA0D7313A45702.quest_desc: [
		"&eWhat:&r Powah's cables. Each tier carries more FE per tick."
		"&eHow:&r 6 horizontal rods, 2 iron nuggets and a tiny capacitor make 12 starter cables."
		"&eTip:&r cables connect to any FE block, not just Powah ones. Use the Powah wrench to configure sides."
	]
	quest.41599518B7C0EF66.title: "Starter Energy Cell"
	quest.41599518B7C0EF66.quest_subtitle: "A first Powah battery block"
	quest.41599518B7C0EF66.quest_desc: [
		"&eWhat:&r the smallest Powah cell. Enough to smooth out a furnator's output."
		"&eHow:&r iron ingots in the corners, tiny capacitors on the sides, a dielectric casing in the middle."
		"&eTip:&r the basic cell is the same recipe with basic capacitors. The bigger tiers come with energized steel and crystals."
	]
	quest.606ACEE39FC2BBFF.title: "Powah Wrench"
	quest.606ACEE39FC2BBFF.quest_subtitle: "Rotate, configure, link"
	quest.606ACEE39FC2BBFF.quest_desc: [
		"&eWhat:&r Powah's wrench. It has Rotate, Config and Link modes; the mode shows on the item."
		"&eHow:&r iron ingots and dielectric paste (check JEI)."
		"&eTip:&r Config mode sets which sides of a cell or generator push or take power."
	]
	quest.429442A741259D63.title: "Furnator"
	quest.429442A741259D63.quest_subtitle: "Burn fuel, make FE"
	quest.429442A741259D63.quest_desc: [
		"&eWhat:&r a Powah generator that burns furnace fuel for FE. It's an early way to run the Dissolver."
		"&eChemistry:&r burning oxidises carbon. Coke burns cleaner and longer than coal because its volatile tars were already driven off."
		"&eHow:&r paste, 2 tiny capacitors, a dielectric casing and a furnace."
		"&eTip:&r feed it coke from your coke ovens for long runs."
	]
	quest.23D0B0246EFED78E.title: "Magmator"
	quest.23D0B0246EFED78E.quest_subtitle: "Power from molten rock"
	quest.23D0B0246EFED78E.quest_desc: [
		"&eWhat:&r a generator that burns lava (and other hot fluids) instead of solid fuel."
		"&eChemistry:&r lava is molten silicate rock at roughly 700 to 1,200 °C. The Magmator draws that stored heat off as FE."
		"&eHow:&r like the Furnator, but with a bucket in place of the furnace. JEI's Magmatic Fluids list shows what it accepts."
		"&eTip:&r a Nether lava lake and a pump give endless fuel."
	]
	quest.332755861094418C.title: "Basic Generators"
	quest.332755861094418C.quest_subtitle: "Upgrade a starter generator"
	quest.332755861094418C.quest_desc: [
		"&eWhat:&r every Powah block upgrades by crafting the lower tier into the next one. Basic is the first step."
		"&eHow:&r a starter generator in the bottom middle, iron ingots, 2 basic capacitors and a dielectric casing (check JEI)."
		"&eTip:&r upgrading keeps the old block's cost, so you never waste a starter."
	]
	quest.42F89DDEBE51A28D.title: "Player Aerial Pearl"
	quest.42F89DDEBE51A28D.quest_subtitle: "A pearl that remembers someone"
	quest.42F89DDEBE51A28D.quest_desc: [
		"&eWhat:&r the core of the Player Transmitter."
		"&eHow:&r craft an Aerial Pearl (an ender pearl in iron bars and paste), then use it on a Zombie or a Husk."
		"&eTip:&r trap a zombie near your base so you can make more later."
	]
	quest.7F94913057D6B0CF.title: "Player Transmitter"
	quest.7F94913057D6B0CF.quest_subtitle: "Charge your gear wirelessly"
	quest.7F94913057D6B0CF.quest_desc: [
		"&eWhat:&r a block that charges the FE items carried by the player bound to it."
		"&eHow:&r Player Aerial Pearl on top, tiny capacitors and a casing in the middle, an upright rod below. The Binding Card is a blank card (2 horizontal rods) with redstone and rotten flesh; right-click to bind it to yourself."
		"&eTip:&r power it from a cell and your jetpack never runs dry at home."
	]
	quest.055DB9E423D53A6B.title: "Panes and Plates"
	quest.055DB9E423D53A6B.quest_subtitle: "Optional: the parts of solar and thermo generators"
	quest.055DB9E423D53A6B.quest_desc: [
		"&eWhat:&r photoelectric panes go into Powah solar panels; thermo plates go into thermo generators (both in the Power chapter)."
		"&eChemistry:&r light can knock electrons out of a material: the photoelectric effect Einstein explained in 1905. Lapis gets its blue from trisulfur radical ions (S₃⁻) trapped in the mineral lazurite."
		"&eHow:&r pane: a glass pane in lapis and paste. Plate: a tiny capacitor in redstone and blaze powder."
		"&eTip:&r blaze powder means a trip to the Nether first."
	]
	quest.5F8856AC6332330C.title: "Hopper and Discharger"
	quest.5F8856AC6332330C.quest_subtitle: "Charge items, drain items"
	quest.5F8856AC6332330C.quest_desc: [
		"&eWhat:&r the Energy Hopper charges FE items in the container it faces; the Energy Discharger pulls FE back out of items put in it."
		"&eHow:&r both are a dielectric casing, tiny capacitors and paste; the hopper also takes a vanilla hopper (check JEI)."
		"&eTip:&r a hopper on a chest of tools makes a charging station."
	]
	quest.122160AE1EEB612D.title: "Batteries"
	quest.122160AE1EEB612D.quest_subtitle: "FE you can carry"
	quest.122160AE1EEB612D.quest_desc: [
		"&eWhat:&r Powah batteries are items that hold FE. Higher tiers hold more."
		"&eHow:&r basic capacitors, a redstone block and paste. Check its tooltip for how it charges your gear."
		"&eTip:&r fill it from an Energy Hopper, empty it in a Discharger."
	]
	quest.4E7E11981E036DF3.title: "Dimensional Binding Card"
	quest.4E7E11981E036DF3.quest_subtitle: "A card touched by the End"
	quest.4E7E11981E036DF3.quest_desc: [
		"&eWhat:&r the dimensional version of the Binding Card, for transmitters and other Powah blocks that take a card."
		"&eHow:&r use a Binding Card on an Enderman or an Endermite."
		"&eTip:&r read its tooltip to see what it does differently from the plain card."
	]
	quest.06B6BF3F2F8FAC26.title: "The Energizing Orb"
	quest.06B6BF3F2F8FAC26.quest_subtitle: "Pack gate: needs an MV electronic circuit"
	quest.06B6BF3F2F8FAC26.quest_desc: [
		"&6A glass sphere that fills with light. You remember charging things just by holding them.&r"
		"&eWhat:&r the Orb turns FE into new materials: energized steel, crystals, ender cores. Every Powah tier above basic needs it."
		"&eHow:&r in this pack: glass on top and sides, an MI &eelectronic circuit&r on each side of a dielectric casing in the middle, and 3 horizontal rods on the bottom. Rods: quartz, tiny capacitors, a casing and an upright rod."
		"&eHow:&r place the orb, aim Energizing Rods at it from nearby, feed the rods FE and put the ingredients in the orb. JEI's Energizing tab shows each recipe and its FE cost."
		"&eTip:&r the first job is uraninite and energized steel: see the Main Path and Power chapter links."
	]
	quest.188B2C143B0497A6.title: "Charged Snowball"
	quest.188B2C143B0497A6.quest_subtitle: "A pocket thunderstorm"
	quest.188B2C143B0497A6.quest_desc: [
		"&eWhat:&r a snowball charged with 500,000 FE. Throw it and lightning strikes where it lands."
		"&eChemistry:&r a lightning channel heats air to around 30,000 K, hotter than the Sun's surface. It splits N₂ and O₂, and the nitrogen oxides it makes fertilise the soil."
		"&eHow:&r one snowball in the Energizing Orb."
		"&eTip:&r lightning turns a pig into a zombified piglin and a villager into a witch. Aim carefully."
	]
	quest.139DB00CF3298722.title: "Better Rods"
	quest.139DB00CF3298722.quest_subtitle: "Quartz focuses the charge"
	quest.139DB00CF3298722.quest_desc: [
		"&eWhat:&r higher-tier rods pour FE into the orb faster. Several rods stack."
		"&eChemistry:&r quartz is crystalline SiO₂ and is piezoelectric: squeeze it and it makes a voltage. Every quartz watch keeps time with a vibrating crystal."
		"&eHow:&r a block of quartz on top, basic capacitors and a casing in the middle, a starter rod below."
		"&eTip:&r crystals cost hundreds of thousands of FE. More and better rods matter more than anything else here."
	]
	quest.2CBDC3EEA3E611E3.title: "Hardened Rods"
	quest.2CBDC3EEA3E611E3.quest_subtitle: "Energized steel capacitors in a rod"
	quest.2CBDC3EEA3E611E3.quest_desc: [
		"&eWhat:&r the hardened rod, another step in charging speed."
		"&eHow:&r a block of quartz, hardened capacitors, a casing and a basic rod below."
		"&eTip:&r every rod tier is built from the one before, so keep upgrading the same rods."
	]
	quest.5D0F8D07E1576330.title: "Hardened Capacitors"
	quest.5D0F8D07E1576330.quest_subtitle: "The first capacitor that needs the Orb"
	quest.5D0F8D07E1576330.quest_desc: [
		"&eWhat:&r hardened capacitors unlock the hardened tier of everything."
		"&eHow:&r 2 basic capacitors make a large one. A large capacitor in energized steel and paste makes 2 hardened capacitors."
		"&eTip:&r large capacitors go into every crystal capacitor too. Craft spares."
	]
	quest.054EDC7E57FF2429.title: "Hardened Cables"
	quest.054EDC7E57FF2429.quest_subtitle: "Optional: more FE per tick"
	quest.054EDC7E57FF2429.quest_desc: [
		"&eWhat:&r faster cables for your growing grid."
		"&eHow:&r basic: 6 rods, 2 starter cables, a basic capacitor. Hardened: 6 rods, 2 energized steel, a hardened capacitor makes 12 (check JEI)."
		"&eTip:&r a cable is only as fast as its slowest segment. Upgrade the trunk line first."
	]
	quest.16654E05A8CD99AF.title: "Hardened Energy Cell"
	quest.16654E05A8CD99AF.quest_subtitle: "Optional: a real buffer"
	quest.16654E05A8CD99AF.quest_desc: [
		"&eWhat:&r the next storage step after the basic cell."
		"&eHow:&r 2 basic cells, energized steel, hardened capacitors and a dielectric casing."
		"&eTip:&r the crystal cells in the Power chapter each start from the cell below them."
	]
	quest.7DCF509468F75457.title: "Hardened Generators"
	quest.7DCF509468F75457.quest_subtitle: "Energized steel around a generator"
	quest.7DCF509468F75457.quest_desc: [
		"&eWhat:&r a hardened Furnator, Magmator, Thermo Generator or Solar Panel. Any one counts."
		"&eHow:&r the basic generator plus energized steel, hardened capacitors and a casing (check JEI)."
		"&eTip:&r a hardened thermo generator on lava with water fed in is quiet, fuel-free power."
	]
	quest.4DDC08CE74AA7FC0.title: "Blazing Generators"
	quest.4DDC08CE74AA7FC0.quest_subtitle: "Crystal-tier power"
	quest.4DDC08CE74AA7FC0.quest_desc: [
		"&eWhat:&r any blazing-tier generator. Output takes a big jump here."
		"&eHow:&r the hardened generator plus blazing crystals, blazing capacitors and a casing."
		"&eTip:&r feed the orb's rods from these and the next crystal tier comes quicker."
	]
	quest.622A84D3D62D6075.title: "Niotic Generators"
	quest.622A84D3D62D6075.quest_subtitle: "Optional: diamond-tier power"
	quest.622A84D3D62D6075.quest_desc: [
		"&eWhat:&r any niotic-tier generator. Spirited and nitro follow the same pattern."
		"&eHow:&r the blazing generator plus niotic crystals, niotic capacitors and a casing (check JEI)."
	]
	quest.392532CF196EEA28.title: "Blazing Gear"
	quest.392532CF196EEA28.quest_subtitle: "Capacitor and rod from blazing crystals"
	quest.392532CF196EEA28.quest_desc: [
		"&eWhat:&r the blazing capacitor is the key part of every blazing block; the blazing rod charges the orb faster still."
		"&eHow:&r capacitor: a large capacitor in blazing crystals and paste (makes 2). Rod: quartz block, blazing capacitors, a casing and a hardened rod."
		"&eTip:&r a blaze farm (or a Hostile Neural Networks blaze model) keeps the crystals coming."
	]
	quest.15406D7A0C94F8DD.title: "Niotic Gear"
	quest.15406D7A0C94F8DD.quest_subtitle: "Diamond in the capacitor"
	quest.15406D7A0C94F8DD.quest_desc: [
		"&eWhat:&r niotic capacitors and the niotic rod."
		"&eChemistry:&r diamond is an excellent electrical insulator but conducts heat better than copper, because its stiff carbon lattice carries vibrations so well."
		"&eHow:&r capacitor: a large capacitor in niotic crystals and paste. Rod: quartz block, niotic capacitors, a casing and a blazing rod."
		"&eTip:&r niotic cables (6 rods, 2 niotic crystals, a niotic capacitor) carry far more FE."
	]
	quest.1FF97EC57F76D0DA.title: "Spirited Gear"
	quest.1FF97EC57F76D0DA.quest_subtitle: "Emerald in the capacitor"
	quest.1FF97EC57F76D0DA.quest_desc: [
		"&eWhat:&r spirited capacitors and the spirited rod, one step below the top."
		"&eHow:&r capacitor: a large capacitor in spirited crystals and paste. Rod: quartz block, spirited capacitors, a casing and a niotic rod."
		"&eTip:&r each spirited crystal costs 1,000,000 FE. Run several spirited rods before you try for nitro."
	]
	quest.4A9EC1F511BD0B62.title: "Nitro"
	quest.4A9EC1F511BD0B62.quest_subtitle: "Optional: the top of the Powah ladder"
	quest.4A9EC1F511BD0B62.quest_desc: [
		"&6Twenty million FE poured into a star. You remember power like this; it used to be yours.&r"
		"&eWhat:&r the nitro rod and nitro energy cell, the strongest Powah blocks."
		"&eHow:&r nitro capacitor: a large capacitor in nitro crystals and paste. Rod: quartz block, nitro capacitors, a casing and a spirited rod. Cell: nitro crystals, nitro capacitors, 2 spirited cells and a casing."
		"&eTip:&r the nitro crystal recipe needs a block of 9 blazing crystals, so save some blazing crystals for it."
	]
	quest.2F421D309B1AEF31.title: "Ender Core"
	quest.2F421D309B1AEF31.quest_subtitle: "An eye of ender, energized"
	quest.2F421D309B1AEF31.quest_desc: [
		"&eWhat:&r the heart of Ender Cells and Ender Gates."
		"&eHow:&r Energizing Orb: an eye of ender, a dielectric casing and a tiny capacitor, 50,000 FE."
		"&eTip:&r one core per ender block, at every tier."
	]
	quest.4D202C36DDF07F68.title: "Ender Gates"
	quest.4D202C36DDF07F68.quest_subtitle: "Optional: small taps on the ender network"
	quest.4D202C36DDF07F68.quest_desc: [
		"&eWhat:&r ender gates connect to the same ender energy network as your Ender Cells, without storing much themselves."
		"&eHow:&r obsidian, 2 starter cables and an ender core make 4. Set the channel in the GUI to match your cells."
		"&eTip:&r put a gate next to each remote machine and one Ender Cell at your main bank."
	]
	quest.26879FC1A7A253A5.title: "Dry Ice"
	quest.26879FC1A7A253A5.quest_subtitle: "A solid coolant for the reactor"
	quest.26879FC1A7A253A5.quest_desc: [
		"&eWhat:&r a strong solid coolant for the Powah reactor. Cooler reactors waste less fuel."
		"&eChemistry:&r real dry ice is solid CO₂, which sublimes straight to gas at -78.5 °C. Powah's is made from energized blue ice, which is H₂O, so take the name loosely."
		"&eHow:&r Energizing Orb: 2 blue ice, 10,000 FE. JEI's Coolants and Solid Coolants tabs list every option and its strength."
		"&eTip:&r the reactor also takes carbon and redstone to boost it. Check its GUI slots."
	]
	quest.486502690DC244A7.title: "Hardened Reactor"
	quest.486502690DC244A7.quest_subtitle: "Optional: rebuild the reactor a tier up"
	quest.486502690DC244A7.quest_desc: [
		"&eWhat:&r a hardened reactor, much stronger than the basic one."
		"&eChemistry:&r uraninite (UO₂) holds U-235, which splits when it absorbs a neutron and releases more neutrons and heat."
		"&eHow:&r 4 basic reactor blocks, 4 hardened capacitors and 1 uraninite make 4 hardened blocks. Every block in the stack must be the same tier."
		"&eTip:&r blazing, niotic, spirited and nitro reactors follow the same recipe with that tier's capacitor."
	]
	quest.4D77CEA314A1CE80.title: "Powah's Manual"
	quest.4D77CEA314A1CE80.quest_subtitle: "Optional: the mod's own guidebook"
	quest.4D77CEA314A1CE80.quest_desc: [
		"&eWhat:&r Powah's in-game book, with a page and a picture for every block on this chapter."
		"&eHow:&r a book and a dielectric paste, shapeless."
		"&eTip:&r add it to your Akashic Tome (Quality of Life page) so it doesn't take a slot."
	]
	quest.67479607B0DAFA8B.title: "Starter Reactor Blocks"
	quest.67479607B0DAFA8B.quest_subtitle: "Optional: where every reactor block begins"
	quest.67479607B0DAFA8B.quest_desc: [
		"&eWhat:&r starter reactor blocks. A stack of them forms a small reactor, and every basic reactor block is crafted from them."
		"&eChemistry:&r uranium dioxide is a ceramic: it melts near 2,865 °C, which is why real fuel pellets are UO₂ and not uranium metal."
		"&eHow:&r 4 uraninite, 4 tiny capacitors and a dielectric casing make 4. Basic blocks: 4 starter blocks, 4 large capacitors and a uraninite make 4."
		"&eTip:&r build the basic reactor (Power chapter) straight from these; starter reactors are weak."
	]
	quest.3221101541CDDAB5.title: "Bigger Batteries"
	quest.3221101541CDDAB5.quest_subtitle: "Optional: any battery above starter"
	quest.3221101541CDDAB5.quest_desc: [
		"&eWhat:&r each battery tier holds and moves more FE. Any one above starter counts."
		"&eChemistry:&r real batteries climb tiers too: lead-acid, then nickel-metal hydride, then lithium-ion, each storing more energy per kilogram."
		"&eHow:&r the lower battery, that tier's capacitors, a redstone block and paste (hardened and up add energized steel or crystals; check JEI)."
	]
	quest.0863B4B131DD160B.title: "Faster Chargers"
	quest.0863B4B131DD160B.quest_subtitle: "Optional: upgrade a hopper or discharger"
	quest.0863B4B131DD160B.quest_desc: [
		"&eWhat:&r higher-tier Energy Hoppers and Dischargers move FE into and out of items faster. Any one counts."
		"&eHow:&r the lower block in a ring of paste, with that tier's capacitors and a casing (check JEI)."
		"&eTip:&r a niotic hopper fills a MekaSuit in moments."
	]
	quest.337576FB79652F28.title: "Crystal Cables"
	quest.337576FB79652F28.quest_subtitle: "Optional: cables for a crystal-tier grid"
	quest.337576FB79652F28.quest_desc: [
		"&eWhat:&r blazing, niotic, spirited and nitro cables: each carries far more FE per tick. Any six."
		"&eHow:&r 6 horizontal rods, 2 cables of the tier below and that tier's capacitor make 6."
		"&eTip:&r only the trunk from your reactor needs top-tier cable; branches can stay hardened."
	]
	quest.77EBF5790B6539B7.title: "Starter Ender Cell"
	quest.77EBF5790B6539B7.quest_subtitle: "Optional: the cheapest window into the ender network"
	quest.77EBF5790B6539B7.quest_desc: [
		"&eWhat:&r an Ender Cell shares one energy pool with every other ender block on the same channel, wherever it is."
		"&eHow:&r an ender core, 4 obsidian and 4 iron nuggets."
		"&eTip:&r the channel is set in its screen; all your cells on channel 1 are one big battery."
	]
	quest.62E8661443403399.title: "A Wider Ender Network"
	quest.62E8661443403399.quest_subtitle: "Optional: better ender cells and gates"
	quest.62E8661443403399.quest_desc: [
		"&eWhat:&r any ender cell above starter and any ender gate above starter. Higher tiers move more FE through the network."
		"&eHow:&r an ender core in obsidian with energized steel or crystals for cells, or that tier's cables for gates (check JEI)."
		"&eTip:&r gates are cheap taps on the network; keep the big cells at home."
	]
	quest.1B5776CBC55DE500.title: "Stronger Transmitters"
	quest.1B5776CBC55DE500.quest_subtitle: "Optional: charge your gear faster"
	quest.1B5776CBC55DE500.quest_desc: [
		"&eWhat:&r higher-tier Player Transmitters push more FE into your inventory per tick. Any one above basic."
		"&eHow:&r the lower transmitter on top, that tier's capacitors and a casing in the middle, a rod below."
		"&eTip:&r one good transmitter beats three weak ones; it charges every item at once."
	]
	quest.28B960116B09CDC3.title: "Crystal Reactor"
	quest.28B960116B09CDC3.quest_subtitle: "Optional: rebuild the reactor in crystal"
	quest.28B960116B09CDC3.quest_desc: [
		"&eWhat:&r 36 reactor blocks of one crystal tier (blazing, niotic, spirited or nitro), enough for a full reactor."
		"&eChemistry:&r a real reactor's power is limited by how fast heat can be carried away, not by the fuel. Better coolant and better heat transfer mean more power from the same uranium."
		"&eHow:&r 4 blocks of the tier below, 4 of this tier's capacitors and a uraninite make 4."
		"&eTip:&r all 36 must be the same tier, or they won't form one reactor."
	]
	quest.7D1952B681C20AD1.title: "Spirited Generators"
	quest.7D1952B681C20AD1.quest_subtitle: "Optional: the top two generator tiers"
	quest.7D1952B681C20AD1.quest_desc: [
		"&eWhat:&r any spirited or nitro Furnator, Magmator, Thermo Generator or Solar Panel."
		"&eHow:&r the niotic generator with spirited crystals, spirited capacitors and a casing (nitro the same, one tier up)."
		"&eTip:&r a row of nitro solar panels is silent, fuel-free and enough for most bases."
	]
	quest.3ADFDC9FA6EBD390.title: "A Block of Nitro"
	quest.3ADFDC9FA6EBD390.quest_subtitle: "Secret: twenty million FE, nine times over"
	quest.3ADFDC9FA6EBD390.quest_desc: [
		"&6Nine crystals, each a star's worth of charge, pressed into one block. You remember holding that much. You used to call it Tuesday.&r"
		"&eWhat:&r a storage block of nitro crystals. It does nothing; it's just very, very expensive."
		"&eTip:&r you can always break it back into crystals."
	]
	chapter.355E4A964218121E.title: "Farming and Food"
	chapter.355E4A964218121E.chapter_subtitle: [
		"Grow what you need, cook it well, feed it back to the soil."
	]
	quest.61BB360C973E0F7F.title: "Knife and Board"
	quest.61BB360C973E0F7F.quest_subtitle: "Farmer's Delight starts with a cut"
	quest.61BB360C973E0F7F.quest_desc: [
		"&6You remember feasts that lasted a week. Start with something smaller.&r"
		"&eWhat:&r Farmer's Delight adds crops, meals and kitchen blocks. The knife harvests straw and cuts ingredients."
		"&eHow:&r craft a Flint Knife and a Cutting Board. Place items on the board and use the knife on them."
		"&eTip:&r a knife on tall grass gives straw; wild crops (tomatoes, onions, cabbage, rice) grow in the wild."
	]
	quest.1CD576F80AC49B5F.title: "Cooking Pot"
	quest.1CD576F80AC49B5F.quest_subtitle: "Heat, ingredients, and a meal"
	quest.1CD576F80AC49B5F.quest_desc: [
		"&eWhat:&r the Cooking Pot turns several ingredients into one meal. It needs heat underneath."
		"&eChemistry:&r browning meat is the Maillard reaction: amino acids and sugars react above about 140 °C, making hundreds of flavour compounds."
		"&eHow:&r iron, bricks, a wooden shovel and a water bucket (check JEI). Place it over a fire, campfire or Stove."
	]
	quest.2CFFEDC4683607CF.title: "A Proper Meal"
	quest.2CFFEDC4683607CF.quest_subtitle: "Food that keeps you full"
	quest.2CFFEDC4683607CF.quest_desc: [
		"&eWhat:&r Farmer's Delight meals restore a lot of hunger and give long effects like Nourishment (hunger stops dropping) and Comfort."
		"&eHow:&r cook vegetable soup in the Cooking Pot (check JEI), then bowl it."
		"&eTip:&r a Feeding Upgrade in your backpack eats these for you."
	]
	quest.6AAF559710229117.title: "Pasta with Meatballs"
	quest.6AAF559710229117.quest_subtitle: "Optional: four ingredients, three of them cooked first"
	quest.6AAF559710229117.quest_desc: [
		"&eWhat:&r a hearty meal that chains every kitchen tool: knife (minced beef), board (raw pasta from dough) and pot (tomato sauce)."
		"&eChemistry:&r dough is starch and gluten proteins; water lets gluten chains cross-link into the stretchy network that holds pasta together."
		"&eHow:&r follow the tree in JEI: wheat dough → raw pasta, beef → minced beef, tomatoes → tomato sauce, then the pot."
		"&eTip:&r press U on any ingredient in JEI to see every meal that uses it."
	]
	quest.6E91CE0ADEA5ADA6.title: "A Varied Diet"
	quest.6E91CE0ADEA5ADA6.quest_subtitle: "Optional: any six Farmer's Delight meals"
	quest.6E91CE0ADEA5ADA6.quest_desc: [
		"&eWhat:&r collect six bowls or plates of any Farmer's Delight meal: stews, soups, rice dishes, ratatouille, you choose."
		"&eHow:&r anything in the 'meals' tag counts. Mix and match, they don't have to be different."
		"&eTip:&r meals stack to 16; keep a stack in the backpack for long mining trips."
	]
	quest.26CA44769AF76A9D.title: "Rich Soil"
	quest.26CA44769AF76A9D.quest_subtitle: "Optional: compost into the best dirt"
	quest.26CA44769AF76A9D.quest_desc: [
		"&eWhat:&r organic compost slowly turns into Rich Soil, which grows crops faster and mushrooms into colonies."
		"&eChemistry:&r composting is microbes breaking down organic matter with oxygen. They release CO₂ and heat, and leave humus rich in nitrogen."
		"&eHow:&r craft compost from dirt, straw and bone meal plus rotten flesh or tree bark (check JEI), place it and wait."
		"&eTip:&r till Rich Soil with a hoe to get rich farmland for crops."
	]
	quest.2FB463350074B333.title: "The Stove"
	quest.2FB463350074B333.quest_subtitle: "Optional: a heat source that never burns out"
	quest.2FB463350074B333.quest_desc: [
		"&eWhat:&r the Stove heats a Cooking Pot or Skillet on top and can grill up to six items on its own surface."
		"&eHow:&r iron ingots, bricks and a campfire (check JEI). Light it with flint and steel."
		"&eTip:&r unlike a campfire it doesn't need logs, and it looks right in a kitchen."
	]
	quest.1DF7F1133046DEB1.title: "A Feast"
	quest.1DF7F1133046DEB1.quest_subtitle: "Optional: one block feeds the whole team"
	quest.1DF7F1133046DEB1.quest_desc: [
		"&eWhat:&r feasts are placed as blocks and served with a bowl, several portions each."
		"&eHow:&r cook a Honey Glazed Ham (check JEI). Place it on a table and right-click with bowls."
		"&eTip:&r a feast is the easiest way to feed a whole team before a boss fight."
	]
	quest.188A4BC2D2682264.title: "Banquet"
	quest.188A4BC2D2682264.quest_subtitle: "Optional: roast chicken and shepherd's pie"
	quest.188A4BC2D2682264.quest_desc: [
		"&eWhat:&r two more feasts for the table: a whole Roast Chicken and a Shepherd's Pie."
		"&eHow:&r both come from the Cooking Pot (check JEI). Each needs a container, often a bowl, to serve."
		"&eTip:&r place feasts where everyone passes, like next to the team's waystone."
	]
	quest.68C63D9C708CAB99.title: "Mushroom Colonies"
	quest.68C63D9C708CAB99.quest_subtitle: "Optional: mushrooms that keep growing"
	quest.68C63D9C708CAB99.quest_desc: [
		"&eWhat:&r a mushroom on Rich Soil grows into a colony that you can harvest again and again."
		"&eChemistry:&r fungi don't photosynthesise. They digest organic matter with enzymes, which is why rich, dark soil suits them."
		"&eHow:&r plant a brown or red mushroom on Rich Soil in low light, wait, then harvest it with shears; the colony stays and regrows."
		"&eTip:&r mushroom colonies are the steady source of mushrooms for stews and rice dishes."
	]
	quest.05CA20DAF3D6CE4E.title: "Skillet"
	quest.05CA20DAF3D6CE4E.quest_subtitle: "Optional: fry it, or hit something with it"
	quest.05CA20DAF3D6CE4E.quest_desc: [
		"&eWhat:&r a frying pan that cooks one item at a time over heat, and doubles as a surprisingly good weapon."
		"&eHow:&r iron ingots and a brick (check JEI). Place it on the Stove or a campfire, or check its tooltip for cooking in hand."
		"&eTip:&r Fire Aspect on a skillet sounds silly; it works."
	]
	quest.056B1AE78D5B1CCF.title: "Breakfast"
	quest.056B1AE78D5B1CCF.quest_subtitle: "Optional: eggs and bacon from the skillet"
	quest.056B1AE78D5B1CCF.quest_desc: [
		"&eWhat:&r the start of most Farmer's Delight breakfasts: fried eggs and cooked bacon."
		"&eChemistry:&r egg white turns opaque as heat unfolds its proteins (denaturation) and they tangle together; it can't go back."
		"&eHow:&r cut raw porkchop into bacon on the Cutting Board, then fry it and the eggs on the Skillet or Stove."
		"&eTip:&r combine them into Bacon and Eggs in the Cooking Pot (check JEI)."
	]
	quest.6D7BCF15F3CF7687.title: "The New Crops"
	quest.6D7BCF15F3CF7687.quest_subtitle: "Tomatoes, onions, cabbage and rice"
	quest.6D7BCF15F3CF7687.quest_desc: [
		"&eWhat:&r Farmer's Delight crops are the base of nearly every meal."
		"&eHow:&r find wild tomatoes, onions, cabbages and rice in the world (rice grows in shallow water). Break them for seeds and replant."
		"&eTip:&r rice must be planted in water one block deep, like in a real paddy."
	]
	quest.2D35837B42389FD6.title: "Tomatoes on a Rope"
	quest.2D35837B42389FD6.quest_subtitle: "Optional: grow upward"
	quest.2D35837B42389FD6.quest_desc: [
		"&eWhat:&r tomato vines climb rope, so a single plant grows several blocks tall and fruits all the way up."
		"&eHow:&r craft rope from straw (check JEI), hang it above a tomato plant, and let the vine climb."
		"&eTip:&r rope also lets you climb down mineshafts; right-click a placed rope to extend it downward."
	]
	quest.726507D0921F20DA.title: "Harvest Festival"
	quest.726507D0921F20DA.quest_subtitle: "Optional: 128 crops of any kind"
	quest.726507D0921F20DA.quest_desc: [
		"&eWhat:&r a full harvest: any 128 items from the shared crops tag (wheat, carrots, potatoes, tomatoes, rice and more)."
		"&eHow:&r a large field, Hopper Botany Pots, or an MI Farmer all count. Carry them in one go."
		"&eTip:&r crop storage blocks (crates and bags) pack 9 crops each; you need the loose crops here."
	]
	quest.3890E7B5FA9CA044.title: "Hopper Botany Pots"
	quest.3890E7B5FA9CA044.quest_subtitle: "A farm in one block"
	quest.3890E7B5FA9CA044.quest_desc: [
		"&eWhat:&r Hopper Botany Pots grow crops and push the harvest into the container below."
		"&eHow:&r place one on a chest, add soil (dirt) and a seed."
		"&eTip:&r Rich Soil or farmland grows faster than dirt, and Mystical Agriculture seeds work in pots too."
	]
	quest.1449CF00D49726FD.title: "Animal Husbandry"
	quest.1449CF00D49726FD.quest_subtitle: "Optional: breeding, explained by Just Enough Breeding"
	quest.1449CF00D49726FD.quest_desc: [
		"&eWhat:&r cows, sheep, pigs and chickens give food, leather, wool and eggs. Two adults fed their favourite food make a baby."
		"&eHow:&r lead two animals into a pen and feed them. Just Enough Breeding adds a JEI page per animal: look up any mob egg or food to see what it eats and what it drops."
		"&eTip:&r babies take about 20 minutes to grow; feeding them their breeding food speeds that up."
	]
	quest.797F266229BD1FB2.title: "Pet Food"
	quest.797F266229BD1FB2.quest_subtitle: "Optional: feed for horses and wolves"
	quest.797F266229BD1FB2.quest_desc: [
		"&eWhat:&r Horse Feed heals and speeds up horses; Dog Food heals tamed wolves and gives them buffs."
		"&eHow:&r both are Farmer's Delight crafting recipes (check JEI)."
		"&eTip:&r a well-fed wolf is a decent bodyguard in the early Twilight Forest."
	]
	quest.383BB756C9C76954.title: "N, P and K"
	quest.383BB756C9C76954.quest_subtitle: "The three numbers on every fertiliser bag"
	quest.383BB756C9C76954.quest_desc: [
		"&eWhat:&r plants need nitrogen (N), phosphorus (P) and potassium (K) more than anything else from the soil. These three compounds deliver them."
		"&eChemistry:&r urea CO(NH₂)₂ is 46% nitrogen; diammonium phosphate (NH₄)₂HPO₄ carries N and P; potassium nitrate KNO₃ carries K and N."
		"&eHow:&r make all three in the Alchemistry Combiner (check JEI for the element recipe of each)."
		"{@pagebreak}"
		"&eDeep dive: why nitrogen is the hard one.&r"
		"Air is 78% nitrogen, but N₂ has a triple bond that plants can't break. Only some soil bacteria (and lightning) can 'fix' it."
		"In 1909 Fritz Haber found how to force N₂ + 3H₂ → 2NH₃ with a metal catalyst, high pressure and heat; Carl Bosch scaled it up."
		"Today about half the nitrogen in your body passed through a Haber-Bosch plant. Ammonia is turned into urea, ammonium nitrate and phosphates."
		"You'll build that same reaction in the main quests (Haber-Bosch, HV tier). Phosphorus comes from mined phosphate rock, and potassium from potash salts like KCl."
	]
	quest.201E746EF18C024B.title: "NPK Fertilizer"
	quest.201E746EF18C024B.quest_subtitle: "Liquid fertiliser from the Chemical Reactor"
	quest.201E746EF18C024B.quest_desc: [
		"&eWhat:&r Extended Industrialization's NPK Fertilizer is a fluid the MI Farmer can spread to grow crops faster."
		"&eChemistry:&r bone meal is calcium phosphate; sulfuric acid frees phosphoric acid, H₃PO₄, just like the real 'wet process' for phosphate rock."
		"&eHow:&r Chemical Reactor, three steps (check JEI): bone meal + H₂SO₄ → phosphoric acid; potato/carrot/beetroot + water + HCl → potassium chloride, then KCl + H₂ + O₂ → potassium hydroxide; finally nitrogen + phosphoric acid + KOH → NPK Fertilizer."
		"&eTip:&r real NPK plants start from ammonia, not raw nitrogen. Here the recipe takes the shortcut."
	]
	quest.42489EAAE4800867.title: "The Steam Farmer"
	quest.42489EAAE4800867.quest_subtitle: "Optional: a multiblock that plants and harvests"
	quest.42489EAAE4800867.quest_desc: [
		"&eWhat:&r Extended Industrialization's Farmer is a multiblock that tills, plants, harvests and (with fertiliser) speeds up a whole field."
		"&eHow:&r analog circuits, a motor, bronze plated bricks, a steel combine and a bronze pipe casing (check JEI). Its layout is in JEI and the MI guidebook."
		"&eTip:&r the Electric Farmer is the upgrade. JEI has a fertiliser page that shows which fluids speed up a Farmer."
	]
	quest.4388A334EC12570D.title: "Food Fight"
	quest.4388A334EC12570D.quest_subtitle: "Secret: ammunition, not dinner"
	quest.4388A334EC12570D.quest_desc: [
		"&eWhat:&r you found a use for spoiled tomatoes: rotten tomatoes can be thrown."
		"&eChemistry:&r rotting is bacteria and fungi breaking sugars into acids, alcohols and gases. Don't eat it."
		"&eTip:&r they're also good compost material. Probably better than throwing them at the team."
	]
	quest.795662BF85103267.title: "Kitchen Garden"
	quest.795662BF85103267.quest_subtitle: "Optional: seeds, roots, melons and berries"
	quest.795662BF85103267.quest_desc: [
		"&eWhat:&r the vanilla crops beyond wheat: potatoes and carrots from village farms, melons from jungles, sweet berries from taiga."
		"&eChemistry:&r a potato is mostly starch, long chains of glucose packed into grains. Cooking swells and bursts the grains (gelatinisation), which is why a baked potato is soft."
		"&eHow:&r break grass for seeds, raid a village farm for potatoes and carrots, and replant everything."
		"&eTip:&r sweet berry bushes hurt to walk through. Plant a row as a mob fence."
	]
	quest.707EBA33CCE0C439.title: "Barnyard Goods"
	quest.707EBA33CCE0C439.quest_subtitle: "Optional: everything a pen of animals gives"
	quest.707EBA33CCE0C439.quest_desc: [
		"&eWhat:&r 16 raw meat of any kind, plus leather, feathers and eggs: the steady output of a few animal pens."
		"&eChemistry:&r an eggshell is about 95% calcium carbonate, CaCO₃: the same compound as chalk and limestone. Drop one in vinegar and it fizzes away as CO₂."
		"&eHow:&r breed cows, pigs, sheep, chickens or rabbits and harvest the adults. Chickens lay eggs on their own."
		"&eTip:&r cook meat before eating; raw chicken can give you Hunger."
	]
	quest.19B3E12AC6512111.title: "Milk"
	quest.19B3E12AC6512111.quest_subtitle: "Optional: the cure for most status effects"
	quest.19B3E12AC6512111.quest_desc: [
		"&eWhat:&r drinking milk clears every potion effect, good and bad. It's also a baking ingredient."
		"&eChemistry:&r milk is an emulsion: fat droplets held in water by proteins (casein). Add acid and the casein clumps into curds, which is the first step of every cheese."
		"&eHow:&r use an empty bucket on a cow (or a goat)."
		"&eTip:&r carry one into the Deep Dark or the Wither fight to wipe Darkness or Wither in one gulp."
	]
	quest.4001ABEC58F9F590.title: "Sugar"
	quest.4001ABEC58F9F590.quest_subtitle: "Optional: crystallised sucrose"
	quest.4001ABEC58F9F590.quest_desc: [
		"&eWhat:&r sugar goes into cakes, pies, fermented spider eyes and speed potions."
		"&eChemistry:&r table sugar is sucrose, C₁₂H₂₂O₁₁: a glucose and a fructose joined together. Heat it past about 160 °C and it breaks down into hundreds of brown, bitter-sweet compounds: caramel."
		"&eHow:&r one sugar cane makes one sugar. A row of cane on Snad (Quality of Life page) grows fast."
		"&eTip:&r the Alchemistry Dissolver splits sucrose into carbon, hydrogen and oxygen if you need the elements."
	]
	quest.4859615A20A98EB3.title: "Bake Sale"
	quest.4859615A20A98EB3.quest_subtitle: "Optional: a cake and two pies"
	quest.4859615A20A98EB3.quest_desc: [
		"&eWhat:&r a cake (placed and eaten a slice at a time) and pumpkin pie, the best vanilla snack per bite."
		"&eChemistry:&r baking is chemistry you can eat: egg proteins set the structure, sugar caramelises, and the Maillard reaction between sugars and proteins browns the crust."
		"&eHow:&r cake: 3 milk buckets, 2 sugar, an egg and 3 wheat (you keep the buckets). Pie: a pumpkin, sugar and an egg."
		"&eTip:&r a cake on the table in your base means nobody ever starves between trips."
	]
	quest.0CEEB0EF247AFEE1.title: "Honey and Wax"
	quest.0CEEB0EF247AFEE1.quest_subtitle: "Optional: rob a hive without being stung"
	quest.0CEEB0EF247AFEE1.quest_desc: [
		"&eWhat:&r shears on a full bee nest give honeycomb; a glass bottle gives honey. Honeycomb waxes copper so it never tarnishes."
		"&eChemistry:&r beeswax is mostly long esters (fatty acids joined to long alcohols). Wax on copper keeps out the air and water that would turn it green."
		"&eHow:&r put a campfire under the nest first: the smoke keeps the bees calm. Then shear it or bottle it when it's dripping."
		"&eTip:&r honey bottles cure poison and can be crafted into sugar."
	]
	quest.5B3831A5F122F274.title: "An Apiary"
	quest.5B3831A5F122F274.quest_subtitle: "Optional: your own hive and its blocks"
	quest.5B3831A5F122F274.quest_desc: [
		"&eWhat:&r a beehive you can place where you like, plus the two honey blocks: sticky honey blocks and decorative honeycomb blocks."
		"&eChemistry:&r honey is a supersaturated sugar solution, about 80% sugar in 17% water. That's why it slowly crystallises, and why bacteria can't live in it: the sugar pulls the water out of them."
		"&eHow:&r a beehive is planks and honeycomb. A honey block is 4 honey bottles; a honeycomb block is 4 honeycomb. Lead bees home with flowers."
		"&eTip:&r honey blocks slow anything on them and stop pistons pulling other blocks; great for flying machines."
	]
	quest.5008B9812B5F38D8.title: "Wildflowers"
	quest.5008B9812B5F38D8.quest_subtitle: "Optional: 16 flowers of any kind"
	quest.5008B9812B5F38D8.quest_desc: [
		"&eWhat:&r flowers make dyes, feed bees and decorate. Any 16 count."
		"&eChemistry:&r many flower colours are anthocyanins, pigments that change colour with pH: the same molecule is red in acid and blue in alkali, like red cabbage indicator."
		"&eHow:&r pick them in meadows and flower forests, or bone meal grass to grow more."
		"&eTip:&r cornflower gives blue dye without lapis."
	]
	quest.2C27F6E0A24ECFCC.title: "Bone Meal"
	quest.2C27F6E0A24ECFCC.quest_subtitle: "Optional: phosphate for your crops"
	quest.2C27F6E0A24ECFCC.quest_desc: [
		"&eWhat:&r bone meal makes crops, saplings and flowers grow instantly."
		"&eChemistry:&r bone is mostly hydroxyapatite, Ca₅(PO₄)₃(OH). Ground bone was one of the first phosphate fertilisers, before mined phosphate rock took over."
		"&eHow:&r one bone makes 3 bone meal; a composter also turns plant scraps into it."
		"&eTip:&r the NPK quests further along this page start from bone meal."
	]
	quest.4F51D89D9F8829D4.title: "Hay Bales"
	quest.4F51D89D9F8829D4.quest_subtitle: "Optional: wheat in bulk"
	quest.4F51D89D9F8829D4.quest_desc: [
		"&eWhat:&r a hay bale is 9 wheat. Horses and llamas eat it, and landing on one cuts fall damage by 80%."
		"&eHow:&r 9 wheat in the crafting grid."
		"&eTip:&r a hay bale under a campfire makes the smoke rise much higher: a signal for friends."
	]
	quest.18F6CFCBB960E126.title: "Crates and Bags"
	quest.18F6CFCBB960E126.quest_subtitle: "Optional: store a harvest in a block"
	quest.18F6CFCBB960E126.quest_desc: [
		"&eWhat:&r Farmer's Delight crates and bags hold 9 crops each and look good in a pantry. Any four."
		"&eHow:&r 9 of the crop in the crafting grid (check JEI). Break one back into crops any time."
		"&eTip:&r a wall of crates is a kitchen store that doubles as decoration."
	]
	quest.10DB0AD9FC683E4A.title: "From the Sea"
	quest.10DB0AD9FC683E4A.quest_subtitle: "Optional: kelp, and a bright fish"
	quest.10DB0AD9FC683E4A.quest_desc: [
		"&eWhat:&r kelp grows fast underwater; dried, it's a snack and (as a block) a good furnace fuel. Tropical fish come from fishing or warm oceans."
		"&eChemistry:&r burnt kelp ash was the world's first source of iodine: Bernard Courtois found it in 1811 when sulfuric acid on seaweed ash gave off violet I₂ vapour. The ash was also a source of soda for glass."
		"&eHow:&r harvest kelp, smelt it into dried kelp, and catch or bucket a tropical fish."
		"&eTip:&r 9 dried kelp make a block that burns for 20 items in a furnace."
	]
	quest.0E68D7AE1C7DBBA0.title: "Nether Fungi"
	quest.0E68D7AE1C7DBBA0.quest_subtitle: "Optional: farm the Nether's forests"
	quest.0E68D7AE1C7DBBA0.quest_desc: [
		"&eWhat:&r crimson and warped fungi grow into huge Nether trees when bone-mealed on matching nylium. Warped fungus on a stick steers a strider."
		"&eChemistry:&r real fungi aren't plants: their cell walls are chitin, the same polymer as insect shells, not cellulose."
		"&eHow:&r pick them in the crimson and warped forests. Bone meal on nylium grows more."
		"&eTip:&r hoglins run from warped fungus. Plant some around your Nether base."
	]
	quest.15F725E5C01D018A.title: "Chorus Orchard"
	quest.15F725E5C01D018A.quest_subtitle: "Optional: the End's only crop"
	quest.15F725E5C01D018A.quest_desc: [
		"&eWhat:&r chorus fruit teleports you a short way when eaten. Smelted, it becomes popped chorus fruit for purpur blocks, end rods and Silent Gear's glittery dust."
		"&eHow:&r break chorus plants on the outer End islands, or plant a chorus flower on end stone and grow your own."
		"&eTip:&r in this pack the Potion of Flying uses hydrogen, not chorus, so this crop is for building and Silent Gear."
	]
	quest.37E826F1EDD6F372.title: "Flax"
	quest.37E826F1EDD6F372.quest_subtitle: "Optional: string without spiders"
	quest.37E826F1EDD6F372.quest_desc: [
		"&eWhat:&r Silent Gear's flax gives fibre for string, so bows and bindings don't depend on spider hunts."
		"&eChemistry:&r flax fibre is nearly pure cellulose. Linen, made from it, is one of the oldest textiles, woven for over 30,000 years."
		"&eHow:&r find flax seeds (check JEI for where they drop), grow them, and craft 2 flax fibre into a flax string."
		"&eTip:&r flax flowers make blue dye too."
	]
	quest.6E4CBAC1961181AC.title: "Overqualified"
	quest.6E4CBAC1961181AC.quest_subtitle: "Secret: the most expensive way to till dirt"
	quest.6E4CBAC1961181AC.quest_desc: [
		"&6You remember making forests grow with a word. Now you're upgrading a hoe with netherite. Priorities.&r"
		"&eWhat:&r a netherite hoe. It tills, it harvests leaves and sculk fast, and it cost you a netherite ingot."
		"&eTip:&r hoes are the fastest tool for leaves, hay, moss and sculk. So it isn't entirely a joke."
	]
	chapter.58F2F526022035F5.title: "Quality of Life"
	chapter.58F2F526022035F5.chapter_subtitle: [
		"Small things that make a big difference."
	]
	quest.082FF7126C739233.title: "Comfort First"
	quest.082FF7126C739233.quest_subtitle: "A catalogue of small conveniences"
	quest.082FF7126C739233.quest_desc: [
		"&6You remember never wasting a motion. These small things feel familiar.&r"
		"&eWhat:&r this page collects the mods that save time and clicks: guidebooks, backpacks, waystones, maps, keybinds and the Utilitarian shortcuts."
		"&eHow:&r each row is one topic. Nearly everything here is optional, so pick what helps you. Click the checkmark to open the page."
		"&eTip:&r none of this is needed for the main path, but most of it pays for itself within an hour."
	]
	quest.7861E90E0F778D26.title: "One Book to Rule Them All"
	quest.7861E90E0F778D26.quest_subtitle: "Every guidebook in one item"
	quest.7861E90E0F778D26.quest_desc: [
		"&eWhat:&r the Akashic Tome merges every mod's guidebook into one item."
		"&eHow:&r craft it, then right-click it with other guidebooks to add them."
		"&eTip:&r right-click the tome to choose which book to open."
	]
	quest.24E1DFE3C86BAB94.title: "Find Anything"
	quest.24E1DFE3C86BAB94.quest_subtitle: "Compasses for biomes and structures"
	quest.24E1DFE3C86BAB94.quest_desc: [
		"&eWhat:&r Nature's Compass finds biomes; Explorer's Compass finds structures (Nether Fortresses, Ancient Cities, villages)."
		"&eHow:&r craft both (check JEI), right-click to pick a target, then follow the needle."
		"&eTip:&r the Explorer's Compass is the fastest way to find an Ancient City for the Deeper and Darker quests."
	]
	quest.417C968CF0B6DB90.title: "No More Mob Spawns"
	quest.417C968CF0B6DB90.quest_subtitle: "One torch, a huge safe radius"
	quest.417C968CF0B6DB90.quest_desc: [
		"&eWhat:&r the Mega Torch stops hostile mobs spawning naturally in a huge radius."
		"&eHow:&r check JEI for the recipe and place it near the middle of your base."
		"&eTip:&r it blocks natural spawns only. Spawners and Simulation Chambers still work."
	]
	quest.2CDD3C38275B155C.title: "Graves"
	quest.2CDD3C38275B155C.quest_subtitle: "Your items wait where you fell"
	quest.2CDD3C38275B155C.quest_desc: [
		"&eWhat:&r if you die, Corail Tombstone keeps your items in a grave where you fell."
		"&eHow:&r walk back and open the grave to recover everything. Click the checkmark once you've read this."
		"&eTip:&r JourneyMap drops a waypoint where you died, so the grave is easy to find."
	]
	quest.6DE92B29EF0F35A9.title: "Backups"
	quest.6DE92B29EF0F35A9.quest_subtitle: "Optional: automatic world saves"
	quest.6DE92B29EF0F35A9.quest_desc: [
		"&eWhat:&r Simple Backups saves your world automatically."
		"&eHow:&r on a server, backups live in the server's backups folder. In single player, look in your instance folder."
		"&eTip:&r copy a backup somewhere else before trying risky reactor builds."
	]
	quest.604BDD9A6947B39B.title: "Dread Lamp"
	quest.604BDD9A6947B39B.quest_subtitle: "Optional: the Mega Torch for Nether mobs"
	quest.604BDD9A6947B39B.quest_desc: [
		"&eWhat:&r the Dread Lamp blocks Nether mob spawns in a large radius, the way the Mega Torch does for Overworld mobs."
		"&eHow:&r check JEI. Place it at your Nether base or portal hub."
		"&eTip:&r place it before building in the Nether so your base stays quiet."
	]
	quest.7B910D75AE5CB5BE.title: "Crafting on a Stick"
	quest.7B910D75AE5CB5BE.quest_subtitle: "A crafting table that fits in your pocket"
	quest.7B910D75AE5CB5BE.quest_desc: [
		"&eWhat:&r a crafting table you carry around. Right-click it to open a 3x3 grid anywhere: in a mine, out exploring, mid-build."
		"&eHow:&r craft it from a crafting table and a stick (check JEI). The same mod makes pocket versions of the stonecutter, smithing table, anvil, grindstone, loom and cartography table."
		"&eTip:&r it saves a hotbar slot over placing and breaking tables. The pocket stonecutter is great for building with Create Deco and Rechiseled blocks."
	]
	quest.0168A13FA2435F4D.title: "A Whole Workshop"
	quest.0168A13FA2435F4D.quest_subtitle: "Pocket stonecutter and smithing table"
	quest.0168A13FA2435F4D.quest_desc: [
		"&eWhat:&r optional: the pocket stonecutter and smithing table."
		"&eHow:&r each one is its block plus a stick (check JEI)."
		"&eTip:&r the smithing table is how netherite and Apotheosis upgrades are applied, so it's handy to carry."
	]
	quest.4BC3CD31C26ED641.title: "Backpack Upgrades"
	quest.4BC3CD31C26ED641.quest_subtitle: "Pickup and magnet upgrades"
	quest.4BC3CD31C26ED641.quest_desc: [
		"&eWhat:&r pickup and magnet upgrades pull items straight into your backpack."
		"&eHow:&r craft an Upgrade Base, then the upgrades (check JEI). Put them in the backpack's upgrade slots."
		"&eTip:&r set a filter on the pickup upgrade so it only grabs ores and drops you actually want."
	]
	quest.288CF747C2D939F7.title: "Iron Backpack"
	quest.288CF747C2D939F7.quest_subtitle: "More slots and more upgrade space"
	quest.288CF747C2D939F7.quest_desc: [
		"&eWhat:&r each backpack tier adds inventory rows and upgrade slots: iron, gold, diamond, netherite."
		"&eHow:&r surround your backpack with iron ingots (check JEI). It keeps everything inside."
		"&eTip:&r stack upgrades multiply how many items fit in each slot."
	]
	quest.087BBFFCDB2D5BBE.title: "Feeding Upgrade"
	quest.087BBFFCDB2D5BBE.quest_subtitle: "Optional: never stop to eat again"
	quest.087BBFFCDB2D5BBE.quest_desc: [
		"&eWhat:&r eats food from the backpack automatically when you're hungry."
		"&eHow:&r check JEI. Farmer's Delight meals restore a lot per bite."
		"&eTip:&r set a filter so it doesn't eat your golden apples."
	]
	quest.667CA6C7D1391223.title: "Netherite Backpack"
	quest.667CA6C7D1391223.quest_subtitle: "Optional: the biggest backpack"
	quest.667CA6C7D1391223.quest_desc: [
		"&eWhat:&r the top tier: the most inventory slots and upgrade space."
		"&eHow:&r ring the backpack with gold, then diamonds, then smith in a netherite ingot with a netherite upgrade template."
		"&eTip:&r a netherite backpack has room for several stack upgrades at once."
	]
	quest.5B094C907C8047AF.title: "Waystones"
	quest.5B094C907C8047AF.quest_subtitle: "Teleport between your places"
	quest.5B094C907C8047AF.quest_desc: [
		"&eWhat:&r waystones are teleport points. Activate one by right-clicking it, then warp between any you've activated."
		"&eHow:&r found in villages, or craft one (check JEI). Place them at your base, mines and portals."
		"&eTip:&r warping costs a little XP depending on distance; check the config if it seems steep."
	]
	quest.491A989F2FB877C8.title: "Warp Scrolls"
	quest.491A989F2FB877C8.quest_subtitle: "Optional: one-use trips to any waystone"
	quest.491A989F2FB877C8.quest_desc: [
		"&eWhat:&r a single-use warp to any activated waystone, handy before you can afford a Warp Stone."
		"&eHow:&r paper, an ender pearl, gold nuggets and an ink sac (check JEI)."
		"&eTip:&r keep one in your backpack for emergencies."
	]
	quest.17EB435344732ED5.title: "Maps"
	quest.17EB435344732ED5.quest_subtitle: "JourneyMap and FTB Chunks"
	quest.17EB435344732ED5.quest_desc: [
		"&eWhat:&r JourneyMap draws a minimap and a full world map as you explore, with waypoints."
		"&eHow:&r press &eJ&r for the full JourneyMap. FTB Chunks has its own map for claims (check Controls for its key). Click the checkmark when you've tried them."
		"&eTip:&r drop a waypoint at every rich ore deposit you find. Deposits are rare, so note the depth too."
	]
	quest.697F3B912ADA9643.title: "Inventory Tricks"
	quest.697F3B912ADA9643.quest_subtitle: "Sorting, dragging and a trash slot"
	quest.697F3B912ADA9643.quest_desc: [
		"&eWhat:&r small mods that save hours: Mouse Tweaks (drag and scroll to move stacks), Inventory Tweaks (sorting) and TrashSlot (a trash can in your inventory)."
		"&eHow:&r try a scroll-wheel drag over stacks, the sort button, and the trash slot by your hotbar. Click the checkmark when done."
		"&eTip:&r Polymorph shows a button when two recipes share a grid; click it to pick the one you want."
	]
	quest.1F2CF66554D65C93.title: "Feral Flare Lantern"
	quest.1F2CF66554D65C93.quest_subtitle: "Optional: light a whole cave at once"
	quest.1F2CF66554D65C93.quest_desc: [
		"&eWhat:&r the lantern places invisible light sources in the dark spots around it, so a cave or a big hall lights up without a single torch."
		"&eHow:&r gold ingots, glass and glowstone dust (check JEI). Place it in the middle of the room."
		"&eTip:&r great for a clean-looking factory floor. It still lets mobs spawn in spots it can't reach."
	]
	quest.5B9CAB5D9BAADF57.title: "Grave Tricks"
	quest.5B9CAB5D9BAADF57.quest_subtitle: "Optional: more from Corail Tombstone"
	quest.5B9CAB5D9BAADF57.quest_desc: [
		"&eWhat:&r Corail Tombstone does more than store your items: it adds scrolls, tablets and the Ankh of Prayer, plus a book that makes items soulbound."
		"&eHow:&r search 'tombstone' in JEI to browse them. Click the checkmark when you've had a look."
		"&eTip:&r by default only you can open your grave, so a death on a server doesn't mean losing your gear to someone else."
	]
	quest.7A2E8D54084A7224.title: "Loot for Everyone"
	quest.7A2E8D54084A7224.quest_subtitle: "Optional: every player gets their own chest loot"
	quest.7A2E8D54084A7224.quest_desc: [
		"&eWhat:&r with Lootr, structure chests (dungeons, temples, villages, mineshafts) hold separate loot for each player."
		"&eHow:&r open any generated chest. You get your own roll; your friends still get theirs. Click the checkmark when you've seen one."
		"&eTip:&r on a server, nobody has to race to a dungeon first."
	]
	quest.014F5E0E68AA6574.title: "Stack Upgrade"
	quest.014F5E0E68AA6574.quest_subtitle: "Optional: more items per slot"
	quest.014F5E0E68AA6574.quest_desc: [
		"&eWhat:&r a stack upgrade multiplies how many items each backpack slot holds. Higher tiers multiply more."
		"&eHow:&r check JEI; each tier is built from the one before it."
		"&eTip:&r stack upgrades make a backpack the best place to carry dust and ingots between machines."
	]
	quest.74B98B27BE564EAD.title: "Tool Swapper"
	quest.74B98B27BE564EAD.quest_subtitle: "Optional: the right tool, automatically"
	quest.74B98B27BE564EAD.quest_desc: [
		"&eWhat:&r swaps the tool in your hand for the best one in your backpack when you start mining a block or hitting a mob."
		"&eHow:&r check JEI, then put it in an upgrade slot and fill the backpack with tools."
		"&eTip:&r pairs well with a paxel; it switches to shears or a sword only when needed."
	]
	quest.1572A9CFC13F6605.title: "Refill Upgrade"
	quest.1572A9CFC13F6605.quest_subtitle: "Optional: never run out of torches"
	quest.1572A9CFC13F6605.quest_desc: [
		"&eWhat:&r keeps chosen hotbar items topped up from the backpack: torches, blocks, food."
		"&eHow:&r check JEI. Set the items to refill in the upgrade's tab."
		"&eTip:&r refill building blocks while bridging and you'll never stop to open your inventory."
	]
	quest.32CFD45D94EE955E.title: "Pocket Anvil"
	quest.32CFD45D94EE955E.quest_subtitle: "Optional: repair and disenchant anywhere"
	quest.32CFD45D94EE955E.quest_desc: [
		"&eWhat:&r pocket versions of the anvil and grindstone, opened with right-click."
		"&eHow:&r each one is its block plus a stick (check JEI)."
		"&eTip:&r the pocket anvil wears down like a placed one, so carry a spare for long trips."
	]
	quest.295E46752750C4C1.title: "FTB Ultimine"
	quest.295E46752750C4C1.quest_subtitle: "Break a whole vein in one swing"
	quest.295E46752750C4C1.quest_desc: [
		"&eWhat:&r Ultimine breaks every connected matching block at once: a full ore vein, a tree, a strip of stone."
		"&eHow:&r hold the Ultimine key (default &e`&r, the key left of 1) and break a block. Arrow keys up and down change the shape. Click the checkmark when you've tried it."
		"&eTip:&r it can cost extra hunger, so eat first. Shapes include tunnels and flat planes for clearing space."
	]
	quest.24582FFEF0C9CA48.title: "Form a Team"
	quest.24582FFEF0C9CA48.quest_subtitle: "Share quests, claims and loot"
	quest.24582FFEF0C9CA48.quest_desc: [
		"&eWhat:&r FTB Teams groups players into a party. Teammates share quest progress and claimed chunks."
		"&eHow:&r open the Teams screen from the button on your inventory screen (or use /ftbteams) and create a party, then invite friends. Click the checkmark when done."
		"&eTip:&r playing alone? A solo party still lets you set chunk permissions for visitors."
	]
	quest.0A6808C7A052CA16.title: "Homes and /back"
	quest.0A6808C7A052CA16.quest_subtitle: "FTB Essentials teleport commands"
	quest.0A6808C7A052CA16.quest_desc: [
		"&eWhat:&r FTB Essentials adds /sethome and /home (one home by default), /back to return to where you died or last teleported, /spawn, and /tpa to ask to teleport to a friend."
		"&eHow:&r stand at your base and type /sethome, then try /home from somewhere else. Click the checkmark when done."
		"&eTip:&r each command has a short cooldown. /back after a death walks you straight to your grave."
	]
	quest.3419EC047902045A.title: "Just Zoom"
	quest.3419EC047902045A.quest_subtitle: "Optional: a spyglass without the spyglass"
	quest.3419EC047902045A.quest_desc: [
		"&eWhat:&r Just Zoom lets you zoom in on the distance with a key, no item needed."
		"&eHow:&r find its key under Options → Controls, and hold it to zoom (its options are in the Mods menu). Click the checkmark when you've tried it."
		"&eTip:&r handy for spotting structures, meteorites and villages from a hilltop."
	]
	quest.213AD19CC7D30A37.title: "Ping Wheel"
	quest.213AD19CC7D30A37.quest_subtitle: "Optional: point things out to friends"
	quest.213AD19CC7D30A37.quest_desc: [
		"&eWhat:&r Ping Wheel puts a marker on the spot you look at, visible to the other players nearby."
		"&eHow:&r find its keys under Options → Controls. Look at something and ping it. Click the checkmark when done."
		"&eTip:&r ping an ore deposit or a dangerous mob instead of typing coordinates."
	]
	quest.1E27CF7DD38A14C8.title: "Chat Heads"
	quest.1E27CF7DD38A14C8.quest_subtitle: "Optional: see who's talking"
	quest.1E27CF7DD38A14C8.quest_desc: [
		"&eWhat:&r Chat Heads shows each player's face next to their messages in chat."
		"&eHow:&r nothing to set up; it works as soon as someone talks. Click the checkmark when you've seen it."
		"&eTip:&r its options are in the Mods menu if you want to change how heads are shown."
	]
	quest.69F41022F3C27254.title: "Trade Cycling"
	quest.69F41022F3C27254.quest_subtitle: "Reroll a villager's offers"
	quest.69F41022F3C27254.quest_desc: [
		"&eWhat:&r Trade Cycling adds a button to the villager trade screen that rerolls the offers of a villager nobody has traded with yet."
		"&eHow:&r give a villager a job block, open its trades and press the cycle button until the offer you want appears. Earn 16 emeralds by trading."
		"&eTip:&r once you trade, the offers lock. Cycle a librarian until it sells the enchanted book you need."
	]
	quest.370448FDEA00C30C.title: "Merchant Prince"
	quest.370448FDEA00C30C.quest_subtitle: "Secret: a demigod with a market stall"
	quest.370448FDEA00C30C.quest_desc: [
		"&eWhat:&r four emerald blocks: 36 emeralds. The villagers have noticed you."
		"&eChemistry:&r emerald is beryl, Be₃Al₂Si₆O₁₈, coloured green by traces of chromium."
		"&eTip:&r every Warp Stone needs an emerald, so a good trading hall pays for your travel network."
	]
	quest.2570EB0A8AF93C47.title: "Tool Belt"
	quest.2570EB0A8AF93C47.quest_subtitle: "Optional: tools on a quick wheel"
	quest.2570EB0A8AF93C47.quest_desc: [
		"&eWhat:&r the Tool Belt holds tools outside your hotbar and opens as a radial menu so you can swap fast."
		"&eHow:&r leather and string (check JEI). Keep it in your inventory; find its key under Options → Controls."
		"&eTip:&r put the wrench, the config card and your paxel on the belt."
	]
	quest.7DAD39B76BA322EE.title: "Belt Pouches"
	quest.7DAD39B76BA322EE.quest_subtitle: "Optional: more slots on the belt"
	quest.7DAD39B76BA322EE.quest_desc: [
		"&eWhat:&r each pouch adds a slot to your tool belt."
		"&eHow:&r craft pouches, then craft them together with the belt (check JEI)."
		"&eTip:&r a full belt keeps your hotbar free for blocks and food."
	]
	quest.7966EBF899C9AB72.title: "A Waystone Network"
	quest.7966EBF899C9AB72.quest_subtitle: "Optional: four more waystones"
	quest.7966EBF899C9AB72.quest_desc: [
		"&eWhat:&r one waystone is a landmark; four make a network. Base, mine, Nether portal and a far-off biome."
		"&eHow:&r any four waystones of any style (check JEI for the variants), or bring back ones found in villages."
		"&eTip:&r name each one clearly ('Bauxite Mine -40') so the list stays readable."
	]
	quest.2367545F51E52EA0.title: "Warp Stone"
	quest.2367545F51E52EA0.quest_subtitle: "Optional: warp from anywhere"
	quest.2367545F51E52EA0.quest_desc: [
		"&eWhat:&r a reusable item that opens the waystone menu wherever you stand. It recharges after each use."
		"&eHow:&r amethyst shards, ender pearls and an emerald (check JEI). It's also in the Demigod Token shop."
		"&eTip:&r with a Warp Stone, warp scrolls become backup only."
	]
	quest.4C714AF8B234F7FB.title: "Waypoints"
	quest.4C714AF8B234F7FB.quest_subtitle: "Optional: never lose a deposit again"
	quest.4C714AF8B234F7FB.quest_desc: [
		"&eWhat:&r JourneyMap waypoints mark places on the minimap and in the world, with distance shown on screen."
		"&eHow:&r open the full map (&eJ&r) and right-click a spot to add a waypoint, or use JourneyMap's waypoint key (see Controls). Click the checkmark when you've made one."
		"&eTip:&r JourneyMap makes a death waypoint for you; share waypoints with teammates in chat."
	]
	quest.3DA42EF9B1B6EE05.title: "Utilitarian Shortcuts"
	quest.3DA42EF9B1B6EE05.quest_subtitle: "Logs straight to sticks, chests and ladders"
	quest.3DA42EF9B1B6EE05.quest_desc: [
		"&eWhat:&r the Utilitarian mod adds bulk recipes that skip the planks step (two logs in a column make 16 sticks), plus small handy blocks: tiny coal, the Trowel, the Angel Block, Snad and more. This row is its catalogue."
		"&eHow:&r press U on any log in JEI to see every log shortcut. Click the checkmark when you've had a look."
		"&eTip:&r the bulk recipes give the same items as the vanilla ones, just with fewer clicks and no waste."
	]
	quest.16303011EEFFC500.title: "Chests and Ladders"
	quest.16303011EEFFC500.quest_subtitle: "Optional: eight logs, four chests"
	quest.16303011EEFFC500.quest_desc: [
		"&eWhat:&r logs in a chest ring make 4 chests at once. Seven logs in a ladder shape make 24 ladders."
		"&eHow:&r the same shapes as the plank recipes, but with logs (check JEI)."
		"&eTip:&r three logs in a V make 12 bowls, and logs between iron make a hopper without a chest."
	]
	quest.1B37259868EBFB82.title: "Slabs and Stairs"
	quest.1B37259868EBFB82.quest_subtitle: "Optional: a row of logs, a stack of slabs"
	quest.1B37259868EBFB82.quest_desc: [
		"&eWhat:&r three logs in a row make 24 slabs; six logs in a stair shape make 16 stairs."
		"&eHow:&r use logs of one wood type in the usual slab or stair shape (check JEI)."
		"&eTip:&r two slabs placed diagonally in the grid turn back into a plank, so leftover slabs are never wasted."
	]
	quest.4A660108C8D617E5.title: "Doors and Trapdoors"
	quest.4A660108C8D617E5.quest_subtitle: "Optional: six logs, a dozen doors"
	quest.4A660108C8D617E5.quest_desc: [
		"&eWhat:&r six logs in a door shape make 12 doors; six logs in a trapdoor shape make 12 trapdoors."
		"&eHow:&r one wood type per craft (check JEI). Two logs side by side also make 4 pressure plates."
		"&eTip:&r doors placed side by side open together, so a double door needs only one click."
	]
	quest.49F02D49AA5F5138.title: "Re-Dyeing"
	quest.49F02D49AA5F5138.quest_subtitle: "Optional: wrong colour? Dye it again"
	quest.49F02D49AA5F5138.quest_desc: [
		"&eWhat:&r Utilitarian lets you re-dye concrete, concrete powder, terracotta, stained glass, glass panes and candles that already have a colour."
		"&eChemistry:&r real pigments are chemicals too: concrete's colours come from metal oxides, like iron oxide (Fe₂O₃) for red and brown."
		"&eHow:&r eight coloured blocks around one dye re-colours all eight, or one block plus one dye does a single block (check JEI)."
		"&eTip:&r it also mixes blue and yellow dye into green, so cactus isn't the only green."
	]
	quest.413856DB1BFD433B.title: "Tiny Coal"
	quest.413856DB1BFD433B.quest_subtitle: "One coal split eight ways"
	quest.413856DB1BFD433B.quest_desc: [
		"&eWhat:&r one coal or charcoal makes 8 tiny pieces. Each burns for 10 seconds, so you don't waste a whole coal on one item."
		"&eChemistry:&r charcoal is wood heated without air (pyrolysis): water and volatile compounds are driven off, leaving mostly carbon."
		"&eHow:&r put one coal or charcoal in the crafting grid. Eight tiny pieces craft back into one."
		"&eTip:&r this pack's furnaces cook faster than vanilla, so one tiny coal covers more than one item."
	]
	quest.0305F783E15AF8E3.title: "The Trowel"
	quest.0305F783E15AF8E3.quest_subtitle: "Places random blocks from your hotbar"
	quest.0305F783E15AF8E3.quest_desc: [
		"&eWhat:&r the Trowel places a random block from your hotbar each time you use it. Great for natural-looking walls and paths."
		"&eHow:&r two iron ingots and a stick (check JEI). Sneak-use it to switch between hotbar only and your whole inventory."
		"&eTip:&r fill the hotbar with stone, cobblestone, andesite and tuff, and a plain wall looks weathered in seconds."
	]
	quest.5EA632BBE18FF255.title: "Angel Block"
	quest.5EA632BBE18FF255.quest_subtitle: "A block you can place in mid-air"
	quest.5EA632BBE18FF255.quest_desc: [
		"&eWhat:&r the Angel Block can be placed in empty air, with nothing next to it. It's the start of any sky bridge or floating build."
		"&eHow:&r two feathers, two gold ingots and obsidian (check JEI). Use it while looking at empty air."
		"&eTip:&r it's a building block, not flight. Flying in this pack is a chemistry milestone (see the Nether chapter)."
	]
	quest.0E218EF0FD4FB53C.title: "Snad"
	quest.0E218EF0FD4FB53C.quest_subtitle: "Sand that makes plants grow taller"
	quest.0E218EF0FD4FB53C.quest_desc: [
		"&eWhat:&r cactus, sugar cane, kelp and bamboo grow taller and faster on Snad. Soul Snad does the same for nether wart."
		"&eChemistry:&r sand is mostly quartz grains, SiO₂, the same compound as the Nether quartz and certus you'll meet later."
		"&eHow:&r two sand make one Snad (red sand makes Red Snad, soul sand makes Soul Snad)."
		"&eTip:&r a column of sugar cane on Snad is the fastest paper source for Sophisticated upgrades and Iron Furnace augments."
	]
	quest.0E3B330A8C3FACC9.title: "Block Magnet"
	quest.0E3B330A8C3FACC9.quest_subtitle: "Optional: powered magnet that lifts iron blocks"
	quest.0E3B330A8C3FACC9.quest_desc: [
		"&eWhat:&r with a redstone signal, the Block Magnet pulls iron blocks, steel blocks and anvils below it up towards it."
		"&eChemistry:&r iron is ferromagnetic: its atoms' tiny magnetic moments line up in domains. The recipe is an electromagnet, an iron core with copper on each side."
		"&eHow:&r copper ingot, iron block, copper ingot in a row. Place it, put an iron block somewhere below, and power the magnet."
		"&eTip:&r a magnet and a lever make a simple lift for iron blocks: power it to pull them up, cut the power to let them fall."
	]
	quest.353EE527E64311F7.title: "Fluid Hopper"
	quest.353EE527E64311F7.quest_subtitle: "A hopper for liquids"
	quest.353EE527E64311F7.quest_desc: [
		"&eWhat:&r the Fluid Hopper moves fluids the way a hopper moves items: it collects fluid from above and passes it on, the way a hopper does with items (check its JEI page)."
		"&eHow:&r iron ingots around a bucket, with white dye on top (check JEI)."
		"&eTip:&r under an infinite water source it fills a tank for your first steam boiler without any pump."
	]
	quest.351E30D6FCEA7716.title: "Well Behaved Dropper"
	quest.351E30D6FCEA7716.quest_subtitle: "Optional: a dropper that doesn't spray"
	quest.351E30D6FCEA7716.quest_desc: [
		"&eWhat:&r a dropper that drops items neatly in front of itself instead of flinging them in random directions."
		"&eHow:&r a dropper with a gold nugget on each side (check JEI)."
		"&eTip:&r drop items onto a pressure plate or into water streams and they land exactly where you planned."
	]
	quest.113DE402B609A554.title: "Redstone Clock"
	quest.113DE402B609A554.quest_subtitle: "A pulse generator in one block"
	quest.113DE402B609A554.quest_desc: [
		"&eWhat:&r the Redstone Clock pulses a redstone signal on its own, with no repeater loop."
		"&eHow:&r chiseled stone bricks with redstone on four sides (check JEI). Right-click it with an empty hand to change the speed; sneak to change it faster."
		"&eTip:&r a slow clock on a dispenser or a Well Behaved Dropper makes a simple timed feeder."
	]
	quest.4311BF3C2BF76AB0.title: "TPS Meter"
	quest.4311BF3C2BF76AB0.quest_subtitle: "Optional: how hard is the server working?"
	quest.4311BF3C2BF76AB0.quest_desc: [
		"&eWhat:&r the TPS Meter gives a redstone signal based on the dimension's ticks per second. A healthy server runs at 20."
		"&eHow:&r four comparators around obsidian (check JEI)."
		"&eTip:&r wire it to a lamp in your factory: if it dims, something you built is lagging the server."
	]
	quest.17EAFFEB5D84D60A.title: "Sound Muffler"
	quest.17EAFFEB5D84D60A.quest_subtitle: "Optional: silence a noisy machine room"
	quest.17EAFFEB5D84D60A.quest_desc: [
		"&eWhat:&r the Sound Muffler mutes sounds in a radius around it. Your crushers, pumps and boilers go quiet."
		"&eChemistry:&r real soundproofing works the same way: soft, porous fibres like wool turn sound energy into a tiny amount of heat."
		"&eHow:&r any wool plus a note block, shapeless."
		"&eTip:&r one in the middle of a machine row is usually enough. Its tooltip shows the radius."
	]
	quest.2CFCE0972D469BBF.title: "Trader Carpet"
	quest.2CFCE0972D469BBF.quest_subtitle: "Wandering traders land here, not on you"
	quest.2CFCE0972D469BBF.quest_desc: [
		"&eWhat:&r a wandering trader arriving nearby appears on a Trader Carpet instead of right in your face."
		"&eHow:&r any carpet plus a small flower, shapeless. Each colour has its own carpet."
		"&eTip:&r put it in a little market stall by your base. JEI also shows a trapped version, if you're feeling unkind."
	]
	quest.73682D8FDFE7FA97.title: "No Soliciting"
	quest.73682D8FDFE7FA97.quest_subtitle: "Optional: a banner that keeps traders away"
	quest.73682D8FDFE7FA97.quest_desc: [
		"&eWhat:&r the No Soliciting Banner stops wandering traders from spawning in the chunks around it."
		"&eHow:&r wool, a lead and a stick, in a banner shape (check JEI)."
		"&eTip:&r use either the carpet or the banner: carpet if you like the trader's goods, banner if you don't."
	]
	quest.1343276077F459D5.title: "Outpost Claim"
	quest.1343276077F459D5.quest_subtitle: "Optional: stop pillagers returning to an outpost"
	quest.1343276077F459D5.quest_desc: [
		"&eWhat:&r place the Raider Outpost Claim Block inside a pillager outpost and raiders stop coming back to it."
		"&eHow:&r the recipe uses an ominous (illager) banner, which a pillager captain drops (check JEI)."
		"&eTip:&r claim the outpost before building there; it makes a fine tower base."
	]
	quest.0B8BA71400FB1E48.title: "Un-Name Tag"
	quest.0B8BA71400FB1E48.quest_subtitle: "Optional: undo a name tag"
	quest.0B8BA71400FB1E48.quest_desc: [
		"&eWhat:&r the Un-Name Tag removes a mob's custom name."
		"&eHow:&r a name tag plus white dye, shapeless. Use it on the named mob."
		"&eTip:&r useful when a pet name typo has been bothering you for weeks."
	]
	quest.5B9605EFADDFC54D.title: "Slime in a Bucket"
	quest.5B9605EFADDFC54D.quest_subtitle: "Secret: it gets excited near its friends"
	quest.5B9605EFADDFC54D.quest_desc: [
		"&6You remember finding hidden things by feel. The slime remembers too.&r"
		"&eWhat:&r you scooped a small slime into a bucket. It gets visibly excited when you carry it into a slime chunk."
		"&eHow:&r use an empty bucket on a small slime. Place it again by using the bucket on the ground."
		"&eTip:&r slime chunks spawn slimes underground at any light level, which makes them the best spot for a slime farm."
	]
	quest.3698C36E49E28F11.title: "The Enchanting Table"
	quest.3698C36E49E28F11.quest_subtitle: "Optional: books, obsidian and a diamond or two"
	quest.3698C36E49E28F11.quest_desc: [
		"&eWhat:&r the enchanting table, with the 15 bookshelves it needs for level 30 enchantments. Apotheosis makes it much deeper (Magic group)."
		"&eChemistry:&r paper is pressed cellulose fibre; old books yellow because acids left in the paper slowly break those chains (and lignin oxidises)."
		"&eHow:&r table: a book, 2 diamonds and 4 obsidian. Bookshelf: 6 planks and 3 books. Book: 3 paper and a leather."
		"&eTip:&r leave one block of air between the table and the shelves, or they don't count."
	]
	quest.28ED4E6CDA9DEBA2.title: "Anvil"
	quest.28ED4E6CDA9DEBA2.quest_subtitle: "Optional: repair, rename, combine"
	quest.28ED4E6CDA9DEBA2.quest_desc: [
		"&eWhat:&r the anvil joins enchanted books to tools, repairs gear with its own material, and renames items."
		"&eChemistry:&r a real anvil is a block of hardened steel on a softer body: the hard face doesn't dent, the soft body doesn't crack."
		"&eHow:&r 3 iron blocks and 4 iron ingots: 31 iron in all."
		"&eTip:&r every repair raises the 'too expensive' cost. Combine books first, then put them on the tool in one go."
	]
	quest.0507C4360C804E7C.title: "Map, Compass and Clock"
	quest.0507C4360C804E7C.quest_subtitle: "Optional: the vanilla navigator's kit"
	quest.0507C4360C804E7C.quest_desc: [
		"&eWhat:&r a map draws the land as you walk; a compass points to world spawn (or a lodestone); a clock shows the time of day, even underground."
		"&eChemistry:&r a real compass needle is magnetised iron. The first ones (China, about 1,000 years ago) used lodestone, naturally magnetic magnetite, Fe₃O₄."
		"&eHow:&r map: paper around a compass. Compass: 4 iron around redstone. Clock: 4 gold around redstone."
		"&eTip:&r JourneyMap does the mapping for you; a framed map on the wall is still a nice trophy."
	]
	quest.44D2755744253F5A.title: "Redstone Basics"
	quest.44D2755744253F5A.quest_subtitle: "Optional: switches, inverters and delays"
	quest.44D2755744253F5A.quest_desc: [
		"&eWhat:&r the three parts of most redstone builds: a lever (a switch), a redstone torch (a NOT gate) and a repeater (a delay and a booster)."
		"&eChemistry:&r redstone is fiction, but the logic is real: a torch is an inverter, exactly like a transistor wired as a NOT gate in every chip you own."
		"&eHow:&r lever: a stick on cobblestone. Torch: redstone on a stick. Repeater: 2 torches and redstone on stone."
		"&eTip:&r MI and Mekanism machines can be switched off with redstone; a lever by your machines saves power at night."
	]
	quest.50AAFA04623459C4.title: "Daylight Detector"
	quest.50AAFA04623459C4.quest_subtitle: "Optional: a switch that knows the time"
	quest.50AAFA04623459C4.quest_desc: [
		"&eWhat:&r it outputs a signal that follows the sun. Right-click it to invert, so it fires at night instead."
		"&eChemistry:&r a real light sensor is a photodiode: light knocks electrons loose in a semiconductor and a current flows. Same physics as a solar panel, just smaller."
		"&eHow:&r glass, Nether quartz and wooden slabs (check JEI)."
		"&eTip:&r inverted, it switches on street lamps at dusk."
	]
	quest.6F16D17B0B750F06.title: "Conduit Power"
	quest.6F16D17B0B750F06.quest_subtitle: "Optional: breathe and see underwater"
	quest.6F16D17B0B750F06.quest_desc: [
		"&eWhat:&r an activated conduit gives Conduit Power to players in the water nearby: no drowning, night vision underwater and faster mining. A bigger frame also attacks hostile mobs."
		"&eChemistry:&r nautilus shells are aragonite, a form of calcium carbonate (CaCO₃) with a different crystal packing from calcite. The pearly sheen is layers of it thinner than a wavelength of light."
		"&eHow:&r a heart of the sea (buried treasure) in 8 nautilus shells (drowned and fishing). Place it in water inside a frame of prismarine (check the wiki shape in JEI's info tab)."
		"&eTip:&r perfect for an underwater base, or for clearing an ocean monument."
	]
	quest.288987F76E925D85.title: "Harvester Pylon"
	quest.288987F76E925D85.quest_subtitle: "Optional: a pylon that farms for you"
	quest.288987F76E925D85.quest_desc: [
		"&eWhat:&r harvests crops in a square around it (3x3 up to 9x9) and puts them in a chest above it. It wears a hoe down by 1 durability per harvest."
		"&eHow:&r quartz slabs, iron bars and polished blackstone around a hay bale. Put it in the farm's water block (or level with the crops), a hoe inside, a chest on top."
		"&eTip:&r an Unbreaking hoe lasts far longer; a Mending one never runs out."
	]
	quest.71E9A9731852D77E.title: "Interdiction Pylon"
	quest.71E9A9731852D77E.quest_subtitle: "Optional: no more of that mob, here"
	quest.71E9A9731852D77E.quest_desc: [
		"&eWhat:&r stops chosen mobs spawning in up to 5x5 chunks. A Mob Filter names the mob; the Lifeless Filter blocks all natural spawns over a much larger area."
		"&eHow:&r the pylon frame around a netherite block. Filters: cyan terracotta, green dye and glass around netherite (mob) or a Nether Star (lifeless). Use a mob filter on the mob to set it."
		"&eTip:&r a phantom filter over your base means sleepless nights are only a figure of speech."
	]
	quest.6C163C76258D2DA7.title: "Guard Pylons"
	quest.6C163C76258D2DA7.quest_subtitle: "Optional: protect your claim, and keep strangers out"
	quest.6C163C76258D2DA7.quest_desc: [
		"&eWhat:&r the Protection Pylon stops you breaking chosen blocks or hurting chosen mobs in its range (so a pet or a showpiece is safe from your own sword). The Expulsion Pylon sends other players out of your chunks; whitelist friends with a Player Filter."
		"&eHow:&r the pylon frame around a honeycomb block (protection) or a diamond block (expulsion). Filters: cyan terracotta, green dye and glass around honeycomb (block) or a diamond (player)."
		"&eTip:&r with FTB Teams, your team is whitelisted automatically."
	]
	chapter.283C125EDC24C8C3.title: "Building and Decoration"
	chapter.283C125EDC24C8C3.chapter_subtitle: [
		"A god's house should look like one."
	]
	quest.41199268F6357478.title: "Building Basics"
	quest.41199268F6357478.quest_subtitle: "Tools and blocks for a base worth living in"
	quest.41199268F6357478.quest_desc: [
		"&6You remember raising cities with a gesture. For now, a few clever tools will do.&r"
		"&eWhat:&r this page is a catalogue: building tools, gadgets, framed blocks, furniture, Macaw's blocks, Supplementaries, Create decor and a proper chemistry lab, one row each."
		"&eHow:&r everything here is optional and cheap; pick what you like. Click the checkmark to open the page."
		"&eTip:&r the lab row at the bottom opens once you have Nether quartz."
	]
	quest.7AD94AAAA5254B9E.title: "Effortless Building"
	quest.7AD94AAAA5254B9E.quest_subtitle: "Optional: mirror, array and line building"
	quest.7AD94AAAA5254B9E.quest_desc: [
		"&eWhat:&r Effortless Building adds mirror, array and line modes for big builds."
		"&eHow:&r open its menu (check Controls) and pick a mode. The randomizer places a random mix of the blocks you load into it."
		"&eTip:&r the randomizer with stone, andesite and cobblestone makes natural-looking walls."
	]
	quest.0EBF44825F21BDC2.title: "Construction Stick"
	quest.0EBF44825F21BDC2.quest_subtitle: "Optional: extend a wall in one click"
	quest.0EBF44825F21BDC2.quest_desc: [
		"&eWhat:&r a Construction Stick places a whole row or face of blocks matching the one you click, using blocks from your inventory."
		"&eHow:&r three sticks in a column (check JEI). Right-click the face of a wall to grow it by one layer."
		"&eTip:&r the tooltip lists its modes, such as only extending in a straight line."
	]
	quest.046BE5DF3A379E58.title: "Diamond Stick"
	quest.046BE5DF3A379E58.quest_subtitle: "Optional: bigger reach, more durability"
	quest.046BE5DF3A379E58.quest_desc: [
		"&eWhat:&r better sticks place more blocks per click and last longer: copper, iron, diamond, then netherite."
		"&eChemistry:&r diamond is pure carbon (C) in a tight 3D lattice, which makes it the hardest natural material."
		"&eHow:&r a diamond on two sticks (check JEI). Templates applied at a smithing table add tricks like placing in mid-air."
	]
	quest.256D3D0FC72501EE.title: "Rechiseled"
	quest.256D3D0FC72501EE.quest_subtitle: "Optional: hundreds of block patterns"
	quest.256D3D0FC72501EE.quest_desc: [
		"&eWhat:&r Rechiseled adds a chisel that turns stone, planks, metal blocks and more into decorative patterns: bricks, tiles, pillars, gears."
		"&eHow:&r craft the chisel from an iron ingot on a stick, right-click to open it, put blocks in and pick a pattern. Click the checkmark when you've chiseled something."
		"&eTip:&r many patterns connect to each other when placed side by side. Try the iron and copper block patterns for a machine room."
	]
	quest.171C251ED5512ABD.title: "Building Gadgets"
	quest.171C251ED5512ABD.quest_subtitle: "Place whole surfaces with FE"
	quest.171C251ED5512ABD.quest_desc: [
		"&eWhat:&r FE-powered gadgets that place, swap, copy and remove blocks in bulk."
		"&eHow:&r iron, redstone, lapis and a diamond (check JEI). Charge it in an energy cube."
		"&eTip:&r link the gadget to a chest or backpack so it pulls blocks from storage."
	]
	quest.34C2506F0D77DBC7.title: "Copy and Paste"
	quest.34C2506F0D77DBC7.quest_subtitle: "Optional: copy a whole build"
	quest.34C2506F0D77DBC7.quest_desc: [
		"&eWhat:&r copy an area and paste it elsewhere; the Template Manager saves copies to share."
		"&eHow:&r check JEI. Great for repeating a chemical reactor cell or a row of machines."
		"&eTip:&r templates can be shared with friends on the server."
	]
	quest.78B3985AFEC9753C.title: "Exchanging Gadget"
	quest.78B3985AFEC9753C.quest_subtitle: "Optional: swap blocks in place"
	quest.78B3985AFEC9753C.quest_desc: [
		"&eWhat:&r replaces blocks in an area with another block, keeping the shape."
		"&eHow:&r check JEI. Perfect for turning a cobble shell into something pretty."
		"&eTip:&r it uses the blocks in your inventory, so carry enough."
	]
	quest.6264FFAD4D805503.title: "Destruction Gadget"
	quest.6264FFAD4D805503.quest_subtitle: "Optional: clear a room in seconds"
	quest.6264FFAD4D805503.quest_desc: [
		"&eWhat:&r removes a box of blocks in front of you, sized however you like. It can undo its last action."
		"&eHow:&r check JEI. Set the depth, width and height in its menu."
		"&eTip:&r perfect for hollowing out a hillside for a new factory floor."
	]
	quest.17B2684DCFCAF116.title: "Framed Blocks"
	quest.17B2684DCFCAF116.quest_subtitle: "Any shape, any texture"
	quest.17B2684DCFCAF116.quest_desc: [
		"&eWhat:&r FramedBlocks are wooden frames that take the look of any block you right-click into them, in dozens of shapes."
		"&eHow:&r framed cubes are planks and sticks (check JEI). Right-click a framed block with any full block to apply it as camouflage. The Framed Hammer takes it back off."
		"&eTip:&r camouflage with glass, ores or even machine casings: the block keeps its shape and takes the texture."
	]
	quest.43AAE4F773290CA0.title: "Slopes and Panels"
	quest.43AAE4F773290CA0.quest_subtitle: "Optional: six framed shapes"
	quest.43AAE4F773290CA0.quest_desc: [
		"&eWhat:&r any six framed slopes, corner slopes, stairs, slabs, panels, pillars or prisms."
		"&eHow:&r each shape is made from framed cubes (check JEI). Most come several at a time."
		"&eTip:&r framed slopes camouflaged as stone make roofs and ramps that look hand-carved."
	]
	quest.493C7E73D1EA248B.title: "Secret Storage"
	quest.493C7E73D1EA248B.quest_subtitle: "Optional: a chest that looks like a wall"
	quest.493C7E73D1EA248B.quest_desc: [
		"&eWhat:&r a full-block chest that wears any block's texture, so it disappears into a wall."
		"&eHow:&r a framed chest surrounded by framed cubes (check JEI), then camouflage it."
		"&eTip:&r hide your rarest elements in one. Nobody suspects the third stone brick from the left."
	]
	quest.0882494FACF73614.title: "Somewhere to Sit"
	quest.0882494FACF73614.quest_subtitle: "Optional: Handcrafted chairs and a table"
	quest.0882494FACF73614.quest_desc: [
		"&eWhat:&r Handcrafted adds furniture you can actually sit on: chairs, couches, benches, tables, desks."
		"&eHow:&r any wood works (check JEI). Right-click a chair to sit."
		"&eTip:&r the Handcrafted Hammer changes the shape of trims and some other pieces (check its tooltip)."
	]
	quest.255AF1E86B0F49B5.title: "A Proper Study"
	quest.255AF1E86B0F49B5.quest_subtitle: "Optional: couches and a desk"
	quest.255AF1E86B0F49B5.quest_desc: [
		"&eWhat:&r couches connect into long sofas; desks connect into long workbenches."
		"&eHow:&r any wood (check JEI). Cushions and sheets add colour."
		"&eTip:&r a desk by your Alchemistry machines makes a fine place to read the quest book."
	]
	quest.4E82A4FFCC6F1EEF.title: "Macaw's Furniture"
	quest.4E82A4FFCC6F1EEF.quest_subtitle: "Optional: wardrobes, drawers and cabinets"
	quest.4E82A4FFCC6F1EEF.quest_desc: [
		"&eWhat:&r Macaw's Furniture adds kitchens, wardrobes, drawers, bookshelves and more. Many of them store items."
		"&eHow:&r any two wardrobes, drawers or kitchen cabinets (check JEI for the full set)."
		"&eTip:&r drawers and cabinets open like chests, so a kitchen can double as food storage."
	]
	quest.5E740E65B6A4BD53.title: "Doors"
	quest.5E740E65B6A4BD53.quest_subtitle: "Optional: Macaw's doors"
	quest.5E740E65B6A4BD53.quest_desc: [
		"&eWhat:&r Macaw's Doors adds barn, cottage, glass, modern and many more doors in every wood."
		"&eHow:&r any two barn, modern, glass or cottage doors (check JEI for recipes)."
		"&eTip:&r glass doors let you see into a machine room without opening it."
	]
	quest.06248880B960989A.title: "Trapdoors"
	quest.06248880B960989A.quest_subtitle: "Optional: Macaw's trapdoors"
	quest.06248880B960989A.quest_desc: [
		"&eWhat:&r decorative trapdoors that match the doors: barn, glass, classic and more."
		"&eHow:&r any four barn, glass or classic trapdoors (check JEI)."
		"&eTip:&r trapdoors on walls make great shutters and cabinet fronts."
	]
	quest.30251E31D4E975EF.title: "Windows"
	quest.30251E31D4E975EF.quest_subtitle: "Optional: framed windows"
	quest.30251E31D4E975EF.quest_desc: [
		"&eWhat:&r Macaw's Windows adds framed windows, shutters, curtains, blinds and parapets."
		"&eHow:&r any four framed windows (check JEI)."
		"&eChemistry:&r glass is mostly silica (SiO₂) melted with soda (Na₂CO₃) and lime (CaO), then cooled before it can crystallise."
	]
	quest.0730AC23E95DCD5A.title: "Roofs"
	quest.0730AC23E95DCD5A.quest_subtitle: "Optional: a roof that isn't flat"
	quest.0730AC23E95DCD5A.quest_desc: [
		"&eWhat:&r Macaw's Roofs adds sloped, steep, attic and top roof pieces that join into proper roofs."
		"&eHow:&r any sixteen roof pieces (check JEI). Wooden roofs come from logs and sticks."
		"&eTip:&r place the lower and upper pieces together to make a gentler slope."
	]
	quest.1C66E75AABEB8A04.title: "Fences and Hedges"
	quest.1C66E75AABEB8A04.quest_subtitle: "Optional: picket, stockade, wired, hedge"
	quest.1C66E75AABEB8A04.quest_desc: [
		"&eWhat:&r Macaw's Fences adds picket and stockade fences, wired fences, hedges and gates."
		"&eHow:&r any eight picket, stockade or wired fences or hedges (check JEI)."
		"&eTip:&r hedges are made from leaves, so you can keep a garden looking natural."
	]
	quest.7E1544D1ED3E2D20.title: "Paths"
	quest.7E1544D1ED3E2D20.quest_subtitle: "Optional: paving between your buildings"
	quest.7E1544D1ED3E2D20.quest_desc: [
		"&eWhat:&r Macaw's Paths adds paving patterns (basket weave, honeycomb, flagstone) in stone, brick and sandstone."
		"&eHow:&r any sixteen paving blocks (check JEI)."
		"&eTip:&r a path from your base to your waystone saves getting lost at night."
	]
	quest.2B01CBA33D88B363.title: "Bridges"
	quest.2B01CBA33D88B363.quest_subtitle: "Optional: rope, stone and iron bridges"
	quest.2B01CBA33D88B363.quest_desc: [
		"&eWhat:&r Macaw's Bridges adds bridge pieces that connect into rope, stone, brick and iron bridges, with piers and stairs."
		"&eHow:&r any eight bridge pieces (check JEI)."
		"&eTip:&r an iron bridge over a lava lake makes the Nether commute much safer."
	]
	quest.7D8A60F5C4CE08DA.title: "Lamps and Lanterns"
	quest.7D8A60F5C4CE08DA.quest_subtitle: "Optional: street lamps and chandeliers"
	quest.7D8A60F5C4CE08DA.quest_desc: [
		"&eWhat:&r Macaw's Lights adds street lamps, lanterns, garden lights and chandeliers."
		"&eHow:&r any four of them (check JEI)."
		"&eTip:&r street lamps along your paths keep mobs from spawning on the way home."
	]
	quest.2483BE5777A45DF0.title: "Lava Lamp"
	quest.2483BE5777A45DF0.quest_subtitle: "Optional: groovy chemistry"
	quest.2483BE5777A45DF0.quest_desc: [
		"&eWhat:&r a lava lamp for your desk. This one really has lava in it."
		"&eChemistry:&r a real lava lamp holds wax in water. The bulb heats the wax, it expands, its density drops below the water's and it rises; at the top it cools, gets denser and sinks."
		"&eHow:&r iron nuggets, a lava bucket and an iron ingot (check JEI)."
	]
	quest.263D8CF775631953.title: "Jars"
	quest.263D8CF775631953.quest_subtitle: "Optional: display jars for anything"
	quest.263D8CF775631953.quest_desc: [
		"&eWhat:&r Supplementaries jars hold items, liquids or even small mobs, and show what's inside."
		"&eHow:&r glass and a wooden slab (check JEI). Right-click with an item or a bucket to fill."
		"&eTip:&r a shelf of jars, one per element, makes a lovely periodic table display."
	]
	quest.03F0CB824882681C.title: "Rope and Sacks"
	quest.03F0CB824882681C.quest_subtitle: "Optional: flax, rope and a sack"
	quest.03F0CB824882681C.quest_desc: [
		"&eWhat:&r rope you can climb and pull things up with, and sacks that store items and can be carried."
		"&eHow:&r grow flax (seeds from wild flax), then craft rope and sacks from it (check JEI)."
		"&eTip:&r ropes hanging down a mineshaft are a quick way up and down (check JEI for the pulley block)."
	]
	quest.3916B5092992AE39.title: "Soap"
	quest.3916B5092992AE39.quest_subtitle: "Optional: the oldest chemistry in the house"
	quest.3916B5092992AE39.quest_desc: [
		"&eWhat:&r soap washes the dye off coloured blocks and items, and it powers the Bubble Blower."
		"&eChemistry:&r saponification. Wood ash is rich in potash (K₂CO₃); in water it makes lye. Lye splits fat into glycerol and fatty-acid salts, which is soap. People made it this way for thousands of years."
		"&eHow:&r a water bucket, four ash and a porkchop (check JEI). Ash is left behind when fire burns blocks away; check JEI for other sources."
	]
	quest.27402D05976252E6.title: "Bubbles!"
	quest.27402D05976252E6.quest_subtitle: "Secret: a demigod at play"
	quest.27402D05976252E6.quest_desc: [
		"&6You remember making nebulae. These are smaller, but they're very pretty.&r"
		"&eWhat:&r the Bubble Blower uses soap to blow bubbles; it can also make Bubble Blocks (check its tooltip)."
		"&eChemistry:&r a soap film is a thin water layer between two layers of soap molecules. The colours come from light reflecting off its front and back surfaces and interfering."
	]
	quest.0390136B315C41D8.title: "Create Deco Lamps"
	quest.0390136B315C41D8.quest_subtitle: "Optional: industrial lights"
	quest.0390136B315C41D8.quest_desc: [
		"&eWhat:&r Create Deco lamps in four colours and five metals light up a factory floor properly."
		"&eHow:&r a nugget, a torch and a plate of the metal (check JEI). Any four lamps."
		"&eTip:&r lamps can be switched off with redstone: red lamps as warning lights next to a reactor are a nice touch."
	]
	quest.5569DB7CD62C242F.title: "Hulls and Supports"
	quest.5569DB7CD62C242F.quest_subtitle: "Optional: riveted walls and girders"
	quest.5569DB7CD62C242F.quest_desc: [
		"&eWhat:&r hulls are riveted metal walls; supports are girders for roofs and catwalks."
		"&eHow:&r any four hulls and four supports (check JEI)."
		"&eTip:&r copper hulls weather like copper blocks do. Wax them with honeycomb to keep the shine."
	]
	quest.05D2EE647B7C6620.title: "Copycats"
	quest.05D2EE647B7C6620.quest_subtitle: "Optional: Create-style shape-shifting blocks"
	quest.05D2EE647B7C6620.quest_desc: [
		"&eWhat:&r Copycats+ adds many more Create copycat shapes: slopes, boards, beams, slices. Each takes the look of the block you apply to it."
		"&eHow:&r cut zinc ingots in a stonecutter (zinc ore is found underground; check JEI), then right-click a placed copycat with a block."
		"&eTip:&r copycat boards cover pipes and shafts while leaving them working."
	]
	quest.1C1D96F956C3898C.title: "Laboratory Blocks"
	quest.1C1D96F956C3898C.quest_subtitle: "Clean white walls for a chemist"
	quest.1C1D96F956C3898C.quest_desc: [
		"&6You remember a laboratory of white stone and light. You can build it again.&r"
		"&eWhat:&r Artemis' Laboratory Blocks adds clean lab walls, tiles, glass, screens, vents and fans."
		"&eChemistry:&r the recipe uses Nether quartz, which is silicon dioxide (SiO₂), the same compound as sand and glass."
		"&eHow:&r eight stone around one Nether quartz makes eight laboratory blocks (check JEI). Stonecut them into tiles, pillars and doors."
	]
	quest.231AB73D5B98BE94.title: "Glowing Panels"
	quest.231AB73D5B98BE94.quest_subtitle: "Optional: walls that light the room"
	quest.231AB73D5B98BE94.quest_desc: [
		"&eWhat:&r glowing laboratory blocks give off light, so a lab can be bright with no torches."
		"&eHow:&r one glowstone dust makes eight glowstone particles; one particle plus a laboratory block makes a glowing block (check JEI)."
		"&eChemistry:&r real glow-in-the-dark materials store energy from light and release it slowly (phosphorescence). Glowstone just glows; it's magic."
	]
	quest.302DFA9D7E8161B1.title: "Lab Screens"
	quest.302DFA9D7E8161B1.quest_subtitle: "Optional: monitors on every wall"
	quest.302DFA9D7E8161B1.quest_desc: [
		"&eWhat:&r decorative screens: clear, text, wave and quantum patterns, plain or glowing."
		"&eHow:&r clear screens from laboratory blocks, laboratory glass and iron screws; add a dye for the patterns (check JEI)."
		"&eTip:&r put a wave screen next to your reactor and a ComputerCraft monitor beside it for real numbers."
	]
	quest.7827D1263B738EE4.title: "Fans and Vents"
	quest.7827D1263B738EE4.quest_subtitle: "Optional: fume extraction"
	quest.7827D1263B738EE4.quest_desc: [
		"&eWhat:&r animated lab fans and vents. The redstone-controlled fan only spins when powered."
		"&eChemistry:&r real labs work with HCl, NH₃ and Cl₂ under a fume hood, which pulls vapours away from your face. Breathing chlorine is a very bad idea."
		"&eHow:&r laboratory blocks with iron nuggets and iron screws (check JEI)."
	]
	quest.63B9D8367D6914A8.title: "Lab Doors and Glass"
	quest.63B9D8367D6914A8.quest_subtitle: "Optional: see in, keep fumes out"
	quest.63B9D8367D6914A8.quest_desc: [
		"&eWhat:&r lab doors (solid, glass or mesh) and laboratory glass for viewing windows."
		"&eHow:&r doors from laboratory blocks; laboratory glass is eight glass around a laboratory block (check JEI)."
		"&eTip:&r a glass wall around your Alchemistry room lets visitors admire it without touching anything."
	]
	quest.4D60C7C6C5F73477.title: "A Proper Laboratory"
	quest.4D60C7C6C5F73477.quest_subtitle: "Optional: build a lab worthy of you"
	quest.4D60C7C6C5F73477.quest_desc: [
		"&6White walls, humming fans, glass and light. You remember this place. It was always where you were happiest.&r"
		"&eWhat:&r a challenge: build a real laboratory around your chemistry machines using these blocks."
		"&eHow:&r include glowing panels, screens, a fume fan and a glass wall. Click the checkmark when you're proud of it."
		"&eTip:&r share a screenshot with your server. Bragging rights are a demigod's privilege."
	]
	quest.3D96DF2EBED7106F.title: "Know Your Rocks"
	quest.3D96DF2EBED7106F.quest_subtitle: "Optional: 64 of any natural stone"
	quest.3D96DF2EBED7106F.quest_desc: [
		"&eWhat:&r stone, deepslate, andesite, diorite, granite, tuff or calcite, mixed as you like. Each has a polished and brick form for building."
		"&eChemistry:&r granite cooled slowly deep underground, so its quartz and feldspar crystals grew big; andesite and diorite are its iron- and calcium-richer cousins. Tuff is welded volcanic ash, and calcite is CaCO₃."
		"&eHow:&r mine them with Silk Touch for smooth stone, or smelt cobblestone back into stone."
		"&eTip:&r the Trowel (Quality of Life page) mixes them into a natural-looking wall."
	]
	quest.28C35CCC84851B27.title: "Rocks of Other Biomes"
	quest.28C35CCC84851B27.quest_subtitle: "Optional: chalk, argillite and mossy stone"
	quest.28C35CCC84851B27.quest_desc: [
		"&eWhat:&r three building stones from Regions Unexplored biomes: white chalk, dark red argillite and mossy stone."
		"&eChemistry:&r chalk is CaCO₃ made of the tiny plates (coccoliths) of ancient sea algae: the white cliffs of Dover are trillions of them. Argillite is clay squeezed into hard rock."
		"&eHow:&r find the biomes with Nature's Compass (Quality of Life page) and mine the stone."
		"&eTip:&r chalk is soft and white; it lights a room almost like the lab blocks."
	]
	quest.65382426023CF47F.title: "Dripstone"
	quest.65382426023CF47F.quest_subtitle: "Optional: stone that grows"
	quest.65382426023CF47F.quest_desc: [
		"&eWhat:&r pointed dripstone grows down from the ceiling and up from the floor in dripstone caves. Hanging under a water source, it slowly fills cauldrons below."
		"&eChemistry:&r water carrying calcium bicarbonate drips, loses CO₂ and leaves calcite behind: Ca(HCO₃)₂ → CaCO₃ + H₂O + CO₂. A real stalactite grows about a centimetre a century."
		"&eHow:&r mine both in a dripstone cave (Nature's Compass finds one)."
		"&eTip:&r falling pointed dripstone hurts like an arrow. Mind your head."
	]
	quest.18FFF9220FA14F85.title: "Masonry"
	quest.18FFF9220FA14F85.quest_subtitle: "Optional: clay, bricks and walls"
	quest.18FFF9220FA14F85.quest_desc: [
		"&eWhat:&r clay fires into bricks; stone bricks chisel into patterns; walls make fences that mobs can't jump."
		"&eChemistry:&r clay is mostly kaolinite, Al₂Si₂O₅(OH)₄. Fired above about 900 °C it loses its water and the particles sinter together into hard, waterproof ceramic."
		"&eHow:&r dig clay from riverbeds and lush caves and smelt it into bricks. Chiseled stone bricks come from the stonecutter; walls from cobblestone."
		"&eTip:&r a stonecutter makes walls, stairs and slabs with no waste."
	]
	quest.58D18066FC360C5F.title: "Terracotta and Concrete"
	quest.58D18066FC360C5F.quest_subtitle: "Optional: colour by the stack"
	quest.58D18066FC360C5F.quest_desc: [
		"&eWhat:&r terracotta is fired clay; concrete powder is sand, gravel and dye that sets into concrete when it touches water."
		"&eChemistry:&r real concrete doesn't dry, it reacts: calcium silicates in cement take up water (hydration) and grow interlocking crystals. It even sets underwater."
		"&eHow:&r smelt clay blocks into terracotta; 4 sand, 4 gravel and a dye make 8 concrete powder of any colour."
		"&eTip:&r place powder in front of a water flow, or run it through Create's bulk washing, to harden a whole stack."
	]
	quest.452737A7575DCEAE.title: "Lighting Without Torches"
	quest.452737A7575DCEAE.quest_subtitle: "Optional: glowstone, lamps and lanterns"
	quest.452737A7575DCEAE.quest_desc: [
		"&eWhat:&r glowstone gives the brightest block light; redstone lamps switch on and off; soul lanterns burn blue and dim."
		"&eChemistry:&r a flame is incandescence (hot soot glowing). Cold light, from LEDs to glow-sticks, is luminescence: electrons drop between energy levels and give off exactly one colour."
		"&eHow:&r glowstone from the Nether ceiling (4 dust per block); lamp: glowstone in redstone; soul lantern: a soul torch in iron nuggets."
		"&eTip:&r a lamp on a daylight detector lights itself at dusk."
	]
	quest.648DEB4A88E62AB0.title: "Froglights"
	quest.648DEB4A88E62AB0.quest_subtitle: "Optional: three frogs, three colours"
	quest.648DEB4A88E62AB0.quest_desc: [
		"&eWhat:&r a frog that eats a small magma cube leaves a froglight. Its colour depends on the frog: temperate, warm or cold."
		"&eChemistry:&r real frogs' skin colour comes from pigment cells stacked in layers: yellow pigment over a layer that scatters blue light makes green, the same trick as a blue sky."
		"&eHow:&r scoop tadpoles from a swamp in a bucket, raise them in a temperate, a warm and a cold biome, and bring the three frogs to the Nether's magma cubes."
		"&eTip:&r a lead is the easiest way to walk frogs through a portal."
	]
	quest.163F940519BFFA36.title: "Mineral Blocks"
	quest.163F940519BFFA36.quest_subtitle: "Optional: copper, lapis and quartz to build with"
	quest.163F940519BFFA36.quest_desc: [
		"&eWhat:&r copper blocks weather from orange to green; lapis and quartz blocks are the classic blue and white trims."
		"&eChemistry:&r copper turns green as it reacts with air, water and CO₂ into basic copper carbonate (the Statue of Liberty's patina). Honeycomb wax stops it, an axe scrapes it back."
		"&eHow:&r 9 copper ingots or 9 lapis per block; 4 Nether quartz per quartz block. Cut copper and quartz pillars come from the stonecutter."
		"&eTip:&r copper blocks in Create Deco and Rechiseled take the same patina."
	]
	quest.6F93CF01FD65C4E4.title: "Amethyst"
	quest.6F93CF01FD65C4E4.quest_subtitle: "Optional: purple quartz from a geode"
	quest.6F93CF01FD65C4E4.quest_desc: [
		"&eWhat:&r amethyst clusters grow on budding amethyst inside underground geodes. Shards make spyglasses, tinted glass and amethyst blocks that chime."
		"&eChemistry:&r amethyst is quartz, SiO₂, coloured violet by traces of iron that natural radiation has nudged into Fe⁴⁺ colour centres. Heat it and it turns yellow (citrine)."
		"&eHow:&r break fully grown clusters in a geode (calcite and smooth basalt shells), and craft 4 shards into a block."
		"&eTip:&r never break the budding amethyst: it can't be moved and it's the only thing that grows more."
	]
	quest.7884D09F7FBE7978.title: "Building with Ice"
	quest.7884D09F7FBE7978.quest_subtitle: "Optional: snow, packed ice and blue ice"
	quest.7884D09F7FBE7978.quest_desc: [
		"&eWhat:&r snow blocks, packed ice (doesn't melt) and blue ice, the slipperiest block in the game: boats on blue ice outrun horses."
		"&eChemistry:&r ice floats because hydrogen bonds lock water into an open hexagonal lattice, about 9% less dense than liquid water. That's why lakes freeze from the top."
		"&eHow:&r 4 snowballs make a snow block; 9 ice make packed ice, 9 packed ice make blue ice. Ice needs Silk Touch; icebergs have packed and blue ice."
		"&eTip:&r a blue-ice boat road in the Nether makes long trips fast."
	]
	quest.2E96863B3A582666.title: "Nether Masonry"
	quest.2E96863B3A582666.quest_subtitle: "Optional: blackstone, gold-flecked stone and chains"
	quest.2E96863B3A582666.quest_desc: [
		"&eWhat:&r polished blackstone and its bricks make dark, gothic builds; gilded blackstone sparkles with gold; chains hang lanterns."
		"&eChemistry:&r gold in veins inside dark rock is how real gold is often found: hot water carries dissolved gold through cracks and drops it as it cools."
		"&eHow:&r polish blackstone in a stonecutter. Gilded blackstone is found in bastions. Chain: an iron ingot between two iron nuggets."
		"&eTip:&r gilded blackstone sometimes drops gold nuggets when mined without Silk Touch."
	]
	quest.4A79D247060404DF.title: "End Stone"
	quest.4A79D247060404DF.quest_subtitle: "Optional: pale stone from the void"
	quest.4A79D247060404DF.quest_desc: [
		"&eWhat:&r end stone and its bricks: pale yellow and very blast-resistant. Chorus plants grow only on it."
		"&eHow:&r mine end stone on any End island; 4 end stone make 4 end stone bricks."
		"&eTip:&r end stone resists explosions far better than cobblestone, so wall in anything that might blow."
	]
	quest.2F7FCB7F23390898.title: "Finishing Touches"
	quest.2F7FCB7F23390898.quest_subtitle: "Optional: paintings, a pumpkin, a cauldron, clean beams"
	quest.2F7FCB7F23390898.quest_desc: [
		"&eWhat:&r the small things that make a base feel lived in: paintings, a carved pumpkin, a cauldron and stripped-log beams."
		"&eChemistry:&r stripping a log takes off the bark, which is full of tannins: the same polyphenols that tan leather."
		"&eHow:&r painting: sticks around wool. Carve a pumpkin with shears. Cauldron: 7 iron. Use an axe on any log to strip it."
		"&eTip:&r a cauldron under pointed dripstone fills with water by itself."
	]
	quest.1EDB5983AC99AF7D.title: "Showing Off"
	quest.1EDB5983AC99AF7D.quest_subtitle: "Secret: nine diamonds you'll never use"
	quest.1EDB5983AC99AF7D.quest_desc: [
		"&6You remember a throne cut from a single gem. A block of diamond on the mantelpiece is a start.&r"
		"&eWhat:&r a block of diamond, placed only to be looked at."
		"&eChemistry:&r a diamond block's worth of real diamond would be about 3.5 tonnes of pure carbon. Burn it and you'd get about 13 tonnes of CO₂."
	]
	quest.4AB4BF290ECDDCFD.title: "Tool Extras"
	quest.4AB4BF290ECDDCFD.quest_subtitle: "Optional: a saw, a hammer and an angel template"
	quest.4AB4BF290ECDDCFD.quest_desc: [
		"&eWhat:&r the Framing Saw crafts any framed shape from plain framed cubes; the Window Hammer reshapes a placed Macaw's window; the Angel template lets a Construction Stick place blocks in mid-air."
		"&eHow:&r check JEI for each. Apply the template to a stick at a smithing table."
		"&eTip:&r the angel template is a building aid, not flight. Flight in this pack is a chemistry milestone."
	]
	quest.25C658490DBB5144.title: "Bamboo Spikes"
	quest.25C658490DBB5144.quest_subtitle: "Optional: a garden of sharp sticks"
	quest.25C658490DBB5144.quest_desc: [
		"&eWhat:&r Supplementaries bamboo spikes hurt mobs that walk on them; coated with a lingering potion they poison them too."
		"&eHow:&r 4 bamboo over 3 wooden slabs (check JEI). Use a lingering potion on placed spikes to coat them."
		"&eTip:&r a ring of spikes around a farm keeps zombies off the crops."
	]
	chapter.4077DB038B5ACC44.title: "The Periodic Table"
	chapter.4077DB038B5ACC44.chapter_subtitle: [
		"Rebuild the table, group by group. Each column shares a chemistry, because each shares an outer-electron arrangement."
	]
	quest.66353CA51BFD14BF.title: "Reading the Table"
	quest.66353CA51BFD14BF.quest_subtitle: "Rows, columns, and why they matter"
	quest.66353CA51BFD14BF.quest_desc: [
		"&6You remember this chart. You used to know every box by heart.&r"
		"&eWhat:&r the periodic table orders the elements by proton number. Rows are periods; columns are groups."
		"&eChemistry:&r elements in the same group have the same number of outer (valence) electrons, so they react alike."
		"&eHow:&r press &eU&r on any element in JEI to see which blocks the Dissolver turns into it."
		"&eTip:&r this chapter is a side path. Nothing in the main story waits on it, but it pays well."
	]
	quest.65BFE56092A18CC6.title: "Alkali Metals"
	quest.65BFE56092A18CC6.quest_subtitle: "Group 1: one electron to give away"
	quest.65BFE56092A18CC6.quest_desc: [
		"&eWhat:&r lithium, sodium and potassium, the softest and most reactive metals."
		"&eChemistry:&r one valence electron, easily lost. Sodium fizzes on water (2Na + 2H₂O → 2NaOH + H₂); potassium burns lilac."
		"&eHow:&r end stone gives lithium; lapis lazuli gives sodium (the mineral lazurite is a sodium aluminosilicate). Plants give potassium."
		"&eTip:&r check JEI with &eU&r on each element. Many common blocks hide small amounts."
	]
	quest.7C336C41BCCDBBD5.title: "Alkaline Earth Metals"
	quest.7C336C41BCCDBBD5.quest_subtitle: "Group 2: two electrons, still eager"
	quest.7C336C41BCCDBBD5.quest_desc: [
		"&eWhat:&r beryllium, magnesium and calcium: lighter structural metals and the stuff of bones and limestone."
		"&eChemistry:&r two valence electrons, so they form 2+ ions. Calcium carbonate (CaCO₃) is limestone; magnesium burns blinding white."
		"&eHow:&r andesite and bone give calcium (bone via hydroxylapatite, the mineral in teeth). Beryllium and magnesium come out of their compounds: check JEI."
	]
	quest.25099A06619CE537.title: "Transition Metals"
	quest.25099A06619CE537.quest_subtitle: "The wide middle block"
	quest.25099A06619CE537.quest_desc: [
		"&eWhat:&r the hard, conductive metals behind every machine you've built."
		"&eChemistry:&r their d-orbitals fill across the row. That's why they form coloured compounds and make good catalysts."
		"&eHow:&r dissolve ingots, nuggets or dusts of each metal."
		"&eTip:&r ore you already process gives nuggets and dust. Dissolve the spares, not your ingots."
	]
	quest.0710D708F34467AF.title: "Post-Transition Metals"
	quest.0710D708F34467AF.quest_subtitle: "Soft metals on the metal side of the line"
	quest.0710D708F34467AF.quest_desc: [
		"&eWhat:&r aluminum, tin, lead and indium: softer, lower-melting metals just right of the transition block."
		"&eChemistry:&r indium tin oxide is the clear conductor in every touchscreen. Lead is dense enough to stop X-rays."
		"&eHow:&r diorite dissolves into tin and indium. Aluminum and lead come from their ingots, dusts and minerals (check JEI)."
		"&ePerk:&r hold one of each of these four elements and your body remembers them: &e+2 armor toughness&r, permanently. Soft metals bend instead of breaking."
		"&eTip:&r type &e/warbucks elements&r to see which Periodic Table perks you've unlocked and what's still missing."
	]
	quest.109F6CDEEFC90F6D.title: "Liquid Metals"
	quest.109F6CDEEFC90F6D.quest_subtitle: "Metals that melt in your hand"
	quest.109F6CDEEFC90F6D.quest_desc: [
		"&eWhat:&r mercury and gallium, the two metals you can pour (almost) at room temperature."
		"&eChemistry:&r mercury melts at −38.8 °C; gallium at 29.8 °C, below body temperature."
		"&eHow:&r ender pearls and end stone dissolve into mercury. Cobblestone gives a little gallium."
	]
	quest.38880DD5F24455C0.title: "Challenge: The First Twenty"
	quest.38880DD5F24455C0.quest_subtitle: "Hydrogen to calcium, one of each"
	quest.38880DD5F24455C0.quest_desc: [
		"&eWhat:&r one of each of elements 1 to 20, the four shortest rows of the table."
		"&eChemistry:&r these twenty make up almost all of your body, the oceans and the air."
		"&eHow:&r most come from the groups in this chapter. Boron and the noble gases need the Fusion Chamber (boron is 5: try H + Be)."
		"&eTip:&r an optional collection. Keep one of each in a chest as you go."
	]
	quest.5A6D643C9FD789DE.title: "The Coinage Metals"
	quest.5A6D643C9FD789DE.quest_subtitle: "Group 11: copper, silver, gold"
	quest.5A6D643C9FD789DE.quest_desc: [
		"&eWhat:&r the three metals humans have minted into money for thousands of years."
		"&eChemistry:&r they're unreactive enough to keep their shine. Silver is the best electrical conductor of any element."
		"&eHow:&r deepslate dissolves into a little silver. Check JEI for richer sources."
	]
	quest.6D2ACD876F2DB46F.title: "Metalloids"
	quest.6D2ACD876F2DB46F.quest_subtitle: "Half metal, half non-metal"
	quest.6D2ACD876F2DB46F.quest_desc: [
		"&eWhat:&r germanium, silicon and arsenic sit on the staircase between metals and non-metals."
		"&eChemistry:&r silicon conducts a little, and a trace of arsenic (doping) controls how much. The first transistor (1947) was germanium."
		"&eHow:&r sand dissolves into silicon dioxide, which dissolves again into silicon and oxygen. Blaze powder and Nether bricks give germanium."
		"&eTip:&r you'll need a lot of silicon later, for circuits and AE2."
	]
	quest.50A543F5038B63D3.title: "Non-Metals"
	quest.50A543F5038B63D3.quest_subtitle: "Fertilisers, matches and acids"
	quest.50A543F5038B63D3.quest_desc: [
		"&eWhat:&r nitrogen, phosphorus and sulfur. Life and industry both run on them."
		"&eChemistry:&r nitrogen and phosphorus feed every crop; sulfur becomes sulfuric acid, the most-made chemical on Earth."
		"&eHow:&r check JEI with &eU&r. Nether blocks are a good place to look for sulfur."
	]
	quest.2357AF880243FC07.title: "Chalcogens"
	quest.2357AF880243FC07.quest_subtitle: "Group 16: the ore-formers"
	quest.2357AF880243FC07.quest_desc: [
		"&eWhat:&r oxygen, sulfur and selenium. 'Chalcogen' means 'ore-former'."
		"&eChemistry:&r two electrons short of a full shell, so they grab metals: most ores are oxides or sulfides (Fe₂O₃, ZnS, PbS)."
		"&eHow:&r fish and crimson fungus dissolve into selenium. Oxygen comes from nearly everything."
		"&eTip:&r selenium is a trace nutrient: you need a little, and too much is poisonous."
	]
	quest.58998E87C50508C4.title: "Halogens"
	quest.58998E87C50508C4.quest_subtitle: "Group 17: the salt-makers"
	quest.58998E87C50508C4.quest_desc: [
		"&eWhat:&r fluorine, chlorine, bromine and iodine, the most reactive non-metals."
		"&eChemistry:&r one electron short of full. 'Halogen' means 'salt-maker': Na + Cl → NaCl, table salt."
		"&eHow:&r magma blocks give fluorine and bromine. Horn coral gives iodine (via lead iodide). Chlorine comes out of salts: check JEI."
	]
	quest.67AFDB4F1145AF74.title: "Noble Gases"
	quest.67AFDB4F1145AF74.quest_subtitle: "Group 18: the full shell"
	quest.67AFDB4F1145AF74.quest_desc: [
		"&6Two halves of the table, joined. More of the old knowledge settles into place.&r"
		"&eWhat:&r helium, neon and argon, the gases that refuse to react."
		"&eChemistry:&r a full outer shell means nothing to gain or lose. Argon shields welds from air; neon glows red in a discharge tube."
		"&eHow:&r nothing dissolves into them, so build them: the Alchemistry Fusion Chamber (EV) adds proton numbers, so H + H → He. Check JEI for neon and argon."
		"&eTip:&r real stars fuse hydrogen into helium too, though it takes them four protons, not two."
	]
	quest.2FCFC5332C725FC5.title: "Heavy Noble Gases"
	quest.2FCFC5332C725FC5.quest_subtitle: "Even the 'inert' ones have limits"
	quest.2FCFC5332C725FC5.quest_desc: [
		"&eWhat:&r xenon and radon, the heaviest natural noble gases."
		"&eChemistry:&r in 1962 xenon was made to react (with platinum hexafluoride), ending the idea that noble gases never react. Radon is radioactive."
		"&eHow:&r dragon's breath dissolves into both. That means a trip to the End."
	]
	quest.4FDD1C7682843FC7.title: "Rare Earths"
	quest.4FDD1C7682843FC7.quest_subtitle: "Not rare, just hard to separate"
	quest.4FDD1C7682843FC7.quest_desc: [
		"&eWhat:&r the lanthanides: lanthanum, cerium, neodymium and their near-identical neighbours."
		"&eChemistry:&r they differ only in an inner (4f) shell, so their chemistry is almost the same. Neodymium makes the strongest permanent magnets."
		"&eHow:&r check JEI for sources. The Alchemistry Fusion Chamber can also build them from lighter elements."
	]
	quest.28B0DD716F969942.title: "Actinides"
	quest.28B0DD716F969942.quest_subtitle: "Every one of them radioactive"
	quest.28B0DD716F969942.quest_desc: [
		"&eWhat:&r thorium, uranium and plutonium, the fuels of the nuclear age."
		"&eChemistry:&r every actinide is radioactive. Plutonium barely exists in nature: you made it by firing neutrons at uranium."
		"&eHow:&r dissolve uranium and thorium materials. Plutonium comes from your fission reactor's waste."
	]
	quest.37629D084F46D2D3.title: "Isotopes: Heavy Water"
	quest.37629D084F46D2D3.quest_subtitle: "Same element, different weight"
	quest.37629D084F46D2D3.quest_desc: [
		"&eWhat:&r heavy water, D₂O: water made with deuterium, hydrogen with an extra neutron."
		"&eChemistry:&r isotopes have the same protons (so the same chemistry) but different neutrons. About 1 in 6,400 hydrogen atoms is deuterium."
		"&eHow:&r put a Filter Upgrade in a Mekanism Electric Pump and pump from water. It pulls out heavy water instead."
		"&eTip:&r deuterium is half of fusion fuel. You'll want this again in the Power chapter."
	]
	quest.6092229653F9D8E1.title: "Superheavy Elements"
	quest.6092229653F9D8E1.quest_subtitle: "Element 117, built by fusion"
	quest.6092229653F9D8E1.quest_desc: [
		"&eWhat:&r tennessine, element 117. Nothing in the world dissolves into it; you have to build it."
		"&eChemistry:&r real labs make superheavy elements by smashing nuclei together; only a handful of atoms have ever existed."
		"&eHow:&r the Alchemistry Fusion Chamber joins two elements, adding their proton numbers. Check JEI for the pairs that reach 117."
		"&eTip:&r one more step after this: add hydrogen (1) to tennessine (117) and you get 118."
	]
	quest.1488AD40E664A1B0.title: "Element 118"
	quest.1488AD40E664A1B0.quest_subtitle: "The last box on the table"
	quest.1488AD40E664A1B0.quest_desc: [
		"&6The last box on the table. You remember now: you once named these.&r"
		"&eWhat:&r oganesson, the heaviest element ever made."
		"&eChemistry:&r in reality it lasts under a millisecond. Here it sits in your inventory, which is the kind of thing demigods can do."
		"&eHow:&r fuse tennessine with hydrogen (or any pair adding to 118) in the Fusion Chamber."
	]
	quest.6FD07C82DBE5D22F.title: "Covalent Bonds: CO₂"
	quest.6FD07C82DBE5D22F.quest_subtitle: "Non-metals share electrons"
	quest.6FD07C82DBE5D22F.quest_desc: [
		"&eWhat:&r carbon dioxide, your first compound in this chapter."
		"&eChemistry:&r C + O₂ → CO₂. Non-metals don't hand electrons over; they share them in covalent bonds (O=C=O)."
		"&eHow:&r in the Combiner, pick Carbon Dioxide and supply 1 carbon + 2 oxygen."
		"&eTip:&r the Combiner GUI shows each recipe once you select its output."
	]
	quest.37C4E268B693B12C.title: "Hydrocarbons"
	quest.37C4E268B693B12C.quest_subtitle: "Carbon chains and hydrogen"
	quest.37C4E268B693B12C.quest_desc: [
		"&eWhat:&r methane (natural gas) and ethylene (the building block of polyethylene)."
		"&eChemistry:&r CH₄ has four single bonds. C₂H₄ has a C=C double bond, which is what lets it link into plastic chains."
		"&eHow:&r Combiner: methane = 1 C + 4 H; ethylene = 2 C + 4 H."
	]
	quest.60B403CE02523A26.title: "Ammonia"
	quest.60B403CE02523A26.quest_subtitle: "Nitrogen made useful"
	quest.60B403CE02523A26.quest_desc: [
		"&eWhat:&r ammonia, NH₃, the base of nearly all fertiliser."
		"&eChemistry:&r N₂ + 3H₂ → 2NH₃. Breaking nitrogen's triple bond is hard; the Haber-Bosch process needs heat, pressure and an iron catalyst."
		"&eHow:&r Combiner: 1 nitrogen + 3 hydrogen. Later you'll run real Haber-Bosch in an MI machine."
	]
	quest.5C85F46DBAFB7975.title: "Ionic Bonds: Salt"
	quest.5C85F46DBAFB7975.quest_subtitle: "A metal gives, a non-metal takes"
	quest.5C85F46DBAFB7975.quest_desc: [
		"&eWhat:&r sodium chloride, NaCl: table salt."
		"&eChemistry:&r sodium gives its one electron to chlorine. Na⁺ and Cl⁻ then hold together in a cubic crystal: an ionic bond."
		"&eHow:&r Combiner: 1 sodium + 1 chlorine."
		"&eTip:&r a reactive metal plus a poisonous gas makes something you sprinkle on food. Chemistry is strange."
	]
	quest.0432714741764BB2.title: "Strong Acids"
	quest.0432714741764BB2.quest_subtitle: "Hydrochloric and nitric acid"
	quest.0432714741764BB2.quest_desc: [
		"&eWhat:&r hydrochloric acid (HCl) and nitric acid (HNO₃)."
		"&eChemistry:&r acids give up H⁺ ions in water. Mixed 3:1, HCl and HNO₃ make aqua regia, which dissolves gold and platinum."
		"&eHow:&r Combiner: HCl = 1 H + 1 Cl; HNO₃ = 1 H + 1 N + 3 O."
	]
	quest.6C1BC2C1F5E838C9.title: "King of Chemicals"
	quest.6C1BC2C1F5E838C9.quest_subtitle: "H₂SO₄ from its elements"
	quest.6C1BC2C1F5E838C9.quest_desc: [
		"&6Built atom by atom. The old craft is coming back faster now.&r"
		"&eWhat:&r sulfuric acid, H₂SO₄, built straight from elements."
		"&eChemistry:&r industry makes it by the contact process: S → SO₂ → SO₃ → H₂SO₄. Here you skip the plant and place the atoms yourself."
		"&eHow:&r Combiner: 2 hydrogen + 1 sulfur + 4 oxygen."
	]
	quest.5A7E7E44590CC88A.title: "Sugar and Wood"
	quest.5A7E7E44590CC88A.quest_subtitle: "Carbohydrates from scratch"
	quest.5A7E7E44590CC88A.quest_desc: [
		"&eWhat:&r sucrose (table sugar) and cellulose (what wood and paper are made of)."
		"&eChemistry:&r plants make both from CO₂ and water using sunlight. Cellulose is a chain of glucose rings: C₆H₁₀O₅ per unit."
		"&eHow:&r Combiner: sucrose = 12 C + 22 H + 11 O; cellulose = 6 C + 10 H + 5 O."
		"&eTip:&r that's a lot of atoms. Stock up on carbon, hydrogen and oxygen first."
	]
	quest.62A5D4682F28805B.title: "Alcohol"
	quest.62A5D4682F28805B.quest_subtitle: "Add an OH group"
	quest.62A5D4682F28805B.quest_desc: [
		"&eWhat:&r ethanol, C₂H₅OH, made by attaching a hydroxide (OH) group to a two-carbon chain."
		"&eChemistry:&r the -OH group is what makes it an alcohol and lets it mix with water."
		"&eHow:&r Combiner: hydroxide = 1 O + 1 H, then ethanol = 2 C + 5 H + 1 hydroxide."
	]
	quest.4E03509D055DE107.title: "Lye"
	quest.4E03509D055DE107.quest_subtitle: "The base that balances the acid"
	quest.4E03509D055DE107.quest_desc: [
		"&eWhat:&r sodium hydroxide, NaOH: lye, a strong base."
		"&eChemistry:&r industry makes it by electrolysing salt water: 2NaCl + 2H₂O → 2NaOH + Cl₂ + H₂. Acid + base → salt + water."
		"&eHow:&r Combiner: 1 sodium + 1 hydroxide (make hydroxide from 1 O + 1 H)."
	]
	quest.22EF02A8E3C647BA.title: "Rust"
	quest.22EF02A8E3C647BA.quest_subtitle: "Iron, slowly returning to ore"
	quest.22EF02A8E3C647BA.quest_desc: [
		"&eWhat:&r iron(III) oxide, Fe₂O₃: rust, and also hematite, the most common iron ore."
		"&eChemistry:&r 4Fe + 3O₂ → 2Fe₂O₃. A blast furnace runs this backwards, using carbon to pull the oxygen off."
		"&eHow:&r Combiner: 2 iron + 3 oxygen."
	]
	quest.588B21981793812F.title: "Group 1, Complete"
	quest.588B21981793812F.quest_subtitle: "Every alkali metal, lithium to francium"
	quest.588B21981793812F.quest_desc: [
		"&eWhat:&r all six alkali metals: Li, Na, K, Rb, Cs and Fr."
		"&eChemistry:&r reactivity climbs down the group: the outer electron sits further from the nucleus and is lost more easily. Caesium explodes in water."
		"&eHow:&r press &eU&r on rubidium and caesium in JEI for Dissolver sources. Francium is rare in both reality and here; the Fusion Chamber can build it."
		"&eTip:&r real francium has a half-life of about 22 minutes. Yours keeps."
	]
	quest.4D4D8F69EA0E51DA.title: "Group 2, Complete"
	quest.4D4D8F69EA0E51DA.quest_subtitle: "Beryllium to radium"
	quest.4D4D8F69EA0E51DA.quest_desc: [
		"&eWhat:&r all six alkaline earth metals: Be, Mg, Ca, Sr, Ba and Ra."
		"&eChemistry:&r strontium salts burn red and barium salts green: that's how fireworks get their colours. Radium glows from its own radioactivity."
		"&eHow:&r JEI (&eU&r) shows Dissolver sources for strontium, barium and radium; the Fusion Chamber fills any gaps."
	]
	quest.7A6D3E363800E95F.title: "The Boron Group"
	quest.7A6D3E363800E95F.quest_subtitle: "Group 13: three valence electrons"
	quest.7A6D3E363800E95F.quest_desc: [
		"&eWhat:&r boron, aluminum, gallium, indium and thallium."
		"&eChemistry:&r boron is a metalloid; the rest are metals. Borosilicate glass (with B₂O₃) survives sudden heat, which is why lab glassware uses it."
		"&eHow:&r boron needs the Fusion Chamber (5 = 1 + 4: hydrogen + beryllium). Check JEI for thallium."
		"&eTip:&r thallium is very toxic in reality. In a chest it's harmless."
	]
	quest.5A3D23B90C25591B.title: "The Carbon Group"
	quest.5A3D23B90C25591B.quest_subtitle: "Group 14: from diamond to lead"
	quest.5A3D23B90C25591B.quest_desc: [
		"&eWhat:&r carbon, silicon, germanium, tin and lead, all with four valence electrons."
		"&eChemistry:&r the group runs from a non-metal (carbon) through metalloids (Si, Ge) to metals (Sn, Pb). Same outer shell, very different behaviour."
		"&eHow:&r all five come from the Dissolver: coal or graphite, sand, Nether bricks, diorite and lead ingots (check JEI)."
	]
	quest.78A106BCA05B94C4.title: "The Pnictogens"
	quest.78A106BCA05B94C4.quest_subtitle: "Group 15: nitrogen to bismuth"
	quest.78A106BCA05B94C4.quest_desc: [
		"&eWhat:&r nitrogen, phosphorus, arsenic, antimony and bismuth."
		"&eChemistry:&r five valence electrons, so they often form three bonds (NH₃, PH₃). Bismuth crystals grow in stepped 'hopper' shapes with a rainbow oxide film."
		"&eHow:&r JEI (&eU&r) shows Dissolver sources for antimony and bismuth."
	]
	quest.1475430F54A37D4C.title: "Group 17, Complete"
	quest.1475430F54A37D4C.quest_subtitle: "All five halogens, astatine included"
	quest.1475430F54A37D4C.quest_desc: [
		"&eWhat:&r the four common halogens plus astatine, one of the rarest natural elements on Earth."
		"&eChemistry:&r down the group the halogens go from gas (F₂, Cl₂) to liquid (Br₂) to solid (I₂): bigger molecules attract each other more strongly."
		"&eHow:&r astatine has a few Dissolver sources (press &eU&r in JEI), or build it in the Fusion Chamber."
	]
	quest.237F3EB96853A0D3.title: "Group 18, Complete"
	quest.237F3EB96853A0D3.quest_subtitle: "Every natural noble gas"
	quest.237F3EB96853A0D3.quest_desc: [
		"&eWhat:&r helium through radon, the whole right-hand column."
		"&eChemistry:&r from 1960 to 1983 the metre was defined by the orange light of krypton-86. Xenon lights car headlamps and drives ion engines in spacecraft."
		"&eHow:&r nothing dissolves into the light ones: fuse them in the Fusion Chamber (krypton is 36: try neon + iron). Xenon and radon come from dragon's breath."
	]
	quest.74C0A65252881167.title: "All Fifteen Lanthanides"
	quest.74C0A65252881167.quest_subtitle: "Lanthanum to lutetium"
	quest.74C0A65252881167.quest_desc: [
		"&eWhat:&r the full lanthanide row, the first line of the f-block."
		"&eChemistry:&r europium makes the red in old TV screens and the anti-forgery glow in euro notes. Promethium has no stable isotope at all."
		"&eHow:&r a few have Dissolver sources (press &eU&r); the Fusion Chamber builds the rest by adding proton numbers."
		"&eTip:&r a challenge, not a requirement. Work through them as spare elements pile up."
	]
	quest.6C84E4F71745246F.title: "All Fifteen Actinides"
	quest.6C84E4F71745246F.quest_subtitle: "Actinium to lawrencium"
	quest.6C84E4F71745246F.quest_desc: [
		"&eWhat:&r the full actinide row. Everything past uranium is man-made."
		"&eChemistry:&r einsteinium and fermium were first found in the debris of the first hydrogen bomb test in 1952. Americium sits in household smoke detectors."
		"&eHow:&r the Fusion Chamber: gold (79) plus a light element reaches actinium and beyond (check JEI for the pairs)."
	]
	quest.22D0F58DF7F25E10.title: "Limestone"
	quest.22D0F58DF7F25E10.quest_subtitle: "CaCO₃: shells, chalk and marble"
	quest.22D0F58DF7F25E10.quest_desc: [
		"&eWhat:&r calcium carbonate, the mineral in limestone, chalk, marble and seashells."
		"&eChemistry:&r heat it and it splits: CaCO₃ → CaO + CO₂. That quicklime is the start of cement and mortar."
		"&eHow:&r Combiner: first carbonate (1 carbon + 3 oxygen), then 1 calcium + 1 carbonate."
	]
	quest.5AC83B5A60A95BA7.title: "Saltpeter"
	quest.5AC83B5A60A95BA7.quest_subtitle: "KNO₃: fertiliser and black powder"
	quest.5AC83B5A60A95BA7.quest_desc: [
		"&eWhat:&r potassium nitrate, the oxidiser in gunpowder and a classic fertiliser."
		"&eChemistry:&r black powder is roughly 75% KNO₃, 15% charcoal and 10% sulfur. The nitrate brings its own oxygen, so it burns without air."
		"&eHow:&r Combiner: nitrate (1 nitrogen + 3 oxygen), then 1 potassium + 1 nitrate."
		"&eTip:&r the Combiner also turns potassium nitrate, sulfur and graphite into gunpowder (check JEI)."
	]
	quest.2E9EA30781616E79.title: "Aspirin"
	quest.2E9EA30781616E79.quest_subtitle: "C₉H₈O₄, from willow bark to pill"
	quest.2E9EA30781616E79.quest_desc: [
		"&eWhat:&r acetylsalicylic acid, the world's best-known painkiller."
		"&eChemistry:&r willow bark contains salicin, used against pain for thousands of years. Adding an acetyl group (1897) made it gentler on the stomach."
		"&eHow:&r Combiner: 9 carbon + 8 hydrogen + 4 oxygen."
	]
	quest.7BCDFE7974554AE4.title: "Permanganate"
	quest.7BCDFE7974554AE4.quest_subtitle: "KMnO₄: the purple oxidiser"
	quest.7BCDFE7974554AE4.quest_desc: [
		"&eWhat:&r potassium permanganate, deep purple crystals and a strong oxidiser."
		"&eChemistry:&r manganese here is in its +7 oxidation state and eager to take electrons back. The purple fades as it reacts, so chemists use it as its own indicator."
		"&eHow:&r Combiner: 1 potassium + 1 manganese + 4 oxygen."
	]
	quest.13136D8964D60149.title: "Morning Coffee"
	quest.13136D8964D60149.quest_subtitle: "Secret: C₈H₁₀N₄O₂"
	quest.13136D8964D60149.quest_desc: [
		"&6Even a demigod likes a cup in the morning. You remember that much without trying.&r"
		"&eWhat:&r caffeine, built atom by atom: 8 carbon, 10 hydrogen, 4 nitrogen, 2 oxygen."
		"&eChemistry:&r it blocks adenosine receptors in the brain, the signal that tells you you're tired."
		"&eTip:&r plants make caffeine as an insecticide. You drink it on purpose."
	]
	quest.1ED913270D2A436D.title: "Han Purple"
	quest.1ED913270D2A436D.quest_subtitle: "Secret: an ancient synthetic pigment"
	quest.1ED913270D2A436D.quest_desc: [
		"&eWhat:&r han purple, BaCuSi₂O₆, a barium copper silicate."
		"&eChemistry:&r Chinese artisans made it more than 2,000 years ago by firing barium, copper and silica minerals together. It colours figures in the Terracotta Army."
		"&eHow:&r Combiner: 1 barium + 1 copper + 2 silicon + 6 oxygen."
		"&eTip:&r one of the first synthetic pigments in history. You just repeated an ancient experiment."
	]
	chapter.19F3B97B20C71F81.title: "Mekanism"
	chapter.19F3B97B20C71F81.chapter_subtitle: [
		"Osmium, infusion and gases: Mekanism's machines, factories, circuits and logistics. Reactors and add-ons are on the next page."
	]
	quest.30B33E37D8C75001.title: "The Mekanism Way"
	quest.30B33E37D8C75001.quest_subtitle: "Infuse, tier up, process"
	quest.30B33E37D8C75001.quest_desc: [
		"&6Osmium hums in your hand. You remember metals that drank other substances and grew stronger.&r"
		"&eWhat:&r Mekanism is a machine mod built on infusion and gases: soak a metal in carbon, redstone, diamond or refined obsidian and it becomes an alloy; pipe gases between machines and they become chemistry."
		"&eHow:&r every machine comes in tiers (basic, advanced, elite, ultimate). In this pack each tier's control circuit needs the matching &eMI circuit&r."
		"&eTip:&r this page is a side path. The main-path Mekanism quests are linked on the left; click one to jump there. Reactors, More Machine and Mekanism Extras are on the next page, &ePower and Beyond&r."
	]
	quest.2EAB2527B94306B0.title: "Configurator"
	quest.2EAB2527B94306B0.quest_subtitle: "Every side of every machine, your choice"
	quest.2EAB2527B94306B0.quest_desc: [
		"&eWhat:&r the Configurator sets which side of a Mekanism block takes input and gives output, ejects contents, and rotates blocks."
		"&eHow:&r iron, an osmium ingot and steel. Sneak + right-click to change its mode; the side colours match the machine's GUI."
		"&eTip:&r most \"my machine won't take gas\" problems are a side set to the wrong colour."
	]
	quest.628207C2E816696C.title: "Energy Tablet"
	quest.628207C2E816696C.quest_subtitle: "A battery you can hold"
	quest.628207C2E816696C.quest_desc: [
		"&eWhat:&r a portable FE store. It is also a crafting part in the Robit, the Wind Generator, lasers, Free Runners and the Portable Teleporter."
		"&eHow:&r gold ingots, redstone and Infused Alloy (check JEI)."
		"&eTip:&r make a few at once; you'll keep needing them."
	]
	quest.15B4A19FFE957B9C.title: "Reinforced Alloy"
	quest.15B4A19FFE957B9C.quest_subtitle: "Infused alloy plus diamond"
	quest.15B4A19FFE957B9C.quest_desc: [
		"&eWhat:&r the second Mekanism alloy, used in elite circuits, lasers and the Solar Neutron Activator."
		"&eChemistry:&r real alloys work the same way: a few percent of a second element (carbon in steel, chromium in stainless) changes the metal's properties."
		"&eHow:&r Metallurgic Infuser: Infused Alloy + diamond infusion (from diamonds or diamond dust; check JEI)."
	]
	quest.430AB97A415B41E0.title: "Atomic Alloy"
	quest.430AB97A415B41E0.quest_subtitle: "Reinforced alloy plus refined obsidian"
	quest.430AB97A415B41E0.quest_desc: [
		"&eWhat:&r the top Mekanism alloy, needed for ultimate circuits, teleportation cores and the Robit."
		"&eHow:&r first infuse obsidian dust with diamond to get refined obsidian dust, then infuse Reinforced Alloy with refined obsidian."
		"&eTip:&r crush obsidian in the Crusher or an MI macerator for obsidian dust."
	]
	quest.74EB548B9C9A8966.title: "Refined Obsidian"
	quest.74EB548B9C9A8966.quest_subtitle: "The Osmium Compressor's speciality"
	quest.74EB548B9C9A8966.quest_desc: [
		"&eWhat:&r refined obsidian ingots: very hard, blast-proof metal for teleporters, the Robit and endgame tools."
		"&eHow:&r the Osmium Compressor presses refined obsidian dust with liquid osmium into ingots. It needs an Advanced Control Circuit (MV)."
		"&eTip:&r refined glowstone ingots come from the same machine: glowstone dust plus osmium."
	]
	quest.43B12CDF9223A242.title: "Advanced Control Circuit"
	quest.43B12CDF9223A242.quest_subtitle: "Mekanism's MV tier"
	quest.43B12CDF9223A242.quest_desc: [
		"&eWhat:&r the circuit for every advanced-tier Mekanism block: factories, cubes, tanks, the Purification Chamber, and in this pack the whole 4x/5x ore line (injection, dissolution, washer, crystallizer)."
		"&eHow:&r an &eMI electronic circuit&r above two Infused Alloys and a Basic Control Circuit (check JEI)."
		"&eTip:&r the old infuser shortcut for circuits is removed in this pack. Circuits follow MI's voltage tiers."
	]
	quest.11991CAC308F74E6.title: "Elite Control Circuit"
	quest.11991CAC308F74E6.quest_subtitle: "Mekanism's HV tier"
	quest.11991CAC308F74E6.quest_desc: [
		"&eWhat:&r the circuit for elite-tier blocks, the Combiner, the Security Desk and the Solar Neutron Activator."
		"&eHow:&r an &eMI digital circuit&r above two Reinforced Alloys and an Advanced Control Circuit (check JEI)."
		"&eTip:&r HV comes with polyethylene on the main path. Make a stack of these before upgrading factories."
	]
	quest.6C11AB2E4E625255.title: "Ultimate Control Circuit"
	quest.6C11AB2E4E625255.quest_subtitle: "Mekanism's EV tier"
	quest.6C11AB2E4E625255.quest_desc: [
		"&eWhat:&r the circuit behind Mekanism's best blocks: the Isotopic Centrifuge, QIO, the Quantum Entangloporter, the Dimensional Stabilizer, the MekaSuit and the Meka-Tool."
		"&eHow:&r an &eMI processing unit&r above two Atomic Alloys and an Elite Control Circuit (check JEI)."
		"&eTip:&r this unlocks the rest of the page: ultimate factories, QIO, More Machine's big machines and Mekanism Extras."
	]
	quest.56344C09388A02E9.title: "Teleportation Core"
	quest.56344C09388A02E9.quest_subtitle: "The heart of everything that moves far"
	quest.56344C09388A02E9.quest_desc: [
		"&eWhat:&r the part inside teleporters, the Digital Miner, QIO drive arrays and the Quantum Entangloporter."
		"&eHow:&r Atomic Alloy, gold ingots, a diamond and ender pearls (check JEI)."
		"&eTip:&r you'll need at least four of these for this page alone. Automate Atomic Alloy early."
	]
	quest.476F4F55DB74C16A.title: "Teleporter"
	quest.476F4F55DB74C16A.quest_subtitle: "Step through a frame, arrive elsewhere"
	quest.476F4F55DB74C16A.quest_desc: [
		"&eWhat:&r a frame-and-controller portal that links to other teleporters, even across dimensions."
		"&eHow:&r the controller is a Teleportation Core in steel casings with basic circuits. Frames are refined obsidian around refined glowstone. Build a 3x4 frame with the controller in it (check JEI)."
		"&eTip:&r set both ends to the same frequency, and give the sending end plenty of power."
	]
	quest.4208DF1E90D16803.title: "Portable Teleporter"
	quest.4208DF1E90D16803.quest_subtitle: "A teleporter in your pocket"
	quest.4208DF1E90D16803.quest_desc: [
		"&eWhat:&r a hand-held teleporter that jumps you to any teleporter frequency you own."
		"&eHow:&r a Teleportation Core between two Energy Tablets and two basic circuits (check JEI). Charge it first."
		"&eTip:&r the further the jump, the more energy it costs."
	]
	quest.50BBE1B998118759.title: "Dimensional Stabilizer"
	quest.50BBE1B998118759.quest_subtitle: "Keep the chunks loaded"
	quest.50BBE1B998118759.quest_desc: [
		"&eWhat:&r Mekanism's chunk loader. It keeps chunks around it running while you're away, so your factories never pause."
		"&eHow:&r refined obsidian, Atomic Alloy, Ultimate Control Circuits (EV) and a diamond block (check JEI). Pick the chunks in its GUI."
		"&eTip:&r load only what you need. Every loaded chunk costs server time."
	]
	quest.07EED935F7FA3E41.title: "Quantum Entangloporter"
	quest.07EED935F7FA3E41.quest_subtitle: "One frequency, two places, everything shared"
	quest.07EED935F7FA3E41.quest_desc: [
		"&eWhat:&r two Entangloporters on the same frequency act as one block: energy, items, fluids, chemicals and heat go in one and out the other, across any distance or dimension."
		"&eChemistry:&r real quantum entanglement can't carry information or matter faster than light (the no-communication theorem). Mekanism takes a little artistic licence."
		"&eHow:&r refined obsidian, Atomic Alloy, Ultimate Control Circuits (EV) and a Teleportation Core (check JEI)."
		"&eTip:&r a pair is the easiest way to pipe uranium hexafluoride or D-T fuel from a remote plant to your base."
	]
	quest.379346C489EA37E0.title: "Robit"
	quest.379346C489EA37E0.quest_subtitle: "A small robot friend"
	quest.379346C489EA37E0.quest_desc: [
		"&eWhat:&r the Robit follows you, picks up items, smelts and crafts. It is also a crafting part for the Digital Miner and several More Machine blocks."
		"&eHow:&r Atomic Alloy, refined obsidian, steel, an Energy Tablet and a personal chest (check JEI). Place it on a Chargepad to recharge."
		"&eTip:&r rename it with a name tag. It won't mind."
	]
	quest.69E6901DA16854A9.title: "Digital Miner"
	quest.69E6901DA16854A9.quest_subtitle: "Mine a whole area by filter"
	quest.69E6901DA16854A9.quest_desc: [
		"&eWhat:&r a machine that mines out a large radius below it, taking only the blocks you filter for."
		"&eHow:&r Atomic Alloy, a Logistical Sorter, a Robit, a Teleportation Core and a steel casing (check JEI). Set filters (tags like c:ores work), radius and height, then start it."
		"&eTip:&r it uses a lot of power. Speed upgrades help, but bring Energy upgrades too. Rich deposits sit at metal-specific depths: set its height range to match."
	]
	quest.724CD60BF0CF8E1A.title: "QIO"
	quest.724CD60BF0CF8E1A.quest_subtitle: "Mekanism's digital storage"
	quest.724CD60BF0CF8E1A.quest_desc: [
		"&eWhat:&r Quantum Item Orchestration: drives in a drive array hold items, and dashboards, importers and exporters reach them wirelessly through a frequency."
		"&eHow:&r the drive array needs a Teleportation Core and Ultimate Control Circuits (EV); the base drive needs an ultimate circuit too. Give every QIO block the same frequency."
		"&eTip:&r AE2 is the pack's main storage. QIO is a good wireless add-on for a remote outpost."
	]
	quest.33BA8C34BC496F6F.title: "QIO In and Out"
	quest.33BA8C34BC496F6F.quest_subtitle: "Importers, exporters and a dashboard to carry"
	quest.33BA8C34BC496F6F.quest_desc: [
		"&eWhat:&r importers pull items from the inventory they face into QIO; exporters push chosen items out. The Portable Dashboard opens your QIO from anywhere."
		"&eHow:&r importer and exporter: lead, ender pearls, a Teleportation Core, an ultimate circuit and a (sticky) piston. The portable dashboard wraps a dashboard and a core in seven polonium pellets (check JEI)."
		"&eTip:&r an exporter with a filter on a machine's input is a tiny autocrafting line."
	]
	quest.1D8A57219BB3DBA2.title: "Challenge: Denser Drives"
	quest.1D8A57219BB3DBA2.quest_subtitle: "More items per drive"
	quest.1D8A57219BB3DBA2.quest_desc: [
		"&eWhat:&r the Hyper-Dense QIO Drive holds far more than a base drive. Time-Dilating and Supermassive drives go further still."
		"&eHow:&r each tier wraps the one below with a Teleportation Core and rarer materials (check JEI for each)."
		"&eTip:&r drive count matters as much as size: an array holds 12 drives."
	]
	quest.4CE52A91135BEBE5.title: "Energized Smelter"
	quest.4CE52A91135BEBE5.quest_subtitle: "A furnace that runs on FE"
	quest.4CE52A91135BEBE5.quest_desc: [
		"&eWhat:&r Mekanism's electric furnace. It smelts anything a furnace can, takes upgrades, and is the base of the smelting factory."
		"&eChemistry:&r electric heating is Joule heating: current through a resistance makes heat (P = I²R). No fuel, no smoke."
		"&eHow:&r Basic Alloy, glass, a Basic Control Circuit and a steel casing (check JEI)."
	]
	quest.66341E3805E3752A.title: "Basic Factory"
	quest.66341E3805E3752A.quest_subtitle: "Three jobs at once"
	quest.66341E3805E3752A.quest_desc: [
		"&eWhat:&r a factory is a machine with several slots that work in parallel. A basic factory runs 3 operations at once."
		"&eHow:&r craft any single machine (Energized Smelter, Enrichment Chamber, Crusher...) with Basic Control Circuits and Basic Alloy. Any factory type counts."
		"&eTip:&r factories sort their own inputs with auto-sort in the GUI, so one input pipe is enough."
	]
	quest.22D7A2CC8DFCC447.title: "Advanced Factory"
	quest.22D7A2CC8DFCC447.quest_subtitle: "Five jobs at once"
	quest.22D7A2CC8DFCC447.quest_desc: [
		"&eWhat:&r 5 parallel slots, and faster with upgrades."
		"&eHow:&r upgrade a basic factory in the crafting grid with Advanced Control Circuits, Infused Alloy and osmium, or use a Tier Installer on a placed one."
		"&eTip:&r upgrading keeps the factory's type, so plan which machines you want at five slots."
	]
	quest.3C4B48A497C51131.title: "Elite Factory"
	quest.3C4B48A497C51131.quest_subtitle: "Seven jobs at once"
	quest.3C4B48A497C51131.quest_desc: [
		"&eWhat:&r 7 parallel slots. Pair an Elite Purifying or Injecting Factory with your ore line and the bottleneck moves elsewhere."
		"&eHow:&r upgrade an advanced factory with Elite Control Circuits and Reinforced Alloy (check JEI)."
		"&eTip:&r the factory GUI shows each slot's progress; idle slots mean the input line is too slow."
	]
	quest.3AFA57F1F49E8CFE.title: "Ultimate Factory"
	quest.3AFA57F1F49E8CFE.quest_subtitle: "Nine jobs at once"
	quest.3AFA57F1F49E8CFE.quest_desc: [
		"&6Nine tasks in one box, all at once. You remember doing many things at once without effort.&r"
		"&eWhat:&r 9 parallel slots, the top of base Mekanism. Mekanism Extras goes further (see the bottom band)."
		"&eHow:&r upgrade an elite factory with Ultimate Control Circuits and Atomic Alloy (check JEI)."
		"&eTip:&r add Speed and Energy upgrades: speed raises power use, energy upgrades bring it back down."
	]
	quest.642807281823E2EA.title: "Tier Installers"
	quest.642807281823E2EA.quest_subtitle: "Upgrade without breaking"
	quest.642807281823E2EA.quest_desc: [
		"&eWhat:&r right-click a placed machine with a Tier Installer to turn it into the next tier, keeping its contents and settings."
		"&eHow:&r the basic installer needs a Basic Control Circuit; the advanced one needs an Advanced Control Circuit (MV)."
		"&eTip:&r a plain machine plus a basic installer becomes a basic factory."
	]
	quest.5155631ED5AF898E.title: "Precision Sawmill"
	quest.5155631ED5AF898E.quest_subtitle: "More planks, plus sawdust"
	quest.5155631ED5AF898E.quest_desc: [
		"&eWhat:&r cuts logs into more planks than hand crafting, often with a bonus of sawdust, and breaks wooden items back down."
		"&eChemistry:&r wood is about 40-50% cellulose (chains of glucose), with hemicellulose and lignin gluing the fibres together. Sawdust is the same polymers, finely divided."
		"&eHow:&r iron, Infused Alloy, a Basic Control Circuit and a steel casing (check JEI)."
		"&eTip:&r sawdust feeds wood gasification in the PRC and the Cardboard Box."
	]
	quest.31BA689339150966.title: "Factories for the Ore Line"
	quest.31BA689339150966.quest_subtitle: "Purifying and injecting in parallel"
	quest.31BA689339150966.quest_desc: [
		"&eWhat:&r a Purifying (O₂, 3x) or Injecting (HCl, 4x) Factory runs several ores at once. Ore processing is where factories pay off most."
		"&eChemistry:&r the gas is consumed per operation: oxygen oxidises the ore surface into clumps, hydrogen chloride attacks it into shards. More slots means more gas, so size the separator to match."
		"&eHow:&r build the factory from a Purification Chamber or Chemical Injection Chamber (both MV in this pack). Any tier and either type counts."
		"&eTip:&r feed the gas into the factory's gas side with pressurized tubes, the same as the single machine."
	]
	quest.4287C9CEAF6336C4.title: "Combiner"
	quest.4287C9CEAF6336C4.quest_subtitle: "Two inputs pressed into one block"
	quest.4287C9CEAF6336C4.quest_desc: [
		"&eWhat:&r the Combiner presses a main input together with a second block, for example flint + cobblestone into gravel, or 4 obsidian dust + cobbled deepslate back into obsidian."
		"&eChemistry:&r pressing powders into a solid below their melting point is sintering; it's how ceramics and many metal parts are made."
		"&eHow:&r Reinforced Alloy, &eElite Control Circuits&r (HV) and a steel casing (check JEI). Press U on it in JEI for every recipe."
	]
	quest.2F682BC4864BE11F.title: "Speed and Energy Upgrades"
	quest.2F682BC4864BE11F.quest_subtitle: "Faster machines, smaller bills"
	quest.2F682BC4864BE11F.quest_desc: [
		"&eWhat:&r slot them into any Mekanism machine. Speed upgrades make it work faster; energy upgrades cut its power use and enlarge its buffer."
		"&eHow:&r Infused Alloy and glass around osmium dust (speed) or gold dust (energy). A machine takes up to 8 of each."
		"&eTip:&r speed upgrades raise power use faster than they raise speed. Balance every speed upgrade with an energy upgrade."
	]
	quest.48A71474D1914A37.title: "The Other Upgrades"
	quest.48A71474D1914A37.quest_subtitle: "Filter, chemical, muffling, anchor, stone"
	quest.48A71474D1914A37.quest_desc: [
		"&eWhat:&r the Filter upgrade lets the Electric Pump pick heavy water; Chemical cuts gas use in gas-fed machines; Muffling quiets machines; Anchor keeps a machine's chunk loaded."
		"&eChemistry:&r the Stone Generator upgrade does what a cobble generator does: lava cooled by water solidifies into stone."
		"&eHow:&r Infused Alloy and glass around tin dust, iron dust or diamond dust; wool for muffling; water and lava buckets for stone (check JEI)."
		"&eTip:&r a machine's tooltip lists which upgrades it accepts."
	]
	quest.2637E04B1AF6D7B8.title: "Moving Day"
	quest.2637E04B1AF6D7B8.quest_subtitle: "Secret: pack a block in a box"
	quest.2637E04B1AF6D7B8.quest_desc: [
		"&eWhat:&r a Cardboard Box made from sawdust. Right-click almost any block (even a full chest or a spawner) to pack it up and carry it."
		"&eChemistry:&r cardboard is pressed cellulose fibre, the same polymer that makes up most of the sawdust."
		"&eTip:&r boxes can't pick up everything; blocks on the mod's blacklist won't pack."
	]
	quest.1D6581CAE9D412EB.title: "Challenge: Every Stage of Iron"
	quest.1D6581CAE9D412EB.quest_subtitle: "Crystal, shard, clump, dirty dust"
	quest.1D6581CAE9D412EB.quest_desc: [
		"&eWhat:&r the full 5x chain, one stage of each: crystal (5x) → shard (4x) → clump (3x) → dirty dust → dust."
		"&eChemistry:&r sulfuric acid dissolves the iron oxide into iron sulfate (Fe₂O₃ + 3H₂SO₄ → Fe₂(SO₄)₃ + 3H₂O). Washing rinses out insoluble rock, and crystallising pulls pure salt back out of solution."
		"&eHow:&r dissolve, wash and crystallise, then inject crystals with HCl, purify shards with O₂, crush clumps. Dirty dust goes to the MI Centrifuge for byproducts."
		"&eTip:&r each stage can also be fed raw ore directly, so a half-built line still gives 3x or 4x."
	]
	quest.4AB8C7EF44B3F0F5.title: "Heating the Plant"
	quest.4AB8C7EF44B3F0F5.quest_subtitle: "Heat is a resource you can pipe"
	quest.4AB8C7EF44B3F0F5.quest_desc: [
		"&eWhat:&r the Resistive Heater turns FE into heat; the Fuelwood Heater burns furnace fuel. Thermodynamic Conductors carry the heat to where it's needed, such as a Thermal Evaporation Plant."
		"&eChemistry:&r evaporation speeds up with temperature because more water molecules have enough energy to escape the surface. The conductors are copper in steel: copper conducts heat about 8 times better than steel."
		"&eHow:&r heaters need a steel casing and a circuit or Energy Tablet; conductors are steel and copper (check JEI). Watch the plant's temperature in its GUI."
		"&eTip:&r a hot plant in a desert biome runs much faster than a cold one in the snow."
	]
	quest.15E98C0F5A65D3FB.title: "Salt and Sodium"
	quest.15E98C0F5A65D3FB.quest_subtitle: "What brine leaves behind"
	quest.15E98C0F5A65D3FB.quest_desc: [
		"&eWhat:&r brine from the evaporation plant crystallises into salt, and splits into sodium and chlorine in the Electrolytic Separator."
		"&eChemistry:&r real sodium is made by electrolysing molten NaCl (2NaCl → 2Na + Cl₂, the Downs cell). Salt is also a classic HCl source: NaCl + H₂SO₄ → NaHSO₄ + HCl."
		"&eHow:&r Chemical Crystallizer: 15 mB brine → 1 salt. Electrolytic Separator: brine → sodium + chlorine. Salt also counts as a hydrogen chloride source in an HCl machine's chemical item slot (press U on Salt in JEI)."
		"&eTip:&r sodium is the coolant for the best fission setups (see Sodium Coolant on the Power and Beyond page)."
	]
	quest.5EA62A3C5AEAE013.title: "Dynamic Tank"
	quest.5EA62A3C5AEAE013.quest_subtitle: "Your first Mekanism multiblock"
	quest.5EA62A3C5AEAE013.quest_desc: [
		"&eWhat:&r a hollow multiblock tank of any size from 3x3x3 up, for huge amounts of a fluid or a chemical."
		"&eHow:&r dynamic tank blocks (steel and a bucket) for the frame, structural glass for walls, and valves to pipe in and out. The layout is in &eJust Enough Mekanism Multiblocks&r in JEI."
		"&eTip:&r one dynamic tank block is also a part in the PRC and the Chemical Oxidizer."
	]
	quest.6081E3377F168B47.title: "Pressurized Reaction Chamber"
	quest.6081E3377F168B47.quest_subtitle: "Solid, liquid and gas in, products out"
	quest.6081E3377F168B47.quest_desc: [
		"&eWhat:&r the PRC reacts an item, a fluid and a gas together under pressure. It makes substrate, HDPE, plutonium and polonium pellets, and gasifies coal and wood."
		"&eChemistry:&r pressure pushes gas molecules closer together so they collide with the other reactants more often. Le Chatelier: a reaction that shrinks gas volume is favoured by high pressure."
		"&eHow:&r Basic Control Circuits, Infused Alloy, steel, an Enrichment Chamber, a Dynamic Tank and chemical tanks (check JEI). Press &eU&r on it in JEI for every recipe."
		"&eTip:&r it often makes two products at once (an item and a gas). Give each output side its own pipe."
	]
	quest.2BA6ED44C18355F8.title: "Substrate"
	quest.2BA6ED44C18355F8.quest_subtitle: "Bio fuel and hydrogen into ethene"
	quest.2BA6ED44C18355F8.quest_desc: [
		"&eWhat:&r substrate is Mekanism's polymer seed: a little of it, with ethene and oxygen, becomes HDPE."
		"&eChemistry:&r plant matter can become ethylene: real bio-ethylene is made by dehydrating bioethanol (C₂H₅OH → C₂H₄ + H₂O). Polyethylene is then thousands of C₂H₄ units joined on a catalyst."
		"&eHow:&r PRC: 2 bio fuel + water + hydrogen → substrate + ethene. Then substrate + water + ethene → 8 substrate (plus a little O₂). Check JEI for amounts."
		"&eTip:&r MI ethylene is tagged as ethene in this pack, so your distillation tower can feed this line too."
	]
	quest.25E722BCAC2527A8.title: "HDPE Parts"
	quest.25E722BCAC2527A8.quest_subtitle: "Sheets, rods and sticks of plastic"
	quest.25E722BCAC2527A8.quest_desc: [
		"&eWhat:&r HDPE pellets shaped into sheets, rods and sticks: parts for the Solar Neutron Activator, module bases, the MekaSuit and the Meka-Tool."
		"&eChemistry:&r high-density polyethylene has straight chains with few branches, so they pack tightly. That makes it stiffer and stronger than the bendy LDPE in plastic bags."
		"&eHow:&r PRC: substrate + ethene + oxygen → HDPE pellet (or use your MI line from the main path). Then shape pellets in the crafting grid (check JEI)."
		"&eTip:&r the MekaSuit alone eats dozens of sheets. Automate the pellets."
	]
	quest.172FE0F1A8820335.title: "Modules"
	quest.172FE0F1A8820335.quest_subtitle: "The Modification Station"
	quest.172FE0F1A8820335.quest_desc: [
		"&eWhat:&r module bases are the blank every MekaSuit and Meka-Tool module is built on. The Modification Station installs modules into your gear."
		"&eHow:&r module base: an HDPE sheet in tin ingots and bronze nuggets (makes 2). Station: HDPE sheets, a chest, Ultimate Control Circuits (EV), a steel casing and a polonium pellet (check JEI)."
		"&eTip:&r press U on a Module Base in JEI to see every module and what each one needs."
	]
	quest.0B26554D7E11DCF3.title: "Meka-Tool"
	quest.0B26554D7E11DCF3.quest_subtitle: "Every tool, upgradable"
	quest.0B26554D7E11DCF3.quest_desc: [
		"&eWhat:&r the Atomic Disassembler grown up: one FE-powered tool that mines, digs, chops and fights, and takes modules for range, speed, silk touch, veinmining and more."
		"&eHow:&r an Atomic Disassembler, a Configurator, HDPE sheets, Ultimate Control Circuits, polonium pellets and a Basic Induction Cell (check JEI)."
		"&eTip:&r it drinks power fast with big modules. Carry a charged energy cube or wear the MekaSuit."
	]
	quest.327B62CC52974966.title: "The Full MekaSuit"
	quest.327B62CC52974966.quest_subtitle: "Pants and boots finish the set"
	quest.327B62CC52974966.quest_desc: [
		"&6Four pieces, one will. You remember standing in fire and feeling only warmth.&r"
		"&eWhat:&r the MekaSuit legs and boots, completing the armour started on the Tools page. Legs take movement and locomotion modules; boots take jump and fall protection."
		"&eHow:&r netherite leggings / boots in HDPE sheets, Ultimate Control Circuits, polonium pellets and a Basic Induction Cell (check JEI)."
		"&eTip:&r the full suit shares one energy pool through its modules. Charge it on a Chargepad or with a charging module."
	]
	quest.56908C9904F02260.title: "Pigments"
	quest.56908C9904F02260.quest_subtitle: "Colour as a chemical"
	quest.56908C9904F02260.quest_desc: [
		"&eWhat:&r the Pigment Extractor pulls coloured pigment out of dyes; the Painting Machine applies it to blocks and items."
		"&eChemistry:&r a pigment's colour comes from the light its molecules absorb: indigo absorbs orange-red light, so it looks blue."
		"&eHow:&r the extractor needs Basic Circuits; the Painting Machine needs an Advanced Control Circuit (MV)."
	]
	quest.0D7E1FDCB704A6ED.title: "Coal Gasification"
	quest.0D7E1FDCB704A6ED.quest_subtitle: "Coal, steam and oxygen into hydrogen"
	quest.0D7E1FDCB704A6ED.quest_desc: [
		"&eWhat:&r the PRC can gasify coal: coal + water + oxygen → hydrogen gas, with the coal's sulfur left behind as sulfur dust."
		"&eChemistry:&r the real water-gas reaction is C + H₂O → CO + H₂ at about 1,000 °C; a little oxygen burns part of the coal to keep it hot. Coal holds 0.5-5% sulfur, which refineries recover as elemental sulfur."
		"&eHow:&r PRC with any coal or coal dust, water and O₂ (check JEI). Logs and sawdust gasify the same way into charcoal dust."
		"&eTip:&r a handy extra sulfur source for the contact process."
	]
	quest.4B25493CF359C69E.title: "Challenge: The Full Chemical Plant"
	quest.4B25493CF359C69E.quest_subtitle: "One of every Mekanism chemical machine"
	quest.4B25493CF359C69E.quest_desc: [
		"&eWhat:&r one of each of Mekanism's ten chemical machines, from the Chemical Infuser to an SPS port."
		"&eChemistry:&r together they cover the unit operations of a real chemical plant: reaction, oxidation, electrolysis, washing, crystallisation, dissolution and isotope separation."
		"&eHow:&r most are on the main path (see the links on the left). The washer, crystallizer and dissolution chamber are MV in this pack; the centrifuge needs Ultimate Control Circuits (EV)."
		"&eTip:&r an optional collection. Keep spares in a chest as you build each one."
	]
	quest.779BBB4D57228159.title: "Cables and Pipes"
	quest.779BBB4D57228159.quest_subtitle: "Energy and fluids, Mekanism style"
	quest.779BBB4D57228159.quest_desc: [
		"&eWhat:&r Universal Cable carries FE, Mechanical Pipe carries fluids. With pressurized tubes (gases) and conductors (heat) they make Mekanism's four transmitter types."
		"&eHow:&r steel with redstone (cable) or a bucket (pipe), 8 per craft. Higher tiers wrap 8 of the lower tier around an alloy."
		"&eTip:&r transmitters of the same type join into one network. Colour them with a Configurator or paint to keep two networks apart."
	]
	quest.129E4985D5B10BD0.title: "Logistical Transporters"
	quest.129E4985D5B10BD0.quest_subtitle: "Item pipes you can see"
	quest.129E4985D5B10BD0.quest_desc: [
		"&eWhat:&r item pipes that carry stacks to the nearest inventory that will take them, and show the items moving."
		"&eHow:&r steel around a Basic Control Circuit, 8 per craft."
		"&eTip:&r a transporter's colour (set with the Configurator) only delivers into sides of the same colour."
	]
	quest.22B29103EF8AC412.title: "Logistical Sorter"
	quest.22B29103EF8AC412.quest_subtitle: "Pull, filter, send"
	quest.22B29103EF8AC412.quest_desc: [
		"&eWhat:&r pulls items out of the inventory behind it and sends them down transporters by filter: item, tag, mod or material."
		"&eHow:&r iron, a piston and a Basic Control Circuit. It is also a part of the Digital Miner."
		"&eTip:&r give each filter a colour, and the items arrive only at inventories with that colour."
	]
	quest.773E30699C7A311B.title: "Diversion and Restriction"
	quest.773E30699C7A311B.quest_subtitle: "Redstone-switched and last-resort routes"
	quest.773E30699C7A311B.quest_desc: [
		"&eWhat:&r a Diversion Transporter opens or closes with redstone; a Restrictive Transporter is only used when no other path works."
		"&eHow:&r steel and iron bars, plus redstone for the diversion type (check JEI)."
		"&eTip:&r a restrictive segment in front of an overflow chest makes it fill last."
	]
	quest.6908810FCE1F56F7.title: "Faster Transporters"
	quest.6908810FCE1F56F7.quest_subtitle: "Elite and ultimate item pipes"
	quest.6908810FCE1F56F7.quest_desc: [
		"&eWhat:&r higher tiers move bigger stacks, faster."
		"&eHow:&r 8 transporters of the tier below around Reinforced Alloy (elite) or Atomic Alloy (ultimate)."
		"&eTip:&r the line only needs to be as fast as its slowest machine. Upgrade the trunk, not every branch."
	]
	quest.062C44FD6FF382D0.title: "Seismic Survey"
	quest.062C44FD6FF382D0.quest_subtitle: "Listen to the ground"
	quest.062C44FD6FF382D0.quest_desc: [
		"&eWhat:&r the Seismic Vibrator shakes the ground beneath it; the Seismic Reader then shows every block straight down to bedrock."
		"&eChemistry:&r real prospectors use reflection seismology: sound waves bounce off layers of different density, and the echo times map oil and ore bodies."
		"&eHow:&r vibrator: tin, lapis, Basic Control Circuits and a steel casing; reader: steel, lapis and an Energy Tablet (check JEI)."
		"&eTip:&r rich ore deposits sit at metal-specific depths. Survey before you dig."
	]
	quest.2226714CAC96DA9D.title: "Formulaic Assemblicator"
	quest.2226714CAC96DA9D.quest_subtitle: "An autocrafter with a memory"
	quest.2226714CAC96DA9D.quest_desc: [
		"&eWhat:&r saves a crafting recipe on a Crafting Formula and crafts it whenever ingredients arrive."
		"&eHow:&r steel, a crafter, a chest, Basic Control Circuits and a steel casing (check JEI). Encode the recipe on a formula in its GUI."
		"&eTip:&r handy for alloy blocks or circuits until your AE2 autocrafting is up."
	]
	quest.6B67102715F82E89.title: "Nutritional Paste"
	quest.6B67102715F82E89.quest_subtitle: "Dinner, liquefied"
	quest.6B67102715F82E89.quest_desc: [
		"&eWhat:&r the Nutritional Liquifier turns food into nutritional paste; a Canteen carries it and feeds you when you drink."
		"&eChemistry:&r food energy is chemical energy in carbohydrates, fats and proteins. Mashing food changes its form, not its calories."
		"&eHow:&r liquifier: redstone, bowls, Basic Control Circuits and a steel casing. Canteen: tin and a bowl (check JEI). The MekaSuit has a module that drinks paste for you."
	]
	quest.74F6C540B45BCF12.title: "Mine, Not Yours"
	quest.74F6C540B45BCF12.quest_subtitle: "Personal storage and a security desk"
	quest.74F6C540B45BCF12.quest_desc: [
		"&eWhat:&r a Personal Chest only opens for its owner. The Security Desk sets who may use your Mekanism blocks: you, a trusted list, or everyone."
		"&eHow:&r personal chest: steel, glass, chests and a Basic Control Circuit. Security desk: steel, glass, a Network Reader and &eElite Control Circuits&r (HV) (check JEI)."
		"&eTip:&r on a shared server, lock your reactor controls."
	]
	quest.483E2D33125DA115.title: "Enriched Infusion"
	quest.483E2D33125DA115.quest_subtitle: "Concentrate the infuse before you use it"
	quest.483E2D33125DA115.quest_desc: [
		"&eWhat:&r the Enrichment Chamber turns coal, charcoal and redstone into enriched forms. One enriched item gives the Metallurgic Infuser far more infuse than the raw material."
		"&eChemistry:&r charcoal is nearly pure carbon left after heating wood without air (pyrolysis). Enriching it is like refining coal into coke: less ash, more carbon per gram."
		"&eHow:&r crush charcoal into Charcoal Dust in the Crusher, then put coal, charcoal or redstone through the Enrichment Chamber (check JEI)."
		"&eTip:&r feed enriched items into the infuser's left slot: one stack lasts a long time."
	]
	quest.228199BA6C4245DA.title: "Obsidian Dusts"
	quest.228199BA6C4245DA.quest_subtitle: "The road to refined obsidian"
	quest.228199BA6C4245DA.quest_desc: [
		"&eWhat:&r obsidian dust, and refined obsidian dust made by infusing it with diamond. Refined obsidian dust becomes Atomic Alloy and refined obsidian ingots."
		"&eChemistry:&r obsidian is volcanic glass, mostly SiO₂ (about 70%) with aluminium, iron and alkali oxides, frozen before it could crystallise."
		"&eHow:&r crush obsidian in the Crusher, then Metallurgic Infuser: obsidian dust + diamond infusion → refined obsidian dust (check JEI)."
		"&eTip:&r a Combiner can turn spare obsidian dust back into obsidian later."
	]
	quest.29E8251D2ECEE9F5.title: "Bio Fuel"
	quest.29E8251D2ECEE9F5.quest_subtitle: "Crush plants into fuel"
	quest.29E8251D2ECEE9F5.quest_desc: [
		"&eWhat:&r bio fuel is crushed plant matter. It burns in the Bio-Generator and is the start of the substrate line in the PRC."
		"&eChemistry:&r plants store sunlight as sugars and cellulose: 6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂. Burning or digesting them gives that energy back."
		"&eHow:&r put seeds, saplings, crops or other plant items into the Crusher (press U on Bio Fuel in JEI to see what counts)."
		"&eTip:&r a Mystical Agriculture or Farmer's Delight farm feeding a Crusher makes it renewable."
	]
	quest.26A70A88593B6654.title: "Dictionary and Gauge Dropper"
	quest.26A70A88593B6654.quest_subtitle: "Read tags, sample tanks"
	quest.26A70A88593B6654.quest_desc: [
		"&eWhat:&r the Dictionary shows the tags of any item or block you click. The Gauge Dropper sucks a little fluid or gas out of a tank, or dumps a tank you don't want."
		"&eHow:&r Dictionary: a book under a Basic Control Circuit. Gauge Dropper: osmium over glass panes (check JEI)."
		"&eTip:&r the Dictionary is the fastest way to find out which tag a filter needs (c:dusts/iron, c:ores and so on)."
	]
	quest.6CD748997C2CC496.title: "Chargepad"
	quest.6CD748997C2CC496.quest_subtitle: "Stand on it, charge everything"
	quest.6CD748997C2CC496.quest_desc: [
		"&eWhat:&r the Chargepad charges the FE items in your inventory (and a Robit) while you stand on it."
		"&eHow:&r polished blackstone pressure plates over steel and an Energy Tablet (check JEI). Feed it power from below."
		"&eTip:&r put one in front of your storage. Every visit tops up your tools."
	]
	quest.25E957C28B9C232B.title: "Portable Fluid Tanks"
	quest.25E957C28B9C232B.quest_subtitle: "Tanks that keep their contents"
	quest.25E957C28B9C232B.quest_desc: [
		"&eWhat:&r Mekanism fluid tanks keep their fluid when broken, so you can carry a tank of acid to another machine. Each tier holds more and moves it faster."
		"&eHow:&r basic: iron and Basic Alloy. Advanced: a basic tank ringed with iron and Infused Alloy (check JEI). They stack on top of each other and pass fluid down."
		"&eTip:&r right-click a tank with a bucket to fill or empty it; tanks also fill buckets placed in their GUI."
	]
	quest.494313CAFE5CE94B.title: "Elite Tanks"
	quest.494313CAFE5CE94B.quest_subtitle: "Bigger tanks for fluids and gases"
	quest.494313CAFE5CE94B.quest_desc: [
		"&eWhat:&r elite tanks hold far more than basic ones. The chemical tank is the gas version, for H₂, O₂, Cl₂ or SO₂."
		"&eHow:&r the advanced tank ringed with Reinforced Alloy and iron (fluid) or osmium (chemical). Check JEI."
		"&eTip:&r a chemical tank under an Electrolytic Separator smooths out its output while the rest of the line catches up."
	]
	quest.35138EE4D6529467.title: "Liquefied Gases"
	quest.35138EE4D6529467.quest_subtitle: "Hydrogen and oxygen, cold enough to pour"
	quest.35138EE4D6529467.quest_desc: [
		"&eWhat:&r the Rotary Condensentrator turns gases into liquids and back. Liquid hydrogen and oxygen fit in buckets and ordinary fluid tanks."
		"&eChemistry:&r hydrogen boils at -253 °C and oxygen at -183 °C. Liquid oxygen is pale blue and is attracted to a magnet, because O₂ has two unpaired electrons."
		"&eHow:&r set the condensentrator to condensing, feed it H₂ or O₂ from a separator, and pipe the liquid into a fluid tank. Fill buckets from the tank."
		"&eTip:&r rockets in this pack burn fuel and oxygen; liquids are how big amounts travel."
	]
	quest.20ED02FC69A36D30.title: "Acids by the Bucket"
	quest.20ED02FC69A36D30.quest_subtitle: "HCl and H₂SO₄ as liquids"
	quest.20ED02FC69A36D30.quest_desc: [
		"&eWhat:&r the same machine liquefies hydrogen chloride and sulfuric acid, so other mods' machines (and the Undergarden catalyst) can use Mekanism's acids."
		"&eChemistry:&r hydrogen chloride dissolved in water is hydrochloric acid; sulfuric acid is already a liquid at room temperature and boils at 337 °C."
		"&eHow:&r Rotary Condensentrator on condensing mode, fed from your contact process or HCl line (check JEI)."
		"&eTip:&r one bucket is 1,000 mB, the same as 1,000 mB of the gas form."
	]
	quest.11B35937083C8B1C.title: "Advanced Transmitters"
	quest.11B35937083C8B1C.quest_subtitle: "The second tier of all five"
	quest.11B35937083C8B1C.quest_desc: [
		"&eWhat:&r every Mekanism transmitter has four tiers. Advanced ones carry several times more energy, fluid, gas, items or heat than basic."
		"&eHow:&r eight basic transmitters around Infused Alloy make eight advanced ones (check JEI)."
		"&eChemistry:&r gas flow through a pipe rises with its cross-section and the pressure difference; Mekanism just lets you buy the bigger pipe."
		"&eTip:&r upgrade the trunk line from the separator first; the branches can stay basic."
	]
	quest.45C0D5C04731B51C.title: "Ultimate Universal Cable"
	quest.45C0D5C04731B51C.quest_subtitle: "Enough power for a reactor hall"
	quest.45C0D5C04731B51C.quest_desc: [
		"&eWhat:&r the top tier of power cable: tens of thousands of times what a basic cable carries."
		"&eHow:&r elite cables around Atomic Alloy (elite cables use Reinforced Alloy). Check JEI."
		"&eChemistry:&r real cables lose power as heat (P = I²R); fusion plants send power at high voltage so the current, and the loss, stays low."
	]
	quest.7AE81F60788EADD0.title: "Electric Bow"
	quest.7AE81F60788EADD0.quest_subtitle: "A bow that never needs repairs"
	quest.7AE81F60788EADD0.quest_desc: [
		"&eWhat:&r an FE-powered bow. Its fire mode sets arrows alight."
		"&eHow:&r string, Infused Alloy and an Energy Tablet (check JEI). Charge it on a Chargepad."
		"&eTip:&r it has no durability, only charge."
	]
	quest.54CF8FC94CFCD8F2.title: "Flamethrower"
	quest.54CF8FC94CFCD8F2.quest_subtitle: "Hydrogen, lit"
	quest.54CF8FC94CFCD8F2.quest_desc: [
		"&eWhat:&r a hand-held flamethrower that burns hydrogen gas. One mode smelts the blocks it hits."
		"&eChemistry:&r 2H₂ + O₂ → 2H₂O, about 286 kJ per mole of hydrogen. The flame is nearly invisible in daylight and leaves only water vapour."
		"&eHow:&r tin, bronze, a basic chemical tank, flint and steel and an &eAdvanced Control Circuit&r (MV). Fill it with H₂ from the separator's output or a chemical tank."
		"&eTip:&r never point it at your storage."
	]
	quest.23BAC71B584A6F45.title: "Pigment Mixer"
	quest.23BAC71B584A6F45.quest_subtitle: "Two colours in, one colour out"
	quest.23BAC71B584A6F45.quest_desc: [
		"&eWhat:&r mixes two pigments into a new one, for colours no single dye gives."
		"&eChemistry:&r pigments mix subtractively: each absorbs part of the spectrum, so yellow + cyan leaves only green to reflect."
		"&eHow:&r Reinforced Alloy, HDPE rods, a steel casing and &eElite Control Circuits&r (HV). Check JEI."
	]
	quest.53B27674143FE723.title: "Osmium Armour"
	quest.53B27674143FE723.quest_subtitle: "The densest metal, worn"
	quest.53B27674143FE723.quest_desc: [
		"&eWhat:&r Mekanism Tools adds a full armour set for each of its metals. Osmium is the first, and tougher than iron."
		"&eChemistry:&r osmium is the densest natural element (22.6 g/cm³). Real osmium is brittle and its oxide, OsO₄, is volatile and very toxic, so nobody actually wears it."
		"&eHow:&r osmium ingots in the usual armour shapes (check JEI)."
		"&eTip:&r bronze, steel and lapis sets exist too; see JEI for their stats."
	]
	quest.7D7B226DB54EB297.title: "Refined Obsidian Armour"
	quest.7D7B226DB54EB297.quest_subtitle: "The best of Mekanism Tools"
	quest.7D7B226DB54EB297.quest_desc: [
		"&eWhat:&r the strongest Mekanism Tools armour: high protection and toughness, good until the MekaSuit."
		"&eChemistry:&r obsidian is volcanic glass: lava cooled too fast for crystals to form. Infusing it with diamond and pressing it with osmium makes Mekanism's refined form."
		"&eHow:&r refined obsidian ingots from the Osmium Compressor, in armour shapes (check JEI)."
	]
	quest.54B932BD380C5962.title: "Refined Glowstone Armour"
	quest.54B932BD380C5962.quest_subtitle: "Light, pressed into metal"
	quest.54B932BD380C5962.quest_desc: [
		"&eWhat:&r the other Osmium Compressor metal as an armour set. Check JEI for how it compares with refined obsidian."
		"&eChemistry:&r real glow-in-the-dark materials store energy in their crystal and release it as light (phosphorescence); glowstone is Minecraft's version."
		"&eHow:&r Osmium Compressor: glowstone dust + osmium → refined glowstone ingots, then armour shapes."
	]
	chapter.676EA7EB0C02348E.title: "Mekanism: Power and Beyond"
	chapter.676EA7EB0C02348E.chapter_subtitle: [
		"Boilers, turbines and fusion; Mekanism: More Machine; and Mekanism Extras' four tiers beyond ultimate."
	]
	quest.7565AF89927B950A.title: "Power and Beyond"
	quest.7565AF89927B950A.quest_subtitle: "Mekanism's reactors and its two add-ons"
	quest.7565AF89927B950A.quest_desc: [
		"&6The machines obey you now. You remember wanting more: more heat, more power, more than the last tier allowed.&r"
		"&eWhat:&r the second Mekanism page. It covers the big power multiblocks (boiler, turbine, fusion), &eMekanism: More Machine&r and &eMekanism Extras&r."
		"&eHow:&r each row opens when its main-path quest is done: fission for the boiler, the turbine casing, D-T fuel for fusion, yellowcake for Extras. Those quests are linked on the left."
		"&eTip:&r the machines, factories, circuits and logistics are on the first Mekanism page."
	]
	quest.00D068F4E57C86B3.title: "Thermoelectric Boiler"
	quest.00D068F4E57C86B3.quest_subtitle: "Water into steam, by the tank"
	quest.00D068F4E57C86B3.quest_desc: [
		"&eWhat:&r a multiblock boiler that turns water into steam, heated by Superheating Elements (power) or by hot coolant from a fission reactor."
		"&eChemistry:&r boiling water takes 2,260 J per gram, far more than heating it. That latent heat is what the turbine later turns back into work."
		"&eHow:&r the layout is in &eJust Enough Mekanism Multiblocks&r in JEI: casing walls, valves, a layer of pressure dispersers, and elements on the bottom."
		"&eTip:&r a sodium-cooled fission reactor sends heated sodium here instead of boiling water itself."
	]
	quest.2CAB629DFAAF7446.title: "Sodium Coolant"
	quest.2CAB629DFAAF7446.quest_subtitle: "A liquid metal carries the heat"
	quest.2CAB629DFAAF7446.quest_desc: [
		"&eWhat:&r cool your fission reactor with sodium instead of water. It returns as superheated sodium, which the Thermoelectric Boiler uses to make steam before sending the sodium back."
		"&eChemistry:&r sodium melts at 98 °C and boils at 883 °C, so it stays liquid at reactor temperatures without high pressure. Real fast reactors use it, and keep it away from water, which it reacts with violently."
		"&eHow:&r sodium comes from brine in the Electrolytic Separator (see Salt and Sodium). Pipe it into the reactor, superheated sodium out to a boiler valve, and the cooled sodium back. Click to confirm once it runs."
		"&eTip:&r one sodium loop feeds a much bigger boiler and turbine than water cooling does."
	]
	quest.206DF2D646E0B9B5.title: "Turbine Valves and Vents"
	quest.206DF2D646E0B9B5.quest_subtitle: "Steam in, spent steam out"
	quest.206DF2D646E0B9B5.quest_desc: [
		"&eWhat:&r valves feed steam in and take power out; vents let the spent steam leave through the walls above the rotor."
		"&eChemistry:&r a turbine extracts work as steam expands and cools. The more vent area, the more steam can pass per tick."
		"&eHow:&r valve: turbine casings around an Advanced Control Circuit (MV). Vent: casings around iron bars (check JEI)."
		"&eTip:&r the turbine GUI shows whether vent flow or blade count is your limit."
	]
	quest.0909511F411FE352.title: "Turbine Internals"
	quest.0909511F411FE352.quest_subtitle: "Rotor, blades, coils, condensers"
	quest.0909511F411FE352.quest_desc: [
		"&eWhat:&r the moving parts inside an Industrial Turbine. More blades and coils mean more power from the same steam."
		"&eChemistry:&r condensers turn spent steam back into water, so the loop reuses the same water over and over."
		"&eHow:&r stack rotors with two blades each on the centre column, a Rotational Complex on top, then coils and condensers above. See Just Enough Mekanism Multiblocks."
		"&eTip:&r the turbine's GUI shows whether steam flow or blade count is the limit."
	]
	quest.579284C06EF69B84.title: "Building the Fusion Reactor"
	quest.579284C06EF69B84.quest_subtitle: "Frame, glass, ports and a laser window"
	quest.579284C06EF69B84.quest_desc: [
		"&eWhat:&r the shell of the Fusion Reactor: frames, reactor glass, ports for fuel and output, and a Laser Focus Matrix to let the ignition laser in."
		"&eHow:&r the 3D layout is in &eJust Enough Mekanism Multiblocks&r in JEI. The controller sits on top in the middle."
		"&eTip:&r ports switch between input and output with a Configurator."
	]
	quest.34E5D064EB957947.title: "Ignition"
	quest.34E5D064EB957947.quest_subtitle: "A laser hot enough to start a star"
	quest.34E5D064EB957947.quest_desc: [
		"&eWhat:&r lasers charge a Laser Amplifier, which fires a single huge pulse into the reactor to ignite it."
		"&eChemistry:&r deuterium and tritium only fuse above about 100 million °C, when the nuclei move fast enough to beat their electric repulsion."
		"&eHow:&r put a filled Hohlraum in the controller, aim the amplifier at the Laser Focus Matrix and fire it with a redstone signal. Then go to the Fusion quest."
		"&eTip:&r once lit, the reactor sustains itself as long as fuel keeps coming."
	]
	quest.0CC77768F60AE9E8.title: "Challenge: Every Generator"
	quest.0CC77768F60AE9E8.quest_subtitle: "Six ways to make FE"
	quest.0CC77768F60AE9E8.quest_desc: [
		"&eWhat:&r one of each Mekanism generator: heat, solar, advanced solar, wind, gas-burning and bio."
		"&eChemistry:&r between them: combustion, the photovoltaic effect, kinetic energy of air, and the energy stored in plant sugars by photosynthesis."
		"&eHow:&r each one has its own quest on the Power page. The wind generator needs an Energy Tablet; the advanced solar is built from four basic solar generators."
		"&eTip:&r none of these beats fission or fusion, but they never need fuel deliveries."
	]
	quest.267246E959EA307D.title: "Radioactive Waste Barrel"
	quest.267246E959EA307D.quest_subtitle: "Somewhere safe for the leftovers"
	quest.267246E959EA307D.quest_desc: [
		"&eWhat:&r a barrel that stores spent nuclear waste and other radioactive chemicals, and lets them slowly decay."
		"&eChemistry:&r radioactive decay can't be sped up by chemistry; you can only wait out the half-life. Real spent fuel spends years in cooling ponds, then decades in dry casks."
		"&eHow:&r check JEI for the recipe. Pipe waste into it with pressurized tubes; never vent it or break a full tube."
		"&eTip:&r reprocessing waste into plutonium and polonium (the T6 page) is better than storing it."
	]
	quest.700325CD50B46596.title: "Fusion Logic Adapter"
	quest.700325CD50B46596.quest_subtitle: "Let redstone watch the star"
	quest.700325CD50B46596.quest_desc: [
		"&eWhat:&r a reactor block that outputs redstone for things like ignition state, plasma temperature or low fuel."
		"&eHow:&r a fusion reactor frame surrounded by redstone; swap one frame of the shell for it and pick the mode in its GUI."
		"&eTip:&r wire \"ready for ignition\" to your laser amplifier to relight the reactor automatically."
	]
	quest.1178EDB5E27173C0.title: "Advanced Induction"
	quest.1178EDB5E27173C0.quest_subtitle: "More storage, faster in and out"
	quest.1178EDB5E27173C0.quest_desc: [
		"&eWhat:&r cells set how much an Induction Matrix stores; providers set how fast power goes in and out. Swap basic ones for advanced and the same shell does far more."
		"&eChemistry:&r the basic cells are lithium: Li has the lowest density of any metal and gives up its electron easily, which is why real batteries use it."
		"&eHow:&r cell: four basic cells around an Advanced Energy Cube, with Energy Tablets in the corners. Provider: four basic providers around an Advanced Energy Cube, with &eAdvanced Control Circuits&r (MV). Check JEI."
		"&eTip:&r cells and providers go inside the matrix, not in its walls."
	]
	quest.5F711391262BEFD1.title: "Elite Induction"
	quest.5F711391262BEFD1.quest_subtitle: "The next tier inside the matrix"
	quest.5F711391262BEFD1.quest_desc: [
		"&eWhat:&r elite cells and providers, each again several times bigger than the advanced ones."
		"&eHow:&r the same pattern one tier up: advanced cells around an Elite Energy Cube; advanced providers with &eElite Control Circuits&r (HV). Check JEI."
		"&eTip:&r a fission or fusion plant needs a big buffer for when the turbine spins down. Size the providers to your turbine's output."
	]
	quest.28F257A509393BA0.title: "Ultimate Energy Cube"
	quest.28F257A509393BA0.quest_subtitle: "The biggest single-block battery"
	quest.28F257A509393BA0.quest_desc: [
		"&eWhat:&r the top Energy Cube: a lot of storage in one block you can pick up and carry, contents and all."
		"&eHow:&r an Elite Energy Cube (Reinforced Alloy, gold) upgraded again with Atomic Alloy, Energy Tablets and diamonds (check JEI)."
		"&eTip:&r it's also the core of the ultimate induction cell and provider."
	]
	quest.6624297467DA9646.title: "Challenge: Ultimate Induction"
	quest.6624297467DA9646.quest_subtitle: "A power bank for a star"
	quest.6624297467DA9646.quest_desc: [
		"&6You remember holding the energy of a sun and not noticing the weight. This is close.&r"
		"&eWhat:&r the top Induction Matrix parts. A matrix full of these stores more than any other block in base Mekanism."
		"&eHow:&r elite cells or providers around an Ultimate Energy Cube, with Ultimate Control Circuits for the provider (check JEI)."
		"&eTip:&r a full matrix lets a fusion reactor keep your base running while you refuel or rebuild it."
	]
	quest.736DB4279A53E093.title: "CNC Machines"
	quest.736DB4279A53E093.quest_subtitle: "More Machine: stamp, turn and roll"
	quest.736DB4279A53E093.quest_desc: [
		"&eWhat:&r Mekanism: More Machine adds CNC machines: the Stamper presses plates, the Lathe turns rods, the Rolling Mill rolls wire."
		"&eHow:&r the CNC Stamper needs Basic Control Circuits, Basic Alloy, pistons and a steel casing. The Lathe also needs a Robit (check JEI). Any one counts."
		"&eTip:&r MI's machines make most plates already. Use CNC machines for the mod recipes that list them in JEI (the stamper also prints AE2 processors)."
	]
	quest.3E4C4D79C59C0844.title: "Recycler"
	quest.3E4C4D79C59C0844.quest_subtitle: "Stone and dirt into scrap"
	quest.3E4C4D79C59C0844.quest_desc: [
		"&eWhat:&r the Recycler grinds cheap blocks (stone, dirt, substrate) and sometimes leaves Scrap."
		"&eHow:&r a Crusher, Advanced Control Circuits (MV), Infused Alloy and osmium (check JEI). About 1 stone in 6 gives a scrap."
		"&eTip:&r 64 scrap compress into a Scrap Box, the first step towards UU-Matter. Start stockpiling early."
	]
	quest.140BB9D1CBB0F759.title: "Large Machines"
	quest.140BB9D1CBB0F759.quest_subtitle: "Big single-block versions"
	quest.140BB9D1CBB0F759.quest_desc: [
		"&eWhat:&r More Machine's large machines do the work of many normal ones, such as the Large Electrolytic Separator or Large Chemical Infuser."
		"&eHow:&r most need a Robit, steel blocks and ultimate-tier tanks or circuits (EV). Any one counts; check JEI for each."
		"&eTip:&r the Large Solar Neutron Activator is a big help for polonium and tritium."
	]
	quest.5947F763AB2801F8.title: "UU-Matter"
	quest.5947F763AB2801F8.quest_subtitle: "Matter from antimatter"
	quest.5947F763AB2801F8.quest_desc: [
		"&6Scrap, crystal, antimatter, and then anything. You remember when making matter was just a thought.&r"
		"&eWhat:&r UU-Matter is More Machine's universal matter. The Replicator turns it back into items."
		"&eHow:&r scrap boxes become Empty Crystals in the PRC (with fusion fuel and a special gas, check JEI). 64 crystals + antimatter in the Antiprotonic Nucleosynthesizer (an optional t7 quest) make one UU-Matter."
		"&eTip:&r the Replicator needs Ultimate Control Circuits and Atomic Alloy. Check JEI for what it can copy."
	]
	quest.1F12D14D184FBA11.title: "Presser"
	quest.1F12D14D184FBA11.quest_subtitle: "An upgraded stamper"
	quest.1F12D14D184FBA11.quest_desc: [
		"&eWhat:&r the Presser builds on the CNC Stamper and makes processors and other pressed parts (check JEI for its recipes)."
		"&eHow:&r a CNC Stamper with Elite Control Circuits (HV), Reinforced Alloy and pistons."
		"&eTip:&r press U on the Presser in JEI to see what it makes."
	]
	quest.40D85A929DD5607F.title: "Planting Station"
	quest.40D85A929DD5607F.quest_subtitle: "Grow crops in a box"
	quest.40D85A929DD5607F.quest_desc: [
		"&eWhat:&r a machine that grows seeds and saplings indoors and outputs the harvest."
		"&eChemistry:&r photosynthesis: 6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂, here powered by electricity instead of sunlight."
		"&eHow:&r Elite Control Circuits (HV), Reinforced Alloy, bio fuel and a steel casing (check JEI)."
	]
	quest.31BB98406EA4EDD2.title: "A Small Tribute"
	quest.31BB98406EA4EDD2.quest_subtitle: "Secret: the author, in doll form"
	quest.31BB98406EA4EDD2.quest_desc: [
		"&eWhat:&r a decorative doll of More Machine's author, compressed out of 64 UU-Matter and a breath of antimatter in the Osmium Compressor."
		"&eTip:&r the mod's modeller has a doll too, made from UU-Matter gas instead. Thank you, modders."
	]
	quest.6CC2DEC317329165.title: "Ambient Gas Collector"
	quest.6CC2DEC317329165.quest_subtitle: "Pull gas out of thin air"
	quest.6CC2DEC317329165.quest_desc: [
		"&eWhat:&r a machine that collects gas from its surroundings (check JEI and its GUI for what it gathers)."
		"&eChemistry:&r real air is 78% N₂, 21% O₂ and 1% argon; industry separates it by cooling it into a liquid and distilling it."
		"&eHow:&r Atomic Alloy, an osmium block, an ultimate chemical tank and ultimate tubes (EV)."
	]
	quest.5E8F3647B73A0992.title: "Radiance"
	quest.5E8F3647B73A0992.quest_subtitle: "Mekanism Extras begins"
	quest.5E8F3647B73A0992.quest_desc: [
		"&eWhat:&r Mekanism Extras adds four tiers beyond ultimate: absolute, supreme, cosmic and infinite. Each needs a new alloy, starting with Radiance."
		"&eHow:&r Osmium Compressor: glowstone dust + uranium oxide gas → Radiance Dust. Enrich it, then infuse Atomic Alloy with radiance (check JEI)."
		"&eTip:&r uranium oxide comes from oxidising yellowcake in the Chemical Oxidizer."
	]
	quest.6C057847340B18C8.title: "Absolute Control Circuit"
	quest.6C057847340B18C8.quest_subtitle: "Tier five"
	quest.6C057847340B18C8.quest_desc: [
		"&eWhat:&r the first Extras circuit: an Ultimate Control Circuit between two Radiance Alloys."
		"&eHow:&r craft it, or infuse an ultimate circuit with radiance in the Metallurgic Infuser."
		"&eTip:&r absolute factories, cubes and tanks all start here."
	]
	quest.62708C199FD0F204.title: "Supreme Control Circuit"
	quest.62708C199FD0F204.quest_subtitle: "Thermonuclear alloy"
	quest.62708C199FD0F204.quest_desc: [
		"&eWhat:&r tier six. Its alloy is Thermonuclear: Radiance Alloy infused with thermonuclear material."
		"&eHow:&r enriched radiance reacts with lava and molten thermonuclear in the PRC (check JEI for the full chain)."
		"&eTip:&r the circuit is an Absolute Control Circuit between two Thermonuclear Alloys."
	]
	quest.271EF9B3ECA8898F.title: "Cosmic Control Circuit"
	quest.271EF9B3ECA8898F.quest_subtitle: "Shining alloy, made with antimatter"
	quest.271EF9B3ECA8898F.quest_desc: [
		"&eWhat:&r tier seven. Its alloy, Shining, needs enriched thermonuclear transmuted with antimatter."
		"&eHow:&r Antiprotonic Nucleosynthesizer: enriched thermonuclear + antimatter → enriched shining. Then infuse Thermonuclear Alloy with it (check JEI)."
		"&eTip:&r the Nucleosynthesizer is slow; run it on fusion power."
	]
	quest.412F542BFE77DA7C.title: "Infinite Control Circuit"
	quest.412F542BFE77DA7C.quest_subtitle: "The last tier"
	quest.412F542BFE77DA7C.quest_desc: [
		"&6Infinite, the circuit says. You remember when that word described you.&r"
		"&eWhat:&r tier eight, the top of Mekanism Extras. Its alloy is Spectrum."
		"&eHow:&r Osmium Compressor: enriched shining + antimatter → enriched spectrum; infuse Shining Alloy with it, then craft the circuit (check JEI)."
	]
	quest.20AADC7F057BBBD9.title: "Absolute Factory"
	quest.20AADC7F057BBBD9.quest_subtitle: "Factories beyond ultimate"
	quest.20AADC7F057BBBD9.quest_desc: [
		"&eWhat:&r Extras factories have more slots than ultimate ones, and Extras adds factory types base Mekanism lacks (oxidizing, washing, crystallizing, centrifuging...)."
		"&eHow:&r upgrade an ultimate factory with Absolute Control Circuits and Radiance Alloy, or use an Absolute Tier Installer. Any absolute factory counts."
		"&eTip:&r the extra factory types are the big win: a washing or crystallizing factory speeds up the whole 5x line."
	]
	quest.76F42EC41A7A87E6.title: "Naquadah"
	quest.76F42EC41A7A87E6.quest_subtitle: "A metal from science fiction"
	quest.76F42EC41A7A87E6.quest_desc: [
		"&eWhat:&r Naquadah ore, added by Mekanism Extras. It is the fuel for the Naquadah Reactor."
		"&eChemistry:&r naquadah is not real; it comes from the Stargate films. Every other material on this page is real chemistry."
		"&eHow:&r Naquadah ore generates underground and in the End. Jade shows the block name when you look at it."
		"&eTip:&r it processes like other Mekanism ores: dissolve, wash and crystallise for the best yield."
	]
	quest.472EF62A30C14D95.title: "Naquadah Reactor"
	quest.472EF62A30C14D95.quest_subtitle: "A fusion reactor on fictional fuel"
	quest.472EF62A30C14D95.quest_desc: [
		"&eWhat:&r a fusion-style power multiblock from Mekanism Extras that runs on naquadah-based fuel."
		"&eHow:&r casings are lead blocks transmuted with antimatter in the Nucleosynthesizer; the controller needs Cosmic Control Circuits. Layout: Just Enough Mekanism Multiblocks."
		"&eTip:&r the fuel chain starts with fluorinated naquadah-uranium fuel. Check JEI for each step."
	]
	chapter.64C69CCA641352A4.title: "Mob Data and Big Crafting"
	chapter.64C69CCA641352A4.chapter_subtitle: [
		"Monifactory-inspired machinery: simulate mobs, craft on giant tables, and fold whole factories into a block."
	]
	quest.0C506EBC53C1DABE.title: "Deep Learning"
	quest.0C506EBC53C1DABE.quest_subtitle: "Teach a model by fighting"
	quest.0C506EBC53C1DABE.quest_desc: [
		"&6You remember knowing every creature by name. You can learn them again, one fight at a time.&r"
		"&eWhat:&r Hostile Neural Networks records mobs into data models. Trained models later make mob drops without the mob."
		"&eHow:&r craft the Deep Learner and a Blank Data Model (check JEI). Put models in the Deep Learner and keep it in your inventory while you fight."
		"&eTip:&r start with a mob whose drops you'll need in bulk, like blazes, slimes or endermen."
	]
	quest.0B5ACE02A3EC167D.title: "Your First Model"
	quest.0B5ACE02A3EC167D.quest_subtitle: "Attune a blank model to one mob"
	quest.0B5ACE02A3EC167D.quest_desc: [
		"&eWhat:&r a data model attuned to one mob type. It starts at Faulty and levels up as you kill that mob."
		"&eHow:&r right-click a mob with a Blank Data Model, or craft a specific model (check JEI). Then hunt with the Deep Learner."
		"&eTip:&r tiers go Faulty, Basic, Advanced, Superior, Self Aware. Higher tiers are more accurate, so fewer simulations fail."
	]
	quest.288F7BE90AC49D6E.title: "Simulation"
	quest.288F7BE90AC49D6E.quest_subtitle: "Mob drops from power and matrices"
	quest.288F7BE90AC49D6E.quest_desc: [
		"&eWhat:&r the Simulation Chamber runs a trained model on FE and prediction matrices to make predictions and mob drops."
		"&eHow:&r it needs an &eMV electronic circuit&r (aluminum chemistry). Insert a model of Basic tier or better, matrices and power."
		"&eTip:&r pipe matrices in and drops out; one chamber per model keeps things simple."
	]
	quest.22C8C82E50C1150C.title: "Loot Fabricator"
	quest.22C8C82E50C1150C.quest_subtitle: "Choose exactly which drop you want"
	quest.22C8C82E50C1150C.quest_desc: [
		"&6You remember making things appear from nothing. This is the mortal version: data, power and patience.&r"
		"&eWhat:&r turns predictions into the specific drop you pick (blaze rods, ender pearls, slime balls and more)."
		"&eHow:&r also needs an MV electronic circuit. Feed it predictions from the chamber and select the output in its GUI."
		"&eTip:&r simulated blazes are a cheap blaze-rod source for Silent Gear alloys and brewing."
	]
	quest.1A724AEF16C690EB.title: "Self Aware"
	quest.1A724AEF16C690EB.quest_subtitle: "Optional: max out a data model"
	quest.1A724AEF16C690EB.quest_desc: [
		"&eWhat:&r train one data model all the way to Self Aware, the top tier."
		"&eHow:&r keep killing that mob with the model in your Deep Learner, or let the Simulation Chamber train it. Click the checkmark when you've done it."
		"&eTip:&r a Self Aware model almost never fails a simulation."
	]
	quest.5A0AEB733FEC4D65.title: "Twilight Predictions"
	quest.5A0AEB733FEC4D65.quest_subtitle: "Optional: simulate Twilight Forest mobs"
	quest.5A0AEB733FEC4D65.quest_desc: [
		"&eWhat:&r Twilight Forest mobs give their own prediction type."
		"&eHow:&r train a model on a Twilight mob and run it in the Simulation Chamber."
		"&eTip:&r the Loot Fabricator shows which drops each prediction can become."
	]
	quest.661102C7F987E7BD.title: "Black Iron Parts"
	quest.661102C7F987E7BD.quest_subtitle: "Slates, components and catalysts"
	quest.661102C7F987E7BD.quest_desc: [
		"&eWhat:&r Extended Crafting tables are built from black iron slates plus a component and a catalyst of matching tier."
		"&eHow:&r black iron ingot = iron ingot + black dye (shapeless). Two ingots make a slate. A component takes a slate, luminessence (glowstone, redstone, gunpowder) and iron; four components ring a black iron ingot for the catalyst."
		"&eTip:&r make extra black iron; every table tier and the Crafting Core need more."
	]
	quest.3D513F09267F082E.title: "Extended Crafting"
	quest.3D513F09267F082E.quest_subtitle: "The 3x3 table that starts the ladder"
	quest.3D513F09267F082E.quest_desc: [
		"&eWhat:&r the Basic Table is a 3x3 table for Extended Crafting recipes, and the base of every bigger table."
		"&eHow:&r black iron slate, basic component and catalyst, an iron block and a crafting table."
		"&eTip:&r each bigger table is crafted from the one before it, so don't use this one up as decoration."
	]
	quest.3E2B8FDB3778E49B.title: "5x5: Advanced Table"
	quest.3E2B8FDB3778E49B.quest_subtitle: "Needs an MV electronic circuit"
	quest.3E2B8FDB3778E49B.quest_desc: [
		"&eWhat:&r a 5x5 crafting grid for mid-game recipes."
		"&eChemistry:&r its &eMI electronic circuit&r rests on aluminum, won by electrolysis of alumina: 2Al₂O₃ → 4Al + 3O₂."
		"&eHow:&r the Basic Table, gold blocks, advanced component and catalyst, plus the electronic circuit (check JEI)."
	]
	quest.00ED2FDA05907C7A.title: "7x7: Elite Table"
	quest.00ED2FDA05907C7A.quest_subtitle: "Needs an HV digital circuit"
	quest.00ED2FDA05907C7A.quest_desc: [
		"&eWhat:&r a 7x7 grid. Crystaltine and many late parts are crafted here."
		"&eChemistry:&r the &eMI digital circuit&r needs polyethylene, chains of ethylene (C₂H₄) from cracking oil."
		"&eHow:&r the Advanced Table, diamond blocks, elite component and catalyst, plus the digital circuit."
	]
	quest.2C2ECADD0D0886BB.title: "9x9: Ultimate Table"
	quest.2C2ECADD0D0886BB.quest_subtitle: "Needs an EV processing unit"
	quest.2C2ECADD0D0886BB.quest_desc: [
		"&6You remember building worlds on a table far bigger than this. Nine by nine will do for now.&r"
		"&eWhat:&r the endgame's biggest crafts happen here, including the Seed of a New World."
		"&eChemistry:&r the &eMI processing unit&r needs PVC: polyvinyl chloride, (C₂H₃Cl)ₙ, made from ethylene and chlorine."
		"&eHow:&r the Elite Table, emerald blocks, ultimate component and catalyst, plus the processing unit."
	]
	quest.71D7CC7520B500C0.title: "Packaged Automation"
	quest.71D7CC7520B500C0.quest_subtitle: "Let AE2 run the big tables for you"
	quest.71D7CC7520B500C0.quest_desc: [
		"&eWhat:&r Packaged Auto lets AE2 autocraft with Extended Crafting tables, through the PackagedExCrafting addon."
		"&eHow:&r encode recipes in the Encoder, then set up a Packager, a PackagedExCrafting crafter and an Unpackager by your ME network (tooltips and JEI explain each block)."
		"&eTip:&r one setup per table size handles every recipe of that size."
	]
	quest.2F7699EA87878993.title: "Ender Crafting"
	quest.2F7699EA87878993.quest_subtitle: "Optional: slow crafting, no hands needed"
	quest.2F7699EA87878993.quest_desc: [
		"&eWhat:&r the Ender Crafter finishes its recipes over time, faster with more Ender Alternators nearby."
		"&eHow:&r ender ingots (iron + ender pearl), eyes of ender and a crafting table (check JEI)."
		"&eTip:&r a ring of alternators around the crafter speeds it up a lot."
	]
	quest.02B9BEBA903C3462.title: "Combination Crafting"
	quest.02B9BEBA903C3462.quest_subtitle: "Optional: a core ringed by pedestals"
	quest.02B9BEBA903C3462.quest_desc: [
		"&eWhat:&r put the main item on the Crafting Core and the extras on Pedestals around it. The core uses FE to fuse them."
		"&eHow:&r elite components and catalysts, a frame and black iron (check JEI). JEI shows every combination recipe."
		"&eTip:&r pipe FE into the core; it won't start without power."
	]
	quest.495A4A8AF596B3DD.title: "Crystaltine"
	quest.495A4A8AF596B3DD.quest_subtitle: "Optional: diamond, lapis and a Nether Star"
	quest.495A4A8AF596B3DD.quest_desc: [
		"&eWhat:&r a late crafting metal made on the Elite Table."
		"&eChemistry:&r lapis lazuli's blue comes from lazurite, a sodium aluminosilicate with trapped sulfur ions (S₃⁻)."
		"&eHow:&r diamonds, lapis, iron, gold and a Nether Star in a 7x4 pattern (check JEI)."
	]
	quest.37FE5B7240F8C222.title: "Compact Machines"
	quest.37FE5B7240F8C222.quest_subtitle: "A whole factory inside one block"
	quest.37FE5B7240F8C222.quest_desc: [
		"&eWhat:&r fold an entire factory into a single block. The Personal Shrinking Device lets you walk inside it."
		"&eHow:&r shrinking and enlarging modules, an eye of ender, copper, iron and glass panes (check JEI)."
		"&eTip:&r it also shows you which machine room you're in and takes you back out."
	]
	quest.72183CBF18D24594.title: "Machine Walls"
	quest.72183CBF18D24594.quest_subtitle: "Polished deepslate, made compact"
	quest.72183CBF18D24594.quest_desc: [
		"&eWhat:&r Compact Machine Walls frame every machine block."
		"&eHow:&r crafted from polished deepslate (check JEI)."
		"&eTip:&r inside a room the walls are unbreakable; these crafted ones aren't."
	]
	quest.5D5BD30841DCCD95.title: "Atom Modules"
	quest.5D5BD30841DCCD95.quest_subtitle: "One shrinks, one enlarges"
	quest.5D5BD30841DCCD95.quest_desc: [
		"&eWhat:&r every Compact Machine needs one Atom Shrinking Module and one Atom Enlarging Module."
		"&eHow:&r an eye of ender, a light pressure plate, a stone button and a piston (sticky for shrinking)."
		"&eTip:&r make spares; each new machine eats a pair."
	]
	quest.3BEE4D083DB28729.title: "Step Inside"
	quest.3BEE4D083DB28729.quest_subtitle: "Craft a machine and shrink into it"
	quest.3BEE4D083DB28729.quest_desc: [
		"&6You remember holding a world in your palm. This one is smaller, but it's yours.&r"
		"&eWhat:&r craft a Compact Machine, place it, and right-click it with the Personal Shrinking Device to enter its room."
		"&eHow:&r walls + both modules + a metal sets the size: copper = tiny, iron = small, gold = normal, obsidian = giant, netherite = colossal (check JEI for the rest)."
		"&eTip:&r tunnels carry items, fluids and power through the walls; perfect for a compact chemical line."
	]
	quest.194624A9FFBFAE06.title: "Hide the Cables"
	quest.194624A9FFBFAE06.quest_subtitle: "Cables that look like any block"
	quest.194624A9FFBFAE06.quest_desc: [
		"&eWhat:&r Cable Facades disguise cables and pipes as any block. Tidy factories, same throughput."
		"&eHow:&r craft the Facade Wrench, then apply blocks to cables (check JEI)."
		"&eTip:&r facades on MI pipes make chemical lines much easier to look at."
	]
	quest.37B1429C3FDEB817.title: "Teleporting Cake"
	quest.37B1429C3FDEB817.quest_subtitle: "Eat a slice, change dimension"
	quest.37B1429C3FDEB817.quest_desc: [
		"&eWhat:&r TelePastries cakes teleport you to their dimension when you eat a slice."
		"&eHow:&r the Overworld Cake brings you home. Refill it with saplings; the Nether Cake takes obsidian."
		"&eTip:&r place the Overworld Cake in your Nether hub for a quick ride home."
	]
	quest.38748839E062F987.title: "Cake at the End"
	quest.38748839E062F987.quest_subtitle: "Optional: a slice to the End"
	quest.38748839E062F987.quest_desc: [
		"&eWhat:&r a cake that sends you to the End."
		"&eHow:&r a cake surrounded by eyes of ender. Refill it with eyes of ender."
		"&eTip:&r leave it in your base so the End is one bite away."
	]
	quest.0E4DA225CB5833A9.title: "Training Data: Blazes"
	quest.0E4DA225CB5833A9.quest_subtitle: "Optional: kill 30 blazes with a model loaded"
	quest.0E4DA225CB5833A9.quest_desc: [
		"&eWhat:&r every kill with a matching model in your Deep Learner adds data. Blaze models are worth it: blaze rods feed brewing, Powah and Create's Blaze Burners."
		"&eHow:&r put a blaze data model in the Deep Learner, keep it in your inventory, and hunt blazes at a Nether Fortress."
		"&eTip:&r a blaze model at a high tier turns the Simulation Chamber into an endless rod farm."
	]
	quest.0D49817F333BA253.title: "Training Data: Endermen"
	quest.0D49817F333BA253.quest_subtitle: "Optional: kill 30 endermen with a model loaded"
	quest.0D49817F333BA253.quest_desc: [
		"&eWhat:&r ender pearls go into Entangled blocks, AE2 seeds, Powah ender cells and teleporting. An enderman model makes them renewable."
		"&eHow:&r load an enderman data model and hunt them at night, in warped forests, or in the End."
		"&eTip:&r wear a carved pumpkin, or look at their feet, so they don't attack you first."
	]
	quest.3A9ADF5D85159EB7.title: "Three Worlds of Data"
	quest.3A9ADF5D85159EB7.quest_subtitle: "Optional: predictions from every dimension"
	quest.3A9ADF5D85159EB7.quest_desc: [
		"&eWhat:&r each simulation gives a prediction for the mob's home dimension as well as the drop. Overworld, Nether and End predictions are used in recipes and Fabrication Directives."
		"&eHow:&r run simulations of one mob from each dimension, such as a zombie, a blaze and an enderman."
		"&eTip:&r predictions stack up fast; send them to storage with a pipe."
	]
	quest.1A6BD466759A0E1E.title: "The Data Center"
	quest.1A6BD466759A0E1E.quest_subtitle: "Optional: 25 simulations at once"
	quest.1A6BD466759A0E1E.quest_desc: [
		"&6You remember watching a million lives at once. This is a pale copy, but a useful one.&r"
		"&eWhat:&r the Data Center runs up to 25 Self Aware data models at the same time, each making one drop per cycle."
		"&eHow:&r a Sim Chamber, a Loot Fabricator, a Nether Star, echo shards and obsidian. Build a 7x7x7 hollow shell: obsidian floor, black stained glass walls and ceiling, with the controller in a bottom wall facing out (JEI shows the rules)."
		"&eTip:&r IO ports in the shell let pipes feed inputs and pull the drops. A Fabrication Directive picks which drop each slot makes."
	]
	quest.23CCCA1395225BEC.title: "Flux Crafting"
	quest.23CCCA1395225BEC.quest_subtitle: "Optional: crafting powered by FE"
	quest.23CCCA1395225BEC.quest_desc: [
		"&eWhat:&r the Flux Crafter runs special recipes using FE delivered by nearby Flux Alternators, like the Flux Star."
		"&eHow:&r gold and redstone ingots (check JEI). Place alternators around the crafter and power them."
		"&eTip:&r JEI's Flux Crafter tab lists every recipe and the FE each one needs."
	]
	quest.383A333C4DD0B8D7.title: "Auto Tables"
	quest.383A333C4DD0B8D7.quest_subtitle: "Optional: tables that craft by themselves"
	quest.383A333C4DD0B8D7.quest_desc: [
		"&eWhat:&r Auto Tables remember a recipe and craft it with FE whenever the ingredients are inside. Each table size has its own."
		"&eHow:&r a crafting table of the same size plus crystaltine components (check JEI)."
		"&eTip:&r the Ultimate Auto Table is also the heart of Packaged ExCrafting's Ultimate Crafter (see the Applied Energistics page)."
	]
	quest.6A7C8CD52FF53CDB.title: "A Room for Every Line"
	quest.6A7C8CD52FF53CDB.quest_subtitle: "Optional: four compact machines"
	quest.6A7C8CD52FF53CDB.quest_desc: [
		"&eWhat:&r one compact machine per chemical line keeps your base tidy: a sulfuric acid room, a chlorine room, a petrochemical room."
		"&eHow:&r craft more machines (check JEI for the sizes) and enter each with the Personal Shrinking Device."
		"&eTip:&r a room only runs while the chunk with its machine block is loaded, so claim and force-load your factory."
	]
	quest.222D824B6476C5A9.title: "Multiblock Builder"
	quest.222D824B6476C5A9.quest_subtitle: "Place a whole MI multiblock in one go"
	quest.222D824B6476C5A9.quest_desc: [
		"&eWhat:&r Industrialization Overdrive's Multiblock Builder places every missing block of an MI multiblock from your inventory (or a linked ME network). Other modes copy and paste a formed one, or tear it down."
		"&eHow:&r steel plates, glass panes and an &eMI electronic circuit&r (MV). Look at the controller and press the key combination its tooltip shows; another key cycles the modes."
		"&eTip:&r carry the casings, hatches and coils first: it only places what you have."
	]
	chapter.6A576761B258CEBA.title: "Automation and Logic"
	chapter.6A576761B258CEBA.chapter_subtitle: [
		"Make the factory run itself."
	]
	quest.140C58A0A3A11DB7.title: "A Computer"
	quest.140C58A0A3A11DB7.quest_subtitle: "Lua, in a box"
	quest.140C58A0A3A11DB7.quest_desc: [
		"&6You never did your own chores. You remember having things that did them for you.&r"
		"&eWhat:&r CC: Tweaked computers run Lua programs: monitor tanks, balance chemical lines, build a base dashboard."
		"&eHow:&r place it and right-click. Type &ehelp&r, or &eedit startup&r to write a program that runs on boot."
		"&eTip:&r Mekanism machines can be read by computers directly. Put a computer next to one and try &eperipheral.getNames()&r."
	]
	quest.5860D80382B926CC.title: "Monitors"
	quest.5860D80382B926CC.quest_subtitle: "A screen for your numbers"
	quest.5860D80382B926CC.quest_desc: [
		"&eWhat:&r monitors show program output on a wall. Placed together, they join into one big screen."
		"&eHow:&r put monitors next to the computer and run &emonitor <side> <program>&r to send output to them."
		"&eTip:&r advanced monitors show colour and accept clicks, so you can make touch buttons."
	]
	quest.1DC5FA34C818F32E.title: "Wired Networks"
	quest.1DC5FA34C818F32E.quest_subtitle: "Reach machines across the room"
	quest.1DC5FA34C818F32E.quest_desc: [
		"&eWhat:&r wired modems and networking cable connect a computer to machines that aren't touching it."
		"&eHow:&r put a modem on the machine, run cable back to a modem on the computer, and right-click the machine's modem to attach it."
		"&eTip:&r each attached peripheral gets a name. List them with &eperipheral.getNames()&r."
	]
	quest.67691356C2B16C8D.title: "Ender Modem"
	quest.67691356C2B16C8D.quest_subtitle: "Talk across dimensions"
	quest.67691356C2B16C8D.quest_desc: [
		"&eWhat:&r the Ender Modem sends messages with no range limit, even between dimensions. A pocket computer carries a terminal with you."
		"&eHow:&r use &erednet&r on both ends: one computer broadcasts tank levels, your pocket computer reads them."
		"&eTip:&r a remote alarm for your reactor is a very good idea."
	]
	quest.5B44262E5F932D07.title: "Turtles"
	quest.5B44262E5F932D07.quest_subtitle: "Robots you program"
	quest.5B44262E5F932D07.quest_desc: [
		"&eWhat:&r turtles are programmable robots that mine, build and farm."
		"&eHow:&r craft one with a tool (a pickaxe makes a mining turtle) and fuel it with coal."
		"&eTip:&r try the built-in &eexcavate&r and &etunnel&r programs first."
	]
	quest.02AEF5F6A8349814.title: "Advanced Peripherals"
	quest.02AEF5F6A8349814.quest_subtitle: "Read power flow and your ME network"
	quest.02AEF5F6A8349814.quest_desc: [
		"&eWhat:&r extra peripherals: the Energy Detector measures power flow; the ME Bridge reads (and requests crafts from) your whole AE2 network."
		"&eHow:&r place them on your wired network like any other peripheral."
		"&eTip:&r an ME Bridge program can keep your stock of every intermediate topped up."
	]
	quest.34D7444D271541A3.title: "Base Dashboard"
	quest.34D7444D271541A3.quest_subtitle: "Every tank on one screen"
	quest.34D7444D271541A3.quest_desc: [
		"&eWhat:&r a wall screen that shows your chemical stocks, power and flow rates at a glance."
		"&eHow:&r the Fluid Detector measures flow through a pipe. Combine it with tank readings and the energy detector in one program."
		"&eTip:&r colour lines red when a tank drops below 20%. You'll spot problems from across the room."
	]
	quest.6192AD314EA01958.title: "Buses"
	quest.6192AD314EA01958.quest_subtitle: "AE2 pulls, pushes and reads"
	quest.6192AD314EA01958.quest_desc: [
		"&eWhat:&r an import bus pulls items out of a machine, an export bus pushes them in, and a storage bus lets ME see inside a chest or tank."
		"&eHow:&r place them on cable facing the machine. Set filters in each bus's GUI."
		"&eTip:&r Applied Mekanistics is in the pack, so buses and storage also handle Mekanism gases like hydrogen and SO₂."
	]
	quest.573035DFFD4A529E.title: "Crafting CPU"
	quest.573035DFFD4A529E.quest_subtitle: "The part of AE2 that plans"
	quest.573035DFFD4A529E.quest_desc: [
		"&eWhat:&r a crafting CPU is a multiblock that works out and tracks autocrafting jobs."
		"&eHow:&r build a solid box of crafting units with at least one crafting storage, and connect it to your network."
		"&eTip:&r more storage lets it plan bigger jobs; co-processing units run more steps at once."
	]
	quest.43797C9ECEA77DF3.title: "Encoding Patterns"
	quest.43797C9ECEA77DF3.quest_subtitle: "Teach AE2 a recipe"
	quest.43797C9ECEA77DF3.quest_desc: [
		"&eWhat:&r a pattern is a recipe card: these inputs make that output."
		"&eHow:&r in the Pattern Encoding Terminal, switch to Processing mode for machine recipes and fill in the inputs and outputs."
		"&eTip:&r processing patterns work for any machine: MI, Mekanism or the Combiner."
	]
	quest.21A977445D70545D.title: "Autocraft a Chemical Line"
	quest.21A977445D70545D.quest_subtitle: "Pattern providers drive your machines"
	quest.21A977445D70545D.quest_desc: [
		"&eWhat:&r pattern providers push ingredients into machines; molecular assemblers do crafting-table recipes."
		"&eHow:&r put a provider against an MI or Mekanism machine, load a processing pattern, and send the output back into the network."
		"&eTip:&r chain patterns (sulfur → SO₂ → SO₃ → H₂SO₄) and one request runs the whole line."
	]
	quest.3FEB19A4A1E0D8A4.title: "Level Emitters"
	quest.3FEB19A4A1E0D8A4.quest_subtitle: "Stop at enough"
	quest.3FEB19A4A1E0D8A4.quest_desc: [
		"&eWhat:&r a level emitter gives a redstone signal when the network holds more (or less) than a number you set."
		"&eHow:&r set the item and the amount, then wire the signal to a machine's redstone control."
		"&eTip:&r stop the Electrolytic Separator when hydrogen hits your target and you never waste power on a full tank."
	]
	quest.44221BA2292D178B.title: "Fully Automated Sulfuric Acid"
	quest.44221BA2292D178B.quest_subtitle: "Sulfur in, acid out, no hands"
	quest.44221BA2292D178B.quest_desc: [
		"&6The factory hums without you. You remember this kind of quiet.&r"
		"&eWhat:&r a line that makes sulfuric acid on its own and stops when the tanks are full."
		"&eChemistry:&r 2SO₂ + O₂ → 2SO₃ (industry uses a vanadium oxide catalyst), then SO₃ + H₂O → H₂SO₄."
		"&eHow:&r Separator (O₂) → Oxidizer (S → SO₂) → Infuser (SO₃) → Rotary Condensentrator (water vapour) → Infuser (H₂SO₄). Feed sulfur with a bus or LaserIO and gate it with a level emitter."
		"&eTip:&r when it runs a full day with no help, fill 16 buckets and click the checkmark."
	]
	quest.27ED21A2DD1FDA38.title: "Menril Resin"
	quest.27ED21A2DD1FDA38.quest_subtitle: "The tree that grows logic"
	quest.27ED21A2DD1FDA38.quest_desc: [
		"&eWhat:&r Integrated Dynamics builds everything from crystallised Menril, a resin from Menril trees."
		"&eChemistry:&r drying resin is just evaporation: the liquid loses its solvent and hardens, like tree sap turning into amber."
		"&eHow:&r squeeze Menril logs in a Squeezer for resin, then dry the resin in a Drying Basin."
		"&eTip:&r Menril trees grow wild in the Overworld. Plant the saplings once you find one."
	]
	quest.00C7FF03D1B02894.title: "Integrated Dynamics"
	quest.00C7FF03D1B02894.quest_subtitle: "Logic networks without code"
	quest.00C7FF03D1B02894.quest_desc: [
		"&eWhat:&r read a value (tank level, item count), apply logic, and act on it, all with blocks and cards."
		"&eHow:&r a Reader part (e.g. Fluid Reader) on a tank exposes values. Write one onto a Variable Card in the Logic Programmer."
		"&eTip:&r a Redstone Writer can then turn that value into a signal: perfect for stopping a separator when its tank is full."
	]
	quest.0B6B6A7EEDAF93D8.title: "Variable Store"
	quest.0B6B6A7EEDAF93D8.quest_subtitle: "Keep and name your logic"
	quest.0B6B6A7EEDAF93D8.quest_desc: [
		"&eWhat:&r the Variable Store holds variable cards so the whole network can use them; the Labeller names them."
		"&eHow:&r put cards in the store and reference them from any writer or display panel on the network."
		"&eTip:&r name cards after what they measure ('H2 tank %'). You'll thank yourself later."
	]
	quest.00A54A06239849EA.title: "Challenge: The Self-Stopping Separator"
	quest.00A54A06239849EA.quest_subtitle: "Your first closed loop"
	quest.00A54A06239849EA.quest_desc: [
		"&eWhat:&r make a Mekanism Electrolytic Separator turn itself off when its hydrogen tank is 90% full, and back on below 50%."
		"&eHow:&r a Reader on the tank → a comparison in the Logic Programmer → a Redstone Writer on the separator (set it to redstone control in its GUI)."
		"&eTip:&r the gap between 50% and 90% (hysteresis) stops it flickering on and off."
		"Click the checkmark once it works."
	]
	quest.34D0F3A6001E73F8.title: "Super Factory Manager"
	quest.34D0F3A6001E73F8.quest_subtitle: "One block scripts the whole factory"
	quest.34D0F3A6001E73F8.quest_desc: [
		"&eWhat:&r one Manager block runs a short program that moves items, fluids and energy between everything on its cables."
		"&eHow:&r put the disk in the Manager and write a program, e.g. &eEVERY 20 TICKS DO INPUT FROM a OUTPUT TO b END&r."
		"&eTip:&r the in-game editor has examples. Start with one input and one output."
	]
	quest.6DFD0C0EE913BF88.title: "Labels"
	quest.6DFD0C0EE913BF88.quest_subtitle: "Name every machine"
	quest.6DFD0C0EE913BF88.quest_desc: [
		"&eWhat:&r the Label Gun tags inventories with names (like &ea&r and &eb&r above) for your programs."
		"&eHow:&r set a label in the gun, then right-click each machine. The Network Tool shows what's connected."
		"&eTip:&r label by job ('sulfur_in', 'acid_out'), not by machine type."
	]
	quest.0239845B19FBECF7.title: "Logistics Network"
	quest.0239845B19FBECF7.quest_subtitle: "Nodes that route by rules"
	quest.0239845B19FBECF7.quest_desc: [
		"&eWhat:&r Logistics Network nodes sit on machines and chests and move items, fluids and energy between every node in the same named network, with no cables."
		"&eHow:&r obsidian, a redstone block, hoppers, an eye of ender and a redstone torch for a node (check JEI). Open a node to create or join a network, then set what it imports and exports."
		"&eTip:&r the Wrench has a copy-paste mode: set up one node, then paste its settings onto the rest."
	]
	quest.06ECD076BD8BC6DA.title: "Logistics Filters"
	quest.06ECD076BD8BC6DA.quest_subtitle: "Move only what you mean to"
	quest.06ECD076BD8BC6DA.quest_desc: [
		"&eWhat:&r filters narrow what a node moves: by tag, by amount and more."
		"&eHow:&r put a filter in a node's slot and set it up in its GUI (check JEI for all the filter types)."
		"&eTip:&r a tag filter for 'c:dusts' sends every dust to one chest."
	]
	quest.489B2F9C72693B10.title: "Node Upgrades"
	quest.489B2F9C72693B10.quest_subtitle: "Bigger batches, shorter delays"
	quest.489B2F9C72693B10.quest_desc: [
		"&eWhat:&r upgrades raise how much a node moves per batch and how often. Iron, gold, diamond and netherite tiers each do more."
		"&eHow:&r the tier's metal, hoppers, chests and smooth stone (check JEI). Put them in the node's upgrade slots."
		"&eTip:&r the upgrade's tooltip lists its exact items, fluid and energy per batch."
	]
	quest.1256F17F8027B0DF.title: "Moving Chemicals"
	quest.1256F17F8027B0DF.quest_subtitle: "Nodes that carry Mekanism gases"
	quest.1256F17F8027B0DF.quest_desc: [
		"&eWhat:&r the Mekanism Chemical Upgrade lets nodes move Mekanism chemicals: H₂, O₂, Cl₂, SO₂ and the rest."
		"&eChemistry:&r the contact process needs SO₂ and O₂ in the same place: 2SO₂ + O₂ → 2SO₃. Nodes can bring both to one Chemical Infuser."
		"&eHow:&r basic chemical tanks, infused alloy, chests and an Iron Upgrade (check JEI)."
		"&eTip:&r one network for gases and another for items keeps the settings easy to read."
	]
	quest.4AAFFDC37F0E4EE8.title: "Network Manager"
	quest.4AAFFDC37F0E4EE8.quest_subtitle: "Optional: see every node and its flow"
	quest.4AAFFDC37F0E4EE8.quest_desc: [
		"&eWhat:&r the Computer opens a Network Manager that lists your networks, their nodes and how much each channel moves."
		"&eHow:&r iron, glass and a comparator (check JEI)."
		"&eTip:&r when a line stops, look here first: a channel with no flow shows where the jam is."
	]
	quest.408A259A993527E2.title: "LaserIO Cards"
	quest.408A259A993527E2.quest_subtitle: "Configure what each node moves"
	quest.408A259A993527E2.quest_desc: [
		"&eWhat:&r cards tell each LaserIO node what to move and in which direction."
		"&eHow:&r put a card in a node's side slot. Set it to Extract on the source and Insert on the destination."
		"&eTip:&r right-click with a card in your hand to open its settings."
	]
	quest.441C3C6BBF44735C.title: "Fluids and Gases by Laser"
	quest.441C3C6BBF44735C.quest_subtitle: "Move acids without pipes"
	quest.441C3C6BBF44735C.quest_desc: [
		"&eWhat:&r fluid cards move liquids; chemical cards move Mekanism gases, like hydrogen and SO₂."
		"&eHow:&r same as item cards: Extract on the tank, Insert on the machine."
		"&eTip:&r one node can run several cards on one side. Hydrogen and oxygen out of one separator, two cards."
	]
	quest.6912F21E0B5211B5.title: "LaserIO Filters"
	quest.6912F21E0B5211B5.quest_subtitle: "Basic, tag and count filters"
	quest.6912F21E0B5211B5.quest_desc: [
		"&eWhat:&r filters go inside cards. Basic matches a list, Tag matches a tag, Count keeps a set number in stock."
		"&eHow:&r put the filter in a card's filter slot and set it up."
		"&eTip:&r a count filter on an insert card keeps exactly 64 sulfur in the oxidizer and no more."
	]
	quest.43C31D71C7FEB6D8.title: "Overclocking"
	quest.43C31D71C7FEB6D8.quest_subtitle: "Faster lasers"
	quest.43C31D71C7FEB6D8.quest_desc: [
		"&eWhat:&r overclockers make LaserIO move more, faster."
		"&eHow:&r overclocker cards go in a card's upgrade slot; overclocker nodes go in the node."
		"&eTip:&r most lines don't need it. Add it when a machine starves."
	]
	quest.5A5E16639EDFAC93.title: "Printers and Disks"
	quest.5A5E16639EDFAC93.quest_subtitle: "Optional: save programs, print lab notes"
	quest.5A5E16639EDFAC93.quest_desc: [
		"&eWhat:&r a Disk Drive lets you save programs on floppy disks and carry them between computers. A Printer prints text onto paper."
		"&eHow:&r check JEI. Put a disk in the drive and it appears as &edisk/&r in the computer's files."
		"&eTip:&r print a list of your reactions and their inputs and bind the pages into a book: a real lab notebook."
	]
	quest.6BDC8F1C446B5D65.title: "Advanced Turtle"
	quest.6BDC8F1C446B5D65.quest_subtitle: "Optional: a golden robot with a colour screen"
	quest.6BDC8F1C446B5D65.quest_desc: [
		"&eWhat:&r advanced turtles have colour screens and can be clicked, which makes menus easy."
		"&eHow:&r an advanced computer with gold instead of iron around it (check JEI). Give it a pickaxe to make a Mining Turtle."
		"&eTip:&r run &eexcavate 16&r on a mining turtle and it digs a 16x16 hole down to bedrock, bringing everything back."
	]
	quest.7D39CBFAE0AE3E52.title: "Geo Scanner"
	quest.7D39CBFAE0AE3E52.quest_subtitle: "Optional: find ores with a program"
	quest.7D39CBFAE0AE3E52.quest_desc: [
		"&eWhat:&r the Geo Scanner lists every block around it within a radius, including ores, for your computer to read."
		"&eChemistry:&r real geologists find ore bodies by measuring gravity, magnetism and how rocks conduct electricity, rather than digging blind."
		"&eHow:&r check JEI. Put it next to a computer (or in a pocket computer) and call &escan(8)&r."
		"&eTip:&r write a program that counts ore blocks by type: it's a quick way to check a deposit before setting up a mine."
	]
	quest.6CC389628C143887.title: "Chat Box and Player Detector"
	quest.6CC389628C143887.quest_subtitle: "Optional: a base that talks back"
	quest.6CC389628C143887.quest_desc: [
		"&eWhat:&r the Chat Box lets a computer send chat messages; the Player Detector tells it who is nearby."
		"&eHow:&r check JEI. Place them next to a computer."
		"&eTip:&r have the base warn everyone in chat when a tank of hydrogen is nearly full or an induction matrix is running low."
	]
	quest.41E9EE7CC03DE9F3.title: "Inventory Manager"
	quest.41E9EE7CC03DE9F3.quest_subtitle: "Optional: programs that use your inventory"
	quest.41E9EE7CC03DE9F3.quest_desc: [
		"&eWhat:&r the Inventory Manager lets a computer move items into and out of your own inventory, once you bind it with a Memory Card."
		"&eHow:&r right-click the Memory Card to bind it to yourself, then put it in the manager (check JEI)."
		"&eTip:&r a button that refills your hotbar with torches and food from storage is a classic first program."
	]
	quest.5B66E9C98951DF71.title: "Integrated Tunnels"
	quest.5B66E9C98951DF71.quest_subtitle: "Move items, fluids and energy with logic"
	quest.5B66E9C98951DF71.quest_desc: [
		"&eWhat:&r Integrated Tunnels adds importer, exporter and interface parts for Integrated Dynamics cables: items, fluids and energy move along the network, controlled by variables."
		"&eHow:&r craft an Item Importer and an Item Exporter (check JEI), put them on cables at a chest and a machine, and give the exporter a variable card that says what to move. Click the checkmark when it works."
		"&eTip:&r a fluid exporter with a boolean variable from a tank reader only fills the reactor when it's below half."
	]
	quest.132AB0ACC55773F4.title: "Integrated Terminals"
	quest.132AB0ACC55773F4.quest_subtitle: "Optional: a storage terminal for ID networks"
	quest.132AB0ACC55773F4.quest_desc: [
		"&eWhat:&r Integrated Terminals adds a Storage Terminal part that shows everything connected to an Integrated Dynamics network, plus a portable version."
		"&eHow:&r a Storage Terminal part between two crystalized menril chunks makes the portable terminal (check JEI)."
		"&eTip:&r the Crafting Job Terminal shows what Integrated Crafting is working on."
	]
	quest.698304026FBC82C1.title: "Integrated Crafting"
	quest.698304026FBC82C1.quest_subtitle: "Optional: autocrafting without AE2"
	quest.698304026FBC82C1.quest_desc: [
		"&eWhat:&r Integrated Crafting adds a Crafting Interface: give it recipe variables and it crafts on demand through the ID network, much like AE2 patterns."
		"&eHow:&r craft a Crafting Interface (check JEI), write recipes into variable cards with the Logic Programmer, and put them in the interface. Click the checkmark when one craft works."
		"&eTip:&r it's a cheaper autocrafter than AE2 for small chains, like rubber sheets or redstone batteries."
	]
	quest.648179C70EA53466.title: "Your First SFM Program"
	quest.648179C70EA53466.quest_subtitle: "Optional: four lines that move items"
	quest.648179C70EA53466.quest_desc: [
		"&eWhat:&r Super Factory Manager runs small text programs written on a disk. Labels name the blocks it talks to."
		"&eHow:&r label a chest &ea&r and a furnace &eb&r with the Label Gun, then write this program on the disk and put it in the manager. Click the checkmark when items start moving."
		"{@pagebreak}"
		"&eProgram:&r"
		"EVERY 20 TICKS DO"
		"    INPUT FROM a"
		"    OUTPUT TO b"
		"END"
		"&eTip:&r add a side, like &eOUTPUT TO b TOP SIDE&r, to choose which face of the block is used. The manager's built-in examples cover fluids and energy too."
	]
	quest.1F1E66B35278C2F3.title: "Menril Trees"
	quest.1F1E66B35278C2F3.quest_subtitle: "Blue-grey wood full of resin"
	quest.1F1E66B35278C2F3.quest_desc: [
		"&eWhat:&r Menril trees are where Integrated Dynamics starts: logs for resin, planks for building, and berries from the leaves."
		"&eChemistry:&r real tree resins are mixtures of terpenes, small hydrocarbons that plants make from units of isoprene (C₅H₈). Amber is resin that hardened over millions of years."
		"&eHow:&r find a Menril tree in the Overworld (Jade names it) and plant its saplings near your base."
		"&eTip:&r read the berries' tooltip before you eat a stack."
	]
	quest.64796471E388C36C.title: "Squeezer and Drying Basin"
	quest.64796471E388C36C.quest_subtitle: "Press the resin out, then dry it"
	quest.64796471E388C36C.quest_desc: [
		"&eWhat:&r the Squeezer presses Menril logs into liquid resin; the Drying Basin dries resin into crystalized Menril chunks."
		"&eChemistry:&r drying is evaporation: the solvent leaves and the dissolved resin is left as a solid, the same way salt is left behind when brine dries."
		"&eHow:&r Squeezer: an iron block, iron, planks and sticks. Drying Basin: logs, iron and black dye (check JEI). Put a Menril log in the Squeezer and jump on it a few times; pipe or bucket the resin into the basin and wait."
		"&eTip:&r place the Squeezer on top of the basin and the resin flows straight in."
	]
	quest.0B8712079F22304F.title: "Mechanical Squeezer and Basin"
	quest.0B8712079F22304F.quest_subtitle: "The same line, on power"
	quest.0B8712079F22304F.quest_desc: [
		"&eWhat:&r powered versions of the Squeezer and Drying Basin: faster, pipe-friendly and no jumping."
		"&eHow:&r the hand-powered block with Energy Batteries, a diamond and obsidian (check JEI). Feed them FE."
		"&eTip:&r they also squeeze and dry other things; press U on each in JEI."
	]
	quest.42F2E8F1D04D046D.title: "Generator and Energy Battery"
	quest.42F2E8F1D04D046D.quest_subtitle: "Power for a logic network"
	quest.42F2E8F1D04D046D.quest_desc: [
		"&eWhat:&r Integrated Dynamics' own Generator burns furnace fuel for FE; the Energy Battery stores it and can feed a network through its cables."
		"&eHow:&r the battery is crystalized Menril chunks and blocks around a redstone block; the Generator is a battery plus a furnace (check JEI)."
		"&eTip:&r any FE source works. Link a cable to your main grid instead if you have one."
	]
	quest.656CCB48225718F9.title: "The Manual and the Wrench"
	quest.656CCB48225718F9.quest_subtitle: "Read first, then rotate"
	quest.656CCB48225718F9.quest_desc: [
		"&eWhat:&r On the Dynamics of Integration is the mod's own guide, with worked examples. The Menril wrench rotates and removes ID blocks and parts."
		"&eHow:&r the book is a book and two crystalized Menril chunks; the wrench is Menril chunks and redstone (check JEI)."
		"&eTip:&r the manual's tutorials give rewards too. Do them once."
	]
	quest.4FFA7DD5BC94074C.title: "Variable Transformers"
	quest.4FFA7DD5BC94074C.quest_subtitle: "The parts inside every reader and writer"
	quest.4FFA7DD5BC94074C.quest_desc: [
		"&eWhat:&r input and output variable transformers are the crafting parts of readers, writers and interfaces. The Portable Logic Programmer is the programmer in your pocket."
		"&eHow:&r variable cards, Menril chunks and a sticky piston make four transformers (check JEI). Craft extra before a big build."
		"&eTip:&r carry the portable programmer while wiring up a factory, so you can fix a card on the spot."
	]
	quest.51734E649209B091.title: "LaserIO Toolkit"
	quest.51734E649209B091.quest_subtitle: "Wrench, logic chips and a connector"
	quest.51734E649209B091.quest_desc: [
		"&eWhat:&r the Laser Wrench links nodes (click one, then the other). Logic chips go into every node and card. A Laser Connector relays lasers between nodes without holding cards."
		"&eHow:&r raw logic chips are a quartz block, clay, gold nuggets and redstone (4 at a time); smelt them. The connector is glass, redstone, iron and a logic chip; the wrench is iron and a logic chip."
		"&eTip:&r nodes link up to a set range; connectors let you go round corners and through walls."
	]
	quest.54D4BBC0F664CD9C.title: "Energy and Redstone Cards"
	quest.54D4BBC0F664CD9C.quest_subtitle: "Power and signals by laser"
	quest.54D4BBC0F664CD9C.quest_desc: [
		"&eWhat:&r Energy Cards move FE between nodes; Redstone Cards read and send redstone signals along the laser network."
		"&eHow:&r a logic chip with quartz, gold nuggets and redstone (a redstone block for the energy card). Set Extract and Insert like any card."
		"&eTip:&r a Redstone Card can switch a separator on only while the sulfur chest has stock."
	]
	quest.13955ABB5B1AFAB1.title: "Card Holder, Cloner and Mod Filter"
	quest.13955ABB5B1AFAB1.quest_subtitle: "Keep your cards in order"
	quest.13955ABB5B1AFAB1.quest_desc: [
		"&eWhat:&r the Card Holder carries spare cards and fills nodes from your inventory; the Card Cloner copies one card's settings onto others; the Mod Filter matches everything from one mod."
		"&eHow:&r holder and cloner are a logic chip in iron with chests or paper; the Mod Filter is a basic filter plus a book (check JEI)."
		"&eTip:&r clone one tuned acid card to every reactor in the line."
	]
	quest.1BD7920FD8476E10.title: "Pipez for Everything"
	quest.1BD7920FD8476E10.quest_subtitle: "Fluids, power and Mekanism gases"
	quest.1BD7920FD8476E10.quest_desc: [
		"&eWhat:&r Pipez has a pipe for each thing that moves: fluids, FE, and Mekanism chemicals (the gas pipe)."
		"&eChemistry:&r one gas pipe network carries one chemical at a time well. Keep H₂ and Cl₂ apart: mixed, they react explosively in light (H₂ + Cl₂ → 2HCl)."
		"&eHow:&r iron and redstone with buckets (fluid), redstone blocks (energy) or Infused Alloy (gas), 16 at a time. Sneak-click where a pipe meets a machine to make that end extract."
		"&eTip:&r Pipez pipes pull only from ends you set to extract, so connecting a machine doesn't drain it."
	]
	quest.787F558E65CB4582.title: "Universal Pipe"
	quest.787F558E65CB4582.quest_subtitle: "One pipe, all four jobs"
	quest.787F558E65CB4582.quest_desc: [
		"&eWhat:&r the Universal Pipe carries several kinds of thing at once in one line (its tooltip lists which)."
		"&eHow:&r item, fluid and energy pipes with iron and a redstone block make six (check JEI)."
		"&eTip:&r set each side's mode per type in its GUI, so one pipe can feed a machine items and power together."
	]
	quest.0C721CC0F004F7C2.title: "Pipe Upgrades and Tools"
	quest.0C721CC0F004F7C2.quest_subtitle: "Faster pipes, targeted filters"
	quest.0C721CC0F004F7C2.quest_desc: [
		"&eWhat:&r the Pipe Wrench disconnects and reconnects pipe sides. The Filter Destination Tool aims a filter at one inventory. Upgrades (basic to infinity) raise speed and unlock filters and redstone modes."
		"&eHow:&r each upgrade tier is the one before plus better materials (advanced: an improved upgrade, diamonds and redstone blocks). The wrench is flint and rods; the tool is iron, glass and a button. Put upgrades in the extracting pipe end."
		"&eTip:&r an advanced upgrade's round-robin mode spreads ore evenly across a row of machines."
	]
	chapter.4F72E72B760CB007.title: "The Mechanical Age"
	chapter.4F72E72B760CB007.chapter_subtitle: [
		"Create: rotation, presses and mixers. An early mechanical age that runs alongside steam and feeds into Modern Industrialization."
	]
	quest.026C969E02786C1B.title: "Andesite Alloy"
	quest.026C969E02786C1B.quest_subtitle: "The frame of every early machine"
	quest.026C969E02786C1B.quest_desc: [
		"&6Gears and shafts. You remember a world that ran on clockwork, and you liked it.&r"
		"&eWhat:&r andesite alloy, Create's first building material."
		"&eHow:&r craft andesite with iron nuggets (zinc nuggets work too). Later a Mechanical Mixer makes it in bulk."
		"&eTip:&r hold &eW&r over almost any Create block to watch its Ponder tutorial."
	]
	quest.4075A74B2774D3BD.title: "Andesite Casing"
	quest.4075A74B2774D3BD.quest_subtitle: "Alloy pressed onto wood"
	quest.4075A74B2774D3BD.quest_desc: [
		"&eWhat:&r casing blocks are the shell for gearboxes, deployers and more."
		"&eHow:&r right-click a stripped log or stripped wood with andesite alloy. That's 'item application', and Create uses it a lot."
		"&eTip:&r strip logs with an axe first. Any wood type works."
	]
	quest.3B8CA867BEED2744.title: "Rotational Power"
	quest.3B8CA867BEED2744.quest_subtitle: "Create runs on rotation"
	quest.3B8CA867BEED2744.quest_desc: [
		"&eWhat:&r Create runs on rotation, not electricity. A water wheel on flowing water turns shafts and cogs."
		"&eHow:&r water must flow across the wheel's blades. Shafts carry rotation straight; cogwheels pass it sideways."
		"&eTip:&r every machine costs stress units (SU). If the network is over capacity, everything stops."
	]
	quest.730C4B4582649D81.title: "Gear Ratios"
	quest.730C4B4582649D81.quest_subtitle: "Big gear, small gear, double speed"
	quest.730C4B4582649D81.quest_desc: [
		"&eWhat:&r a large cogwheel meshed with a small one doubles the speed (or halves it the other way)."
		"&eChemistry:&r physics, really: power is torque times speed. Gearing trades one for the other, and Create shows the trade as stress: a machine's SU cost grows with its speed."
		"&eHow:&r a shaft and two planks make a large cogwheel. Place it diagonally next to a small one so the teeth mesh."
		"&eTip:&r run slow machines (like mixers you don't need fast) at low speed to save stress."
	]
	quest.744DE466E8633CF3.title: "Windmills"
	quest.744DE466E8633CF3.quest_subtitle: "More stress capacity, anywhere"
	quest.744DE466E8633CF3.quest_desc: [
		"&eWhat:&r a windmill bearing with sails attached spins without water."
		"&eHow:&r place the bearing, build at least 8 sails onto the front of it (the Ponder shows how), and right-click the bearing."
		"&eTip:&r more sails means more stress capacity but slower speed. Check the numbers with your goggles."
	]
	quest.182C584F79A9026F.title: "Gearboxes and Belts"
	quest.182C584F79A9026F.quest_subtitle: "Move rotation and items"
	quest.182C584F79A9026F.quest_desc: [
		"&eWhat:&r gearboxes turn rotation through corners; belts carry both rotation and items between two shafts."
		"&eHow:&r belts are made from dried kelp. Click one shaft with a belt, then the other, to link them."
		"&eTip:&r belts make great machine feeders: items ride past presses and fans on their own."
	]
	quest.34342A28CCEA9E01.title: "Pressing and Mixing"
	quest.34342A28CCEA9E01.quest_subtitle: "Plates and compacting"
	quest.34342A28CCEA9E01.quest_desc: [
		"&eWhat:&r the Mechanical Press flattens ingots into plates and compacts items in a basin."
		"&eHow:&r put the press over a depot, a belt or a basin, and power it."
		"&eTip:&r plates are shared with MI in this pack, so pressed plates work in MI recipes too."
	]
	quest.6616482D84CB76CA.title: "Heated Mixing"
	quest.6616482D84CB76CA.quest_subtitle: "Create's chemistry bench"
	quest.6616482D84CB76CA.quest_desc: [
		"&eWhat:&r a mixer over a basin, heated by a Blaze Burner, makes alloys and fluids."
		"&eChemistry:&r heat speeds up reactions and melts metals so they can mix into alloys."
		"&eHow:&r catch a blaze in an Empty Blaze Burner (iron plates around netherrack), put it under the basin, feed it fuel, and put the mixer above."
		"&eTip:&r feed the burner with a deployer or a mechanical arm so it never goes cold."
	]
	quest.77E50022B90D19F9.title: "Brass"
	quest.77E50022B90D19F9.quest_subtitle: "Copper plus zinc, mixed hot"
	quest.77E50022B90D19F9.quest_desc: [
		"&6A golden metal, mixed in a basin. The old skill comes back to your hands.&r"
		"&eWhat:&r brass, the key metal of Create's second age."
		"&eChemistry:&r brass is a copper-zinc alloy, usually about two-thirds copper. Zinc makes it harder and gives the gold colour."
		"&eHow:&r 1 copper + 1 zinc in a heated mixer gives 2 brass. Zinc ore generates in the world."
	]
	quest.1E61B3A6087F88B3.title: "Brass Casing"
	quest.1E61B3A6087F88B3.quest_subtitle: "The shell of smart machines"
	quest.1E61B3A6087F88B3.quest_desc: [
		"&eWhat:&r brass casing, for mechanical crafters, arms and brass tunnels."
		"&eHow:&r right-click a stripped log or stripped wood with a brass ingot."
		"&eTip:&r a deployer holding brass ingots can apply it automatically."
	]
	quest.77FA7755F842A8D2.title: "Precision"
	quest.77FA7755F842A8D2.quest_subtitle: "Your first sequenced assembly"
	quest.77FA7755F842A8D2.quest_desc: [
		"&6Each step in its place, every time. You used to build worlds this way.&r"
		"&eWhat:&r the precision mechanism, made by sequenced assembly: one item passes the same stations several times. Mechanical Crafters join into a big grid for recipes too large for a crafting table."
		"&eHow:&r start with a gold plate, then deploy a cogwheel, a large cogwheel and an iron nugget onto it, 5 loops. JEI shows the sequence. Crafters are an electron tube, brass casing and crafting table."
		"&eTip:&r some outputs are scrap. Sort them off the end of the belt and recycle them."
	]
	quest.0036FBB03BA5041E.title: "Hand Crank"
	quest.0036FBB03BA5041E.quest_subtitle: "Optional: rotation by muscle"
	quest.0036FBB03BA5041E.quest_desc: [
		"&eWhat:&r the simplest power source: you turn it yourself."
		"&eHow:&r three planks over an andesite alloy. Hold right-click on it to spin whatever it's attached to."
		"&eTip:&r handy for testing a contraption before you build a real generator for it."
	]
	quest.72C45775E3F11445.title: "Goggles and Wrench"
	quest.72C45775E3F11445.quest_subtitle: "See the stress"
	quest.72C45775E3F11445.quest_desc: [
		"&eWhat:&r Engineer's Goggles show speed and stress when you look at a machine; the wrench rotates and picks up Create blocks."
		"&eHow:&r wear the goggles in your helmet slot and look at a shaft or generator."
		"&eTip:&r sneak-right-click with the wrench to pick a block up instantly."
	]
	quest.337C8FD68BAD4AE5.title: "Gauges"
	quest.337C8FD68BAD4AE5.quest_subtitle: "Optional: dials for your network"
	quest.337C8FD68BAD4AE5.quest_desc: [
		"&eWhat:&r the Speedometer reads RPM; the Stressometer shows how much of your network's capacity is in use."
		"&eHow:&r a compass on an andesite casing makes the speedometer (check JEI for the stressometer). Put them inline on a shaft."
		"&eTip:&r both give a comparator signal, so a nearly full network can switch things off by redstone."
	]
	quest.6B18E15CBED2C58D.title: "Clutch and Gearshift"
	quest.6B18E15CBED2C58D.quest_subtitle: "Redstone control for rotation"
	quest.6B18E15CBED2C58D.quest_desc: [
		"&eWhat:&r a powered Clutch cuts the rotation passing through it; a powered Gearshift reverses it."
		"&eHow:&r andesite casing + redstone, with a shaft (clutch) or a cogwheel (gearshift)."
		"&eTip:&r a gearshift on a timer makes a piston or gantry go back and forth by itself."
	]
	quest.046177CACEBE5530.title: "Chain Drives"
	quest.046177CACEBE5530.quest_subtitle: "Optional: rotation along a chain"
	quest.046177CACEBE5530.quest_desc: [
		"&eWhat:&r encased chain drives pass rotation between each other in a line, in any direction, like a bike chain."
		"&eHow:&r an andesite casing and three iron nuggets. The Adjustable Chain Gearshift version changes speed with a redstone signal (check JEI)."
		"&eTip:&r a neat way to bring power up a wall without shafts sticking out."
	]
	quest.7784CD3C06844B0C.title: "Create Deco"
	quest.7784CD3C06844B0C.quest_subtitle: "Make the factory look like one"
	quest.7784CD3C06844B0C.quest_desc: [
		"&eWhat:&r catwalks, sheet metal, cage lamps and other industrial building blocks."
		"&eHow:&r check JEI for Create Deco recipes. Many use a press or the stonecutter."
		"&eTip:&r catwalks over your machine lines make maintenance much easier."
	]
	quest.054CDC887B5F6350.title: "Create: Connected"
	quest.054CDC887B5F6350.quest_subtitle: "Handy kinetic parts"
	quest.054CDC887B5F6350.quest_desc: [
		"&eWhat:&r Create: Connected adds small conveniences: compact gearboxes, a kinetic bridge that carries rotation across gaps, and more."
		"&eHow:&r check JEI for everything the mod adds."
		"&eTip:&r the kinetic bridge saves long runs of shafts."
	]
	quest.20EF956BB16A02B8.title: "Kinetic Battery"
	quest.20EF956BB16A02B8.quest_subtitle: "Optional: store rotation for later"
	quest.20EF956BB16A02B8.quest_desc: [
		"&eWhat:&r the Kinetic Battery charges from rotation and gives it back later, so a windmill's power isn't wasted when nothing is running."
		"&eHow:&r check JEI and its Ponder scene (hold W over it). Put it on a shaft line to charge it."
		"&eTip:&r a charged battery can be picked up and moved, like a wind-up spring."
	]
	quest.02C1134654884DCB.title: "Mechanical Bearing"
	quest.02C1134654884DCB.quest_subtitle: "Make blocks spin"
	quest.02C1134654884DCB.quest_desc: [
		"&eWhat:&r a bearing turns the blocks attached to its face into a moving 'contraption': doors, rotors, fans, ferris wheels."
		"&eHow:&r a wooden slab, an andesite casing and a shaft. Build onto its face, power it, and right-click to start."
		"&eTip:&r moving blocks keep working: a spinning contraption can carry drills, harvesters and seats."
	]
	quest.3FE2DEA03C20D896.title: "Clockwork Bearing"
	quest.3FE2DEA03C20D896.quest_subtitle: "Optional: a bearing that tells time"
	quest.3FE2DEA03C20D896.quest_desc: [
		"&eWhat:&r the Clockwork Bearing points its contraption at the current in-game time, like the hands of a clock."
		"&eHow:&r a wooden slab, a brass casing and an electron tube. Build an hour hand on it, and a second layer for the minute hand."
		"&eTip:&r a giant clock tower is a classic Create build."
	]
	quest.1BDD2ADB951FA49F.title: "Glue and Chassis"
	quest.1BDD2ADB951FA49F.quest_subtitle: "Tell a contraption what to carry"
	quest.1BDD2ADB951FA49F.quest_desc: [
		"&eWhat:&r Super Glue sticks blocks together so they move as one; chassis blocks grab whole rows and layers at once."
		"&eHow:&r super glue is slime, an iron plate and an iron nugget; drag it across a region to glue it. Linear chassis is alloy and logs."
		"&eTip:&r a slimeball on a chassis face makes it sticky. Check the Ponder for range settings."
	]
	quest.4C3093032BC73EDC.title: "Rope Pulley"
	quest.4C3093032BC73EDC.quest_subtitle: "Optional: lift things straight up"
	quest.4C3093032BC73EDC.quest_desc: [
		"&eWhat:&r the Rope Pulley lowers and raises a contraption on a rope, which makes a simple lift."
		"&eHow:&r an andesite casing, wool and an iron plate. Glue a platform under it and power it."
		"&eTip:&r the brass Elevator Pulley (check JEI) adds floor buttons and stops at contacts."
	]
	quest.7092808649B4419F.title: "Mechanical Piston"
	quest.7092808649B4419F.quest_subtitle: "Push a contraption in a line"
	quest.7092808649B4419F.quest_desc: [
		"&eWhat:&r a mechanical piston pushes and pulls glued blocks along a straight line, as far as its poles reach."
		"&eHow:&r a wooden slab, an andesite casing and an extension pole. Put poles behind the piston head; each pole adds one block of travel."
		"&eTip:&r rotation direction decides push or pull, so a gearshift reverses it."
	]
	quest.275774CB0C8D5DAA.title: "Drills and Harvesters"
	quest.275774CB0C8D5DAA.quest_subtitle: "Contraptions that do the work"
	quest.275774CB0C8D5DAA.quest_desc: [
		"&eWhat:&r a moving Drill breaks blocks in front of it; a Harvester picks crops and leaves the plant to regrow."
		"&eHow:&r both use andesite casing and alloy, with iron (drill) or iron plates (harvester). Mount them on a piston, bearing or gantry."
		"&eTip:&r a slow bearing with harvesters sweeping a round field is a cheap automatic farm."
	]
	quest.1C221C2CE7105C61.title: "Gantries"
	quest.1C221C2CE7105C61.quest_subtitle: "A carriage that rides a shaft"
	quest.1C221C2CE7105C61.quest_desc: [
		"&eWhat:&r a Gantry Carriage runs along a powered gantry shaft, carrying its contraption with it, with no length limit."
		"&eHow:&r gantry shafts are alloy and redstone; the carriage is a slab, a casing and a cogwheel. Power the shaft and the carriage moves."
		"&eTip:&r gantries can carry other gantries, which makes an X-Y frame for a big drill or quarry."
	]
	quest.5ACA2D213411E355.title: "Minecart Contraptions"
	quest.5ACA2D213411E355.quest_subtitle: "Contraptions on rails"
	quest.5ACA2D213411E355.quest_desc: [
		"&eWhat:&r a Cart Assembler on a rail turns a passing minecart and the blocks glued to it into a moving contraption."
		"&eHow:&r andesite alloy, redstone and logs. Place it as a rail, build on top, then send a minecart through with the assembler powered."
		"&eTip:&r a minecart contraption with a drill digs its own tunnel along the track."
	]
	quest.7393547E525DA47A.title: "Millstone"
	quest.7393547E525DA47A.quest_subtitle: "Slow and steady grinding"
	quest.7393547E525DA47A.quest_desc: [
		"&eWhat:&r the Millstone grinds cobblestone to gravel, wheat to flour, flowers to dye, bones to bone meal and more."
		"&eChemistry:&r grinding raises surface area: a powder reacts, dissolves and mixes much faster than a lump."
		"&eHow:&r a cogwheel, an andesite casing and stone. Power it from the side or below and drop items in on top."
		"&eTip:&r it doesn't take ores here. Ore crushing needs Crushing Wheels later."
	]
	quest.4D6920783F3B9DEF.title: "Mechanical Saw"
	quest.4D6920783F3B9DEF.quest_subtitle: "A stonecutter with a motor"
	quest.4D6920783F3B9DEF.quest_desc: [
		"&eWhat:&r a still saw over a belt cuts logs into planks and acts as a stonecutter; on a contraption it fells whole trees."
		"&eHow:&r iron plates, an iron ingot and an andesite casing. Set its target recipe with a filter if it has several."
		"&eTip:&r a row of saws on a bearing makes a tree farm that never misses a log."
	]
	quest.53010A1245136B9D.title: "Copper Casing"
	quest.53010A1245136B9D.quest_subtitle: "The shell for fluid machines"
	quest.53010A1245136B9D.quest_desc: [
		"&eWhat:&r copper casing is the base for spouts, item drains and hose pulleys."
		"&eHow:&r right-click a stripped log or stripped wood with a copper ingot."
		"&eTip:&r press a stack of copper sheets while you're at it. Pipes need them next."
	]
	quest.0436C53380018D12.title: "Pipes and Pumps"
	quest.0436C53380018D12.quest_subtitle: "Fluids go where you push them"
	quest.0436C53380018D12.quest_desc: [
		"&eWhat:&r fluid pipes carry liquids, but only while a Mechanical Pump pushes them along."
		"&eChemistry:&r a pump makes a pressure difference, and fluid always flows from high pressure to low."
		"&eHow:&r copper sheets around a copper ingot make 4 pipes; a pipe and a cogwheel make a pump. The arrow on the pump shows the flow direction."
		"&eTip:&r reverse the pump's rotation to reverse the flow."
	]
	quest.2D0EA05FF8E594C0.title: "Hose Pulley"
	quest.2D0EA05FF8E594C0.quest_subtitle: "Optional: drain or fill a lake"
	quest.2D0EA05FF8E594C0.quest_desc: [
		"&eWhat:&r the Hose Pulley lowers a hose into a pool and sucks the fluid up, or fills an area from your pipes."
		"&eHow:&r a copper casing, a dried kelp block and a copper plate. Power it and pipe its output away with a pump."
		"&eTip:&r a big enough body of water or lava counts as endless (check the Ponder), so it's a free fluid source."
	]
	quest.7DD9261D9EB35A40.title: "Bioethanol"
	quest.7DD9261D9EB35A40.quest_subtitle: "Optional: fuel from fermented plants"
	quest.7DD9261D9EB35A40.quest_desc: [
		"&eWhat:&r Crafts and Additions makes liquid fuel from plants: seed oil, then biomass, then bioethanol, which burns in a Liquid Blaze Burner."
		"&eChemistry:&r real bioethanol comes from yeast fermenting sugar: C₆H₁₂O₆ → 2 C₂H₅OH + 2 CO₂. Plant oils are triglycerides, long carbon chains that store a lot of energy."
		"&eHow:&r compact seeds in a press and basin for seed oil; mix crops with seed oil over heat for biomass; mix biomass, sugar and cinder flour for bioethanol (check JEI)."
		"&eTip:&r it's a renewable fuel for Create steam engines that never touches your oil wells."
	]
	quest.70CAEA0A4BE6690E.title: "Spout"
	quest.70CAEA0A4BE6690E.quest_subtitle: "Fill whatever passes underneath"
	quest.70CAEA0A4BE6690E.quest_desc: [
		"&eWhat:&r the Spout pours fluid into items below it on a depot or belt: water bottles, buckets, honey, lava cakes and more."
		"&eHow:&r a copper casing over dried kelp. Pipe fluid into it and put a depot underneath."
		"&eTip:&r spouts are a station in many sequenced assembly recipes, so you'll use them again."
	]
	quest.630D92ADDEA25362.title: "Item Drain"
	quest.630D92ADDEA25362.quest_subtitle: "Empty buckets on the way past"
	quest.630D92ADDEA25362.quest_desc: [
		"&eWhat:&r the Item Drain empties fluid containers that roll over it and holds the fluid for your pipes."
		"&eHow:&r iron bars over a copper casing. Put it in a belt line and pull the fluid out with a pump."
		"&eTip:&r it's the easy way to turn buckets from another mod into piped fluid."
	]
	quest.1E78E7EE6A500B30.title: "Steam Engines"
	quest.1E78E7EE6A500B30.quest_subtitle: "Fire, water and pistons"
	quest.1E78E7EE6A500B30.quest_desc: [
		"&eWhat:&r Create's boiler: a fluid tank full of water, heated by Blaze Burners, drives steam engines on its sides."
		"&eChemistry:&r water expands about 1,600 times when it boils. That pressure pushes the pistons."
		"&eHow:&r pump water into the tank, put fuelled Blaze Burners underneath, and place engines on its sides with a shaft in front. Check the Ponder."
		"&eTip:&r a bigger tank and more burners raise the boiler level. Goggles show what's limiting it."
	]
	quest.1651838BBC9A8F9A.title: "Blaze Cake"
	quest.1651838BBC9A8F9A.quest_subtitle: "Optional: superheat a burner"
	quest.1651838BBC9A8F9A.quest_desc: [
		"&eWhat:&r feeding a Blaze Cake to a burner makes it &esuperheated&r for a while, hotter than any normal fuel."
		"&eHow:&r compact an egg, sugar and cinder flour into a cake base, then spout 250 mB of lava into it."
		"&eTip:&r some recipes need superheat (New Age's blank circuits, for one). Check the heat icon in JEI."
	]
	quest.0A9697F091D66EBC.title: "Encased Fan"
	quest.0A9697F091D66EBC.quest_subtitle: "Air that cooks, washes and haunts"
	quest.0A9697F091D66EBC.quest_desc: [
		"&eWhat:&r an Encased Fan blows items along and processes them depending on what the air passes through."
		"&eHow:&r a shaft, an andesite casing and a propeller (iron plates around alloy). Water in front washes, fire smokes, lava blasts, soul fire haunts."
		"&eTip:&r items on a belt or depot in the air stream are processed; loose items on the ground are too."
	]
	quest.1E1DACF0E1734052.title: "Smoking and Blasting"
	quest.1E1DACF0E1734052.quest_subtitle: "A furnace with no fuel slot"
	quest.1E1DACF0E1734052.quest_desc: [
		"&eWhat:&r a fan blowing through fire or a campfire cooks food (smoking); through lava it smelts like a blast furnace (blasting)."
		"&eChemistry:&r hot air carries heat by convection, which is why a fan oven cooks faster than a still one."
		"&eHow:&r put a lit campfire or a lava source block a block or two in front of the fan and send items through the stream."
		"&eTip:&r one lava block never runs out, so bulk blasting costs nothing but rotation."
	]
	quest.58731C2AF70FC309.title: "Haunting"
	quest.58731C2AF70FC309.quest_subtitle: "Soul fire changes things"
	quest.58731C2AF70FC309.quest_desc: [
		"&eWhat:&r air blown through soul fire 'haunts' items: sand becomes soul sand, stone bricks infested, fungi swap Nether types."
		"&eHow:&r a soul campfire or soul fire in front of a fan. Pass sand through it for soul sand. JEI lists every haunting recipe."
		"&eTip:&r it's a renewable source of soul sand and soul soil, handy for Nether wart and soul torches."
	]
	quest.61B0B8A85B5A74B3.title: "Fan Catalysts"
	quest.61B0B8A85B5A74B3.quest_subtitle: "Optional: processing without the mess"
	quest.61B0B8A85B5A74B3.quest_desc: [
		"&eWhat:&r Create: Connected's fan catalysts hold the 'fire' or 'water' for a fan in one tidy block."
		"&eHow:&r brass and iron bars make the empty catalyst; fill it to pick its processing type (check JEI)."
		"&eTip:&r no more flowing water flooding your belt line."
	]
	quest.688CEE3263B8CCE8.title: "Depots"
	quest.688CEE3263B8CCE8.quest_subtitle: "A table for machines to work on"
	quest.688CEE3263B8CCE8.quest_desc: [
		"&eWhat:&r a Depot holds one stack of items for a press, fan, spout or deployer to work on."
		"&eHow:&r andesite alloy and an andesite casing. Right-click to put items on it."
		"&eTip:&r a depot under a press is the cheapest plate maker in the game."
	]
	quest.30511CA78664A015.title: "Funnels and Tunnels"
	quest.30511CA78664A015.quest_subtitle: "Items in, items out"
	quest.30511CA78664A015.quest_desc: [
		"&eWhat:&r funnels pull items out of chests and machines onto belts, or insert items from a belt; tunnels split a belt line evenly."
		"&eHow:&r andesite alloy over dried kelp makes 2 funnels. Place them on a chest face or at the end of a belt (check JEI for tunnels)."
		"&eTip:&r a redstone signal shuts a funnel off, which is an easy on/off switch."
	]
	quest.43ACD4F3446AA37E.title: "Weighted Ejector"
	quest.43ACD4F3446AA37E.quest_subtitle: "Optional: throw items across a gap"
	quest.43ACD4F3446AA37E.quest_desc: [
		"&eWhat:&r the Weighted Ejector flings items (or you) to a target block in an arc."
		"&eHow:&r a gold plate, a depot and a cogwheel. Hold it and click the target before you place it."
		"&eTip:&r stand on it for a free launch pad. The landing is your problem."
	]
	quest.5AA6A69C848DC1AA.title: "Chutes"
	quest.5AA6A69C848DC1AA.quest_subtitle: "Let gravity do the hauling"
	quest.5AA6A69C848DC1AA.quest_desc: [
		"&eWhat:&r chutes drop items straight down between machines and chests; a fan under or over one blows items upward."
		"&eHow:&r iron plates and an iron ingot make 4 chutes."
		"&eTip:&r a chute into a crushing wheel or basin is the simplest feeder there is."
	]
	quest.14B3C8ED4DC01638.title: "Item Vaults"
	quest.14B3C8ED4DC01638.quest_subtitle: "Storage that grows as you build"
	quest.14B3C8ED4DC01638.quest_desc: [
		"&eWhat:&r Item Vaults merge into one big storage block when placed together."
		"&eHow:&r iron plates around a barrel. Place several side by side; funnels and pipes reach the whole vault."
		"&eTip:&r vaults also go into frogports, so make a few extra."
	]
	quest.6A9EF93F22D557DE.title: "Smart Logistics"
	quest.6A9EF93F22D557DE.quest_subtitle: "Brass parts that read filters"
	quest.6A9EF93F22D557DE.quest_desc: [
		"&eWhat:&r brass funnels, tunnels and smart chutes take a filter, so you choose exactly which items pass and how many."
		"&eHow:&r each uses an electron tube and brass (check JEI). Put an item or a Create Filter in the slot on the block."
		"&eTip:&r a brass tunnel set to 'synchronise' only lets items through when every lane has one: perfect for 1:1 recipes."
	]
	quest.4C283EA530BC4A7F.title: "Cardboard"
	quest.4C283EA530BC4A7F.quest_subtitle: "Pulp, pressed flat"
	quest.4C283EA530BC4A7F.quest_desc: [
		"&eWhat:&r cardboard, for Create's package logistics."
		"&eChemistry:&r paper and card are mats of cellulose fibres; water lets the fibres bond as it dries, which is why pulp holds together."
		"&eHow:&r mix 4 pulpable items (like sticks or sugar cane; check JEI) with 250 mB of water for pulp, then press the pulp into cardboard."
	]
	quest.77A3B29A589655FD.title: "Packagers"
	quest.77A3B29A589655FD.quest_subtitle: "Box it up, send it off"
	quest.77A3B29A589655FD.quest_desc: [
		"&eWhat:&r a Packager boxes items from the inventory behind it into a package with an address, or unpacks packages addressed to it."
		"&eHow:&r a cardboard block, iron ingots and redstone. Put a sign or name on it for its address (see the Ponder)."
		"&eTip:&r packages ride belts, chutes and chain conveyors like any other item."
	]
	quest.2A2D28D70DFF0880.title: "Frogports and Chains"
	quest.2A2D28D70DFF0880.quest_subtitle: "A frog that catches your mail"
	quest.2A2D28D70DFF0880.quest_desc: [
		"&eWhat:&r chain conveyors carry packages through the air; a Package Frogport tongues them off the chain at the right stop."
		"&eHow:&r a frogport is a slimeball, an item vault and andesite alloy; a chain conveyor is a large cogwheel in andesite casings. Link chains with iron chains."
		"&eTip:&r a chain network with frogports at each base is a whole-base mail system."
	]
	quest.049C8A27289976E8.title: "Stock Keeping"
	quest.049C8A27289976E8.quest_subtitle: "Order from a counter"
	quest.049C8A27289976E8.quest_desc: [
		"&eWhat:&r a Stock Link reports what a packager can reach; a Stock Ticker lets you browse that stock and order items to be packed and sent."
		"&eHow:&r a transmitter (lightning rod, copper plates, redstone) on an item vault makes the link; add glass and gold for the ticker."
		"&eTip:&r put the ticker by your workbench and order ingredients without walking to storage."
	]
	quest.05EBFEF4A4AA72FE.title: "Factory Gauges"
	quest.05EBFEF4A4AA72FE.quest_subtitle: "Optional: production on demand"
	quest.05EBFEF4A4AA72FE.quest_desc: [
		"&eWhat:&r Factory Gauges watch your stock and request ingredients for a recipe whenever a target amount runs low."
		"&eHow:&r a stock link and a precision mechanism make 2. Place them on a packager and link them in their panel (see the Ponder)."
		"&eTip:&r chain gauges together and one order can run a whole production line."
	]
	quest.37C0C525864C5286.title: "Rose Quartz"
	quest.37C0C525864C5286.quest_subtitle: "Quartz soaked in redstone"
	quest.37C0C525864C5286.quest_desc: [
		"&eWhat:&r rose quartz, for electron tubes."
		"&eHow:&r craft 1 Nether quartz with 8 redstone, then polish it: hold sandpaper with the rose quartz in your off-hand and use it (a deployer can do this too)."
		"&eTip:&r washing crushed iron makes redstone as a byproduct, so a later ore line can feed this."
	]
	quest.0182206067908BB0.title: "Electron Tubes"
	quest.0182206067908BB0.quest_subtitle: "Create's 'smart' component"
	quest.0182206067908BB0.quest_desc: [
		"&eWhat:&r electron tubes go into deployers, mechanical crafters and other smart machines."
		"&eHow:&r polished rose quartz on top of an iron plate."
		"&eTip:&r make a stack. You'll need more than you think."
	]
	quest.28E8E77EF5C671EB.title: "Deployers"
	quest.28E8E77EF5C671EB.quest_subtitle: "A hand that uses items"
	quest.28E8E77EF5C671EB.quest_desc: [
		"&eWhat:&r a deployer acts like a player's hand: it places, uses and applies items."
		"&eHow:&r an andesite casing, an electron tube and a brass hand (pressed brass sheets)."
		"&eTip:&r deployers over a belt are how Create builds things in steps: that's sequenced assembly."
	]
	quest.5191CA10F7F0E39F.title: "Mechanical Arm"
	quest.5191CA10F7F0E39F.quest_subtitle: "Pick up here, put down there"
	quest.5191CA10F7F0E39F.quest_desc: [
		"&eWhat:&r the mechanical arm moves items between depots, belts, basins and machines in its reach."
		"&eHow:&r hold the arm and click inputs and outputs before you place it. Check the Ponder."
		"&eTip:&r one arm can feed a whole ring of depots around it."
	]
	quest.58DA1F2D41B82800.title: "Speed Controller"
	quest.58DA1F2D41B82800.quest_subtitle: "Optional: dial in the exact RPM"
	quest.58DA1F2D41B82800.quest_desc: [
		"&eWhat:&r the Rotation Speed Controller sets the speed of the cogwheel on top of it to any RPM you choose."
		"&eHow:&r a precision mechanism over a brass casing. Power it from below and set the speed on its face."
		"&eTip:&r faster costs more stress, so only speed up what needs it."
	]
	quest.6629EEE3B93734E8.title: "Crushing Wheels"
	quest.6629EEE3B93734E8.quest_subtitle: "Ore into crushed ore"
	quest.6629EEE3B93734E8.quest_desc: [
		"&eWhat:&r two Crushing Wheels spinning toward each other grind ore blocks into crushed ore, obsidian into powder, and stone into gravel and sand."
		"&eHow:&r each wheel is a mechanical crafting recipe (check JEI). Place them side by side, spin them inward, and drop items in from above."
		"&eHow:&r yields: an ore block gives 1 crushed ore plus a 75% chance of a second; deepslate and modded ores are &ecapped at 2&r in this pack. Raw ore gives just 1 crushed ore (no gain), plus an XP nugget chance."
		"&eTip:&r crush ore blocks (silk touch), not raw ore. Even so it's the same 2x ceiling as every route before acids; Mekanism's acid chain is where 3x and up begins."
	]
	quest.16A9DFC1FA028ABC.title: "Bulk Washing"
	quest.16A9DFC1FA028ABC.quest_subtitle: "Water, a fan and a bonus"
	quest.16A9DFC1FA028ABC.quest_desc: [
		"&eWhat:&r an encased fan blowing through water washes crushed ore into nuggets plus a byproduct."
		"&eHow:&r put flowing water in front of the fan and pass items through the air stream (a belt works)."
		"&eTip:&r washed crushed iron gives 9 nuggets (one ingot's worth) and a 75% chance of redstone. The byproduct is the bonus, not extra iron."
	]
	quest.5AE74064D976F177.title: "Sturdy Sheets"
	quest.5AE74064D976F177.quest_subtitle: "Obsidian, lava and two presses"
	quest.5AE74064D976F177.quest_desc: [
		"&eWhat:&r sturdy sheets, the armour plate for train casings and schedules."
		"&eChemistry:&r obsidian is volcanic glass: lava cooled so fast that its silica never formed crystals."
		"&eHow:&r crush obsidian into powder, then a sequenced assembly: spout 500 mB of lava onto it, press, press. JEI shows the loop."
		"&eTip:&r the crushing wheels give the obsidian back 75% of the time, so feed it in until it's all powder."
	]
	quest.608E9C45084DDC0B.title: "Train Casing"
	quest.608E9C45084DDC0B.quest_subtitle: "The body of every train"
	quest.608E9C45084DDC0B.quest_desc: [
		"&eWhat:&r train casing is the base block for stations, controls, signals and bogeys."
		"&eHow:&r right-click a brass casing with a sturdy sheet."
		"&eTip:&r right-clicking a track with train casing places a bogey: the wheels your train sits on."
	]
	quest.2DD7DD7E4EBAC4C3.title: "Train Track"
	quest.2DD7DD7E4EBAC4C3.quest_subtitle: "Sleepers, nuggets, a press"
	quest.2DD7DD7E4EBAC4C3.quest_desc: [
		"&eWhat:&r Create's train track, which can curve, slope and cross."
		"&eHow:&r sequenced assembly on stone slabs (the 'sleepers'): deploy an iron or zinc nugget, deploy another, then press. Check JEI."
		"&eTip:&r click one track end, then another, to lay a curve or slope between them."
	]
	quest.14F0FB6C383BA061.title: "Stations and Controls"
	quest.14F0FB6C383BA061.quest_subtitle: "Where trains are born"
	quest.14F0FB6C383BA061.quest_desc: [
		"&eWhat:&r a Train Station assembles a train from the casing, bogeys and blocks on the track beside it; Train Controls let you drive it."
		"&eHow:&r a station is train casing and a compass; controls are a lever, train casing and a precision mechanism."
		"&eTip:&r stand at the station's GUI and press assemble once the controls face the way you want to go."
	]
	quest.6C250F7008A406FF.title: "Your First Train"
	quest.6C250F7008A406FF.quest_subtitle: "A schedule and somewhere to go"
	quest.6C250F7008A406FF.quest_desc: [
		"&6A machine that carries itself across the world. You used to move whole mountains like this.&r"
		"&eWhat:&r a Train Schedule tells a train where to stop and when to leave, so it runs by itself."
		"&eHow:&r a sturdy sheet and paper make 4. Write stops in it and give it to the conductor (a mob in a seat behind the controls)."
		"&eTip:&r a train with portable storage interfaces at each station moves ore and goods on its own."
	]
	quest.64021CBAE89E85B8.title: "Signals"
	quest.64021CBAE89E85B8.quest_subtitle: "Optional: more than one train"
	quest.64021CBAE89E85B8.quest_desc: [
		"&eWhat:&r signals split a line into sections so two trains never share one. Real railways use the same 'block' idea."
		"&eHow:&r train casing and an electron tube make 4. Place them on the track at each junction."
		"&eTip:&r check the Ponder for chain signals at crossings."
	]
	quest.79D324D3D42641AD.title: "Rotation to Electricity"
	quest.79D324D3D42641AD.quest_subtitle: "Spin a shaft, get FE"
	quest.79D324D3D42641AD.quest_desc: [
		"&eWhat:&r Crafts and Additions' Alternator turns rotation into FE."
		"&eChemistry:&r a coil turning in a magnetic field pushes electrons along the wire: electromagnetic induction."
		"&eHow:&r in this pack its core is an &eMI analog circuit&r (LV), so electricity from rotation waits for the LV age. Feed it fast rotation."
	]
	quest.2B4C4B280D8E7AC8.title: "Electricity to Rotation"
	quest.2B4C4B280D8E7AC8.quest_subtitle: "Run contraptions off the grid"
	quest.2B4C4B280D8E7AC8.quest_desc: [
		"&eWhat:&r the Electric Motor turns FE back into rotation, with a speed you set."
		"&eHow:&r give it FE from your MI or Mekanism grid and set the speed in its GUI."
		"&eTip:&r motors free you from water wheels and windmills. Put a Create line anywhere."
	]
	quest.53AD12F81CBB1F0A.title: "Wires and Connectors"
	quest.53AD12F81CBB1F0A.quest_subtitle: "Overhead power lines"
	quest.53AD12F81CBB1F0A.quest_desc: [
		"&eWhat:&r the Rolling Mill turns ingots into rods and plates into wire. Spools of wire link connectors into power lines."
		"&eHow:&r roll copper plates into wire, wind it onto a spool, then click two connectors with the spool to string a wire."
		"&eTip:&r connectors carry power over long gaps without cables on the ground."
	]
	quest.07D97B34A6E5B266.title: "Accumulators"
	quest.07D97B34A6E5B266.quest_subtitle: "Store FE in brass and capacitors"
	quest.07D97B34A6E5B266.quest_desc: [
		"&eWhat:&r the Modular Accumulator stores FE, and several placed together merge into one bigger battery."
		"&eChemistry:&r the capacitor here is zinc over copper, the same pair Volta used in the first battery in 1800."
		"&eHow:&r needs brass casing, capacitors, copper rods and electrum wire. Electrum is gold + silver mixed hot."
		"&eTip:&r put it between your alternators and your machines to smooth out spikes."
	]
	quest.24FF50E20F1EA5BC.title: "Tesla Coil"
	quest.24FF50E20F1EA5BC.quest_subtitle: "Optional: charge items with lightning"
	quest.24FF50E20F1EA5BC.quest_desc: [
		"&eWhat:&r the Tesla Coil charges FE items on belts or depots below it, and zaps anything that walks under it."
		"&eHow:&r a mechanical crafting recipe with brass, a capacitor, electron tubes and a copper spool (check JEI). Power it with FE."
		"&eTip:&r put a belt of jetpacks or gadgets under it for an automatic charging station."
	]
	quest.4B937C395BAB0201.title: "Create: New Age"
	quest.4B937C395BAB0201.quest_subtitle: "Magnets, coils and energisers"
	quest.4B937C395BAB0201.quest_desc: [
		"&eWhat:&r magnet-and-coil generators, and Energisers that charge items with electricity."
		"&eHow:&r the Generator Coil's core is an &eMI analog circuit&r (LV) in this pack. Spin it among magnets; the Ponder shows the layout."
		"&eTip:&r the Basic Energiser is just an andesite casing and a lightning rod."
	]
	quest.52C094F29194B559.title: "New Age Motors"
	quest.52C094F29194B559.quest_subtitle: "Optional: FE in, rotation out"
	quest.52C094F29194B559.quest_desc: [
		"&eWhat:&r New Age's Basic Motor runs on FE and spins a shaft; carbon brushes and motor extensions tune it."
		"&eChemistry:&r a motor is a generator run backwards: current in a coil inside a magnetic field feels a force and turns."
		"&eHow:&r an andesite casing, a magnetite block, a shaft and iron nuggets (check JEI for magnetite). Brushes are alloy, coal and a shaft."
	]
	quest.4751D19651EF6413.title: "Heat Engines"
	quest.4751D19651EF6413.quest_subtitle: "Optional: rotation from sunlight and heat"
	quest.4751D19651EF6413.quest_desc: [
		"&eWhat:&r New Age moves heat through heat pipes. Solar heating plates collect it from sunlight; a Stirling Engine turns it into slow rotation, and a Boiler Heater uses it in place of a blaze burner."
		"&eChemistry:&r a real Stirling engine heats and cools a sealed gas. Hot gas expands and pushes a piston; cooled gas contracts and pulls it back. No fuel burns inside it."
		"&eHow:&r heat pipes, iron and glass for the plate; a copper block, heat pipes and a shaft for the engine (check JEI and the Ponder scenes)."
	]
	quest.55B52C24164AD4E0.title: "Charging Metal"
	quest.55B52C24164AD4E0.quest_subtitle: "Iron soaked in electricity"
	quest.55B52C24164AD4E0.quest_desc: [
		"&eWhat:&r overcharged iron, made by charging an iron ingot in an Energiser."
		"&eHow:&r power the Energiser with FE and put iron underneath it (on a depot or belt). Each ingot takes 1,000 FE."
		"&eTip:&r overcharged metals make better wire and magnets."
	]
	quest.7FEB4F6BF2712680.title: "New Age Circuits"
	quest.7FEB4F6BF2712680.quest_subtitle: "Optional: superheated circuit boards"
	quest.7FEB4F6BF2712680.quest_desc: [
		"&eWhat:&r New Age's own circuit boards, used in its better machines (check JEI for uses)."
		"&eChemistry:&r real boards are an insulating base with copper traces; here quartz, stone, iron and redstone fuse into the base."
		"&eHow:&r compact stone, redstone, iron and quartz over a &esuperheated&r burner (blaze cake) for 4 blanks, then deploy copper wire onto one."
	]
	quest.24AA4CAED5C9CBF5.title: "Layered Magnets"
	quest.24AA4CAED5C9CBF5.quest_subtitle: "Stronger fields, more power"
	quest.24AA4CAED5C9CBF5.quest_desc: [
		"&eWhat:&r stronger magnets for New Age generators."
		"&eHow:&r overcharged iron and overcharged gold in layers (check JEI)."
		"&eTip:&r a stronger field induces more current in the same coil."
	]
	quest.4A4E6C320C2A7399.title: "Thorium Reactor"
	quest.4A4E6C320C2A7399.quest_subtitle: "New Age goes nuclear"
	quest.4A4E6C320C2A7399.quest_desc: [
		"&eWhat:&r New Age's nuclear reactor, fuelled by &ethorium&r."
		"&eChemistry:&r thorium-232 isn't fissile itself; it absorbs a neutron and becomes uranium-233, which is."
		"&eHow:&r the rods need &eMI processing units&r (EV) in this pack, so it arrives alongside Mekanism fission. Check JEI and the Ponder for the build."
		"&eTip:&r treat it like any reactor: cooling first, then power."
	]
	quest.07E1E573A3B65309.title: "Liquid Experience"
	quest.07E1E573A3B65309.quest_subtitle: "XP you can pipe"
	quest.07E1E573A3B65309.quest_desc: [
		"&eWhat:&r Enchantment Industry turns experience into a fluid you can store and pipe."
		"&eHow:&r the Mechanical Grindstone strips enchantments off items; a Grindstone Drain collects the XP as fluid. Check JEI."
		"&eTip:&r feed it the enchanted junk from your mob farm."
	]
	quest.22860F179A18DF0F.title: "Automated Enchanting"
	quest.22860F179A18DF0F.quest_subtitle: "A blaze that reads spellbooks"
	quest.22860F179A18DF0F.quest_desc: [
		"&eWhat:&r the Blaze Enchanter spends liquid XP to enchant items automatically."
		"&eHow:&r it's a smithing upgrade of a Blaze Burner with an enchanting table (check JEI). Give it an enchanting template and XP."
		"&eTip:&r put it beside a belt and a deployer for a hands-free enchanting line."
	]
	quest.57619AFCA4F05DA0.title: "The Printer"
	quest.57619AFCA4F05DA0.quest_subtitle: "Copy books with XP"
	quest.57619AFCA4F05DA0.quest_desc: [
		"&eWhat:&r the Printer copies written and enchanted books, paid for in liquid XP."
		"&eHow:&r check JEI and the Ponder for the setup."
		"&eTip:&r find a good enchanted book once, then print it as often as your XP lasts."
	]
	quest.14BCCEEAD81D18E7.title: "Experience Lantern"
	quest.14BCCEEAD81D18E7.quest_subtitle: "Optional: collect XP as it drops"
	quest.14BCCEEAD81D18E7.quest_desc: [
		"&eWhat:&r the Experience Lantern pulls nearby experience orbs in and stores them as liquid XP."
		"&eHow:&r check JEI for the recipe. Hang it over a mob farm's kill zone and pipe its XP away."
		"&eTip:&r pair it with the Blaze Enchanter and your farm pays for its own enchanting."
	]
	quest.55AB70C3F4CCB36F.title: "Large Water Wheel"
	quest.55AB70C3F4CCB36F.quest_subtitle: "Slower, but far stronger"
	quest.55AB70C3F4CCB36F.quest_desc: [
		"&eWhat:&r a 3x3 water wheel. It turns at half the speed of the small one but gives more stress capacity in total (check with goggles)."
		"&eChemistry:&r physics again: a bigger wheel catches the flow further from its axle, so the same water gives more torque."
		"&eHow:&r a water wheel ringed with planks. Give it flowing water across the whole face."
		"&eTip:&r follow it with a large cogwheel to get the speed back."
	]
	quest.2A991699F562C061.title: "Fine Rotation Control"
	quest.2A991699F562C061.quest_subtitle: "Turn corners, change speed, run a sequence"
	quest.2A991699F562C061.quest_desc: [
		"&eWhat:&r the Vertical Gearbox passes rotation up and down; the Adjustable Chain Gearshift changes its speed ratio with the strength of a redstone signal; the Sequenced Gearshift runs a programmed list of turns, waits and reversals."
		"&eHow:&r vertical gearbox: a gearbox in the crafting grid. The other two add an electron tube to a chain drive or to brass casing and a cogwheel (check JEI)."
		"&eTip:&r a sequenced gearshift on a piston makes a door that opens, waits and closes on one pulse."
	]
	quest.5AE7EF121BD612F0.title: "Spare Burners"
	quest.5AE7EF121BD612F0.quest_subtitle: "More burners, and the cake base"
	quest.5AE7EF121BD612F0.quest_desc: [
		"&eWhat:&r empty Blaze Burners to catch more blazes, and a Blaze Cake base ready to fill with lava."
		"&eChemistry:&r a superheated burner runs hotter because the cake gives it richer fuel; as a rule of thumb, many reactions run about twice as fast for every 10 °C hotter."
		"&eHow:&r burners are iron plates around netherrack; right-click a blaze with one, or use it on a monster spawner. The cake base is compacted egg, sugar and cinder flour (check JEI)."
		"&eTip:&r a big steam boiler wants nine or more burners. Catch them early."
	]
	quest.0CA5A69F3DDE9CA2.title: "Valves and Smart Pipes"
	quest.0CA5A69F3DDE9CA2.quest_subtitle: "Open, close and filter a fluid line"
	quest.0CA5A69F3DDE9CA2.quest_desc: [
		"&eWhat:&r a Fluid Valve opens or closes a pipe when rotation turns it (a valve handle turns it by hand); a Smart Fluid Pipe lets only the fluid you set pass."
		"&eChemistry:&r chemical plants are mostly valves: the right reagent, in the right amount, at the right moment."
		"&eHow:&r valve: an iron plate and a pipe. Handle: copper plates on andesite alloy. Smart pipe: a pipe with a brass plate and an electron tube (check JEI)."
		"&eTip:&r a smart pipe after a mixer stops the wrong fluid backing up the line."
	]
	quest.37A5960612C5F1E9.title: "Nozzle"
	quest.37A5960612C5F1E9.quest_subtitle: "Spread a fan's effect in a circle"
	quest.37A5960612C5F1E9.quest_desc: [
		"&eWhat:&r a Nozzle on the front of an Encased Fan spreads its air all around instead of in a line, and pushes or pulls mobs in range."
		"&eHow:&r andesite alloy and wool (check JEI)."
		"&eTip:&r a fan, a nozzle and a fire behind it make a warm room. A water source behind it, a mob wash."
	]
	quest.5979E1A0A4E0A3FF.title: "Plough and Radial Chassis"
	quest.5979E1A0A4E0A3FF.quest_subtitle: "Till fields, grab whole rings"
	quest.5979E1A0A4E0A3FF.quest_desc: [
		"&eWhat:&r the Mechanical Plough tills dirt and breaks small blocks as a contraption moves; Radial Chassis grabs blocks around it in a ring, for bearing contraptions."
		"&eHow:&r plough: iron plates, andesite alloy and a casing. Radial chassis: logs and andesite alloy, three at a time (check JEI)."
		"&eTip:&r a plough leading a row of harvesters and seed deployers is a field that farms itself."
	]
	quest.0C4EDC1CF83CA395.title: "Portable Interfaces"
	quest.0C4EDC1CF83CA395.quest_subtitle: "Load a moving contraption"
	quest.0C4EDC1CF83CA395.quest_desc: [
		"&eWhat:&r a pair of Portable Storage (or Fluid) Interfaces, one on the contraption and one on the ground, swap items or fluids whenever they line up."
		"&eHow:&r an andesite casing (items) or copper casing (fluids) with a chute (check JEI)."
		"&eTip:&r a train with fluid interfaces can haul acid from a remote plant without a single pipe."
	]
	quest.5ABFE1AA0F7D2878.title: "Take a Seat"
	quest.5ABFE1AA0F7D2878.quest_subtitle: "Somewhere to sit, and a seat for a conductor"
	quest.5ABFE1AA0F7D2878.quest_desc: [
		"&eWhat:&r Create seats. You can sit on them, mobs sit on them, and a seated mob (or you) is what drives a train or moving contraption."
		"&eHow:&r a wooden slab and wool of any colour. Dye one seat to recolour it."
		"&eTip:&r a villager in a seat behind train controls becomes your conductor."
	]
	quest.27B65A1388E16EA7.title: "Display Links and Nixie Tubes"
	quest.27B65A1388E16EA7.quest_subtitle: "Put your numbers on the wall"
	quest.27B65A1388E16EA7.quest_desc: [
		"&eWhat:&r a Display Link reads a block (a stockpile, a tank, a station, a speedometer) and writes it onto Nixie Tubes, signs or display boards."
		"&eHow:&r a transmitter on brass casing makes the link; two electron tubes make four nixie tubes (check JEI)."
		"&eTip:&r link a tank of seed oil to a nixie row and you'll see the level from across the room."
	]
	quest.4DEB762041D07FF5.title: "Re-Packager"
	quest.4DEB762041D07FF5.quest_subtitle: "Merge and split packages"
	quest.4DEB762041D07FF5.quest_desc: [
		"&eWhat:&r a Re-Packager opens incoming packages and repacks their contents, so a recipe's ingredients arrive at a machine in one box."
		"&eHow:&r a Packager converted in the crafting grid (check JEI)."
		"&eTip:&r use it in front of a mechanical crafter that needs many different items at once."
	]
	quest.4CF901DAE3949FBB.title: "Train Fittings"
	quest.4CF901DAE3949FBB.quest_subtitle: "Doors that stay shut, and a track sensor"
	quest.4CF901DAE3949FBB.quest_desc: [
		"&eWhat:&r Train Doors and Trapdoors open only when the train is stopped at a station. A Train Observer gives a redstone signal when a train passes over it."
		"&eHow:&r a wooden door or trapdoor with train casing; the observer is train casing and a pressure plate (check JEI)."
		"&eTip:&r a train observer before a station can open a loading gate in time."
	]
	chapter.102A36D87D384450.title: "Just Dire Things"
	chapter.102A36D87D384450.chapter_subtitle: [
		"Living goo that rewrites the blocks it touches: new metals, denser coal, refined fuels, upgradeable tools and small automation machines."
	]
	quest.2232B59A6FDB6BB1.title: "Feeding the Goo"
	quest.2232B59A6FDB6BB1.quest_subtitle: "Goo converts the blocks around it"
	quest.2232B59A6FDB6BB1.quest_desc: [
		"&6You remember making things change just by touching them. The goo still can; you'll borrow the trick.&r"
		"&eWhat:&r goo blocks slowly convert the blocks touching them. Tier 1 (Primogel) turns iron blocks into raw ferricore ore."
		"&eHow:&r place the goo, put iron blocks against its sides and wait. JEI's Goo Spreading tab lists every conversion, its tier and its time."
		"&eTip:&r after a conversion the goo can die (a 10% chance in this pack's config). Right-click exhausted Primogel with sugar or rotten flesh to wake it."
	]
	quest.12DFAC850D78DC82.title: "Raw Ferricore"
	quest.12DFAC850D78DC82.quest_subtitle: "Mine what the goo made"
	quest.12DFAC850D78DC82.quest_desc: [
		"&eWhat:&r raw ferricore ore drops raw ferricore. Smelt or blast it into ferricore ingots, the base of everything on this page."
		"&eHow:&r mine the converted block with a pickaxe. Silk Touch gives you the ore block itself instead."
		"&eTip:&r one iron block (9 ingots) becomes one raw ferricore, so let a Create or MI line feed the goo once you need a lot."
	]
	quest.712073365D239874.title: "Upgrade Blanks"
	quest.712073365D239874.quest_subtitle: "Four ferricore ingots, one empty upgrade"
	quest.712073365D239874.quest_desc: [
		"&eWhat:&r every Just Dire Things upgrade and smithing template starts from a blank."
		"&eHow:&r four ferricore ingots in a diamond shape (check JEI)."
		"&eTip:&r keep a stack around; most upgrades are a blank plus a few vanilla items."
	]
	quest.46FFCEA3F055D97B.title: "Blazebloom and Blazegold"
	quest.46FFCEA3F055D97B.quest_subtitle: "Tier 2 goo turns gold into blazegold"
	quest.46FFCEA3F055D97B.quest_desc: [
		"&eWhat:&r Blazebloom goo (tier 2) converts gold blocks into raw blazegold ore. Blazegold opens the second tier of tools and machines."
		"&eHow:&r tier 1 goo ringed with blaze powder, redstone and Nether wart (check JEI). Smelt the raw blazegold."
		"&eChemistry:&r real gold is famously unreactive: it doesn't tarnish in air because Au has a very high reduction potential (+1.50 V)."
		"&eTip:&r feed exhausted Blazebloom Nether wart or blaze powder."
	]
	quest.55300B4F8479D90F.title: "VoidShimmer and Celestigem"
	quest.55300B4F8479D90F.quest_subtitle: "Tier 3 goo turns diamond into a gem"
	quest.55300B4F8479D90F.quest_desc: [
		"&eWhat:&r VoidShimmer goo (tier 3) turns diamond blocks into celestigem ore, which drops celestigem directly. Advanced machines and the third tool tier use it."
		"&eHow:&r tier 2 goo ringed with ender pearls, end stone and dragon's breath (check JEI). A diamond conversion takes twice as long as iron or gold."
		"&eChemistry:&r diamond is pure carbon: every atom bonds to four neighbours in a tetrahedral (sp³) lattice, which is why it's so hard."
		"&eTip:&r VoidShimmer revives with chorus fruit or an ender pearl."
	]
	quest.5CF448724AF2D37A.title: "Shadowpulse and Eclipse Alloy"
	quest.5CF448724AF2D37A.quest_subtitle: "Tier 4 goo eats a netherite block"
	quest.5CF448724AF2D37A.quest_desc: [
		"&6The goo has learned to eat the hardest thing you own. You remember being that hungry.&r"
		"&eWhat:&r Shadowpulse goo (tier 4) turns netherite blocks into raw eclipse alloy ore, Just Dire Things' top material."
		"&eHow:&r tier 3 goo ringed with sculk, sculk shriekers and echo shards from an Ancient City (check JEI). Smelt the raw eclipse alloy."
		"&eTip:&r one netherite block is a big price. Plan which eclipse alloy item you want first; Shadowpulse revives with sculk or a sculk catalyst."
	]
	quest.3DA60895E31143A1.title: "Primal Coal"
	quest.3DA60895E31143A1.quest_subtitle: "Goo squeezes a coal block denser"
	quest.3DA60895E31143A1.quest_desc: [
		"&eWhat:&r tier 1 goo turns a coal block (or a charcoal block) into Primal Coal ore. Primal Coal burns for 4,800 ticks, three times a piece of coal."
		"&eChemistry:&r real coal ranks up with heat and pressure: lignite (~65% carbon) → bituminous (~80%) → anthracite (>90%). More carbon, more energy per kilogram."
		"&eHow:&r place coal or charcoal blocks against tier 1 goo and mine the ore (it drops several pieces)."
		"&eTip:&r nine Primal Coal make a block, and that block is the input for the next tier."
	]
	quest.29770C92488D544F.title: "Blaze Ember"
	quest.29770C92488D544F.quest_subtitle: "The second coal tier"
	quest.29770C92488D544F.quest_desc: [
		"&eWhat:&r tier 2 goo turns a Primal Coal block into Blaze Ember ore. Blaze Ember burns 14,400 ticks: nine coal's worth."
		"&eHow:&r craft a Primal Coal block, put it against Blazebloom goo and mine the ore for 3 to 4 embers."
		"&eTip:&r each coal tier burns three times longer than the one before, so the climb pays off quickly."
	]
	quest.119A89E117863D04.title: "Voidflame Coal"
	quest.119A89E117863D04.quest_subtitle: "Optional: the third coal tier"
	quest.119A89E117863D04.quest_desc: [
		"&eWhat:&r tier 3 goo turns a Blaze Ember block into Voidflame Coal ore: 43,200 ticks of burn per piece."
		"&eHow:&r a block of Blaze Ember against VoidShimmer goo (check JEI for counts)."
		"&eTip:&r Voidflame Coal is also the catalyst for the tier 3 fluid fuel."
	]
	quest.4B08F81375A43134.title: "Eclipse Ember"
	quest.4B08F81375A43134.quest_subtitle: "Optional: 81 coal in one lump"
	quest.4B08F81375A43134.quest_desc: [
		"&eWhat:&r tier 4 goo turns a Voidflame Coal block into Eclipse Ember ore. One ember burns 129,600 ticks, as long as 81 pieces of coal."
		"&eHow:&r a block of Voidflame Coal against Shadowpulse goo."
		"&eChemistry:&r burning carbon, C + O₂ → CO₂, gives about 394 kJ per mole. Denser fuel just packs more carbon into the same slot."
	]
	quest.45FA2621E2C93B56.title: "Charcoal Blocks"
	quest.45FA2621E2C93B56.quest_subtitle: "Optional: a renewable way into Primal Coal"
	quest.45FA2621E2C93B56.quest_desc: [
		"&eWhat:&r Just Dire Things adds a charcoal block (nine charcoal). It burns for 16,000 ticks and tier 1 goo accepts it like a coal block."
		"&eChemistry:&r charcoal is wood heated without air (pyrolysis): water and volatiles leave, mostly carbon stays."
		"&eTip:&r a tree farm plus a furnace array makes the coal ladder fully renewable."
	]
	quest.09B259721626EA2D.title: "Simple Coal Generator"
	quest.09B259721626EA2D.quest_subtitle: "Burn the coal tiers for FE"
	quest.09B259721626EA2D.quest_desc: [
		"&eWhat:&r burns solid fuel for Forge Energy: up to 1,000 FE/t into a 1,000,000 FE buffer."
		"&eHow:&r ferricore, redstone, coal and a blast furnace (check JEI)."
		"&eTip:&r it burns fuel four times faster than a furnace, so the long-burning coal tiers are what make it worth having."
	]
	quest.34D4C3650F6E20ED.title: "Fuel Canister"
	quest.34D4C3650F6E20ED.quest_subtitle: "Optional: fuel in one slot"
	quest.34D4C3650F6E20ED.quest_desc: [
		"&eWhat:&r a canister that soaks up furnace fuel and stores it as burn time. Its tooltip shows how much it holds."
		"&eHow:&r ferricore around a piece of coal (check JEI)."
		"&eTip:&r pair it with the Pocket Generator from the Tools page so your FE tools recharge on long trips."
	]
	quest.614E51D267FFEB96.title: "Polymorphic Fluid"
	quest.614E51D267FFEB96.quest_subtitle: "Drop a catalyst into water"
	quest.614E51D267FFEB96.quest_desc: [
		"&eWhat:&r Polymorphic Fluid is the base for every Just Dire Things fluid: fuels, portal fluid and time fluid."
		"&eHow:&r blazegold + Nether wart makes four catalysts. Throw one into a water source block and it becomes Polymorphic Fluid. Bucket it up."
		"&eChemistry:&r a real catalyst speeds a reaction and comes out unchanged. This one is used up, so chemists would call it a reagent."
		"&eTip:&r JEI shows these 'fluid drop' recipes; each catalyst converts one source block."
	]
	quest.64481192AF15BAED.title: "Blaze Ember Fuel"
	quest.64481192AF15BAED.quest_subtitle: "Unrefined, then refined by goo"
	quest.64481192AF15BAED.quest_desc: [
		"&eWhat:&r liquid fuel for the Simple Fuel Generator. It comes from Polymorphic Fluid in two steps."
		"&eHow:&r drop a Blaze Ember into a Polymorphic Fluid source to get Unrefined Blaze Ember Fuel, then let tier 2 goo touch that source to refine it."
		"&eChemistry:&r real refineries separate crude oil by boiling point in a fractionating column; here the goo does the cleanup."
		"&eTip:&r tier 3 and 4 fuels follow the same pattern: drop the next coal into the refined fuel below it, then refine with the next goo."
	]
	quest.721797C986C6CFC2.title: "Simple Fuel Generator"
	quest.721797C986C6CFC2.quest_subtitle: "Liquid fuel, more FE"
	quest.721797C986C6CFC2.quest_desc: [
		"&eWhat:&r burns refined fuel for up to 5,000 FE/t. Blaze Ember Fuel gives 450 FE per mB, Voidflame 1,300 and Eclipse Ember 4,000."
		"&eHow:&r blazegold, redstone, buckets and a blast furnace (check JEI). Pipe or bucket refined fuel in."
		"&eTip:&r one bucket of Eclipse Ember Fuel is 4,000,000 FE, nearly the generator's whole 5,000,000 FE buffer."
	]
	quest.129543C07BADD01E.title: "Voidflame and Eclipse Fuels"
	quest.129543C07BADD01E.quest_subtitle: "Optional: the two top refined fuels"
	quest.129543C07BADD01E.quest_desc: [
		"&eWhat:&r the tier 3 and tier 4 liquid fuels, roughly 3x and 9x the energy of Blaze Ember Fuel per mB."
		"&eHow:&r Voidflame Coal into refined Blaze Ember Fuel, then VoidShimmer goo; Eclipse Ember into refined Voidflame Fuel, then Shadowpulse goo."
		"&eTip:&r one bucket of each. The refined fuel is consumed by the next step, so keep a source block of each tier going."
	]
	quest.34EB382BADB5E4B7.title: "Energy Transmitter"
	quest.34EB382BADB5E4B7.quest_subtitle: "Optional: power without cables"
	quest.34EB382BADB5E4B7.quest_desc: [
		"&eWhat:&r Energy Transmitters move FE without cables, up to 1,000 FE/t, losing a little for every block of distance (check the GUI)."
		"&eHow:&r celestigem, redstone, an ender pearl and blazegold (check JEI)."
		"&eChemistry:&r real power lines lose energy as heat, P = I²R, which is why grids use high voltage and low current."
	]
	quest.73E2C20379D2790F.title: "Time Crystals"
	quest.73E2C20379D2790F.quest_subtitle: "Optional: Shadowpulse goo on budding amethyst"
	quest.73E2C20379D2790F.quest_desc: [
		"&eWhat:&r tier 4 goo turns budding amethyst into a Budding Time Crystal block, which grows time crystal clusters."
		"&eHow:&r budding amethyst can't be moved, so take Shadowpulse goo to a geode and place it touching a budding block. The budding block has to mature in stages first; check JEI and its tooltip for what it needs."
		"&eChemistry:&r amethyst is quartz, SiO₂, coloured purple by iron (Fe³⁺) impurities and natural radiation."
		"&eTip:&r a Time Crystal Block converts back into a budding block, so one success is enough."
	]
	quest.42D2A94125058F8F.title: "The Time Wand"
	quest.42D2A94125058F8F.quest_subtitle: "Optional: speed up time on a block"
	quest.42D2A94125058F8F.quest_desc: [
		"&eWhat:&r the Time Wand makes a block tick faster (up to 256x), paid for in FE and Time Fluid."
		"&eHow:&r Time Fluid: drop a time crystal into a Polymorphic Fluid source. The wand is blazegold, ferricore and a time crystal (check JEI)."
		"&eTip:&r try it on a slow crop, a furnace or a budding block."
	]
	quest.1ACD6F7529AF348F.title: "Paradox Machine"
	quest.1ACD6F7529AF348F.quest_subtitle: "Optional: undo what happened to an area"
	quest.1ACD6F7529AF348F.quest_desc: [
		"&eWhat:&r the Paradox Machine reverts blocks and entities in an area to an earlier state, paying FE and Time Fluid per block or entity."
		"&eHow:&r eclipse alloy, time crystals, a time crystal block and a bucket of Time Fluid (check JEI)."
		"&eTip:&r it's powerful and expensive. Read its GUI before you aim it at your base."
	]
	quest.4408031B4D0E368F.title: "Ferricore Tools"
	quest.4408031B4D0E368F.quest_subtitle: "Tools that take upgrades"
	quest.4408031B4D0E368F.quest_desc: [
		"&eWhat:&r Just Dire Things tools work like iron ones but accept ability upgrades. Each tier can hold more abilities and break more blocks at once."
		"&eHow:&r the usual tool shapes with ferricore ingots and sticks."
		"&eTip:&r vein-style abilities are capped per tier: 64 blocks for ferricore, 128 blazegold, 192 celestigem, 256 eclipse alloy."
	]
	quest.694BC0F994FD0B39.title: "Ore Miner"
	quest.694BC0F994FD0B39.quest_subtitle: "Your first ability: mine the whole vein"
	quest.694BC0F994FD0B39.quest_desc: [
		"&eWhat:&r Ore Miner harvests every connected ore when you break one."
		"&eHow:&r a blank between two iron pickaxes, then combine the upgrade with your pickaxe in a smithing table (no template needed)."
		"&eTip:&r every ability goes on the same way. JEI shows which tools accept which upgrade."
	]
	quest.478D683C2EA8B684.title: "Blazegold Upgrade"
	quest.478D683C2EA8B684.quest_subtitle: "Smith ferricore tools up a tier"
	quest.478D683C2EA8B684.quest_desc: [
		"&eWhat:&r tools climb tiers in the smithing table: template + old tool + new ingot."
		"&eHow:&r a blazegold template is a blank ringed with blazegold. Smith it with a ferricore pickaxe and a blazegold ingot."
		"&eTip:&r a template plus two ingots crafts two templates, so never spend your last one."
	]
	quest.2A6DD513EC097B09.title: "Celestigem and the Paxel"
	quest.2A6DD513EC097B09.quest_subtitle: "Pickaxe, axe and shovel in one"
	quest.2A6DD513EC097B09.quest_desc: [
		"&eWhat:&r from celestigem up you can fuse a pickaxe, axe and shovel of the same tier into a paxel."
		"&eHow:&r smith the blazegold tools up with a celestigem template, then put pickaxe, axe and shovel together in the smithing table (check JEI)."
		"&eTip:&r one paxel instead of three tools frees two hotbar slots."
	]
	quest.465DD74BC5CE144E.title: "Eclipse Alloy Paxel"
	quest.465DD74BC5CE144E.quest_subtitle: "Optional: the last tool tier"
	quest.465DD74BC5CE144E.quest_desc: [
		"&eWhat:&r the top paxel. Eclipse alloy tools take the strongest abilities, such as Instant Break and Ore X-Ray."
		"&eHow:&r smith celestigem tools with an eclipse alloy template, then fuse the three (check JEI)."
		"&eTip:&r Instant Break needs a Nether Star, a netherite pickaxe and time crystals."
	]
	quest.2B4C038D1E902E2C.title: "Dire Bows"
	quest.2B4C038D1E902E2C.quest_subtitle: "Optional: bows with abilities"
	quest.2B4C038D1E902E2C.quest_desc: [
		"&eWhat:&r Just Dire Things bows tier up like the tools and take arrow abilities: Potion Arrow, Splash, Lingering, Homing and more."
		"&eHow:&r a ferricore bow first (check JEI); smith it up with templates."
		"&eTip:&r Potion Arrow uses a Potion Canister (ferricore around a glass bottle) instead of tipped arrows."
	]
	quest.1E92D647D258E222.title: "A Toolbox of Abilities"
	quest.1E92D647D258E222.quest_subtitle: "Optional: any three tool upgrades"
	quest.1E92D647D258E222.quest_desc: [
		"&eWhat:&r Hammer (3x3 up to 7x7 by tier), Treefeller, Smelter (auto-smelts drops), Ore Scanner, Lawnmower, Leafbreaker, Skysweeper and Drops Teleport."
		"&eHow:&r each is a blank plus vanilla parts, e.g. Hammer = blank + two diamond pickaxes, Smelter = blank + blast furnace + blaze rods (check JEI)."
		"&eChemistry:&r smelting ore is reduction: carbon pulls the oxygen off the metal, e.g. Fe₂O₃ + 3CO → 2Fe + 3CO₂."
		"&eTip:&r not every tier takes every upgrade; JEI's smithing recipes show the allowed pairs."
	]
	quest.70C6AB4591A1A113.title: "Ferricore Armour"
	quest.70C6AB4591A1A113.quest_subtitle: "Optional: armour that takes upgrades"
	quest.70C6AB4591A1A113.quest_desc: [
		"&eWhat:&r Just Dire Things armour takes upgrades too: Step Assist and Jump Boost on boots, Walk and Run Speed on leggings, Mind Fog on helmets."
		"&eHow:&r the usual armour shapes in ferricore. Smith them up with templates later."
		"&eTip:&r higher tiers add Night Vision, Water Breathing, Negate Fall Damage and Lava Immunity."
	]
	quest.785F351394AF9717.title: "Built-in Elytra"
	quest.785F351394AF9717.quest_subtitle: "Optional: an elytra inside your chestplate"
	quest.785F351394AF9717.quest_desc: [
		"&eWhat:&r the Elytra upgrade builds an elytra into a celestigem or eclipse alloy chestplate, so you keep armour and glide."
		"&eHow:&r a blank plus an elytra (from an End City), then smith it onto the chestplate."
		"&eTip:&r it's gliding, not flight. True flight is the next step."
	]
	quest.272CB75AA9A5CC92.title: "Flight"
	quest.272CB75AA9A5CC92.quest_subtitle: "Creative-style flight, the hard way"
	quest.272CB75AA9A5CC92.quest_desc: [
		"&6You remember the sky. The goo had to eat netherite before it would give it back.&r"
		"&eWhat:&r the Flight upgrade gives creative-style flight. It only fits the Eclipse Alloy Chestplate, so it needs tier 4 goo and a netherite block."
		"&eHow:&r a blank with phantom membranes, feathers and two End Crystals (check JEI), smithed onto an eclipse alloy chestplate."
		"&eTip:&r this pack keeps the End Crystal recipe on purpose: JDT flight is a late reward, after the End and an Ancient City."
	]
	quest.287688ABE62B1FB8.title: "Chestplate Defences"
	quest.287688ABE62B1FB8.quest_subtitle: "Optional: two more chestplate abilities"
	quest.287688ABE62B1FB8.quest_desc: [
		"&eWhat:&r Invulnerability (a few seconds on demand), Lava Immunity, Extinguish, Death Protection (once every 5 minutes), Time Protection and Phase (walk through walls, on leggings)."
		"&eHow:&r check JEI for each; Death Protection takes a Totem of Undying and time crystals."
		"&eTip:&r activated abilities sit on keybinds; look for Just Dire Things in Controls."
	]
	quest.543641BA542385BF.title: "Breaker and Placer"
	quest.543641BA542385BF.quest_subtitle: "The first automation pair"
	quest.543641BA542385BF.quest_desc: [
		"&eWhat:&r the Simple Block Breaker mines the block in front of it; the Simple Block Placer puts blocks down. Together they automate a goo farm."
		"&eHow:&r ferricore, a diamond, lapis, redstone and an observer (breaker) or dispenser (placer). Check JEI."
		"&eTip:&r a placer feeding iron blocks to the goo and a breaker harvesting the ore makes ferricore hands-free."
	]
	quest.2B0704C1164EA8DC.title: "Clicker and Sensor"
	quest.2B0704C1164EA8DC.quest_subtitle: "Fake clicks and redstone eyes"
	quest.2B0704C1164EA8DC.quest_desc: [
		"&eWhat:&r the Simple Clicker right- or left-clicks like a player; the Simple Sensor emits a redstone signal when it sees a chosen block or mob."
		"&eHow:&r both use ferricore, lapis, redstone and an eye of ender (clicker: dispenser core, sensor: observer core)."
		"&eTip:&r a sensor watching for the converted ore can tell the breaker exactly when to fire."
	]
	quest.6D8E40C28DD7E567.title: "Fluid Collector and Placer"
	quest.6D8E40C28DD7E567.quest_subtitle: "Optional: pick up and place fluid sources"
	quest.6D8E40C28DD7E567.quest_desc: [
		"&eWhat:&r the fluid versions of the breaker and placer: collect source blocks into a tank, or set them down."
		"&eHow:&r ferricore, lapis, redstone and a bucket around a dispenser or dropper (check JEI)."
		"&eTip:&r a placer and a collector around goo automate the refined fuel line."
	]
	quest.16F62F05718CB1F7.title: "Item Collector and Dropper"
	quest.16F62F05718CB1F7.quest_subtitle: "Optional: vacuum up drops"
	quest.16F62F05718CB1F7.quest_desc: [
		"&eWhat:&r the Item Collector pulls dropped items from an area into an attached inventory; the Simple Dropper drops items out like a configurable dropper."
		"&eHow:&r Item Collector: ferricore, a hopper, a diamond and an ender pearl. Dropper: ferricore, lapis, redstone and a dropper."
		"&eTip:&r the Machine Settings Copier (Primal Coal, paper, ferricore) copies one machine's setup to another."
	]
	quest.6C3E6C9C1F544A53.title: "Advanced Machines"
	quest.6C3E6C9C1F544A53.quest_subtitle: "Any two tier 2 machines"
	quest.6C3E6C9C1F544A53.quest_desc: [
		"&eWhat:&r the Advanced versions do the same jobs with more range and settings (check each GUI)."
		"&eHow:&r the Simple machine in the centre, ringed with celestigem, eyes of ender and redstone (check JEI)."
		"&eTip:&r one Advanced Breaker can harvest a whole wall of goo conversions."
	]
	quest.4AE6C7907D93FFD8.title: "The Swapper"
	quest.4AE6C7907D93FFD8.quest_subtitle: "Optional: trade two blocks' places"
	quest.4AE6C7907D93FFD8.quest_desc: [
		"&eWhat:&r Swappers exchange the blocks (and optionally entities) between two linked spots. The Advanced Swapper uses eclipse alloy."
		"&eHow:&r blazegold, lapis, redstone, an eye of ender and an observer (check JEI)."
		"&eTip:&r swap freshly converted ore out and a new iron block in, without breaking anything."
	]
	quest.40A615A7CEF86785.title: "Blazegold Utilities"
	quest.40A615A7CEF86785.quest_subtitle: "Optional: any two blazegold blocks"
	quest.40A615A7CEF86785.quest_desc: [
		"&eWhat:&r the Player Accessor lets pipes reach a bound player's inventory; the Inventory Holder stores and swaps a loadout; the Experience Holder banks XP."
		"&eHow:&r all three are blazegold plus vanilla parts (armour stand, books, emerald, ender pearls; check JEI)."
		"&eTip:&r the Experience Holder is the tidy place to keep levels between anvil and enchanting sessions."
	]
	quest.1D2D7E53909E80B6.title: "Blazejet Wand"
	quest.1D2D7E53909E80B6.quest_subtitle: "Optional: launch yourself"
	quest.1D2D7E53909E80B6.quest_desc: [
		"&eWhat:&r Air Burst: the wand launches you in the direction you're looking."
		"&eHow:&r a blazegold ingot over two ferricore ingots (check JEI)."
		"&eTip:&r it's the base of the Voidshift Wand, so don't throw it away."
	]
	quest.7FAAB20CAC7E13A1.title: "Voidshift Wand"
	quest.7FAAB20CAC7E13A1.quest_subtitle: "Optional: the next mobility wand"
	quest.7FAAB20CAC7E13A1.quest_desc: [
		"&eWhat:&r the Blazejet Wand upgraded with celestigem. It adds Void Shift (read its tooltip for the details)."
		"&eHow:&r celestigem, the Blazejet Wand and blazegold in a column."
		"&eTip:&r it upgrades again into the Eclipsegate Wand."
	]
	quest.05805628CA71C46C.title: "Eclipsegate Wand"
	quest.05805628CA71C46C.quest_subtitle: "Optional: a portable hole"
	quest.05805628CA71C46C.quest_desc: [
		"&eWhat:&r Eclipse Gate temporarily removes the blocks you click, then puts them back."
		"&eHow:&r eclipse alloy, the Voidshift Wand and celestigem in a column."
		"&eTip:&r perfect for stepping through your own base walls without breaking them."
	]
	quest.10C6694C5492D209.title: "Polymorphic Wand"
	quest.10C6694C5492D209.quest_subtitle: "Optional: turn one mob into another"
	quest.10C6694C5492D209.quest_desc: [
		"&eWhat:&r the wand polymorphs a mob into a random one (or, on the Advanced wand, a chosen target), using Polymorphic Fluid."
		"&eHow:&r a fluid canister, a polymorphic catalyst and blazegold in a column. Fill it with Polymorphic Fluid."
		"&eTip:&r the Advanced Polymorphic Wand adds eclipse alloy and celestigem and also costs FE."
	]
	quest.327536CBCCD658B1.title: "Catcher and Recall Totem"
	quest.327536CBCCD658B1.quest_subtitle: "Optional: two handy blazegold items"
	quest.327536CBCCD658B1.quest_desc: [
		"&eWhat:&r the Creature Catcher captures a mob to carry and release elsewhere; the Totem of Death Recall is for getting back to where you died (read its tooltip)."
		"&eHow:&r both are blazegold and ender pearls (the totem adds diamonds and lapis). Check JEI."
		"&eTip:&r it won't take the Ender Dragon, sadly."
	]
	quest.69EEDCAC09CAF489.title: "Portal Fluid"
	quest.69EEDCAC09CAF489.quest_subtitle: "Optional: the Advanced Portal Gun"
	quest.69EEDCAC09CAF489.quest_desc: [
		"&eWhat:&r Portal Fluid powers the Advanced Portal Gun, the upgrade of the Portal Gun on the Tools page."
		"&eHow:&r a Portal Fluid Catalyst (chorus fruit and lapis) dropped into Polymorphic Fluid makes Unstable Portal Fluid; tier 3 goo stabilises it. The gun adds celestigem and a fluid canister (check JEI)."
		"&eTip:&r the Advanced Portal Gun holds 1,000,000 FE; the basic one only 100,000."
	]
	quest.73433D9F76AD2B25.title: "Ferricore Ingots"
	quest.73433D9F76AD2B25.quest_subtitle: "The goo's first metal, and its template"
	quest.73433D9F76AD2B25.quest_desc: [
		"&eWhat:&r ferricore ingots, plus the Ferricore template that smiths ordinary iron gear up into ferricore."
		"&eChemistry:&r 'ferri-' means iron (Latin ferrum, symbol Fe). The goo has rearranged the iron into something new; real iron would need an alloying element to change this much."
		"&eHow:&r smelt raw ferricore. The template is a blank ringed with ferricore ingots (check JEI)."
		"&eTip:&r a template plus ingots crafts a copy of itself, so you only make the first one by hand."
	]
	quest.263A3EE38E34F561.title: "Sword, Hoe and Wrench"
	quest.263A3EE38E34F561.quest_subtitle: "The rest of the ferricore set"
	quest.263A3EE38E34F561.quest_desc: [
		"&eWhat:&r the ferricore sword and hoe take abilities like the other tools. The Ferricore Wrench rotates blocks and Just Dire Things machines."
		"&eHow:&r the usual tool shapes; the wrench is four ferricore ingots (check JEI)."
		"&eTip:&r the hoe can take tilling and harvesting abilities at higher tiers; JEI lists which."
	]
	quest.584B497766A8890C.title: "The Blazegold Set"
	quest.584B497766A8890C.quest_subtitle: "Every blazegold tool"
	quest.584B497766A8890C.quest_desc: [
		"&eWhat:&r blazegold versions of every tool. Each tier holds more abilities and reaches further with them."
		"&eHow:&r smith ferricore tools with a blazegold template and a blazegold ingot (check JEI)."
		"&eTip:&r upgrade the tools you actually use first; the hoe can wait."
	]
	quest.1875AD19DDABA3F2.title: "Blazegold Armour"
	quest.1875AD19DDABA3F2.quest_subtitle: "Armour with more upgrade slots"
	quest.1875AD19DDABA3F2.quest_desc: [
		"&eWhat:&r the second armour tier. More abilities fit, and some only unlock here."
		"&eHow:&r smith each ferricore piece with a blazegold template and ingot (check JEI)."
		"&eChemistry:&r gold reflects infrared well, which is why astronaut visors are gold-coated. Blazegold is the goo's version."
	]
	quest.4CA5A61DDFFC47AA.title: "The Celestigem Set"
	quest.4CA5A61DDFFC47AA.quest_subtitle: "Every celestigem tool"
	quest.4CA5A61DDFFC47AA.quest_desc: [
		"&eWhat:&r the third tier of every tool, with its template."
		"&eHow:&r the template is a blank ringed with celestigem; smith each blazegold tool with it and a celestigem (check JEI)."
		"&eTip:&r axe, shovel and pickaxe of one tier fuse into the paxel."
	]
	quest.2DC5A4853D0048E4.title: "Celestigem Armour"
	quest.2DC5A4853D0048E4.quest_subtitle: "Helmet, leggings and boots"
	quest.2DC5A4853D0048E4.quest_desc: [
		"&eWhat:&r the rest of the celestigem set (the chestplate has its own quest with the elytra)."
		"&eHow:&r smith each blazegold piece with a celestigem template and a celestigem (check JEI)."
		"&eChemistry:&r a celestigem forms from diamond, and diamond is pure carbon in a tetrahedral lattice; the hardest natural material known."
	]
	quest.2694B10DECA65E53.title: "The Eclipse Alloy Set"
	quest.2694B10DECA65E53.quest_subtitle: "Challenge: every eclipse alloy tool"
	quest.2694B10DECA65E53.quest_desc: [
		"&eWhat:&r the last tier of every tool. Each one starts from a netherite block fed to tier 4 goo, so this is a real investment."
		"&eHow:&r smelt raw eclipse alloy; the template is a blank ringed with it. Smith each celestigem tool up (check JEI)."
		"&eTip:&r the sword takes the strongest combat abilities; check JEI before you spend the alloy."
	]
	quest.5AB23F16BA4A836F.title: "Eclipse Alloy Armour"
	quest.5AB23F16BA4A836F.quest_subtitle: "Challenge: finish the set"
	quest.5AB23F16BA4A836F.quest_desc: [
		"&6Helmet, legs, boots: the last pieces fall into place. You remember being hard to hurt.&r"
		"&eWhat:&r helmet, leggings and boots in eclipse alloy, matching the chestplate from the Flight quest. The best Just Dire Things armour."
		"&eHow:&r smith each celestigem piece with an eclipse alloy template and ingot (check JEI)."
	]
	quest.2208B80C133DBEBA.title: "Challenge: Every Dire Bow"
	quest.2208B80C133DBEBA.quest_subtitle: "Four tiers of bow"
	quest.2208B80C133DBEBA.quest_desc: [
		"&eWhat:&r one bow of each tier. Higher tiers draw faster and hold more arrow abilities."
		"&eHow:&r smith each bow up with the next template (check JEI). Keep one of each, or craft spares on the way up."
	]
	quest.40F4F3AC965317C2.title: "Arrow Abilities"
	quest.40F4F3AC965317C2.quest_subtitle: "Any two bow upgrades"
	quest.40F4F3AC965317C2.quest_desc: [
		"&eWhat:&r Potion Arrow (fires a potion from a canister), Splash and Lingering (change how that potion spreads), Homing, and Yondu Arrow (arrows that pass through several targets)."
		"&eChemistry:&r splash and lingering potions are the same mixture delivered as a spray or a cloud; real aerosols work the same way, spreading a dose over more surface."
		"&eHow:&r each is a blank plus vanilla items; Yondu Arrow also needs a Nether Star (check JEI)."
	]
	quest.51D38CD44B52C9EE.title: "Light on Your Feet"
	quest.51D38CD44B52C9EE.quest_subtitle: "Any two movement abilities"
	quest.51D38CD44B52C9EE.quest_desc: [
		"&eWhat:&r Step Assist, Jump Boost, Walk Speed, Run Speed, Swim Speed, Negate Fall Damage and Ground Stomp (push mobs away)."
		"&eHow:&r a blank plus vanilla items, e.g. Step Assist is a blank ringed with ladders (check JEI). Smith onto boots or leggings."
		"&eTip:&r none of these is flight. In this pack JDT flight is a late reward on eclipse alloy."
	]
	quest.7D4F93D7A3437172.title: "Eyes of the Goo"
	quest.7D4F93D7A3437172.quest_subtitle: "Any two helmet or senses abilities"
	quest.7D4F93D7A3437172.quest_desc: [
		"&eWhat:&r Night Vision, Mob X-Ray (see mobs through walls), Mob Scanner, Ore X-Ray, Mind Fog (mobs notice you less) and Water Breathing."
		"&eChemistry:&r Night Vision's recipe uses golden carrots: carrots really are rich in beta-carotene, which the body turns into vitamin A for the eye's light-sensing pigment."
		"&eHow:&r a blank plus vanilla items each (check JEI); Ore X-Ray needs a high tier."
	]
	quest.53A42527BFED1B59.title: "Fighting Dirty"
	quest.53A42527BFED1B59.quest_subtitle: "Any two combat abilities"
	quest.53A42527BFED1B59.quest_desc: [
		"&eWhat:&r Cauterize Wounds (heal), Debuff Remover, Decoy (mobs attack a dummy), Earthquake (slows nearby mobs), Stupefy (a mob forgets you) and Mental Obliteration (nearby mobs stop for good)."
		"&eHow:&r a blank plus vanilla items each, e.g. Earthquake uses soul sand, sticky pistons and fermented spider eyes (check JEI)."
		"&eTip:&r activated abilities have keybinds; find them under Just Dire Things in Controls."
	]
	quest.3E1D1A8CBB130C82.title: "Cooked on the Spot"
	quest.3E1D1A8CBB130C82.quest_subtitle: "Mob drops come out cooked"
	quest.3E1D1A8CBB130C82.quest_desc: [
		"&eWhat:&r the Smoker ability auto-smelts mob drops: raw meat drops as cooked meat."
		"&eChemistry:&r cooking meat is chemistry: proteins denature, and the Maillard reaction between amino acids and sugars makes the brown crust and the flavour."
		"&eHow:&r a blank, a smoker and blaze rods (check JEI). Smith it onto a weapon."
	]
	quest.42F4D88FCE771394.title: "Instant Break"
	quest.42F4D88FCE771394.quest_subtitle: "Challenge: every block breaks at once"
	quest.42F4D88FCE771394.quest_desc: [
		"&eWhat:&r the strongest tool ability: blocks break instantly."
		"&eHow:&r a blank, two Nether Stars, two netherite pickaxes and four time crystals (check JEI). Only top-tier tools take it."
		"&eTip:&r combine it with a hammer ability and a 5x5 hole is one click."
	]
	quest.4826C019BFEBD2C1.title: "Challenge: The Advanced Workshop"
	quest.4826C019BFEBD2C1.quest_subtitle: "One of every advanced machine"
	quest.4826C019BFEBD2C1.quest_desc: [
		"&eWhat:&r all eight advanced machines: breaker, placer, clicker, sensor, dropper, fluid collector, fluid placer and swapper."
		"&eHow:&r each wraps its Simple version in celestigem and more; the Advanced Swapper needs eclipse alloy (check JEI)."
		"&eTip:&r together they can run a whole goo farm, from feeding iron blocks to collecting the ore."
	]
	quest.304B62D33BDE1A70.title: "Liquid Experience"
	quest.304B62D33BDE1A70.quest_subtitle: "Bank your levels as a fluid"
	quest.304B62D33BDE1A70.quest_desc: [
		"&eWhat:&r the Experience Holder stores your levels, and holds them as XP Fluid you can pipe or bucket out."
		"&eHow:&r blazegold, a book, an ender pearl and an emerald (check JEI). Use its GUI to deposit or withdraw levels."
		"&eTip:&r the fluid lets one XP store feed anvils, enchanters and other XP machines."
	]
	quest.373D24AD924BD8D6.title: "Player Accessor"
	quest.373D24AD924BD8D6.quest_subtitle: "Pipes into your own inventory"
	quest.373D24AD924BD8D6.quest_desc: [
		"&eWhat:&r a block bound to you that pipes can push into or pull out of, as if it were your inventory."
		"&eHow:&r blazegold, eyes of ender, ender pearls, a dispenser and lapis (check JEI), then bind it to yourself (its tooltip shows how)."
		"&eTip:&r pipe arrows or fuel straight into your inventory from base while you're out."
	]
	quest.3724FBBCAC0F3D26.title: "Canister and Settings Copier"
	quest.3724FBBCAC0F3D26.quest_subtitle: "Carry a fluid, copy a setup"
	quest.3724FBBCAC0F3D26.quest_desc: [
		"&eWhat:&r the Fluid Canister holds a fluid for wands and guns; the Machine Settings Copier copies one machine's settings onto another."
		"&eHow:&r canister: ferricore around glass. Copier: Primal Coal, paper and ferricore (check JEI)."
		"&eTip:&r set up one breaker perfectly, then copy it down a whole row."
	]
	quest.3C4A936CD4F3DDCF.title: "Portal Fluid Catalyst"
	quest.3C4A936CD4F3DDCF.quest_subtitle: "Chorus fruit and lapis"
	quest.3C4A936CD4F3DDCF.quest_desc: [
		"&eWhat:&r the catalyst that turns Polymorphic Fluid into Unstable Portal Fluid, the first step to the Advanced Portal Gun's fuel."
		"&eHow:&r chorus fruit around lapis (check JEI). Drop one into a Polymorphic Fluid source block."
		"&eTip:&r chorus fruit grows on the outer End islands. Bring some back and plant it."
	]
	chapter.0995B455F4B29E6B.title: "Applied Energistics"
	chapter.0995B455F4B29E6B.chapter_subtitle: [
		"The archive of a god: every item as data, every recipe on demand."
	]
	quest.18BA0BAED4B065FB.title: "Certus Quartz"
	quest.18BA0BAED4B065FB.quest_subtitle: "The crystal every AE2 part starts from"
	quest.18BA0BAED4B065FB.quest_desc: [
		"&6You remember crystals that sang when you touched them. These still hum, faintly.&r"
		"&eWhat:&r certus quartz goes into almost every AE2 recipe: processors, glass, cells and cards."
		"&eChemistry:&r certus is fictional, but it behaves like real quartz (SiO₂), which is piezoelectric: squeeze it and it makes a small voltage."
		"&eHow:&r mine certus from meteorite craters and budding certus. Grind crystals into dust in the Inscriber with no press (or any crusher JEI lists)."
		"&eTip:&r charged certus plus certus dust dropped in water makes two new crystals. Grow it once you have a little."
	]
	quest.586BC6690936D78A.title: "Sky Stone"
	quest.586BC6690936D78A.quest_subtitle: "Stone that fell from the sky"
	quest.586BC6690936D78A.quest_desc: [
		"&eWhat:&r sky stone is the rock of AE2 meteorites. The ME Controller in this pack needs smooth sky stone."
		"&eChemistry:&r real stony meteorites are mostly silicate minerals like olivine and pyroxene; iron meteorites are an iron-nickel alloy."
		"&eHow:&r mine the crater shell (it needs an iron pickaxe or better), then smelt sky stone into smooth sky stone."
		"&eTip:&r the Inscriber grinds sky stone into sky dust, which ExtendedAE and AdvancedAE recipes ask for."
	]
	quest.41F9E505FC3331BB.title: "All Four Presses"
	quest.41F9E505FC3331BB.quest_subtitle: "Logic and calculation join the set"
	quest.41F9E505FC3331BB.quest_desc: [
		"&eWhat:&r the Inscriber has four presses: silicon, logic, calculation and engineering. You need all four for AE2's processors."
		"&eHow:&r each meteorite's mysterious cube holds one press. Keep finding meteorites with the Meteorite Compass until you have the set."
		"&eTip:&r never use your only copy in a long automation line. Make a spare in the Inscriber with an iron block first (check JEI)."
	]
	quest.353932F678CB4992.title: "Printed Silicon"
	quest.353932F678CB4992.quest_subtitle: "Every processor sits on silicon"
	quest.353932F678CB4992.quest_desc: [
		"&eWhat:&r printed silicon is the base layer of every AE2 processor."
		"&eChemistry:&r industry makes silicon by heating quartz with carbon to about 2000 °C: SiO₂ + 2C → Si + 2CO. Chips need it purer than 99.9999999%."
		"&eHow:&r press MI silicon ingots in the Inscriber with the Silicon Press. They come from the Electric Blast Furnace (quartz dust + coke dust)."
		"&eTip:&r in this pack certus and sand don't smelt into silicon: carbothermic reduction is the only way, as in the real world."
	]
	quest.1DF011A9A8CA2618.title: "Logic Processors"
	quest.1DF011A9A8CA2618.quest_subtitle: "Gold, redstone and silicon"
	quest.1DF011A9A8CA2618.quest_desc: [
		"&eWhat:&r logic processors go into cell components, cores, interfaces and much more. You'll want hundreds."
		"&eChemistry:&r gold (Au) barely reacts with air or water, so it never corrodes. Real chips use gold for contacts and bond wires."
		"&eHow:&r press a gold ingot with the Logic Press, then put printed logic on top, redstone in the middle and printed silicon at the bottom."
		"&eTip:&r one Inscriber per processor type, each fed by pipes, keeps all three in stock."
	]
	quest.2BE1DBF6A42A1D60.title: "Calculation Processors"
	quest.2BE1DBF6A42A1D60.quest_subtitle: "A quartz heartbeat for the network"
	quest.2BE1DBF6A42A1D60.quest_desc: [
		"&eWhat:&r calculation processors go into crafting units, cards, bigger cell components and wireless parts."
		"&eChemistry:&r a real quartz crystal vibrates at a precise frequency when a voltage drives it. Watches count 32,768 vibrations of quartz a second to keep time."
		"&eHow:&r press a certus crystal with the Calculation Press, then combine it with redstone and printed silicon like a logic processor."
		"&eTip:&r engineering processors use a diamond the same way. Diamond spreads heat better than any metal, which is why it's used to cool chips."
	]
	quest.43D2CB1DCAE0ECF0.title: "Quartz Glass and Fiber"
	quest.43D2CB1DCAE0ECF0.quest_subtitle: "Glass for housings, fibre for power"
	quest.43D2CB1DCAE0ECF0.quest_desc: [
		"&eWhat:&r quartz glass goes into cell housings and patterns. Quartz Fiber shares power between networks without sharing channels."
		"&eChemistry:&r glass made from pure SiO₂ (fused silica) barely expands when heated. Optical fibre is the same glass, so pure that light travels kilometres inside it."
		"&eHow:&r quartz dust and glass make quartz glass; glass and quartz dust make fibre (check JEI)."
	]
	quest.201AD8AF75B2F90C.title: "Cell Housings"
	quest.201AD8AF75B2F90C.quest_subtitle: "The case every storage cell needs"
	quest.201AD8AF75B2F90C.quest_desc: [
		"&eWhat:&r a storage cell is a housing plus a component. Item housings take iron and copper; fluid housings take copper."
		"&eHow:&r quartz glass, redstone and metal in a crafting table (check JEI). Combine a housing with any component to make the cell."
		"&eTip:&r sneak-use an empty cell in the air to split it back into housing and component, for upgrading to a bigger one."
	]
	quest.69F4CBBE99F8800E.title: "Annihilation and Formation"
	quest.69F4CBBE99F8800E.quest_subtitle: "The cores that move things in and out"
	quest.69F4CBBE99F8800E.quest_desc: [
		"&eWhat:&r annihilation cores take things into the network; formation cores put things out. Interfaces, pattern providers, planes and the Molecular Assembler all need both."
		"&eHow:&r nether quartz (annihilation) or certus (formation), plus fluix dust and a logic processor, two at a time. Grind fluix crystals in the Inscriber for the dust."
		"&eTip:&r make a stack of each. Autocrafting eats them fast."
	]
	quest.7B5A836AFA0968E6.title: "Upgrade Cards"
	quest.7B5A836AFA0968E6.quest_subtitle: "Faster buses, more filter slots"
	quest.7B5A836AFA0968E6.quest_desc: [
		"&eWhat:&r Acceleration Cards speed up buses, Inscribers and Molecular Assemblers. Capacity Cards add filter slots. Fuzzy, Inverter, Crafting and Redstone cards change what a part does."
		"&eHow:&r basic cards from gold, iron, redstone and a calculation processor; advanced cards use a diamond instead. Add fluix for speed or certus for capacity (check JEI)."
		"&eTip:&r a Crafting Card on an export bus makes it order missing items from your autocrafting."
	]
	quest.162A48BA45345800.title: "Memory Card and Network Tool"
	quest.162A48BA45345800.quest_subtitle: "Copy settings, read channels"
	quest.162A48BA45345800.quest_desc: [
		"&eWhat:&r the Memory Card copies a part's settings and filters to another; the Network Tool shows channels and holds spare upgrade cards."
		"&eHow:&r both use a calculation processor (check JEI). Sneak-use the Memory Card on the source, then use it on the target."
		"&eTip:&r the Memory Card is also how you link P2P tunnels."
	]
	quest.3038F3E8F86270FC.title: "Cell Workbench"
	quest.3038F3E8F86270FC.quest_subtitle: "Optional: partition and upgrade cells"
	quest.3038F3E8F86270FC.quest_desc: [
		"&eWhat:&r the Cell Workbench sets which items a cell accepts (partitioning) and adds cards to cells."
		"&eHow:&r wool, iron, a chest and a calculation processor (check JEI)."
		"&eTip:&r a cell partitioned to one dust, with a Void Card, keeps its stock without overflowing into your other cells."
	]
	quest.56E785A27AA8ECF6.title: "Dense Energy Cell"
	quest.56E785A27AA8ECF6.quest_subtitle: "A bigger buffer for big jobs"
	quest.56E785A27AA8ECF6.quest_desc: [
		"&eWhat:&r a Dense Energy Cell stores eight times more AE than a normal cell."
		"&eHow:&r eight Energy Cells around a calculation processor (check JEI). Put it anywhere on the network."
		"&eTip:&r when a network starts flickering during autocrafting, more buffer is usually the cure, not more power input."
	]
	quest.72E2395F124F6C52.title: "Tunnels for Everything"
	quest.72E2395F124F6C52.quest_subtitle: "Optional: P2P for power and fluids"
	quest.72E2395F124F6C52.quest_desc: [
		"&eWhat:&r P2P tunnels can carry FE, fluids, items, light or redstone instead of channels."
		"&eHow:&r right-click an ME P2P tunnel with what it should carry, like a bucket or an FE item (check JEI for the full list)."
		"&eTip:&r FE tunnels move power through one dense cable instead of a bundle of power lines."
	]
	quest.5A12756B50F4FE84.title: "Feeding the Network"
	quest.5A12756B50F4FE84.quest_subtitle: "AE2 runs on its own energy, fed by FE"
	quest.5A12756B50F4FE84.quest_desc: [
		"&eWhat:&r the ME network turns FE into its own AE energy. The Energy Acceptor converts it; Energy Cells buffer it."
		"&eHow:&r connect an Energy Acceptor to any FE source (an energy cube, a Powah cell, a Flux Point) and to your cables. Add an Energy Cell next to the controller (check JEI)."
		"&eTip:&r a big autocraft can drain the network fast. A Dense Energy Cell keeps it from browning out mid-job."
	]
	quest.2A7CE0F1602C61FA.title: "Growing Certus"
	quest.2A7CE0F1602C61FA.quest_subtitle: "Optional: crystal farms at full speed"
	quest.2A7CE0F1602C61FA.quest_desc: [
		"&eWhat:&r Growth Accelerators speed up certus quartz buds growing on budding certus blocks."
		"&eChemistry:&r real quartz (SiO₂) crystals grow from silica-rich water over thousands of years. Certus is fictional, but the idea of a seed crystal pulling dissolved material out of solution is real."
		"&eHow:&r iron, fluix glass cable, quartz glass and a fluix block (check JEI). Place them touching budding certus and power them."
		"&eTip:&r flawless budding certus never decays. Find it in meteorites and never break it with a normal pickaxe."
	]
	quest.15163874C4379E91.title: "P2P Tunnels"
	quest.15163874C4379E91.quest_subtitle: "Optional: one cable, many channels"
	quest.15163874C4379E91.quest_desc: [
		"&eWhat:&r a pair of P2P tunnels carries 32 channels (or items, fluids, FE and redstone) through a single dense cable."
		"&eHow:&r place both tunnels, then copy the input's settings to the output with a Memory Card (check JEI)."
		"&eTip:&r right-click a P2P tunnel with a bucket, a redstone dust or an FE item to change what it carries."
	]
	quest.29DF6C2F77C3462E.title: "The Matter Condenser"
	quest.29DF6C2F77C3462E.quest_subtitle: "Crush a quarter-million items into a point"
	quest.29DF6C2F77C3462E.quest_desc: [
		"&eWhat:&r the Matter Condenser destroys items. With a 64k component inside, it squeezes them into Matter Balls or a Singularity."
		"&eHow:&r craft it (check JEI), put a storage component in it, set it to Singularity and feed it cobblestone from a pipe. It takes a lot of items."
		"&eTip:&r singularities unlock MEGA Cells' accumulation processor and every AdvancedAE machine, so start a cobblestone generator early."
	]
	quest.12502172FFC387E5.title: "Quantum Bridge"
	quest.12502172FFC387E5.quest_subtitle: "Optional: link networks across dimensions"
	quest.12502172FFC387E5.quest_desc: [
		"&eWhat:&r two Quantum Network Bridges joined by entangled singularities act like one cable, even across dimensions."
		"&eHow:&r build a 3x3 ring of 8 Quantum Rings around a Quantum Link Chamber at each end, then put one of a pair of entangled singularities in each chamber."
		"&eTip:&r both ends must be chunk-loaded. Use FTB Chunks to force-load them."
	]
	quest.2DC9FE73876C2216.title: "Spooky Action"
	quest.2DC9FE73876C2216.quest_subtitle: "Secret: two particles, one fate"
	quest.2DC9FE73876C2216.quest_desc: [
		"&6You remember being in two places at once. It felt exactly like this.&r"
		"&eWhat:&r you made a pair of Quantum Entangled Singularities by blowing up a singularity with ender pearl dust."
		"&eChemistry:&r real entangled particles share one quantum state: measure one and you know the other, however far apart. Sadly it can't send messages faster than light; AE2 is kinder."
	]
	quest.33690DED4CD25646.title: "AE2 Storage"
	quest.33690DED4CD25646.quest_subtitle: "Drives, terminals and the god's archive"
	quest.33690DED4CD25646.quest_desc: [
		"&6You remember a mind that held every name of every thing. The archive is waking.&r"
		"&eWhat:&r ME Drives hold storage cells; terminals let you see and search everything."
		"&eHow:&r connect the drive and a terminal to your ME Controller with cables (check JEI)."
		"&eTip:&r keep power stable: an Energy Cell buffers the network."
	]
	quest.4ACE8FFE618969CC.title: "Cables and Channels"
	quest.4ACE8FFE618969CC.quest_subtitle: "Every device needs a channel"
	quest.4ACE8FFE618969CC.quest_desc: [
		"&eWhat:&r each ME device uses one channel. Normal cables carry 8 channels, dense cables 32. The controller sends 32 out of each face."
		"&eHow:&r craft fluix cables, then smart cables (they show channel use as lines) and dense cables (check JEI)."
		"&eTip:&r build a dense-cable backbone from the controller and branch normal cables off it. Smart cables show you where channels run out."
		"{@pagebreak}"
		"&eDeep dive:&r if a device's light is off, it has no channel. Count devices on each normal cable (max 8). Drives, terminals, buses and interfaces all count. Plain cables, quartz fibre and energy cells don't."
		"&eHow:&r the Network Tool (check JEI) shows the channel count of any cable when you right-click it."
	]
	quest.58932D295CE4DB3B.title: "Storage Cells"
	quest.58932D295CE4DB3B.quest_subtitle: "Bytes for your items"
	quest.58932D295CE4DB3B.quest_desc: [
		"&eWhat:&r cells are where the network actually stores things. Bigger components (4k, 16k, 64k, 256k) hold more."
		"&eChemistry:&r certus and fluix are fictional, but the logic processors behind them echo real chips: doped silicon (Si)."
		"&eHow:&r craft components from processors and certus quartz, then put one in a cell housing (check JEI)."
	]
	quest.7D7098581E0AE024.title: "Bigger Components"
	quest.7D7098581E0AE024.quest_subtitle: "16k and 64k: room for whole chemical stocks"
	quest.7D7098581E0AE024.quest_desc: [
		"&eWhat:&r each tier combines three of the last with a calculation processor and quartz glass, holding four times as many bytes."
		"&eHow:&r 4k from 1k, 16k from 4k, 64k from 16k (check JEI). Put them in housings, or into the Matter Condenser."
		"&eTip:&r a cell holds up to 63 different item types whatever its size, so use small cells for many odd items and big cells for bulk ores and dusts."
	]
	quest.76110B693DBF6FF2.title: "Autocrafting"
	quest.76110B693DBF6FF2.quest_subtitle: "Whole chemical chains in one click"
	quest.76110B693DBF6FF2.quest_desc: [
		"&eWhat:&r pattern providers plus molecular assemblers turn whole chemical chains into one click."
		"&eHow:&r a Crafting Terminal, some crafting storage, and patterns encoded in a Pattern Encoding Terminal (check JEI)."
		"&eTip:&r processing patterns can drive MI machines too: send the inputs, wait for the outputs. The Automation and Logic page walks through a full sulfuric acid line."
	]
	quest.72A62F77A5D7C0CE.title: "Wireless Access"
	quest.72A62F77A5D7C0CE.quest_subtitle: "Optional: your network in your pocket"
	quest.72A62F77A5D7C0CE.quest_desc: [
		"&eWhat:&r reach your ME network from anywhere in range of a Wireless Access Point."
		"&eHow:&r check JEI. Link the terminal by putting it in the access point, and charge it in the Charger."
		"&eTip:&r put the access point near the middle of your base for the best coverage."
	]
	quest.07860310FF05CBD6.title: "Universal Terminal"
	quest.07860310FF05CBD6.quest_subtitle: "Optional: one terminal to rule them all"
	quest.07860310FF05CBD6.quest_desc: [
		"&eWhat:&r AE2 Wireless Terminals merges the crafting, pattern access and pattern encoding terminals into one Universal Terminal."
		"&eHow:&r combine two wireless terminals in a crafting grid (check JEI); add more by crafting them in again."
		"&eTip:&r a Magnet Card from the same mod pulls nearby drops straight into your network. A Quantum Bridge Card works across dimensions."
	]
	quest.5F84732A701D2559.title: "Infinite Range"
	quest.5F84732A701D2559.quest_subtitle: "Optional: no more range limit"
	quest.5F84732A701D2559.quest_desc: [
		"&eWhat:&r the Infinity Booster Card removes the Wireless Access Point's range limit within one dimension."
		"&eHow:&r a Nether Star, wireless boosters, eyes of ender and netherite ingots (check JEI). The star means fighting the Wither first."
		"&eTip:&r put it in the Wireless Access Point, not the terminal."
	]
	quest.0ADD4DC8D8127357.title: "Across Worlds"
	quest.0ADD4DC8D8127357.quest_subtitle: "Optional: your archive in every dimension"
	quest.0ADD4DC8D8127357.quest_desc: [
		"&eWhat:&r the Dimension Card lets a Wireless Access Point reach you in any dimension: the Nether, the Twilight Forest, the Moon."
		"&eHow:&r four Infinity Cards, four Nether Stars and an eye of ender (check JEI)."
		"&eTip:&r the access point's chunk must stay loaded while you're away."
	]
	quest.3E6BB0338E3344C9.title: "ME Requester"
	quest.3E6BB0338E3344C9.quest_subtitle: "Optional: keep stock topped up"
	quest.3E6BB0338E3344C9.quest_desc: [
		"&eWhat:&r the ME Requester keeps a set amount of an item in stock by ordering crafts automatically."
		"&eHow:&r check JEI. Set \"keep 64 HDPE\" and it never runs out."
		"&eTip:&r it needs autocrafting patterns for whatever it keeps in stock."
	]
	quest.0CC9A52C043BEE4C.title: "Requester Terminal"
	quest.0CC9A52C043BEE4C.quest_subtitle: "Optional: every stock rule on one screen"
	quest.0CC9A52C043BEE4C.quest_desc: [
		"&eWhat:&r the Requester Terminal lists every ME Requester on the network, so you can edit all your stock rules from one place."
		"&eHow:&r an illuminated panel, a logic processor and a Requester, shapeless (check JEI)."
		"&eTip:&r keep a stock rule for each acid and solvent: H₂SO₄, HCl and HNO₃ are inputs to almost everything late game."
	]
	quest.68089090A4D213E6.title: "Entro Crystals"
	quest.68089090A4D213E6.quest_subtitle: "ExtendedAE's own budding crystal"
	quest.68089090A4D213E6.quest_desc: [
		"&eWhat:&r entro crystals feed every ExtendedAE machine. They grow like certus, from Budding Entroized Fluix."
		"&eHow:&r craft Entro Seeds (sand, ender dust, redstone, glowstone, sky dust), then right-click a placed Fluix Block with a seed to make it budding. Harvest the clusters."
		"&eTip:&r Growth Accelerators work on budding entro too."
	]
	quest.66ED4FE9373A352B.title: "Crystal Assembler"
	quest.66ED4FE9373A352B.quest_subtitle: "A crafting machine for AE2 parts"
	quest.66ED4FE9373A352B.quest_desc: [
		"&eWhat:&r the Crystal Assembler makes ExtendedAE's blocks from several items (and sometimes a fluid) at once."
		"&eHow:&r crush entro to dust in the Inscriber, drop it in water with a gold ingot and lapis for an entro ingot, then build a Machine Frame and the Assembler (check JEI)."
		"&eTip:&r it accepts pipes and patterns, so the network can drive it like any other machine."
	]
	quest.33967F89E0530A95.title: "ExtendedAE"
	quest.33967F89E0530A95.quest_subtitle: "Bigger providers and drives"
	quest.33967F89E0530A95.quest_desc: [
		"&eWhat:&r ExtendedAE adds larger versions of AE2 blocks: the Extended Pattern Provider holds many more patterns, the Extended Drive many more cells."
		"&eHow:&r made in the Crystal Assembler from the normal blocks plus concurrent processors (check JEI)."
		"&eTip:&r one extended provider can feed a whole row of chemical reactors."
	]
	quest.671135248AAD6760.title: "Wireless Connectors"
	quest.671135248AAD6760.quest_subtitle: "Optional: cables through thin air"
	quest.671135248AAD6760.quest_desc: [
		"&eWhat:&r a pair of Wireless Connectors links two parts of your network without a cable between them."
		"&eHow:&r made two at a time in the Crystal Assembler. Bind them with the Wireless Setup Kit (check JEI)."
		"&eTip:&r great for reaching a reactor room behind thick shielding."
	]
	quest.3770AEAFDC83097B.title: "Assembler Matrix"
	quest.3770AEAFDC83097B.quest_subtitle: "Optional: one multiblock, thousands of crafts"
	quest.3770AEAFDC83097B.quest_desc: [
		"&eWhat:&r the Assembler Matrix is a multiblock that replaces walls of molecular assemblers: crafter blocks do the work, pattern blocks hold the patterns."
		"&eHow:&r build a hollow box of frames and walls (or glass), with crafter, pattern and speed cores inside (check JEI for the rules)."
		"&eTip:&r it's for crafting-table recipes only. Processing patterns for MI machines still need pattern providers."
	]
	quest.7A9D33953F39D9E9.title: "Concurrent Processors"
	quest.7A9D33953F39D9E9.quest_subtitle: "ExtendedAE's own processor"
	quest.7A9D33953F39D9E9.quest_desc: [
		"&eWhat:&r concurrent processors go into nearly every Extended block: drives, providers, interfaces, inscribers and chargers."
		"&eHow:&r build the Concurrent Press in the Crystal Assembler (eyes of ender, entro crystals and a Silicon Press), inscribe entro crystals with it, then assemble the prints with printed silicon and redstone (check JEI)."
		"&eTip:&r the Crystal Assembler can also make AE2's normal processors from their prints. One machine fed by pipes keeps all of them stocked."
	]
	quest.3A03AD5658BF5053.title: "Extended Inscriber and Charger"
	quest.3A03AD5658BF5053.quest_subtitle: "Process several stacks at once"
	quest.3A03AD5658BF5053.quest_desc: [
		"&eWhat:&r the Extended Inscriber and Extended Charger work on several items in parallel, so processors and charged certus stop being a bottleneck."
		"&eHow:&r a normal Inscriber or Charger plus capacity cards and a concurrent processor, in the Crystal Assembler (check JEI)."
		"&eTip:&r the Circuit Slicer (also in JEI) cuts a whole storage block into nine prints at once: a gold block becomes nine printed logic circuits."
	]
	quest.64B349EC2D6CA5B6.title: "Extended Interface and IO Port"
	quest.64B349EC2D6CA5B6.quest_subtitle: "More slots, faster cell transfers"
	quest.64B349EC2D6CA5B6.quest_desc: [
		"&eWhat:&r the Extended Interface stocks many more item types than a normal one. The Extended IO Port empties and fills cells far faster than AE2's IO Port."
		"&eHow:&r both are made in the Crystal Assembler from the normal block plus cards and concurrent processors (check JEI)."
		"&eTip:&r an Extended Interface next to an MI machine can hold every input that machine needs, all at once."
	]
	quest.261AE8C2C2D39AC5.title: "Extended Pattern Access"
	quest.261AE8C2C2D39AC5.quest_subtitle: "Every pattern, searchable, from anywhere"
	quest.261AE8C2C2D39AC5.quest_desc: [
		"&eWhat:&r the Extended Pattern Access Terminal lists every pattern provider on the network with search and filters. The wireless version works from your pocket."
		"&eHow:&r a Pattern Access Terminal upgraded in the Crystal Assembler; add a wireless receiver and a dense energy cell for the wireless one (check JEI)."
		"&eTip:&r name your pattern providers in an anvil (Sulfuric Acid, Polyethylene) and the terminal groups them by name."
	]
	quest.7231154AB582EF98.title: "Smarter Buses"
	quest.7231154AB582EF98.quest_subtitle: "Optional: filter by tag, switch with a margin"
	quest.7231154AB582EF98.quest_desc: [
		"&eWhat:&r the Tag Storage Bus filters by item tag, so one bus can accept every dust or every ingot. The Threshold Level Emitter turns on at one amount and off at another."
		"&eHow:&r a storage bus or level emitter plus processors, a book or redstone torches, in a crafting table (check JEI)."
		"&eTip:&r a threshold emitter on an MI Electrolyzer stops it flickering: on below 10,000 mB of hydrogen, off above 50,000 mB."
	]
	quest.740C1D9B0EE26F7C.title: "MEGA Cells"
	quest.740C1D9B0EE26F7C.quest_subtitle: "Sky steel and million-byte cells"
	quest.740C1D9B0EE26F7C.quest_desc: [
		"&eWhat:&r MEGA Cells adds 1M to 256M cells, bulk cells and bigger crafting storage."
		"&eChemistry:&r sky steel is made by dropping charged certus, iron and sky stone into lava: heat drives the alloying, like a tiny smelter."
		"&eHow:&r throw the ingredients into a lava pool for sky steel, then build the 1M component (check JEI)."
	]
	quest.096161FE28A839F6.title: "Sky Bronze and Sky Osmium"
	quest.096161FE28A839F6.quest_subtitle: "Optional: more lava alloys"
	quest.096161FE28A839F6.quest_desc: [
		"&eWhat:&r the same lava trick with copper gives sky bronze, and with osmium gives sky osmium. Both go into MEGA's larger parts."
		"&eChemistry:&r bronze is really copper plus tin (Cu + Sn); here the sky stone plays the tin. Osmium (Os) is the densest natural element, 22.6 g/cm³."
		"&eHow:&r drop charged certus, the ingot and a sky stone block into lava together. Each throw makes two ingots."
	]
	quest.5160F2053D91D317.title: "Accumulation Processors"
	quest.5160F2053D91D317.quest_subtitle: "A press made from a singularity"
	quest.5160F2053D91D317.quest_desc: [
		"&eWhat:&r the accumulation processor is MEGA's fourth processor, needed for every 1M+ part."
		"&eHow:&r inscribe a singularity between the calculation and engineering presses to make the Accumulation Press, then print sky steel with it (check JEI)."
		"&eTip:&r keep the press. The Inscriber can copy it with an iron block, like the other presses."
	]
	quest.1665F7B5F4B8CBDF.title: "MEGA Crafting CPU"
	quest.1665F7B5F4B8CBDF.quest_subtitle: "Room for the biggest crafting jobs"
	quest.1665F7B5F4B8CBDF.quest_desc: [
		"&eWhat:&r MEGA crafting storage and units build a separate, much larger crafting CPU."
		"&eHow:&r check JEI. MEGA blocks only join other MEGA blocks, so build it as its own multiblock."
		"&eTip:&r the Seed of a New World chain is huge. One big CPU saves splitting the job by hand."
	]
	quest.6A29B228E6049846.title: "MEGA Pattern Provider"
	quest.6A29B228E6049846.quest_subtitle: "Optional: room for many more patterns"
	quest.6A29B228E6049846.quest_desc: [
		"&eWhat:&r a pattern provider with many more pattern slots than the normal one."
		"&eHow:&r made as a cable part and turned into a block in the crafting grid (check JEI)."
		"&eTip:&r put one on each multi-input MI machine, like the Chemical Reactor or the Large Diesel Generator's fuel line."
	]
	quest.606F92F0A56293B8.title: "Bulk Cells"
	quest.606F92F0A56293B8.quest_subtitle: "Optional: one item, practically no limit"
	quest.606F92F0A56293B8.quest_desc: [
		"&eWhat:&r a Bulk Item Cell holds a single item type in near-unlimited amounts. The Compression Card stores nuggets, ingots and blocks as one pool."
		"&eHow:&r the bulk component needs a 1M component and accumulation processors; the card is an advanced card plus a matter ball (check JEI)."
		"&eTip:&r perfect for cobblestone (condenser feed), salt dust or coal coke."
	]
	quest.38EEABF9A5AA71CB.title: "Four Million Bytes"
	quest.38EEABF9A5AA71CB.quest_subtitle: "Optional: the 4M component and MEGA housings"
	quest.38EEABF9A5AA71CB.quest_desc: [
		"&eWhat:&r MEGA components go up to 256M. They need MEGA cell housings, not AE2's."
		"&eHow:&r the 4M component is 1M components, accumulation processors, ender dust and vibrant quartz glass (check JEI for the bigger ones)."
		"&eTip:&r big cells pay off for bulk stocks like stone dusts and plastics. Keep many small cells for rare items instead."
	]
	quest.4E78EF5F2B0FEF48.title: "MEGA Energy"
	quest.4E78EF5F2B0FEF48.quest_subtitle: "Optional: a huge AE buffer and a stronger card"
	quest.4E78EF5F2B0FEF48.quest_desc: [
		"&eWhat:&r the MEGA Energy Cell is eight dense cells around an accumulation processor. The Greater Energy Card gives portable tools and terminals far more charge."
		"&eHow:&r both in a crafting table (check JEI). The card is an advanced card plus a MEGA energy cell."
		"&eTip:&r one MEGA cell is plenty for a Quantum Computer's burst of crafting."
	]
	quest.6ABB15806114CC83.title: "Gas in the Network"
	quest.6ABB15806114CC83.quest_subtitle: "Store Mekanism chemicals in AE2"
	quest.6ABB15806114CC83.quest_desc: [
		"&eWhat:&r Applied Mekanistics lets AE2 store and move Mekanism chemicals: H₂, O₂, Cl₂, HCl, SO₂ and the rest."
		"&eChemistry:&r a 1k cell holds a lot of gas because the network stores amounts, not tanks. Real gases need pressure vessels."
		"&eHow:&r a chemical cell housing (osmium, quartz glass, redstone) + a 1k component. Import buses on chemical tanks fill it."
		"&eTip:&r processing patterns can pull stored SO₂ and O₂ straight from the cell to feed your sulfuric acid line."
	]
	quest.52CB2FB63C5C2051.title: "A Tank Farm in a Cell"
	quest.52CB2FB63C5C2051.quest_subtitle: "Optional: 64k of chemicals"
	quest.52CB2FB63C5C2051.quest_desc: [
		"&eWhat:&r a 64k chemical cell replaces a room full of chemical tanks."
		"&eChemistry:&r one mole of any ideal gas fills about 22.4 L at 0 °C and 1 atm. Stored as data, it fills nothing at all."
		"&eHow:&r chemical housing plus a 64k component, or upgrade a smaller cell in the crafting grid (check JEI)."
	]
	quest.049F324F4DE92733.title: "Shielded Storage"
	quest.049F324F4DE92733.quest_subtitle: "Optional: a cell for hot chemicals"
	quest.049F324F4DE92733.quest_desc: [
		"&eWhat:&r normal chemical cells refuse radioactive chemicals. MEGA's Radioactive Chemical Cell holds one, like nuclear waste or plutonium."
		"&eChemistry:&r spent fuel stays dangerous because unstable nuclei keep decaying, giving off α, β and γ radiation for years."
		"&eHow:&r check JEI for the radioactive component and cell."
		"&eTip:&r a cell never leaks, unlike a broken tank. It's the safest place to keep waste before you reprocess it."
	]
	quest.4B1B2296A5EDEB45.title: "Energy in a Cell"
	quest.4B1B2296A5EDEB45.quest_subtitle: "Applied Flux stores FE in AE2"
	quest.4B1B2296A5EDEB45.quest_desc: [
		"&eWhat:&r Applied Flux stores FE in AE2 cells and moves it through the network with Flux Accessors."
		"&eHow:&r redstone crystal (redstone block, fluix and glowstone dropped in water) → charge it in the AE2 Charger → FE cell core and housing (check JEI)."
		"&eTip:&r the housing needs insulating resin, which needs silicon: a little chemistry even here."
	]
	quest.136207F7A3DC6A3C.title: "Flux Accessor"
	quest.136207F7A3DC6A3C.quest_subtitle: "Power machines from the network"
	quest.136207F7A3DC6A3C.quest_desc: [
		"&eWhat:&r a Flux Accessor pushes FE from your FE cells into any machine it touches. An Induction Card lets an I/O bus or interface do the same."
		"&eHow:&r an energy acceptor, energy processors (iron block charged into the Energy Press, then inscribed), copper and glowstone (check JEI)."
		"&eTip:&r one FE cell plus accessors can replace a tangle of power cables around a dense machine room."
	]
	quest.7FFFA15128FCBD88.title: "Reaction Chamber"
	quest.7FFFA15128FCBD88.quest_subtitle: "AdvancedAE's powered reactor"
	quest.7FFFA15128FCBD88.quest_desc: [
		"&eWhat:&r AdvancedAE's Reaction Chamber combines items and a fluid with lots of energy. Its first job: shattering singularities."
		"&eHow:&r a matter condenser, a vibration chamber, fluix dust, glowstone and a bucket (check JEI). Feed it a singularity, ender dust, sky dust and lava."
		"&eTip:&r it uses a lot of power per craft. Put it on its own Energy Acceptor."
	]
	quest.43A72FAC8EB012CB.title: "Quantum Alloy"
	quest.43A72FAC8EB012CB.quest_subtitle: "Copper, singularities and quantum infusion"
	quest.43A72FAC8EB012CB.quest_desc: [
		"&eWhat:&r quantum alloy is AdvancedAE's top material, for the quantum computer and gear."
		"&eHow:&r press a shattered singularity into quantum-infused dust, react it with water into Quantum Infusion, then react that with copper ingots, singularities and shattered singularities (check JEI)."
		"&eChemistry:&r copper (Cu) is the base for a reason: after silver it's the best electrical conductor of any metal."
	]
	quest.4FBB5D1C1A7FC218.title: "Directional Providers"
	quest.4FBB5D1C1A7FC218.quest_subtitle: "Send each ingredient to the right face"
	quest.4FBB5D1C1A7FC218.quest_desc: [
		"&eWhat:&r the Advanced Pattern Provider lets a processing pattern send each input to a chosen side of the machine."
		"&eHow:&r an Extended Pattern Provider, a logic processor, an ender pearl and redstone (check JEI). Encode patterns in the Advanced Pattern Encoder."
		"&eTip:&r ideal for machines with separate input faces, like a Mekanism machine that takes gas on one side and items on another."
	]
	quest.423E95AFA4363CFD.title: "Quantum Computer"
	quest.423E95AFA4363CFD.quest_subtitle: "Optional: the archive learns to think"
	quest.423E95AFA4363CFD.quest_desc: [
		"&6You remember thinking a thousand thoughts at once. The machine remembers how, too.&r"
		"&eWhat:&r the Quantum Computer is a multiblock crafting CPU: huge storage, many parallel jobs, and accelerators that multiply speed."
		"&eHow:&r a Quantum Core inside a shell of Quantum Structure blocks, with multi-threaders, accelerators and storage blocks (check JEI for size limits)."
		"&eTip:&r build it next to your main pattern providers so every chemical line can run at once."
	]
	quest.39E28A8F48D7260F.title: "Quantum Processors"
	quest.39E28A8F48D7260F.quest_subtitle: "AdvancedAE's processor, printed on quantum alloy"
	quest.39E28A8F48D7260F.quest_desc: [
		"&eWhat:&r quantum processors go into the Quantum Computer's parts, quantum gear and AdvancedAE's best buses."
		"&eHow:&r press a shattered singularity between the logic and engineering presses for the Quantum Press. Inscribe quantum alloy with it, then add redstone and printed silicon (check JEI)."
		"&eTip:&r copy the Quantum Press before you use it in automation, like the other presses."
	]
	quest.007EDC75C12A0DBE.title: "Quantum Armour"
	quest.007EDC75C12A0DBE.quest_subtitle: "Optional: armour wired into the network"
	quest.007EDC75C12A0DBE.quest_desc: [
		"&eWhat:&r quantum armour is netherite armour rebuilt around quantum processors, with slots for AdvancedAE's armour cards."
		"&eHow:&r each piece needs its netherite piece, quantum alloy plates, quantum processors and a quantum storage component (check JEI)."
		"&eTip:&r cards like Magnet, Night Vision and Step Assist are built on the Quantum Upgrade Base. Flight in this pack comes from chemistry (pylons, jetpacks, the Angel Ring), not from AE2."
	]
	quest.56AC603AD4E1D10D.title: "Import and Export Cards"
	quest.56AC603AD4E1D10D.quest_subtitle: "Optional: your inventory, auto-sorted"
	quest.56AC603AD4E1D10D.quest_desc: [
		"&eWhat:&r these cards go in a wireless terminal. The Import Card pushes chosen items from your inventory into the network; the Export Card keeps chosen items stocked in your inventory."
		"&eHow:&r an import (or export) bus, redstone blocks, an advanced card and processors (check JEI)."
		"&eTip:&r set the Import Card to cobblestone, dirt and raw ores, and mining trips never fill your inventory."
	]
	quest.0793BD80DC7ABE69.title: "Packaged Extended Crafting"
	quest.0793BD80DC7ABE69.quest_subtitle: "Optional: autocraft on the big tables"
	quest.0793BD80DC7ABE69.quest_desc: [
		"&eWhat:&r Packaged ExCrafting adds crafters that run Extended Crafting recipes from packages: one for each table size, plus combination and ender crafting."
		"&eHow:&r an auto table of the right size, an ME package component, crystaltine components, black iron and a redstone catalyst (check JEI)."
		"&eTip:&r encode the recipe in the Packaged Auto encoder, just like normal packages."
	]
	quest.24D6EC7D3175543C.title: "The Ultimate Crafter"
	quest.24D6EC7D3175543C.quest_subtitle: "Optional: 9x9 recipes on demand"
	quest.24D6EC7D3175543C.quest_desc: [
		"&eWhat:&r the Ultimate Crafter runs 9x9 Ultimate Table recipes automatically from the network."
		"&eHow:&r same recipe as the basic crafter, with an Ultimate Auto Table in the middle (check JEI)."
		"&eTip:&r the Seed of a New World is a 9x9 recipe. Feed it from the network and the capstone crafts itself once its ingredients exist."
	]
	quest.732A1D66682FA86D.title: "Co-Processors"
	quest.732A1D66682FA86D.quest_subtitle: "More jobs at once, and a window into them"
	quest.732A1D66682FA86D.quest_desc: [
		"&eWhat:&r each Crafting Co-Processing Unit lets a CPU run one more step at the same time. The Crafting Monitor shows what the CPU is making."
		"&eHow:&r a crafting unit plus an engineering processor makes a co-processor; a crafting unit plus a storage monitor makes the monitor (check JEI)."
		"&eTip:&r co-processors only help if the machines can keep up. Ten acid patterns on one Chemical Reactor still run one at a time."
	]
	quest.15508397E54C44E6.title: "A Bigger Plan"
	quest.15508397E54C44E6.quest_subtitle: "Crafting storage for long chains"
	quest.15508397E54C44E6.quest_desc: [
		"&eWhat:&r crafting storage limits how big a job a CPU can plan. Long chemical chains need far more than 1k."
		"&eHow:&r a crafting unit plus a 16k or 64k cell component (check JEI). Add them to the CPU's solid box."
		"&eTip:&r build two CPUs instead of one huge one, so a long job doesn't block a quick request."
	]
	quest.02D7A1418218250D.title: "ME Interfaces"
	quest.02D7A1418218250D.quest_subtitle: "Stock a machine, or join two networks"
	quest.02D7A1418218250D.quest_desc: [
		"&eWhat:&r an interface keeps chosen items stocked in itself for pipes and machines to pull. A storage bus on an interface lets one network see into another."
		"&eHow:&r iron, glass, an annihilation core and a formation core (check JEI). Set the items to keep in its top row."
		"&eTip:&r a subnetwork for one chemical line, joined to the main network through an interface, keeps channels free."
	]
	quest.4406D049ECD7E7BB.title: "Pattern Access Terminal"
	quest.4406D049ECD7E7BB.quest_subtitle: "Every provider's patterns on one screen"
	quest.4406D049ECD7E7BB.quest_desc: [
		"&eWhat:&r the Pattern Access Terminal shows the patterns in every pattern provider, so you can add or swap them without walking to each machine."
		"&eHow:&r an illuminated panel, an engineering processor and a pattern provider, shapeless (check JEI)."
		"&eTip:&r one terminal next to your Pattern Encoding Terminal makes a tidy crafting desk."
	]
	quest.35F3D5EA62AB545F.title: "Charged Certus"
	quest.35F3D5EA62AB545F.quest_subtitle: "A crystal holding a jolt"
	quest.35F3D5EA62AB545F.quest_desc: [
		"&eWhat:&r the Charger puts energy into certus crystals. Charged certus is the key to fluix, crystal growth and many AE2 recipes."
		"&eChemistry:&r real quartz is piezoelectric: squeeze it and it makes a voltage, push a voltage into it and it flexes. AE2 imagines it can store the charge."
		"&eHow:&r the Charger is iron and copper ingots (check JEI). Power it with FE and put certus crystals in."
		"&eTip:&r a Crank on top of the Charger works too, slowly, if your power isn't up yet."
	]
	quest.3AA7CCC895AD04F0.title: "Fluix"
	quest.3AA7CCC895AD04F0.quest_subtitle: "Certus, quartz and redstone, in water"
	quest.3AA7CCC895AD04F0.quest_desc: [
		"&eWhat:&r fluix crystals carry AE2's channels: every cable, core and most parts need fluix."
		"&eChemistry:&r a reaction in solution: charged certus, nether quartz and redstone dropped together in water fuse into fluix. Real crystals also grow fastest from a seed in solution."
		"&eHow:&r throw charged certus, nether quartz and redstone into a water block: you get two fluix crystals. Grind fluix in the Inscriber for dust; four crystals make a block."
		"&eTip:&r a fluix block is what ExtendedAE's entro seeds are planted on."
	]
	quest.4EE0310E1069717A.title: "Budding Certus by Hand"
	quest.4EE0310E1069717A.quest_subtitle: "Grow your own crystal farm"
	quest.4EE0310E1069717A.quest_desc: [
		"&eWhat:&r a certus quartz block dropped in water with charged certus becomes Damaged Budding Certus; repeat to climb to Chipped and better. Budding blocks grow certus buds."
		"&eHow:&r throw a certus block and a charged crystal into water together (JEI's transform tab). AdvancedAE's Reaction Chamber can do eight at a time."
		"&eTip:&r lower-grade budding blocks decay as they grow. Keep a stock of charged certus to remake them."
	]
	quest.31588D043F199E47.title: "Ender Dust"
	quest.31588D043F199E47.quest_subtitle: "Ground pearls"
	quest.31588D043F199E47.quest_desc: [
		"&eWhat:&r ender pearls ground into dust in the Inscriber. Entangled singularities, entro seeds and wireless parts use it."
		"&eHow:&r put an ender pearl in the Inscriber with no press."
		"&eTip:&r an enderman model in a Simulation Chamber keeps the pearls coming."
	]
	quest.6DB07A0E0C18A4CB.title: "Tiny TNT"
	quest.6DB07A0E0C18A4CB.quest_subtitle: "Small bangs for quantum science"
	quest.6DB07A0E0C18A4CB.quest_desc: [
		"&eWhat:&r a small explosive made from quartz dust and gunpowder."
		"&eChemistry:&r gunpowder is potassium nitrate, charcoal and sulfur: 2KNO₃ + S + 3C → K₂S + N₂ + 3CO₂. The gases expanding all at once are the bang."
		"&eHow:&r drop a singularity and ender dust together, then set off Tiny TNT next to them: you get a pair of Quantum Entangled Singularities."
		"&eTip:&r set it off away from anything you care about. It is still TNT."
	]
	quest.1AED651855E02225.title: "Cards That Change a Part"
	quest.1AED651855E02225.quest_subtitle: "Fuzzy, inverter, crafting, redstone"
	quest.1AED651855E02225.quest_desc: [
		"&eWhat:&r Fuzzy matches items by damage or ignores their data; Inverter turns a whitelist into a blacklist; Crafting lets a bus order what it lacks; Redstone switches a part by signal."
		"&eHow:&r each is a basic or advanced card plus one extra item (check JEI). Slot them into the part's upgrade slots."
		"&eTip:&r an export bus with a Crafting Card and a Redstone Card makes items only when a machine asks for them."
	]
	quest.5F3A3A91F04E760E.title: "Energy, Split and Overflow"
	quest.5F3A3A91F04E760E.quest_subtitle: "Cards for tools and storage cells"
	quest.5F3A3A91F04E760E.quest_desc: [
		"&eWhat:&r the Energy Card adds charge to portable terminals and tools. Equal Distribution spreads items evenly over a cell's partitions; Overflow Destruction deletes what a full cell can't hold."
		"&eHow:&r each is a basic or advanced card plus a few items (check JEI). Cell cards go in through the Cell Workbench."
		"&eTip:&r an overflow card on a cobblestone cell stops a generator from filling your whole network."
	]
	quest.4AA0804D5C3521EA.title: "4k Components"
	quest.4AA0804D5C3521EA.quest_subtitle: "Three 1k components and a processor"
	quest.4AA0804D5C3521EA.quest_desc: [
		"&eWhat:&r the first step up: a 4k component holds four times as many bytes as a 1k."
		"&eHow:&r three 1k components around quartz glass, with redstone and a calculation processor (check JEI)."
		"&eTip:&r split an empty 1k cell in the crafting grid to get its housing back for the bigger component."
	]
	quest.0D2DB0C5B5689C1A.title: "256k Component"
	quest.0D2DB0C5B5689C1A.quest_subtitle: "The biggest cell in base AE2"
	quest.0D2DB0C5B5689C1A.quest_desc: [
		"&eWhat:&r the top AE2 component: 256 kilobytes for a single cell."
		"&eHow:&r three 64k components around quartz glass, with sky stone dust and a calculation processor (check JEI)."
		"&eTip:&r a cell spends bytes on every new item type, so put bulk stock here and rare items elsewhere."
	]
	quest.14720B35A2C4785D.title: "Planes"
	quest.14720B35A2C4785D.quest_subtitle: "Break blocks in, place blocks out"
	quest.14720B35A2C4785D.quest_desc: [
		"&eWhat:&r the Annihilation Plane breaks the block in front of it (or picks up items) into the network; the Formation Plane places blocks or drops items out of it."
		"&eHow:&r fluix crystals with an annihilation or formation core (check JEI). Put them on a cable facing the space."
		"&eTip:&r an annihilation plane in front of a cobblestone generator feeds the Matter Condenser with no pipes."
	]
	quest.5D65AF6211578AC7.title: "Active Formation Plane"
	quest.5D65AF6211578AC7.quest_subtitle: "Push items into whatever is in front"
	quest.5D65AF6211578AC7.quest_desc: [
		"&eWhat:&r ExtendedAE's plane inserts items straight into the inventory it faces instead of dropping them."
		"&eHow:&r a formation plane upgraded with ExtendedAE parts (check JEI)."
		"&eTip:&r handy for filling machines that don't accept a storage bus."
	]
	quest.06B6E959227F5BB6.title: "IO Port and ME Chest"
	quest.06B6E959227F5BB6.quest_subtitle: "Move whole cells at once"
	quest.06B6E959227F5BB6.quest_desc: [
		"&eWhat:&r the IO Port empties a cell into the network (or fills a cell from it). The ME Chest is a one-cell drive with its own terminal."
		"&eHow:&r the IO Port is glass, two drives, fluix cable, iron and a logic processor; the ME Chest is glass, a terminal, fluix cable, iron and copper (check JEI)."
		"&eTip:&r upgrading 4k cells to 64k? Run the old cells through an IO Port first."
	]
	quest.4447903D72FA5B90.title: "Toggle Bus and Cable Anchors"
	quest.4447903D72FA5B90.quest_subtitle: "Switch a branch, keep cables apart"
	quest.4447903D72FA5B90.quest_desc: [
		"&eWhat:&r a Toggle Bus connects or cuts a branch of cable by redstone. Cable Anchors stop two neighbouring cables joining."
		"&eHow:&r toggle bus: fluix glass cable, redstone and a lever. Anchors: cut any metal ingot with a Certus or Nether Quartz Cutting Knife (4 at a time)."
		"&eTip:&r put a toggle bus in front of a subnetwork you only want running sometimes, like a long autocrafting line."
	]
	quest.45E7618F9628A70D.title: "Wireless Access Point"
	quest.45E7618F9628A70D.quest_subtitle: "Where every wireless terminal connects"
	quest.45E7618F9628A70D.quest_desc: [
		"&eWhat:&r the Wireless Access Point sends your network a short distance through the air. Boosters raise its range; any wireless terminal links to it."
		"&eHow:&r access point: a wireless receiver (fluix pearl, quartz fibre, iron) over a calculation processor and fluix cable. Boosters: fluix dust, certus, ender dust and iron (check JEI)."
		"&eTip:&r put the terminal in the access point once to link it, and keep it charged in the Charger."
	]
	quest.26BA1E4C00A29726.title: "Quantum Bridge Card"
	quest.26BA1E4C00A29726.quest_subtitle: "Your terminal, through an entangled pair"
	quest.26BA1E4C00A29726.quest_desc: [
		"&eWhat:&r this AE2 Wireless Terminals card lets your universal terminal reach the network through quantum entanglement, from any distance or dimension."
		"&eHow:&r quantum rings, a Quantum Link Chamber and an advanced card (check JEI). Put it in the terminal; its tooltip explains how to pair it."
		"&eTip:&r the network's end must stay chunk-loaded."
	]
	quest.7257CA35618CA7BF.title: "AE2 Powered Tools"
	quest.7257CA35618CA7BF.quest_subtitle: "Any two: heat and cool, paint, zap"
	quest.7257CA35618CA7BF.quest_desc: [
		"&eWhat:&r the Entropy Manipulator heats or cools blocks (water to ice, cobblestone to stone, lava to obsidian); the Color Applicator paints cables; the Charged Staff zaps mobs."
		"&eChemistry:&r the manipulator follows real phase changes: removing heat freezes water, and lava cools into obsidian when it loses heat too fast to crystallise."
		"&eHow:&r each uses an energy cell and processors (check JEI). Charge them in the Charger."
		"&eTip:&r colour-coding cables keeps two neighbouring networks from merging."
	]
	quest.67C615814E0346D9.title: "Matter Cannon"
	quest.67C615814E0346D9.quest_subtitle: "The heavier the atom, the harder it hits"
	quest.67C615814E0346D9.quest_desc: [
		"&eWhat:&r the Matter Cannon fires matter balls or metal nuggets from a cell inside it."
		"&eChemistry:&r AE2 rates each nugget by its element's real atomic mass: iron 55.8, osmium 190.2, uranium 238. Heavier atoms carry more momentum at the same speed, so they hit harder."
		"&eHow:&r a Matter Condenser set to Matter Balls makes ammo. The cannon is iron, a formation core, a 4k component and an energy cell (check JEI). Its tooltip shows how to load ammo."
		"&eTip:&r osmium and uranium nuggets are the best ammo you'll have spare."
	]
	quest.41D5614938BB0331.title: "A Press With Your Name"
	quest.41D5614938BB0331.quest_subtitle: "Secret: label anything in the Inscriber"
	quest.41D5614938BB0331.quest_desc: [
		"&eWhat:&r the Inscriber Name Press. Rename it in an anvil, then press any item with it to give that item the name."
		"&eTip:&r every chemist labels their bottles. Now you can label everything."
	]
	quest.3345DF7236466D75.title: "Fluix Sword"
	quest.3345DF7236466D75.quest_subtitle: "Optional: a crystal blade"
	quest.3345DF7236466D75.quest_desc: [
		"&eWhat:&r a sword with a fluix crystal edge. Compare its stats with iron in JEI."
		"&eHow:&r fluix crystals and a stick, like any sword (check JEI)."
		"&eTip:&r AE2 also makes certus and fluix tools if you like the look."
	]
	quest.41E4A1BAA00E0A6E.title: "Spatial IO"
	quest.41E4A1BAA00E0A6E.quest_subtitle: "Cut a room out of the world"
	quest.41E4A1BAA00E0A6E.quest_desc: [
		"&eWhat:&r Spatial Pylons frame a box; the Spatial IO Port stores everything inside it in a spatial cell, and can put it back elsewhere. The Spatial Anchor keeps a network's chunks loaded."
		"&eHow:&r pylons are fluix and quartz glass; the port and anchor add processors and spatial components (check JEI and the AE2 guidebook)."
		"&eTip:&r the stored room becomes a real dimension you can visit. Ask before you move someone else's base."
	]
	quest.167FA55B833918AF.title: "Matrix Speed and Walls"
	quest.167FA55B833918AF.quest_subtitle: "A faster Assembler Matrix"
	quest.167FA55B833918AF.quest_desc: [
		"&eWhat:&r Speed Cores make the Assembler Matrix craft faster; walls close its shell more cheaply than frames."
		"&eHow:&r both come from the Crystal Assembler with concurrent processors and entro (check JEI)."
		"&eTip:&r more crafter cores add parallel jobs; speed cores make each job finish sooner."
	]
	quest.61E774E4778CD356.title: "ME Canner"
	quest.61E774E4778CD356.quest_subtitle: "Fill and empty containers for autocrafting"
	quest.61E774E4778CD356.quest_desc: [
		"&eWhat:&r the ME Canner fills buckets, cells and other containers from the network, or empties them back in."
		"&eChemistry:&r many recipes still ask for a bucket of acid. The canner means the network can hand over 1,000 mB of H₂SO₄ in a bucket without you."
		"&eHow:&r made in the Crystal Assembler (check JEI). Set Fill or Empty mode in its GUI and give it patterns through a provider."
	]
	quest.6A53C98F6B5D669D.title: "Circuit Slicer"
	quest.6A53C98F6B5D669D.quest_subtitle: "A storage block into nine prints"
	quest.6A53C98F6B5D669D.quest_desc: [
		"&eWhat:&r the Circuit Slicer cuts a whole block (gold, diamond, silicon, certus) into nine printed circuits at once."
		"&eHow:&r made in the Crystal Assembler (check JEI). Put the matching press-style blade in and feed it blocks."
		"&eTip:&r a silicon block becomes nine printed silicon. That's an MI ingot line feeding AE2 nine at a time."
	]
	quest.3F280E221B8CB5BE.title: "Keeping Entro Growing"
	quest.3F280E221B8CB5BE.quest_subtitle: "Budding entro and the Crystal Fixer"
	quest.3F280E221B8CB5BE.quest_desc: [
		"&eWhat:&r budding entro decays as it grows clusters, from fully to mostly to half to hardly entroized. The Crystal Fixer restores it with fresh material."
		"&eHow:&r the fixer comes from the Crystal Assembler (check JEI). Put it next to a budding block and give it what its GUI asks for."
		"&eTip:&r it works on budding certus too, so one fixer keeps both farms alive."
	]
	quest.7EF291158B90A46F.title: "ME Void Cell"
	quest.7EF291158B90A46F.quest_subtitle: "Trash, matter balls or singularities"
	quest.7EF291158B90A46F.quest_desc: [
		"&eWhat:&r a cell that destroys what you send it. Its modes delete items, turn them into Matter Balls, or compress them into Singularities."
		"&eHow:&r check JEI. Partition it to cobblestone in a Cell Workbench and put it in a drive."
		"&eTip:&r on Singularity mode it replaces the Matter Condenser for AdvancedAE and MEGA's singularity needs."
	]
	quest.3785AD22B4BFBE03.title: "Wireless Hub"
	quest.3785AD22B4BFBE03.quest_subtitle: "Many wireless links, one block"
	quest.3785AD22B4BFBE03.quest_desc: [
		"&eWhat:&r the ME Wireless Setup Kit binds wireless connectors; the ME Wireless Hub takes many wireless links at one point."
		"&eHow:&r both come from the Crystal Assembler (check JEI). Use the kit on one end, then the other."
		"&eTip:&r one hub in the middle of your base, linked out to every outpost room."
	]
	quest.642DEBE4D8CDB237.title: "The MEGA Ladder"
	quest.642DEBE4D8CDB237.quest_subtitle: "1M up to 16M"
	quest.642DEBE4D8CDB237.quest_desc: [
		"&eWhat:&r MEGA components climb by four each step: 1M, 4M, 16M, 64M, 256M."
		"&eHow:&r each one is three of the last with accumulation processors (check JEI)."
		"&eTip:&r a MEGA cell needs a MEGA housing; AE2 housings won't take these components."
	]
	quest.0E1219045D005E45.title: "Challenge: 256M"
	quest.0E1219045D005E45.quest_subtitle: "The largest component there is"
	quest.0E1219045D005E45.quest_desc: [
		"&6Every name of every thing, and room to spare. You remember this kind of memory.&r"
		"&eWhat:&r the 64M and 256M MEGA components, the top of AE2 storage in this pack."
		"&eHow:&r keep climbing the ladder (check JEI). Bulk cells and accumulation processors keep it affordable."
	]
	quest.2EAE22CFCB5FBC80.title: "A Pocket Archive"
	quest.2EAE22CFCB5FBC80.quest_subtitle: "Optional: 256M in your inventory"
	quest.2EAE22CFCB5FBC80.quest_desc: [
		"&eWhat:&r a portable cell with a 256M component: a whole storage network you carry, no drive needed."
		"&eHow:&r a 256M component in a portable cell housing with an energy cell (check JEI). Charge it first."
		"&eTip:&r perfect for a long trip to another planet."
	]
	quest.7090BF1A6ACCFCD5.title: "Advanced Pattern Encoder"
	quest.7090BF1A6ACCFCD5.quest_subtitle: "Pick a face for each ingredient"
	quest.7090BF1A6ACCFCD5.quest_desc: [
		"&eWhat:&r the encoder adds side information to a processing pattern, so an Advanced Pattern Provider sends each input to the right face."
		"&eHow:&r check JEI. Put a pattern in, set each input's side, and take it out."
		"&eTip:&r a Mekanism PRC takes items, a fluid and a gas on different sides: perfect for this."
	]
	quest.4A0F9E21A373D41D.title: "A Bigger Quantum Computer"
	quest.4A0F9E21A373D41D.quest_subtitle: "Units, accelerators and storage"
	quest.4A0F9E21A373D41D.quest_desc: [
		"&eWhat:&r Quantum Crafting Units fill the Quantum Computer's shell; accelerators add parallel jobs; storage blocks raise how big a job it can plan."
		"&eHow:&r all need shattered singularities and quantum parts (check JEI; ExtendedAE changes a few recipes)."
		"&eTip:&r storage first: a long chemical chain fails to plan long before it runs short of threads."
	]
	quest.45B43718DAF8FF7C.title: "Challenge: Quantum Data Entangler"
	quest.45B43718DAF8FF7C.quest_subtitle: "Multiply the computer's memory"
	quest.45B43718DAF8FF7C.quest_desc: [
		"&eWhat:&r the 256M Quantum Storage block, and the Quantum Data Entangler, which multiplies the whole computer's storage (a few per multiblock)."
		"&eHow:&r both need quantum storage, quantum units and shattered singularities (check JEI)."
		"&eTip:&r one entangler is usually enough for the Seed of a New World chain."
	]
	quest.641030E10A5328A9.title: "Quantum Crafter"
	quest.641030E10A5328A9.quest_subtitle: "An assembler that keeps stock"
	quest.641030E10A5328A9.quest_desc: [
		"&eWhat:&r the Quantum Crafter crafts patterns over and over with no CPU, keeping a set amount in stock."
		"&eHow:&r quantum accelerators, a quantum unit, 64k components and shattered singularities (check JEI)."
		"&eTip:&r set it to keep plates and wires in stock; the CPU stays free for the long chains."
	]
	quest.139AEA4F1FC0C461.title: "Quantum Upgrade Base"
	quest.139AEA4F1FC0C461.quest_subtitle: "The blank behind every armour card"
	quest.139AEA4F1FC0C461.quest_desc: [
		"&eWhat:&r the blank card that every Quantum Armour card is built on."
		"&eHow:&r a quantum alloy plate surrounded by quantum processors (check JEI)."
	]
	quest.396979F7EE253206.title: "Armour Cards: Movement"
	quest.396979F7EE253206.quest_subtitle: "Any two: speed, step, jump, swim, reach"
	quest.396979F7EE253206.quest_desc: [
		"&eWhat:&r cards for Quantum Armour: faster walking, sprinting and swimming, step assist, higher jumps and longer reach."
		"&eHow:&r a Quantum Upgrade Base plus a few items each (check JEI). Install them in the armour piece's GUI."
		"&eTip:&r flight is not on this list on purpose: in this pack it comes from chemistry (pylons, jetpacks, the Angel Ring)."
	]
	quest.149697C62123CCCA.title: "Armour Cards: Survival"
	quest.149697C62123CCCA.quest_subtitle: "Any two: health, regen, evasion and more"
	quest.149697C62123CCCA.quest_desc: [
		"&eWhat:&r extra health, regeneration, a chance to dodge, lava immunity, water breathing, night vision, or eating from your network when hungry."
		"&eHow:&r a Quantum Upgrade Base plus a few items each (check JEI)."
		"&eTip:&r Auto Feeding pulls food from the ME network, so stock a farm's output there."
	]
	quest.6E6993C23E508954.title: "Armour Cards: Utility"
	quest.6E6993C23E508954.quest_subtitle: "Any two: magnet, auto stock, recharging and more"
	quest.6E6993C23E508954.quest_desc: [
		"&eWhat:&r Magnet pulls in drops; Auto Stock refills your inventory from the network; ME Recharging charges your armour from it; Pick Craft orders the block you're looking at; plus a portable workbench, luck, strength and attack speed."
		"&eHow:&r a Quantum Upgrade Base plus quantum alloy and a few items each (check JEI)."
		"&eTip:&r Auto Stock plus a Magnet means you never visit storage for torches or scaffolding again."
	]
	chapter.081BBC14B8F2A34A.title: "Ars Nouveau"
	chapter.081BBC14B8F2A34A.chapter_subtitle: [
		"Spellcraft, Source, rituals and the Wilden: magic that runs on stored energy."
	]
	quest.4A082B2D50268C72.title: "Novice Spell Book"
	quest.4A082B2D50268C72.quest_subtitle: "Your first spells"
	quest.4A082B2D50268C72.quest_desc: [
		"&6You remember speaking and the world listening. The words come back slowly.&r"
		"&eWhat:&r the Novice Spell Book holds spells built from glyphs: a form (how it's cast), effects, then augments."
		"&eHow:&r a book with an iron shovel, pickaxe, axe and sword (shapeless). Open it to combine glyphs, e.g. Projectile + Break to mine at range."
		"&eTip:&r the Worn Notebook explains every glyph. Mana regenerates over time."
	]
	quest.42317C39DA4FD3E1.title: "Archwood Logs"
	quest.42317C39DA4FD3E1.quest_subtitle: "Any colour of magic wood"
	quest.42317C39DA4FD3E1.quest_desc: [
		"&eWhat:&r archwood is the wood Ars Nouveau builds with: the Scribe's Table, Source Jars, the Imbuement Chamber and every ritual tablet."
		"&eHow:&r find the bright red, blue, green or purple trees in archwood forests and cut any 16 logs. Bring saplings home too."
		"&eTip:&r ritual tablets ask for a specific colour (purple for Flight and Binding, green for farming rituals), so plant all four."
	]
	quest.5AF9082F7AD1DE7C.title: "Scribe's Table"
	quest.5AF9082F7AD1DE7C.quest_subtitle: "Write new glyphs into your book"
	quest.5AF9082F7AD1DE7C.quest_desc: [
		"&eWhat:&r the Scribe's Table crafts new glyphs, which unlock more spell parts."
		"&eHow:&r archwood slabs, gold nuggets and archwood logs. Put your spell book on it and pick a glyph; each costs items and experience."
		"&eTip:&r Light and Harvest are cheap early glyphs that pay off right away."
	]
	quest.619D1CA1E2F34139.title: "Source"
	quest.619D1CA1E2F34139.quest_subtitle: "Store magic, then spend it"
	quest.619D1CA1E2F34139.quest_desc: [
		"&eWhat:&r Source is Ars Nouveau's magical energy. Jars store it; the Imbuement Chamber spends it to make source gems and essences."
		"&eHow:&r jars are glass and archwood slabs; the chamber is archwood planks and gold. Place jars near the chamber; they share Source within a few blocks."
		"&eTip:&r empty jars do nothing. The next step is a Sourcelink to fill them."
	]
	quest.094B0B47A8BEB3F8.title: "Volcanic Sourcelink"
	quest.094B0B47A8BEB3F8.quest_subtitle: "Turn fuel into Source"
	quest.094B0B47A8BEB3F8.quest_desc: [
		"&eWhat:&r the Volcanic Sourcelink burns fuel and pushes the Source into nearby jars."
		"&eChemistry:&r burning is fast oxidation: C + O₂ → CO₂ plus heat. The sourcelink claims that energy as Source."
		"&eHow:&r two source gems, two gold ingots and a lava bucket. Feed it logs or coal with a hopper or pipe."
		"&eTip:&r the other sourcelinks feed on crops (Agronomic), food (Mycelial), mob deaths (Vitalic) and potions (Alchemical)."
	]
	quest.3C8BCCCB478BE602.title: "Source Gems"
	quest.3C8BCCCB478BE602.quest_subtitle: "Imbue amethyst or lapis"
	quest.3C8BCCCB478BE602.quest_desc: [
		"&eWhat:&r source gems are the currency of Ars Nouveau: sourcestone, pedestals, relays, essences and charms all need them."
		"&eChemistry:&r amethyst is quartz (SiO₂) tinted purple by iron impurities; lapis owes its blue to lazurite, an aluminosilicate holding sulfur radicals."
		"&eHow:&r put an amethyst shard or a lapis lazuli in the Imbuement Chamber with Source nearby. Each gem costs 500 Source."
		"&eTip:&r a budding amethyst geode or an amethyst farm turns into an endless gem supply."
	]
	quest.108235FB0131BB59.title: "Sourcestone"
	quest.108235FB0131BB59.quest_subtitle: "Stone that carries magic"
	quest.108235FB0131BB59.quest_desc: [
		"&eWhat:&r sourcestone is the building block of the Arcane Core, the Arcane Pedestals and the Enchanting Apparatus."
		"&eHow:&r eight stone around one source gem gives eight sourcestone (any c:stones work). A stonecutter turns it into bricks and tiles."
		"&eTip:&r make extra; it's a handsome building stone for your magic room."
	]
	quest.37432FA85E0B250D.title: "Enchanting Apparatus"
	quest.37432FA85E0B250D.quest_subtitle: "Ars Nouveau's big crafting altar"
	quest.37432FA85E0B250D.quest_desc: [
		"&eWhat:&r the Apparatus sits on an Arcane Core and fuses items from surrounding Arcane Pedestals, using Source."
		"&eHow:&r Core first, Apparatus on top, pedestals within a few blocks. Put the main item in the Apparatus and right-click (check JEI)."
		"&eTip:&r it also applies enchantments to gear: more ways to make divine equipment."
	]
	quest.5B85AC6D5C703756.title: "Ritual Brazier"
	quest.5B85AC6D5C703756.quest_subtitle: "Where rituals happen"
	quest.5B85AC6D5C703756.quest_desc: [
		"&eWhat:&r rituals are area effects: sunrise, cloudshaping, overgrowth, flight and more. Each needs a brazier and a ritual tablet."
		"&eHow:&r an Arcane Pedestal, a source gem block and three gold ingots (shapeless). Place it and right-click it with a ritual tablet."
		"&eTip:&r most rituals draw Source from nearby jars, so build next to your source room."
	]
	quest.2F020C2FEA6EEB68.title: "Ritual of Flight"
	quest.2F020C2FEA6EEB68.quest_subtitle: "Base flight, after you've earned the sky"
	quest.2F020C2FEA6EEB68.quest_desc: [
		"&6You already remember the sky. Now your home remembers it too.&r"
		"&eWhat:&r gives creative flight to players near the brazier, paid for with Source. It's base flight, not world flight."
		"&eChemistry:&r hydrogen (H₂) is the lightest gas there is, 14 times less dense than air. It lifted the first balloons in 1783."
		"&eHow:&r a purple archwood log, 3 Wilden Wings, 2 diamonds, an ender pearl and 2 hydrogen from the Dissolver (this pack's recipe). Put the tablet in the Ritual Brazier and keep the jars topped up."
		"&eTip:&r this opens after the Infusion Pylon on purpose: real flight is a chemistry milestone."
	]
	quest.554750920598677C.title: "Tier 1 Glyphs"
	quest.554750920598677C.quest_subtitle: "Forms, effects and augments"
	quest.554750920598677C.quest_desc: [
		"&eWhat:&r tier 1 glyphs are the basics: Projectile, Touch and Self (forms); Break, Harm, Ignite, Light, Harvest, Leap and Freeze (effects); Amplify, Delay and Randomize (augments)."
		"&eHow:&r scribe them at the Scribe's Table. Each costs a few common items plus experience; JEI shows the exact list."
		"&eTip:&r a Touch + Break + Amplify spell is a magic pickaxe. Click the checkmark once you've written five glyphs."
	]
	quest.21991C2E96238C6B.title: "Apprentice Spell Book"
	quest.21991C2E96238C6B.quest_subtitle: "More glyphs, bigger spells"
	quest.21991C2E96238C6B.quest_desc: [
		"&eWhat:&r the second spell book tier: more mana, more slots and access to tier 2 glyphs."
		"&eHow:&r a crafting-grid upgrade: your Novice book with obsidian, 3 diamonds, 2 quartz blocks and 2 blaze rods (keeps your spells)."
		"&eTip:&r more mana means longer spells and more casts between rests."
	]
	quest.5F98B10EDD36CAE4.title: "Tier 2 Glyphs"
	quest.5F98B10EDD36CAE4.quest_subtitle: "Explosions, smelting and area spells"
	quest.5F98B10EDD36CAE4.quest_desc: [
		"&eWhat:&r tier 2 adds the AOE, Pierce, Fortune, Extract, Extend Time and Dampen augments, and effects like Smelt, Crush, Grow, Exchange, Explosion, Heal and Slowfall."
		"&eHow:&r scribe them with the Apprentice book. Several want an essence from the Imbuement Chamber (check JEI)."
		"&eTip:&r Crush + AOE grinds cobble to sand and gravel in bulk. Click the checkmark when you've written three."
	]
	quest.7C900EC108C827B7.title: "Explosion Glyph"
	quest.7C900EC108C827B7.quest_subtitle: "Optional: the chemistry of a bang"
	quest.7C900EC108C827B7.quest_desc: [
		"&eWhat:&r the Explosion glyph needs fire essence, three TNT and a fire charge. Scribe it and your spells can blast."
		"&eChemistry:&r TNT is trinitrotoluene, C₇H₅N₃O₆: toluene nitrated with HNO₃ and H₂SO₄, the same acids your Ostwald and contact plants make."
		"&eHow:&r gather the items, then write the glyph at the Scribe's Table."
		"&eTip:&r Dampen makes the blast smaller and Amplify makes it bigger."
	]
	quest.6445ADA8DD3F6E25.title: "Archmage Spell Book"
	quest.6445ADA8DD3F6E25.quest_subtitle: "Optional: the top spell book"
	quest.6445ADA8DD3F6E25.quest_desc: [
		"&6You remember when every word you spoke was a spell. This book is a reminder.&r"
		"&eWhat:&r the last book tier, with tier 3 glyphs and the most mana."
		"&eHow:&r crafting grid: the Apprentice book with 3 ender pearls, 2 emeralds, a Totem of Undying, a Nether Star and a Wilden Tribute."
		"&eTip:&r the Wither and the Wilden Chimera both stand between you and this book."
	]
	quest.2E88B366469FFA4E.title: "Tier 3 Glyphs"
	quest.2E88B366469FFA4E.quest_subtitle: "Optional: Blink, Lightning, Linger, Wall"
	quest.2E88B366469FFA4E.quest_desc: [
		"&eWhat:&r tier 3 glyphs are the strongest: Blink (teleport), Lightning, Fangs, Linger and Wall (lasting zones), Split, Glide and summons."
		"&eHow:&r scribe them with the Archmage book; they cost the most experience (check JEI)."
		"&eTip:&r Glide works like an elytra, not like flight. Click the checkmark when you've written one."
	]
	quest.2D21E70FCF3645E2.title: "Other Sourcelinks"
	quest.2D21E70FCF3645E2.quest_subtitle: "Optional: Source from crops, food, mobs or potions"
	quest.2D21E70FCF3645E2.quest_desc: [
		"&eWhat:&r every sourcelink feeds on a different kind of energy. Agronomic eats crop growth, Mycelial eats food, Vitalic eats mob deaths, Alchemical eats potions."
		"&eChemistry:&r all of them are the same idea in a costume: stored chemical energy (sugars, fats, potions) released and captured."
		"&eHow:&r same frame as the Volcanic one (source gems and gold) around wheat, mushroom stew, a glistering melon or a brewing stand."
		"&eTip:&r an Agronomic Sourcelink next to a crop farm is free Source forever."
	]
	quest.213B30987607E210.title: "Source Relays"
	quest.213B30987607E210.quest_subtitle: "Optional: move Source across your base"
	quest.213B30987607E210.quest_desc: [
		"&eWhat:&r relays carry Source from one jar to another, so your sourcelinks don't have to sit next to the machines that spend it."
		"&eHow:&r gold ingots around a source gem block. Link them with a Dominion Wand (the Worn Notebook shows how). A Relay Splitter shares one input between many outputs."
		"&eTip:&r put noisy sourcelink farms out of sight and relay the Source in."
	]
	quest.099469C78FF652DF.title: "Ender Source Jar"
	quest.099469C78FF652DF.quest_subtitle: "Optional: Source that follows you"
	quest.099469C78FF652DF.quest_desc: [
		"&eWhat:&r an Ars Additions jar whose Source is shared with your other Ender Source Jars, wherever they are."
		"&eHow:&r a Source Jar in the Apparatus with 4 ender pearls and 4 popped chorus fruit."
		"&eTip:&r one at home and one at an outpost makes a Source network without relays."
	]
	quest.16561B8FB81C8360.title: "Storage Lectern"
	quest.16561B8FB81C8360.quest_subtitle: "Optional: Ars Nouveau's own storage network"
	quest.16561B8FB81C8360.quest_desc: [
		"&eWhat:&r the Storage Lectern shows the contents of linked Repositories and chests in one searchable screen."
		"&eHow:&r a lectern with 4 chests in the Apparatus; Repositories are archwood logs and gold nuggets. Link them with a Dominion Wand."
		"&eTip:&r it's small and cheap; AE2 or Occultism storage scale further."
	]
	quest.3E935F6461903A8B.title: "Spell Turret"
	quest.3E935F6461903A8B.quest_subtitle: "Optional: spells that cast themselves"
	quest.3E935F6461903A8B.quest_desc: [
		"&eWhat:&r a turret casts the spell you inscribe into it whenever it gets a redstone signal, using Source from nearby jars."
		"&eHow:&r the Basic Spell Turret is source gems, gold and a redstone block; upgrade it in the Apparatus with a source gem block and 2 blaze rods."
		"&eTip:&r a turret with Break or Harvest on a clock is a simple farm."
	]
	quest.6BF1C2A90E137F34.title: "Ars Additions Charms"
	quest.6BF1C2A90E137F34.quest_subtitle: "Optional: one-shot protections in a bottle"
	quest.6BF1C2A90E137F34.quest_desc: [
		"&eWhat:&r Ars Additions charms save you once from a specific danger: falling, fire, drowning, the void, or death itself."
		"&eHow:&r made in the Enchanting Apparatus around a glass bottle (the Undying Charm takes a Totem of Undying, crying obsidian and glowstone). Recharge them in the Imbuement Chamber."
		"&eTip:&r a Void Protection Charm (stable warp scroll and end stone bricks) is cheap insurance in the End."
	]
	quest.2286BDE9BF97D7A6.title: "Handy Haversack"
	quest.2286BDE9BF97D7A6.quest_subtitle: "Optional: a bag bound to a chest"
	quest.2286BDE9BF97D7A6.quest_desc: [
		"&eWhat:&r the Handy Haversack links to a container so items you pick up go straight there."
		"&eHow:&r craft it (check JEI), then bind it to a chest or your storage as its tooltip says."
		"&eTip:&r bind it to your AE2 or Occultism storage interface for a bottomless pocket."
	]
	quest.5021CB8784BA6761.title: "Ritual of Binding"
	quest.5021CB8784BA6761.quest_subtitle: "Turn a helper into a familiar"
	quest.5021CB8784BA6761.quest_desc: [
		"&eWhat:&r the Ritual of Binding turns a creature charm into its familiar form, a companion that rides along and grants a bonus."
		"&eHow:&r a purple archwood log, blank parchment, an ender pearl and 3 source gems. Run it in the brazier with the charm nearby."
		"&eTip:&r the Worn Notebook lists what each familiar gives."
	]
	quest.1ADA8BE66806FEF8.title: "A Familiar"
	quest.1ADA8BE66806FEF8.quest_subtitle: "Optional: a small spirit that follows you"
	quest.1ADA8BE66806FEF8.quest_desc: [
		"&eWhat:&r a familiar is a bound creature that rides along and gives a passive bonus: Starbuncles speed you up, Wixies boost potions, Bookwyrms cut spell costs."
		"&eHow:&r run the Ritual of Binding with the creature's charm nearby to turn it into a familiar item. Use the item to call your familiar."
		"&eTip:&r Ars Elemental adds elemental familiars (Firenando, Flashjack, Siren) that boost that school of magic."
	]
	quest.6066F3C0F57019E8.title: "Sky Rituals"
	quest.6066F3C0F57019E8.quest_subtitle: "Optional: command the day and the weather"
	quest.6066F3C0F57019E8.quest_desc: [
		"&eWhat:&r Sunrise skips to morning, Moonfall to night, and Cloudshaping clears or starts rain."
		"&eHow:&r Sunrise is a red archwood log, 3 dandelions and a clock; Moonfall a blue log, an ink sac, a coal block and a clock; Cloudshaping a blue log, a feather and a source gem block."
		"&eTip:&r Moonfall on demand is a quick way to hunt Wilden."
	]
	quest.7FDAECADA6F4511B.title: "Garden Rituals"
	quest.7FDAECADA6F4511B.quest_subtitle: "Optional: crops, trees and animals on their own"
	quest.7FDAECADA6F4511B.quest_desc: [
		"&eWhat:&r green-log rituals tend the land: Overgrowth grows plants, Fertility breeds animals, Harvest reaps crops, Forestation plants trees."
		"&eHow:&r each starts from a green archwood log; Harvest is the log, earth essence and an iron hoe. JEI has the rest."
		"&eTip:&r a Harvest ritual next to an Agronomic Sourcelink feeds itself."
	]
	quest.285BE27D315A22D2.title: "Ritual of Scrying"
	quest.285BE27D315A22D2.quest_subtitle: "Optional: see ores through the stone"
	quest.285BE27D315A22D2.quest_desc: [
		"&eWhat:&r Scrying highlights a chosen block (usually an ore) through walls for a while."
		"&eHow:&r a purple archwood log, 3 spider eyes, glowstone and a source gem block. The Worn Notebook shows how to pick which block it reveals."
		"&eTip:&r combine it with the spectrometer and the pack's deposit depths to find rich veins faster."
	]
	quest.5548AB66C078F0FD.title: "Ritual of Chunk Loading"
	quest.5548AB66C078F0FD.quest_subtitle: "Optional: keep your base running"
	quest.5548AB66C078F0FD.quest_desc: [
		"&eWhat:&r an Ars Additions ritual that keeps its chunk loaded while it has Source."
		"&eHow:&r craft the tablet (check JEI) and run it in a Ritual Brazier next to your Source Jars."
		"&eTip:&r FTB Chunks can also force-load claimed chunks; use whichever you prefer."
	]
	quest.467B08B8BAB4A217.title: "Warp Scrolls"
	quest.467B08B8BAB4A217.quest_subtitle: "Optional: go home in one step"
	quest.467B08B8BAB4A217.quest_desc: [
		"&eWhat:&r a Warp Scroll remembers a spot and takes you back once; the Stable Warp Scroll can be reused."
		"&eHow:&r Warp Scroll: blank parchment, 4 lapis and 4 source gems. Stabilize it in the Apparatus with 4 blaze powder and 2 ender pearls."
		"&eTip:&r a Ritual of Warping (purple log + warp scroll) does the same for creatures around the brazier."
	]
	quest.33F8C0D7689BA016.title: "Fire Essence"
	quest.33F8C0D7689BA016.quest_subtitle: "A source gem that learned to burn"
	quest.33F8C0D7689BA016.quest_desc: [
		"&eWhat:&r essences are source gems imbued with one idea. Fire essence goes into fire glyphs, threads and Ars Elemental gear."
		"&eChemistry:&r gunpowder is about 75% saltpetre (KNO₃), 15% charcoal and 10% sulfur: the nitrate supplies the oxygen, so it burns without air."
		"&eHow:&r Imbuement Chamber: a source gem, with flint and steel, a torch and gunpowder on nearby pedestals (2,000 Source)."
		"&eTip:&r Arcane Pedestals next to the chamber hold the extra ingredients."
	]
	quest.508F9F928B091261.title: "Earth and Water"
	quest.508F9F928B091261.quest_subtitle: "Two more essences"
	quest.508F9F928B091261.quest_desc: [
		"&eWhat:&r earth essence feeds growth rituals and earth spells; water essence makes Sanctuary, the Everfull Urn and water foci."
		"&eChemistry:&r burned kelp was once Europe's source of soda ash (Na₂CO₃), and in 1811 the first iodine was isolated from seaweed ash."
		"&eHow:&r earth: an iron ingot, seeds and dirt on pedestals. Water: a water bucket, a snow block and kelp. Both 2,000 Source."
		"&eTip:&r keep a stack of source gems ready; essences go fast."
	]
	quest.7EE93737C3D00550.title: "Abjuration Essence"
	quest.7EE93737C3D00550.quest_subtitle: "The essence of protection"
	quest.7EE93737C3D00550.quest_desc: [
		"&eWhat:&r abjuration essence makes Potion Jars, the Potion Melder, Potion Flasks and Restoration."
		"&eHow:&r Imbuement Chamber: a source gem, with a fermented spider eye, sugar and a milk bucket on pedestals (2,000 Source)."
		"&eTip:&r a Source Jar plus abjuration essence makes a Potion Jar, which stores potions by the litre."
	]
	quest.64D109A658B14856.title: "Manipulation Essence"
	quest.64D109A658B14856.quest_subtitle: "The essence of change"
	quest.64D109A658B14856.quest_desc: [
		"&eWhat:&r manipulation essence goes into the Enchanter's Wand, Spell Bow, Repairing thread, runic chalk and Containment."
		"&eHow:&r Imbuement Chamber: a source gem, with a stone button, redstone and a clock on pedestals (2,000 Source)."
		"&eTip:&r it also converts some blocks into others, such as stone into granite or tuff (check JEI)."
	]
	quest.61355C6881E84380.title: "Anima Essence"
	quest.61355C6881E84380.quest_subtitle: "Ars Elemental's essence of life and death"
	quest.61355C6881E84380.quest_desc: [
		"&eWhat:&r anima essence is the eighth essence, used for the Mark of Mastery and necromantic gear."
		"&eChemistry:&r bone meal comes from bone, which is mostly hydroxyapatite, a calcium phosphate (Ca₅(PO₄)₃OH)."
		"&eHow:&r Imbuement Chamber: a source gem, with a wither skeleton skull, bone meal and a golden apple on pedestals (3,000 Source)."
		"&eTip:&r the skulls come from Nether fortresses, or Occultism's Wild Hunt."
	]
	quest.68EB39940451FDA6.title: "Air Essence"
	quest.68EB39940451FDA6.quest_subtitle: "Bottled wind"
	quest.68EB39940451FDA6.quest_desc: [
		"&eWhat:&r air essence makes the Jump Ring, the Belt of Levitation, air foci and several threads."
		"&eHow:&r Imbuement Chamber: a source gem, with a feather, a Wilden Wing and arrows on pedestals (2,000 Source)."
		"&eTip:&r save a few wings for the Ritual of Flight before spending them here."
	]
	quest.39665C36C3C24D92.title: "Conjuration Essence"
	quest.39665C36C3C24D92.quest_subtitle: "The essence of summoning"
	quest.39665C36C3C24D92.quest_desc: [
		"&eWhat:&r conjuration essence feeds summoning glyphs and can also make end stone or soul sand (check JEI)."
		"&eHow:&r Imbuement Chamber: a source gem, with a Wilden Horn, Starbuncle shards and a book on pedestals (2,000 Source)."
		"&eTip:&r the Mark of Mastery needs one of every essence, so make this one early."
	]
	quest.1AF72DB24D1FCA5A.title: "Wilden Hunt"
	quest.1AF72DB24D1FCA5A.quest_subtitle: "Kill 5 Wilden Hunters"
	quest.1AF72DB24D1FCA5A.quest_desc: [
		"&eWhat:&r Wilden are Ars Nouveau's wild magical beasts. Hunters charge, Stalkers fly, Guardians throw spikes."
		"&eHow:&r they roam the Overworld at night, more often near archwood forests and Wilden dens. Bring a shield."
		"&eTip:&r keep every horn, spike and wing they drop. Rituals need them."
	]
	quest.58D4B5ED67D6FE13.title: "Wilden Wings"
	quest.58D4B5ED67D6FE13.quest_subtitle: "The key ingredient for flight"
	quest.58D4B5ED67D6FE13.quest_desc: [
		"&eWhat:&r Wilden Wings drop from Wilden Stalkers, the flying ones."
		"&eHow:&r hunt Stalkers at night. The Ritual of Flight tablet needs three wings (purple archwood log, 3 wings, 2 diamonds, an ender pearl)."
		"&eTip:&r a Ritual of Wilden Summoning will need three more Wilden drops, so keep hunting."
	]
	quest.5647205E4092E13E.title: "The Wilden Chimera"
	quest.5647205E4092E13E.quest_subtitle: "Summon and slay Ars Nouveau's boss"
	quest.5647205E4092E13E.quest_desc: [
		"&6You remember beasts that were many beasts at once. You remember winning.&r"
		"&eWhat:&r the Wilden Chimera combines all three Wilden. It drops Wilden Tribute, used for the Archmage book and Ars Elemental's Mark of Mastery."
		"&eHow:&r craft the Ritual of Wilden Summoning (purple archwood log, 3 Wilden drops, a lapis block), place it in a brazier away from your base, and fight."
		"&eTip:&r it has phases and calls spikes from the ground. Keep moving and bring healing."
	]
	quest.0ED371501E3635D7.title: "Mark of Mastery"
	quest.0ED371501E3635D7.quest_subtitle: "Ars Elemental's upgrade token"
	quest.0ED371501E3635D7.quest_desc: [
		"&eWhat:&r the Mark of Mastery upgrades elemental foci and turns Arcanist armor into elemental mage armor."
		"&eHow:&r imbue a Wilden Tribute with all seven essences plus anima essence on the pedestals (check JEI). One tribute gives five marks."
		"&eTip:&r five marks is a focus plus most of an armor set; plan before you spend them."
	]
	quest.68F810DE695926AB.title: "Lesser Elemental Focus"
	quest.68F810DE695926AB.quest_subtitle: "Pick an element and specialise"
	quest.68F810DE695926AB.quest_desc: [
		"&eWhat:&r an Ars Elemental focus is a curio that strengthens one school of spells (fire, water, earth or air) and lowers its cost."
		"&eChemistry:&r the four classical elements were the first attempt at a periodic table. You know there are 118, but the spells don't."
		"&eHow:&r in the Imbuement Chamber: an amethyst shard with 3 matching essences and 3 gold ingots on pedestals (5,000 Source)."
		"&eTip:&r choose the school your favourite spell uses most."
	]
	quest.49C42FE354691DD3.title: "Greater Elemental Focus"
	quest.49C42FE354691DD3.quest_subtitle: "Master an element"
	quest.49C42FE354691DD3.quest_desc: [
		"&eWhat:&r the full focus gives a much bigger bonus to its school and protects you from matching hazards."
		"&eHow:&r put the lesser focus in the Enchanting Apparatus with a Mark of Mastery on a pedestal (5,000 Source)."
		"&eTip:&r a fire focus pairs well with Ignite and Flare; a water focus with Watery Grave."
	]
	quest.64B3AC170A838184.title: "Elemental Mage Armor"
	quest.64B3AC170A838184.quest_subtitle: "Optional: armor of a single element"
	quest.64B3AC170A838184.quest_desc: [
		"&eWhat:&r Ars Elemental turns Arcanist armor into fire, water, earth or air armor, each with resistances and a spell bonus."
		"&eHow:&r in the Enchanting Apparatus: an Arcanist piece plus a Mark of Mastery, a netherite ingot and two matching essences (7,000 Source)."
		"&eTip:&r a full set matching your focus makes that school very cheap to cast."
	]
	quest.12A5EADCA037CB52.title: "Everfull Urn"
	quest.12A5EADCA037CB52.quest_subtitle: "Optional: water from nowhere"
	quest.12A5EADCA037CB52.quest_desc: [
		"&eWhat:&r the Everfull Urn pushes water into adjacent tanks and machines for free."
		"&eChemistry:&r water is the feedstock for half your chemistry: electrolysis splits 2H₂O → 2H₂ + O₂."
		"&eHow:&r a flower pot in the Apparatus with a source gem, 2 water essences and 2 prismarine shards."
		"&eTip:&r one next to an electrolyzer saves a pump."
	]
	quest.662465DCA194057C.title: "Caster's Bag"
	quest.662465DCA194057C.quest_subtitle: "Optional: a bag for books and charms"
	quest.662465DCA194057C.quest_desc: [
		"&eWhat:&r the Curio Bag holds trinkets and charms; the Caster's Bag is its upgrade that also takes spell books and caster tomes."
		"&eHow:&r Curio Bag: a chest in magebloom fiber. Then the Apparatus with 2 manipulation essences, 2 blaze powder and 2 gold blocks."
		"&eTip:&r it frees hotbar slots for tools."
	]
	quest.1CB6E763B581D822.title: "Magebloom"
	quest.1CB6E763B581D822.quest_subtitle: "The magic fiber crop"
	quest.1CB6E763B581D822.quest_desc: [
		"&eWhat:&r magebloom is a flower crop; each one gives 4 magebloom fiber for robes, threads, the Alteration Table and runic chalk."
		"&eHow:&r Magebloom seeds come from the Apparatus (any seeds with 4 source gems). Plant them like wheat."
		"&eTip:&r a small magebloom field early saves a lot of waiting later."
	]
	quest.4404A38C2E79830C.title: "Mage Armor"
	quest.4404A38C2E79830C.quest_subtitle: "Armor that stores mana"
	quest.4404A38C2E79830C.quest_desc: [
		"&eWhat:&r Ars Nouveau armor comes in three styles (Sorcerer, Arcanist, Battlemage). Each piece adds mana and mana regeneration."
		"&eHow:&r made in the Enchanting Apparatus around a golden armor piece with 4 magebloom fiber (check JEI for each style)."
		"&eTip:&r grow magebloom early; every piece needs fiber."
	]
	quest.2A18E9D2794B3941.title: "Armor Tiers"
	quest.2A18E9D2794B3941.quest_subtitle: "Upgrade mage armor in the Apparatus"
	quest.2A18E9D2794B3941.quest_desc: [
		"&eWhat:&r mage armor has three tiers. Each tier raises mana and opens more thread slots."
		"&eHow:&r put the armor in the Apparatus: tier 2 needs 2 blaze rods (2,500 Source), tier 3 needs 2 ender pearls and a chorus fruit (5,000 Source)."
		"&eTip:&r click the checkmark once you've upgraded a piece."
	]
	quest.2093DB5E1CE78BC8.title: "Alteration Table"
	quest.2093DB5E1CE78BC8.quest_subtitle: "Sew threads into your robes"
	quest.2093DB5E1CE78BC8.quest_desc: [
		"&eWhat:&r the Alteration Table holds a piece of mage armor and lets you put threads (perks) into its slots."
		"&eHow:&r the table is a Scribe's Table with magebloom fiber; blank threads are magebloom fiber and gold nuggets."
		"&eTip:&r right-click the table with armor, then with threads."
	]
	quest.14D39D547F0B39A3.title: "Threads"
	quest.14D39D547F0B39A3.quest_subtitle: "Optional: perks for your armor"
	quest.14D39D547F0B39A3.quest_desc: [
		"&eWhat:&r threads add perks: Spellpower, Magic Capacity, Repairing, Warding, Feather Falling, Step Height and more."
		"&eHow:&r a blank thread in the Apparatus with the thread's ingredients (Repairing: an anvil and 2 manipulation essences; check JEI for the rest)."
		"&eTip:&r Spellpower takes one of every essence; it's worth it for a main spell set."
	]
	quest.10B493F58C8B1550.title: "Mana Amulet"
	quest.10B493F58C8B1550.quest_subtitle: "Optional: more mana around your neck"
	quest.10B493F58C8B1550.quest_desc: [
		"&eWhat:&r amulets are curios that raise your maximum mana or how fast it comes back."
		"&eHow:&r a Dull Trinket (iron nuggets and a source gem) in the Apparatus with diamonds and source gems (Regen also wants gold)."
		"&eTip:&r Regen suits short, frequent spells; Boost suits big ones."
	]
	quest.1825EF6F5141669B.title: "Ring of Discount"
	quest.1825EF6F5141669B.quest_subtitle: "Optional: cheaper spells"
	quest.1825EF6F5141669B.quest_desc: [
		"&eWhat:&r discount rings cut the mana cost of every spell you cast."
		"&eHow:&r a Ring of Potential (iron nuggets and a source gem) in the Apparatus with 4 diamonds, 2 ender pearls and 2 source gems. The Greater ring swaps the pearls for blaze rods."
		"&eTip:&r you have two ring slots; two rings stack."
	]
	quest.3EBCDC7434CE7F17.title: "Enchanter's Arms"
	quest.3EBCDC7434CE7F17.quest_subtitle: "Optional: weapons that cast spells"
	quest.3EBCDC7434CE7F17.quest_desc: [
		"&eWhat:&r the Enchanter's Sword casts a spell on hit, the Spell Bow puts spells on arrows, and the Enchanter's Shield is a mana-powered shield."
		"&eHow:&r the vanilla item in the Apparatus with source gem blocks and gold blocks (the bow also takes manipulation essence, the sword a diamond)."
		"&eTip:&r give them a spell at the Scribe's Table, like a spell book."
	]
	quest.013C67CF325A6CB0.title: "Starbuncle"
	quest.013C67CF325A6CB0.quest_subtitle: "Optional: a tiny helper that moves items"
	quest.013C67CF325A6CB0.quest_desc: [
		"&eWhat:&r a Starbuncle carries items from one chest to another. Cute logistics."
		"&eHow:&r befriend a wild Starbuncle for its shards (the Worn Notebook explains how), then put the shards in the Apparatus with 4 gold ingots."
		"&eTip:&r use a Dominion Wand to set where it picks up and where it drops off."
	]
	quest.14B10F384B40EE79.title: "Too Cool for Logistics"
	quest.14B10F384B40EE79.quest_subtitle: "Secret: sunglasses for a Starbuncle"
	quest.14B10F384B40EE79.quest_desc: [
		"&6You remember having servants who took themselves very seriously. This one does not.&r"
		"&eWhat:&r Starbuncle Shades: tinted glass and a source gem. Give them to a Starbuncle."
		"&eTip:&r they do nothing useful. That is the point."
	]
	quest.27D2613B68F661C7.title: "Wixie"
	quest.27D2613B68F661C7.quest_subtitle: "Optional: a helper that crafts and brews"
	quest.27D2613B68F661C7.quest_desc: [
		"&eWhat:&r a Wixie works a cauldron: it repeats a crafting recipe or brews potions from nearby chests."
		"&eHow:&r cast a Dispel spell on a witch at half health or less for Wixie Shards, then the Apparatus with a sapling, an emerald, a crafting table and a brewing stand."
		"&eTip:&r pair a brewing Wixie with a Potion Jar to keep your favourite potion stocked."
	]
	quest.274FEB81C0308524.title: "Drygmy"
	quest.274FEB81C0308524.quest_subtitle: "Optional: mob drops without killing"
	quest.274FEB81C0308524.quest_desc: [
		"&eWhat:&r a Drygmy at its henge collects drops from nearby mobs without hurting them."
		"&eHow:&r Drygmy shards (the Worn Notebook explains how to befriend one) in the Apparatus with fish, wheat, an apple, a carrot, seeds and 3 source gems."
		"&eTip:&r the Worn Notebook shows the henge layout and what the Drygmy needs nearby."
	]
	quest.7739DC5C26CE431C.title: "Whirlisprig"
	quest.7739DC5C26CE431C.quest_subtitle: "Optional: a garden spirit"
	quest.7739DC5C26CE431C.quest_desc: [
		"&eWhat:&r a Whirlisprig speeds up plant growth around it and makes Source from a varied garden."
		"&eHow:&r Whirlisprig shards in the Apparatus with a source gem, magebloom (seed and flower), a diamond, three saplings and wheat seeds."
		"&eTip:&r the more different plants nearby, the happier it is."
	]
	quest.0A8282FFFAA50AE1.title: "Two Roads to the Sky"
	quest.0A8282FFFAA50AE1.quest_subtitle: "Optional: how Ars flight fits the pack"
	quest.0A8282FFFAA50AE1.quest_desc: [
		"&eWhat:&r a note on the Ritual of Flight and the pack's other flight sources."
		"&eHow:&r read the second page, then click the checkmark."
		"{@pagebreak}"
		"&eRitual of Flight:&r the tablet is a purple archwood log, 3 Wilden Wings, 2 diamonds, an ender pearl and 2 hydrogen. The hydrogen is this pack's addition: no chemistry, no wings."
		"&eRange:&r the ritual only grants flight near its brazier and drains Source while you fly. It's base flight, not world flight."
		"&eNot flight:&r the Belt of Levitation, the Jump Ring and the Glide glyph help you move, but none of them is true flight."
		"&eElsewhere:&r the Infusion Pylon with a Potion of Flying (hydrogen from the Dissolver), Iron Jetpacks (MI circuits) and the Angel Ring (digital circuit) all work anywhere. See Tools and Comfort."
	]
	quest.417E9338D4012FA8.title: "Dowsing Rod"
	quest.417E9338D4012FA8.quest_subtitle: "Optional: find geodes and magical creatures"
	quest.417E9338D4012FA8.quest_desc: [
		"&eWhat:&r a short burst of Scrying for budding amethyst, and magical creatures within 75 blocks start to glow. It has limited uses."
		"&eChemistry:&r a geode is a hollow rock where silica-rich water slowly deposited SiO₂ crystals inward, layer by layer."
		"&eHow:&r a gold ingot above two archwood planks."
		"&eTip:&r a budding amethyst near home means endless source gems."
	]
	quest.50B3A698EA605A6B.title: "Dominion Wand"
	quest.50B3A698EA605A6B.quest_subtitle: "Optional: tell things where to go"
	quest.50B3A698EA605A6B.quest_desc: [
		"&eWhat:&r the Dominion Wand links blocks and creatures: relays to jars, Starbuncles to chests, golems and Weald Walkers to their homes."
		"&eHow:&r a stick in the Enchanting Apparatus with 2 source gems and a gold ingot on the pedestals."
		"&eTip:&r click the first thing, then the second. Sneak-click shows what is already linked."
	]
	quest.53C17139F5A23A68.title: "Wand or Mirror"
	quest.53C17139F5A23A68.quest_subtitle: "Optional: one spell, cast cheaply"
	quest.53C17139F5A23A68.quest_desc: [
		"&eWhat:&r the Enchanter's Wand fires one spell as Projectile + Accelerate; the Enchanter's Mirror casts one self spell on you, cheaper and longer."
		"&eHow:&r wand: an archwood log in the Apparatus with 4 source gems, 2 gold, air and manipulation essence. Mirror: a source gem block with glass, archwood logs, gold and 2 manipulation essence."
		"&eTip:&r inscribe them at the Scribe's Table with a spell that has no form of its own (e.g. just Break, or Heal + Amplify)."
	]
	quest.36895B07D4FA2698.title: "Useful Jars"
	quest.36895B07D4FA2698.quest_subtitle: "Optional: light, a trash can or a potion tank"
	quest.36895B07D4FA2698.quest_desc: [
		"&eWhat:&r the Jar of Light summons a light that follows you; the Jar of Voiding deletes chosen items on pickup for a little mana; the Potion Jar stores 100 potions."
		"&eChemistry:&r glowstone light is fiction, but real 'cold light' exists: in a glow stick, a peroxide reaction excites a dye that emits photons instead of heat."
		"&eHow:&r Potion Jar: a Source Jar and abjuration essence (shapeless). The other two are a glass bottle in the Apparatus (check JEI)."
		"&eTip:&r a Void Jar set to cobblestone and dirt keeps your inventory clean while mining."
	]
	quest.188FDD8EDD08FACE.title: "Magic Belts"
	quest.188FDD8EDD08FACE.quest_subtitle: "Optional: levitate, or gamble on potions"
	quest.188FDD8EDD08FACE.quest_desc: [
		"&eWhat:&r the Belt of Levitation lets you rise by sneaking in mid-air (climbing, not flight). The Belt of Unstable Gifts hands out random good potion effects."
		"&eHow:&r a Mundane Belt in the Apparatus. Levitation: 4 gold, 3 feathers and air essence. Unstable Gifts: brewing ingredients and a brewing stand."
		"&eTip:&r levitation also softens falls a little; it doesn't replace real flight."
	]
	quest.1CC6523D2748AC7F.title: "Greater Discount"
	quest.1CC6523D2748AC7F.quest_subtitle: "Optional: the better ring"
	quest.1CC6523D2748AC7F.quest_desc: [
		"&eWhat:&r a slightly bigger discount on every spell than the lesser ring."
		"&eHow:&r the Ring of Lesser Discount in the Apparatus with 4 diamonds, 2 blaze rods and 2 source gems."
		"&eTip:&r wear it with a lesser ring in the second slot until you can afford two."
	]
	quest.411A88680C81A7BF.title: "Four Archwoods"
	quest.411A88680C81A7BF.quest_subtitle: "Optional: one sapling of every colour"
	quest.411A88680C81A7BF.quest_desc: [
		"&eWhat:&r Blazing (red), Cascading (blue), Flourishing (green) and Vexing (purple) archwood. Each colour feeds different rituals."
		"&eHow:&r break archwood leaves in the four kinds of archwood forest. Plant a few of each at home."
		"&eTip:&r the Ritual of Awakening needs all four saplings at once."
	]
	quest.0BD4CEEC829E5293.title: "Ritual of Awakening"
	quest.0BD4CEEC829E5293.quest_subtitle: "Optional: wake the trees"
	quest.0BD4CEEC829E5293.quest_desc: [
		"&6You remember forests that stood up when you called. Some of them still do.&r"
		"&eWhat:&r awakens nearby archwood trees into Weald Walkers that guard an area, and budding amethyst into an Amethyst Golem charm."
		"&eHow:&r a green archwood log, one sapling of each colour and 4 source gems (shapeless). Run it next to the tree base or the budding amethyst."
		"&eTip:&r add Book and Quills to the ritual and it makes Bookwyrm charms instead."
	]
	quest.0E5A703BF2EF1CC6.title: "Amethyst Golem"
	quest.0E5A703BF2EF1CC6.quest_subtitle: "Optional: a geode that tends itself"
	quest.0E5A703BF2EF1CC6.quest_desc: [
		"&eWhat:&r the Amethyst Golem grows and harvests amethyst near its home, turns amethyst blocks into budding amethyst and stores the shards."
		"&eChemistry:&r amethyst is quartz, SiO₂, coloured purple by Fe³⁺ ions that natural radiation has changed in the crystal."
		"&eHow:&r run the Ritual of Awakening near budding amethyst. Place the charm, then give the golem a home with the Dominion Wand (a chest makes it store shards)."
		"&eTip:&r golem shards in an Imbuement Chamber are a hands-free source gem line."
	]
	quest.53E8FAD6EDBAC01F.title: "Working Rituals"
	quest.53E8FAD6EDBAC01F.quest_subtitle: "Optional: dig, heal, warp or fight"
	quest.53E8FAD6EDBAC01F.quest_desc: [
		"&eWhat:&r Burrowing digs four holes to bedrock; Disintegration turns monsters into double experience; Restoration heals and cures zombie villagers; Warping moves everyone to a warp scroll; Challenge starts a raid; Wilden Summoning calls the Chimera."
		"&eHow:&r each tablet is an archwood log plus a few items (Burrowing: green log, iron pickaxe, coal block; Restoration: green log, golden apple, abjuration essence). JEI has them all."
		"&eTip:&r Burrowing drops ore as raw ore: it saves digging, not processing."
	]
	quest.707C3618147E2664.title: "Containment"
	quest.707C3618147E2664.quest_subtitle: "Optional: a mob in a jar"
	quest.707C3618147E2664.quest_desc: [
		"&eWhat:&r Containment Jars hold a living mob. Chickens still lay, cows can be milked, sheep sheared, and a jarred blaze lights the room."
		"&eHow:&r the jar is glass and archwood slabs. The Ritual of Containment (purple log, manipulation essence, 3 glass bottles) puts a mob within 3 blocks into a nearby jar."
		"&eTip:&r a Drygmy counts jarred mobs as if they were roaming free."
	]
	quest.30D36E2DE3520AC3.title: "Source Spawner"
	quest.30D36E2DE3520AC3.quest_subtitle: "Optional: a spawner that runs on Source"
	quest.30D36E2DE3520AC3.quest_desc: [
		"&eWhat:&r an Ars Additions spawner that reads nearby Containment Jars to decide what to spawn and pays Source for each mob. A redstone signal turns it off."
		"&eHow:&r a Drygmy charm in the Apparatus with a summon focus and conjuration essence."
		"&eTip:&r it spawns mobs without their guaranteed drops, so it's for farms of normal drops, not boss loot."
	]
	quest.5D6E13185E33FC72.title: "Magebloom Fiber"
	quest.5D6E13185E33FC72.quest_subtitle: "Optional: spin the magic crop"
	quest.5D6E13185E33FC72.quest_desc: [
		"&eWhat:&r magebloom fiber is the cloth of Ars Nouveau: robes, threads, the Alteration Table, runic chalk and mirrorweave."
		"&eChemistry:&r real fibres like cotton are cellulose: long chains of glucose (C₆H₁₀O₅)ₙ held together by hydrogen bonds."
		"&eHow:&r each magebloom flower crafts into fiber. Keep 4 seeds back so the field keeps growing (seeds are any seeds with 4 source gems in the Apparatus)."
		"&eTip:&r a Harvest ritual or a Whirlisprig keeps the field going without you."
	]
	quest.015AB28EEF81B46C.title: "Runes and Illusions"
	quest.015AB28EEF81B46C.quest_subtitle: "Optional: traps and fake walls"
	quest.015AB28EEF81B46C.quest_desc: [
		"&eWhat:&r Runic Chalk draws permanent runes that cast a spell on whatever walks over them. Mirrorweave copies the look of any block you use on it."
		"&eHow:&r runic chalk: manipulation essence, bone meal and magebloom fiber. Mirrorweave: 8 magebloom blocks around conjuration essence (makes 8)."
		"&eTip:&r a mirrorweave wall hides a secret door; Sense Magic reveals it."
	]
	quest.1F1D1D2DED7B490C.title: "A Full Mage Set"
	quest.1F1D1D2DED7B490C.quest_subtitle: "Optional: hat, robes, leggings and boots"
	quest.1F1D1D2DED7B490C.quest_desc: [
		"&eWhat:&r four pieces of mage armor, any style mixed: every piece adds mana and regeneration, and each one is a thread slot."
		"&eHow:&r each piece is the matching golden armor piece in the Apparatus with magebloom fiber (check JEI per style)."
		"&eTip:&r Arcanist pieces are needed later for Ars Elemental's elemental armor."
	]
	quest.258D1E55D262016C.title: "A Full Elemental Set"
	quest.258D1E55D262016C.quest_subtitle: "Optional: four pieces of elemental armor"
	quest.258D1E55D262016C.quest_desc: [
		"&6You remember wearing a single element like a cloak. Now you wear it like a lab coat.&r"
		"&eWhat:&r all four slots in Ars Elemental armor. Matching pieces stack their school bonus and resistances."
		"&eHow:&r each Arcanist piece in the Apparatus with a Mark of Mastery, a netherite ingot and two matching essences."
		"&eTip:&r that's four marks and four netherite: plan it with your Wilden Tribute."
	]
	chapter.717248739CAC3545.title: "Occultism"
	chapter.717248739CAC3545.chapter_subtitle: [
		"Spirits, pentacles, otherworld storage and miners that dig where you can't."
	]
	quest.5F9B839BB34A9A16.title: "Demon's Dream"
	quest.5F9B839BB34A9A16.quest_subtitle: "Eat it and see the Otherworld"
	quest.5F9B839BB34A9A16.quest_desc: [
		"&6You remember seeing everything at once. One bite, and some of it comes back.&r"
		"&eWhat:&r eating Demon's Dream Fruit gives the Third Eye: you see Otherworld blocks hidden behind normal ones."
		"&eHow:&r break grass for Demon's Dream seeds, grow them, and eat a fruit. Seeds plus a book make the Dictionary of Spirits, which explains the rest."
		"&eTip:&r with the Third Eye active, otherworld trees appear among normal oaks."
	]
	quest.78F4BD2F6AF9E2BE.title: "Spiritfire"
	quest.78F4BD2F6AF9E2BE.quest_subtitle: "A fire that changes things instead of burning them"
	quest.78F4BD2F6AF9E2BE.quest_desc: [
		"&eWhat:&r spiritfire doesn't hurt you and doesn't destroy items: things thrown into it come out converted."
		"&eChemistry:&r andesite, the input for otherstone, is a grey volcanic rock made mostly of plagioclase feldspar."
		"&eHow:&r throw a Demon's Dream Fruit on the ground and light it with flint and steel. Then throw andesite in for otherstone (diorite gives otherrock)."
		"&eTip:&r books, feathers and black dye also go in: they come out as taboo books, awakened feathers and purified ink."
	]
	quest.0BA278E85EFFD02A.title: "Spirit-Attuned Gems"
	quest.0BA278E85EFFD02A.quest_subtitle: "Diamonds that spirits can hold"
	quest.0BA278E85EFFD02A.quest_desc: [
		"&eWhat:&r spirit-attuned gems are in almost every spirit tool: magic lamps, lenses, the infused pickaxe, stabilizers and crystals."
		"&eChemistry:&r a diamond is pure carbon in a rigid tetrahedral lattice, which is why it survives spiritfire unchanged in substance."
		"&eHow:&r throw diamonds into spiritfire. Four gems make a Spirit-Attuned Crystal, which the mineshaft and bigger pentacles need."
		"&eTip:&r keep a few diamonds aside for this from the start."
	]
	quest.603A14E7F1E5BEF2.title: "Silver"
	quest.603A14E7F1E5BEF2.quest_subtitle: "The summoner's metal"
	quest.603A14E7F1E5BEF2.quest_desc: [
		"&eWhat:&r silver goes into magic lamps, lens frames, satchels, the infused pickaxe and storage remotes."
		"&eChemistry:&r silver (Ag) is the best electrical conductor of all metals. It tarnishes black when traces of H₂S turn its surface into Ag₂S."
		"&eHow:&r mine and smelt silver ore; any silver ingot counts (they're unified)."
		"&eTip:&r MI's ore processing gives silver as a byproduct too."
	]
	quest.05E11B298B4EDE10.title: "Otherworld Trees"
	quest.05E11B298B4EDE10.quest_subtitle: "Wood from beyond, burned to ash"
	quest.05E11B298B4EDE10.quest_desc: [
		"&eWhat:&r otherworld trees look like oaks unless you have the Third Eye. Their logs burn in spiritfire to otherworld ashes, half of white chalk."
		"&eChemistry:&r real wood ash is mostly calcium and potassium carbonates. Potash (K₂CO₃ leached from 'pot ash') gave potassium its name."
		"&eHow:&r throw an oak sapling into spiritfire for an unstable otherworld sapling, grow it, and cut it while under the Third Eye. Burn logs for ashes."
		"&eTip:&r a foliot sapling trader later sells stable saplings that don't need the Third Eye."
	]
	quest.1C4A9DF1826EB0BF.title: "Burnt Otherstone"
	quest.1C4A9DF1826EB0BF.quest_subtitle: "The other half of chalk"
	quest.1C4A9DF1826EB0BF.quest_desc: [
		"&eWhat:&r burnt otherstone counts as otherstone dust, the base of every chalk."
		"&eHow:&r cut or craft otherstone into polished otherstone, then smelt it in a furnace."
		"&eTip:&r make a stack; every new chalk colour starts from white impure chalk."
	]
	quest.0CBD62BC2D8578CE.title: "Your First Pentacle"
	quest.0CBD62BC2D8578CE.quest_subtitle: "Chalk, bowls and a circle"
	quest.0CBD62BC2D8578CE.quest_desc: [
		"&eWhat:&r rituals happen on chalk pentacles, with a Golden Sacrificial Bowl at the centre and Sacrificial Bowls holding the ingredients."
		"&eChemistry:&r real chalk is calcium carbonate, CaCO₃: the shells of tiny sea creatures, pressed into rock."
		"&eHow:&r burnt otherstone and otherworld ashes make impure white chalk; purify it in spiritfire. Bowls are otherstone (the golden one adds gold). The Dictionary shows each pentacle's layout."
		"&eTip:&r ingredient bowls can stand anywhere within 8 blocks of the golden bowl."
	]
	quest.34926D9EB18DDD3C.title: "Bind a Foliot"
	quest.34926D9EB18DDD3C.quest_subtitle: "Learn a spirit's true name"
	quest.34926D9EB18DDD3C.quest_desc: [
		"&eWhat:&r a bound Book of Binding holds a spirit's name and starts its rituals. Foliots are the weakest spirits."
		"&eHow:&r craft the Book of Binding (taboo book, purified ink, awakened feather, blue dye), then bind it with a name as the Dictionary describes (check JEI)."
		"&eTip:&r Aviar's Circle, the foliot summoning pentacle, uses only white chalk."
	]
	quest.498816364D001224.title: "Foliot Crusher"
	quest.498816364D001224.quest_subtitle: "A spirit that grinds ore to dust"
	quest.498816364D001224.quest_desc: [
		"&eWhat:&r a crusher spirit picks up ores and gems and drops dusts. New chalks need gold, silver, iron, emerald, calcite and obsidian dust."
		"&eHow:&r Summon Foliot Crusher: iron, gold, copper and silver ingots in the bowls, a white-chalk circle. Feed it items; any gold and obsidian dust counts for this quest."
		"&eTip:&r a foliot gives 2 dusts per ore, the pack's normal cap. Bigger crushers exist; use the MI and Mekanism ore lines for real ore yield."
	]
	quest.6F0703EECF1B4A99.title: "Golden Chalk"
	quest.6F0703EECF1B4A99.quest_subtitle: "The chalk of possession"
	quest.6F0703EECF1B4A99.quest_desc: [
		"&eWhat:&r golden (yellow) chalk turns a summoning into a possession: the spirit takes over a creature's body."
		"&eHow:&r impure white chalk with glowstone dust and 2 gold dust, purified in spiritfire."
		"&eTip:&r Hedyrin's Lure (white + gold) is the foliot possession pentacle."
	]
	quest.511BA28692361258.title: "Possessed Endermite"
	quest.511BA28692361258.quest_subtitle: "End stone without the End"
	quest.511BA28692361258.quest_desc: [
		"&eWhat:&r a possessed endermite has a high chance to drop end stone, which purple chalk needs."
		"&eHow:&r foliot possession ritual with 2 dirt and 2 stone (the Dictionary shows the extra step). Kill what appears."
		"&eTip:&r run it a few times; crushed end stone goes into every purple chalk."
	]
	quest.39020A6B0F63177F.title: "Possessed Skeleton"
	quest.39020A6B0F63177F.quest_subtitle: "Skulls for bigger pentacles"
	quest.39020A6B0F63177F.quest_desc: [
		"&eWhat:&r skeleton skulls raise a pentacle's calling power. Every djinni, afrit and marid pentacle places them."
		"&eHow:&r foliot possession ritual with 4 bones and a chicken as the sacrifice. The possessed skeleton drops skulls."
		"&eTip:&r check each pentacle in the Dictionary for how many skulls it wants."
	]
	quest.5D15157DFC452720.title: "Purple Chalk"
	quest.5D15157DFC452720.quest_subtitle: "The chalk of infusion"
	quest.5D15157DFC452720.quest_desc: [
		"&eWhat:&r purple chalk binds spirits into objects. Every crafting ritual (satchels, storage, miners) needs it."
		"&eChemistry:&r obsidian is volcanic glass, about 70% SiO₂ that cooled too fast to crystallise."
		"&eHow:&r impure white chalk with crushed end stone and 2 obsidian dust, purified in spiritfire."
		"&eTip:&r Eziveus' Spectral Compulsion (white + purple) is the foliot crafting pentacle."
	]
	quest.573A759E9F1FCC52.title: "Research Fragment Dust"
	quest.573A759E9F1FCC52.quest_subtitle: "Experience pressed into emerald"
	quest.573A759E9F1FCC52.quest_desc: [
		"&eWhat:&r research fragment dust is the special ingredient of lime chalk and knowledge tablets."
		"&eChemistry:&r emerald is beryl, Be₃Al₂Si₆O₁₈, coloured green by traces of chromium."
		"&eHow:&r foliot crafting ritual: emerald dust and 2 bottles o' enchanting."
		"&eTip:&r crush emeralds with your crusher spirit for the dust."
	]
	quest.61D9732EE25B31B5.title: "Lime Chalk"
	quest.61D9732EE25B31B5.quest_subtitle: "The chalk that calls djinn"
	quest.61D9732EE25B31B5.quest_desc: [
		"&eWhat:&r lime chalk attracts spirits stronger than foliots. Every djinni pentacle and up uses it."
		"&eHow:&r impure white chalk with research fragment dust, emerald dust and a slime ball, purified in spiritfire."
		"&eTip:&r make several; afrit and marid pentacles still use lime."
	]
	quest.6826F6BC78244DE3.title: "Light Gray Chalk"
	quest.6826F6BC78244DE3.quest_subtitle: "Real chalk, finally"
	quest.6826F6BC78244DE3.quest_desc: [
		"&eWhat:&r light gray chalk strengthens a pentacle's foundation; djinni pentacles need it."
		"&eChemistry:&r calcite is CaCO₃, exactly the compound real chalk and limestone are made of."
		"&eHow:&r impure white chalk with silver dust, iron dust and crushed calcite, purified in spiritfire."
		"&eTip:&r calcite lines amethyst geodes, so collect it while you farm source gems."
	]
	quest.312300639D5FB8C9.title: "Bind a Djinni"
	quest.312300639D5FB8C9.quest_subtitle: "A stronger spirit for bigger rituals"
	quest.312300639D5FB8C9.quest_desc: [
		"&6You remember spirits who bowed when you passed. This one only negotiates.&r"
		"&eWhat:&r djinn are the second rank of spirits. Their rituals make storage, soul gems, the infused pickaxe and better miners."
		"&eHow:&r a Book of Binding with purple dye, bound with a name like the foliot one. Djinni pentacles add light gray and lime chalk and skeleton skulls."
		"&eTip:&r the Dictionary's Pentacles section is a table: each tier upgrades the pentacle you drew before."
	]
	quest.3FDBDF6D763139AC.title: "Infused Pickaxe"
	quest.3FDBDF6D763139AC.quest_subtitle: "A pickaxe that can cut otherworld ore"
	quest.3FDBDF6D763139AC.quest_desc: [
		"&eWhat:&r a djinni bound into a pickaxe lets you mine otherworld materials such as iesnium ore."
		"&eHow:&r a spirit-attuned pickaxe head (3 gems) with 2 sticks and 2 silver ingots, in Strigeor's Higher Binding (the djinni crafting pentacle)."
		"&eTip:&r you only need it until you have iesnium; then make an iesnium pickaxe."
	]
	quest.1668E0C4B6468525.title: "Iesnium"
	quest.1668E0C4B6468525.quest_subtitle: "An Otherworld metal from the Nether"
	quest.1668E0C4B6468525.quest_desc: [
		"&eWhat:&r iesnium ore hides in the Nether and only shows up with the Third Eye. You need the infused pickaxe to mine it."
		"&eHow:&r eat Demon's Dream (or wear goggles) in the Nether, mine the ore with the infused pickaxe and smelt it."
		"&eTip:&r three ingots make an iesnium pickaxe, which every miner spirit needs."
	]
	quest.6E0E0CD99AFBE407.title: "Spirit Miners"
	quest.6E0E0CD99AFBE407.quest_subtitle: "A spirit digs in a world you can't see"
	quest.6E0E0CD99AFBE407.quest_desc: [
		"&6You remember the earth giving up its treasures when asked. Now a spirit asks for you.&r"
		"&eWhat:&r the Dimensional Mineshaft holds a miner spirit that pulls blocks from the Otherworld over time."
		"&eHow:&r mineshaft: djinni ritual with 4 otherstone, gold, an iesnium block and a spirit-attuned crystal. Foliot miner: a magic lamp (silver and an attuned gem), an iesnium pickaxe, iron and gravel."
		"&eTip:&r in this pack miners &ccan't&r produce chemistry-milestone ores: uranium, uraninite, osmium, fluorite, platinum, iridium or tungsten. Those still come from real processing."
	]
	quest.1E72E45C7693EAF9.title: "Djinni Miner"
	quest.1E72E45C7693EAF9.quest_subtitle: "A faster miner that only brings ores"
	quest.1E72E45C7693EAF9.quest_desc: [
		"&eWhat:&r the djinni miner skips the stone and pulls only ores, much faster than a foliot."
		"&eHow:&r a djinni ritual with the foliot miner, an iesnium pickaxe, gold, lapis and a spirit-attuned crystal."
		"&eTip:&r the pack's ban list still applies: no uranium, uraninite, osmium, fluorite, platinum, iridium or tungsten."
	]
	quest.7128DCEDF4AA3FCF.title: "Afrit Deep Miner"
	quest.7128DCEDF4AA3FCF.quest_subtitle: "Deepslate ores from the Otherworld"
	quest.7128DCEDF4AA3FCF.quest_desc: [
		"&eWhat:&r the afrit miner brings deepslate ores as well as normal ones, faster again."
		"&eHow:&r an afrit crafting ritual: the djinni miner, an iesnium pickaxe, a spirit-attuned crystal, afrit essence, an echo shard and crying obsidian."
		"&eTip:&r miners wear out. Repair them with otherworld essence and an attuned gem in an afrit pentacle (check the Dictionary)."
	]
	quest.582DDE5701841D1D.title: "Marid Master Miner"
	quest.582DDE5701841D1D.quest_subtitle: "The strongest miner a mortal can bind"
	quest.582DDE5701841D1D.quest_desc: [
		"&6You remember commanding the deep places. A marid remembers being commanded.&r"
		"&eWhat:&r the marid miner is the fastest and also finds rare otherworld blocks like iesnium ore and ancient debris."
		"&eHow:&r a marid crafting ritual: the afrit miner, an iesnium pickaxe, a spirit-attuned crystal, a netherite pickaxe, dragon's breath, a Totem of Undying, a Nether Star and marid essence."
		"&eTip:&r even a marid can't reach the pack's chemistry milestones: no uranium, uraninite, osmium, fluorite, platinum, iridium or tungsten."
	]
	quest.630FF9CD0C40458F.title: "Tallow and Candles"
	quest.630FF9CD0C40458F.quest_subtitle: "Optional: steady the circle"
	quest.630FF9CD0C40458F.quest_desc: [
		"&eWhat:&r large candles placed in a pentacle steady it, so summoned spirits last longer before they fade."
		"&eChemistry:&r tallow is rendered animal fat: triglycerides of stearic, palmitic and oleic acid, the stuff of the first candles."
		"&eHow:&r kill pigs, cows or sheep with the Butcher Knife (iron and sticks) for tallow, then a string over tallow makes a candle."
		"&eTip:&r the Dictionary's pentacle pages show where candles go."
	]
	quest.0BD7691FC034B936.title: "Foliot Workers"
	quest.0BD7691FC034B936.quest_subtitle: "Optional: a spirit with a job"
	quest.0BD7691FC034B936.quest_desc: [
		"&eWhat:&r summoned foliots can work: Lumberjack cuts trees, Farmer tends crops, Janitor picks up items, Transporter moves items between chests."
		"&eHow:&r each is a foliot summoning ritual (Lumberjack: an otherworld sapling, 3 saplings and an axe). The Book of Calling it gives lets you set its work area."
		"&eTip:&r a Transporter feeding a Crusher and a Janitor collecting the dust is a whole processing line."
	]
	quest.3573C8631E3C0C8D.title: "Surprisingly Large Bag"
	quest.3573C8631E3C0C8D.quest_subtitle: "Optional: a foliot lives in your backpack"
	quest.3573C8631E3C0C8D.quest_desc: [
		"&eWhat:&r a satchel with a bound foliot inside that keeps it bigger on the inside."
		"&eHow:&r a foliot crafting ritual: a chest, two leather, string and a silver ingot around the golden bowl, on a white and purple pentacle."
		"&eTip:&r the djinni version, the Ender Satchel, opens your ender chest."
	]
	quest.751FA6C7610576BF.title: "Otherworld Goggles"
	quest.751FA6C7610576BF.quest_subtitle: "Optional: the Third Eye without the fruit"
	quest.751FA6C7610576BF.quest_desc: [
		"&eWhat:&r the goggles give a permanent Third Eye, and show even more hidden blocks than Demon's Dream does."
		"&eHow:&r lenses (glass panes and an attuned gem) become infused lenses in a foliot ritual with 2 silver and gold; add a lens frame (otherstone and silver) and leather."
		"&eTip:&r goggles let you see, not harvest: you still need the infused or iesnium pickaxe."
	]
	quest.71B513E95B37ECAD.title: "Divination Rod"
	quest.71B513E95B37ECAD.quest_subtitle: "Optional: dowse for the Otherworld"
	quest.71B513E95B37ECAD.quest_desc: [
		"&eWhat:&r the rod points toward otherworld blocks such as otherstone and otherworld trees."
		"&eHow:&r gold ingots, glass and a spirit-attuned gem. Use it as the Dictionary explains to pick a target."
		"&eTip:&r handy for finding an otherworld grove before you have saplings."
	]
	quest.639ACBFA868A3605.title: "Machine Operator"
	quest.639ACBFA868A3605.quest_subtitle: "Optional: a djinni that runs a machine"
	quest.639ACBFA868A3605.quest_desc: [
		"&eWhat:&r the djinni Machine Operator keeps a linked machine fed from your Storage Actuator and returns the results."
		"&eHow:&r djinni summoning ritual with a coal block, gold, iron and a furnace. Use its Book of Calling on the storage and the machine."
		"&eTip:&r it's a light autocrafting option before AE2."
	]
	quest.1AB48F1F7BE43200.title: "Dimensional Matrix"
	quest.1AB48F1F7BE43200.quest_subtitle: "The heart of Occultism storage"
	quest.1AB48F1F7BE43200.quest_desc: [
		"&eWhat:&r the Dimensional Matrix binds a djinni to hold items in a pocket dimension."
		"&eChemistry:&r the quartz it needs is SiO₂, the same crystal that keeps time in a real watch by vibrating at a fixed frequency."
		"&eHow:&r a djinni crafting ritual with three quartz blocks and an ender pearl."
	]
	quest.4546FB3608214B1A.title: "Storage Actuator"
	quest.4546FB3608214B1A.quest_subtitle: "A whole warehouse in one block"
	quest.4546FB3608214B1A.quest_desc: [
		"&eWhat:&r the Dimensional Storage Actuator stores thousands of items and shows them in one searchable screen."
		"&eHow:&r a foliot ritual makes the Storage Actuator Base (otherstone pedestal, 2 copper, gold). Put the matrix on top of the base in a crafting grid."
		"&eTip:&r it's an alternative to AE2 for early storage. Stabilizers expand it."
	]
	quest.39B0D17ED843DF29.title: "Storage Stabilizers"
	quest.39B0D17ED843DF29.quest_subtitle: "More room for the warehouse"
	quest.39B0D17ED843DF29.quest_desc: [
		"&eWhat:&r stabilizers pointed at the Actuator raise how many items and item types it holds."
		"&eHow:&r tier 0 is an otherstone pedestal; tier 1 is a foliot ritual: the tier 0 stabilizer, a copper block, blaze dust and a spirit-attuned gem."
		"&eTip:&r place them within a few blocks, facing the Actuator."
	]
	quest.0F76D8949B1CCBEF.title: "Djinni Stabilizer"
	quest.0F76D8949B1CCBEF.quest_subtitle: "Tier 2 storage"
	quest.0F76D8949B1CCBEF.quest_desc: [
		"&eWhat:&r the tier 2 stabilizer holds a djinni and adds much more room than tier 1."
		"&eHow:&r djinni crafting ritual: a tier 1 stabilizer, a silver block, a ghast tear and 2 spirit-attuned gems."
		"&eTip:&r upgrade your tier 1 stabilizers one at a time; they keep working in between."
	]
	quest.25505398FD3FA1AB.title: "Greater Stabilizers"
	quest.25505398FD3FA1AB.quest_subtitle: "Optional: afrit and marid storage"
	quest.25505398FD3FA1AB.quest_desc: [
		"&eWhat:&r tier 3 binds an afrit, tier 4 a marid; each is a big jump in capacity."
		"&eHow:&r tier 3: tier 2 stabilizer, a gold block, a Totem of Undying, a crystal and afrit essence. Tier 4 adds an iesnium block, a beacon and marid essence."
		"&eTip:&r a few high-tier stabilizers beat many low ones."
	]
	quest.7BF2913DF4513A2E.title: "Storage Remote"
	quest.7BF2913DF4513A2E.quest_subtitle: "Optional: your storage in your pocket"
	quest.7BF2913DF4513A2E.quest_desc: [
		"&eWhat:&r opens your Storage Actuator from anywhere."
		"&eHow:&r a djinni ritual with an inert remote (iesnium nuggets, an attuned gem, an otherstone tablet, silver), two ender pearls and quartz. Link it by clicking the Actuator."
		"&eTip:&r one remote per player saves a lot of walking back to base."
	]
	quest.1BEF4D3D43C28E59.title: "Stable Wormhole"
	quest.1BEF4D3D43C28E59.quest_subtitle: "Optional: a second door into storage"
	quest.1BEF4D3D43C28E59.quest_desc: [
		"&eWhat:&r a Stable Wormhole links to your Storage Actuator so you can open it from another room."
		"&eHow:&r foliot crafting ritual: an otherstone frame, an ender pearl, 2 quartz and 2 gold ingots. Link it to the Actuator."
		"&eTip:&r put one beside each crafting area."
	]
	quest.30756D89D79CE096.title: "Soul Gem"
	quest.30756D89D79CE096.quest_subtitle: "Optional: carry a mob around"
	quest.30756D89D79CE096.quest_desc: [
		"&eWhat:&r a Soul Gem traps a living creature so you can move it and release it elsewhere."
		"&eHow:&r a djinni ritual: a diamond, copper, silver and gold ingots, a fragile soul gem and 3 soul sand or soil."
		"&eTip:&r it's the easy way to move villagers or animals to your base."
	]
	quest.3B705B3C46B4208C.title: "Familiar Ring"
	quest.3B705B3C46B4208C.quest_subtitle: "Optional: wear your familiar"
	quest.3B705B3C46B4208C.quest_desc: [
		"&eWhat:&r familiars are summoned with rituals (greedy, bat, beaver, deer, blacksmith...). The ring stores one so it travels with you."
		"&eHow:&r a djinni ritual with a soul gem, two gold and two silver ingots. Capture your familiar with it."
		"&eTip:&r the Greedy Familiar picks up items for you. The Dictionary lists what each familiar does."
	]
	quest.5E236E6AE2C06A35.title: "Bind an Afrit"
	quest.5E236E6AE2C06A35.quest_subtitle: "A spirit of fire"
	quest.5E236E6AE2C06A35.quest_desc: [
		"&eWhat:&r afrits are the third rank of spirits. They power stronger rituals and the deep-mining miner."
		"&eHow:&r a Book of Binding with yellow dye, bound with the spirit's name (see the Dictionary)."
		"&eTip:&r afrit rituals need afrit essence, which only an unbound afrit drops."
	]
	quest.4F9CDFF94B4D9ACC.title: "Gray Chalk"
	quest.4F9CDFF94B4D9ACC.quest_subtitle: "A stronger foundation"
	quest.4F9CDFF94B4D9ACC.quest_desc: [
		"&eWhat:&r gray chalk is the foundation colour of afrit pentacles."
		"&eHow:&r impure white chalk with gray paste (a djinni ritual: gunpowder, clay, a phantom membrane and gray dye), purified in spiritfire."
		"&eTip:&r gray, light gray and black chalk can stand in for white in most pentacles."
	]
	quest.5FDAF6F05B133169.title: "Orange Chalk"
	quest.5FDAF6F05B133169.quest_subtitle: "Sweet bait for an afrit"
	quest.5FDAF6F05B133169.quest_desc: [
		"&eWhat:&r orange chalk lures afrits. It doesn't control them; that takes red chalk."
		"&eHow:&r impure white chalk with cursed honey, glow berries and blaze dust. Cursed honey drops from a possessed bee (djinni possession with honey items and a chicken)."
		"&eTip:&r Ihagan's Enthrallment, the djinni possession pentacle, is white, light gray, lime and gold."
	]
	quest.2A9367B90A0DFF1B.title: "Unbound Afrit"
	quest.2A9367B90A0DFF1B.quest_subtitle: "Summon a wild afrit and defeat it"
	quest.2A9367B90A0DFF1B.quest_desc: [
		"&6You remember fire that obeyed. This one remembers being free.&r"
		"&eWhat:&r the Summon Unbound Afrit ritual calls a hostile afrit. It drops afrit essence when killed."
		"&eHow:&r Kandar's Open Conjure (white, gray, lime, orange, skulls and a spirit-attuned crystal). Netherrack, an iesnium ingot, flint and steel and gunpowder, plus a cow as the sacrifice."
		"&eTip:&r fire resistance potions turn this from a disaster into a fair fight. Build far from anything flammable."
	]
	quest.74374AFF946AA880.title: "Red Chalk"
	quest.74374AFF946AA880.quest_subtitle: "Command an afrit"
	quest.74374AFF946AA880.quest_desc: [
		"&eWhat:&r red chalk is made from afrit essence and lets your pentacles bind afrits instead of just calling them."
		"&eHow:&r impure white chalk with afrit essence, a torchflower and redstone dust, purified in spiritfire."
		"&eTip:&r Sevira's Permanent Confinement (the afrit crafting pentacle) uses red, orange, lime, purple, gray and white."
	]
	quest.1CF5C54EFC2D1E7E.title: "The Wild Hunt"
	quest.1CF5C54EFC2D1E7E.quest_subtitle: "Optional: kill 5 Wild Hunt wither skeletons"
	quest.1CF5C54EFC2D1E7E.quest_desc: [
		"&eWhat:&r the Wild Hunt ritual calls a pack of wither skeletons with a good chance of dropping wither skeleton skulls."
		"&eHow:&r Osorin's Unbound Calling (green, light blue and pink chalk; check the Dictionary). Activated with a skeleton skull; copper, silver and gold blocks, a diamond, netherrack and soul sand, plus a sacrifice."
		"&eTip:&r the easiest way to collect three skulls for the Wither, and the skulls marid pentacles need."
	]
	quest.0E4356789E613F84.title: "Black Chalk"
	quest.0E4356789E613F84.quest_subtitle: "Witherite and netherite"
	quest.0E4356789E613F84.quest_desc: [
		"&eWhat:&r black chalk is the strongest foundation chalk; marid pentacles need it."
		"&eChemistry:&r real witherite is barium carbonate, BaCO₃, named after the 18th-century chemist William Withering. It has nothing to do with the Wither."
		"&eHow:&r impure white chalk with 3 witherite dust. Witherite dust is an afrit ritual: netherite dust, a wither skeleton skull, blackstone dust and a wither rose."
		"&eTip:&r netherite dust comes from crushing a netherite ingot, so save one."
	]
	quest.47FB4F3415A4549B.title: "Bind a Marid"
	quest.47FB4F3415A4549B.quest_subtitle: "The highest spirit you can name"
	quest.47FB4F3415A4549B.quest_desc: [
		"&eWhat:&r marids are the fourth and strongest rank of spirits."
		"&eHow:&r a Book of Binding with green dye, bound with a name like the others."
		"&eTip:&r like the afrit, its essence only comes from an unbound one."
	]
	quest.0EDBA37C95386B2E.title: "Unbound Marid"
	quest.0EDBA37C95386B2E.quest_subtitle: "Summon a wild marid and survive"
	quest.0EDBA37C95386B2E.quest_desc: [
		"&6You remember the sea answering you. This spirit answers to no one.&r"
		"&eWhat:&r the unbound marid is hostile and very strong. It drops marid essence."
		"&eHow:&r Tibira's Attraction (black, red, orange, lime and white chalk, wither skulls and a crystal). A conduit, prismarine crystals, a prismarine shard and a ghast tear; use a trident to start it."
		"&eTip:&r bring your best armor and healing, and don't do it at home."
	]
	quest.0EAE054A4927480F.title: "Blue Chalk"
	quest.0EAE054A4927480F.quest_subtitle: "Command a marid"
	quest.0EAE054A4927480F.quest_desc: [
		"&eWhat:&r blue chalk, made from marid essence, lets pentacles control marids."
		"&eChemistry:&r tube coral builds its skeleton from calcium carbonate (aragonite), the same CaCO₃ as your chalk."
		"&eHow:&r impure white chalk with marid essence, lapis dust and tube coral, purified in spiritfire."
		"&eTip:&r Uphyxes' Inverted Tower, the marid crafting pentacle, makes the master miner and tier 4 stabilizers."
	]
	quest.4AF0ABD9381C2468.title: "Chalk Brush"
	quest.4AF0ABD9381C2468.quest_subtitle: "Optional: clean up after a ritual"
	quest.4AF0ABD9381C2468.quest_desc: [
		"&eWhat:&r right-click chalk glyphs with the brush to wipe them away much faster than breaking them."
		"&eChemistry:&r chalk, CaCO₃, fizzes away in acid: CaCO₃ + 2HCl → CaCl₂ + H₂O + CO₂. A brush is gentler."
		"&eHow:&r three planks over two wool and a string."
	]
	quest.18E119A9C71591E9.title: "Spirit-Attuned Crystal"
	quest.18E119A9C71591E9.quest_subtitle: "Optional: four gems, one anchor"
	quest.18E119A9C71591E9.quest_desc: [
		"&eWhat:&r the crystal anchors bigger pentacles and goes into the mineshaft, miners and the afrit and marid circles."
		"&eChemistry:&r a real crystal is a lattice that repeats in three dimensions; four small gems pressed together would only be a polycrystal."
		"&eHow:&r four spirit-attuned gems in a 2×2 grid."
		"&eTip:&r make two: the mineshaft and the djinni miner each need one."
	]
	quest.5E12AED3193EBD58.title: "Iesnium Tools"
	quest.5E12AED3193EBD58.quest_subtitle: "Optional: the pickaxe every miner needs"
	quest.5E12AED3193EBD58.quest_desc: [
		"&eWhat:&r the iesnium pickaxe mines otherworld blocks and is an ingredient of every miner spirit. The block goes into the Dimensional Mineshaft."
		"&eHow:&r pickaxe: 3 iesnium ingots over 2 sticks. Block: 9 ingots."
		"&eTip:&r you'll want a spare pickaxe for each miner upgrade."
	]
	quest.771B8F5296757381.title: "Apprentice Ritual Satchel"
	quest.771B8F5296757381.quest_subtitle: "Optional: a foliot draws your pentacles"
	quest.771B8F5296757381.quest_desc: [
		"&eWhat:&r fill the satchel with chalks, candles, skulls and crystals; preview a pentacle in the Dictionary and the foliot places the pieces for you."
		"&eHow:&r a foliot crafting ritual: a hopper, a dispenser, 2 wool, 2 leather, string and a silver ingot."
		"&eTip:&r chalks are used up by durability, so keep spares inside."
	]
	quest.5F44A5C536C013A8.title: "Artisanal Ritual Satchel"
	quest.5F44A5C536C013A8.quest_subtitle: "Optional: an afrit sets the whole circle at once"
	quest.5F44A5C536C013A8.quest_desc: [
		"&eWhat:&r the afrit version places a whole pentacle in one click, and can also pick one up again: chalk, candles and all."
		"&eHow:&r an afrit upgrade ritual: the apprentice satchel, afrit essence and 4 ender pearls (it keeps the contents)."
		"&eTip:&r right-click the golden bowl with it to clear an intact pentacle."
	]
	quest.09D8A61036B3E57D.title: "Iesnium Anvil"
	quest.09D8A61036B3E57D.quest_subtitle: "Optional: an anvil a marid helps you pay for"
	quest.09D8A61036B3E57D.quest_desc: [
		"&eWhat:&r an unbreakable anvil that can go one level past an enchantment's maximum, and the marid pays half the level cost."
		"&eHow:&r a marid crafting ritual: an anvil, 3 iesnium blocks and marid essence."
		"&eTip:&r pair it with the Enchantment Library from Apotheosis for top-level books."
	]
	quest.29EA9B8274FEABF7.title: "Rainbow Chalk"
	quest.29EA9B8274FEABF7.quest_subtitle: "Optional: one chalk for every glyph"
	quest.29EA9B8274FEABF7.quest_desc: [
		"&6You remember not needing a circle at all. This is the next best thing.&r"
		"&eWhat:&r rainbow chalk can stand in for any coloured chalk glyph and takes on its look."
		"&eChemistry:&r chalk colours come from pigments; the oldest, like red ochre (Fe₂O₃), are iron oxides people have used for 100,000 years."
		"&eHow:&r the eldritch pentacle with 12 coloured chalks, a sheep as the sacrifice and the brush to start it. The Dictionary shows the circle and the full list."
	]
	chapter.6E579A98FE880FED.title: "Neo Vitae"
	chapter.6E579A98FE880FED.chapter_subtitle: [
		"Blood magic: an altar that drinks, orbs that remember, and rituals carved in stone."
	]
	quest.5D36CB2BA3E716C5.title: "Ara Vitae"
	quest.5D36CB2BA3E716C5.quest_subtitle: "An altar that runs on life"
	quest.5D36CB2BA3E716C5.quest_desc: [
		"&6You remember that every power has a price, and that the oldest price was always blood.&r"
		"&eWhat:&r the Ara Vitae is the heart of Neo Vitae. It turns life into Essentia Vitae (EV) and uses it to transmute items placed on top."
		"&eChemistry:&r blood is about 55% plasma (mostly water, salts and proteins) and 45% cells. Its red comes from haemoglobin, an iron(II) complex that carries O₂."
		"&eHow:&r a furnace, 3 gold ingots and 4 deepslate (the mod's 'vitae stone') in a crafting table."
		"&eTip:&r the guide book, Scriptura Vitae, is a book with 4 redstone; it shows every multiblock."
	]
	quest.6698D1F588C53B2D.title: "Novicius Orb"
	quest.6698D1F588C53B2D.quest_subtitle: "A diamond that holds your blood"
	quest.6698D1F588C53B2D.quest_desc: [
		"&eWhat:&r an Orb of Vitae is your personal EV network. Right-click it to bleed into it; machines and sigils draw from it anywhere."
		"&eChemistry:&r the orb starts as a diamond: pure carbon in a tetrahedral lattice, hard enough to hold whatever the altar pours into it."
		"&eHow:&r place a diamond on the empty altar and stand close. With no blood of its own, the altar draws from anyone nearby."
		"&eTip:&r watch your hearts while bleeding. Eat well first; regeneration is your fuel."
	]
	quest.6EED43714E3E8F31.title: "Tabula Rasa"
	quest.6EED43714E3E8F31.quest_subtitle: "Blank slates for everything"
	quest.6EED43714E3E8F31.quest_desc: [
		"&eWhat:&r Tabula Rasa is the blank slate in almost every Neo Vitae recipe: runes, sigils, tables and fuel cells."
		"&eChemistry:&r deepslate is metamorphosed rock: heat and pressure deep underground recrystallised it into dense, layered stone."
		"&eHow:&r put deepslate on the altar with blood in it. Cobblestone on the altar also turns into cobbled deepslate for 50 EV."
		"&eTip:&r make a stack; you will use them faster than you expect."
	]
	quest.68EBC363A4C85F7C.title: "Tabula Vitae"
	quest.68EBC363A4C85F7C.quest_subtitle: "The alchemy table"
	quest.68EBC363A4C85F7C.quest_desc: [
		"&eWhat:&r the Tabula Vitae combines up to six items with EV from the orb inside it: reagents, catalysts, cutting fluids, anointments."
		"&eChemistry:&r its gunpowder recipe is real: sulfur, saltpetre (KNO₃) and charcoal, about 10:75:15 by mass in classic black powder."
		"&eHow:&r deepslate, planks, iron and gold ingots and a Tabula Rasa. Put your orb in its orb slot."
		"&eTip:&r it also grinds an ore block into 2 dust, the pack's normal pre-acid yield."
	]
	quest.067F539FCB6023EF.title: "Throwing Daggers"
	quest.067F539FCB6023EF.quest_subtitle: "Wounds that leave something behind"
	quest.067F539FCB6023EF.quest_desc: [
		"&eWhat:&r creatures killed with throwing daggers drop Spiritus, the residue of a soul. The Hellfire Forge burns it."
		"&eHow:&r 2 iron ingots and a string in the Tabula Vitae make 16 daggers."
		"&eTip:&r a Sentient Sword collects Spiritus much faster once you have one."
	]
	quest.646A47024D9CB316.title: "Arcane Scribe Tool"
	quest.646A47024D9CB316.quest_subtitle: "Draw circles on the ground"
	quest.646A47024D9CB316.quest_desc: [
		"&eWhat:&r the Arcane Scribe Tool draws an Alchemy Array. Drop two items into an array and it crafts a sigil or casts an effect."
		"&eChemistry:&r it is made of redstone, white dye, gunpowder and coal: a pigment, a binder and a little fire."
		"&eHow:&r Tabula Vitae, then right-click the ground with the tool."
		"&eTip:&r JEI lists every array recipe under the Alchemy Array category."
	]
	quest.68017FF35A6697CF.title: "Divination Sigil"
	quest.68017FF35A6697CF.quest_subtitle: "Read your own blood"
	quest.68017FF35A6697CF.quest_desc: [
		"&eWhat:&r the Divination Sigil shows how much EV is in your network and in an altar you look at."
		"&eHow:&r an Alchemy Array with redstone first, then a Tabula Rasa."
		"&eTip:&r keep it handy while you build up the altar; it tells you when a craft has enough EV."
	]
	quest.035456673F726A27.title: "Water and Lava Sigils"
	quest.035456673F726A27.quest_subtitle: "Carry a spring and a volcano"
	quest.035456673F726A27.quest_desc: [
		"&eWhat:&r the Water Sigil places water and the Lava Sigil places lava, each for a little EV."
		"&eChemistry:&r lava plus cobblestone in the Tabula Vitae gives sulfur: volcanoes really do deposit sulfur where their gases (H₂S, SO₂) cool at vents."
		"&eHow:&r make Reagent Water and Reagent Lava in the Tabula Vitae, then put each in an array with a Tabula Rasa."
		"&eTip:&r the Water Sigil also replaces water bottles in some Tabula recipes."
	]
	quest.2F31D9AA48043EB7.title: "Blank Runes"
	quest.2F31D9AA48043EB7.quest_subtitle: "The altar grows downward"
	quest.2F31D9AA48043EB7.quest_desc: [
		"&eWhat:&r runes around the altar raise its tier. Tier II is a ring of 8 runes one block below the altar."
		"&eHow:&r deepslate, a Tabula Rasa and your orb in a crafting table (the orb is not used up). Scriptura Vitae shows each tier's layout."
		"&eTip:&r blank runes count for the structure; upgraded runes add their effect on top."
	]
	quest.1CE190A4D6321064.title: "Sacrifice and Speed"
	quest.1CE190A4D6321064.quest_subtitle: "Runes that do something"
	quest.1CE190A4D6321064.quest_desc: [
		"&eWhat:&r Runes of Sacrifice give more EV per creature killed near the altar; Speed Runes make it craft faster."
		"&eHow:&r both start from a blank rune. Sacrifice needs a Tabula Robur, gold and an Apprentice orb or better; Speed needs Tabula Rasa and sugar."
		"&eTip:&r a mob farm next to a ring of Sacrifice runes feeds the altar while you're away."
	]
	quest.1F251E1D6739FDF7.title: "Discipulus Orb"
	quest.1F251E1D6739FDF7.quest_subtitle: "Tier II: the second orb"
	quest.1F251E1D6739FDF7.quest_desc: [
		"&6You remember the weight of a bigger vessel, and how much more it could hold.&r"
		"&eWhat:&r a bigger orb holds more EV and unlocks tier-2 recipes, including the Sacrifice rune and Tabula Robur."
		"&eHow:&r a block of redstone on a Tier II altar (8 runes), 5,000 EV."
		"&eTip:&r keep the old orb; Tabula recipes that need a lower orb accept a higher one."
	]
	quest.1CDAB99B2BB3535D.title: "Stronger Slates"
	quest.1CDAB99B2BB3535D.quest_subtitle: "Robur and Animata"
	quest.1CDAB99B2BB3535D.quest_desc: [
		"&eWhat:&r Tabula Robur and Tabula Animata are the next slates: runes, sigils, casings and the Athanor need them."
		"&eHow:&r a Tabula Rasa on the altar becomes Robur (2,000 EV); Robur on a Tier III altar becomes Animata."
		"&eTip:&r slates are where most of your EV goes early on. Upgrade the altar before mass-producing them."
	]
	quest.79BA36D342715B75.title: "Sigil of Holding"
	quest.79BA36D342715B75.quest_subtitle: "Five sigils, one slot"
	quest.79BA36D342715B75.quest_desc: [
		"&eWhat:&r the Sigil of Holding stores other sigils and lets you switch between them."
		"&eHow:&r Reagent Holding (chest, leather, 2 string) in an array with a Tabula Animata."
		"&eTip:&r put your Water, Lava and Divination sigils in it to free hotbar slots."
	]
	quest.303A621549A04817.title: "Hellfire Forge"
	quest.303A621549A04817.quest_subtitle: "A forge that burns souls"
	quest.303A621549A04817.quest_desc: [
		"&eWhat:&r the Hellfire Forge combines items using Spiritus in its gem slot instead of fuel."
		"&eHow:&r iron ingots, an iron block, deepslate and a Tabula Rasa. Kill mobs with throwing daggers and pick up the Spiritus they drop."
		"&eTip:&r a recipe only starts if the gem holds at least its minimum Spiritus. JEI shows both numbers."
	]
	quest.317BE4308F8FE6FB.title: "Petty Spiritus Gem"
	quest.317BE4308F8FE6FB.quest_subtitle: "Somewhere to keep it"
	quest.317BE4308F8FE6FB.quest_desc: [
		"&eWhat:&r Spiritus gems store Spiritus and soak up any you pick up, so it stops cluttering your inventory."
		"&eChemistry:&r lapis lazuli is mostly lazurite, a sodium aluminium silicate whose blue comes from trapped S₃⁻ radical ions."
		"&eHow:&r redstone, a gold ingot, glass and lapis in the Hellfire Forge."
		"&eTip:&r bigger gems come later from the same forge; each holds much more."
	]
	quest.5E12ADBD0D83C3F6.title: "Sentient Sword"
	quest.5E12ADBD0D83C3F6.quest_subtitle: "A blade that takes its share"
	quest.5E12ADBD0D83C3F6.quest_desc: [
		"&eWhat:&r the Sentient Sword collects Spiritus from every kill and hits harder the more Spiritus you carry."
		"&eHow:&r an iron sword in the Hellfire Forge with a Petty Spiritus Gem as catalyst (the gem stays)."
		"&eTip:&r the axe, pickaxe, shovel and scythe work the same way."
	]
	quest.12A553D541821422.title: "Veneficus Orb"
	quest.12A553D541821422.quest_subtitle: "Tier III: rituals open"
	quest.12A553D541821422.quest_desc: [
		"&eWhat:&r the third orb. With it come ritual stones, the Master Ritual Stone and activation crystals."
		"&eChemistry:&r gold is the input: it barely reacts with anything, which is why it lasts in the ground as native metal."
		"&eHow:&r a block of gold on a Tier III altar, 25,000 EV. Scriptura Vitae shows the Tier III layout."
		"&eTip:&r Runes of Capacity and Charging help the altar hold enough EV for this craft."
	]
	quest.6643E667BC436BD7.title: "Master Ritual Stone"
	quest.6643E667BC436BD7.quest_subtitle: "Carve the circle"
	quest.6643E667BC436BD7.quest_desc: [
		"&eWhat:&r a ritual is a Master Ritual Stone surrounded by inscribed ritual stones in a fixed pattern, started with an activation crystal."
		"&eHow:&r ritual stones from obsidian, Tabula Robur and a Discipulus orb; the master stone needs the Veneficus orb. The crystal is a Lava Crystal on the altar."
		"&eTip:&r the Ritual Diviner places a whole ritual's stones for you, already inscribed."
	]
	quest.6984375DCD2592CE.title: "Ritual Diviner"
	quest.6984375DCD2592CE.quest_subtitle: "Place a whole ritual at once"
	quest.6984375DCD2592CE.quest_desc: [
		"&eWhat:&r the Ritual Diviner builds a chosen ritual around a Master Ritual Stone, stone by stone, from your inventory."
		"&eHow:&r the four elemental inscription tools (ghast tear, obsidian, magma cream, lapis block on the altar) with diamonds and a stick."
		"&eTip:&r useful early rites: Green Grove (crops), Harvest, Well of Suffering (EV from mobs) and Magnetism (ores, like a slow quarry)."
	]
	quest.1F756503ABFB5B65.title: "Athanor"
	quest.1F756503ABFB5B65.quest_subtitle: "An alchemical furnace with a thermostat"
	quest.1F756503ABFB5B65.quest_desc: [
		"&eWhat:&r the Athanor is Neo Vitae's reaction chamber: ore processing, sulfur from netherrack, blood shards and the late gems."
		"&eChemistry:&r a medieval athanor was a furnace that fed itself charcoal to hold one steady heat. Holding a temperature is a control problem, so here it needs analog circuits."
		"&eHow:&r deepslate, 2 Tabula Animata, a furnace, a Veneficus orb and 2 MI analog circuits (LV). Tools go in its tool slot: cutting fluid, resonator, hydration cell."
		"&eTip:&r it runs at half speed with no Raw Spiritus in the chunk and up to double speed when the chunk is full."
	]
	quest.38AAD029073B21E9.title: "Blood and Ore"
	quest.38AAD029073B21E9.quest_subtitle: "Cutting fluid and fragments"
	quest.38AAD029073B21E9.quest_desc: [
		"&eWhat:&r with Cutting Fluid as its tool, the Athanor breaks an ore block into 2 fragments, then gravel, then dust."
		"&eChemistry:&r in this pack the big ore multipliers belong to acids (HCl, H₂SO₄ in Mekanism): dissolving ore frees metal that crushing leaves behind."
		"&eHow:&r Basic Cutting Fluid is plant oil, redstone, gunpowder, sugar, coal dust and water in the Tabula Vitae. Raw ore goes straight to 1 dust with a small bonus chance."
		"&eTip:&r this is a magic route at the normal 2x cap, not a shortcut past the acid lines."
	]
	quest.404C39F1827D431D.title: "Tau Fruit"
	quest.404C39F1827D431D.quest_subtitle: "Something grows on the other side"
	quest.404C39F1827D431D.quest_desc: [
		"&eWhat:&r the ritual Breaching the Edge of Demon Realm builds a small dungeon that leads into the Demon Realm, where Tau fruit grows wild."
		"&eHow:&r start the ritual on a Master Ritual Stone (the Diviner lists it); it needs a large EV pool. Bring armour and food."
		"&eTip:&r replant Tau. A creature standing on the plant while it ripens turns it into Saturated Tau."
	]
	quest.3F5BBC5F4250B1CA.title: "Weak Blood Shard"
	quest.3F5BBC5F4250B1CA.quest_subtitle: "Concentrated life"
	quest.3F5BBC5F4250B1CA.quest_desc: [
		"&eWhat:&r Weak Blood Shards open Tier IV: the Magus orb, stronger anointments and potion catalysts."
		"&eHow:&r Saturated Tau (strong_tau) in the Athanor with a hydration cell as the tool and 3,200 mB of Essentia Vitae."
		"&eTip:&r the Primitive Hydration Cell is cobblestone, a water bucket, a Tabula Rasa and a Veneficus orb."
	]
	quest.35DCB0A86D3D507F.title: "Magus Orb"
	quest.35DCB0A86D3D507F.quest_subtitle: "Tier IV: the deep end"
	quest.35DCB0A86D3D507F.quest_desc: [
		"&6You remember the altar answering before you asked. Your blood and the stone keep the same time now.&r"
		"&eWhat:&r the fourth orb, for Tier IV recipes and the Awakened Activation Crystal."
		"&eHow:&r a Weak Blood Shard on a Tier IV altar, 40,000 EV."
		"&eTip:&r stock up EV first; the altar drains fast on big crafts."
	]
	quest.6C8C3EE72DBD4CEB.title: "Sentient Armour"
	quest.6C8C3EE72DBD4CEB.quest_subtitle: "Armour that trains itself"
	quest.6C8C3EE72DBD4CEB.quest_desc: [
		"&eWhat:&r Sentient Armour gains upgrades from what you do while wearing it: running, taking hits, mining, eating."
		"&eHow:&r an Alchemy Array with Reagent Binding (glowstone, redstone, gunpowder, gold nugget) and an iron chestplate."
		"&eTip:&r the Elytra upgrade only comes as a tome from Demon Realm loot; it glides like a normal elytra."
	]
	quest.654009A64A9CDD54.title: "Tenebrae Ink"
	quest.654009A64A9CDD54.quest_subtitle: "Dark runes, flight and the big rites"
	quest.654009A64A9CDD54.quest_desc: [
		"&eWhat:&r the Tenebrae inscription tool carves the dark ritual stones of the big rites: Condor (flight in an area), Torment Nexus, Enchanted Vitae."
		"&eChemistry:&r soot (carbon black) is the oldest ink there is. Here a coal block is made into ink with 2 hydrogen (chemlib:hydrogen) and an MI electronic circuit (MV)."
		"&eHow:&r Tabula Vitae with a Magus-level setup. The Flight elixir (Suspended + Levitation fused with a Combinational Catalyst) also needs 2 hydrogen."
		"&eTip:&r flight in this pack is always a chemistry milestone. The Ritual of Meteo has no catalysts here: ore comes from the ground and from chemistry."
	]
	quest.16A4D003E9E542B5.title: "Ritual Diviner [Tenebrae]"
	quest.16A4D003E9E542B5.quest_subtitle: "Place the dark rites too"
	quest.16A4D003E9E542B5.quest_desc: [
		"&eWhat:&r the Tenebrae diviner can place every Tier IV ritual, including the Ritual of the Condor."
		"&eHow:&r your Ritual Diviner, 2 Tenebrae tools and 2 Tabula Spiritus."
		"&eTip:&r the Ritual Configurator changes a ritual's area and options."
	]
	quest.46C020E0C1CDA4CB.title: "Hellforged Metal"
	quest.46C020E0C1CDA4CB.quest_subtitle: "Ore from the Demon Realm"
	quest.46C020E0C1CDA4CB.quest_desc: [
		"&eWhat:&r demonite ore lies deep in the Demon Realm's Endless dungeon. Its metal makes the Dominus orb and the reinforced runes."
		"&eHow:&r the Highway to Hell ritual opens the Endless dungeon. Smelt or blast raw demonite into Hellforged Ingots."
		"&eTip:&r Hellforged Dust, which better cutting fluids need, comes from ingots in the Athanor."
	]
	quest.53F7D3A8E2BF03FF.title: "Dominus Orb"
	quest.53F7D3A8E2BF03FF.quest_subtitle: "Tier V"
	quest.53F7D3A8E2BF03FF.quest_desc: [
		"&eWhat:&r the fifth orb, made from a block of Hellforged metal."
		"&eHow:&r a Hellforged Block on a Tier V altar, 80,000 EV. Tier V needs upgraded runes and capstones (see Scriptura Vitae)."
		"&eTip:&r Reinforced runes (netherite scrap + Hellforged Parts) double a rune's effect."
	]
	quest.783F8AF95E019FA0.title: "Divinus Orb"
	quest.783F8AF95E019FA0.quest_subtitle: "Tier VI: the last altar"
	quest.783F8AF95E019FA0.quest_desc: [
		"&6You remember the last altar: not a tool any more, but a promise kept in stone.&r"
		"&eWhat:&r the sixth and final orb. It opens the Deus rites and the top of Vitaemancy."
		"&eHow:&r a Crystal Cluster (sculk, Tabula Aetherea, a Weak Blood Shard and a Nether Star in the Hellfire Forge) on a Tier VI altar, 200,000 EV."
		"&eTip:&r Nether Stars only come from the Wither here; a diamond can't be turned into one."
	]
	quest.05C3D2E2FA44B05B.title: "Tome of Peritia"
	quest.05C3D2E2FA44B05B.quest_subtitle: "Bottle your experience"
	quest.05C3D2E2FA44B05B.quest_desc: [
		"&eWhat:&r the Tome of Peritia stores experience levels so you can spend them later."
		"&eHow:&r an enchanted book, lapis blocks, gold, string, 2 Tabula Animata and a Veneficus orb."
		"&eTip:&r the Array of Liquified Experience moves stored XP into a tank as fluid."
	]
	chapter.5BBA2E199EC82256.title: "Apotheosis"
	chapter.5BBA2E199EC82256.chapter_subtitle: [
		"Affix loot, gems, enchanting beyond level 30, spawners and Gateways."
	]
	quest.0823E0B0B994DD08.title: "Gem Dust"
	quest.0823E0B0B994DD08.quest_subtitle: "The currency of Apotheosis"
	quest.0823E0B0B994DD08.quest_desc: [
		"&6You remember gear that remembered you back. Mortal gear can learn, if you teach it.&r"
		"&eWhat:&r Apotheosis gear can roll affixes and sockets. Gems drop from mobs and chests; gem dust builds its tables."
		"&eHow:&r crush spare gems into gem dust (JEI shows how)."
		"&eTip:&r keep good gems for sockets and crush the rest."
	]
	quest.6E58E2BD59CFAE57.title: "Simple Reforging"
	quest.6E58E2BD59CFAE57.quest_subtitle: "Reroll an item's affixes"
	quest.6E58E2BD59CFAE57.quest_desc: [
		"&eWhat:&r the Simple Reforging Table rerolls affixes on gear of lower rarities."
		"&eHow:&r an enchanting table, iron, smooth stone and gem dust."
		"&eTip:&r reforging costs rarity materials; salvage junk gear to get them."
	]
	quest.57C95E565D3B2119.title: "Salvaging"
	quest.57C95E565D3B2119.quest_subtitle: "Junk gear into rarity materials"
	quest.57C95E565D3B2119.quest_desc: [
		"&eWhat:&r the Salvaging Table breaks affixed gear into materials of its rarity."
		"&eHow:&r a smithing table, iron tools, copper, a lava bucket and gem dust (check JEI)."
		"&eTip:&r every affixed sword you don't want is a reforge for one you do."
	]
	quest.629C34B0AC068654.title: "Gem Cutting"
	quest.629C34B0AC068654.quest_subtitle: "Combine gems into higher purities"
	quest.629C34B0AC068654.quest_desc: [
		"&eWhat:&r the Gem Cutting Table upgrades gems to higher purity using matching gems and dust."
		"&eChemistry:&r real gems are cut along cleavage planes, flat directions where the crystal's bonds are weakest."
		"&eHow:&r planks, smooth stone, shears and gem dust."
	]
	quest.153E1F2212F6740C.title: "Divine Reforging"
	quest.153E1F2212F6740C.quest_subtitle: "Reforge any rarity, up to mythic"
	quest.153E1F2212F6740C.quest_desc: [
		"&6You remember weapons that chose their wielders. These at least choose good affixes.&r"
		"&eWhat:&r the full Reforging Table handles every rarity, up to mythic gear."
		"&eHow:&r the Simple Reforging Table, netherite, nether bricks and arcane sands (check JEI)."
	]
	quest.563D61599C12CF41.title: "Better Bookshelves"
	quest.563D61599C12CF41.quest_subtitle: "Optional: push enchanting past level 30"
	quest.563D61599C12CF41.quest_desc: [
		"&eWhat:&r Apothic Enchanting adds shelves that raise enchanting power, quanta and arcana. Hellshelves are the first step."
		"&eHow:&r bookshelves, nether bricks and a blaze rod. Create: Enchantment Industry can automate enchanting later."
		"&eTip:&r enchanting power above 30 unlocks enchantments beyond vanilla levels."
	]
	quest.12EF5F7791329CED.title: "Sigil of Socketing"
	quest.12EF5F7791329CED.quest_subtitle: "Optional: add a socket to any gear"
	quest.12EF5F7791329CED.quest_desc: [
		"&eWhat:&r adds a socket to gear in a smithing table, so you can slot in a gem."
		"&eHow:&r gem-fused slate, amethyst, gunpowder and gem dust (check JEI)."
		"&eTip:&r a Sigil of Withdrawal pulls gems back out later."
	]
	quest.0C78BE8ECFF1CD59.title: "Augmenting"
	quest.0C78BE8ECFF1CD59.quest_subtitle: "Optional: upgrade and reroll single affixes"
	quest.0C78BE8ECFF1CD59.quest_desc: [
		"&eWhat:&r the Augmenting Table improves or rerolls one affix at a time."
		"&eHow:&r an enchanting table, a Nether Star, a godforged pearl and polished blackstone (check JEI)."
		"&eTip:&r save it for gear you plan to keep for the rest of the game."
	]
	quest.124C0733D11EE060.title: "Bottled Monsters"
	quest.124C0733D11EE060.quest_subtitle: "Optional: mine a spawner with Silk Touch"
	quest.124C0733D11EE060.quest_desc: [
		"&eWhat:&r with Apothic Spawners a monster spawner can be picked up with a Silk Touch pickaxe and moved home."
		"&eHow:&r find one in a dungeon or mineshaft, light it up, then mine it with Silk Touch. Check its tooltip after placing."
		"&eTip:&r spawners are mob farms for drops you can't make chemically: bones, string, ender pearls, blaze rods."
	]
	quest.4175DD97D428CAF7.title: "Spawner Runes"
	quest.4175DD97D428CAF7.quest_subtitle: "Optional: rewrite a spawner's rules"
	quest.4175DD97D428CAF7.quest_desc: [
		"&eWhat:&r spawner runes change a spawner when you right-click it: spawn without players nearby, obey redstone, set mobs on fire, stay silent, and more."
		"&eHow:&r a basic Spawner Rune is gem dust, gem-fused slate and spawner chains (check JEI for where chains come from). Each modifier rune adds one item, like campfires for Burning."
		"&eTip:&r Redstone Control first, so you can switch the farm off when you don't need it."
	]
	quest.29B876259D4B5686.title: "Elite Hunting"
	quest.29B876259D4B5686.quest_subtitle: "Kill 50 zombies and watch for affix gear"
	quest.29B876259D4B5686.quest_desc: [
		"&eWhat:&r Apotheosis gives some monsters affixed gear and makes rare elites with a coloured name. Their drops can roll affixes and sockets."
		"&eHow:&r kill 50 zombies. Pick up any named or glowing item they drop and read its tooltip."
		"&eTip:&r elites hit hard. Gear up before poking one with a stick."
	]
	quest.1F426EE32EDF30C4.title: "Potion Charm"
	quest.1F426EE32EDF30C4.quest_subtitle: "Optional: a potion that never runs out (almost)"
	quest.1F426EE32EDF30C4.quest_desc: [
		"&eWhat:&r a Potion Charm holds a potion effect and applies it while switched on, using durability."
		"&eChemistry:&r blaze powder is a reactive powder; here it fixes the potion so it lasts, a bit like a preservative."
		"&eHow:&r three identical potions in the middle row and six blaze powder around them. Infusing it later makes it permanent (check JEI)."
		"&eTip:&r Night Vision or Haste charms are the most useful early."
	]
	quest.645E6EA4F2C67FAB.title: "Rarity Materials"
	quest.645E6EA4F2C67FAB.quest_subtitle: "Scrap, fabric, crystal, sand, pearl"
	quest.645E6EA4F2C67FAB.quest_desc: [
		"&eWhat:&r each rarity salvages into its own material: common scrap metal, uncommon timeworn fabric, rare luminous crystal, epic arcane sands, mythic godforged pearls."
		"&eHow:&r salvage rare (blue) gear in the Salvaging Table until you have 4 luminous crystal shards."
		"&eTip:&r reforging uses the material of that rarity, so sort your loot by colour before salvaging."
	]
	quest.30908A094F9B094F.title: "Gate Pearl"
	quest.30908A094F9B094F.quest_subtitle: "Gateways to Eternity: a wave-based arena"
	quest.30908A094F9B094F.quest_desc: [
		"&eWhat:&r a Gate Pearl opens a Gateway that releases waves of a chosen mob. Beat every wave for rewards."
		"&eHow:&r the Blaze gate is five blaze rods, an ender pearl and three nether bricks. Apotheosis adds tiered gates (Frontier and up); JEI shows them all."
		"&eTip:&r a gate is a controlled mob farm: blaze rods, ender pearls and XP on demand."
	]
	quest.29DC8827585EFBB8.title: "Close a Gateway"
	quest.29DC8827585EFBB8.quest_subtitle: "Survive every wave"
	quest.29DC8827585EFBB8.quest_desc: [
		"&eWhat:&r the gateway closes when every wave is defeated and pays out its reward."
		"&eHow:&r throw the pearl in an open area, stay close (leaving fails the gate) and kill each wave. Click the checkmark when it closes."
		"&eTip:&r tiered Apotheosis gates hand out affix gear and rarity materials."
	]
	quest.0E850BA9288D13B8.title: "Sigil of Withdrawal"
	quest.0E850BA9288D13B8.quest_subtitle: "Optional: get your gems back"
	quest.0E850BA9288D13B8.quest_desc: [
		"&eWhat:&r pulls every gem out of an item without destroying them, so a good gem can move to new gear."
		"&eHow:&r gem-fused slate, blaze rods, ender pearls, a lava bucket and gem dust (makes 4)."
		"&eTip:&r withdraw gems before salvaging or reforging old gear."
	]
	quest.074EDD3891190AD6.title: "Sigil of Enhancement"
	quest.074EDD3891190AD6.quest_subtitle: "Optional: raise a gem's rarity"
	quest.074EDD3891190AD6.quest_desc: [
		"&eWhat:&r upgrades a socketed gem to the next rarity at the Reforging Table."
		"&eHow:&r gem-fused slate, gem dust and a godforged pearl (makes 4). Godforged pearls come from salvaging mythic gear."
		"&eTip:&r save these for gems you'll keep: a mythic gem in endgame gear is worth it."
	]
	quest.0DA470EE8E63A89F.title: "Infusion"
	quest.0DA470EE8E63A89F.quest_subtitle: "Enchant a block instead of a tool"
	quest.0DA470EE8E63A89F.quest_desc: [
		"&eWhat:&r Apothic Enchanting can 'infuse' items: enchanting a hellshelf at the right power makes an Infused Hellshelf."
		"&eHow:&r put a hellshelf in the enchanting table with enough shelves around it. JEI's infusion page shows the exact Eterna, Quanta and Arcana it needs."
		"&eTip:&r the table's three stats are shown on the screen: power, randomness and how many extra enchantments you get."
	]
	quest.67476A5068C80199.title: "Enchantment Library"
	quest.67476A5068C80199.quest_subtitle: "Store every enchanted book"
	quest.67476A5068C80199.quest_desc: [
		"&eWhat:&r the Library absorbs enchanted books and stores their enchantments as points, then pulls out any level you've collected."
		"&eHow:&r four ender chests, four infused shelves and an enchanting table."
		"&eTip:&r it only gives back levels up to the highest single book you fed it, so feed it every spare book."
	]
	quest.2103D96D8A9B8008.title: "Endshelves"
	quest.2103D96D8A9B8008.quest_subtitle: "Optional: the strongest shelf family"
	quest.2103D96D8A9B8008.quest_desc: [
		"&eWhat:&r endshelves push enchanting power past what hellshelves and seashelves allow."
		"&eHow:&r end stone bricks, a bookshelf, an ender pearl and Infused Breath (dragon's breath infused at the enchanting table)."
		"&eTip:&r collect dragon's breath in glass bottles during the Ender Dragon fight."
	]
	quest.742D6F656F7BFD9B.title: "Scrap Tome"
	quest.742D6F656F7BFD9B.quest_subtitle: "Optional: recycle enchanted gear"
	quest.742D6F656F7BFD9B.quest_desc: [
		"&eWhat:&r a Scrap Tome in an anvil with enchanted gear strips off some of its enchantments into a book (the gear is destroyed)."
		"&eHow:&r eight books around an anvil makes eight tomes."
		"&eTip:&r the Extraction Tome (infused) keeps the item; check JEI's infusion page."
	]
	quest.5816867DEF0C5DBF.title: "Gem-Fused Slate"
	quest.5816867DEF0C5DBF.quest_subtitle: "Optional: the base of every sigil"
	quest.5816867DEF0C5DBF.quest_desc: [
		"&eWhat:&r gem-fused slate is the backing for sigils and spawner runes."
		"&eChemistry:&r deepslate is metamorphic rock: older stone squeezed and heated deep underground until its minerals recrystallised."
		"&eHow:&r 8 deepslate around 1 gem dust makes 8."
	]
	quest.42B5A285CF0DDEC1.title: "Working Sigils"
	quest.42B5A285CF0DDEC1.quest_subtitle: "Optional: fuel reforging, or clear a name"
	quest.42B5A285CF0DDEC1.quest_desc: [
		"&eWhat:&r the Sigil of Rebirth fuels the Reforging Table; the Sigil of Unnaming removes an item's affix name."
		"&eHow:&r Rebirth: 6 slate around 3 gem dust. Unnaming: 6 slate around 3 flint. Each makes 6."
		"&eTip:&r the rarer sigils (Malice, Supremacy) come from Gateways, not the crafting grid."
	]
	quest.4E86CCB805AC4C3A.title: "Gem Case"
	quest.4E86CCB805AC4C3A.quest_subtitle: "Optional: a display case that upgrades gems"
	quest.4E86CCB805AC4C3A.quest_desc: [
		"&eWhat:&r a cabinet that stores gems by type and purity and can combine two of a kind into the next purity."
		"&eChemistry:&r a ruby is corundum (Al₂O₃) with about 1% chromium. Less chromium and it's a pink sapphire."
		"&eHow:&r glass on top, basalt around a Gem Cutting Table, and an ender chest below."
		"&eTip:&r infused at the enchanting table it becomes the Gem Case of House Fabergé, which keeps the gems inside."
	]
	quest.3A57E3617E30E375.title: "House Fabergé"
	quest.3A57E3617E30E375.quest_subtitle: "Optional: the best gem case"
	quest.3A57E3617E30E375.quest_desc: [
		"&eWhat:&r the infused Gem Case. It keeps everything stored in the old one."
		"&eHow:&r infuse a Gem Case at an enchanting table with very high stats (JEI's infusion page: 100 Eterna and Quanta)."
		"&eTip:&r you'll need endshelves or deepshelves to reach those numbers."
	]
	quest.107F658AC0B2249C.title: "Every Rarity"
	quest.107F658AC0B2249C.quest_subtitle: "Optional: scrap, fabric, sands and a pearl"
	quest.107F658AC0B2249C.quest_desc: [
		"&eWhat:&r one material of each other rarity: common scrap metal, uncommon timeworn fabric, epic arcane sands and a mythic godforged pearl."
		"&eHow:&r salvage gear of each colour. The pearl only comes from mythic gear: tiered Gateways and the toughest elites."
		"&eTip:&r Divine Reforging, upgrade runes and the strongest sigils all spend these."
	]
	quest.3D6835D5C5C226C2.title: "God-Fused Pearl"
	quest.3D6835D5C5C226C2.quest_subtitle: "Optional: infuse a mythic pearl"
	quest.3D6835D5C5C226C2.quest_desc: [
		"&6You remember something like this sitting in your crown. It was warmer then.&r"
		"&eWhat:&r a godforged pearl infused at a maxed-out enchanting table, used for the Raven's table."
		"&eHow:&r an enchanting table at 100 Eterna, about 59 Arcana and 10 Quanta (JEI's infusion page has the exact window)."
	]
	quest.455E28217ADB7ECE.title: "Enchanting Table of the Raven"
	quest.455E28217ADB7ECE.quest_subtitle: "Optional: set the enchanting stats yourself"
	quest.455E28217ADB7ECE.quest_desc: [
		"&eWhat:&r an enchanting table where you set the core stats by hand instead of building shelves."
		"&eHow:&r an Apothic enchanting table, 2 god-fused pearls, 3 obsidian and a perfect Royalty gem (check JEI)."
		"&eTip:&r a late luxury: a good shelf room already does most of this."
	]
	quest.115518D0E8FADA52.title: "Spawner Chains"
	quest.115518D0E8FADA52.quest_subtitle: "Optional: blow up a spawner"
	quest.115518D0E8FADA52.quest_desc: [
		"&eWhat:&r spawner chains are the binding for spawner runes. They only come from a monster spawner destroyed by an explosion."
		"&eChemistry:&r TNT (C₇H₅N₃O₆) carries its own oxygen in its nitro groups, so it burns in microseconds and makes a shock wave."
		"&eHow:&r find a spawner you don't want to keep and blow it up with TNT. Pick up the chains."
		"&eTip:&r keep the good spawners: Silk Touch them home instead."
	]
	quest.0A132D9A963A11B1.title: "Stranger Runes"
	quest.0A132D9A963A11B1.quest_subtitle: "Optional: rewrite more spawner rules"
	quest.0A132D9A963A11B1.quest_desc: [
		"&eWhat:&r more runes: spawn in daylight, ignore spawn conditions, weaken mobs, freeze their AI, change the range. Some need an Infused Spawner Rune."
		"&eHow:&r a basic Spawner Rune plus the rune's item (Perpetual Twilight: 4 soul lanterns). The infused rune is a spawner rune infused at the table, or ringed with gem dust and bottles o' enchanting."
		"&eTip:&r Stupor (no AI) makes a mob farm that can't fight back."
	]
	quest.33E489B3C17435FC.title: "Spawner Upgrade Runes"
	quest.33E489B3C17435FC.quest_subtitle: "Optional: faster, bigger spawners"
	quest.33E489B3C17435FC.quest_desc: [
		"&eWhat:&r four tiers of upgrade rune, from Frontiersman's (slightly better) to Thundering (the maximum)."
		"&eHow:&r Frontiersman's: a spawner rune with timeworn fabric, clocks and flint. Higher tiers use rarer materials; Thundering needs godforged pearls and a Nether Star."
		"&eTip:&r save Nether Stars: the Seed of a New World needs them too."
	]
	quest.080F97306DC1EEBE.title: "Curious Shelves"
	quest.080F97306DC1EEBE.quest_subtitle: "Optional: shelves that bend the rules"
	quest.080F97306DC1EEBE.quest_desc: [
		"&eWhat:&r the Stoneshelf, Beeshelf, Melonshelf, Geode shelf and Basic Bookshelf each nudge the table's stats in an odd direction."
		"&eChemistry:&r a geode's calcite rind is CaCO₃, the same compound as chalk and limestone."
		"&eHow:&r Stoneshelf: polished andesite and books. Geode shelf: calcite around a bookshelf and a budding amethyst. JEI has the rest."
		"&eTip:&r every shelf's tooltip lists its Eterna, Quanta and Arcana: read them before you build."
	]
	quest.6D427E6087161CE0.title: "Hellshelf Upgrades"
	quest.6D427E6087161CE0.quest_subtitle: "Optional: blazing, glowing or all-seeing"
	quest.6D427E6087161CE0.quest_desc: [
		"&eWhat:&r the Infused Hellshelf upgrades into Blazing (fire charges), Glowing (glowstone) or the Hellshelf of Sight, which shows more enchantment clues."
		"&eHow:&r an Infused Hellshelf in the grid with the upgrade items (check JEI). Masterful Sight needs netherite and emerald blocks."
		"&eTip:&r one Sightshelf shows much more of what the table will roll."
	]
	quest.50C2261CC96A09E9.title: "Seashelves"
	quest.50C2261CC96A09E9.quest_subtitle: "Optional: the ocean's shelf family"
	quest.50C2261CC96A09E9.quest_desc: [
		"&eWhat:&r seashelves are the second shelf family, with different stats from hellshelves."
		"&eChemistry:&r sea water is about 3.5% dissolved salts, mostly NaCl with magnesium and sulfate ions."
		"&eHow:&r prismarine bricks, a bookshelf, a water bottle and a pufferfish."
	]
	quest.38713E8802C76BD6.title: "Seashelf Upgrades"
	quest.38713E8802C76BD6.quest_subtitle: "Optional: infuse a seashelf"
	quest.38713E8802C76BD6.quest_desc: [
		"&eWhat:&r an Infused Seashelf, then Crystalline, Heart-Forged or the Seashelf of Aquatic Filtration, which keeps chosen enchantments out of the pool."
		"&eHow:&r infuse a seashelf at the table, then craft it with prismarine crystals, a heart of the sea, or prismarine bricks and slabs (check JEI)."
		"&eTip:&r the filtering shelf is how you stop a table rolling the enchantment you never want."
	]
	quest.4E9B6DB7867AE262.title: "Deepshelves"
	quest.4E9B6DB7867AE262.quest_subtitle: "Optional: shelves from the deep dark"
	quest.4E9B6DB7867AE262.quest_desc: [
		"&eWhat:&r the deepshelf family pushes the stats high. It starts dormant and wakes with infusion."
		"&eHow:&r Dormant Deepshelf: cracked deepslate tiles and books. Infuse it at the table to wake it."
		"&eTip:&r upgrade it with echo shards or soul lanterns; the Deepshelf of Arcane Treasures allows treasure enchantments."
	]
	quest.624644FE4BB6E32A.title: "Deepshelf Upgrades"
	quest.624644FE4BB6E32A.quest_subtitle: "Optional: echoing, soul-touched or treasure"
	quest.624644FE4BB6E32A.quest_desc: [
		"&eWhat:&r Echoing and Soul-Touched deepshelves raise the stats further; the treasure shelf lets the table roll treasure enchantments."
		"&eHow:&r a Deepshelf with an echo shard and candles, or a soul lantern and sculk. Treasure: 2 deepshelves, gold blocks, diamonds and an emerald block."
		"&eTip:&r echo shards come from Ancient City chests."
	]
	quest.20558B1364FA3529.title: "Sculkshelves"
	quest.20558B1364FA3529.quest_subtitle: "Optional: take a tendril from the Warden"
	quest.20558B1364FA3529.quest_desc: [
		"&eWhat:&r the strongest deepshelves need a Warden Tendril, which drops from a Warden."
		"&eHow:&r kill a Warden (Ancient City; don't make a sound), then craft the tendril over an upgraded deepshelf with sculk and a sculk catalyst."
		"&eTip:&r a Warden has 500 health and its sonic boom ignores armor. Plan the fight, or plan the escape."
	]
	quest.64304335E8D6B4B1.title: "Endshelf Upgrades"
	quest.64304335E8D6B4B1.quest_subtitle: "Optional: pearlescent or draconic"
	quest.64304335E8D6B4B1.quest_desc: [
		"&eWhat:&r the top of the shelf ladder. The Pearlescent Endshelf adds end rods; the Draconic one is crowned with a dragon head."
		"&eHow:&r infuse dragon's breath for Infused Breath (3 per bottle), then craft an Endshelf with end rods and ender pearls, or a dragon head and pearls."
		"&eTip:&r dragon heads hang on End Ship bows. Bring the elytra home too."
	]
	quest.6434E76C18D3EA01.title: "Better Tomes"
	quest.6434E76C18D3EA01.quest_subtitle: "Optional: books with a single job"
	quest.6434E76C18D3EA01.quest_desc: [
		"&eWhat:&r the Tome of the Others enchants like a tool no other tome covers; Superior Scrapping and Extraction strip enchantments more gently (Extraction keeps the item)."
		"&eHow:&r Tome of the Others: 6 books and a blaze rod (makes 6). Infuse a Scrap Tome for Superior Scrapping, and that for Extraction."
		"&eTip:&r Extraction tomes are the cleanest way to move a good enchantment to new gear."
	]
	quest.73834033716D42E1.title: "Library of Alexandria"
	quest.73834033716D42E1.quest_subtitle: "Optional: the library, infused"
	quest.73834033716D42E1.quest_desc: [
		"&eWhat:&r the infused Enchantment Library stores more and gives back higher levels."
		"&eHow:&r infuse an Enchantment Library at the enchanting table; it keeps the enchantments already inside (check JEI for the stats)."
		"&eTip:&r the real Library of Alexandria burned; keep this one away from your blaze farm."
	]
	quest.4B9E10E49642FC65.title: "Ender Leads"
	quest.4B9E10E49642FC65.quest_subtitle: "Optional: carry a mob in your pocket"
	quest.4B9E10E49642FC65.quest_desc: [
		"&eWhat:&r the Flimsy Ender Lead captures animals; the infused Ender Lead captures most mobs; the Occult one can bind a mob to a spawner."
		"&eHow:&r flimsy: an ender pearl, a lead and a gold ingot (shapeless). Infuse it for the Ender Lead; infuse that holding a witch for the Occult lead."
		"&eTip:&r the easy way to move a villager across the world."
	]
	quest.2FB8A7CEA97331D2.title: "Inert Trident"
	quest.2FB8A7CEA97331D2.quest_subtitle: "Optional: a trident without a drowned"
	quest.2FB8A7CEA97331D2.quest_desc: [
		"&eWhat:&r an inert trident infuses into a real trident at the enchanting table."
		"&eHow:&r 3 nautilus shells, a heart of the sea and an iron ingot. Then infuse it (check JEI for the stats)."
		"&eTip:&r a Channeling trident in a thunderstorm calls lightning where it lands."
	]
	chapter.37F569BC21D75E5E.title: "Relics and Artifacts"
	chapter.37F569BC21D75E5E.chapter_subtitle: [
		"Found treasures and crafted curios: Relics, Artifacts and Reliquary."
	]
	quest.2CAD2D054CB09ACA.title: "Relics"
	quest.2CAD2D054CB09ACA.quest_subtitle: "Reliquary, Relics and Artifacts"
	quest.2CAD2D054CB09ACA.quest_desc: [
		"&6You remember a treasury. Most of it is scattered now, in chests and in the hands of monsters.&r"
		"&eWhat:&r three mods of found and crafted treasures. Reliquary items are crafted from mob parts; Relics and Artifacts hide in chests and structures."
		"&eHow:&r mob charm fragments drop from mobs. JEI shows the charm they build."
		"&eTip:&r a Mob Charm stops that mob type attacking you."
	]
	quest.66B6DA99BDA6AD30.title: "Alkahestry Tome"
	quest.66B6DA99BDA6AD30.quest_subtitle: "The alchemists' dream, in book form"
	quest.66B6DA99BDA6AD30.quest_desc: [
		"&eWhat:&r charged with redstone, the tome duplicates common items in a crafting grid."
		"&eChemistry:&r alchemists searched for alkahest, a universal solvent. None exists (what would you keep it in?), but aqua regia, HCl + HNO₃, dissolves even gold."
		"&eHow:&r check JEI for the tome and its recipes. Recharge it with redstone."
	]
	quest.43308A673FF653BF.title: "Relic Hunter"
	quest.43308A673FF653BF.quest_subtitle: "Optional: find a relic or an artifact"
	quest.43308A673FF653BF.quest_desc: [
		"&eWhat:&r find any Relics or Artifacts item: a cloud in a bottle, running shoes, a leafy mantle, a mimic's treasure."
		"&eHow:&r loot chests in dungeons, mineshafts and towers, and beware chests that bite. Click the checkmark when you have one."
		"&eTip:&r Relics items level up as you use them; check their tooltips."
	]
	quest.08F23BEDD14FD31D.title: "Fortune Coin"
	quest.08F23BEDD14FD31D.quest_subtitle: "Optional: a magnet in your pocket"
	quest.08F23BEDD14FD31D.quest_desc: [
		"&eWhat:&r pulls nearby items and XP toward you while active."
		"&eHow:&r check JEI. Right-click to toggle it."
		"&eTip:&r turn it off near your sorting system or it'll grab the items."
	]
	quest.65639548C2C2E03A.title: "A True Relic"
	quest.65639548C2C2E03A.quest_subtitle: "Find any item from the Relics mod"
	quest.65639548C2C2E03A.quest_desc: [
		"&6You remember owning things no mortal smith made. A few of them seem to have survived.&r"
		"&eWhat:&r Relics are found, never crafted: mantles, belts, necklaces, boots, a chef's hat, a ring of the seven deadly sins. Each has abilities that grow with use."
		"&eHow:&r loot chests in dungeons, mineshafts, temples, villages and modded structures. Any one relic completes this quest."
		"&eTip:&r read the tooltip: each relic says what it does and how it gains experience."
	]
	quest.1C39B10303C8A4FB.title: "Relic Growth"
	quest.1C39B10303C8A4FB.quest_subtitle: "Optional: level up a relic"
	quest.1C39B10303C8A4FB.quest_desc: [
		"&eWhat:&r relics earn experience when you use their abilities, and their levels make those abilities stronger."
		"&eHow:&r keep the relic equipped and use it. Open its ability screen (the tooltip names the key) to spend levels. Click the checkmark after your first upgrade."
		"&eTip:&r one well-levelled relic beats a drawer full of new ones."
	]
	quest.155D611580258963.title: "An Artifact"
	quest.155D611580258963.quest_subtitle: "Find any item from the Artifacts mod"
	quest.155D611580258963.quest_desc: [
		"&eWhat:&r Artifacts are simple, always-on curios: Running Shoes, Cloud in a Bottle, Digging Claws, a Lucky Scarf, Night Vision Goggles and many more."
		"&eHow:&r found in chests underground and in structures, and dropped by Mimics. Any one artifact completes this quest."
		"&eTip:&r a Cloud in a Bottle (double jump) and Running Shoes make early exploring much easier."
	]
	quest.138734AE1F0C3A87.title: "That Chest Has Teeth"
	quest.138734AE1F0C3A87.quest_subtitle: "Kill a Mimic"
	quest.138734AE1F0C3A87.quest_desc: [
		"&eWhat:&r a Mimic looks exactly like a chest until you open it. It always drops an artifact."
		"&eHow:&r they hide in mineshafts, dungeons and caves. If a chest stands somewhere odd, hit it before opening it."
		"&eTip:&r Mimics are tough for their size; fight one with real armor, not a wooden sword."
	]
	quest.73D8CBFF0B71205A.title: "Divine Comedy"
	quest.73D8CBFF0B71205A.quest_subtitle: "Secret: the least dignified artifact"
	quest.73D8CBFF0B71205A.quest_desc: [
		"&6You remember the other gods laughing at something like this. You never admitted it was you.&r"
		"&eWhat:&r the Whoopee Cushion. Equip it and crouch."
		"&eTip:&r it does exactly what you think."
	]
	quest.344B4E30A304E85A.title: "Mob Ingredients"
	quest.344B4E30A304E85A.quest_subtitle: "Hearts, ribs, glands and pearls"
	quest.344B4E30A304E85A.quest_desc: [
		"&eWhat:&r Reliquary items are built from rare mob parts: zombie hearts, rib bones, catalyzing glands, slime pearls, molten cores and more."
		"&eHow:&r they drop from their mobs (zombies drop zombie hearts). In this pack they can also be crafted: a zombie heart is rotten flesh in a ring of iron ingots."
		"&eTip:&r a Looting sword makes the drops much more common than the iron recipe."
	]
	quest.77C7E8214CABA7DB.title: "Mob Charm Belt"
	quest.77C7E8214CABA7DB.quest_subtitle: "Wear all your charms at once"
	quest.77C7E8214CABA7DB.quest_desc: [
		"&eWhat:&r the belt holds Mob Charms, so you can be ignored by several mob types at once."
		"&eHow:&r three leather and five mob charm fragments (check JEI). Each fragment is made from that mob's drops."
		"&eTip:&r creeper and enderman charms are the most valuable around a base."
	]
	quest.1B9288F0EB08F5B2.title: "Void Tear"
	quest.1B9288F0EB08F5B2.quest_subtitle: "A pocket that holds one item type"
	quest.1B9288F0EB08F5B2.quest_desc: [
		"&eWhat:&r a Void Tear stores a huge stack of one item, and pulls more of it from your inventory."
		"&eHow:&r a ghast tear, a nebulous heart, a slime pearl and lapis (shapeless)."
		"&eTip:&r it's also an ingredient for the Infernal Tear, Emperor's Chalice and Midas Touchstone."
	]
	quest.7C823E959B36BA96.title: "Lantern of Paranoia"
	quest.7C823E959B36BA96.quest_subtitle: "Optional: it places torches for you"
	quest.7C823E959B36BA96.quest_desc: [
		"&eWhat:&r the lantern places torches from your inventory wherever it's dark enough for mobs to spawn."
		"&eHow:&r iron ingots, glass, a slime pearl and a molten core (check JEI)."
		"&eTip:&r carry a stack of torches when caving and let it do the lighting."
	]
	quest.37897CAA67020AFC.title: "The Handgun"
	quest.37897CAA67020AFC.quest_subtitle: "Optional: Reliquary's magic pistol"
	quest.37897CAA67020AFC.quest_desc: [
		"&eWhat:&r a pistol that fires magazines of special bullets: neutral, exorcism, blaze, ender, storm, seeker and more."
		"&eHow:&r barrel, grip and hammer assemblies plus iron and a slime pearl. Bullets and magazines have their own recipes (check JEI)."
		"&eTip:&r Seeker bullets home in on targets; good against flying mobs."
	]
	quest.064A1813B7F32692.title: "Phoenix Down"
	quest.064A1813B7F32692.quest_subtitle: "Optional: cheat death several times"
	quest.064A1813B7F32692.quest_desc: [
		"&eWhat:&r saves you from death, heals you, and gives you a few seconds of protection. It has several charges."
		"&eHow:&r three Angelheart Vials and an Angelic Feather. Vials need milk, glass, fertile essence and an infernal claw (check JEI)."
		"&eTip:&r keep it in your inventory before boss fights and Nether trips."
	]
	quest.5E6FBB34947A8DDF.title: "Gold Teeth"
	quest.5E6FBB34947A8DDF.quest_subtitle: "Optional: the Piglin Mask's loot"
	quest.5E6FBB34947A8DDF.quest_desc: [
		"&eWhat:&r with the Piglin Mask's looting ability, kills drop golden teeth: bigger mobs, more teeth. Picking them up can also fire up its frenzy rank."
		"&eChemistry:&r gold crowns last because gold barely reacts with anything in your mouth: it is the least reactive metal of all."
		"&eHow:&r find a Piglin Mask, level its looting ability and fight. Three teeth craft into a gold ingot, or trade them to piglins."
		"&eTip:&r it's mob-drop gold, like a zombified piglin farm: handy, but not ore."
	]
	chapter.53DC761A27800BDC.title: "Equivalent Exchange"
	chapter.53DC761A27800BDC.chapter_subtitle: [
		"A builder's toy for a demigod who has already mastered the elements."
	]
	quest.202454706F0D6586.title: "The Philosopher's Stone"
	quest.202454706F0D6586.quest_subtitle: "Oganesson, at the heart of an old legend"
	quest.202454706F0D6586.quest_desc: [
		"&6You remember turning one thing into another with a thought. Now you know what it really costs.&r"
		"&eWhat:&r the Philosopher's Stone transmutes blocks in the world and is the key to every ProjectE item."
		"&eChemistry:&r alchemists spent centuries looking for a stone that turns lead into gold. Real transmutation needs a nuclear reaction, and you've already done that: it's how you made oganesson."
		"&eHow:&r redstone dust and glowstone dust in a ring around one oganesson (this pack's recipe)."
		"&eTip:&r it isn't used up in crafting recipes, so one stone lasts forever."
	]
	quest.5DF0000BBA218F93.title: "World Transmutation"
	quest.5DF0000BBA218F93.quest_subtitle: "Right-click to reshape the land"
	quest.5DF0000BBA218F93.quest_desc: [
		"&eWhat:&r right-click a block with the stone to turn it into a related block: stone and cobblestone, dirt, grass and sand, one wood or flower type into the next."
		"&eHow:&r an outline shows what will change before you click; sneak-click for the reverse direction. ProjectE's keybinds change the area size and shape."
		"&eTip:&r a whole hillside of stone into cobblestone (or back) takes seconds. Click the checkmark once you've tried it."
	]
	quest.7FE06D3B05479258.title: "Transmutation Table"
	quest.7FE06D3B05479258.quest_subtitle: "Learn a block once, make it forever"
	quest.7FE06D3B05479258.quest_desc: [
		"&eWhat:&r the Transmutation Table turns items into EMC and EMC back into any item you've learned."
		"&eHow:&r four obsidian in the corners, four stone on the sides, the Philosopher's Stone in the centre."
		"&eTip:&r your EMC and your learned items belong to you, not the table: every table you open shows the same list."
	]
	quest.7AA96CF99DD2EA9A.title: "Burn to Learn"
	quest.7AA96CF99DD2EA9A.quest_subtitle: "What EMC can and can't do here"
	quest.7AA96CF99DD2EA9A.quest_desc: [
		"&eWhat:&r placing an item in the table's burn slot destroys it, adds its EMC to your total and teaches you that item."
		"&eHow:&r burn a stack of something cheap (cobblestone, logs, sand), then try to burn an iron ingot. The ingot has no EMC, so it can't be learned."
		"&eTip:&r stone, wood, glass, terracotta, wool and other building materials all work. Click the checkmark when you understand the rule."
	]
	quest.18B513C9D4D8674F.title: "Covalence Dust"
	quest.18B513C9D4D8674F.quest_subtitle: "ProjectE's crafting dusts"
	quest.18B513C9D4D8674F.quest_desc: [
		"&eWhat:&r three dusts used for ProjectE storage and repairs."
		"&eChemistry:&r a covalent bond is two atoms sharing electrons. The name fits: these dusts bind items together."
		"&eHow:&r low: charcoal and 8 cobblestone. Medium: an iron ingot and redstone. High: a diamond and coal. Each recipe makes 40."
		"&eTip:&r covalence dust repairs tools in a crafting grid: the matching dust for the tool's material."
	]
	quest.042E22483673AC0E.title: "Alchemical Chest"
	quest.042E22483673AC0E.quest_subtitle: "A big chest for ProjectE items"
	quest.042E22483673AC0E.quest_desc: [
		"&eWhat:&r a large chest, and the base of the Alchemical Bag."
		"&eHow:&r one of each covalence dust on top, stone, a diamond and stone in the middle, iron, a chest and iron on the bottom."
	]
	quest.170DD0614698F425.title: "Alchemical Bag"
	quest.170DD0614698F425.quest_subtitle: "The same inventory everywhere you go"
	quest.170DD0614698F425.quest_desc: [
		"&eWhat:&r an Alchemical Bag shares its inventory with every bag of the same colour you own."
		"&eHow:&r three high covalence dust on top, wool on each side of an Alchemical Chest, and three wool below. Dye the wool for a different colour."
		"&eTip:&r keep one colour for building blocks so your supplies follow you between builds."
	]
	quest.50BE1EFCA730933B.title: "Repair Talisman"
	quest.50BE1EFCA730933B.quest_subtitle: "Optional: slowly mends your gear"
	quest.50BE1EFCA730933B.quest_desc: [
		"&eWhat:&r while it's in your inventory it slowly repairs your damaged tools and armor."
		"&eHow:&r covalence dusts, string and paper (check JEI for the pattern)."
	]
	quest.4435E0CBCBF45F67.title: "Transmutation Tablet"
	quest.4435E0CBCBF45F67.quest_subtitle: "Optional: the table, in your pocket"
	quest.4435E0CBCBF45F67.quest_desc: [
		"&eWhat:&r a portable Transmutation Table."
		"&eHow:&r four Dark Matter blocks, four stone and a Transmutation Table. That's sixteen Dark Matter: a real project."
		"&eTip:&r worth it for big builds far from home."
	]
	quest.5C6F6C15DC731192.title: "The Law of Conservation"
	quest.5C6F6C15DC731192.quest_subtitle: "Why you can't conjure metal"
	quest.5C6F6C15DC731192.quest_desc: [
		"&eWhat:&r in this pack, EMC works on building blocks only. Metals, gems, dusts, ores and plates have no EMC."
		"&eHow:&r read the second page, then click the checkmark."
		"{@pagebreak}"
		"&eThe rule:&r ProjectE normally gives every item an EMC value, so a pile of cobblestone can become diamonds. In a chemistry pack that would skip everything you've built."
		"&eChemistry:&r matter isn't created or destroyed in a chemical reaction (Lavoisier, 1789). Iron comes from iron oxide, Fe₂O₃ + 3CO → 2Fe + 3CO₂. Copper comes from its ores. Gold comes from anode sludge and aqua regia. You can rearrange atoms; you can't conjure them."
		"&eSo:&r ingots, nuggets, raw ores, dusts, gems, plates, gears, rods, wires and storage blocks are set to EMC 0. Nether Stars, the Dragon Egg and the Beacon are 0 too, because the Seed of a New World needs them."
		"&eAlso removed:&r Energy Condensers, Collectors and Relays. They turn EMC into unlimited items or power."
		"&eWhat's left:&r a terraforming and building tool. Stone, wood, glass, sand, dirt and decoration are what a demigod reshapes the world with, and those still have EMC."
	]
	quest.3EBFBBF5E8D82173.title: "Alchemical Coal"
	quest.3EBFBBF5E8D82173.quest_subtitle: "Four coal, compressed"
	quest.3EBFBBF5E8D82173.quest_desc: [
		"&eWhat:&r a dense fuel and the first step toward Dark Matter."
		"&eChemistry:&r coal is mostly carbon. Packing more energy into less mass is what refining fuel is all about."
		"&eHow:&r the Philosopher's Stone and four coal (shapeless). It must be real coal, not charcoal."
		"&eTip:&r it also burns far longer than coal in a furnace."
	]
	quest.41149E66ACB4670C.title: "Mobius Fuel"
	quest.41149E66ACB4670C.quest_subtitle: "Four alchemical coal, compressed"
	quest.41149E66ACB4670C.quest_desc: [
		"&eWhat:&r the next fuel tier."
		"&eHow:&r the Philosopher's Stone and four alchemical coal. That's 16 coal per Mobius Fuel."
		"&eTip:&r automate coal now (Create crushing, MI quarries or a coal farm); the next steps need a lot."
	]
	quest.244F034391DF698B.title: "Aeternalis Fuel"
	quest.244F034391DF698B.quest_subtitle: "Four Mobius fuel, compressed"
	quest.244F034391DF698B.quest_desc: [
		"&eWhat:&r the top fuel, and the main ingredient of Dark Matter."
		"&eHow:&r the Philosopher's Stone and four Mobius Fuel. Each one is 64 coal; this quest asks for eight (512 coal)."
		"&eTip:&r packaged autocrafting (PackagedAuto or AE2) can do the whole chain while you build."
	]
	quest.6F6D4836ABF17642.title: "Dark Matter"
	quest.6F6D4836ABF17642.quest_subtitle: "Eight Aeternalis around a diamond block"
	quest.6F6D4836ABF17642.quest_desc: [
		"&6You remember materials no forge could make. This one you made from coal and patience.&r"
		"&eWhat:&r Dark Matter is ProjectE's strongest crafting material: tools, armor and rings."
		"&eHow:&r eight Aeternalis Fuel around a diamond block. The diamonds come from real mining or synthesis; EMC can't make them here."
		"&eTip:&r four Dark Matter make a Dark Matter Block, used by the tablet and the Dark Matter Furnace."
	]
	quest.5B4ADDA8DEC0D225.title: "Dark Matter Tools"
	quest.5B4ADDA8DEC0D225.quest_subtitle: "Unbreakable tools"
	quest.5B4ADDA8DEC0D225.quest_desc: [
		"&eWhat:&r Dark Matter tools never break and dig very fast. Their charge key widens what they mine."
		"&eHow:&r like diamond tools, but Dark Matter replaces the head and diamonds the handle (the pickaxe is 3 Dark Matter and 2 diamonds)."
		"&eTip:&r charge the Dark Matter Hammer to mine a wider area: great for clearing land."
	]
	quest.65926BF0E01A33EA.title: "Dark Matter Armor"
	quest.65926BF0E01A33EA.quest_subtitle: "Optional: a full set of 24 Dark Matter"
	quest.65926BF0E01A33EA.quest_desc: [
		"&eWhat:&r very strong armor that doesn't wear out."
		"&eHow:&r shaped like diamond armor, all Dark Matter: helmet 5, chestplate 8, leggings 7, boots 4."
		"&eTip:&r that's 24 Dark Matter. Automate the fuel chain first."
	]
	quest.6C81FB35328C5C1E.title: "Black Hole Band"
	quest.6C81FB35328C5C1E.quest_subtitle: "Optional: pulls in every item nearby"
	quest.6C81FB35328C5C1E.quest_desc: [
		"&eWhat:&r while active, it draws nearby items toward you."
		"&eHow:&r an Iron Band (eight iron around a lava bucket) between two Dark Matter, with string above and below."
		"&eTip:&r switch it off near your storage system."
	]
	quest.200E2D7438535AEC.title: "Red Matter"
	quest.200E2D7438535AEC.quest_subtitle: "Optional: beyond Dark Matter"
	quest.200E2D7438535AEC.quest_desc: [
		"&eWhat:&r the strongest ProjectE material, for Red Matter tools and armor."
		"&eHow:&r three Dark Matter in the middle row with three Aeternalis Fuel above and three below."
		"&eTip:&r each one is three Dark Matter plus 384 coal of fuel. Only for the truly committed."
	]
	quest.4AC7BF8F4637BC0C.title: "Rapid Reorganisation"
	quest.4AC7BF8F4637BC0C.quest_subtitle: "Secret: TNT with ambitions"
	quest.4AC7BF8F4637BC0C.quest_desc: [
		"&6You remember reshaping mountains. The quick way was never the tidy way.&r"
		"&eWhat:&r a Nova Catalyst: TNT and Mobius Fuel. A much bigger blast."
		"&eChemistry:&r TNT is trinitrotoluene, C₇H₅N₃O₆. It carries its own oxygen, which is why it burns so fast."
		"&eTip:&r never near your base. Ever."
	]
	chapter.477FA5F1CFD1E7A9.title: "Other Worlds"
	chapter.477FA5F1CFD1E7A9.chapter_subtitle: [
		"The End, the Otherside and the Undergarden."
	]
	quest.0F5CD98214E3E454.title: "The End"
	quest.0F5CD98214E3E454.quest_subtitle: "Eyes of ender, a stronghold, a portal"
	quest.0F5CD98214E3E454.quest_desc: [
		"&6You remember the edge of the world. It's closer than it used to be.&r"
		"&eWhat:&r the End holds the dragon, End Cities, shulkers and azure silver ore. End Crystals power Just Dire Things' flight upgrade."
		"&eHow:&r throw eyes of ender to find a stronghold, fill the portal frame and jump in."
		"&eTip:&r bring blocks, a bow and slow-falling potions. YUNG's Better Strongholds make the hunt more interesting."
	]
	quest.587A409CC5EF5395.title: "Slay the Dragon"
	quest.587A409CC5EF5395.quest_subtitle: "The End's guardian falls"
	quest.587A409CC5EF5395.quest_desc: [
		"&eWhat:&r the Ender Dragon guards the End's central island. Beating it opens the gateways to the outer islands."
		"&eHow:&r shoot or climb to the End Crystals on the obsidian pillars and destroy them first (the caged ones need a climb), then fight the dragon when it perches on the portal."
		"&eTip:&r stay out of its purple breath and never look an enderman in the eye mid-fight. A bow and a stack of arrows do most of the work."
	]
	quest.478C654ED802C25B.title: "The Dragon's Breath"
	quest.478C654ED802C25B.quest_subtitle: "Bottle what the dragon breathes"
	quest.478C654ED802C25B.quest_desc: [
		"&eWhat:&r the dragon's purple breath can be bottled and makes lingering potions."
		"&eChemistry:&r the Dissolver splits one bottle into 8 xenon and 8 radon, two heavy noble gases. It gives no oganesson in this pack: element 118 has never been found in nature, so here it only comes from the Fusion Chamber."
		"&eHow:&r catch the purple breath cloud in glass bottles during the fight, or respawn the dragon for another go."
		"&eTip:&r crystals respawn the dragon when placed on the exit portal, if you need it again."
	]
	quest.288DC19CA85DA3E9.title: "An End City"
	quest.288DC19CA85DA3E9.quest_subtitle: "Purple towers on the outer islands"
	quest.288DC19CA85DA3E9.quest_desc: [
		"&eWhat:&r End Cities are tall purpur towers on the outer islands, guarded by shulkers. Some have an End Ship moored alongside."
		"&eHow:&r throw an ender pearl into an End Gateway near the main island, then search the outer islands. The Explorer's Compass can find one."
		"&eTip:&r shulker bullets make you float; carry milk or slow falling."
	]
	quest.786DC9EAB0FB870A.title: "End City Loot"
	quest.786DC9EAB0FB870A.quest_subtitle: "Wings and shulker shells"
	quest.786DC9EAB0FB870A.quest_desc: [
		"&eWhat:&r End Cities hold elytra (on the end ships) and shulkers whose shells make shulker boxes."
		"&eHow:&r take an End Gateway from the main island, then search the outer islands for purple towers."
		"&eTip:&r the Angel Ring needs an elytra; shulker shells feed Silent Gear's tyrian steel."
	]
	quest.272CE62B5A0B766A.title: "Rocket Boost"
	quest.272CE62B5A0B766A.quest_subtitle: "Optional: chemistry that pushes"
	quest.272CE62B5A0B766A.quest_desc: [
		"&eWhat:&r firework rockets boost elytra flight. Thirty-two is a good start for a long trip."
		"&eChemistry:&r gunpowder is black powder: about 75% potassium nitrate (KNO₃, the oxidiser), 15% charcoal and 10% sulfur. The nitrate supplies its own oxygen, so it burns fast even in a sealed tube."
		"&eHow:&r paper + gunpowder (1–3 for longer flight) in the crafting grid. Creepers and the hunting page give gunpowder."
		"&eTip:&r rockets with a firework star explode and hurt you; use plain ones for flying."
	]
	quest.62AB5E194AA2C276.title: "The Egg"
	quest.62AB5E194AA2C276.quest_subtitle: "Secret: the only one in the world"
	quest.62AB5E194AA2C276.quest_desc: [
		"&6One egg, one dragon, one world. You remember having a whole shelf of these.&r"
		"&eWhat:&r the dragon leaves a single egg on top of the exit portal the first time it dies."
		"&eTip:&r it teleports when you hit it. Push it off with a piston, or let it fall onto a torch to pick it up."
	]
	quest.1A42564839595307.title: "An Ancient City"
	quest.1A42564839595307.quest_subtitle: "Find the city beneath the deep dark"
	quest.1A42564839595307.quest_desc: [
		"&eWhat:&r Ancient Cities sit deep below the Overworld in the deep dark. Each one's centre holds the frame of a portal to the Otherside."
		"&eHow:&r the Explorer's Compass can find one. Sneak everywhere: shriekers summon the Warden. Click the checkmark once you're inside."
		"&eTip:&r sneaking never triggers sculk sensors, and walking on wool doesn't either."
	]
	quest.3A05164A9C113523.title: "The Warden"
	quest.3A05164A9C113523.quest_subtitle: "Kill the blind guardian of the deep"
	quest.3A05164A9C113523.quest_desc: [
		"&eWhat:&r the Warden is the strongest regular mob in the game, and the key to the Otherside: with Deeper and Darker it drops the Heart of the Deep."
		"&eHow:&r trigger shriekers three times to summon one (or let it find you). Fight from range; it's blind and tracks you by sound and smell."
		"&eTip:&r its sonic boom goes through shields and armour. Break line of sight when it starts charging."
	]
	quest.47E37212E3AD9C51.title: "The Otherside"
	quest.47E37212E3AD9C51.quest_subtitle: "Take the Warden's heart and step through"
	quest.47E37212E3AD9C51.quest_desc: [
		"&6You remember a silence older than the world. You can hear it again.&r"
		"&eWhat:&r beyond the Ancient City lies the Otherside, a dark dimension of sculk and echo trees."
		"&eHow:&r defeat a Warden for its Heart of the Deep, then use it to light the portal frame in the city's centre."
		"&eTip:&r the Warden is blind but hears everything. Fight from range and keep moving."
	]
	quest.67E57795C7B28D27.title: "Echoes of the Deep"
	quest.67E57795C7B28D27.quest_subtitle: "The Otherside's strongest material"
	quest.67E57795C7B28D27.quest_desc: [
		"&eWhat:&r reinforced echo shards make Warden gear that rivals netherite."
		"&eHow:&r check JEI for the recipe; echo shards come from Ancient City chests and Otherside loot."
		"&eTip:&r Warden armour is a netherite smithing upgrade, so keep your netherite gear."
	]
	quest.7D4873404550BDD4.title: "The Ancient Temple"
	quest.7D4873404550BDD4.quest_subtitle: "A temple deep in the Otherside"
	quest.7D4873404550BDD4.quest_desc: [
		"&eWhat:&r the Otherside's great structure: a sculk-choked temple with traps and the best loot in the dimension."
		"&eHow:&r the Explorer's Compass points the way. Step inside."
		"&eTip:&r the temple is full of sculk; sneak, as you did in the Ancient City."
	]
	quest.0F1E8758CCEAA1C1.title: "Biomes of the Otherside"
	quest.0F1E8758CCEAA1C1.quest_subtitle: "Optional: forests, columns and caverns"
	quest.0F1E8758CCEAA1C1.quest_desc: [
		"&eWhat:&r the Otherside has its own biomes: echo-tree forests, towering columns and caverns lit by blooming plants."
		"&eChemistry:&r there's no sunlight down here; real cave and deep-sea ecosystems run on chemosynthesis, where microbes get energy by oxidising H₂S or CH₄ instead of from light."
		"&eHow:&r Nature's Compass works in the Otherside. Visit all three."
	]
	quest.33C65B50A9A09FDB.title: "Soul Elytra"
	quest.33C65B50A9A09FDB.quest_subtitle: "Optional: an elytra with its own boost"
	quest.33C65B50A9A09FDB.quest_desc: [
		"&eWhat:&r an upgraded elytra that boosts itself, no rockets needed."
		"&eHow:&r an elytra, sculk bones (from Shattered), a soul crystal (from Stalkers) and soul dust (check JEI)."
		"&eTip:&r Stalkers and Shattered roam the Otherside; fight them at range."
	]
	quest.2E4E2442F4D9031D.title: "Warden Armour"
	quest.2E4E2442F4D9031D.quest_subtitle: "Optional: beyond netherite"
	quest.2E4E2442F4D9031D.quest_desc: [
		"&eWhat:&r Warden armour is tougher than netherite."
		"&eHow:&r netherite chestplate + reinforced echo shard + Warden upgrade template in a smithing table."
		"&eTip:&r check JEI for where the Warden upgrade template comes from."
	]
	quest.4832FB99F0BF6921.title: "Undergarden Metals"
	quest.4832FB99F0BF6921.quest_subtitle: "Cloggrum and froststeel"
	quest.4832FB99F0BF6921.quest_desc: [
		"&eWhat:&r new ores beneath the world: cloggrum (tough) and froststeel (slows what it hits). Utherium comes much later."
		"&eHow:&r mine them in depthrock and shiverstone, then smelt. Utherium only grows deep in tremblecrust and dreadrock, and its clusters need the Infuser: see the Undergarden page."
		"&eTip:&r run them through the Alchemistry Dissolver: what are these strange metals made of?"
	]
	quest.233CEF5C6F7B9E72.title: "Regalium"
	quest.233CEF5C6F7B9E72.quest_subtitle: "The Undergarden's precious crystal"
	quest.233CEF5C6F7B9E72.quest_desc: [
		"&eWhat:&r regalium is the Undergarden's treasure: a rare crystal in depthrock and shiverstone."
		"&eHow:&r smelt regalium ore. It also turns up in catacomb chests."
		"&eTip:&r catacombs are also where the Forgotten Guardian waits."
	]
	quest.54EE1E70147EBAAF.title: "The Catacombs"
	quest.54EE1E70147EBAAF.quest_subtitle: "Find the catacombs and beat their guardian"
	quest.54EE1E70147EBAAF.quest_desc: [
		"&eWhat:&r the catacombs are a buried tomb of the Undergarden's old builders. The Forgotten Guardian, a hulking armoured giant, still stands watch."
		"&eHow:&r the Explorer's Compass can find one. Clear the halls, then fight the guardian."
		"&eTip:&r it's slow; hit it, step back out of its swing, and repeat."
	]
	quest.3618066084A5EC94.title: "The Forgotten Ingot"
	quest.3618066084A5EC94.quest_subtitle: "Forge the guardian's metal"
	quest.3618066084A5EC94.quest_desc: [
		"&6You remember the old guardians and the oaths they swore. This one has forgotten its own.&r"
		"&eWhat:&r the Forgotten Guardian drops forgotten nuggets; nine make a Forgotten Ingot for the strongest Undergarden tools."
		"&eHow:&r find a catacomb, beat the guardian, and craft the nuggets into an ingot. The smithing template is in catacomb chests."
		"&eTip:&r it hits hard; armour up and keep your distance between swings."
	]
	quest.47243C7EB987EF94.title: "Ruins and Camps"
	quest.47243C7EB987EF94.quest_subtitle: "Optional: who else lives down here?"
	quest.47243C7EB987EF94.quest_desc: [
		"&eWhat:&r forgotten vestiges are ruins left by the Undergarden's builders; denizen camps belong to the hostile Denizens who live there now."
		"&eHow:&r explore until you find one of each (the Explorer's Compass helps) and step inside."
		"&eTip:&r Denizens fight in groups; draw them out one at a time."
	]
	quest.60F7318695B23F85.title: "Biomes Below"
	quest.60F7318695B23F85.quest_subtitle: "Optional: three corners of the Undergarden"
	quest.60F7318695B23F85.quest_desc: [
		"&eWhat:&r the Undergarden's biomes range from frozen fields to spires that belch smog."
		"&eChemistry:&r a smog is a mix of smoke and fog; real industrial smog is soot plus sulfur dioxide (SO₂), which forms sulfuric acid droplets in damp air."
		"&eHow:&r Nature's Compass works here too. Visit all three."
	]
	chapter.409E2F2CFC4C4323.title: "Exploration"
	chapter.409E2F2CFC4C4323.chapter_subtitle: [
		"Go and see what the world has made without you."
	]
	quest.19D5348F991D1D5B.title: "A Plains Village"
	quest.19D5348F991D1D5B.quest_subtitle: "Neighbours, at last"
	quest.19D5348F991D1D5B.quest_desc: [
		"&6You remember knowing every corner of this world by heart. For now, a compass will do.&r"
		"&eWhat:&r villagers trade emeralds for crops, tools and enchanted books, and their beds and fields are free for the taking (politely)."
		"&eHow:&r plains villages generate in plains and a few grassy modded biomes. Walk into one. Nature's Compass and Explorer's Compass (the &eFind Anything&r quest, linked on the left) point you to any biome or structure on this page."
		"&eTip:&r Towns and Towers adds a village style for most biomes (the optional villages next to this one), and villages often have a waystone. A cartographer villager sells maps to ocean monuments and woodland mansions."
	]
	quest.60152F4E87D63285.title: "A Forest Village"
	quest.60152F4E87D63285.quest_subtitle: "Optional: timber houses under the trees"
	quest.60152F4E87D63285.quest_desc: [
		"&eWhat:&r Towns and Towers builds a village style for each biome. The forest village is timber and cobblestone."
		"&eHow:&r find one in a forest biome (Explorer's Compass: Towns and Towers) and walk in."
		"&eTip:&r each biome style has its own loot chests."
	]
	quest.351DC01BDF9B2F7D.title: "A Meadow Village"
	quest.351DC01BDF9B2F7D.quest_subtitle: "Optional: a village in the mountain meadows"
	quest.351DC01BDF9B2F7D.quest_desc: [
		"&eWhat:&r high meadows below the peaks get their own village style."
		"&eHow:&r find a meadow biome on a mountainside and the village in it."
		"&eTip:&r meadows are where bees and wildflowers are thickest."
	]
	quest.3E4655FCC160E807.title: "A Snowy Taiga Village"
	quest.3E4655FCC160E807.quest_subtitle: "Optional: spruce and snow"
	quest.3E4655FCC160E807.quest_desc: [
		"&eWhat:&r a village built for the cold, in the snowy taiga."
		"&eHow:&r find a snowy taiga and the village in it."
		"&eTip:&r bring leather boots for powder snow."
	]
	quest.7A6C1F22C67DC796.title: "A Swamp Village"
	quest.7A6C1F22C67DC796.quest_subtitle: "Optional: houses on stilts"
	quest.7A6C1F22C67DC796.quest_desc: [
		"&eWhat:&r vanilla never put villages in swamps. Towns and Towers does."
		"&eHow:&r find a swamp and the village in it."
		"&eTip:&r witches love swamps too; keep a milk bucket handy."
	]
	quest.6C0F741B9358A2D2.title: "A Desert Village"
	quest.6C0F741B9358A2D2.quest_subtitle: "Optional: sandstone in the sun"
	quest.6C0F741B9358A2D2.quest_desc: [
		"&eWhat:&r a sandstone village in the desert."
		"&eChemistry:&r sandstone is sand grains (mostly quartz, SiO₂) cemented by minerals like calcite or iron oxides that precipitated from groundwater."
		"&eHow:&r find a desert village (Explorer's Compass) and walk in."
	]
	quest.514B4137700D8590.title: "A Pillager Outpost"
	quest.514B4137700D8590.quest_subtitle: "The villagers' enemies have towers too"
	quest.514B4137700D8590.quest_desc: [
		"&eWhat:&r pillagers build watchtowers. Towns and Towers gives each biome its own design."
		"&eHow:&r find a forest outpost and walk in. Expect crossbow fire."
		"&eTip:&r killing a pillager captain gives Bad Omen; in 1.21 you drink the ominous bottle it drops to start a raid."
	]
	quest.612E99E12D4629B9.title: "A Woodland Mansion"
	quest.612E99E12D4629B9.quest_subtitle: "Optional: the illagers' stronghold"
	quest.612E99E12D4629B9.quest_desc: [
		"&eWhat:&r huge dark-oak mansions, very rare, deep in dark forests. Vindicators and evokers live inside."
		"&eHow:&r a cartographer's woodland explorer map or the Explorer's Compass. Step inside."
		"&eTip:&r evokers drop totems of undying; vindicators hit very hard."
	]
	quest.6D0121AD6AFBB06A.title: "Better Dungeons"
	quest.6D0121AD6AFBB06A.quest_subtitle: "Optional: clear a YUNG's dungeon"
	quest.6D0121AD6AFBB06A.quest_desc: [
		"&eWhat:&r YUNG's Better Dungeons adds catacombs, fortresses and spider caves underground."
		"&eHow:&r find one (the Explorer's Compass lists them), clear it and loot it. Click the checkmark when done."
		"&eTip:&r some dungeon chests hold Relics and Artifacts items."
	]
	quest.4D5D6454D9CCBB6A.title: "Zombie Catacombs"
	quest.4D5D6454D9CCBB6A.quest_subtitle: "A tomb full of the restless dead"
	quest.4D5D6454D9CCBB6A.quest_desc: [
		"&eWhat:&r YUNG's zombie dungeon: a tomb with spawners, coffins and loot."
		"&eHow:&r find it with the Explorer's Compass (Better Dungeons) and step inside."
		"&eTip:&r break or torch the spawners first; then loot at your leisure."
	]
	quest.3C3DB798AE67BB23.title: "Skeleton Fortress"
	quest.3C3DB798AE67BB23.quest_subtitle: "A buried fort of archers"
	quest.3C3DB798AE67BB23.quest_desc: [
		"&eWhat:&r YUNG's skeleton dungeon is a sprawling underground fort."
		"&eHow:&r find it and step inside. Bring a shield."
		"&eTip:&r torches on every spawner; skeletons will pick you off from the dark otherwise."
	]
	quest.23C618FC62DB7FEC.title: "Spider Caves"
	quest.23C618FC62DB7FEC.quest_subtitle: "Webs everywhere"
	quest.23C618FC62DB7FEC.quest_desc: [
		"&eWhat:&r a natural-looking cave full of webs, cave spiders and their spawners."
		"&eChemistry:&r real spider silk is a protein (spidroin) with crystalline β-sheets that make it, weight for weight, stronger than steel."
		"&eHow:&r find one and step inside. A sword or shears cut webs fast."
		"&eTip:&r cave spiders poison; carry milk."
	]
	quest.5440F7447034043F.title: "A Better Stronghold"
	quest.5440F7447034043F.quest_subtitle: "Where the End portal hides"
	quest.5440F7447034043F.quest_desc: [
		"&eWhat:&r YUNG's Better Strongholds replaces the vanilla stronghold with a much larger, trapped maze. The End portal room is inside."
		"&eHow:&r throw eyes of ender, or use the Explorer's Compass. Step inside."
		"&eTip:&r mark your path with torches on one side; the halls all look alike."
	]
	quest.68B5AC09A423AA4D.title: "Better Mineshafts"
	quest.68B5AC09A423AA4D.quest_subtitle: "Optional: explore a YUNG's mineshaft"
	quest.68B5AC09A423AA4D.quest_desc: [
		"&eWhat:&r YUNG's Better Mineshafts are longer, with ore deposits, carts and loot."
		"&eHow:&r explore one and loot a chest. Click the checkmark when done."
		"&eTip:&r look for minecarts with chests along the tracks."
	]
	quest.56FD6ABE6F060C83.title: "An Old Mineshaft"
	quest.56FD6ABE6F060C83.quest_subtitle: "Someone mined here before you"
	quest.56FD6ABE6F060C83.quest_desc: [
		"&eWhat:&r YUNG's mineshafts come in styles for each biome. The oak style is the common one."
		"&eHow:&r find one under a forest or plains (Explorer's Compass) and walk in."
		"&eTip:&r the rails and planks are free building material."
	]
	quest.28491E1F764497B4.title: "Mineshafts of the Caves"
	quest.28491E1F764497B4.quest_subtitle: "Optional: dripstone and lush styles"
	quest.28491E1F764497B4.quest_desc: [
		"&eWhat:&r two mineshafts built into cave biomes: one among dripstone, one among moss and glow berries."
		"&eChemistry:&r dripstone is calcium carbonate: water carrying dissolved Ca(HCO₃)₂ drips, loses CO₂, and leaves CaCO₃ behind, a millimetre at a time."
		"&eHow:&r find a mineshaft under dripstone caves and one under lush caves."
	]
	quest.75E4DF1E89697FCF.title: "Trail Ruins"
	quest.75E4DF1E89697FCF.quest_subtitle: "Optional: dig like an archaeologist"
	quest.75E4DF1E89697FCF.quest_desc: [
		"&eWhat:&r half-buried ruins of an old people. Suspicious gravel hides pottery sherds and armour trims."
		"&eHow:&r find the ruins (Explorer's Compass) and bring a brush (feather, copper ingot, stick)."
		"&eTip:&r brush slowly; breaking suspicious blocks destroys the loot."
	]
	quest.5D9ABBC3297E8F11.title: "Trial Chambers"
	quest.5D9ABBC3297E8F11.quest_subtitle: "Copper halls and trial spawners"
	quest.5D9ABBC3297E8F11.quest_desc: [
		"&eWhat:&r copper and tuff vaults deep underground. Trial spawners give keys; keys open vaults."
		"&eChemistry:&r the halls show copper's patina: Cu weathers to green basic copper carbonate, Cu₂CO₃(OH)₂, unless you wax it."
		"&eHow:&r find a chamber, beat a trial spawner's wave and take the key."
		"&eTip:&r breezes deflect arrows; fight them up close."
	]
	quest.3D2834AA290BDC3C.title: "Temples"
	quest.3D2834AA290BDC3C.quest_subtitle: "Optional: desert and jungle"
	quest.3D2834AA290BDC3C.quest_desc: [
		"&eWhat:&r a desert pyramid and a jungle temple, each with treasure and a trap."
		"&eChemistry:&r the desert trap is TNT: trinitrotoluene, C₇H₅N₃O₆, which carries its oxygen inside the molecule."
		"&eHow:&r find one of each. Don't stand on the pressure plate in the desert."
	]
	quest.6B1ACC106AA8CC7C.title: "Odd Little Houses"
	quest.6B1ACC106AA8CC7C.quest_subtitle: "Optional: a witch's hut and an igloo"
	quest.6B1ACC106AA8CC7C.quest_desc: [
		"&eWhat:&r a witch's hut in the swamp and an igloo on the snow. Some igloos hide a basement."
		"&eHow:&r find one of each and step inside."
		"&eTip:&r the igloo basement has a brewing stand and a golden apple for curing a zombie villager."
	]
	quest.696EDE3758F11DDE.title: "A Ruined Portal"
	quest.696EDE3758F11DDE.quest_subtitle: "Optional: someone tried to leave"
	quest.696EDE3758F11DDE.quest_desc: [
		"&eWhat:&r broken Nether portals, with crying obsidian and a chest of gold."
		"&eChemistry:&r obsidian forms when lava (molten silicate) cools so fast it can't crystallise: it's volcanic glass."
		"&eHow:&r find one and stand inside it. Fill the missing blocks to repair the portal."
	]
	quest.50F76B15FECDB23D.title: "A Shipwreck"
	quest.50F76B15FECDB23D.quest_subtitle: "Someone else's bad day at sea"
	quest.50F76B15FECDB23D.quest_desc: [
		"&eWhat:&r sunken ships with supply, treasure and map chests. The map leads to buried treasure."
		"&eHow:&r find a wreck (Explorer's Compass) and swim inside."
		"&eTip:&r a potion of water breathing or a turtle shell helmet makes this easy."
	]
	quest.11B352742B41A2F3.title: "Buried Treasure"
	quest.11B352742B41A2F3.quest_subtitle: "X marks the spot"
	quest.11B352742B41A2F3.quest_desc: [
		"&eWhat:&r buried chests on beaches, each with a Heart of the Sea for a conduit."
		"&eHow:&r follow a shipwreck's treasure map to the X and dig down."
		"&eTip:&r the chest is usually right under the X, a few blocks down."
	]
	quest.39CC43EB79388B13.title: "Ocean Ruins"
	quest.39CC43EB79388B13.quest_subtitle: "Optional: sandstone and stone ruins underwater"
	quest.39CC43EB79388B13.quest_desc: [
		"&eWhat:&r ruins on the sea floor: sandstone ones in warm water, stone bricks in cold."
		"&eChemistry:&r warm-water coral reefs are calcium carbonate skeletons; more dissolved CO₂ makes seawater more acidic and dissolves them."
		"&eHow:&r find one of each. Drowned guard them."
	]
	quest.4A7EC6354DC5269B.title: "Wreckage"
	quest.4A7EC6354DC5269B.quest_subtitle: "Optional: a Towns and Towers wreck"
	quest.4A7EC6354DC5269B.quest_desc: [
		"&eWhat:&r Towns and Towers scatters its own wreckage across the oceans."
		"&eHow:&r find it with the Explorer's Compass (Towns and Towers) and swim in."
		"&eTip:&r boats are faster than swimming between ocean structures."
	]
	quest.2D328EFF89A3A160.title: "An Ocean Monument"
	quest.2D328EFF89A3A160.quest_subtitle: "The guardians' temple"
	quest.2D328EFF89A3A160.quest_desc: [
		"&eWhat:&r a prismarine temple guarded by guardians and three elder guardians. Its sponge rooms and gold block vault are the prize."
		"&eChemistry:&r a sponge holds water by capillary action in its pores; dry it in a furnace to drive the water off."
		"&eHow:&r find it with a cartographer's map or the Explorer's Compass. Bring water breathing and Respiration."
		"&eTip:&r elder guardians give Mining Fatigue; kill all three to lift it (see the hunting page)."
	]
	quest.1A2B391538F70F19.title: "A Nether Fortress"
	quest.1A2B391538F70F19.quest_subtitle: "Blazes and wither skeletons"
	quest.1A2B391538F70F19.quest_desc: [
		"&eWhat:&r dark nether-brick bridges and halls. Blazes give blaze rods; wither skeletons drop skulls for the Wither."
		"&eHow:&r fortresses run in long lines across the Nether; the Explorer's Compass finds them quickly."
		"&eTip:&r nether wart grows in the fortress stairwells; take some for brewing."
	]
	quest.782E886E60A354D9.title: "A Bastion Remnant"
	quest.782E886E60A354D9.quest_subtitle: "The piglins' castle"
	quest.782E886E60A354D9.quest_desc: [
		"&eWhat:&r blackstone castles full of piglins and gold. Some hide netherite upgrade templates and ancient debris."
		"&eChemistry:&r gold doesn't tarnish because it's the least reactive metal: it won't oxidise in air, even at high temperatures."
		"&eHow:&r wear one piece of gold armour so piglins stay calm, then step inside."
		"&eTip:&r opening chests angers piglins anyway; piglin brutes ignore gold entirely."
	]
	quest.126B19FC8B92ED56.title: "Nether Fossils"
	quest.126B19FC8B92ED56.quest_subtitle: "Optional: bones in the soul sand"
	quest.126B19FC8B92ED56.quest_desc: [
		"&eWhat:&r giant bone fossils in the soul sand valleys."
		"&eChemistry:&r bone is mostly hydroxyapatite, Ca₅(PO₄)₃(OH): a calcium phosphate mineral, the same family as phosphate rock for fertiliser."
		"&eHow:&r find a soul sand valley and walk into one of the bone arches."
	]
	quest.20FE0812FEA6CB0B.title: "A Nether Dungeon"
	quest.20FE0812FEA6CB0B.quest_subtitle: "Optional: YUNG's small Nether dungeon"
	quest.20FE0812FEA6CB0B.quest_desc: [
		"&eWhat:&r Better Dungeons adds small dungeons to the Nether too, with spawners and loot."
		"&eHow:&r find one with the Explorer's Compass and step inside."
		"&eTip:&r fire resistance first; everything here burns."
	]
	quest.4F755E3FE879848F.title: "Ruins in the Fire"
	quest.4F755E3FE879848F.quest_subtitle: "Optional: a ruined portal on the other side"
	quest.4F755E3FE879848F.quest_desc: [
		"&eWhat:&r ruined portals turn up in the Nether as well, with the same gold chest."
		"&eHow:&r find one in the Nether and stand inside it."
		"&eTip:&r crying obsidian makes respawn anchors, which let you respawn in the Nether."
	]
	quest.5319A7F7508FDD4C.title: "Erupting Inferno"
	quest.5319A7F7508FDD4C.quest_subtitle: "Optional: Biomes O' Plenty's angriest Nether biome"
	quest.5319A7F7508FDD4C.quest_desc: [
		"&eWhat:&r a Nether biome of lava, ash and erupting vents."
		"&eChemistry:&r volcanic gas is mostly water vapour, CO₂ and SO₂; the SO₂ is what makes volcanic air sting."
		"&eHow:&r Nature's Compass finds it. Fire resistance is a must."
	]
	quest.2392661194C63179.title: "Cliffs of Chalk"
	quest.2392661194C63179.quest_subtitle: "White cliffs and tall stone"
	quest.2392661194C63179.quest_desc: [
		"&eWhat:&r two Regions Unexplored cliff biomes: white chalk and towering stone."
		"&eChemistry:&r chalk is calcium carbonate (CaCO₃) made of the shells of tiny sea plankton. Heat it and it gives quicklime: CaCO₃ → CaO + CO₂."
		"&eHow:&r Nature's Compass finds each one. Visit both."
	]
	quest.4E8EFFB2A502F674.title: "Hot Ground"
	quest.4E8EFFB2A502F674.quest_subtitle: "Springs and volcanic plains"
	quest.4E8EFFB2A502F674.quest_desc: [
		"&eWhat:&r two Biomes O' Plenty biomes warmed from below."
		"&eChemistry:&r hot springs carry dissolved minerals; when the water cools at the surface, silica and carbonates precipitate as terraces."
		"&eHow:&r visit both (Nature's Compass)."
	]
	quest.7F926E6F393B0BC7.title: "Wetlands"
	quest.7F926E6F393B0BC7.quest_subtitle: "Bog, marsh and fen"
	quest.7F926E6F393B0BC7.quest_desc: [
		"&eWhat:&r three kinds of wetland from the two biome mods."
		"&eChemistry:&r waterlogged peat has almost no oxygen, so it barely rots; microbes there make methane (CH₄), the original \"marsh gas\"."
		"&eHow:&r visit all three. Bring a boat."
	]
	quest.122FF431CDA92EC1.title: "Caves That Glow"
	quest.122FF431CDA92EC1.quest_subtitle: "Three cave biomes with their own light"
	quest.122FF431CDA92EC1.quest_desc: [
		"&eWhat:&r cave biomes lit by redstone, giant glowing mushrooms and glowing fungi."
		"&eChemistry:&r real glowing fungi use the same chemistry as fireflies: luciferin oxidised by O₂ with the help of an enzyme, luciferase."
		"&eHow:&r these are underground; Nature's Compass gives the location, then dig down."
	]
	quest.27B9D528EE9E2A4F.title: "Useful Forests"
	quest.27B9D528EE9E2A4F.quest_subtitle: "Optional: maple, eucalyptus and fruit trees"
	quest.27B9D528EE9E2A4F.quest_desc: [
		"&eWhat:&r three forests whose real trees give us chemicals."
		"&eChemistry:&r maple sap is about 2% sucrose (C₁₂H₂₂O₁₁), boiled down 40:1 into syrup. Eucalyptus oil is mostly eucalyptol (C₁₀H₁₈O)."
		"&eHow:&r visit all three."
	]
	quest.4FBB33D6AE0D7BF7.title: "Dry Country"
	quest.4FBB33D6AE0D7BF7.quest_subtitle: "Optional: three Regions Unexplored deserts"
	quest.4FBB33D6AE0D7BF7.quest_desc: [
		"&eWhat:&r Joshua trees, saguaro cacti and the red outback."
		"&eChemistry:&r red desert soil is coloured by a thin coat of iron(III) oxide, Fe₂O₃, on every grain: the same rust that colours Mars."
		"&eHow:&r visit all three. Carry water."
	]
	quest.01C187527EBB2E42.title: "Cold Places"
	quest.01C187527EBB2E42.quest_subtitle: "Optional: tundra, icy heights and snowblossoms"
	quest.01C187527EBB2E42.quest_desc: [
		"&eWhat:&r three cold biomes from the biome mods."
		"&eChemistry:&r ice floats because water expands about 9% when it freezes: hydrogen bonds lock the molecules into an open hexagonal lattice."
		"&eHow:&r visit all three. Warm clothes not required, but recommended."
	]
	quest.39B8F4EF8E933165.title: "Colour Fields"
	quest.39B8F4EF8E933165.quest_subtitle: "Optional: red, purple and violet"
	quest.39B8F4EF8E933165.quest_desc: [
		"&eWhat:&r biomes full of flowers: poppies, jacarandas and wisteria."
		"&eChemistry:&r most red, purple and blue petals owe their colour to anthocyanins, pigments that change colour with pH (red in acid, blue in base)."
		"&eHow:&r visit all three. Collect the flowers for dyes."
	]
	quest.5D9AAF892091E191.title: "Strange Heights"
	quest.5D9AAF892091E191.quest_subtitle: "Optional: spires and crags"
	quest.5D9AAF892091E191.quest_desc: [
		"&eWhat:&r tall rock spires and broken crags: two of the most dramatic landscapes in the pack."
		"&eChemistry:&r rock spires are what's left when softer rock around them is weathered away by water, frost and slow acid rain (H₂CO₃ from dissolved CO₂)."
		"&eHow:&r visit both. Bring a water bucket for the way down."
	]
	quest.05E537B097F52D38.title: "Dead Lands"
	quest.05E537B097F52D38.quest_subtitle: "Optional: where nothing grows"
	quest.05E537B097F52D38.quest_desc: [
		"&eWhat:&r cracked wasteland and grey dead forest."
		"&eChemistry:&r soil dies when it loses organic matter and nitrogen; your Haber-Bosch ammonia (N₂ + 3H₂ → 2NH₃) is how real farms put nitrogen back."
		"&eHow:&r visit both. A demigod might one day make them green again."
	]
	quest.31A980F1060C1B0E.title: "The Origin Valley"
	quest.31A980F1060C1B0E.quest_subtitle: "Secret: the world as it first was"
	quest.31A980F1060C1B0E.quest_desc: [
		"&6Blocky trees, bright grass, a sky of old. You remember the world looking exactly like this, once.&r"
		"&eWhat:&r a rare Biomes O' Plenty biome styled after Minecraft's earliest days."
		"&eTip:&r there's a snowy version too, the wintry origin valley."
	]
	chapter.67F72EF37ED32542.title: "The Undergarden"
	chapter.67F72EF37ED32542.chapter_subtitle: [
		"A forgotten land under the world, opened with acid."
	]
	quest.0EB52209EC2A14E4.title: "Depthrock"
	quest.0EB52209EC2A14E4.quest_subtitle: "The bedrock of a world below the world"
	quest.0EB52209EC2A14E4.quest_desc: [
		"&6Acid opened the way, and the dark below remembers you. You were the one who sealed it.&r"
		"&eWhat:&r depthrock is the Undergarden's stone, the way deepslate is the Overworld's. Its ores (cloggrum, froststeel, utherium, regalium) all sit in it or in icy shiverstone."
		"&eChemistry:&r dissolve depthrock in the Alchemistry Dissolver and it gives silicon dioxide (SiO₂), iron and aluminium, with rare traces of zirconium, gallium, dysprosium and tungsten."
		"&eHow:&r the catalyst is copper ingots, stone, an ender pearl and a bucket of sulfuric acid (MI, Mekanism or ChemLib; this pack's recipe). Light the stone-brick frame and step through, then mine."
		"&eTip:&r the Undergarden has no sun. Bring a stack of torches and mark your portal."
	]
	quest.486778256DB43A64.title: "Cloggrum Tools"
	quest.486778256DB43A64.quest_subtitle: "The Undergarden's everyday metal"
	quest.486778256DB43A64.quest_desc: [
		"&eWhat:&r cloggrum is the first Undergarden metal: about as good as iron, and the base for every Forgotten tool later."
		"&eHow:&r mine cloggrum ore (stone pickaxe or better), smelt the raw cloggrum, and craft tools as you would iron ones."
		"&eTip:&r keep the cloggrum sword and pickaxe once you replace them: they're what the Forgotten template upgrades."
	]
	quest.4A627B3563B300B3.title: "Cloggrum Armour"
	quest.4A627B3563B300B3.quest_subtitle: "A full suit for the dark"
	quest.4A627B3563B300B3.quest_desc: [
		"&eWhat:&r a full set of cloggrum armour. The boots have a perk: scintling goo no longer slows you."
		"&eHow:&r 24 cloggrum ingots for the set. Raw cloggrum also turns up in depleted mines."
		"&eTip:&r scintlings leave sticky goo trails across whole caverns; the boots pay for themselves fast."
	]
	quest.765D740D175B0667.title: "Forgotten Tools"
	quest.765D740D175B0667.quest_subtitle: "Upgrade cloggrum with the guardian's metal"
	quest.765D740D175B0667.quest_desc: [
		"&eWhat:&r Forgotten tools mine Undergarden blocks 1.5x as fast, Forgotten weapons hit non-boss Undergarden mobs 1.5x as hard. Only a Forgotten pickaxe can break dreadrock."
		"&eHow:&r smithing table: Forgotten upgrade template + cloggrum tool + Forgotten Ingot. Ingots come from the Forgotten Guardian in the catacombs (see the Other Worlds page); templates from catacomb chests."
		"&eTip:&r copy a template with 7 diamonds and a block of depthrock (makes 2). Do it before you use your last one."
	]
	quest.46300C88FE52E77A.title: "The Depths"
	quest.46300C88FE52E77A.quest_subtitle: "Break the dreadrock floor"
	quest.46300C88FE52E77A.quest_desc: [
		"&6Under the forgotten land there is an older one. You remember the floor you laid over it.&r"
		"&eWhat:&r a layer of dreadrock seals the bottom of the Undergarden. Below it lie the Depths: infected caverns, puff mushroom forests and rogdorium groves."
		"&eHow:&r dig down until you hit dreadrock, then break through it with a Forgotten pickaxe. Nothing else can mine it."
		"&eTip:&r the Depths carry the Utheric Infection. Read the rogdorium quest before you stay long."
	]
	quest.2B2D7DD2918988F5.title: "Rogdorium"
	quest.2B2D7DD2918988F5.quest_subtitle: "The antidote grows in dreadrock"
	quest.2B2D7DD2918988F5.quest_desc: [
		"&eWhat:&r rogdorium is a crystal found only in dreadrock. It's the key to the Infuser, and eating it holds back the Utheric Infection."
		"&eChemistry:&r real poisoning by heavy metals is treated much the same way: a chelating agent such as EDTA binds the toxic metal ions so the body can flush them out."
		"&eHow:&r mine dreadrock rogdorium ore with a Forgotten pickaxe (it drops rogdorium) or smelt the ore block."
		"&eTip:&r carry a few rogdorium nuggets on every trip down; eat one when the infection meter climbs."
	]
	quest.448C26B7E160AC35.title: "Utheric Clusters"
	quest.448C26B7E160AC35.quest_subtitle: "Raw, corrupted utherium"
	quest.448C26B7E160AC35.quest_desc: [
		"&eWhat:&r mined utherium ore gives utheric clusters: utherium still full of the infection. The Infuser needs one to be built, and purifies the rest."
		"&eChemistry:&r most real ores come out of the ground impure too: the metal is locked in a compound with sulfur, oxygen or arsenic, and refining is the work of pulling it free."
		"&eHow:&r utherium ore sits in depthrock, shiverstone, tremblecrust and the Depths' dreadrock. Mine or smelt it; nine utheric shards also make a cluster."
		"&eTip:&r mine extra: every utherium crystal you will ever make starts as one of these."
	]
	quest.4AAC289EC65DBD8E.title: "The Infuser"
	quest.4AAC289EC65DBD8E.quest_subtitle: "Purify or corrupt what you put in"
	quest.4AAC289EC65DBD8E.quest_desc: [
		"&eWhat:&r the Undergarden's own processing block. With rogdorium fuel it purifies; with utherium it corrupts."
		"&eChemistry:&r the idea is old: purification is often just a reaction that removes one impurity, the way a blast furnace strips oxygen from iron ore."
		"&eHow:&r an utheric cluster, rogdorium and five dreadrock (check JEI). It also gives armour a Rogdorium Infusion."
		"&eTip:&r JEI's Infusing category lists every conversion, including which fuel slot it needs."
	]
	quest.39560B90630543DF.title: "Purified Utherium"
	quest.39560B90630543DF.quest_subtitle: "Turn utheric clusters into crystal"
	quest.39560B90630543DF.quest_desc: [
		"&eWhat:&r utherium crystal is the Undergarden's weapon against rotspawn. Mined utherium ore only gives raw utheric clusters."
		"&eHow:&r mine or smelt utherium ore for clusters (9 utheric shards also make one), then purify each cluster in the Infuser with rogdorium."
		"&eTip:&r rotbeasts and rotbelchers drop utheric shards, so hunting them feeds the line."
	]
	quest.01955F27A3D813AE.title: "Utherium Gear"
	quest.01955F27A3D813AE.quest_subtitle: "Bane of the rotspawn"
	quest.01955F27A3D813AE.quest_desc: [
		"&6Rot fears what is pure. You remember forging blades for exactly this.&r"
		"&eWhat:&r utherium weapons deal 1.5x damage to rotspawn; the armour is the Undergarden's best plain set."
		"&eHow:&r craft them from utherium crystals like diamond gear (check JEI)."
		"&eTip:&r a worn-out utherium tool smelts back into a crystal, so nothing is wasted."
	]
	quest.0231BCFF66ED4C89.title: "Slingshot"
	quest.0231BCFF66ED4C89.quest_subtitle: "Wigglewood, pebbles and patience"
	quest.0231BCFF66ED4C89.quest_desc: [
		"&eWhat:&r a ranged weapon that fires pebbles, goo balls, gronglets or rotten blisterberries."
		"&eHow:&r twistytwigs (two wigglewood planks make four) and sticks. Pebbles drop from mogs and stoneborn, or stonecut depthrock."
		"&eTip:&r it takes its own enchantments: Ricochet bounces shots off walls, Self Sling launches you instead."
	]
	quest.0F7594687DE1EAEA.title: "Froststeel"
	quest.0F7594687DE1EAEA.quest_subtitle: "A metal that bites with cold"
	quest.0F7594687DE1EAEA.quest_desc: [
		"&eWhat:&r froststeel weapons give targets the Chilly effect, which slows them."
		"&eChemistry:&r real steel gets brittle in deep cold: below its ductile-to-brittle transition temperature it cracks instead of bending, which is why ships' hulls once split in icy seas."
		"&eHow:&r froststeel ore only forms in shiverstone, in the frozen biomes. It needs an iron pickaxe; smelt the raw froststeel."
		"&eTip:&r a froststeel sword is great against fast rotspawn; slowed foes can't close the gap."
	]
	quest.187A2B440E772903.title: "The Forgotten"
	quest.187A2B440E772903.quest_subtitle: "Take a battleaxe from cold dead hands"
	quest.187A2B440E772903.quest_desc: [
		"&eWhat:&r the Forgotten are armoured undead that guard the catacombs and vestiges. Some carry a cloggrum battleaxe."
		"&eHow:&r kill five Forgotten. The battleaxe can't be crafted: it only drops from a Forgotten carrying one."
		"&eTip:&r they hit hard but slowly. Shield up, then strike."
	]
	quest.41E649928119EA01.title: "Forgotten Battleaxe"
	quest.41E649928119EA01.quest_subtitle: "Optional: the heaviest weapon below"
	quest.41E649928119EA01.quest_desc: [
		"&eWhat:&r the cloggrum battleaxe, upgraded with Forgotten metal."
		"&eHow:&r smithing table: Forgotten upgrade template + cloggrum battleaxe + Forgotten Ingot."
		"&eTip:&r make all six Forgotten tools if you want the mod's own completion advancement."
	]
	quest.0681BE0B1FFC768C.title: "Rogdorium Spear"
	quest.0681BE0B1FFC768C.quest_subtitle: "Optional: a throwable point of antidote"
	quest.0681BE0B1FFC768C.quest_desc: [
		"&eWhat:&r a spear you can stab with or throw, like a trident without the water."
		"&eHow:&r one rogdorium on top of two sticks."
		"&eTip:&r retrieve it after every throw; it doesn't come back on its own."
	]
	quest.79B495E1D4C44BAA.title: "Two Kinds of Gronglet"
	quest.79B495E1D4C44BAA.quest_subtitle: "Optional: purify one, corrupt one"
	quest.79B495E1D4C44BAA.quest_desc: [
		"&eWhat:&r gronglets are little glowing growths. The Infuser can purify one with rogdorium or corrupt one with utherium."
		"&eHow:&r collect two wild gronglets, then run one through each Infuser mode (JEI shows both)."
		"&eTip:&r gronglets also work as slingshot ammo. The mod asks if that is okay."
	]
	quest.31CC851D9D5D4C5E.title: "Collector's Shelf"
	quest.31CC851D9D5D4C5E.quest_subtitle: "Optional: a block of every Undergarden metal"
	quest.31CC851D9D5D4C5E.quest_desc: [
		"&eWhat:&r one storage block each of cloggrum, froststeel, utherium, regalium, rogdorium and Forgotten metal."
		"&eChemistry:&r feed spares to the Dissolver: the Undergarden's metals are fiction, but what they break down into tells you what the pack thinks they are made of."
		"&eHow:&r nine of each ingot or crystal in a crafting grid."
		"&eTip:&r a Forgotten block and a carved gloomgourd summon a Forgotten Minion."
	]
	quest.701BAFF30660B586.title: "Cloggrum Kit"
	quest.701BAFF30660B586.quest_subtitle: "Optional: axe, shovel, hoe and shield"
	quest.701BAFF30660B586.quest_desc: [
		"&eWhat:&r the rest of the cloggrum toolset, plus a cloggrum shield for the Forgotten's heavy swings."
		"&eChemistry:&r a real shield works by spreading a blow over a large area: the same force over more area means less pressure (P = F / A) on your arm."
		"&eHow:&r the usual tool shapes with cloggrum ingots; the shield is cloggrum and planks (check JEI)."
		"&eTip:&r the axe, shovel and hoe are the three the Forgotten template turns into the rest of the Forgotten set."
	]
	quest.0828CA49B524F49E.title: "Froststeel Tools"
	quest.0828CA49B524F49E.quest_subtitle: "Optional: a full set of cold tools"
	quest.0828CA49B524F49E.quest_desc: [
		"&eWhat:&r pickaxe, axe, shovel and hoe of froststeel."
		"&eChemistry:&r cold slows chemistry down: as a rule of thumb, many reactions run about half as fast for every 10 °C cooler. That's why a fridge keeps food."
		"&eHow:&r froststeel ingots in the usual tool shapes (check JEI)."
		"&eTip:&r raw froststeel has a blast furnace recipe, so smelt it there at double speed."
	]
	quest.487D13B22151070D.title: "Froststeel Armour"
	quest.487D13B22151070D.quest_subtitle: "Optional: finish the froststeel suit"
	quest.487D13B22151070D.quest_desc: [
		"&eWhat:&r the rest of the froststeel armour to go with your chestplate."
		"&eHow:&r froststeel ingots in the usual armour shapes (check JEI). Froststeel ore only forms in shiverstone, in the frozen biomes."
		"&eTip:&r compare it with cloggrum in your inventory before you commit: pick the set whose perks suit how you fight."
	]
	quest.5C8858520F0C9F34.title: "Forgotten Kit"
	quest.5C8858520F0C9F34.quest_subtitle: "Optional: upgrade the rest of the cloggrum set"
	quest.5C8858520F0C9F34.quest_desc: [
		"&eWhat:&r Forgotten axe, shovel and hoe: the same 1.5x speed on Undergarden blocks as the pickaxe."
		"&eHow:&r smithing table: Forgotten upgrade template + cloggrum tool + Forgotten Ingot, once for each."
		"&eTip:&r with the pickaxe, sword and battleaxe that makes all six Forgotten tools, which the mod has an advancement for."
	]
	quest.2DFE7BBF830A2DDB.title: "Utherium Tools"
	quest.2DFE7BBF830A2DDB.quest_subtitle: "Optional: the purest tools below"
	quest.2DFE7BBF830A2DDB.quest_desc: [
		"&eWhat:&r the rest of the utherium toolset."
		"&eHow:&r utherium crystals in the usual tool shapes (check JEI)."
		"&eTip:&r a worn-out utherium tool smelts back into a crystal."
	]
	quest.466ADBA0915E562D.title: "Utherium Armour"
	quest.466ADBA0915E562D.quest_subtitle: "Optional: finish the utherium suit"
	quest.466ADBA0915E562D.quest_desc: [
		"&eWhat:&r helmet, leggings and boots of utherium to go with your chestplate: the Undergarden's best plain set."
		"&eChemistry:&r a crystal's strength comes from its lattice: every atom held by bonds in every direction, which is why diamond (carbon in a 3D lattice) is so hard."
		"&eHow:&r utherium crystals in the usual armour shapes (check JEI)."
		"&eTip:&r the Infuser can still give this armour a Rogdorium Infusion."
	]
	quest.2186E2018E61FC25.title: "Small Change"
	quest.2186E2018E61FC25.quest_subtitle: "Optional: nuggets of three metals"
	quest.2186E2018E61FC25.quest_desc: [
		"&eWhat:&r nuggets of cloggrum, froststeel and Forgotten metal. Forgotten nuggets are how the guardian pays out: nine make an ingot."
		"&eChemistry:&r real nuggets only form from unreactive metals. Gold turns up native in rivers because it doesn't oxidise; iron almost never does."
		"&eHow:&r break an ingot into nine in the crafting grid; Forgotten nuggets drop from the Forgotten Guardian."
		"&eTip:&r a Forgotten nugget is also the heart of the Crumbling Catalyst."
	]
	quest.08C29C8F19C80492.title: "Crumbling Catalyst"
	quest.08C29C8F19C80492.quest_subtitle: "Optional: a catalyst that's spent once used"
	quest.08C29C8F19C80492.quest_desc: [
		"&eWhat:&r a cheaper, crumbling cousin of the Catalyst: it lights an Undergarden portal frame and is used up doing it."
		"&eChemistry:&r the name is a joke for chemists: a true catalyst is never used up by the reaction it speeds. This one is a reagent wearing a catalyst's name."
		"&eHow:&r four cloggrum ingots, four depthrock and one Forgotten nugget in the middle (check JEI)."
		"&eTip:&r use it for a second portal near another base, and keep the real Catalyst safe."
	]
	quest.73152516B1255FF6.title: "Ancient Armour"
	quest.73152516B1255FF6.quest_subtitle: "Optional: rare gear off the Forgotten"
	quest.73152516B1255FF6.quest_desc: [
		"&eWhat:&r the Forgotten wear ancient armour. It has no recipe: the only way to get a piece is from a Forgotten when it falls."
		"&eHow:&r keep fighting Forgotten in catacombs and vestiges. Drops are rare; Looting helps."
		"&eTip:&r any one piece completes this quest."
	]
	quest.6F82ED3914FBD824.title: "Mysterious Totem"
	quest.6F82ED3914FBD824.quest_subtitle: "Optional: purify an ancient root"
	quest.6F82ED3914FBD824.quest_desc: [
		"&eWhat:&r a carved totem like the ones in denizen camps."
		"&eHow:&r purify an ancient root in the Infuser with rogdorium, or loot one from a denizen camp chest."
		"&eTip:&r it's an axe-mined block, so break and move it with an axe."
	]
	quest.00C8D06724A3EA0F.title: "Woods Without Sun"
	quest.00C8D06724A3EA0F.quest_subtitle: "Optional: smogstem, wigglewood, grongle"
	quest.00C8D06724A3EA0F.quest_desc: [
		"&eWhat:&r three kinds of tree that grow with no daylight at all."
		"&eChemistry:&r real plants can't do that: photosynthesis (6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂) needs light. Underground life runs on chemosynthesis or on food that falls from above."
		"&eHow:&r smogstem forests, wigglewood forests and the gronglegrowth each have their own tree."
		"&eTip:&r wigglewood planks make the twistytwigs for the slingshot."
	]
	quest.71424F14C6F041A0.title: "Shard Torches"
	quest.71424F14C6F041A0.quest_subtitle: "Light that burns rotspawn"
	quest.71424F14C6F041A0.quest_desc: [
		"&eWhat:&r a torch tipped with an utheric shard. It lights the dark and hurts rotspawn that come close."
		"&eHow:&r one utheric shard on a stick. Shards drop from rotbeasts and rotbelchers and sit in catacomb chests."
		"&eTip:&r ring your portal and your base with them."
	]
	quest.2EE8A0D50F4EB7A1.title: "A Depleted Mine"
	quest.2EE8A0D50F4EB7A1.quest_subtitle: "Optional: someone mined here before you"
	quest.2EE8A0D50F4EB7A1.quest_desc: [
		"&eWhat:&r old mines left by the Undergarden's builders. The chests still hold raw cloggrum, raw froststeel and cloggrum tools."
		"&eHow:&r explore depthrock caverns until you find timber supports and rails; step inside."
		"&eTip:&r a quick way to an early cloggrum pickaxe."
	]
	quest.2F458255EBD570FD.title: "Mushroom Bogs"
	quest.2F458255EBD570FD.quest_subtitle: "Optional: blood, ink and veil"
	quest.2F458255EBD570FD.quest_desc: [
		"&eWhat:&r three bogs named after the giant mushrooms that grow in them. Each mushroom makes its own stew and dye."
		"&eChemistry:&r a fungus is closer to an animal than a plant: its cell walls are chitin, (C₈H₁₃O₅N)ₙ, the same polymer as insect shells."
		"&eHow:&r Nature's Compass works down here. Visit all three."
	]
	quest.5E353CE5F8D3373C.title: "Into the Depths"
	quest.5E353CE5F8D3373C.quest_subtitle: "Optional: three regions under the dreadrock"
	quest.5E353CE5F8D3373C.quest_desc: [
		"&eWhat:&r the rest of the Depths: the infected depths, the puff mushroom forest and the rogdorium grove."
		"&eHow:&r with a Forgotten pickaxe, tunnel through dreadrock to each one."
		"&eTip:&r the rogdorium grove is the richest place for rogdorium; carry plenty out."
	]
	quest.01EC8B2403704D6F.title: "Saplings of the Dark"
	quest.01EC8B2403704D6F.quest_subtitle: "Optional: grow the Undergarden at home"
	quest.01EC8B2403704D6F.quest_desc: [
		"&eWhat:&r a sapling of each Undergarden tree, so you can farm their wood without the trip."
		"&eHow:&r break the leaves of smogstem, wigglewood and grongle trees until each drops a sapling."
		"&eTip:&r wigglewood leaves also drop twistytwigs, the slingshot's frame."
	]
	quest.5C2E01E20EAF6231.title: "Four Mushrooms"
	quest.5C2E01E20EAF6231.quest_subtitle: "Optional: blood, indigo, ink and veil"
	quest.5C2E01E20EAF6231.quest_desc: [
		"&eWhat:&r the four small mushrooms of the Undergarden, each the seed of its own stew and dye."
		"&eChemistry:&r real ink caps (Coprinus) digest their own gills into a black liquid as they ripen, and people once wrote with it: the black comes from the ripe spores."
		"&eHow:&r they grow on the ground in the bogs and forests; the mushroom bogs have the most."
		"&eTip:&r keep a few of each for the four stews."
	]
	quest.2FBB36C42CBD1489.title: "Mogmoss"
	quest.2FBB36C42CBD1489.quest_subtitle: "Optional: moss from two kinds of mog"
	quest.2FBB36C42CBD1489.quest_desc: [
		"&eWhat:&r mogs, the Undergarden's mossy burrowers, drop mogmoss; the smog mogs of the smog spires drop the blue kind."
		"&eHow:&r find mogs digging in the depthrock forests and smog mogs in the smog spires. Mogmoss makes rugs and slop bowls."
		"&eTip:&r mogs also drop depthrock pebbles for the slingshot."
	]
	quest.27065FA074FA47AB.title: "Gronglets"
	quest.27065FA074FA47AB.quest_subtitle: "Optional: little glowing growths"
	quest.27065FA074FA47AB.quest_desc: [
		"&eWhat:&r small glowing growths that hang on grongle trees in the gronglegrowth. The Infuser can purify or corrupt them."
		"&eHow:&r break a wild gronglet to pick it up."
		"&eTip:&r keep two: the Infuser quest later wants one of each kind."
	]
	quest.26F4F461250D42A3.title: "Scintling Goo"
	quest.26F4F461250D42A3.quest_subtitle: "Optional: harvest the snail trail"
	quest.26F4F461250D42A3.quest_desc: [
		"&eWhat:&r goo balls, the sticky stuff scintlings leave behind. They work like slime balls: sticky pistons, leads and goo blocks."
		"&eChemistry:&r slime is a hydrogel: long, tangled polymer chains (glycoproteins, in a real snail) holding many times their weight in water."
		"&eHow:&r break the goo trail blocks scintlings leave across the caverns; each drops goo balls. No need to hurt the snail."
		"&eTip:&r cloggrum boots stop goo from slowing you down."
	]
	quest.6CFE58493658BF8A.title: "The Rotbelcher"
	quest.6CFE58493658BF8A.quest_subtitle: "Optional: the rotspawn that spits"
	quest.6CFE58493658BF8A.quest_desc: [
		"&eWhat:&r a bloated rotspawn that hurls rot from a distance. Like rotbeasts, it drops utheric shards."
		"&eHow:&r close the distance fast, or fight it with a bow or slingshot from cover."
		"&eTip:&r a shard torch nearby softens it up while you fight."
	]
	quest.4803EAF3D5701D4D.title: "Brutes"
	quest.4803EAF3D5701D4D.quest_subtitle: "Optional: tusks for bone meal"
	quest.4803EAF3D5701D4D.quest_desc: [
		"&eWhat:&r brutes are tusked beasts that leave you alone until you hit them. Their tusks grind into bone meal."
		"&eChemistry:&r tusks, teeth and bone are mostly hydroxyapatite, Ca₅(PO₄)₃OH, which is why bone meal feeds plants phosphorus."
		"&eHow:&r one brute tusk crafts into four bone meal."
	]
	quest.16698236D54811EB.title: "The Denizens"
	quest.16698236D54811EB.quest_subtitle: "Optional: the Undergarden's current tenants"
	quest.16698236D54811EB.quest_desc: [
		"&eWhat:&r Denizens live in camps around campfires. They drop mysterious masks, and their camp chests hold more."
		"&eHow:&r find a denizen camp (see the Other Worlds page) and fight. Breaking their campfire angers the whole camp."
		"&eTip:&r draw them out one at a time."
	]
	quest.4B11A4B67E7AA6C4.title: "You Monster"
	quest.4B11A4B67E7AA6C4.quest_subtitle: "Secret: it was just a snail"
	quest.4B11A4B67E7AA6C4.quest_desc: [
		"&eWhat:&r you killed a scintling, a harmless glowing snail. It dropped a goo ball."
		"&eChemistry:&r real snail slime is a mix of glycoproteins and water that thickens under stress, letting the snail glue itself to walls."
		"&eTip:&r goo balls make sticky pistons, so at least it wasn't for nothing."
	]
	quest.12FEECD2BF471C9F.title: "A Minion of Your Own"
	quest.12FEECD2BF471C9F.quest_subtitle: "Optional: build what the guardian was"
	quest.12FEECD2BF471C9F.quest_desc: [
		"&eWhat:&r stack a carved gloomgourd on a block of Forgotten metal and it wakes as a Forgotten Minion that fights for you."
		"&eHow:&r a block of Forgotten metal is nine Forgotten Ingots, so beat the guardian until you have enough nuggets."
		"&eTip:&r the mod has an advancement for building one; the minion fires at your enemies."
	]
	quest.5D0D993B4956B38D.title: "The Gloomper's Secret"
	quest.5D0D993B4956B38D.quest_subtitle: "Secret: a disc the gloompers kept quiet"
	quest.5D0D993B4956B38D.quest_desc: [
		"&6Even down here someone wrote music. You remember humming it.&r"
		"&eWhat:&r a hidden music disc from the Undergarden. The mod counts finding it as a challenge."
		"&eTip:&r the Undergarden has four more discs; play them on a jukebox."
	]
	quest.42C72B875161B03C.title: "Roasted Underbeans"
	quest.42C72B875161B03C.quest_subtitle: "The first meal below"
	quest.42C72B875161B03C.quest_desc: [
		"&eWhat:&r underbean bushes grow in the forests. The beans are edible raw, much better roasted."
		"&eChemistry:&r roasting browns food by the Maillard reaction: amino acids and sugars combine into hundreds of new flavour molecules above about 140 °C."
		"&eHow:&r pick a bush, then smelt or campfire-cook the beans."
		"&eTip:&r underbeans on a stick steer a dweller you're riding."
	]
	quest.41804BCF1DFBC8F5.title: "Blisterbombs"
	quest.41804BCF1DFBC8F5.quest_subtitle: "Optional: rotten berries, thrown hard"
	quest.41804BCF1DFBC8F5.quest_desc: [
		"&eWhat:&r a throwable bomb of rotten blisterberries that bursts into a harmful cloud."
		"&eChemistry:&r real rotting fruit ferments: yeast turns its sugar into ethanol and carbon dioxide (C₆H₁₂O₆ → 2C₂H₅OH + 2CO₂), and sealed fruit can split from the gas."
		"&eHow:&r a twistytwig over six rotten blisterberries (blisterberry bushes drop both kinds)."
		"&eTip:&r eight around a gloomgourd make a boomgourd: an explosive block."
	]
	quest.22A611C7FB2B9007.title: "Hunter's Supper"
	quest.22A611C7FB2B9007.quest_subtitle: "Dweller steak and gloomper leg"
	quest.22A611C7FB2B9007.quest_desc: [
		"&eWhat:&r the best meats below: dwellers (big rideable grazers) and gloompers (hopping toads) both drop meat and leather."
		"&eChemistry:&r heat denatures meat proteins: the coiled chains unfold and bond to each other, which is why meat firms up as it cooks."
		"&eHow:&r cook the raw meat in a furnace, smoker or campfire."
	]
	quest.68D239C447F22CEC.title: "Gloomgourds"
	quest.68D239C447F22CEC.quest_subtitle: "The Undergarden's pumpkin"
	quest.68D239C447F22CEC.quest_desc: [
		"&eWhat:&r a dark gourd that grows like a pumpkin. Carve it for lanterns and minions, or bake it into pie."
		"&eHow:&r find wild gloomgourds; one gourd crafts into four seeds. Plant them on deepsoil farmland."
		"&eTip:&r a carved gloomgourd over a torch makes a gloom-o-lantern; over a shard torch, a shard-o-lantern."
	]
	quest.3B9249F0535DD3F1.title: "Four Stews"
	quest.3B9249F0535DD3F1.quest_subtitle: "Optional: a stew from every giant mushroom"
	quest.3B9249F0535DD3F1.quest_desc: [
		"&eWhat:&r each giant mushroom (blood, indigo, ink and veil) cooks into its own stew."
		"&eChemistry:&r the Dissolver breaks Undergarden mushrooms into chitin and phosphoric acid (H₃PO₄); phosphate is how cells store energy, as ATP."
		"&eHow:&r a bowl and the mushrooms (check JEI); the mushroom bogs have all four kinds nearby."
	]
	quest.271D393332A6196C.title: "Weird Fish"
	quest.271D393332A6196C.quest_subtitle: "Optional: catch a gwibling, cook a few more"
	quest.271D393332A6196C.quest_desc: [
		"&eWhat:&r gwiblings are the small fish of the Undergarden seas. Catch one live, or cook them."
		"&eHow:&r use a water bucket on a gwibling to catch it; kill others for raw gwibling and smelt it."
		"&eTip:&r the full-grown gwib is not a friendly fish. Watch the water."
	]
	quest.3B228DD04D1C5596.title: "Gloomgourd Pie"
	quest.3B228DD04D1C5596.quest_subtitle: "Optional: gourd, mushroom and glitterkelp"
	quest.3B228DD04D1C5596.quest_desc: [
		"&eWhat:&r the Undergarden's best plain food."
		"&eHow:&r a gloomgourd, any Undergarden mushroom and a glitterkelp from the seas, shapeless."
		"&eTip:&r glitterkelp also smelts into ordinary dried kelp."
	]
	quest.323AAE72767E5C67.title: "Underbeans"
	quest.323AAE72767E5C67.quest_subtitle: "Pick a bush in the dark"
	quest.323AAE72767E5C67.quest_desc: [
		"&eWhat:&r underbean bushes grow on the forest floors. Their beans are the Undergarden's first food."
		"&eChemistry:&r beans are protein-rich because legumes host bacteria that fix nitrogen from the air: N₂ becomes ammonia (NH₃), and the plant builds amino acids from it."
		"&eHow:&r right-click a ripe underbean bush to pick it. The mod counts your first pick as an advancement."
		"&eTip:&r raw beans are edible, but the roasted ones in the next quest are far better."
	]
	quest.5CE46C9E4BE6ADD9.title: "Hunting Below"
	quest.5CE46C9E4BE6ADD9.quest_subtitle: "Dwellers and gloompers"
	quest.5CE46C9E4BE6ADD9.quest_desc: [
		"&eWhat:&r dwellers (big rideable grazers) and gloompers (hopping toads) are the Undergarden's game animals. Both drop meat and leather."
		"&eHow:&r hunt them in the forests and fields. Cook the meat in the next quest."
		"&eTip:&r gloompers hop away fast; a slingshot or bow helps."
	]
	quest.25C875F981CFAFF0.title: "Underbean on a Stick"
	quest.25C875F981CFAFF0.quest_subtitle: "Optional: steer a dweller"
	quest.25C875F981CFAFF0.quest_desc: [
		"&eWhat:&r the Undergarden's carrot on a stick. Hold it while riding a dweller to steer it."
		"&eHow:&r a stick and underbeans, shapeless."
		"&eTip:&r a ridden dweller carries you over long cavern floors without tiring your hunger bar as fast as sprinting."
	]
	quest.7337CAB0B300E8DB.title: "Blisterberries"
	quest.7337CAB0B300E8DB.quest_subtitle: "Optional: fresh and rotten"
	quest.7337CAB0B300E8DB.quest_desc: [
		"&eWhat:&r blisterberry bushes drop both fresh and rotten berries. The rotten ones are slingshot ammo and the base of blisterbombs."
		"&eChemistry:&r rotting is chemistry by microbes: yeasts and bacteria break sugars into ethanol, acids and gas, which is why spoiled fruit fizzes and smells sour."
		"&eHow:&r harvest blisterberry bushes in the forests."
		"&eTip:&r don't eat the rotten ones."
	]
	quest.564E8DB3682690EC.title: "Droopfruit and Glitterkelp"
	quest.564E8DB3682690EC.quest_subtitle: "Optional: food that glows"
	quest.564E8DB3682690EC.quest_desc: [
		"&eWhat:&r droopfruit hangs from droopvines on cavern roofs; glitterkelp grows in the Undergarden's seas. Both are edible."
		"&eChemistry:&r real kelp is where iodine was discovered: in 1811 Bernard Courtois added sulfuric acid to seaweed ash and saw violet I₂ vapour rise."
		"&eHow:&r pick droopfruit off the vines (they're climbable, too); harvest glitterkelp from the water. Glitterkelp smelts into dried kelp."
		"&eTip:&r the gloomgourd pie needs a glitterkelp."
	]
	quest.1D0C0BB393755A99.title: "Boomgourd"
	quest.1D0C0BB393755A99.quest_subtitle: "Optional: a gourd that explodes"
	quest.1D0C0BB393755A99.quest_desc: [
		"&eWhat:&r an explosive block: a gloomgourd packed with blisterbombs."
		"&eHow:&r eight blisterbombs around a gloomgourd (check JEI)."
		"&eTip:&r treat it like TNT: place it, light it, step back."
	]
	chapter.782082F7E1BFE609.title: "The Twilight Forest"
	chapter.782082F7E1BFE609.chapter_subtitle: [
		"A realm of permanent dusk, ruled by bosses in order."
	]
	quest.4D231017F4253DCD.title: "Wood of Dusk"
	quest.4D231017F4253DCD.quest_subtitle: "Your first logs in the forest"
	quest.4D231017F4253DCD.quest_desc: [
		"&6The trees here are older than your forgetting. Their bark still knows your hand.&r"
		"&eWhat:&r twilight oak is the forest's common wood. It makes mason jars, drying racks and tannin for leather."
		"&eHow:&r chop any twilight oak. Canopy trees, mangroves and darkwood grow nearby too."
		"&eTip:&r every side quest on this page branches from here; the boss line starts at the Naga's courtyard."
	]
	quest.4EA4B955C6925C4B.title: "Twilight Cake"
	quest.4EA4B955C6925C4B.quest_subtitle: "Optional: a portal you can eat"
	quest.4EA4B955C6925C4B.quest_desc: [
		"&eWhat:&r a TelePastries cake: eat a slice and you're taken to the Twilight Forest. A tidy alternative to the flower pool."
		"&eHow:&r cake, poppies and dandelions, with an MI digital circuit (HV) in the bottom centre (this pack's recipe; check JEI)."
		"&eTip:&r keep the cake at your base and the portal pool stays optional."
	]
	quest.4DFE7AFE22B459FA.title: "A Hollow Giant"
	quest.4DFE7AFE22B459FA.quest_subtitle: "Optional: climb inside a giant hollow tree"
	quest.4DFE7AFE22B459FA.quest_desc: [
		"&eWhat:&r huge hollow trees tower over the forest. Their branches hide leafy caches with rare magic saplings."
		"&eHow:&r find one (taller than everything around it) and climb inside. Search the leaf clusters for a chest."
		"&eTip:&r bring ladders or scaffolding; the fall from the canopy is long."
	]
	quest.133A1A361E39E958.title: "Magic Saplings"
	quest.133A1A361E39E958.quest_subtitle: "Optional: a sapling with a heart"
	quest.133A1A361E39E958.quest_desc: [
		"&eWhat:&r four magic trees: Time, Transformation, Mining and Sorting. Each grows with a working core inside its trunk."
		"&eHow:&r loot one from a hollow tree's cache. Plant it where you want the tree; it can't be moved later."
		"&eTip:&r breaking a core only drops a plain log, so choose the spot first."
	]
	quest.0F7514A8F468C6EF.title: "Tree of Time"
	quest.0F7514A8F468C6EF.quest_subtitle: "Optional: grow the Timewood Clock"
	quest.0F7514A8F468C6EF.quest_desc: [
		"&eWhat:&r the Timewood Clock in the trunk makes blocks around the tree tick faster: crops, saplings and machines that tick."
		"&eHow:&r grow a Tree of Time from its sapling and collect some of its logs (any log of the tree counts)."
		"&eTip:&r plant it in the middle of a farm. Check its tooltip in JEI for the range."
	]
	quest.757EF0A10E439663.title: "Tree of Transformation"
	quest.757EF0A10E439663.quest_subtitle: "Optional: grow the Heart of Transformation"
	quest.757EF0A10E439663.quest_desc: [
		"&eWhat:&r the Heart of Transformation slowly rewrites the biome around the tree into a Twilight one."
		"&eHow:&r grow a Tree of Transformation from its sapling and collect some of its logs."
		"&eTip:&r don't plant it next to a base that needs a particular biome; the change spreads."
	]
	quest.7F7A757A0C0D6E52.title: "Miner's Tree"
	quest.7F7A757A0C0D6E52.quest_subtitle: "Optional: grow the Minewood Core"
	quest.7F7A757A0C0D6E52.quest_desc: [
		"&eWhat:&r the Minewood Core gathers ore from the ground around the tree (its tooltip in JEI explains the details)."
		"&eChemistry:&r real ore is just rock rich in a mineral, like haematite (Fe₂O₃) or chalcopyrite (CuFeS₂). The tree simply finds it for you."
		"&eHow:&r grow a Miner's Tree from its sapling and collect some of its logs."
	]
	quest.16949366931715D7.title: "Sorting Tree"
	quest.16949366931715D7.quest_subtitle: "Optional: grow the Sortingwood Engine"
	quest.16949366931715D7.quest_desc: [
		"&eWhat:&r the Sortingwood Engine moves items from a chest by the tree into nearby chests that already hold the same item."
		"&eHow:&r grow a Sorting Tree from its sapling and collect some of its logs."
		"&eTip:&r a cheap sorting room for a forest outpost; at home your storage network does it better."
	]
	quest.7CFBB54ED187EDE0.title: "Feather and Berries"
	quest.7CFBB54ED187EDE0.quest_subtitle: "A raven's feather and a glowing berry"
	quest.7CFBB54ED187EDE0.quest_desc: [
		"&eWhat:&r the two forest ingredients of the Magic Map Focus."
		"&eChemistry:&r glowing berries are a nod to real bioluminescence: an enzyme, luciferase, oxidises a molecule called luciferin, and the energy leaves as light instead of heat."
		"&eHow:&r ravens hop about the forest floor and drop feathers; Dark Tower chests hold them too. Torchberries hang from cave and hollow-hill roofs, and skeleton druids drop them."
		"&eTip:&r the Moonworm Queen eats torchberries: each one restores 64 of its durability."
	]
	quest.4CA9218FA53F5DE1.title: "Magic Map Focus"
	quest.4CA9218FA53F5DE1.quest_subtitle: "Feather, berry and glowstone"
	quest.4CA9218FA53F5DE1.quest_desc: [
		"&eWhat:&r the focus that turns paper into a Magic Map of the Twilight Forest."
		"&eHow:&r a raven feather, torchberries and glowstone dust, shapeless. Ravens hop about the forest floor; torchberries hang from cave roofs (skeleton druids drop them too)."
		"&eTip:&r torchberries also make berry torches, which never need fuel."
	]
	quest.4382AE1CE86BC1A6.title: "A Map of Dusk"
	quest.4382AE1CE86BC1A6.quest_subtitle: "Optional: the forest draws its own map"
	quest.4382AE1CE86BC1A6.quest_desc: [
		"&eWhat:&r the Magic Map shows Twilight biomes and marks every boss structure with an icon."
		"&eHow:&r eight paper around the focus makes a blank Magic Map. Use it inside the Twilight Forest to fill it in."
		"&eTip:&r the Maze Map does the same job inside the Minoshroom's labyrinth; Nature's Compass finds biomes, Explorer's Compass finds structures."
	]
	quest.236C4B860AAB5C49.title: "Hollow Hills"
	quest.236C4B860AAB5C49.quest_subtitle: "Optional: a hill full of ore and spiders"
	quest.236C4B860AAB5C49.quest_desc: [
		"&eWhat:&r hollow hills are mounds with a cave inside, lined with ore blocks, spawners and a treasure chest."
		"&eHow:&r find a small hollow hill (the mounds in the plain forest) and step inside."
		"&eTip:&r break the spawners first. The ore inside is free feedstock for your ore lines."
	]
	quest.2E9E4733D025679D.title: "Ore Magnet"
	quest.2E9E4733D025679D.quest_subtitle: "Optional: pull the vein to you"
	quest.2E9E4733D025679D.quest_desc: [
		"&eWhat:&r a hollow hill treasure that drags a vein of ore out of the rock towards you."
		"&eChemistry:&r real mines do a version of this: magnetic separation pulls magnetite (Fe₃O₄) out of crushed rock, because it is strongly ferromagnetic."
		"&eHow:&r loot it from a hollow hill chest (any size). Aim at stone and use it."
	]
	quest.20296B7B6D4D509C.title: "The Great Hollow Hill"
	quest.20296B7B6D4D509C.quest_subtitle: "Optional: the biggest hill, the best chest"
	quest.20296B7B6D4D509C.quest_desc: [
		"&eWhat:&r large hollow hills hold the most ore, the most spawners and the richest chest of the three sizes."
		"&eHow:&r look for the biggest mounds in the forest and step inside."
		"&eTip:&r light the cave up as you go; the spawners inside are what makes it dangerous."
	]
	quest.11BB4BAFB379C1DA.title: "Hill Curios"
	quest.11BB4BAFB379C1DA.quest_subtitle: "Optional: a fan, a worm queen or a powder"
	quest.11BB4BAFB379C1DA.quest_desc: [
		"&eWhat:&r odd treasures from hills and the Lich Tower: the Peacock Feather Fan blows a gust of wind, the Moonworm Queen fires glowing moonworms, and Transformation Powder turns some mobs into their Twilight cousins."
		"&eHow:&r loot any one of them from hollow hill or tower chests."
		"&eTip:&r the Moonworm Queen is a lighting tool that never runs out for good; its repair recipe is in JEI."
	]
	quest.127FD36957AB6CC5.title: "Steeleaf"
	quest.127FD36957AB6CC5.quest_subtitle: "Optional: leaves as hard as metal"
	quest.127FD36957AB6CC5.quest_desc: [
		"&eWhat:&r steeleaf is a metal-hard leaf found only as treasure: hollow hill, labyrinth, stronghold and Dark Tower chests."
		"&eChemistry:&r a leaf of steel is fantasy. Real steel is iron with roughly 0.2 to 2% carbon dissolved in it, which is what makes it hard."
		"&eHow:&r loot chests as you explore. Nine make a steeleaf block for storage."
	]
	quest.575CA84F7948FBE4.title: "Steeleaf Gear"
	quest.575CA84F7948FBE4.quest_subtitle: "Optional: a pickaxe with built-in Fortune"
	quest.575CA84F7948FBE4.quest_desc: [
		"&eWhat:&r steeleaf tools and armour come pre-enchanted. The pickaxe is crafted with Fortune II already on it."
		"&eHow:&r craft any steeleaf piece (vanilla shapes with steeleaf; check JEI)."
		"&eTip:&r a Fortune II pickaxe this early doubles ore from your best veins."
	]
	quest.52D07DFAAE1958CD.title: "Ironwood"
	quest.52D07DFAAE1958CD.quest_subtitle: "Living root, iron and gold"
	quest.52D07DFAAE1958CD.quest_desc: [
		"&eWhat:&r ironwood is the forest's first metal: tougher than iron, and needed for the Twilight Metals milestone."
		"&eChemistry:&r smelting raw iron is a reduction: carbon monoxide strips the oxygen, Fe₂O₃ + 3CO → 2Fe + 3CO₂. The liveroot and gold just make it Twilight."
		"&eHow:&r liveroot + raw iron + a gold nugget makes 2 raw ironwood (shapeless). Smelt or blast it. Liveroot grows in the root tangles underground."
		"&eTip:&r bring a stack of raw iron from home; liveroot is the only forest part."
	]
	quest.2A8520BC87E05E4F.title: "Ironwood Gear"
	quest.2A8520BC87E05E4F.quest_subtitle: "Optional: tools that come enchanted"
	quest.2A8520BC87E05E4F.quest_desc: [
		"&eWhat:&r ironwood tools and armour come with enchantments built in (the pickaxe has Efficiency I)."
		"&eHow:&r craft any ironwood piece in the usual shapes (check JEI)."
		"&eTip:&r a full ironwood set is a solid start for the Naga and the Lich."
	]
	quest.04C278B25CA523F3.title: "Oreberries"
	quest.04C278B25CA523F3.quest_subtitle: "Optional: bushes that grow metal"
	quest.04C278B25CA523F3.quest_desc: [
		"&eWhat:&r oreberry bushes grow underground in the forest and fruit iron, copper or gold berries. Smelt a berry for a nugget."
		"&eChemistry:&r real plants can do this: hyperaccumulators such as Alyssum store nickel in their leaves, and phytomining burns them for metal-rich ash."
		"&eHow:&r dig down a little under the forest floor to find the bushes (the enchanted forest grows them too). Collect 8 berries of any metal."
		"&eTip:&r the bushes are thorny and hurt you when you walk through them. Harvest them, don't push past."
	]
	quest.5650E651512B60B8.title: "Drying Rack"
	quest.5650E651512B60B8.quest_subtitle: "Optional: let the air do the work"
	quest.5650E651512B60B8.quest_desc: [
		"&eWhat:&r a rack that slowly dries what you hang on it: meat into jerky, mud into clay, treated leather into tanned leather."
		"&eHow:&r three twilight oak slabs in a row. Every wood has its own rack; right-click items onto it."
		"&eTip:&r drying takes minutes, not seconds. Build a row of racks."
	]
	quest.2BF59B0595F7B373.title: "Tanning"
	quest.2BF59B0595F7B373.quest_subtitle: "Optional: bark chemistry for leather"
	quest.2BF59B0595F7B373.quest_desc: [
		"&eWhat:&r tanned leather is the material for the new traveller's gear."
		"&eChemistry:&r real vegetable tanning works the same way: tannins (polyphenols from bark and leaves) bind to the collagen in hide and cross-link it, so it stops rotting and stays supple."
		"&eHow:&r tannin = water bottle + twilight oak sapling + root strand + twilight oak leaves. Tannin + leather = treated leather; dry that on a rack to get tanned leather."
		"&eTip:&r root strands come from the root blocks underground, near the liveroot."
	]
	quest.1670158D0136FEDD.title: "Traveller's Gear"
	quest.1670158D0136FEDD.quest_subtitle: "Optional: gear you can upgrade"
	quest.1670158D0136FEDD.quest_desc: [
		"&eWhat:&r vest, belt, goggles, boots, gloves and wings made from tanned leather. Each piece takes modifiers (double jump, gliding, auto-repair and more)."
		"&eHow:&r craft any piece (check JEI). The modifier recipes are in JEI too; many use Twilight drops such as raven feathers and borer essence."
		"&eTip:&r the wings need carminite, so they wait until the Dark Tower."
	]
	quest.3F245F5BEA0EA889.title: "Jerky"
	quest.3F245F5BEA0EA889.quest_subtitle: "Optional: food that keeps"
	quest.3F245F5BEA0EA889.quest_desc: [
		"&eWhat:&r dried meat from the drying rack: light, filling travel food."
		"&eChemistry:&r drying lowers the water activity of meat below about 0.85, and most bacteria can't grow without free water. It's one of the oldest preservation methods there is."
		"&eHow:&r hang raw meat (venison from forest deer works well) on a drying rack and wait. Collect 8 jerky."
	]
	quest.31A10F1B06C351EA.title: "Venison"
	quest.31A10F1B06C351EA.quest_subtitle: "Optional: the forest's everyday meat"
	quest.31A10F1B06C351EA.quest_desc: [
		"&eWhat:&r Twilight deer drop raw venison and leather. Cooked, it's a steady food for long trips."
		"&eChemistry:&r red meat is red because of myoglobin, an iron protein that holds oxygen. Cooking unfolds it and oxidises its iron from Fe²⁺ to Fe³⁺, which turns the meat brown."
		"&eHow:&r hunt deer in the forest, then cook the venison in a furnace, smoker or on a campfire."
		"&eTip:&r save a few raw pieces for the drying rack: venison jerky keeps forever."
	]
	quest.537A527A1114A7B6.title: "Charm of Life"
	quest.537A527A1114A7B6.quest_subtitle: "Optional: one death, refused"
	quest.537A527A1114A7B6.quest_desc: [
		"&eWhat:&r carried in your inventory, the Charm of Life is used up to save you from a killing blow."
		"&eHow:&r a chest find: fallen trunks, hollow hills, the Lich Tower, the stronghold and the Aurora Palace all have them."
		"&eTip:&r carry one into every boss fight."
	]
	quest.18D4A2102F919AE7.title: "Charm of Keeping"
	quest.18D4A2102F919AE7.quest_subtitle: "Optional: keep your things when you fall"
	quest.18D4A2102F919AE7.quest_desc: [
		"&eWhat:&r the Charm of Keeping is used up when you die and keeps some of your items with you. Higher tiers keep more."
		"&eHow:&r found in many forest chests; maze slimes drop them too."
		"&eTip:&r the forest's death caskets also hold what you drop, so you can come back for it."
	]
	quest.7A896DEA1B224171.title: "Stronger Charms"
	quest.7A896DEA1B224171.quest_subtitle: "Optional: four charms make one better"
	quest.7A896DEA1B224171.quest_desc: [
		"&eWhat:&r combine charms into a higher tier: Charm of Life II, or Charm of Keeping II and III."
		"&eHow:&r four of a tier, shapeless, make one of the next tier (check JEI)."
		"&eTip:&r a Charm of Keeping III keeps your whole inventory, so it's worth saving sixteen of the first tier."
	]
	quest.3798CB29F2F9EB96.title: "The Green Twilight"
	quest.3798CB29F2F9EB96.quest_subtitle: "Optional: three of the open biomes"
	quest.3798CB29F2F9EB96.quest_desc: [
		"&eWhat:&r the outer Twilight biomes are open from the start: a glowing enchanted forest, a firefly forest and giant mushrooms."
		"&eChemistry:&r fireflies (and their real cousins) glow by bioluminescence: the enzyme luciferase oxidises luciferin with O₂ and ATP, releasing light instead of heat."
		"&eHow:&r Nature's Compass can point you to each biome. Just walk in."
	]
	quest.3C32DFF182AAB721.title: "The Hedge Maze"
	quest.3C32DFF182AAB721.quest_subtitle: "Optional: thorny walls and hedge spiders"
	quest.3C32DFF182AAB721.quest_desc: [
		"&eWhat:&r a maze of hedges in the forest, with hedge spiders and chests at the dead ends."
		"&eHow:&r find one in the forest and walk in."
		"&eTip:&r bring shears or an axe and cut your own path when you're lost."
	]
	quest.3EDECB3F741E7A42.title: "The Questing Ram"
	quest.3EDECB3F741E7A42.quest_subtitle: "Secret: a ram that wants every colour"
	quest.3EDECB3F741E7A42.quest_desc: [
		"&eWhat:&r a hidden grove where the Questing Ram lives. Feed it one wool of every colour and it rewards you."
		"&eChemistry:&r wool dyes are real chemistry too: indigo, cochineal and lapis-blue (lazurite, a sulfur-bearing silicate) all coloured cloth in history."
		"&eTip:&r the grove's ring of stones looks like a fairy ring in the enchanted forest."
	]
	quest.50BB6994DC34E843.title: "The Crumble Horn"
	quest.50BB6994DC34E843.quest_subtitle: "Secret: the ram's reward"
	quest.50BB6994DC34E843.quest_desc: [
		"&eWhat:&r feed the Questing Ram all sixteen colours of wool and it pays out blocks of metal and gems, its trophy, and the Crumble Horn."
		"&eHow:&r blow the horn at stone and it crumbles the blocks in front of you (check JEI for what turns into what)."
		"&eTip:&r it's a handy tunnelling tool for the labyrinth."
	]
	quest.3DB2F38D604DB483.title: "The Ram's Own Trophy"
	quest.3DB2F38D604DB483.quest_subtitle: "Secret: a bundle with a head in it"
	quest.3DB2F38D604DB483.quest_desc: [
		"&eWhat:&r the Questing Ram's reward comes in a bundle: its own trophy plus a pile of metal and gem blocks."
		"&eHow:&r open the bundle the ram gave you and keep the trophy. Place it on a wall next to your boss trophies."
		"&eTip:&r it's the only trophy in the forest you earn without a fight."
	]
	quest.30B14071B1D5A576.title: "The Naga's Courtyard"
	quest.30B14071B1D5A576.quest_subtitle: "Find the serpent's courtyard and win"
	quest.30B14071B1D5A576.quest_desc: [
		"&6You remember this twilight. You walked here once, when the forest was young.&r"
		"&eWhat:&r the first boss. Each boss lifts the curse on the next region (hunger, fire, darkness, frost or acid rain), so the order matters."
		"&eHow:&r the courtyard is a walled stone garden in the plain forest (the Magic Map marks it). Fight inside it."
		"&eTip:&r the Naga charges in straight lines; sidestep, then hit it while it turns."
	]
	quest.5718690DD26FB67B.title: "Naga Scale Armour"
	quest.5718690DD26FB67B.quest_subtitle: "Optional: armour from the serpent"
	quest.5718690DD26FB67B.quest_desc: [
		"&eWhat:&r a tunic and leggings of naga scales. Both come pre-enchanted: Fire Protection III on the tunic, Protection III on the leggings."
		"&eHow:&r eight scales for the tunic, seven for the leggings, in the usual armour shapes (check JEI)."
		"&eTip:&r the fire protection pays off later in the Hydra's fire swamp."
	]
	quest.14B8FA65B7C3829D.title: "The Naga"
	quest.14B8FA65B7C3829D.quest_subtitle: "Scales from the forest's first boss"
	quest.14B8FA65B7C3829D.quest_desc: [
		"&eWhat:&r a great serpent coiled in a stone courtyard. Its scales unlock the path forward and make naga armour."
		"&eHow:&r the Naga drops scales and its trophy when it dies. Hit it when it stops charging; stay out of its coils."
		"&eTip:&r the Lich Tower is next. Its door won't open until the Naga is dead."
	]
	quest.573FFFBA26396F1C.title: "The Lich Tower"
	quest.573FFFBA26396F1C.quest_subtitle: "Climb the tower and break the sorcerer"
	quest.573FFFBA26396F1C.quest_desc: [
		"&eWhat:&r the Lich waits at the top of a tall stone tower. Beating it opens the swamp, the dark forest and the snowy forest."
		"&eHow:&r climb through the tower's rooms to the top. Break the shields orbiting it before you can hurt it."
		"&eTip:&r the Lich's shadow clones are distractions; watch for the one that casts."
	]
	quest.4EEBFA76B5E993E8.title: "Four Scepters"
	quest.4EEBFA76B5E993E8.quest_subtitle: "Optional: every scepter the Lich carries"
	quest.4EEBFA76B5E993E8.quest_desc: [
		"&eWhat:&r the Lich drops one scepter per kill: Twilight (fires bolts), Zombie (raises loyal zombies), Lifedrain (heals you as it hurts) and Fortification (a shield)."
		"&eHow:&r other Lich Towers have their own Lich. Beat it again to collect the set."
		"&eTip:&r scepters recharge on a crafting grid with their own item (check JEI). The Renewal enchantment recharges them automatically."
	]
	quest.1B55EFB33077AC2C.title: "The Lich"
	quest.1B55EFB33077AC2C.quest_subtitle: "A sorcerer's trophy and scepters"
	quest.1B55EFB33077AC2C.quest_desc: [
		"&eWhat:&r the Lich drops its trophy, one of its scepters and golden gear."
		"&eHow:&r pick up the trophy from the top of the tower once it falls."
		"&eTip:&r three ways open now: the labyrinth in the swamp, the stronghold in the dark forest, and the snowy forest below."
	]
	quest.32F33C12C92BD123.title: "The Labyrinth"
	quest.32F33C12C92BD123.quest_subtitle: "A maze under the swamp"
	quest.32F33C12C92BD123.quest_desc: [
		"&eWhat:&r beneath the swamp lies a maze of mossy stone. The Minoshroom waits in a room at its heart."
		"&eHow:&r enter through the stairs in the swamp. A Maze Map (made with a Maze Map Focus) shows the corridors."
		"&eTip:&r mosquito swarms bite in the swamp; bring plenty of food."
	]
	quest.352D5D70DB4C3D96.title: "Mazebreaker"
	quest.352D5D70DB4C3D96.quest_subtitle: "Optional: the labyrinth's jackpot"
	quest.352D5D70DB4C3D96.quest_desc: [
		"&eWhat:&r a diamond pickaxe that chews through maze stone, found only in the labyrinth's best vault."
		"&eHow:&r labyrinth vaults are sealed rooms off the corridors. The jackpot vault is rare; check every one."
		"&eTip:&r a Maze Map shows unexplored rooms as gaps in the corridors."
	]
	quest.65BD66A52090130E.title: "Maze Map Focus"
	quest.65BD66A52090130E.quest_subtitle: "A minotaur's map lens"
	quest.65BD66A52090130E.quest_desc: [
		"&eWhat:&r the focus for Maze Maps, and the heart of the Uncrafting Table."
		"&eHow:&r minotaurs in the labyrinth drop it. Kill them as you search for the Minoshroom."
		"&eTip:&r keep a spare; the Uncrafting Table eats one."
	]
	quest.72B1C3C4965990E9.title: "Minotaur Axe"
	quest.72B1C3C4965990E9.quest_subtitle: "Optional: the Minoshroom's weapon"
	quest.72B1C3C4965990E9.quest_desc: [
		"&eWhat:&r a heavy diamond axe dropped by the Minoshroom."
		"&eHow:&r beat the Minoshroom; the axe drops with its stroganoff."
		"&eTip:&r it's an axe, so it still chops wood; keep it for both jobs."
	]
	quest.005D8A97125DC3EC.title: "Meef"
	quest.005D8A97125DC3EC.quest_subtitle: "Optional: minotaur meat, a maze staple"
	quest.005D8A97125DC3EC.quest_desc: [
		"&eWhat:&r the labyrinth's minotaurs drop raw meef. Cooked meef steaks are among the best plain foods in the forest."
		"&eChemistry:&r a seared crust is the Maillard reaction: amino acids and sugars react above about 140 °C into hundreds of browned flavour compounds."
		"&eHow:&r kill minotaurs in the labyrinth's corridors, then cook the meef in a furnace, smoker or on a campfire."
		"&eTip:&r raw meef also dries into meef jerky on a drying rack."
	]
	quest.52E4898C23EA212B.title: "Maze Wafers"
	quest.52E4898C23EA212B.quest_subtitle: "Optional: biscuits from the labyrinth's larder"
	quest.52E4898C23EA212B.quest_desc: [
		"&eWhat:&r small dry wafers stashed in labyrinth rooms, dead ends and vaults. Goblin strongholds and the Aurora Palace keep some too."
		"&eChemistry:&r dry food keeps because microbes need free water; bakers call this low water activity, the same trick as jerky and hard tack."
		"&eHow:&r open the labyrinth's chests as you work through the maze."
		"&eTip:&r keep a few in a pocket as emergency food for the rest of the boss line."
	]
	quest.39DF1364A3BB9256.title: "Maze Map"
	quest.39DF1364A3BB9256.quest_subtitle: "Optional: a map of corridors"
	quest.39DF1364A3BB9256.quest_desc: [
		"&eWhat:&r a map that draws the tunnels around you at your own depth."
		"&eHow:&r eight paper around a Maze Map Focus makes a blank Maze Map. Use it in the labyrinth to fill it in."
		"&eTip:&r one map covers one level; make another for each floor."
	]
	quest.3DD75B19D000C358.title: "Ore Map"
	quest.3DD75B19D000C358.quest_subtitle: "Optional: a map that shows ore"
	quest.3DD75B19D000C358.quest_desc: [
		"&eWhat:&r a Maze Map upgraded to also mark the ore around you."
		"&eHow:&r a blank Maze Map + a diamond block + a gold block + an iron block, shapeless. Use it to fill it in."
		"&eTip:&r expensive, but it finds rich pockets for your ore lines fast."
	]
	quest.0DD53DE3BCAD93CA.title: "Uncrafting Table"
	quest.0DD53DE3BCAD93CA.quest_subtitle: "Optional: undo a crafting recipe"
	quest.0DD53DE3BCAD93CA.quest_desc: [
		"&eWhat:&r the Twilight Forest's table that turns crafted items back into their ingredients, for XP."
		"&eChemistry:&r the Alchemistry Dissolver goes further: it uncrafts all the way down to elements."
		"&eHow:&r eight crafting tables around a Maze Map Focus (this pack leaves the recipe and the table unchanged)."
		"&eTip:&r the XP cost rises with the item's value, and some recipes can't be reversed; the table tells you."
	]
	quest.7BC4ACBC5EAAC5BD.title: "The Minoshroom"
	quest.7BC4ACBC5EAAC5BD.quest_subtitle: "The boss at the labyrinth's heart"
	quest.7BC4ACBC5EAAC5BD.quest_desc: [
		"&eWhat:&r a mushroom minotaur in the swamp labyrinth. It drops its trophy, meef stroganoff and a mighty axe."
		"&eHow:&r the Maze Map helps you find it in the maze. Sidestep its charges."
		"&eTip:&r don't eat all the stroganoff at once; the next quest needs one."
	]
	quest.4BC58543EF192729.title: "Mighty Stroganoff"
	quest.4BC58543EF192729.quest_subtitle: "Eat it to bear the fire swamp"
	quest.4BC58543EF192729.quest_desc: [
		"&eWhat:&r the fire swamp sets you alight until your body is used to its heat. Eating meef stroganoff does that."
		"&eHow:&r eat one meef stroganoff from the Minoshroom, and keep another in your inventory for this quest."
		"&eTip:&r it's also one of the best foods in the forest: a full bowl of hunger."
	]
	quest.24D5883E6B376D56.title: "The Hydra's Lair"
	quest.24D5883E6B376D56.quest_subtitle: "A cave in the fire swamp"
	quest.24D5883E6B376D56.quest_desc: [
		"&eWhat:&r the Hydra lives in a hill cave in the fire swamp, the hottest place in the forest."
		"&eChemistry:&r swamps really do burn: rotting plants release methane (CH₄), which can ignite as marsh fire."
		"&eHow:&r eat the stroganoff first or the swamp burns you. Strike the heads when they lunge."
		"&eTip:&r the heads regrow if you're slow; pressure one at a time."
	]
	quest.571F7949936FB1BC.title: "The Wild Regions"
	quest.571F7949936FB1BC.quest_subtitle: "Optional: swamp, fire swamp and dark forest"
	quest.571F7949936FB1BC.quest_desc: [
		"&eWhat:&r the regions you fought through on the main line. Walk through each once you've earned it."
		"&eHow:&r Nature's Compass points to each biome. The Lich lifts the swamp's hunger and the dark forest's darkness; the stroganoff lifts the fire swamp's burning."
		"&eTip:&r a quick visit counts; you don't need to stay."
	]
	quest.39A9D5474A8012E0.title: "The Hydra"
	quest.39A9D5474A8012E0.quest_subtitle: "Three heads in the fire swamp"
	quest.39A9D5474A8012E0.quest_desc: [
		"&eWhat:&r the Hydra breathes fire from three heads. It drops its trophy, fiery blood and hydra chops."
		"&eHow:&r fire resistance potions help. Hit the heads when they lunge at you; they regrow, so keep up the pressure."
		"&eTip:&r a hydra chop is a huge meal that also heals; save them for boss fights."
	]
	quest.6A3D139EDF66F3AB.title: "Fiery Metal"
	quest.6A3D139EDF66F3AB.quest_subtitle: "Iron quenched in burning blood"
	quest.6A3D139EDF66F3AB.quest_desc: [
		"&eWhat:&r fiery ingots: the hottest metal of the forest, for fire-proof tools and armour."
		"&eChemistry:&r real blood is red because of the iron in haem, the part of haemoglobin that carries O₂. The Hydra's blood just burns as well."
		"&eHow:&r a vial of fiery blood (Hydra) or fiery tears (Ur-Ghast) + an iron ingot, shapeless."
	]
	quest.492415D794906357.title: "Hydra Chop"
	quest.492415D794906357.quest_subtitle: "Optional: one bite fills you up"
	quest.492415D794906357.quest_desc: [
		"&eWhat:&r a giant cut of Hydra meat. Eating one fills your whole hunger bar at once."
		"&eChemistry:&r food energy is measured by burning food in a bomb calorimeter: the heat released (about 4 kcal per gram of protein, 9 per gram of fat) is what your body can extract by slower oxidation."
		"&eHow:&r the Hydra drops them when it dies. Fight another Hydra in a different lair for more."
		"&eTip:&r eat it when your hunger bar is empty; the mod has an advancement for exactly that."
	]
	quest.7F3E65B654069BAA.title: "Fiery Gear"
	quest.7F3E65B654069BAA.quest_subtitle: "Optional: a pickaxe that smelts as it digs"
	quest.7F3E65B654069BAA.quest_desc: [
		"&eWhat:&r the Fiery Pickaxe smelts the ore it mines on the spot; the sword sets targets alight."
		"&eChemistry:&r smelting is reduction: heat plus carbon pulls the oxygen off a metal oxide. The pickaxe does the furnace's job at the moment you mine."
		"&eHow:&r fiery ingots with blaze rods for the tools, or alone for the armour (check JEI)."
		"&eTip:&r auto-smelting skips your ore doubling. Use it on things you'd only smelt anyway."
	]
	quest.2035D7BA15DF5C7D.title: "Armour Shards"
	quest.2035D7BA15DF5C7D.quest_subtitle: "Knock the plates off goblins"
	quest.2035D7BA15DF5C7D.quest_desc: [
		"&eWhat:&r shards of knightmetal, the stronghold's metal. Nine make a shard cluster."
		"&eHow:&r goblin knights and block-and-chain goblins in the Goblin Knight Stronghold drop them; helmet crabs on the shore drop them too."
		"&eTip:&r the dark forest has been safe to walk since the Lich; only its centre stays dark."
	]
	quest.457A1193C4EB239D.title: "Knightmetal"
	quest.457A1193C4EB239D.quest_subtitle: "Melt the shards back together"
	quest.457A1193C4EB239D.quest_desc: [
		"&eWhat:&r knightmetal ingots, for the heaviest armour and weapons in the forest."
		"&eChemistry:&r remelting scrap is how most real steel is made today: an electric arc furnace melts recycled metal back into new ingots."
		"&eHow:&r nine armour shards make a cluster (shapeless). Smelt or blast the cluster for one ingot."
	]
	quest.5CB8CFE1F0ED4E1C.title: "Twilight Metals"
	quest.5CB8CFE1F0ED4E1C.quest_subtitle: "Ironwood, knightmetal and fiery metal"
	quest.5CB8CFE1F0ED4E1C.quest_desc: [
		"&eWhat:&r the three alloys found nowhere else, for strong tools and armour."
		"&eHow:&r ironwood from liveroot (see the forest), knightmetal from armour shards, fiery metal from iron and fiery blood or tears."
		"&eTip:&r knightmetal armour and tools are great against the Knight Phantoms."
	]
	quest.60C0DD7EE2931A65.title: "Knight's Arms"
	quest.60C0DD7EE2931A65.quest_subtitle: "Optional: knightmetal or phantom gear"
	quest.60C0DD7EE2931A65.quest_desc: [
		"&eWhat:&r knightmetal tools and armour, or the phantom helmet and chestplate the Knight Phantoms sometimes drop."
		"&eHow:&r craft any knightmetal piece (check JEI), or take phantom armour from the phantoms' drops."
		"&eTip:&r the phantoms also drop knightmetal weapons, so the fight can pay for itself."
	]
	quest.08AEB9FC16AE3379.title: "Block and Chain"
	quest.08AEB9FC16AE3379.quest_subtitle: "Optional: a ball and chain, or a shield"
	quest.08AEB9FC16AE3379.quest_desc: [
		"&eWhat:&r the Block and Chain is a thrown flail that smashes blocks and mobs; the Knightmetal Shield blocks like a wall."
		"&eHow:&r both start with a knightmetal ring (four ingots in a ring). Block and Chain: block + 3 ingots + ring. Shield: ingots, ring and towerwood (check JEI)."
		"&eTip:&r the shield needs towerwood from the Dark Tower."
	]
	quest.075918014C45253D.title: "The Goblin Stronghold"
	quest.075918014C45253D.quest_subtitle: "Six phantoms under the dark forest"
	quest.075918014C45253D.quest_desc: [
		"&eWhat:&r the Knight Phantoms haunt the deepest room of the Goblin Knight Stronghold, buried under the dark forest."
		"&eHow:&r find the entrance in the dark forest (the Magic Map marks it). Inside, place a boss trophy on the Trophy Pedestal to wake the phantoms, then kill all six."
		"&eTip:&r the stronghold opens after the Lich; this page sends you after the Hydra so you arrive with fiery and knightmetal gear."
	]
	quest.2BC7F933F44AED54.title: "The Knight Phantoms"
	quest.2BC7F933F44AED54.quest_subtitle: "Six ghosts in the goblin stronghold"
	quest.2BC7F933F44AED54.quest_desc: [
		"&eWhat:&r six phantom knights guard the Goblin Stronghold in the dark forest. Their trophy drops with the last one."
		"&eHow:&r they wait deep inside the stronghold. Knightmetal armour helps."
		"&eTip:&r beating them lifts the darkness on the dark forest's centre, where the Dark Tower stands."
	]
	quest.64F3BF8672A26176.title: "The Dark Tower"
	quest.64F3BF8672A26176.quest_subtitle: "Climb to the Ur-Ghast"
	quest.64F3BF8672A26176.quest_desc: [
		"&eWhat:&r a huge tower of towerwood in the centre of the dark forest, with the Ur-Ghast at the top."
		"&eHow:&r climb through the tower's floors using its carminite contraptions; redstone opens the way in many rooms. A tower key from a chest opens the locked doors."
		"&eTip:&r towerwood borers eat through the walls; kill them before they swarm."
	]
	quest.7EBA413DC414750D.title: "Carminite"
	quest.7EBA413DC414750D.quest_subtitle: "The red gem that runs the tower"
	quest.7EBA413DC414750D.quest_desc: [
		"&eWhat:&r carminite powers the Dark Tower's devices and the traveller's wings."
		"&eChemistry:&r its name echoes carmine, a real red dye: carminic acid (C₂₂H₂₀O₁₃), made by cochineal insects."
		"&eHow:&r the Ur-Ghast drops some. Or craft it: 4 borer essence + 4 redstone + a ghast tear. Borer essence drops from towerwood borers."
	]
	quest.4CF4753B35BC4EA2.title: "Tower Contraptions"
	quest.4CF4753B35BC4EA2.quest_subtitle: "Optional: build the tower's tricks"
	quest.4CF4753B35BC4EA2.quest_desc: [
		"&eWhat:&r the redstone gadgets of the Dark Tower: blocks that vanish and reappear, a builder that lays bridges, and the carminite reactor."
		"&eHow:&r encased towerwood + carminite, with redstone, a dispenser or redstone ore depending on the device (check JEI)."
		"&eTip:&r vanishing blocks make secret doors for your base; a redstone pulse opens them."
	]
	quest.7D7C2530FE94F90E.title: "Experiment 115"
	quest.7D7C2530FE94F90E.quest_subtitle: "Secret: someone baked in the tower"
	quest.7D7C2530FE94F90E.quest_desc: [
		"&eWhat:&r a strange cake left in the Dark Tower's chests. Nobody knows who baked it."
		"&eHow:&r found in Dark Tower chests. Place it and take a bite."
		"&eTip:&r there's a rumour it can be refilled. Experiment."
	]
	quest.24EB5B9F3C30D2F1.title: "The Ur-Ghast"
	quest.24EB5B9F3C30D2F1.quest_subtitle: "The ghast queen of the Dark Tower"
	quest.24EB5B9F3C30D2F1.quest_desc: [
		"&6You remember the last tower of the twilight. Its keeper remembers you too.&r"
		"&eWhat:&r the great ghast at the top of the Dark Tower. Its fiery tears make more fiery metal."
		"&eHow:&r climb the tower. Kill ghastlings near the ghast traps to charge them; charged traps pull the Ur-Ghast down so you can strike."
		"&eTip:&r carminite from the tower makes redstone gadgets of the twilight."
	]
	quest.06CC5F9C904C562E.title: "The Yeti Cave"
	quest.06CC5F9C904C562E.quest_subtitle: "A cave in the snowy forest"
	quest.06CC5F9C904C562E.quest_desc: [
		"&eWhat:&r the Alpha Yeti rules a cave in the snowy forest, surrounded by its smaller yetis."
		"&eChemistry:&r cold kills by pulling heat out of you; still air is a poor conductor of heat, which is why fur and down keep you warm."
		"&eHow:&r the snowy forest's frost lifts after the Lich. Find the cave and fight inside."
		"&eTip:&r when it roars, icicles fall from the roof; keep moving."
	]
	quest.7C52CA9E17D044E7.title: "Arctic Fur"
	quest.7C52CA9E17D044E7.quest_subtitle: "Optional: dyeable armour from yeti fur"
	quest.7C52CA9E17D044E7.quest_desc: [
		"&eWhat:&r ordinary yetis drop arctic fur, which makes light, warm armour you can dye."
		"&eChemistry:&r fur traps a layer of still air, and air conducts heat about a thousand times worse than ice-cold water does."
		"&eHow:&r kill yetis in the snowy forest. Arctic armour uses the usual shapes (check JEI)."
	]
	quest.656D7C4735C0CFA8.title: "The Alpha Yeti"
	quest.656D7C4735C0CFA8.quest_subtitle: "The snowy forest's boss"
	quest.656D7C4735C0CFA8.quest_desc: [
		"&eWhat:&r the Alpha Yeti lives in a cave in the snowy forest. It drops its trophy, alpha yeti fur and ice bombs."
		"&eHow:&r dodge the ice it throws and the icicles that fall from the cave roof."
		"&eTip:&r carrying alpha yeti fur is what lets you bear the glacier's cold."
	]
	quest.350ECB50DEF6DE63.title: "Alpha Yeti Fur"
	quest.350ECB50DEF6DE63.quest_subtitle: "Optional: the pelt of the snowy forest's boss"
	quest.350ECB50DEF6DE63.quest_desc: [
		"&eWhat:&r the Alpha Yeti's thick white fur, the material of yeti armour."
		"&eChemistry:&r hair and fur are keratin, a protein whose chains are cross-linked by disulfide (S–S) bonds from the amino acid cysteine; that's what makes it tough and water-shedding."
		"&eHow:&r the Alpha Yeti drops it when it dies. Other yeti caves have other Alpha Yetis if you need more."
		"&eTip:&r a full yeti set takes a lot of fur; keep a piece in your pack for the glacier's cold."
	]
	quest.54DEACECA3E07A58.title: "Yeti Armour"
	quest.54DEACECA3E07A58.quest_subtitle: "Optional: the Alpha Yeti's coat"
	quest.54DEACECA3E07A58.quest_desc: [
		"&eWhat:&r armour of alpha yeti fur; every piece is crafted with Protection II already on it."
		"&eHow:&r alpha yeti fur in the usual armour shapes (check JEI)."
		"&eTip:&r the Alpha Yeti's ice bombs freeze the ground where they land; throw them at a crowd."
	]
	quest.7B22307BB2A82650.title: "The Aurora Palace"
	quest.7B22307BB2A82650.quest_subtitle: "An ice palace on the glacier"
	quest.7B22307BB2A82650.quest_desc: [
		"&eWhat:&r the Snow Queen's palace of packed ice and aurora blocks stands on the glacier."
		"&eChemistry:&r real auroras are light from oxygen (green, red) and nitrogen (blue, purple) atoms excited by charged particles from the Sun."
		"&eHow:&r the glacier opens after the Alpha Yeti. Climb the palace to the Queen's throne room."
		"&eTip:&r break her ice shields first; she falls on you from above, so look up."
	]
	quest.170C7097B314C79D.title: "Palace Armoury"
	quest.170C7097B314C79D.quest_subtitle: "Optional: weapons from the palace caches"
	quest.170C7097B314C79D.quest_desc: [
		"&eWhat:&r the Aurora Palace's chests hold the Ice Sword and Ice Bow, which slow what they hit, and the Ender Bow, which swaps you with your target."
		"&eHow:&r loot the palace's rooms and caches on your way up."
		"&eTip:&r the Ender Bow is a fine escape tool: shoot a mob far away and trade places."
	]
	quest.73128FC20EA6EAB0.title: "One Hit Wonder"
	quest.73128FC20EA6EAB0.quest_subtitle: "Optional: a blade that shatters on first use"
	quest.73128FC20EA6EAB0.quest_desc: [
		"&eWhat:&r an enchanted Glass Sword from the Aurora Palace's room chests. It hits very hard, then breaks after a single hit."
		"&eChemistry:&r glass is amorphous SiO₂: with no crystal grains to stop it, one crack runs straight through. Toughened glass is quenched so its surface is squeezed, and cracks have to fight that first."
		"&eHow:&r loot the palace rooms on your way up to the Queen. It's a rare find; check every chest."
		"&eTip:&r save it for one blow that matters, like the last hit on a boss."
	]
	quest.53A416978B641844.title: "The Snow Queen"
	quest.53A416978B641844.quest_subtitle: "The glacier's ice palace"
	quest.53A416978B641844.quest_desc: [
		"&eWhat:&r the Snow Queen rules the Aurora Palace on the glacier."
		"&eHow:&r climb the palace, then break her ice shields and avoid her drop attacks."
		"&eTip:&r beating her finishes the snowy branch of the twilight."
	]
	quest.53890000D55CBBAB.title: "The Queen's Bows"
	quest.53890000D55CBBAB.quest_subtitle: "Optional: three arrows, or arrows that seek"
	quest.53890000D55CBBAB.quest_desc: [
		"&eWhat:&r the Snow Queen drops one of two bows: the Tri-Bow fires three arrows at once, the Seeker Bow's arrows home in on targets."
		"&eHow:&r beat the Snow Queen; one bow drops with her trophy."
		"&eTip:&r the Seeker Bow is perfect against the flying Ur-Ghast's ghastlings."
	]
	quest.089D4A7144E8B41C.title: "The Frozen Regions"
	quest.089D4A7144E8B41C.quest_subtitle: "Optional: snowy forest and glacier"
	quest.089D4A7144E8B41C.quest_desc: [
		"&eWhat:&r the cold half of the forest: the snowy forest and the glacier beyond it."
		"&eChemistry:&r glacier ice is blue because water absorbs red light weakly; thick, bubble-free ice lets mostly blue through."
		"&eHow:&r visit both. Warm armour stops the blizzard's chill."
	]
	quest.1A1B0B1B03A203F4.title: "The Highlands"
	quest.1A1B0B1B03A203F4.quest_subtitle: "The plateau beyond every barrier"
	quest.1A1B0B1B03A203F4.quest_desc: [
		"&6Both branches beaten, the last barrier thins. You remember standing up here and looking down on all of it.&r"
		"&eWhat:&r the highlands and the thornlands ring the forest's centre. Trolls and giants live up here."
		"&eHow:&r with the Hydra, the Ur-Ghast and the Snow Queen beaten, the acid rain over the highlands stops. Step into the thornlands' edge too; their rain only stops once you hold the Lamp of Cinders."
		"&eTip:&r giants are huge and hit hard; fight them from range."
	]
	quest.323C64846AFEC17D.title: "Trophy Wall"
	quest.323C64846AFEC17D.quest_subtitle: "Optional: all eight trophies at once"
	quest.323C64846AFEC17D.quest_desc: [
		"&eWhat:&r a trophy from every boss of the forest, in your inventory at the same time."
		"&eHow:&r keep the trophies you already have. Bosses can be fought again in other structures of the same kind."
		"&eTip:&r trophies make a fine wall in your base; place them with a right-click."
	]
	quest.21B4176B92393E04.title: "Troll Caves"
	quest.21B4176B92393E04.quest_subtitle: "The trolls' vaults and the Lamp of Cinders"
	quest.21B4176B92393E04.quest_desc: [
		"&eWhat:&r caves under the highlands, full of trolls guarding vaults. The Lamp of Cinders hides in one."
		"&eHow:&r find a troll cave in the highlands and loot its vaults. The lamp burns away the thorns that wall off the final plateau."
		"&eTip:&r trolls throw rocks; fight them in the open, not in narrow tunnels."
	]
	quest.2CC987541BBC6F25.title: "Thorn Roses"
	quest.2CC987541BBC6F25.quest_subtitle: "Optional: a flower that grows on thorns"
	quest.2CC987541BBC6F25.quest_desc: [
		"&eWhat:&r the thornlands' only flower, growing among the thorns. One rose crafts into red dye."
		"&eChemistry:&r red petals get their colour from anthocyanins, pigments that change colour with pH: red in acid, purple to blue as it rises. Red cabbage juice is the same dye and makes a classroom pH indicator."
		"&eHow:&r pick them carefully at the thornlands' edge; living thorns hurt to touch."
		"&eTip:&r bring the Lamp of Cinders to clear a safe path first."
	]
	quest.02D40EB8D976C22D.title: "Uberous Soil"
	quest.02D40EB8D976C22D.quest_subtitle: "Optional: soil rich enough for a beanstalk"
	quest.02D40EB8D976C22D.quest_desc: [
		"&eWhat:&r a glowing, absurdly fertile soil from the trolls' gardens. Magic beans planted on it sprout a beanstalk."
		"&eChemistry:&r real fertile soil is rich in humus and in the three big plant nutrients, nitrogen, phosphorus and potassium (N-P-K), the same numbers printed on every fertiliser bag."
		"&eHow:&r loot troll cave gardens; the same caves hold the magic beans."
		"&eTip:&r a beanstalk is only useful with clouds above it; plant under the cloud layer."
	]
	quest.438848E256C633EB.title: "Magic Beans"
	quest.438848E256C633EB.quest_subtitle: "Optional: a beanstalk to the clouds"
	quest.438848E256C633EB.quest_desc: [
		"&eWhat:&r trolls drop magic beans. Planted on the glowing uberous soil beneath the clouds, they grow a beanstalk straight up."
		"&eChemistry:&r real beans are legumes: bacteria in their root nodules fix N₂ from the air into ammonia (NH₃), the same job Haber-Bosch does with iron and heat."
		"&eHow:&r kill trolls or loot their gardens (the gardens also hold uberous soil). Plant a bean on the glowing soil under the clouds."
	]
	quest.0142C2CF3AF4D2BC.title: "Giant's Tools"
	quest.0142C2CF3AF4D2BC.quest_subtitle: "Optional: a pickaxe the size of a house"
	quest.0142C2CF3AF4D2BC.quest_desc: [
		"&eWhat:&r giant miners drop the Giant's Pickaxe, which breaks the oversized blocks of the cloud world; armoured giants drop the Giant's Sword."
		"&eHow:&r climb the beanstalk to the clouds and beat a giant. Both can also be crafted from giant cobblestone and giant logs (check JEI)."
		"&eTip:&r giant blocks break down into normal ones: one giant log crafts into 64 oak logs."
	]
	quest.627F1905DCEA1C00.title: "The Final Plateau"
	quest.627F1905DCEA1C00.quest_subtitle: "Burn through the thorns"
	quest.627F1905DCEA1C00.quest_desc: [
		"&eWhat:&r the highest ground in the forest, walled in by thorns and acid rain."
		"&eHow:&r carry the Lamp of Cinders. Use it on the thorns to burn a path through the thornlands, then climb onto the plateau."
		"&eTip:&r burnt thorns crumble away; don't stand in living ones, they hurt."
	]
	quest.025B8EF9A3CE8915.title: "The Unfinished Castle"
	quest.025B8EF9A3CE8915.quest_subtitle: "The castle at the top of the world"
	quest.025B8EF9A3CE8915.quest_desc: [
		"&6A castle on the final plateau, waiting for a ruler. You remember planning to come back for it.&r"
		"&eWhat:&r the Final Castle stands on the final plateau. Its last boss was never finished by the mod's authors, so this is the end of the road."
		"&eHow:&r cross the plateau and step inside the castle."
		"&eTip:&r the castle is still worth exploring for its architecture and its force-field doors."
	]
	quest.66F9A1EE403567F1.title: "Castle Stone"
	quest.66F9A1EE403567F1.quest_subtitle: "Optional: bricks from the last castle"
	quest.66F9A1EE403567F1.quest_desc: [
		"&eWhat:&r the Final Castle's pale brick, for building your own keep."
		"&eHow:&r mine castle brick from the castle walls. Its cracked, mossy, worn and pillar variants are in JEI."
		"&eTip:&r a stonecutter makes the stairs and pillars without waste."
	]
	chapter.269B4E9243C73BB1.title: "Deeper and Darker"
	chapter.269B4E9243C73BB1.chapter_subtitle: [
		"The Otherside: a silent world of sculk beneath the Ancient City."
	]
	quest.3A447C1F1CEAD738.title: "Sculk Stone and Gloomslate"
	quest.3A447C1F1CEAD738.quest_subtitle: "The bedrock of the Otherside"
	quest.3A447C1F1CEAD738.quest_desc: [
		"&6You remember this silence. Every footstep here used to be yours.&r"
		"&eWhat:&r the Otherside's two stones. Both carry their own versions of the usual ores: coal, iron, copper, gold, redstone, lapis, emerald and diamond."
		"&eChemistry:&r real slate is a metamorphic rock: shale (mostly clay minerals) squeezed and heated until its grains line up, so it splits into flat sheets."
		"&eHow:&r mine it and smelt the cobbled forms back into smooth stone."
		"&eTip:&r these ores go through the Create crusher too, with the same pack caps as Overworld ore."
	]
	quest.4358914CA70F20CE.title: "Resonarium"
	quest.4358914CA70F20CE.quest_subtitle: "Sludges carry a ringing metal"
	quest.4358914CA70F20CE.quest_desc: [
		"&eWhat:&r resonarium is a vibration-tuned material that drops from sludges, oozing creatures of the Otherside."
		"&eHow:&r hunt sludges in the Otherside's caves and collect the resonarium they drop."
		"&eTip:&r a Looting sword raises the drop count."
	]
	quest.625511AD7760DE41.title: "Resonarium Plate"
	quest.625511AD7760DE41.quest_subtitle: "Resonarium bound with scutes"
	quest.625511AD7760DE41.quest_desc: [
		"&eWhat:&r the plate that upgrades diamond gear to resonarium."
		"&eChemistry:&r turtle and armadillo scutes are built on keratin, the tough protein of hair, horn and hooves; its sulfur bridges (cysteine disulfides) make it hard."
		"&eHow:&r four resonarium and four scutes (turtle or armadillo, any mix), shapeless."
	]
	quest.013B3F7F9F09DE18.title: "Resonarium Template"
	quest.013B3F7F9F09DE18.quest_subtitle: "The smithing pattern for resonarium"
	quest.013B3F7F9F09DE18.quest_desc: [
		"&eWhat:&r the smithing template that turns diamond gear into resonarium gear."
		"&eHow:&r loot it from Ancient City chests, Trial Chamber reward chests, stronghold corridors or the Ancient Temple's top chest."
		"&eTip:&r copy it with 7 diamonds and a resonarium (makes 2). Never use your last one."
	]
	quest.05B9413B575A1FD9.title: "Resonarium Gear"
	quest.05B9413B575A1FD9.quest_subtitle: "Diamond gear, retuned"
	quest.05B9413B575A1FD9.quest_desc: [
		"&6Stone that sings when struck. You remember tuning it to your own voice.&r"
		"&eWhat:&r resonarium tools and armour: an upgrade over diamond that doesn't need netherite."
		"&eHow:&r smithing table: resonarium template + diamond tool or armour piece + resonarium plate."
		"&eTip:&r the rest of the set (axe, shovel, hoe, sword, helmet, leggings, boots) uses the same recipe."
	]
	quest.68B1341780D45FC8.title: "Warden Carapace"
	quest.68B1341780D45FC8.quest_subtitle: "The shell of the blind guardian"
	quest.68B1341780D45FC8.quest_desc: [
		"&eWhat:&r every Warden drops one to three carapace pieces (and its heart). The carapace is the core of reinforced echo shards."
		"&eHow:&r kill Wardens, or loot Ancient City chests and the Ancient Temple."
		"&eTip:&r one reinforced echo shard takes four carapace, four phantom membranes and an echo shard. Plan your Warden fights."
	]
	quest.66420E691B6216FC.title: "Ancient Compass"
	quest.66420E691B6216FC.quest_subtitle: "Optional: a needle that seeks the temple"
	quest.66420E691B6216FC.quest_desc: [
		"&eWhat:&r a compass wrapped in Warden carapace. In the Otherside it points toward the nearest Ancient Temple."
		"&eChemistry:&r an ordinary compass needle is magnetised iron or steel lining up with Earth's magnetic field."
		"&eHow:&r a compass with four Warden carapace around it."
	]
	quest.574FC3862F29AA23.title: "Warden Template"
	quest.574FC3862F29AA23.quest_subtitle: "The smithing pattern beyond netherite"
	quest.574FC3862F29AA23.quest_desc: [
		"&eWhat:&r the template that upgrades netherite gear to Warden gear."
		"&eHow:&r loot it from Ancient City chests (often) or the Ancient Temple's secret chest."
		"&eTip:&r copy it with 7 diamonds and a sculk block (makes 2)."
	]
	quest.71A31138E5B796F4.title: "Warden Tools"
	quest.71A31138E5B796F4.quest_subtitle: "Netherite, reinforced with echoes"
	quest.71A31138E5B796F4.quest_desc: [
		"&eWhat:&r the Otherside's best tools and weapons."
		"&eHow:&r smithing table: Warden template + netherite tool + reinforced echo shard (see Echoes of the Deep on the Other Worlds page)."
		"&eTip:&r echo shards also come from the Demigod Token shop (check JEI) if Ancient City chests run dry."
	]
	quest.49C18B6C77E30EB4.title: "Cover Me with Sculk"
	quest.49C18B6C77E30EB4.quest_subtitle: "Optional: the rest of the Warden armour"
	quest.49C18B6C77E30EB4.quest_desc: [
		"&6The guardian's shell, worn by the one it guarded against. You remember that joke.&r"
		"&eWhat:&r helmet, leggings and boots of Warden armour, to go with the chestplate."
		"&eHow:&r the same smithing recipe on netherite armour: one template and one reinforced echo shard per piece."
		"&eTip:&r that's three more Wardens' worth of carapace, at least."
	]
	quest.77ED1272F1E7A428.title: "Sculk Transmitter"
	quest.77ED1272F1E7A428.quest_subtitle: "Open a chest from far away"
	quest.77ED1272F1E7A428.quest_desc: [
		"&eWhat:&r a handheld sculk link. Link it to a container, and it opens that container from a distance."
		"&eHow:&r found in the Ancient Temple's secret chest. Use it on a chest to link it, then use it anywhere to open that chest."
		"&eTip:&r dye it to tell several apart; each colour is its own item."
	]
	quest.60C684E7570FFD31.title: "Soul Materials"
	quest.60C684E7570FFD31.quest_subtitle: "Dust, crystal and bone"
	quest.60C684E7570FFD31.quest_desc: [
		"&eWhat:&r the Otherside's crafting drops: soul dust (snappers, leeches), soul crystals (stalkers) and sculk bones (shattered)."
		"&eHow:&r hunt in the Otherside; the Ancient Temple's chests hold some of each too."
		"&eTip:&r the Monster Hunting page has quests for these mobs, so do both at once."
	]
	quest.1BB4B8B4CC1770EC.title: "Sonorous Staff"
	quest.1BB4B8B4CC1770EC.quest_subtitle: "Borrow the Warden's voice"
	quest.1BB4B8B4CC1770EC.quest_desc: [
		"&eWhat:&r a staff that charges and releases a sonic boom, the Warden's own attack."
		"&eChemistry:&r sound is a pressure wave: molecules bunch up and spread apart. A shock wave is a pressure jump so steep it travels faster than sound itself."
		"&eHow:&r a Heart of the Deep, two soul crystals and two sculk bones (check JEI). Repair it with soul crystals."
		"&eTip:&r the Volume and Reverberation enchantments raise its damage and range."
	]
	quest.6B352FFC0F1D2CC9.title: "Soundproof Glass"
	quest.6B352FFC0F1D2CC9.quest_subtitle: "Optional: glass the sculk can't hear through"
	quest.6B352FFC0F1D2CC9.quest_desc: [
		"&eWhat:&r glass that blocks vibrations, so sculk sensors (and Wardens) can't hear you through it."
		"&eChemistry:&r sound needs a medium. Damping materials turn the wave's energy into heat; a vacuum stops it completely."
		"&eHow:&r four soul dust around one glass makes two."
	]
	quest.646A8E1013D752E0.title: "Echo Trees"
	quest.646A8E1013D752E0.quest_subtitle: "Optional: wood from the echoing forest"
	quest.646A8E1013D752E0.quest_desc: [
		"&eWhat:&r pale echo trees grow on echo soil in the echoing forest. Their wood is found nowhere else."
		"&eChemistry:&r all wood is the same chemistry: cellulose fibres glued by lignin, an aromatic polymer that makes trees rigid."
		"&eHow:&r cut a few trees; leaves drop saplings."
	]
	quest.6122E89C29A24B28.title: "Blooming Caverns"
	quest.6122E89C29A24B28.quest_subtitle: "Optional: stems and berries from the caverns"
	quest.6122E89C29A24B28.quest_desc: [
		"&eWhat:&r the blooming caverns grow tall blooming stems (a second Otherside wood) and edible bloom berries."
		"&eHow:&r cut the stems and pick the berries in the blooming caverns."
		"&eTip:&r bloom berries are the easiest food to find down here."
	]
	quest.14A0BB33C07DFFB9.title: "Light in the Dark"
	quest.14A0BB33C07DFFB9.quest_subtitle: "Optional: gloomslate lights"
	quest.14A0BB33C07DFFB9.quest_desc: [
		"&eWhat:&r sculk gleam is the Otherside's glowing block; set in gloomslate it makes a tidy lamp."
		"&eChemistry:&r a glow stick makes cold light by chemiluminescence: hydrogen peroxide oxidises an oxalate ester, and the energy excites a dye that emits light."
		"&eHow:&r one sculk gleam with four gloomslate around it."
	]
	quest.0DB06BD8BCA91014.title: "Crystallized Amber"
	quest.0DB06BD8BCA91014.quest_subtitle: "Optional: something is trapped inside"
	quest.0DB06BD8BCA91014.quest_desc: [
		"&eWhat:&r amber blocks in the Otherside hold an item, or a live sculk leech. Break one to find out which."
		"&eChemistry:&r real amber is fossilised tree resin: terpenes that slowly polymerised over millions of years, sometimes around an insect."
		"&eHow:&r look in the Otherside's caves; the tooltip shows what's inside."
		"&eTip:&r a leech pops out when you break the block. Be ready."
	]
	quest.7811592DAB04EC9B.title: "Angler Fish"
	quest.7811592DAB04EC9B.quest_subtitle: "Optional: a fish with its own lamp"
	quest.7811592DAB04EC9B.quest_desc: [
		"&eWhat:&r the Otherside's waters hide angler fish, a good food once cooked."
		"&eChemistry:&r a real anglerfish's lure glows because of symbiotic bacteria living in it, which produce light by bioluminescence."
		"&eHow:&r catch or kill them in Otherside water, then smelt or campfire-cook."
	]
	quest.6CFF4538B44BB55A.title: "Leeches and Worms"
	quest.6CFF4538B44BB55A.quest_subtitle: "Optional: the smaller horrors"
	quest.6CFF4538B44BB55A.quest_desc: [
		"&eWhat:&r sculk leeches latch on in swarms; the shriek worm bursts from the ground."
		"&eHow:&r leeches hide in crystallized amber and in caves; shriek worms burst out of the Otherside's ground."
		"&eTip:&r a sweeping sword handles a leech swarm best."
	]
	quest.37A7AD6C2F962A4E.title: "Gloomsherds"
	quest.37A7AD6C2F962A4E.quest_subtitle: "Optional: pottery of the old city"
	quest.37A7AD6C2F962A4E.quest_desc: [
		"&eWhat:&r pottery sherds from the Otherside's makers. They decorate gloomslate pots, like vanilla sherds on decorated pots."
		"&eChemistry:&r firing clay drives out water and partly melts its silicates into glass, which is why fired pottery survives for millennia."
		"&eHow:&r collect any three. Amber blocks and the strange pots of the Otherside carry them."
	]
	quest.16954838A76C1F73.title: "That Pot Moved"
	quest.16954838A76C1F73.quest_subtitle: "Secret: not every pot is a pot"
	quest.16954838A76C1F73.quest_desc: [
		"&eWhat:&r some pots in the Otherside are alive: anger, sorrow and fear pots. You broke an angry one."
		"&eTip:&r they drop gloomsherds, so a living pot is worth chasing."
	]
	quest.3FF906041B74EDD8.title: "Grime Bricks"
	quest.3FF906041B74EDD8.quest_subtitle: "Optional: bricks fired from sculk grime"
	quest.3FF906041B74EDD8.quest_desc: [
		"&eWhat:&r grime balls fire into grime bricks, a building block made from the Otherside's mud."
		"&eChemistry:&r brick-making is old chemistry: heating clay above about 900 °C sinters its particles together into a hard ceramic."
		"&eHow:&r smelt grime balls (Ancient Temple chests hold them). Four grime balls also make a block of sculk grime."
	]
	quest.35E65938210C21EF.title: "Sculk Gleam"
	quest.35E65938210C21EF.quest_subtitle: "Optional: the Otherside's own lamps"
	quest.35E65938210C21EF.quest_desc: [
		"&eWhat:&r glowing sculk growths that light the deeplands and the echoing forest."
		"&eChemistry:&r a glow can be fluorescence (light given back at once, like a highlighter under UV) or phosphorescence (stored and released slowly, like glow-in-the-dark paint, often strontium aluminate)."
		"&eHow:&r mine sculk gleam where it grows in the deeplands and echoing forest."
		"&eTip:&r it's the core of the gloomslate light in the next quest."
	]
	quest.32856C975EB7A004.title: "Living Ground"
	quest.32856C975EB7A004.quest_subtitle: "Optional: echo soil and blooming moss"
	quest.32856C975EB7A004.quest_desc: [
		"&eWhat:&r the two soils of the Otherside: echo soil under the echoing forest's trees, blooming moss across the blooming caverns."
		"&eChemistry:&r real soil is about half mineral grains, a quarter water and a quarter air, plus a few percent organic matter that holds most of its nutrients."
		"&eHow:&r dig them up in the echoing forest and the blooming caverns."
		"&eTip:&r echo trees grow on echo soil; bring some home with your saplings."
	]
	quest.2637712205B68034.title: "Otherside Flora"
	quest.2637712205B68034.quest_subtitle: "Optional: roots, vines, tendrils and a cactus"
	quest.2637712205B68034.quest_desc: [
		"&eWhat:&r the plants of each region: glowing roots in the blooming caverns, sculk vines and tendrils in the deeplands and echoing forest, gloomy cacti in the overcast columns."
		"&eChemistry:&r real cacti save water with CAM photosynthesis: they open their pores only at night, store CO₂ as malic acid, and use it by day with their pores shut."
		"&eHow:&r visit the four Otherside regions and collect each plant."
		"&eTip:&r the overcast columns are the gloomslate region; the cacti grow among its gloomy sculk."
	]
	quest.698F574DC57BB03E.title: "Grime Balls"
	quest.698F574DC57BB03E.quest_subtitle: "Optional: mud from the sculk patches"
	quest.698F574DC57BB03E.quest_desc: [
		"&eWhat:&r sculk grime is a muddy block that forms in the Otherside's sculk patches. Mined without Silk Touch, it breaks into 2 to 4 grime balls."
		"&eChemistry:&r mud is mostly clay minerals: sheets of aluminium silicate so thin they slide over each other when wet, which is why clay can be shaped."
		"&eHow:&r mine sculk grime where sculk spreads; Ancient Temple chests hold grime balls too."
		"&eTip:&r the grime bricks in the next quest are smelted from these."
	]
	chapter.5B56830817DF1227.title: "Metals of Legend"
	chapter.5B56830817DF1227.chapter_subtitle: [
		"Allthemodium, vibranium and unobtainium: metals no fire can win."
		"A pad of steel and pearl opens three more worlds."
	]
	quest.1473F22A71605FE2.title: "Allthemodium"
	quest.1473F22A71605FE2.quest_subtitle: "Yellow seams on the ceiling of the Deep Dark"
	quest.1473F22A71605FE2.quest_desc: [
		"&6There were metals you once named yourself. One of them is waiting under the sculk.&r"
		"&eWhat:&r the first of three legendary metals. It only grows in the Deep Dark biome, below Y 10, on cave ceilings (plain and deepslate ore)."
		"&eHow:&r a netherite pickaxe or better. Look up, not down. Sneak: the Deep Dark has shriekers and a Warden."
		"&eTip:&r these ores must be mined by hand. A quarry, miner or other machine that breaks one destroys it and gets nothing. Ultimine is fine."
	]
	quest.148A9565625B6739.title: "Reduce It"
	quest.148A9565625B6739.quest_subtitle: "Coke and a cupronickel EBF"
	quest.148A9565625B6739.quest_desc: [
		"&eWhat:&r allthemodium won't melt in any furnace. Raw ore or dust has to be reduced in the Electric Blast Furnace."
		"&eChemistry:&r carbothermic reduction, MO + C → M + CO: carbon pulls the oxygen off the metal. It's how iron, and MI's silicon, are made."
		"&eHow:&r EBF with cupronickel coils, 32 EU/t: 1 raw allthemodium (or dust) + 1 coke dust → 1 ingot."
	]
	quest.32482055FF266858.title: "Five from One"
	quest.32482055FF266858.quest_subtitle: "Optional: the acid chain works here too"
	quest.32482055FF266858.quest_desc: [
		"&eWhat:&r the mod comes with full Mekanism processing: oxygen 3x, hydrogen chloride 4x, sulfuric acid 5x, like every other ore."
		"&eChemistry:&r sulfuric acid dissolves the ore into a slurry, water washes it, and crystals grow out as the solution concentrates."
		"&eHow:&r Dissolution Chamber → Washer → Crystallizer → Injection → Purification → Crusher → Enrichment, then reduce the dust in the EBF."
		"&eTip:&r without Fortune, silk-touch the ore: an ore block gives 5 crystals, a raw ore 3⅓. With Fortune III, mine it normally."
	]
	quest.6328B8D727DD60F8.title: "The Teleport Pad"
	quest.6328B8D727DD60F8.quest_subtitle: "Steel, a pearl and a circuit"
	quest.6328B8D727DD60F8.quest_desc: [
		"&eWhat:&r one block that links two worlds. Placed in the Overworld it leads to the Mining dimension, in the Nether to The Other, in the End to The Beyond."
		"&eHow:&r an ender pearl, 4 allthemodium nuggets, 4 MI steel plates and an analog circuit (check JEI)."
		"&eTip:&r stand on it, empty both hands and sneak + right-click. A return pad appears on the far side; it doesn't drop if broken, so leave it."
	]
	quest.7F4AB720B256F910.title: "The Mining Dimension"
	quest.7F4AB720B256F910.quest_subtitle: "A flat world made of ore"
	quest.7F4AB720B256F910.quest_desc: [
		"&6You built a world once just to dig in it. You kept the key.&r"
		"&eWhat:&r a flat world in layers: grass and stone on top, deepslate from Y 128 down to 65, netherrack to Y 1, end stone, bedrock. The layers are packed with ore."
		"&eHow:&r place a Teleport Pad in the Overworld and use it. Iron, emerald, diamond, gold and redstone are far richer here than at home, and ancient debris sits in the netherrack."
		"&eTip:&r allthemodium grows here too (about one vein per chunk, in the deepslate layer). It is still hand-mined only. Light your tunnels: mobs spawn in the dark."
	]
	quest.1D4517BF727CDF3A.title: "Rich Seams"
	quest.1D4517BF727CDF3A.quest_subtitle: "Optional: debris in the netherrack layer"
	quest.1D4517BF727CDF3A.quest_desc: [
		"&eWhat:&r the Mining dimension's netherrack layer (Y 1 to 64) carries veins of ancient debris."
		"&eHow:&r strip-mine the netherrack layer. A Mekanism or MI tool with a wide area helps."
		"&eTip:&r every netherite pick and armour piece is an allthemodium upgrade waiting to happen."
	]
	quest.5E5769AD5749CA25.title: "Brush the City"
	quest.5E5769AD5749CA25.quest_subtitle: "Archaeology in the Ancient City"
	quest.5E5769AD5749CA25.quest_desc: [
		"&eWhat:&r the smithing template that upgrades netherite gear to allthemodium."
		"&eHow:&r Ancient Cities hide Suspicious Clay where polished basalt would be. Brush it (vanilla brush) for the template."
		"&eTip:&r copy it before you use it: template + 7 netherite ingots + deepslate makes 2."
	]
	quest.7FADA5DEE250D019.title: "Allthemodium Pickaxe"
	quest.7FADA5DEE250D019.quest_subtitle: "The pick that breaks vibranium"
	quest.7FADA5DEE250D019.quest_desc: [
		"&eWhat:&r the next rung of the ladder: netherite pick → allthemodium ore, allthemodium pick → vibranium ore."
		"&eHow:&r smithing table: allthemodium template + netherite pickaxe + allthemodium ingot. Enchantments carry over."
	]
	quest.3171C01B77F60495.title: "Allthemodium Armour"
	quest.3171C01B77F60495.quest_subtitle: "Four netherite pieces, four templates"
	quest.3171C01B77F60495.quest_desc: [
		"&eWhat:&r the boots cancel fall damage, the helmet refills your air underwater, the chestplate halves magic damage, and the set puts out fire on you."
		"&eHow:&r smithing table, one template and one allthemodium ingot per netherite piece."
		"&eTip:&r no flight here. Your wings still come from chemistry."
	]
	quest.7325BE414B354045.title: "The Other"
	quest.7325BE414B354045.quest_subtitle: "A pad in the Nether leads somewhere older"
	quest.7325BE414B354045.quest_desc: [
		"&6A world of endless night, with your old trees still standing. You remember planting them.&r"
		"&eWhat:&r a dark, Nether-like realm of soul sand valleys, deserts and crimson and warped forests, with ancient, demonic and soul trees. Allthemodium and vibranium ores grow here."
		"&eHow:&r place a Teleport Pad in the Nether and use it."
		"&eTip:&r blocks inside The Other's structures can't be broken. Explore them; don't tunnel through them."
	]
	quest.72F0259C95DA1271.title: "The Ancient Pyramid"
	quest.72F0259C95DA1271.quest_subtitle: "In the soul sand valleys"
	quest.72F0259C95DA1271.quest_desc: [
		"&eWhat:&r the pyramids of the soul sand valleys hold loot rooms and treasure chests (allthemodium and vibranium nuggets among them) and the Piglich."
		"&eHow:&r an Explorer's Compass or a long walk through soul sand. Click once you're inside."
		"&eTip:&r bring fire resistance; the soul sand valleys of The Other are no kinder than the Nether's."
	]
	quest.55ECEE8AE20E2CE4.title: "Piglich Hearts"
	quest.55ECEE8AE20E2CE4.quest_subtitle: "The pyramid's undead lord"
	quest.55ECEE8AE20E2CE4.quest_desc: [
		"&eWhat:&r the Piglich spawns inside the Ancient Pyramid and drops one heart. Every alloy in this chapter needs one."
		"&eHow:&r fight it in the pyramid; it keeps spawning inside the structure."
		"&eTip:&r a Hostile Neural Networks data model for the Piglich farms hearts once you have the Simulation Chamber."
	]
	quest.1C06831A38BD73E3.title: "The Dungeon"
	quest.1C06831A38BD73E3.quest_subtitle: "In the warped forests"
	quest.1C06831A38BD73E3.quest_desc: [
		"&eWhat:&r a sprawling dungeon of halls, a forge, a treasure room and a library. The library's chest holds the unobtainium template."
		"&eHow:&r search The Other's warped forests. Click once you're inside."
		"&eTip:&r Apotheosis bosses spawn in The Other. Gear up before you go deep."
	]
	quest.11C5F76536F38D43.title: "Vibranium"
	quest.11C5F76536F38D43.quest_subtitle: "Hanging from the Nether's ceilings"
	quest.11C5F76536F38D43.quest_desc: [
		"&eWhat:&r the second legendary metal. It grows on cave ceilings in the Nether, from Y 64 up to the roof, and in The Other."
		"&eHow:&r an allthemodium pickaxe or better. Hand-mined only, like allthemodium."
		"&eTip:&r fly along the Nether ceiling with a light source; the ore shows up against the netherrack."
	]
	quest.58CDB46235307897.title: "The Kroll Route"
	quest.58CDB46235307897.quest_subtitle: "Chlorine, magnesium, argon, kanthal"
	quest.58CDB46235307897.quest_desc: [
		"&eWhat:&r vibranium is refined like titanium and zirconium: through its chloride, never by melting the ore."
		"&eChemistry:&r the Kroll process: MO₂ + 2Cl₂ + 2C → MCl₄ + 2CO, then MCl₄ + 2Mg → M + 2MgCl₂, under argon because the hot metal steals oxygen and nitrogen from air."
		"&eHow:&r EBF with kanthal coils, 128 EU/t: raw vibranium (or dust) + coke dust + 2 magnesium dust + 500 mB chlorine + 50 mB argon → 1 ingot + 2 magnesium chloride dust."
		"&eTip:&r the Alchemistry Compactor turns magnesium elements into magnesium dust. Keep the MgCl₂: the Dissolver splits it back into Mg and Cl."
	]
	quest.391BA35508956395.title: "Brush the Bastion"
	quest.391BA35508956395.quest_subtitle: "Archaeology in a treasure room"
	quest.391BA35508956395.quest_desc: [
		"&eWhat:&r the template that upgrades allthemodium gear to vibranium."
		"&eHow:&r the treasure-room variant of a Bastion Remnant hides Suspicious Soul Sand among its blackstone. Brush it."
		"&eTip:&r copy it: template + 7 allthemodium ingots + ancient stone (from The Other) makes 2."
	]
	quest.5EF91D72548DE6BC.title: "Vibranium Pickaxe"
	quest.5EF91D72548DE6BC.quest_subtitle: "The pick that breaks unobtainium"
	quest.5EF91D72548DE6BC.quest_desc: [
		"&eWhat:&r the only kind of pick (besides unobtainium) that can mine unobtainium ore."
		"&eHow:&r smithing table: vibranium template + allthemodium pickaxe + vibranium ingot."
	]
	quest.150C76053DA40504.title: "Vibranium Armour"
	quest.150C76053DA40504.quest_subtitle: "A full vibranium set"
	quest.150C76053DA40504.quest_desc: [
		"&eWhat:&r the same perks as allthemodium armour, and the chestplate cuts magic damage to a quarter."
		"&eHow:&r one vibranium template and ingot per allthemodium piece."
	]
	quest.190762EAFF8AD47D.title: "Vibranium-Allthemodium Alloy"
	quest.190762EAFF8AD47D.quest_subtitle: "Powder metallurgy, with a heart in it"
	quest.190762EAFF8AD47D.quest_desc: [
		"&6Two metals that refuse each other. You remember how to make them agree.&r"
		"&eWhat:&r the first of the three legendary alloys."
		"&eChemistry:&r refractory alloys melt too hot for any crucible, so industry blends the metal powders and consolidates them by sintering or arc-melting under argon."
		"&eHow:&r Mixer: allthemodium dust + vibranium dust + Piglich Heart → 2 alloy dust. EBF (kanthal, 128 EU/t): 1 alloy dust + 100 mB argon → 1 ingot."
		"&eTip:&r crush ingots to dust in the Mekanism Crusher."
	]
	quest.314CCC5282A02269.title: "Unobtainium"
	quest.314CCC5282A02269.quest_subtitle: "On the floors of the End highlands"
	quest.314CCC5282A02269.quest_desc: [
		"&eWhat:&r the last legendary metal, found only in the End highlands (the outer islands), on solid floors."
		"&eHow:&r a vibranium pickaxe or better, by hand. It's rarer than the others: about three tries per chunk."
		"&eTip:&r a Teleport Pad placed in the End also opens The Beyond, a quiet empty world to build in."
	]
	quest.7857FF3F88FECDC1.title: "The Fluoride Route"
	quest.7857FF3F88FECDC1.quest_subtitle: "Hydrofluoric acid and molten sodium"
	quest.7857FF3F88FECDC1.quest_desc: [
		"&eWhat:&r unobtainium is refined like tantalum, the metal of capacitors and surgical implants."
		"&eChemistry:&r HF digests the ore into a fluoride complex (K₂TaF₇ for tantalum), and molten sodium reduces it: K₂TaF₇ + 5Na → Ta + 2KF + 5NaF."
		"&eHow:&r EBF (kanthal, 128 EU/t, 40 s): raw unobtainium (or dust) + 2 sodium dust + 250 mB hydrofluoric acid + 100 mB argon → 1 ingot."
		"&eTip:&r HF eats glass and bone. In game it just needs Mekanism tanks; in a real lab it needs calcium gluconate on the bench."
	]
	quest.637155B176290CED.title: "The Library Chest"
	quest.637155B176290CED.quest_subtitle: "Hidden in The Other's dungeon"
	quest.637155B176290CED.quest_desc: [
		"&eWhat:&r the template that upgrades vibranium gear to unobtainium."
		"&eHow:&r loot the chest in the dungeon's library room."
		"&eTip:&r copy it: template + 7 vibranium ingots + end stone makes 2."
	]
	quest.46DA2E17B992C9EC.title: "Unobtainium Gear"
	quest.46DA2E17B992C9EC.quest_subtitle: "The top of the ladder"
	quest.46DA2E17B992C9EC.quest_desc: [
		"&eWhat:&r the unobtainium pick mines everything here, including ancient stone bricks and the alloy blocks. The chestplate cuts magic damage to a tenth."
		"&eHow:&r smithing table: unobtainium template + vibranium piece + unobtainium ingot."
	]
	quest.758670EFED31C601.title: "Forged in Annihilation"
	quest.758670EFED31C601.quest_subtitle: "Antimatter is the only heat left"
	quest.758670EFED31C601.quest_desc: [
		"&6Matter meets its mirror and both are gone, and the metals finally yield. You remember this fire. It was yours.&r"
		"&eWhat:&r the two unobtainium alloys, the rarest materials in the pack."
		"&eChemistry:&r antimatter turns its whole mass into energy (E = mc²): one gram meeting one gram of matter releases about 1.8 × 10¹⁴ J, some 43 kilotons of TNT."
		"&eHow:&r Mixer: unobtainium dust + vibranium or allthemodium dust + Piglich Heart → 2 alloy dust. EBF (128 EU/t): 8 alloy dust + 1 antimatter pellet + 1000 mB argon → 8 ingots."
		"&eTip:&r one pellet fuses a whole batch of eight. Make the dust first, then spend the antimatter."
	]
	quest.59FAB24F74C3B377.title: "The Beyond"
	quest.59FAB24F74C3B377.quest_subtitle: "Optional: an empty world past the End"
	quest.59FAB24F74C3B377.quest_desc: [
		"&eWhat:&r a blank world with no features at all: a clean canvas for a demigod's building project."
		"&eHow:&r place a Teleport Pad in the End and use it."
		"&eTip:&r nothing spawns there to bother your builds, and nothing there needs mining. Bring your own blocks."
	]
	chapter.52D4F58B0C6E5EBB.title: "Space"
	chapter.52D4F58B0C6E5EBB.chapter_subtitle: [
		"The Moon, the planets and the air you bring with you."
	]
	quest.742D7993CB0086CB.title: "Desh on the Moon"
	quest.742D7993CB0086CB.quest_subtitle: "The Moon's metal builds the next rocket"
	quest.742D7993CB0086CB.quest_desc: [
		"&6You remember the Moon from above. Now you're standing on it.&r"
		"&eWhat:&r desh ore is found only on the Moon. Desh blocks, engines and tanks build the Tier 2 rocket."
		"&eChemistry:&r the Moon has no atmosphere and its days swing from about +120 °C to −170 °C, so bring oxygen."
		"&eHow:&r mine desh ore on the Moon with an iron pickaxe or better (this pack sets its tier) and process it like any ore."
	]
	quest.635A241489681170.title: "Mars"
	quest.635A241489681170.quest_subtitle: "The red planet"
	quest.635A241489681170.quest_desc: [
		"&eWhat:&r Mars holds ostrum ore, the metal for the Tier 3 rocket."
		"&eChemistry:&r Mars is red because its dust is rich in iron(III) oxide, Fe₂O₃: rust. Its thin air is about 95% CO₂."
		"&eHow:&r build the Tier 2 rocket from desh at the NASA Workbench, fuel it with diesel and launch."
	]
	quest.1751F7DCDA2801ED.title: "Ostrum"
	quest.1751F7DCDA2801ED.quest_subtitle: "Mars's metal for the Tier 3 rocket"
	quest.1751F7DCDA2801ED.quest_desc: [
		"&eWhat:&r ostrum ore is found only on Mars. It builds the Tier 3 rocket."
		"&eHow:&r mine ostrum ore on Mars and process it. It needs a diamond pickaxe or better (this pack sets its tier)."
		"&eTip:&r grab some extra for the Tier 3 rocket's engine and tank."
	]
	quest.7E7B71100CC2752B.title: "Heat Shielding"
	quest.7E7B71100CC2752B.quest_subtitle: "A suit that survives 464 °C"
	quest.7E7B71100CC2752B.quest_desc: [
		"&eWhat:&r Venus and Mercury are hot enough to kill in a normal space suit. The netherite space suit handles the heat."
		"&eHow:&r check JEI for the netherite suit pieces. Fill it with oxygen at the Oxygen Loader."
		"&eTip:&r the jet suit (later, check JEI) also handles the heat, and flies."
	]
	quest.0371D774272DB515.title: "Venus"
	quest.0371D774272DB515.quest_subtitle: "Acid clouds and crushing pressure"
	quest.0371D774272DB515.quest_desc: [
		"&eWhat:&r Venus holds calorite ore, the metal for the Tier 4 rocket."
		"&eChemistry:&r its atmosphere is about 96% CO₂ at roughly 92 times Earth's pressure, under clouds of sulfuric acid (H₂SO₄). A runaway greenhouse keeps it near 464 °C."
		"&eHow:&r Tier 3 rocket from ostrum, plus your netherite space suit."
	]
	quest.31F2D0605D2E5028.title: "Calorite"
	quest.31F2D0605D2E5028.quest_subtitle: "Venus's metal for the Tier 4 rocket"
	quest.31F2D0605D2E5028.quest_desc: [
		"&eWhat:&r calorite ore is found on Venus. It builds the Tier 4 rocket, the only one that reaches another star."
		"&eHow:&r mine calorite ore in the Venusian stone and process it like any ore. Only a netherite pickaxe (or better) can mine it in this pack."
		"&eTip:&r Venus is hot and its rain is acid; keep the netherite suit on the whole time."
	]
	quest.1CA5613802C3B7C6.title: "Alien Metals"
	quest.1CA5613802C3B7C6.quest_subtitle: "Desh, ostrum and calorite"
	quest.1CA5613802C3B7C6.quest_desc: [
		"&eWhat:&r one metal from each world: desh (Moon), ostrum (Mars) and calorite (Venus). Each builds the next rocket tier."
		"&eHow:&r process the raw ores; MI and Mekanism ore lines work on them too (check JEI)."
		"&eTip:&r the Dissolver can tell you what these metals break down into."
	]
	quest.537431DD08EA991F.title: "Glacio"
	quest.537431DD08EA991F.quest_subtitle: "A frozen world around another star"
	quest.537431DD08EA991F.quest_desc: [
		"&6You remember stars that were yours to name. This one you'll have to visit first.&r"
		"&eWhat:&r Glacio orbits Proxima Centauri, the nearest star to the Sun, about 4.2 light-years away. Unlike the others, it has breathable air."
		"&eHow:&r build the Tier 4 rocket from calorite and launch."
	]
	quest.129266E51D79A231.title: "A Spare Breath"
	quest.129266E51D79A231.quest_subtitle: "Carry oxygen to top up your suit"
	quest.129266E51D79A231.quest_desc: [
		"&eWhat:&r a gas tank holds oxygen you can carry, to refill the suit far from your Oxygen Loader."
		"&eChemistry:&r a resting adult breathes in roughly 550 litres of O₂ a day; your suit's tank is all that stands between you and vacuum."
		"&eHow:&r iron plates and an iron rod (check JEI). Fill it in the Oxygen Loader like the suit."
		"&eTip:&r the large gas tank holds much more and is a part in later machines."
	]
	quest.18FD507A01896D7C.title: "The Oxygen Can"
	quest.18FD507A01896D7C.quest_subtitle: "Giselle Addon: oxygen for everything you wear"
	quest.18FD507A01896D7C.quest_desc: [
		"&eWhat:&r the Giselle Addon's oxygen can stores oxygen and tops up the oxygen gear you're carrying."
		"&eHow:&r iron plates around an iron rod (check JEI). Fill it with oxygen like a tank."
		"&eTip:&r the addon also links Ad Astra to Mekanism and other mods; search its name in JEI to see what else it adds."
	]
	quest.0304AF411C0ADEBE.title: "Breathable Bases"
	quest.0304AF411C0ADEBE.quest_subtitle: "Optional: fill a sealed room with air"
	quest.0304AF411C0ADEBE.quest_desc: [
		"&eWhat:&r the Oxygen Distributor fills a sealed room with breathable air, so you can work without a helmet."
		"&eChemistry:&r it makes oxygen from water with FE, the same idea as your Electrolytic Separator: 2H₂O → 2H₂ + O₂."
		"&eHow:&r check JEI. Seal the room completely; any gap stops it working."
	]
	quest.404C175EA043B30A.title: "Is There Air?"
	quest.404C175EA043B30A.quest_subtitle: "Optional: a redstone check for oxygen"
	quest.404C175EA043B30A.quest_desc: [
		"&eWhat:&r the Oxygen Sensor gives a redstone signal depending on whether the space around it has oxygen."
		"&eHow:&r check JEI for the recipe, place it inside your sealed base and wire it to a lamp or alarm."
		"&eTip:&r a light that goes out when the air does is the cheapest life support alarm there is."
	]
	quest.6C46189D0E479A97.title: "Water for Oxygen"
	quest.6C46189D0E479A97.quest_subtitle: "Optional: feed your electrolysis off-world"
	quest.6C46189D0E479A97.quest_desc: [
		"&eWhat:&r Ad Astra's powered water pump feeds water into your pipes, so a base on the Moon can make its own oxygen."
		"&eChemistry:&r electrolysis splits water: 2H₂O → 2H₂ + O₂. Every 2 molecules of water give 1 of oxygen and 2 of hydrogen, which you can burn or store."
		"&eHow:&r steel and desh plates, a gas tank and a hopper (check JEI). Pipe its water into a Mekanism Electrolytic Separator and the O₂ into an Oxygen Loader."
		"&eTip:&r Ad Astra's ice shards are frozen water; the Moon and Mars both have ice shard ore."
	]
	quest.07797DB5628E9DBE.title: "Netherite Oxygen Can"
	quest.07797DB5628E9DBE.quest_subtitle: "Optional: a bigger can for the hot worlds"
	quest.07797DB5628E9DBE.quest_desc: [
		"&eWhat:&r the upgraded oxygen can holds much more oxygen than the iron one."
		"&eHow:&r an oxygen can, a netherite ingot and ostrum plates in the crafting grid (check JEI). Its oxygen carries over."
		"&eTip:&r on Venus every trip back to base costs time; carry more air instead."
	]
	quest.19BBF6AF16FB7E15.title: "An Automated Launch Site"
	quest.19BBF6AF16FB7E15.quest_subtitle: "Optional: Giselle Addon fuelling and sensing"
	quest.19BBF6AF16FB7E15.quest_desc: [
		"&eWhat:&r the Fuel Loader takes piped fuel and fills any rocket or rover within a few blocks; the Rocket Sensor reports a nearby rocket's state to a comparator."
		"&eHow:&r both are steel ingots and iron plates around a bucket or an observer (check JEI). Pipe diesel into the loader."
		"&eTip:&r no more filling rockets by hand from buckets."
	]
	quest.62B2455C3CD4B583.title: "Earth Gravity"
	quest.62B2455C3CD4B583.quest_subtitle: "Optional: normal gravity indoors"
	quest.62B2455C3CD4B583.quest_desc: [
		"&eWhat:&r the Gravity Normalizer gives an area Earth-like gravity, so your jumps behave in your Moon base."
		"&eChemistry:&r the Moon's gravity is about 1/6 of Earth's, Mars about 3/8; you weigh less because they have less mass."
		"&eHow:&r etrionic capacitors, a diamond block and desh plates (check JEI)."
	]
	quest.25DDA7F730F46AFC.title: "The Rover"
	quest.25DDA7F730F46AFC.quest_subtitle: "Optional: drive across the Moon"
	quest.25DDA7F730F46AFC.quest_desc: [
		"&eWhat:&r a fuelled buggy for crossing big, airless plains quickly."
		"&eHow:&r desh engine, desh blocks and plates, a large gas tank, a radio and wheels (check JEI). Fuel it with diesel."
		"&eTip:&r low gravity makes it bounce; slow down on hills."
	]
	quest.40442645A8B5A09C.title: "The Moon Is Cheese"
	quest.40442645A8B5A09C.quest_subtitle: "Optional: the old joke is true here"
	quest.40442645A8B5A09C.quest_desc: [
		"&eWhat:&r Ad Astra hides cheese ore on the Moon."
		"&eChemistry:&r the real Moon is mostly silicate rock: oxygen, silicon, magnesium, iron, calcium and aluminum."
		"&eHow:&r mine moon cheese ore. Eat responsibly."
	]
	quest.3B5922B2AEA252B7.title: "Lunarians"
	quest.3B5922B2AEA252B7.quest_subtitle: "Optional: villagers on the Moon"
	quest.3B5922B2AEA252B7.quest_desc: [
		"&eWhat:&r Lunarians are the Moon's villagers. Their villages stand on the lunar wastelands, with towers nearby."
		"&eHow:&r explore the Moon until you find one, then walk into it. They trade like villagers."
		"&eTip:&r the Explorer's Compass works on other planets too."
	]
	quest.134D3F3BADF7D9BF.title: "Moon Dungeon"
	quest.134D3F3BADF7D9BF.quest_subtitle: "Optional: something built under the Moon"
	quest.134D3F3BADF7D9BF.quest_desc: [
		"&eWhat:&r a dungeon hidden under the lunar wastelands, with loot and hostile guards."
		"&eHow:&r the Explorer's Compass can find one. Step inside."
		"&eTip:&r bring a spare gas tank: dungeons take longer than you think."
	]
	quest.12A113F5FF1A0758.title: "Temples of Mars"
	quest.12A113F5FF1A0758.quest_subtitle: "Optional: ruins in the red canyons"
	quest.12A113F5FF1A0758.quest_desc: [
		"&eWhat:&r temples stand in the Martian wastelands and canyon creeks."
		"&eChemistry:&r Mars's canyons were carved by liquid water long ago; today its low pressure makes surface water boil or freeze almost at once."
		"&eHow:&r visit a canyon creek and find a temple (the Explorer's Compass helps)."
	]
	quest.36C2163D475D5DD0.title: "The Polar Caps"
	quest.36C2163D475D5DD0.quest_subtitle: "Optional: ice at the ends of Mars"
	quest.36C2163D475D5DD0.quest_desc: [
		"&eWhat:&r Mars's polar caps are frozen; ice shard ore gives ice shards."
		"&eChemistry:&r the real caps are water ice with a seasonal layer of dry ice (solid CO₂), which turns straight to gas in spring (sublimation)."
		"&eHow:&r visit the polar caps biome and mine ice shard ore (it's on the Moon too)."
	]
	quest.5E6BCCAA71BB14F4.title: "The Pygros"
	quest.5E6BCCAA71BB14F4.quest_subtitle: "Optional: Venus has inhabitants"
	quest.5E6BCCAA71BB14F4.quest_desc: [
		"&eWhat:&r Pygros are piglin-like natives of Venus. Their villages and towers stand in the Venus wastelands."
		"&eHow:&r find a village (the Explorer's Compass helps) and step inside. Wear gold, just in case."
		"&eTip:&r Pygro brutes guard the towers; they hit hard."
	]
	quest.0CCDB1D0755282C7.title: "Infernal Barrens"
	quest.0CCDB1D0755282C7.quest_subtitle: "Optional: Venus at its worst"
	quest.0CCDB1D0755282C7.quest_desc: [
		"&eWhat:&r the harshest of the Venusian biomes."
		"&eChemistry:&r Venus is hotter than Mercury despite being twice as far from the Sun: its thick CO₂ atmosphere traps heat."
		"&eHow:&r visit it in the netherite space suit. Fire resistance helps."
	]
	quest.72A1114536C4C6FA.title: "Mercury"
	quest.72A1114536C4C6FA.quest_subtitle: "Optional: the planet closest to the Sun"
	quest.72A1114536C4C6FA.quest_desc: [
		"&eWhat:&r a scorched, airless world reachable with the Tier 3 rocket."
		"&eChemistry:&r with almost no atmosphere, Mercury can't hold heat: about 430 °C by day and −180 °C at night."
		"&eHow:&r Tier 3 rocket plus the netherite space suit."
	]
	quest.706C2B3D42BFE9DD.title: "Mercury Deltas"
	quest.706C2B3D42BFE9DD.quest_subtitle: "Optional: walk the deltas"
	quest.706C2B3D42BFE9DD.quest_desc: [
		"&eWhat:&r Mercury's deltas, a dark landscape of scorched stone."
		"&eChemistry:&r despite the name, the planet has no mercury metal; the element was named after the same god for its quick, flowing liquid."
		"&eHow:&r land on Mercury and walk into the deltas."
	]
	quest.407A51A230482666.title: "Peaks of Glacio"
	quest.407A51A230482666.quest_subtitle: "Optional: walk another star's world"
	quest.407A51A230482666.quest_desc: [
		"&6Air you didn't bring, under a sun that isn't yours. You remember this feeling: arriving.&r"
		"&eWhat:&r Glacio's frozen peaks and snowy barrens, with its own trees and woolly rams."
		"&eHow:&r visit both biomes. You can take your helmet off here."
		"&eTip:&r Glacio has ordinary ores too (coal, iron, copper, lapis) in its own stone."
	]
	quest.482F2CC86AEE5F02.title: "In Orbit"
	quest.482F2CC86AEE5F02.quest_subtitle: "Optional: stop above the Moon and Mars"
	quest.482F2CC86AEE5F02.quest_desc: [
		"&eWhat:&r every planet has an orbit dimension above it, where space stations are built."
		"&eChemistry:&r in orbit you're falling around the planet all the time, which is why everything floats."
		"&eHow:&r choose the orbit on the rocket's planet screen instead of the surface."
	]
	chapter.1C4BA472D45EB848.title: "Monster Hunting"
	chapter.1C4BA472D45EB848.chapter_subtitle: [
		"Every monster is just chemistry with bad manners."
	]
	quest.544849C91E73A547.title: "Zombie Hunter"
	quest.544849C91E73A547.quest_subtitle: "Kill 25 zombies"
	quest.544849C91E73A547.quest_desc: [
		"&6You remember when the dead stayed down out of respect. Time to remind them.&r"
		"&eWhat:&r the first line of the hunting page. Each tier asks for more of the same mob and pays out a Hunter's Bounty."
		"&eHow:&r zombies spawn in the dark and at night everywhere. A sword and shield are all you need."
		"&eTip:&r zombies burn in daylight; fight at dawn and let the sun help."
	]
	quest.3A8571E358829A4E.title: "Zombie Slayer"
	quest.3A8571E358829A4E.quest_subtitle: "Optional: kill 100 zombies"
	quest.3A8571E358829A4E.quest_desc: [
		"&eWhat:&r a hundred zombies. You'll get there just by playing at night."
		"&eChemistry:&r rotten flesh really is rotten: bacteria break proteins into amines like putrescine and cadaverine, which is where the smell comes from."
		"&eTip:&r a simple dark room over a spawner (YUNG's dungeons have plenty) speeds this up."
	]
	quest.07FFFFC27D98A06B.title: "Bane of the Dead"
	quest.07FFFFC27D98A06B.quest_subtitle: "Optional: kill 500 zombies"
	quest.07FFFFC27D98A06B.quest_desc: [
		"&eWhat:&r five hundred. This one is for people who build mob farms."
		"&eHow:&r a zombie spawner trap with a killing floor, or a Smite sword and a lot of nights."
		"&eTip:&r Smite adds damage against all undead: zombies, skeletons, wither skeletons, phantoms and the Wither."
	]
	quest.07F520C4C9DCA26D.title: "Bone Collector"
	quest.07F520C4C9DCA26D.quest_subtitle: "Kill 25 skeletons"
	quest.07F520C4C9DCA26D.quest_desc: [
		"&eWhat:&r skeletons drop bones and arrows, and sometimes their bow."
		"&eChemistry:&r bone meal is crushed bone: calcium phosphate, a real phosphorus fertiliser for plants."
		"&eHow:&r raise your shield when they draw, then close in between shots."
		"&eTip:&r strafing sideways makes skeletons miss most of their arrows."
	]
	quest.3768FF31E575A11C.title: "Skeleton Slayer"
	quest.3768FF31E575A11C.quest_subtitle: "Optional: kill 100 skeletons"
	quest.3768FF31E575A11C.quest_desc: [
		"&eWhat:&r a hundred skeletons, and a full stack of bones for bone meal."
		"&eHow:&r keep killing them at night, or trap a skeleton spawner."
		"&eTip:&r a skeleton spawner farm is also an arrow farm."
	]
	quest.67858DD92CCB0EF4.title: "Ossuary"
	quest.67858DD92CCB0EF4.quest_subtitle: "Optional: kill 500 skeletons"
	quest.67858DD92CCB0EF4.quest_desc: [
		"&eWhat:&r five hundred skeletons. Build a farm."
		"&eHow:&r YUNG's skeleton dungeons have several spawners close together; trap them."
		"&eTip:&r Looting raises bone and arrow drops."
	]
	quest.2787A073A108D244.title: "Undead of Every Climate"
	quest.2787A073A108D244.quest_subtitle: "Husks, strays and drowned"
	quest.2787A073A108D244.quest_desc: [
		"&eWhat:&r the undead adapt to their biome: husks in deserts, strays in the snow, drowned in the water."
		"&eHow:&r husks don't burn in daylight; strays shoot slowness arrows; drowned may carry tridents."
		"&eTip:&r a drowned holding a trident can drop it. The trident is worth the hunt."
	]
	quest.6882F9EA87616B2D.title: "Tide Breaker"
	quest.6882F9EA87616B2D.quest_subtitle: "Optional: kill 100 drowned"
	quest.6882F9EA87616B2D.quest_desc: [
		"&eWhat:&r a hundred drowned, for copper ingots, nautilus shells and the occasional trident."
		"&eChemistry:&r fitting loot for the sea: copper resists seawater well, because it grows a protective skin of copper oxides and chlorides."
		"&eHow:&r rivers and oceans at night. Channeling or Impaling help."
	]
	quest.3FA449155D4FEA25.title: "Creeper Hunter"
	quest.3FA449155D4FEA25.quest_subtitle: "Kill 25 creepers"
	quest.3FA449155D4FEA25.quest_desc: [
		"&eWhat:&r creepers drop gunpowder, the oldest chemical explosive."
		"&eChemistry:&r gunpowder is potassium nitrate, charcoal and sulfur. The nitrate (KNO₃) supplies the oxygen: 2KNO₃ + S + 3C → K₂S + N₂ + 3CO₂."
		"&eHow:&r hit and step back; a creeper resets its fuse when you leave its range."
		"&eTip:&r a bow is the safest creeper tool there is."
	]
	quest.06935A94927B14A4.title: "Demolition Expert"
	quest.06935A94927B14A4.quest_subtitle: "Optional: kill 100 creepers"
	quest.06935A94927B14A4.quest_desc: [
		"&eWhat:&r a hundred creepers and a pile of gunpowder for TNT and rockets."
		"&eHow:&r keep hunting at night; a Knockback sword keeps them away from you."
		"&eTip:&r a creeper killed by a skeleton's arrow drops a music disc."
	]
	quest.7F28D5737D25033D.title: "Ssssilence"
	quest.7F28D5737D25033D.quest_subtitle: "Optional: kill 250 creepers"
	quest.7F28D5737D25033D.quest_desc: [
		"&eWhat:&r two hundred and fifty creepers. The world is quieter now."
		"&eHow:&r a mob farm, or many careful nights."
		"&eTip:&r cats scare creepers away from your base."
	]
	quest.0F182C0FD3BF28FC.title: "Spider Hunter"
	quest.0F182C0FD3BF28FC.quest_subtitle: "Kill 25 spiders"
	quest.0F182C0FD3BF28FC.quest_desc: [
		"&eWhat:&r spiders drop string and spider eyes."
		"&eChemistry:&r a fermented spider eye (eye + sugar + brown mushroom) turns potions into their opposites; real fermentation is microbes turning sugars into new compounds like ethanol and acids."
		"&eHow:&r spiders climb walls; build with an overhang to keep them out."
		"&eTip:&r spiders are neutral in daylight unless you hit them."
	]
	quest.68FD0B5C8685AEC6.title: "Arachnophobe"
	quest.68FD0B5C8685AEC6.quest_subtitle: "Optional: kill 100 spiders"
	quest.68FD0B5C8685AEC6.quest_desc: [
		"&eWhat:&r a hundred spiders, and enough string for every bow and wool block you need."
		"&eHow:&r spiders spawn on the surface at night; Bane of Arthropods helps."
		"&eTip:&r string from spiders makes wool: four string per block."
	]
	quest.6E22D2D1C73AD43E.title: "Cave Spiders"
	quest.6E22D2D1C73AD43E.quest_subtitle: "Kill 25 cave spiders"
	quest.6E22D2D1C73AD43E.quest_desc: [
		"&eWhat:&r small, poisonous spiders that only come from spawners in mineshafts and spider caves."
		"&eChemistry:&r milk cures poison in Minecraft; in reality there's no general antidote, and venoms are treated with antivenom antibodies."
		"&eHow:&r find a mineshaft or YUNG's spider cave and fight near the spawner. Carry milk."
		"&eTip:&r torches on and around the spawner stop it."
	]
	quest.30F228CCC8B496B2.title: "Pearl Diver"
	quest.30F228CCC8B496B2.quest_subtitle: "Kill 16 endermen"
	quest.30F228CCC8B496B2.quest_desc: [
		"&eWhat:&r endermen drop ender pearls: teleportation, eyes of ender and many machines."
		"&eHow:&r look at one to make it attack, then fight with your back to a 2-block-high gap; it can't follow under a low roof."
		"&eTip:&r endermen hate water. A rain storm sends them teleporting away."
	]
	quest.253114F2D024BB07.title: "Enderman Slayer"
	quest.253114F2D024BB07.quest_subtitle: "Kill 64 endermen"
	quest.253114F2D024BB07.quest_desc: [
		"&eWhat:&r a stack of kills and, with luck, a stack of pearls."
		"&eHow:&r warped forests in the Nether and the End are full of them."
		"&eTip:&r a carved pumpkin on your head lets you look at endermen safely."
	]
	quest.58C7893587424EDB.title: "Void Walker"
	quest.58C7893587424EDB.quest_subtitle: "Optional: kill 256 endermen"
	quest.58C7893587424EDB.quest_desc: [
		"&eWhat:&r four stacks of endermen. You'll need an End farm or a lot of patience."
		"&eHow:&r an enderman farm on the outer End islands is the classic way."
		"&eTip:&r endermites make endermen aggressive; that's how most End farms lure them."
	]
	quest.7E196F63F0F0A960.title: "Witch Hunt"
	quest.7E196F63F0F0A960.quest_subtitle: "Kill 10 witches"
	quest.7E196F63F0F0A960.quest_desc: [
		"&eWhat:&r witches throw potions and drink their own to heal. They drop redstone, glowstone, sugar and bottles."
		"&eChemistry:&r glowstone dust in-game is a brewing amplifier; real \"glow\" chemicals (like the zinc sulfide in glow paint) store light and release it slowly."
		"&eHow:&r rush them; at range they out-potion you. Milk clears their effects."
		"&eTip:&r swamp huts spawn witches over and over: a classic redstone farm."
	]
	quest.5518E80E2B9B731B.title: "Coven Breaker"
	quest.5518E80E2B9B731B.quest_subtitle: "Optional: kill 50 witches"
	quest.5518E80E2B9B731B.quest_desc: [
		"&eWhat:&r fifty witches and a pile of redstone and glowstone."
		"&eHow:&r a swamp hut farm, or raids (witches join them)."
		"&eTip:&r witches are immune to most potion damage; use a sword or bow."
	]
	quest.3789F700DBDAA49F.title: "Slime Time"
	quest.3789F700DBDAA49F.quest_subtitle: "Kill 25 slimes"
	quest.3789F700DBDAA49F.quest_desc: [
		"&eWhat:&r slimes split when killed; the smallest drop slimeballs for sticky pistons and leads."
		"&eChemistry:&r real slime is a polymer gel: long molecules cross-linked loosely enough to flow, like borax and PVA glue."
		"&eHow:&r slimes spawn in swamps at night and in slime chunks underground."
		"&eTip:&r every split counts as a kill. A big slime is many kills."
	]
	quest.63D72081F346D7E0.title: "Night Terrors"
	quest.63D72081F346D7E0.quest_subtitle: "Kill 10 phantoms"
	quest.63D72081F346D7E0.quest_desc: [
		"&eWhat:&r phantoms dive at players who haven't slept for three nights. Their membranes repair elytra."
		"&eHow:&r stay up three nights, then fight with a bow on open ground at night."
		"&eTip:&r once you're done, sleep: it resets the timer and phantoms stop coming."
	]
	quest.6349CF403F409E40.title: "Skyclearer"
	quest.6349CF403F409E40.quest_subtitle: "Optional: kill 50 phantoms"
	quest.6349CF403F409E40.quest_desc: [
		"&eWhat:&r fifty phantoms, and enough membranes to keep an elytra flying for a long time."
		"&eHow:&r a bow with Power, or a trident with Loyalty, and a sleepless week."
		"&eTip:&r phantoms are undead; Smite works on them."
	]
	quest.7C77F3713A93792F.title: "Pest Control"
	quest.7C77F3713A93792F.quest_subtitle: "Optional: kill 50 silverfish"
	quest.7C77F3713A93792F.quest_desc: [
		"&eWhat:&r silverfish hide in infested stone in strongholds and mountains, and call their friends when hurt."
		"&eHow:&r YUNG's strongholds are full of infested blocks; a single blow kills each one."
		"&eTip:&r don't break blocks near a silverfish fight; you'll wake more."
	]
	quest.5B7746A8D5C8363A.title: "The Trials"
	quest.5B7746A8D5C8363A.quest_subtitle: "Kill 10 breezes and 10 bogged"
	quest.5B7746A8D5C8363A.quest_desc: [
		"&eWhat:&r two mobs from 1.21: breezes (wind spirits) and bogged (mossy skeletons with poison arrows), both from trial chambers."
		"&eHow:&r find a trial chamber (see the Exploration page) and fight the trial spawners."
		"&eTip:&r breeze rods make wind charges and the mace."
	]
	quest.325CC7A411B2A8F9.title: "Pillager Hunter"
	quest.325CC7A411B2A8F9.quest_subtitle: "Kill 25 pillagers"
	quest.325CC7A411B2A8F9.quest_desc: [
		"&eWhat:&r crossbow-armed illagers from outposts and patrols."
		"&eHow:&r a shield blocks their bolts. Outposts respawn pillagers around the tower."
		"&eTip:&r a captain (banner on its head) gives Bad Omen when killed: drink the ominous bottle to start a raid."
	]
	quest.4AB7BA8E5DA7EFFF.title: "Outpost Breaker"
	quest.4AB7BA8E5DA7EFFF.quest_subtitle: "Optional: kill 100 pillagers"
	quest.4AB7BA8E5DA7EFFF.quest_desc: [
		"&eWhat:&r a hundred pillagers."
		"&eHow:&r camp an outpost or run raids. Raids bring them in waves."
		"&eTip:&r a raid farm is the best emerald source in the game."
	]
	quest.24E4368C41967996.title: "Axes of Malice"
	quest.24E4368C41967996.quest_subtitle: "Kill 10 vindicators"
	quest.24E4368C41967996.quest_desc: [
		"&eWhat:&r axe-wielding illagers from raids and woodland mansions. They hit very hard."
		"&eHow:&r keep your shield up; their axes can disable it, so back off after a block."
		"&eTip:&r a vindicator named \"Johnny\" attacks every mob in sight."
	]
	quest.3E29A8FDA2E99B04.title: "Evoker Bane"
	quest.3E29A8FDA2E99B04.quest_subtitle: "Kill 3 evokers"
	quest.3E29A8FDA2E99B04.quest_desc: [
		"&eWhat:&r evokers summon fangs and vexes. Each one drops a Totem of Undying."
		"&eHow:&r they come in later raid waves and live in woodland mansions. Kill the evoker first; its vexes die with it."
		"&eTip:&r keep a totem in your off-hand when fighting raids."
	]
	quest.19A9413C7BECB803.title: "Beast of the Raid"
	quest.19A9413C7BECB803.quest_subtitle: "Kill 3 ravagers"
	quest.19A9413C7BECB803.quest_desc: [
		"&eWhat:&r ravagers are huge raid beasts that trample crops and charge."
		"&eHow:&r they appear in raids from wave 3 on. Block the charge with a shield, then counterattack while it's stunned."
		"&eTip:&r ravagers drop saddles."
	]
	quest.502A6AE02C3F21B9.title: "Guardian Hunter"
	quest.502A6AE02C3F21B9.quest_subtitle: "Kill 25 guardians"
	quest.502A6AE02C3F21B9.quest_desc: [
		"&eWhat:&r the spiky fish of ocean monuments. They drop prismarine shards and crystals."
		"&eChemistry:&r prismarine is in-game sea crystal; real sea creatures build shells and spines from calcium carbonate and silica pulled out of seawater."
		"&eHow:&r find a monument (see the Exploration page). Break line of sight when their laser charges."
		"&eTip:&r water breathing and Depth Strider make monuments much easier."
	]
	quest.3B3FCDB389203401.title: "Gold in the Rot"
	quest.3B3FCDB389203401.quest_subtitle: "Kill 50 zombified piglins"
	quest.3B3FCDB389203401.quest_desc: [
		"&eWhat:&r zombified piglins drop gold nuggets and rotten flesh."
		"&eHow:&r they're neutral until you hit one, then the whole crowd comes. Fight in a corridor."
		"&eTip:&r gold farms over Nether-roof portals are a classic build."
	]
	quest.25C1958DAE2F684A.title: "Blaze Hunter"
	quest.25C1958DAE2F684A.quest_subtitle: "Kill 25 blazes"
	quest.25C1958DAE2F684A.quest_desc: [
		"&eWhat:&r blazes drop blaze rods: brewing stands, blaze powder and eyes of ender."
		"&eChemistry:&r blazes throw fireballs; real fireballs need fuel plus oxygen, which is why a fire triangle (heat, fuel, O₂) puts them out when you remove any side."
		"&eHow:&r blaze spawners sit in Nether fortresses. Snowballs hurt them."
		"&eTip:&r fire resistance makes you immune to their fireballs."
	]
	quest.701B865E5BC4BFC5.title: "Blaze Slayer"
	quest.701B865E5BC4BFC5.quest_subtitle: "Optional: kill 100 blazes"
	quest.701B865E5BC4BFC5.quest_desc: [
		"&eWhat:&r a hundred blazes and a good supply of rods."
		"&eHow:&r build a blaze farm around a fortress spawner."
		"&eTip:&r blaze rods are a good furnace fuel: 12 items each."
	]
	quest.4BDCC9A8EB40A6B9.title: "Ghastbuster"
	quest.4BDCC9A8EB40A6B9.quest_subtitle: "Kill 10 ghasts"
	quest.4BDCC9A8EB40A6B9.quest_desc: [
		"&eWhat:&r ghasts drop ghast tears (regeneration potions, end crystals) and gunpowder."
		"&eHow:&r hit their fireballs back at them with a sword or an arrow."
		"&eTip:&r kill them over solid ground, not lava, or the tear is lost."
	]
	quest.6C85B3B27CEA7AB0.title: "Hot Jelly"
	quest.6C85B3B27CEA7AB0.quest_subtitle: "Kill 50 magma cubes"
	quest.6C85B3B27CEA7AB0.quest_desc: [
		"&eWhat:&r magma cubes split like slimes and drop magma cream for fire resistance."
		"&eHow:&r basalt deltas are full of them."
		"&eTip:&r every split counts as a kill."
	]
	quest.38A42A798875518D.title: "Skull Hunter"
	quest.38A42A798875518D.quest_subtitle: "Kill 25 wither skeletons"
	quest.38A42A798875518D.quest_desc: [
		"&eWhat:&r tall black skeletons in Nether fortresses. They sometimes drop their skull; three summon the Wither."
		"&eHow:&r fight in a 2-block-high tunnel; they're three blocks tall and can't follow."
		"&eTip:&r Looting raises the skull drop chance."
	]
	quest.3C7A0FC62606150B.title: "Bonebreaker"
	quest.3C7A0FC62606150B.quest_subtitle: "Optional: kill 100 wither skeletons"
	quest.3C7A0FC62606150B.quest_desc: [
		"&eWhat:&r a hundred wither skeletons, and enough skulls for several Withers."
		"&eHow:&r a wither skeleton farm on a fortress platform."
		"&eTip:&r a Smite sword kills them quickly."
	]
	quest.6463056EC87BB840.title: "Bastion Brawl"
	quest.6463056EC87BB840.quest_subtitle: "Kill 5 piglin brutes and 10 hoglins"
	quest.6463056EC87BB840.quest_desc: [
		"&eWhat:&r the toughest regular Nether fighters: axe-armed piglin brutes in bastions and charging hoglins in crimson forests."
		"&eChemistry:&r hoglins fear warped fungus; real animals avoid many plant compounds, which evolved as chemical defences."
		"&eHow:&r brutes ignore gold armour; fight them in doorways. Hoglins drop pork and leather."
		"&eTip:&r hoglins turn into zoglins in the Overworld, so don't bring one home."
	]
	quest.0BA05583E0D3118B.title: "Shell Game"
	quest.0BA05583E0D3118B.quest_subtitle: "Kill 20 shulkers"
	quest.0BA05583E0D3118B.quest_desc: [
		"&eWhat:&r shulkers hide in End Cities and drop shells for shulker boxes."
		"&eHow:&r hit them when their shell opens. Their bullets make you levitate."
		"&eTip:&r carry milk or slow falling against levitation."
	]
	quest.4DAB5F2E15BD1E7F.title: "The Rotspawn"
	quest.4DAB5F2E15BD1E7F.quest_subtitle: "Undergarden's rotting horde"
	quest.4DAB5F2E15BD1E7F.quest_desc: [
		"&eWhat:&r the Undergarden's undead-like rotspawn: small rotlings, tall rotwalkers and the huge rotbeast."
		"&eHow:&r utherium weapons deal extra damage to rotspawn."
		"&eTip:&r rotbeasts hit hard and have a lot of health; fight them in the open."
	]
	quest.3E7FE9B8E21A772D.title: "Things in the Dark"
	quest.3E7FE9B8E21A772D.quest_subtitle: "Nargoyles and munchers"
	quest.3E7FE9B8E21A772D.quest_desc: [
		"&eWhat:&r more Undergarden predators: nargoyles and the hungry munchers."
		"&eHow:&r explore the Undergarden at length; both turn up in its caverns."
		"&eTip:&r cloggrum armour is the Undergarden's best early protection."
	]
	quest.23851676A0A2DF97.title: "Sculk Fauna"
	quest.23851676A0A2DF97.quest_subtitle: "Snappers and centipedes"
	quest.23851676A0A2DF97.quest_desc: [
		"&eWhat:&r creatures of the Otherside, grown from sculk."
		"&eHow:&r roam the Otherside's biomes. Sneak to approach without alerting the sculk."
		"&eTip:&r carry food and a way home; the Otherside is a long way from your base."
	]
	quest.6C4CA5C87E1715D4.title: "Shattered and Stalkers"
	quest.6C4CA5C87E1715D4.quest_subtitle: "The Otherside's hunters"
	quest.6C4CA5C87E1715D4.quest_desc: [
		"&eWhat:&r shattered drop sculk bones; stalkers drop soul crystals. Both go into the soul elytra."
		"&eHow:&r both hunt by sound like the Warden. Fight at range."
		"&eTip:&r sneak to keep your footsteps quiet."
	]
	quest.5E83D1D3C67233ED.title: "Martian Raptors"
	quest.5E83D1D3C67233ED.quest_subtitle: "Optional: kill 10 raptors on Mars"
	quest.5E83D1D3C67233ED.quest_desc: [
		"&eWhat:&r fast predators of the Martian surface."
		"&eChemistry:&r anything living on Mars would need to cope with perchlorates (ClO₄⁻), reactive salts found in real Martian soil."
		"&eHow:&r land on Mars and hunt in the wastelands. Keep your suit topped up."
	]
	quest.68D285E63CF52E20.title: "Twilight Pests"
	quest.68D285E63CF52E20.quest_subtitle: "Redcaps, kobolds and swarm spiders"
	quest.68D285E63CF52E20.quest_desc: [
		"&eWhat:&r the common hostile mobs of the Twilight Forest."
		"&eHow:&r redcaps and kobolds roam the forest; swarm spiders spawn around hollow hills and spider-infested spots."
		"&eTip:&r redcap sappers carry TNT; kill them before they light it."
	]
	quest.7506A7C163583FD3.title: "Maze and Swamp"
	quest.7506A7C163583FD3.quest_subtitle: "Minotaurs, maze slimes and druids"
	quest.7506A7C163583FD3.quest_desc: [
		"&eWhat:&r guardians of the labyrinth and the swamp beyond the Lich."
		"&eHow:&r minotaurs and maze slimes fill the labyrinth; skeleton druids lurk in the forest at night."
		"&eTip:&r maze slimes split like regular slimes."
	]
	quest.260C93AB006F87B1.title: "Goblins and Ghastguards"
	quest.260C93AB006F87B1.quest_subtitle: "Stronghold and Dark Tower guards"
	quest.260C93AB006F87B1.quest_desc: [
		"&eWhat:&r goblin knights and block-and-chain goblins hold the Goblin Stronghold; carminite ghastguards haunt the Dark Tower."
		"&eHow:&r goblin knights ride in pairs; knock off the upper one, then finish the lower."
		"&eTip:&r ghastguards' fireballs can be hit back like a ghast's."
	]
	quest.4D50CBE90F48364F.title: "Snow Beasts"
	quest.4D50CBE90F48364F.quest_subtitle: "Yetis and winter wolves"
	quest.4D50CBE90F48364F.quest_desc: [
		"&eWhat:&r the snowy forest's hunters. Yetis drop arctic fur for warm armour."
		"&eHow:&r yetis guard the Alpha Yeti's cave; winter wolves roam the snowy forest and breathe frost."
		"&eTip:&r winter wolves come in packs; back against a tree."
	]
	quest.141CF02320F05EF3.title: "Trolls and Giants"
	quest.141CF02320F05EF3.quest_subtitle: "Optional: the highlands' heavyweights"
	quest.141CF02320F05EF3.quest_desc: [
		"&eWhat:&r trolls in the troll caves and giant miners on the highlands."
		"&eHow:&r trolls throw rocks; giants swing slowly but hard. Fight both from range."
		"&eTip:&r giant miners drop giant pickaxes."
	]
	quest.68F983645DEC5133.title: "Elder Guardians"
	quest.68F983645DEC5133.quest_subtitle: "All three elders of a monument"
	quest.68F983645DEC5133.quest_desc: [
		"&eWhat:&r each ocean monument holds three elder guardians. They cast Mining Fatigue until all three are dead."
		"&eHow:&r the elders sit in the top room and two wing rooms. Water breathing, a good sword and patience."
		"&eTip:&r elders drop wet sponges and, sometimes, a tide armour trim."
	]
	quest.62C34C9BAFF44652.title: "The Wither"
	quest.62C34C9BAFF44652.quest_subtitle: "Summon it, kill it, take its star"
	quest.62C34C9BAFF44652.quest_desc: [
		"&6You remember making stars. This one you'll have to take.&r"
		"&eWhat:&r the Wither is the Nether's boss, summoned by the player. It drops a Nether Star for beacons and many late recipes."
		"&eHow:&r four soul sand in a T with three wither skeleton skulls on top. Summon it deep underground or far from base: it destroys blocks."
		"&eTip:&r below half health it gains armour that stops arrows; switch to a Smite sword."
	]
	quest.6289ECF868508BE4.title: "Spoils: Rotten Flesh"
	quest.6289ECF868508BE4.quest_subtitle: "Optional: the least wanted drop, put to use"
	quest.6289ECF868508BE4.quest_desc: [
		"&eWhat:&r a stack of rotten flesh. Nobody wants to eat it, but your Dissolver does."
		"&eChemistry:&r the Dissolver breaks one rotten flesh into 3 protein. Proteins are chains of amino acids joined by peptide bonds (–CO–NH–); rotting is bacteria cutting those chains."
		"&eHow:&r keep the flesh from your zombie hunts instead of throwing it away."
		"&eTip:&r dissolve the protein again and it gives ammonia, CO₂, ethylene and sulfur; the sulfur comes from the amino acids cysteine and methionine."
	]
	quest.0957B507E7B098AB.title: "Spoils: Bones"
	quest.0957B507E7B098AB.quest_subtitle: "Optional: calcium phosphate on legs"
	quest.0957B507E7B098AB.quest_desc: [
		"&eWhat:&r a stack of bones: bone meal, bone blocks and a mineral the Dissolver can use."
		"&eChemistry:&r bone is mostly hydroxyapatite, Ca₅(PO₄)₃OH. Half the time the Dissolver gives 3 of it per bone: calcium and phosphorus in one crystal."
		"&eHow:&r keep the bones from skeletons."
		"&eTip:&r hydroxyapatite is also what tooth enamel is made of; fluoride toothpaste swaps OH⁻ for F⁻ to make it harder."
	]
	quest.6FD9C1EAEB0CC958.title: "Spoils: Silk and Eyes"
	quest.6FD9C1EAEB0CC958.quest_subtitle: "Optional: string and spider eyes"
	quest.6FD9C1EAEB0CC958.quest_desc: [
		"&eWhat:&r string for bows, wool and machines, and spider eyes for brewing."
		"&eChemistry:&r in the Dissolver, string gives keratin and a spider eye gives beta-carotene and chitin. Real spider silk is a different protein, spidroin, and is tougher than steel for its weight."
		"&eHow:&r keep the drops from your spider hunts. Witches drop spider eyes too."
		"&eTip:&r beta-carotene is the orange pigment in carrots; your body splits it into vitamin A."
	]
	quest.0218B2F222BDDB89.title: "Spoils: The Witch's Pantry"
	quest.0218B2F222BDDB89.quest_subtitle: "Optional: glowstone, sugar and bottles"
	quest.0218B2F222BDDB89.quest_desc: [
		"&eWhat:&r the ingredients witches carry: glowstone dust, sugar and empty bottles."
		"&eChemistry:&r the Dissolver breaks glowstone dust into 4 phosphorus and sugar into sucrose, C₁₂H₂₂O₁₁. Glass itself is mostly SiO₂, melted with soda (Na₂CO₃) and lime so it softens at a workable heat."
		"&eHow:&r keep the drops from witches; swamp huts respawn them."
		"&eTip:&r sucrose in the Dissolver is one of the easiest early sources of carbon, hydrogen and oxygen."
	]
	quest.0CD244DAA913DA26.title: "The Trident"
	quest.0CD244DAA913DA26.quest_subtitle: "Optional: take it from a drowned"
	quest.0CD244DAA913DA26.quest_desc: [
		"&eWhat:&r the only trident in the game is the one a drowned carries. It can't be crafted."
		"&eHow:&r fight drowned in rivers and oceans; only those holding a trident can drop one, and it's rare. Looting helps."
		"&eTip:&r enchant it with Loyalty to have it fly back, Riptide to launch yourself in rain, or Channeling to call lightning."
	]
	chapter.1C9E9D35BDB125AE.title: "Mystical Agriculture"
	chapter.1C9E9D35BDB125AE.chapter_subtitle: [
		"Resource crops, within the rules of chemistry."
	]
	quest.7592FE8784DA7D0E.title: "Mystical Agriculture"
	quest.7592FE8784DA7D0E.quest_subtitle: "Resource crops, made on an altar"
	quest.7592FE8784DA7D0E.quest_desc: [
		"&6You remember coaxing metal out of the ground like wheat. Some of that still works.&r"
		"&eWhat:&r resource crops grow essence that crafts into real materials. Seeds are made on the Infusion Altar with Infusion Pedestals around it."
		"&eHow:&r inferium ore gives inferium essence (mobs drop some too). The altar is gold, stone and red wool; pedestals are in JEI."
		"&eTip:&r &eTier 3/4/5 seeds need MI LV/MV/HV circuits&r, and crops for chemistry milestones can't be grown at all. Farming is a convenience here, not a shortcut."
	]
	quest.476972F4A69AE2B6.title: "Prosperity"
	quest.476972F4A69AE2B6.quest_subtitle: "Shards for seed bases and crystals"
	quest.476972F4A69AE2B6.quest_desc: [
		"&eWhat:&r prosperity shards come from prosperity ore. They make seed bases (the core of every resource seed) and infusion crystals."
		"&eHow:&r mine prosperity ore; 4 shards around wheat seeds make a Prosperity Seed Base."
		"&eTip:&r Ultimine the veins; you'll want a lot of shards."
	]
	quest.53DFFD39635750E6.title: "Infusion Crystal"
	quest.53DFFD39635750E6.quest_subtitle: "The tool that upgrades essence"
	quest.53DFFD39635750E6.quest_desc: [
		"&eWhat:&r a crystal that combines lower essence into higher tiers. It wears out with use."
		"&eHow:&r a diamond, prosperity shards and inferium essence (check JEI)."
		"&eTip:&r the Master Infusion Crystal never wears out; it comes much later, from supremium."
	]
	quest.05F6FABCA51A5D27.title: "Prudentium"
	quest.05F6FABCA51A5D27.quest_subtitle: "Tier 2 essence"
	quest.05F6FABCA51A5D27.quest_desc: [
		"&eWhat:&r the second essence tier, for tier 2 seeds (JEI lists every crop and its tier)."
		"&eHow:&r 4 inferium essence around an infusion crystal make 1 prudentium (check JEI)."
		"&eTip:&r it uncrafts back to inferium if you overshoot (check JEI)."
	]
	quest.63BC9482303C7949.title: "Tertium: LV Seeds"
	quest.63BC9482303C7949.quest_subtitle: "Tier 3 seeds need an analog circuit"
	quest.63BC9482303C7949.quest_desc: [
		"&eWhat:&r tier 3 seeds (iron, copper, redstone, nether quartz, tin, lead and more) need Tertium essence and an &eMI analog circuit&r."
		"&eChemistry:&r the analog circuit stands on steel, and steel stands on coke: coal baked without air until only carbon is left."
		"&eHow:&r 4 prudentium around an infusion crystal make 1 tertium. Each seed type costs its circuit once; planted seeds multiply."
	]
	quest.429B4A2ABF9C8710.title: "Imperium: MV Seeds"
	quest.429B4A2ABF9C8710.quest_subtitle: "Tier 4 seeds need an electronic circuit"
	quest.429B4A2ABF9C8710.quest_desc: [
		"&eWhat:&r tier 4 seeds (gold, lapis, nickel, blaze, enderman and more) need Imperium essence and an &eMI electronic circuit&r."
		"&eChemistry:&r the electronic circuit needs aluminum, which only electrolysis can free from its oxide: 2Al₂O₃ → 4Al + 3O₂."
		"&eHow:&r 4 tertium around an infusion crystal make 1 imperium."
	]
	quest.329417D2B6B5EF41.title: "Supremium: HV Seeds"
	quest.329417D2B6B5EF41.quest_subtitle: "Tier 5 seeds need a digital circuit"
	quest.329417D2B6B5EF41.quest_desc: [
		"&6You remember gardens that grew gold. These come close, and they still answer to chemistry.&r"
		"&eWhat:&r tier 5 seeds (diamond, emerald, netherite and more) need Supremium essence and an &eMI digital circuit&r."
		"&eChemistry:&r the digital circuit needs polyethylene: thousands of ethylene units, C₂H₄, linked into one chain."
		"&eHow:&r 4 imperium around an infusion crystal make 1 supremium."
	]
	quest.12AA4108F02395E9.title: "Growth Accelerators"
	quest.12AA4108F02395E9.quest_subtitle: "Optional: crops grow faster above them"
	quest.12AA4108F02395E9.quest_desc: [
		"&eWhat:&r growth accelerators placed below farmland speed up the crops above them. Stack several for more effect."
		"&eHow:&r check JEI for each tier's recipe."
		"&eTip:&r put them under the floor of your crop room so they're out of the way."
	]
	quest.4D32DDE3DA6B6767.title: "Awakening"
	quest.4D32DDE3DA6B6767.quest_subtitle: "Optional: beyond supremium"
	quest.4D32DDE3DA6B6767.quest_desc: [
		"&eWhat:&r the Awakening Altar turns supremium into awakened supremium for the strongest Mystical Agriculture gear."
		"&eHow:&r JEI shows the altar, its Awakening Pedestals, the Essence Vessels and the awakening recipe."
		"&eTip:&r awakened supremium makes the best Mystical Agriculture tools and armour."
	]
	quest.7B1B5EF67E8690E8.title: "Master Infusion Crystal"
	quest.7B1B5EF67E8690E8.quest_subtitle: "Optional: a crystal that never breaks"
	quest.7B1B5EF67E8690E8.quest_desc: [
		"&eWhat:&r an infusion crystal with no durability, so essence upgrades stop costing crystals."
		"&eHow:&r a supremium gemstone, supremium essence and prosperity shards (check JEI)."
		"&eTip:&r worth it once you are mass-producing tertium and imperium for seeds."
	]
	quest.08D5A196E95B09AF.title: "Inferium Seeds"
	quest.08D5A196E95B09AF.quest_subtitle: "The crop that grows more essence"
	quest.08D5A196E95B09AF.quest_desc: [
		"&eWhat:&r Inferium Seeds grow inferium essence, the fuel for every higher tier. Any 4 Mystical Agriculture seeds complete this."
		"&eHow:&r 8 inferium essence around wheat seeds in a crafting grid (no altar needed). Plant them on farmland and replant the extra seeds."
		"&eTip:&r every other resource seed starts from a seed base on the altar, so build a big inferium field first."
	]
	quest.05CAB1D55ED3D024.title: "Essence Farmland"
	quest.05CAB1D55ED3D024.quest_subtitle: "Better soil for inferium crops"
	quest.05CAB1D55ED3D024.quest_desc: [
		"&eWhat:&r farmland infused with essence. Inferium crops drop more essence on higher-tier farmland."
		"&eHow:&r one inferium essence plus one farmland, shapeless (check JEI). Higher tiers use their own essence."
		"&eTip:&r upgrade the farmland under your inferium field as each new essence tier arrives."
	]
	quest.54A29771FF1DDF78.title: "Mystical Fertilizer"
	quest.54A29771FF1DDF78.quest_subtitle: "Optional: grow a crop instantly"
	quest.54A29771FF1DDF78.quest_desc: [
		"&eWhat:&r instantly grows a crop or sapling, including resource crops that bone meal can't push."
		"&eHow:&r bone meal, inferium essence and a diamond make 4 (check JEI)."
		"&eTip:&r save it for slow, expensive crops rather than wheat."
	]
	quest.5839B7784C096EED.title: "Agglomeratio"
	quest.5839B7784C096EED.quest_subtitle: "Optional: materials for crops with no single item"
	quest.5839B7784C096EED.quest_desc: [
		"&eWhat:&r some crops (nature, the four elements, dye, nether, coral and others) don't map to one item. Their seed recipes use an agglomeratio instead."
		"&eHow:&r Nature Agglomeratio is pumpkin, potato, cactus and sugar cane; JEI shows the rest."
		"&eTip:&r the elemental crops (air, earth, water, fire) feed many other recipes, so they're good early picks."
	]
	quest.24AE5486AE474342.title: "Why Chemistry Won't Grow"
	quest.24AE5486AE474342.quest_subtitle: "Some seeds were removed on purpose"
	quest.24AE5486AE474342.quest_desc: [
		"&eWhat:&r seeds for uranium, uraninite, osmium, fluorite, silicon, steel, aluminum, graphite, platinum, iridium, refined obsidian and refined glowstone don't exist in this pack. Click the checkmark when you've read why."
		"&eHow:&r if JEI shows no altar recipe for a crop, it's one of these. Get them from ore processing and the reactors in the main quests."
		"&eTip:&r iron, copper, tin, lead, gold and other everyday metals are still farmable, behind their circuit gates."
		"{@pagebreak}"
		"&eDeep dive: why these metals?&r"
		"Each blocked resource is the reason a tier exists. Steel needs carbon from coke and an oxygen-controlled furnace; aluminum needs electrolysis of molten alumina (Hall-Héroult, 2Al₂O₃ → 4Al + 3O₂)."
		"Silicon is reduced from quartz with carbon at about 2000 °C (SiO₂ + 2C → Si + 2CO). Fluorite is the fluorine source for uranium enrichment; uranium and uraninite are the nuclear chain."
		"Platinum and iridium come from the PGM line: anode sludge, aqua regia, ammonium hexachloroplatinate, calcining. Graphite and osmium gate Mekanism and MI steps."
		"Growing them on a plant would skip the chemistry those tiers teach. Everything else stays farmable, so farming saves time without replacing a single reaction."
	]
	quest.31B95BF1B78FC771.title: "Watering Can"
	quest.31B95BF1B78FC771.quest_subtitle: "Water speeds up growth"
	quest.31B95BF1B78FC771.quest_desc: [
		"&eWhat:&r right-click to water crops in an area, which makes them grow faster while you hold it."
		"&eHow:&r iron ingots, a bowl and bone meal (check JEI). Fill it from any water source."
		"&eTip:&r stand in the middle of the field and hold right-click."
	]
	quest.2AE6F05324BA2C59.title: "Inferium Ingots"
	quest.2AE6F05324BA2C59.quest_subtitle: "The metal for Mystical Agriculture gear"
	quest.2AE6F05324BA2C59.quest_desc: [
		"&eWhat:&r essence-infused ingots for tools, armour and the better watering cans."
		"&eHow:&r a prosperity ingot plus 2 inferium essence (check JEI for the prosperity ingot)."
		"&eTip:&r each essence tier has its own ingot; JEI shows the upgrade path."
	]
	quest.3BC7002FEB68725F.title: "Inferium Watering Can"
	quest.3BC7002FEB68725F.quest_subtitle: "Optional: a bigger watering area"
	quest.3BC7002FEB68725F.quest_desc: [
		"&eWhat:&r a tiered watering can covers a larger area and works faster."
		"&eHow:&r your watering can, inferium ingots and mystical fertilizer (check JEI). The higher tiers repeat the pattern."
		"&eTip:&r the can keeps its contents when upgraded."
	]
	quest.08F7E833C88C6704.title: "A Lucky Harvest"
	quest.08F7E833C88C6704.quest_subtitle: "Secret: a rare drop from the field"
	quest.08F7E833C88C6704.quest_desc: [
		"&eWhat:&r crops sometimes drop Fertilized Essence. You found one."
		"&eHow:&r it crafts into mystical fertilizer (check JEI)."
		"&eTip:&r more crops means more chances; a big inferium field pays for itself."
	]
	quest.1A6616EA3169DE4E.title: "Soulstone"
	quest.1A6616EA3169DE4E.quest_subtitle: "A Nether stone with something inside"
	quest.1A6616EA3169DE4E.quest_desc: [
		"&eWhat:&r soulstone clusters generate in the Nether. A few of their blocks are soulium ore, the source of soulium dust."
		"&eHow:&r mine soulstone in the Nether and watch for soulium ore (check JEI for its drops)."
		"&eTip:&r a soulium ingot is a prosperity ingot plus 2 soulium dust; soul dust (for soul glass) comes from smelting smooth soulstone."
	]
	quest.0A1E76D6BAED16FB.title: "Soulium Dagger"
	quest.0A1E76D6BAED16FB.quest_subtitle: "A blade that collects souls"
	quest.0A1E76D6BAED16FB.quest_desc: [
		"&eWhat:&r kills with this dagger capture the mob's soul into a Soul Jar in your inventory."
		"&eHow:&r a golden sword, soulium ingots and soulium dust (check JEI)."
		"&eTip:&r JEI's soul extraction page shows how many souls each mob gives."
	]
	quest.428E72DF157C0E84.title: "Soul Jars"
	quest.428E72DF157C0E84.quest_subtitle: "Glass that holds a mob's essence"
	quest.428E72DF157C0E84.quest_desc: [
		"&eWhat:&r each jar stores souls of one mob type. Full jars are the material for mob seeds."
		"&eHow:&r soul glass (soul dust around glass) and a soulium ingot (check JEI)."
		"&eTip:&r carry one empty jar per mob type you're hunting."
	]
	quest.26B2F788E44A88FF.title: "Fill a Jar"
	quest.26B2F788E44A88FF.quest_subtitle: "Kill 20 zombies with the dagger"
	quest.26B2F788E44A88FF.quest_desc: [
		"&eWhat:&r fill a Soul Jar with zombie souls for zombie seeds (rotten flesh)."
		"&eHow:&r keep an empty Soul Jar in your inventory and kill zombies with the Soulium Dagger."
		"&eTip:&r the Soul Extractor can also pull souls out of mob drops like rotten flesh (check JEI)."
	]
	quest.7BF7865AB438BD4F.title: "Mob Seeds"
	quest.7BF7865AB438BD4F.quest_subtitle: "Grow mob drops without the mobs"
	quest.7BF7865AB438BD4F.quest_desc: [
		"&eWhat:&r mob seeds start from a Soulium Seed Base and grow drops like rotten flesh, bones and string."
		"&eHow:&r a prosperity seed base plus 2 soulium dust. On the altar, put it in the middle and the full jars and essence on the pedestals (check JEI)."
		"&eTip:&r zombie, skeleton, spider and creeper are tier 3, so they also need an analog circuit."
	]
	quest.0D456A2E999CC4F8.title: "Machine Frame"
	quest.0D456A2E999CC4F8.quest_subtitle: "The base of Mystical Agriculture machines"
	quest.0D456A2E999CC4F8.quest_desc: [
		"&eWhat:&r the shared frame for the Harvester, Soul Extractor, Seed Reprocessor and other MA machines."
		"&eHow:&r iron, redstone and stone (check JEI)."
		"&eTip:&r MA machines run on Forge Energy, so they plug into any FE cable."
	]
	quest.4E7A8526103C06DE.title: "Harvester"
	quest.4E7A8526103C06DE.quest_subtitle: "Harvests and replants a field"
	quest.4E7A8526103C06DE.quest_desc: [
		"&eWhat:&r the Harvester picks mature crops in an area in front of it and replants them, pushing drops into its inventory."
		"&eHow:&r machine frame, soulium ingots, iron and two diamond scythes (check JEI). Power it with FE."
		"&eTip:&r pipe its output into storage and the field runs itself."
	]
	quest.1AB94C1A78E23821.title: "Soul Extractor"
	quest.1AB94C1A78E23821.quest_subtitle: "Optional: souls from mob drops"
	quest.1AB94C1A78E23821.quest_desc: [
		"&eWhat:&r fills Soul Jars from mob drops (rotten flesh, bones, string and more) instead of kills."
		"&eHow:&r machine frame, soulium ingots, iron and a soulium dagger (check JEI). Power it with FE."
		"&eTip:&r feed it drops from an HNN Simulation Chamber for a fully passive soul supply."
	]
	quest.2E34A7CBAE7C47D5.title: "A Pot Farm"
	quest.2E34A7CBAE7C47D5.quest_subtitle: "Eight hopper pots of resource crops"
	quest.2E34A7CBAE7C47D5.quest_desc: [
		"&eWhat:&r Mystical Agriculture seeds grow in Hopper Botany Pots, which harvest by themselves into a chest below."
		"&eHow:&r put each pot on a hopper, pipe or chest, add dirt or farmland and a seed. Hold any MA seed in JEI to see its pot growth time."
		"&eTip:&r a column of pots over one shared item pipe is a compact essence farm for every tier."
	]
	quest.65BFEDF064434795.title: "Infusion Pedestals"
	quest.65BFEDF064434795.quest_subtitle: "Optional: a full ring around the altar"
	quest.65BFEDF064434795.quest_desc: [
		"&eWhat:&r the altar takes its eight side ingredients from the pedestals around it. Every seed recipe uses all eight."
		"&eHow:&r each pedestal is gold, red wool and stone (check JEI). Place them as JEI shows around the altar."
		"&eTip:&r a hopper or pipe into the altar's centre makes repeat seeds easier."
	]
	quest.6950DD2DF950738A.title: "Better Farmland"
	quest.6950DD2DF950738A.quest_subtitle: "Optional: upgrade the soil under your inferium"
	quest.6950DD2DF950738A.quest_desc: [
		"&eWhat:&r higher-tier farmland makes inferium crops drop more essence: prudentium, tertium, imperium or supremium."
		"&eHow:&r one essence of the tier plus farmland (shapeless), or till dirt with a hoe and the essence."
		"&eTip:&r it only boosts inferium crops; resource crops grow the same on any farmland."
	]
	quest.7FD7ED0A2D0B0532.title: "Stronger Accelerators"
	quest.7FD7ED0A2D0B0532.quest_subtitle: "Optional: faster growth from below"
	quest.7FD7ED0A2D0B0532.quest_desc: [
		"&eWhat:&r higher-tier growth accelerators reach further and tick crops more often."
		"&eHow:&r essence of the tier around stone and that tier's gemstone (makes 3; check JEI)."
		"&eTip:&r stack them in a column under the crop; each tier adds range."
	]
	quest.62D1ADC312A36564.title: "Essence Armor"
	quest.62D1ADC312A36564.quest_subtitle: "Optional: armor grown from a field"
	quest.62D1ADC312A36564.quest_desc: [
		"&eWhat:&r Mystical Agriculture armor in six tiers, from inferium to awakened supremium. Higher tiers hold augments."
		"&eHow:&r a diamond armor piece with two ingots and two gemstones of the tier (it keeps the item's enchantments). Each tier upgrades the last."
		"&eTip:&r higher tiers also take augments; see the Augments quest."
	]
	quest.118A7C8F362C4A22.title: "Essence Weapons"
	quest.118A7C8F362C4A22.quest_subtitle: "Optional: swords, bows and a fishing rod"
	quest.118A7C8F362C4A22.quest_desc: [
		"&eWhat:&r essence swords, bows, crossbows and fishing rods, upgraded tier by tier like the armor."
		"&eHow:&r the diamond (or plain) item with two ingots and two gemstones of the tier (check JEI)."
		"&eTip:&r a sword with the Mystical Enlightenment enchantment can collect Cognizant Dust from bosses."
	]
	quest.74CC190A40E105C8.title: "Augments"
	quest.74CC190A40E105C8.quest_subtitle: "Optional: add powers to essence gear"
	quest.74CC190A40E105C8.quest_desc: [
		"&eWhat:&r augments add effects to essence tools and armor (speed, night vision, mining area and more). The Tinkering Table fits them."
		"&eHow:&r the table is stone and soulium dust. An Unattuned Augment is prosperity shards and iron; attune it on the altar (check JEI)."
		"&eTip:&r higher gear tiers have more augment slots."
	]
	quest.36C94540F248019D.title: "Seed Reprocessor"
	quest.36C94540F248019D.quest_subtitle: "Optional: spare seeds back into essence"
	quest.36C94540F248019D.quest_desc: [
		"&eWhat:&r grinds surplus resource seeds back into the essence they're made of, powered by FE."
		"&eHow:&r a machine frame with soulium ingots, iron and 2 iron hoes."
		"&eTip:&r feed it the extra seeds from a pot farm and nothing goes to waste."
	]
	quest.15A2839EEA20814E.title: "Essence Furnace"
	quest.15A2839EEA20814E.quest_subtitle: "Optional: an electric furnace"
	quest.15A2839EEA20814E.quest_desc: [
		"&eWhat:&r a powered furnace that smelts with FE instead of burning fuel."
		"&eChemistry:&r an electric furnace heats by resistance: current through a wire, P = I²R. No combustion, no CO₂ at the furnace."
		"&eHow:&r a machine frame with iron, prosperity ingots and 2 furnaces."
	]
	quest.04376C3B679506E2.title: "Essence Enchanter"
	quest.04376C3B679506E2.quest_subtitle: "Optional: enchant with essence, not luck"
	quest.04376C3B679506E2.quest_desc: [
		"&eWhat:&r applies the enchantment you pick, paid for with experience essence plus an item for each enchantment (check JEI for the costs)."
		"&eHow:&r an enchanting table on a soulium ingot over 3 soulstone."
		"&eTip:&r it's the easy way to put Mystical Enlightenment on a sword."
	]
	quest.4CFD3DC3D0DD7BAA.title: "Experience Capsule"
	quest.4CFD3DC3D0DD7BAA.quest_subtitle: "Optional: bottle your levels"
	quest.4CFD3DC3D0DD7BAA.quest_desc: [
		"&eWhat:&r stores experience points picked up while it's in your inventory, to spend later."
		"&eHow:&r 2 soulium ingots and 2 soul glass."
	]
	quest.16715B6E6324D65F.title: "Soulium Spawner"
	quest.16715B6E6324D65F.quest_subtitle: "Optional: mobs from essence"
	quest.16715B6E6324D65F.quest_desc: [
		"&eWhat:&r a powered spawner that turns mob essence into living mobs (JEI's Soulium Spawner page lists what each costs)."
		"&eHow:&r a machine frame with iron, soulium ingots and 2 wither skeleton skulls."
		"&eTip:&r pair it with a mob grinder for drops crops can't grow, like XP."
	]
	quest.5CA7AAE7C8DAE7C6.title: "Awakening Rig"
	quest.5CA7AAE7C8DAE7C6.quest_subtitle: "Optional: pedestals and vessels for the altar"
	quest.5CA7AAE7C8DAE7C6.quest_desc: [
		"&eWhat:&r the Awakening Altar is fed by 4 Awakening Pedestals and 4 Essence Vessels holding air, earth, water and fire essence."
		"&eHow:&r both are gold and soulstone, with orange wool (pedestal) or glass (vessel). JEI shows the layout."
		"&eTip:&r fill the vessels before you start; awakening drains a lot of elemental essence."
	]
	quest.4449C276C65D5AC5.title: "Witherproof Bricks"
	quest.4449C276C65D5AC5.quest_subtitle: "Optional: an arena the Wither can't break"
	quest.4449C276C65D5AC5.quest_desc: [
		"&eWhat:&r bricks the Wither's skulls can't destroy: build a box and fight it on your terms."
		"&eHow:&r a witherproof block is soulstone in wither skeleton essence (a tier 5 crop); 4 blocks make 4 bricks."
		"&eTip:&r the Seed of a New World needs Nether Stars, so a safe Wither arena pays for itself."
	]
	quest.79AB7DDCFF409FB4.title: "Cognizant Dust"
	quest.79AB7DDCFF409FB4.quest_subtitle: "Optional: knowledge from a boss"
	quest.79AB7DDCFF409FB4.quest_desc: [
		"&6You remember learning from the strongest things you fought. Some of it is still on the floor.&r"
		"&eWhat:&r Cognizant Dust drops from the Wither and the Ender Dragon when they die to an essence weapon with Mystical Enlightenment."
		"&eHow:&r enchant an essence sword in the Essence Enchanter, then land the last hit on a boss with it."
		"&eTip:&r it goes into awakened supremium: JEI shows the awakening recipe."
	]
	reward_table.7698EA20494532B6.title: "Stone Age Cache"
	reward_table.22FCA4FB112E3A56.title: "Steam Age Cache"
	reward_table.13B98F99C0996D21.title: "LV Cache"
	reward_table.040700CF17D96F66.title: "MV Cache"
	reward_table.672AFE0FCAFF7A3F.title: "HV Cache"
	reward_table.6185B172AA6E1712.title: "EV Cache"
	reward_table.2DCA2BE8DD71D3AB.title: "Nuclear Cache"
	reward_table.222363D0FD03B0F8.title: "Stellar Cache"
	reward_table.6CD014CE62D908F0.title: "Hunter's Bounty"
	reward_table.7F8807499523C6AA.title: "Trophy Hoard"
	reward_table.09A1108284FAFEF6.title: "Pick a Comfort"
	reward_table.39CAE41B832998A7.title: "Pick a Feedstock"
	reward_table.7684E3C5E3EE06BA.title: "Pick a Treasure"
	reward_table.787D99A5C5571E41.title: "Hidden Stash"
}
